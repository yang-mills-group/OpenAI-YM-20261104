    WilsonThermometerClusterProjectionBudget.Ready R.family.path.levels ∧
    ∃lamp:WilsonReportLampForecast.Ready R.family.path.levels,∃paths:FundedOriginalVacuumPaths.prices R.kit,
    Lower p paths lamp ∧
    ∃row:(n:ℕ)→(Fin n→R.family.book.Token)→Test n→ℕ→ℂ,
    (∀n tokens t,WilsonPhysicalStationMixedWickWeakRoseRawProductAtlasWardScientificPermanentPublicPeriodMesh.Fixed R.family .full n tokens t (row n tokens t)) ∧
    ∀(cohort:Ultrafilter (ℕ×ℕ)→Prop),(∀(v:Extraction.Order)(l:Ultrafilter (ℕ×ℕ)),(l:Filter (ℕ×ℕ))≤v.fuse→cohort l)→
      ∃selector:(request:Extraction.Sequence)→WilsonPhysicalStationMixedWickWeakRoseRawProductAtlasWardScientificPermanentPublicEndowment.Published R request,∀request:Extraction.Sequence,
        let v:=WilsonPhysicalStationMixedWickWeakRoseRawProductAtlasWardScientificPermanentPublicVolumeSelector.input request
        let w:=(selector request).daughter
        let S:=(selector request).table
        let F:=(selector request).theory
        let L:=(selector request).atlas
        let Q:=(selector request).reader
        let H:=(selector request).hierarchy
        let z:=(selector request).arch
        let l:=(selector request).late
        let J:=(selector request).frame
        let X:=(selector request).scaling
        ∃chosen:WilsonViewerElectedHierarchy.Selected.{u} F L Q J H z l simple cohort,
        Household p chosen.bliss chosen.leading chosen.obeys chosen.original lamp ∧
        Nonempty (WilsonPhysicalAllGradeWeakElection.Assignment F J H l simple) ∧
        WilsonPhysicalStationMixedWickPose.Finance (Y:=l) (Z:=z) simple F H ∧
        (∀Jc:ℝ→PhysMS.tower S,∀posed:WilsonViewerElectedHierarchy.Selected.{u} F L Q Jc H z l simple cohort,
          Household p posed.bliss posed.leading posed.obeys posed.original lamp) ∧
        WilsonPhysicalStationMixedWickCommissionRun.Reported.{u} R F (l:=l) J H (arch:=z) L Q cohort simple p ∧
        StrictMono w.per.choose ∧ (v.refine w).per.choose=request.choose ∘ w.per.choose ∧
        WilsonPhysicalStationMixedWickWeakRoseRawProductAtlasWardScientificPermanentPublicPhaseData.Recovered chosen ∧
        Pert.FirstExtension F X ∧ OPE.Nesting.Uniform F Q ∧
        (∀ q:OPE.Prescription F.sector.derivatives, q.Coherent → OPE.AllShapes F q) ∧
        (∀ U:Ultrafilter (ℕ×ℕ),(U:Filter _)≤(v.refine w).fuse→Nonempty (SharpGram.Lenses.Mantle F (U:Filter _))) ∧
        (⟨.full,(v.refine w).per⟩:Extraction.Order).Ordered R.family S ∧
        (∀n j:ℕ,∀q:Fin n→(Bel R.family.book).Tag,∀marks:Fin n→Bool,∀ab:Fin n→Axis×Axis,
          ∀K:Set (Points n),IsCompact K→K⊆conf n→∀t:ℝ,0<t→∀ᶠk:ℕ in atTop,∀x∈K,∀viewer:OPE.Viewers F,
          ‖iteratedFDeriv ℝ j (fun y=>S.useAt (OPE.spectator F viewer) (X.r k • y)
              (Pert.scaledPhysical X F.sector.energy k q marks ab)) x-
            iteratedFDeriv ℝ j (Ward.disc (Pert.freeWithStress R.family.labels q marks ab)) x‖≤t) ∧
        ∀n tokens t,WilsonPhysicalStationMixedWickWeakRoseRawProductAtlasWardScientificPermanentPublicPeriodMesh.Arrives R.family (request.after w.per) n tokens t (row n tokens t) S := by
  let simple := YangMills.GaugeGroup.coreSimple hg
  obtain ⟨R,T,W,all⟩ := WilsonPhysicalStationMixedWickWeakRoseRawProductAtlasWardScientificPermanentPublicMarkedVolumes.original.{u} axis simple positive σ
  exact ⟨R,T,W,⟨IssuedRuns.FinalWilsonData.original R.family R.makes hg B, rfl⟩,
    IssuedRuns.OriginalTrajectory.original R.family R.makes hg B, all⟩

