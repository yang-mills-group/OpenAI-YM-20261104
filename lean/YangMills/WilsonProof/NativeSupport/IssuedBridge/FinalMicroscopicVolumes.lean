theorem original (axis:Axis)(hg:g.IsSimple) (B : YangMills.Maxwell.Reference g){ε:ℝ}(positive:0<ε)(σ:WilsonOriginalAllOrderCourse.Schedule g.core):
    let simple := YangMills.GaugeGroup.coreSimple hg
    ∃(R:Run g.core)(T:Campaign R)(W:Campaign.Pillars R T),
