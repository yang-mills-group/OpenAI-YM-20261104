import YM.FormalOPE.RG10.Spiral.Waves
/-!
# H and mode-sum lift of projected color covariance matrices
Proof from finite full-torus costates (NOT inversion-restricted inverse).
Cant ignore discrete null directions; use only directions genuinely generated by full link field,
since that's where stencil transformation is bought. -/
set_option autoImplicit false
noncomputable section
namespace YM.FormalOPE.RG10.Spiral
open Function Wilson Lattice Gauge Precision Exterior Work.F03 Further.CorrectedLift.Compass
   PertExtension Filter RG PertExtension.LatticePT LatticePT.Projection Finset
open Further.CurvedGaussianJets.Shape AnalyticBridge.CouplingShape Next.Rank
open scoped Topology ContDiff BigOperators Classical RealInnerProductSpace
variable {G:Gauge} {n : Side}
local notation "γ" => Bid.Dir G n
local notation "ξ" => G.Color
local notation "ϕ" => FaceAt n

def overlap (u v:γ) := ∑ i: ϕ, inner ℝ (faceCurl i u) (faceCurl i v)
private lemma comm (u v:γ): overlap u v=overlap v u:= Finset.sum_congr rfl (fun _ _=> Eq.symm (real_inner_comm ..))
lemma projected (s:Signed)(u v:γ): overlap (Bid.pulled u s) (Bid.pulled v s)=overlap u v:=by
 unfold overlap; simp_rw [pulled,real_inner_smul_left,real_inner_smul_right,←mul_assoc,wind_sq,one_mul]; exact Equiv.sum_comp (permutation s) (fun q => inner ℝ (faceCurl q u) (faceCurl q v))

abbrev tap (p:ϕ)(u:ξ):γ:= windDir (glare (G:=G) p u)
lemma pays (p:ϕ)(u:ξ)(v:γ) : overlap (tap p u) v=inner ℝ u (faceCurl p v):=by
 unfold overlap; simp_rw [rawCoil,tap,collect_wind]; exact costate_shine ..
lemma payTurn (s:Signed)(p:ϕ)(u:ξ)(v:γ): overlap v (Bid.pulled (tap (permutation s p) u) s)= inner ℝ u (faceCurl (permutation s p) (Bid.pulled v s⁻¹)) := by
 rw [comm]; have he : ∀ q, faceCurl q v=faceCurl q (Bid.pulled (Bid.pulled v s⁻¹) s) := fun q=> (roundTrip s v q).symm
 calc
    _ = overlap (Bid.pulled (tap (permutation s p) u) s) (Bid.pulled (Bid.pulled v s⁻¹) s):= Finset.sum_congr rfl (fun i _=> congr_arg (fun x=>inner ℝ (faceCurl ..) x) (he i))
    _ = _:= (projected ..).trans (pays ..)

def earning (p q:ϕ)(u v:ξ): ℝ:= inner ℝ u (faceCurl p (tap q v))
lemma earning_comm (p q:ϕ)(u v:ξ) : earning p q u v=earning q p v u := by
 unfold earning; rw [← pays,← pays, comm]
lemma earning_spin (s:Signed)(p q:ϕ)(u v:ξ) : earning p q u v = wind s p.2 * wind s q.2 * earning (permutation s p) (permutation s q) u v:= by
 let P:= permutation (n:=n) s
 have he: wind s p.2 * earning (P p) (P q) u v= inner ℝ u (faceCurl p (Bid.pulled (tap (P q) v) s)):= by rw [pulled,real_inner_smul_right]; rfl
 rw [mul_comm (wind s p.2),mul_assoc,he,←pays,payTurn,earning_comm,earning,← real_inner_smul_right,← pulled, roundTrip]

lemma earning_color (p q : ϕ)(i j:G.ColorIndex) :
    earning p q (LatticePT.colorBasis i) (LatticePT.colorBasis (G:=G) j)=(if i=j then (disk (shining q) p).re else 0) := by
 rw [earning,rawCoil,tap,collect_wind,crease_glare,real_inner_smul_right]; unfold LatticePT.colorBasis; rw [EuclideanSpace.basisFun_inner]; by_cases hi:i=j <;> simp [hi,PiLp.single_apply]

def tone (c:ϕ × G.ColorIndex)(A:γ):= (faceCurl c.1 A) c.2
lemma earned (p q:ϕ)(u v:ξ) : ∑ a:ϕ×G.ColorIndex, tone a (tap p u) * tone a (tap q v) = earning p q u v := by
 rw [Fintype.sum_prod_type,earning,←pays]; unfold overlap; apply sum_congr rfl; intro t _; rw [PiLp.inner_apply]; unfold tone; refine sum_congr rfl fun i _=>by exact mul_comm ..
end YM.FormalOPE.RG10.Spiral
