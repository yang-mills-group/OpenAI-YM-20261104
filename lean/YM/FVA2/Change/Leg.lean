variable {G:Gauge} {n:Side} {F:Dot G Cover} {v:ℕ} (X:Stencil F) (p:Cover) (i:ℕ)
local notation "V" => (Chart.City G (Site n))
local notation "Z" => Transverse G n
local notation "T" => MultiGauge.Stack.rise
local notation "B₀" => X.placed n p ∘ nation

-- all linear directions generated by plain position mode vectors.
private theorem der_zero (f: V→ℝ)(h:germ f) (hl:mask (i:ℤ) (ink direction f)=0) : iteratedFDeriv ℝ i f 0 = 0 := by
  induction i generalizing f with
  | zero=>
      have hp : f 0=0:= by have he:= congr_fun hl []; rw [Nat.cast_zero,enough (h:=0) [] rfl,drip] at he; exact Complex.ofReal_eq_zero.mp he
      exact ContinuousMultilinearMap.ext fun _ => by simp [hp]
  | succ k ih=>
      apply ContinuousMultilinearMap.ext; intro x
      rw [iteratedFDeriv_succ_apply_right]
      let U := iteratedFDeriv ℝ k (fderiv ℝ f) 0 (Fin.init x)
      let L : LightMode G (Site n)→ V := direction
      have he j : U (L j)=0:= by
         let e := ContinuousLinearMap.apply ℝ ℝ (L j)
         have hh := e.iteratedFDeriv_comp_left (h.fderiv_right (m:=ω) (by simp)) (show (k: WithTop ℕ∞)≤ω from le_top)
         have hv := ih (layer (L j) f) (germ_layer h _) (show mask k (D j (reads f))=0 from ?_);
         · rw [show iteratedFDeriv ℝ k (e ∘ fderiv ℝ f) 0=0 from hv] at hh; exact Eq.symm (DFunLike.congr_fun hh (Fin.init x))
         have hK := congr_arg (D j) hl; rw [Book.conn,show (↑(k+1):ℤ)-1=k by omega,map_zero] at hK; exact hK
      let Ω := panel G (Site n); let M:= glow G (Site n); change U _=0
      rw [← M.restore (x (Fin.last k)), map_sum]; refine Finset.sum_eq_zero fun j _=> ?_; rw [map_smul]; exact (congr_arg ((M.seed j (x _)) • ·) (he ((Native.Paper G (Site n)).plain (Ω.AId j)))).trans (smul_zero ..)
lemma low (h:From F.val v)(hi:i<v) : iteratedFDeriv ℝ i B₀ 0=0 := by
    refine der_zero i B₀ (X.crease p) (show mask _ (reads B₀)=_ from ?_)
    rw [← X.travel_bill, ← show enters n (model i (Lab.Shift p F)) = mask i (enters n (Lab.Shift p F)) from enterShim (b:=false) _ _]
    have he : model (i:ℤ) F=0:= by apply Subtype.ext; funext l; by_cases hL:(l.length:ℤ)=i; exact (enough _ hL).trans (h l (by omega)); exact strange _ hL
    rw [← show Lab.Shift p (model (i:ℤ) F) = model i (Lab.Shift p F) from mod_ferry .., he,map_zero,map_zero]

lemma flowing (h:From F.val v) (hi:i<v) (E:Type)[NormedAddCommGroup E][NormedSpace ℝ E] (L:E→L[ℝ] V)(u : E) : jet (B₀ ∘ L) i u=0:= by
    let f:=B₀; have hv : germ f := X.crease p; have hV: ContDiffAt ℝ i (f ∘ L) 0:= ( (L.map_zero.symm ▸ hv : ContDiffAt ℝ ω f (L 0)).comp 0 L.contDiff.contDiffAt ).of_le le_top
    change jet (f ∘ L) i u=0
    rw [homogeneous_derivative _ _ _ hV,show (fun t:ℝ=>(f ∘ L) (t • u))=fun t:ℝ=>f (t • L u) from funext fun t=> by rw [comp_apply,map_smul], ← homogeneous_derivative f (L u) i (hv.of_le le_top)]; unfold jet; rw [ show iteratedFDeriv ℝ i f 0 = 0 from X.low p i h hi, _root_.zero_apply, mul_zero ]

/-- Actual translated group-function loglift then order-shift. -/
def onLandau (n:Side) (p:Cover)(v:ℕ) := MultiGauge.Stack.drop v (MultiGauge.Stack.rise ((X.placed n p ∘ nation) ∘ Slice.incCL G n))
lemma giveback (h:From F.val v) : PowerSeries.X ^ v * X.onLandau n p v = T (B₀ ∘ incCL G n) := by
    unfold onLandau; apply MultiGauge.Stack.recover; intro i hi
    unfold MultiGauge.Stack.rise; rw [PowerSeries.coeff_mk]; apply Subtype.ext; funext u
    change jet (B₀ ∘ incCL G n) i u=0; apply X.flowing p i h hi Z _ u

lemma mode (n:ℤ)(p:Cover) : model n (Lab.Shift p F)= Lab.Shift p (model n F):= (mod_ferry ..).symm
lemma landed {J A:Type} [Fintype A][Fintype J][DecidableEq J](q d:Cover)(a:Axes G n A J)(v:ℕ): promote (Wick.pull a.R) (promote (Mark_T G n q d) (levels v F))= Wick.Boson.bills (J:=J) a.X (X.onLandau n (q+d) v) := by
    let f := X.placed n (q+d) ∘ nation; funext i; rw [promised,promised,a.mark_pulled];
    unfold levels; rw [← mode]; -- rewrite using hl
    rw [show enters n (model _ _)= mask (i+(v:ℤ)) (enters n (Lab.Shift (q+d) F)) from enterShim (b:=false) n (i+(v:ℤ)), Wick.pull_mask, X.travel_bill, a.read_pull (h:=X.crease _)]
    unfold onLandau; rw [Wick.Boson.at_bill,MultiGauge.Stack.drop,PowerSeries.coeff_mk, ← Wick.Boson.at_bill, Wick.Boson.analytic a.X _ (Axes.calm (X.crease (q+d))) ]; unfold Wick.Gem.letter; rw [show ((↑(v+i)):ℤ)= i+(v:ℤ) from (by omega)]
end YM.FVA2.Change.Stencil
