-- SAME calibr family for goal. Equivalence.Per.Period.
include hm hW g0
lemma actual_arch {U:RG.Rep G (A.B.a.S.side (m+1) n)} (hU:U.eval=(Γ₀).eval) : Ancillary A F β m n N U b:= by
 have hmV:= C₀.moves N m n hm; have hβout: βℓ ∈ band (a) m := ((C₀.sticks N n).prices m (Nat.zero_le _) hm.le).2; -- clamp usable
 have he: β+Γ+ (b)= βℓ:= by ring
 refine ⟨?_, he.symm ▸ trial_in hβout, hmV.δ⟩ -- Near from trial_in is defeq
 obtain ⟨l,v,u,H,x₀,hx,hf,hs⟩:= (hW.held N m n hm).1; have hy := H.core hm x₀ hx; have hp:= H.owns g0 hm hx; let X:= H.X'; let z':= H.V' x₀; let y':= H.τ x₀; let d := Averaging.delta (X.read z'); let P₁:= predictor A.B N u x₀; have hξ : β=(u x₀).beta := congr_arg RG.Rep.beta hf; have hP:P₁= β+Γ:= congr_arg (·+Γ) hξ.symm
 have he' : H.result x₀=finish Λ (B') V (Collection.shelves X Λ V) (branch X Λ B' V z' Γ) (P₁+d) (vac z' y'):= hp
 refine ⟨X,z',y', hξ.symm ▸ hy, ?_, fun i=>?_⟩
 · have hδ: βℓ=P₁+d:= by rw [hs, he']; rfl
   rw [hδ,hP]; ring
 let Q':=F.machine.passes hm H.knows; rw [hU,← hmV.ident, hs, he']; rw [show P₁+d=β+Γ+d by rw [hP] ]; exact congr_fun (hy.actual g0 (A.B.support.cap N _ hm.le) Q'.1.decent Q'.1.width _ (Return.enough_room ..) (Q'.1.fees x₀ hx) β y') _
end
