lemma song_price : (turnFee V= away s)∧ Carillon.payment V G (p).clip δ (p).paths (L0) (turnFee (V)*(t^(P').wanting+t^(-(7/16):ℝ))) U.beta E' Ξ Γ ≤ G' ∧ Real.exp (-(δ/4)*B)*octaveNeed G V (D').low δ (p).paths (L0) Ξ Γ ≤ v₀:= by
 obtain ⟨hw,hB,H,h1,hV⟩:= bless R Q A F h hk; obtain ⟨h₂,h0,hf,hp,hT⟩:= low_tent R Q A F h hm u K; obtain ⟨ht,hη,hK,ha,hw',hq⟩:= WheelP.mates R Q A F h hm hk X' hh x hx; have he:= hV hp _ _ _ hq ha h0 hf; let y':=t; have hj:1<y':=(zones R Q A F h)|>.2.2.2.2.2.2.2; have h₀ : x∈ Set.Icc (y'/2) (2*y') := ht; have hf:= hV hp U.beta E' (L0) (show |U.beta|≤_ from (by rw [hs, abs_of_pos ((half_pos (zero_lt_one.trans hj)).trans_le h₀.1)]; change x≤4*y'; linarith [h₀.2])) ((Boulevard.coupling A _ _ hm).trans (le_add_of_nonneg_left zero_le_one)) h0 hf
 have he' : turnFee V=Height.away s:=by obtain ⟨ht,hh,hg⟩:= (zones R Q A F (m:=m) h).2.1; unfold turnFee Height.away; rw [ht,hh]; --
 refine ⟨he', ?_, he.2⟩; unfold Carillon.payment; rw [h.tour.wanting Y E (step_paid (a) m),he']; change _ ≤ Height.away s*(6* fee1 G L y); unfold fee1 at *; nlinarith only [mul_le_mul_of_nonneg_left he.1 (show 0≤ Height.away s from he' ▸ (turnFee_pos V).le),mul_le_mul_of_nonneg_left hf.1 (show 0≤ Height.away s from he' ▸ (turnFee_pos V).le)]
lemma guidance (S':Forest (Pane.panel A m u).ratio) : Collection.Local (posting V K) V (organ K Op Ξ Γ) G' V':= by
 let w:=low_tent R Q A F h hm u K; obtain ⟨hV,-⟩:= Shop.weight A F u hm K hz S'; obtain ⟨ht,hq,hK⟩:= song_price R Q A F h hm hk X' hh u x hx K hz hs; let Bξ:= V; let σ:=δ; have hv:= (bless R Q A F h hk).1; have hp:= Carillon.scope K Op V Ξ Γ E' w.1 hV (by change preExponent V /_ ≤ _; refine (le_trans (b:=(preExponent V+1)/(Bξ.B:ℝ)) ?_ (hv.2.2.trans ?_)); exact div_le_div_of_nonneg_right (by linarith) (by positivity); linarith only [show 0<δ from hv.1]) w.2.2.2.2; obtain ⟨u,hu,hU⟩:= hp.cheap; exact {hp with cheap:=⟨u,hu, fun i=>budget_loosen (hU i) hq⟩}
lemma applies (Kx:Forest (Sℓ).ratio){s' u' t' d' l k' q A' z':ℝ}{j i:ℕ}(hj:(V).order ≤ j) (C0:Captain K j s' u' t' d' l k' q A' z' i Chi.canonical): ∀ v,(Sℓ).push U.beta U.eval v= hallelujah x Γ D0 M★ (D').down (D').low V (Song.weighty K Op Kx) v:= by
 let gξ:= low_tent R Q A F h hm u K; intro v; have hv:=Carillon.noted Op Γ (V) C0 gξ.1 hz rfl hj Kx v; rw [hs, show x+(goldN R Q A hk X' x-x)=Ξ by ring] at hv; rw [hs]; exact hv
