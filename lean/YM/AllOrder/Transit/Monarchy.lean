lemma no_mane (he:∀ i∉Set.range C₀.model,U.activities.E i=0): haze (k:=k) (Mξ:=Set.range C₀.model) A F u K 0:= by
 refine ⟨fun _=>0,fun x=>?_,?_⟩; · simp only [zero_mul,ite_self]; exact ⟨fun _=>le_rfl,summable_zero,tsum_zero.le⟩
 intro i; have hh : (if ¬T0 i ∧ errorX K M i then S0 i else 0)=0:= by
    split; next h=> obtain ⟨j,hj,rfl⟩:= h.2; dsimp only; unfold Song.sequence; rw [flip_noop, Height.noLines (μ:=(F.shape.μ Y E)) Op (Brim.icon K j) none j (by change Opacity.key _ j ∈ Brim.head j; exact Finset.mem_singleton_self _) (he j hj),smul_zero]
    next h=> rfl
 simp only [] at hh; dsimp only; rw [hh]; exact ⟨Progress.DirectedRecipe.unspent .., Progress.DirectedRecipe.no_cost ..⟩
-- attraction radius
lemma accessG (t':ℕ)(q':ℕ)(b B':ℕ) (hv:t'≤q')(he:2≤B'): High.clusterBound t' (Mint.width b B' (2*B')) t'+ Mint.width b B' (2*B') ≤ Shop.cargo q' b B':= by
 let D:=Mint.width b B' (2*B'); let v:=(b+10)*B'; let q:=q'
 have he:D≤ v:= by unfold D Mint.width v; rw [add_mul]; omega -- nonlin with b?
 have hf:1≤ v:= by unfold v; nlinarith
 have hx: (t'+1)*t'≤ (q'+10)^2:= by nlinarith
 change clusterBound t' D t'+D ≤ _; unfold clusterBound; calc
   _ ≤ (q'+10)^2*(4*v+2)+2*v+v:= by gcongr
   _ ≤ (q'+10)^2*10*v:= by nlinarith [Nat.le_mul_of_pos_left v (show 0 < (q'+10)^2 from by positivity), mul_le_mul_left' hf ((q'+10)^2)]
   _ ≤ _ := by change _ ≤ 18* (Shop.parking q' b*B'+(6*B'+3)+B')+8+2*B'; rw [show (q'+10)^2*10*v=Shop.parking q' b*B' by unfold Shop.parking v; ring]; omega
