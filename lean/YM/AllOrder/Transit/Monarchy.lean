 apply Subset.trans (High.hall τ (Burn.steady K C₀ τ j) τ (Eξ) Burn.check_steady i ((runIn ..).1 hi) hq); intro x hx; apply (neighbors_mem ..).2; exact (((neighbors_mem ..).1 hx).trans ((Nat.le_add_right (clusterBound τ (Eξ) τ) _).trans (paying R Q A F h hk)))
