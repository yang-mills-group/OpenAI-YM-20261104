lemma afloat (hd:4*Meadow.studio (Shop.parking (Shop.tall (A.B.a.clock.J m)) ((F.target (A.B.a.clock.J (m+1)) (A.B.a.clock.J m)).halo)) (radiusB (A.B.a.clock.hatBeta m))+16≤ c'.val): Compatible (v!) (Dξ) V eξ:= by
  intro i k' Xᵥ Wᵥ hQ hW hE; let Cb:=c*c'; let Fb:= Cb*(g); have hM:Fb.val=Cb.val*(A.B.a.S.block m).val:=rfl; have hN: Cb.val=c.val*c'.val:=rfl; have hN':Cb.val=c'.val*c.val:=mul_comm ..
  have he' : c.val≤Cb.val:=Nat.le_mul_of_pos_right _ c'.pos
  obtain ⟨Zb,Hb⟩:= tokens R Q A F h g0 hm hk X' hh hM x hx (show 100*(1+radiusB y) ≤ Cb.val from K.laws.data.room.buys.trans he')
  let U₁ := Lattice.translate i Xᵥ; let U₂:= Lattice.translate k' Wᵥ; let Z:= normal (divides hN) hN; let Z2:= normal (divides hN') hN'
  have h1: RG.flags (V).threshold U₁=∅:= by unfold U₁; rw [← pull_one]; exact Pane.tranquility Xᵥ hQ ..
  have h2: RG.flags (V).threshold U₂=∅:= by unfold U₂; rw [← pull_one]; exact Pane.tranquility Wᵥ hW ..
  have hK:= sits R Q A F h hm hk X' hh hM x hx Zb Hb rfl j (youthS R A X' hM x) (0:Site Cb)
  calc
    _ = v! 0 U₁:= by unfold U₁; unfold assetC; rw [← pull_one, newC_turns]; simp [Lattice.affine]
    _ = assetC R Q A F hk X' hM x Zb (youthS R A X' hM x) j 0 (Z.links U₁):= by rw [match_fan R Q A F h g0 hm hk X' hh u x hx K hz hs j C₀ hu hr hM hc hN Zb 0 _ h1,_root_.map_zero] -- syntax
    _ = assetC R Q A F hk X' hM x Zb (youthS R A X' hM x) j 0 (Z2.links U₂):= by
       apply hK.sites _ _ (Slide.readNear (Z:=eξ) 0 (by omega) ?_); rw [Slide.rolls,Slide.rolls,map_zero,map_zero]; unfold U₁ U₂; rw [increases,increases]; exact hE
    _ = Dξ 0 U₂:= by rw [match_fan R Q A F h g0 hm hk X' hh Hc x hx K' hz' hs' j C₁ hu' hr' hM hd hN' Zb 0 _ h2,_root_.map_zero]
    _ = _:= by unfold U₂; unfold assetC; rw [← pull_one, newC_turns]; simp [Lattice.affine]
lemma beehive (hd:4*Meadow.studio (Shop.parking (Shop.tall (A.B.a.clock.J m)) ((F.target (A.B.a.clock.J (m+1)) (A.B.a.clock.J m)).halo)) (radiusB (A.B.a.clock.hatBeta m))+16≤ c'.val): Compatible (𝒢) (brook R Q A F hk X' Hc x K' C₁ j) V eξ:= by
   intro i j' U Wξ hv hv' hE; have he:= afloat R Q A F h g0 hm hk X' hh u x hx K hz hs j C₀ hu hr Hc hc K' hz' hs' hu' hr' C₁ hd i j' U Wξ hv hv' hE; have he' : (MNew) c i U=(MNew) c' j' Wξ:= (paint R Q A F h g0 hm hk X' hh x hx (show 4≤c.val from (by have hv:=K.laws.data.room.buys; omega))|>.2.2) _ _ _ _ _ _ ?_ ; exact congr_arg₂ (·-·) he he';
   have hm : Lattice.box B⊆Lattice.box eξ:= by intro i₀ hi; change i₀∈ Lattice.box eξ; change i₀∈ Lattice.box B at hi; obtain ⟨hs,hp⟩:= box_test.mp hi; have hh:B≤ eξ:= (Nat.le_add_right B B).trans (Shop.perimeter ..); exact box_test.mpr ⟨fun j=> (show -(eξ:ℤ) ≤ -(B:ℤ) from neg_le_neg (Nat.cast_le.mpr hh))|>.trans (hs j),fun j=> (hp j).trans (Nat.cast_le.mpr hh)⟩
   exact fun i hi hx=>hE i (hm hi) (hm hx)
