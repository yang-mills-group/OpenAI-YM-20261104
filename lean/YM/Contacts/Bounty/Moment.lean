   have h:= (Psalm.Stage.directed hq.conducts.hearing A.B hm hb hl (fun i hi=>hq.conducts.full N _ _ (by simp at hi; omega))).1.enabled
   have hw:= h.make; obtain ⟨hA,hS⟩:=h.pre; have hE:= h.clocks U.beta hb|>.2; rw [← hl.point] at hA hS hw hE; obtain ⟨hh,hp',hX⟩:= canyon A (m:=m)
   let hp₀:= hq.agenda _ _ i; let C':=B.expense J I; have hp':= hp'; have hr': (P).supportExponent=(M.p.profile I).supportExponent:= hX; have hz:preExponent (P)≤ (C').earn:= by unfold preExponent; rw [hr']; exact hp₀.1
   have hκ: preExponent (P)≤Solo.raise B.t J I:= by unfold preExponent Solo.raise; rw [hr']; exact hp₀.2.1.trans (le_add_of_nonneg_right (by norm_num))
   let l':=((L).val:ℝ); let u':=l'⁻¹*Ω+(2*l'⁻¹+V/l'+l'⁻¹)*t; have ht':A.B.a.S.block m=L:= PriceCompiler.block_eq A.B.valid m; have hv':Terrain.Make X P O (fun i=> Poetry.keep X Ψ o (.inl i)) u':= hx _ _ (A.B.a.clock.op m n) T rfl X.laws.data.funds (Opera.protocol A.B hm hq.conducts.full) U X P rfl hp' hw hp₀.2.2 (ht' ▸ hA) (hp' ▸ hS) (ht' ▸ hE) hz hκ rfl hh.le (Poetry.unknown Ψ) t _ hr ((Trophy.asset A (m:=m)) ▸ hv) (fun z hh hv=> hh (entrants z hv))
   have h0:1≤l':= Nat.one_le_cast.mpr ((L).pos); have hL:= zero_lt_one.trans_le h0;
   let hα': (A.B.a.S.side (m+1) n).val=(A.B.a.S.side m n).val*(A.B.a.S.block m).val:=(A.B.a.S.oneStep m n).exact_size; refine (H.authority hm hp ht hα hα' X he hb Ψ hv').mono (fun i hi=>Cap.raise hi ?_); unfold nana owne; rw [show Height.away p=oof from rfl]; unfold u'; have hp: Ω≥0:= by exact (Ωp H).le -- char
   have hv₀:l'⁻¹ * Ω ≤ Ω := mul_le_of_le_one_left hp (inv_le_one_of_one_le₀ h0); have ht:0≤oof:=(turnFee_pos _).le; rw [show 2*l'⁻¹+ V/l'+l'⁻¹=(3+ V)/l' from (by field_simp; ring)]; change _≤ _ + _*((3+ V)/l')*_; linarith only [mul_le_mul_of_nonneg_left hv₀ ht]
