variable {G:Gauge}{n i k:ℕ}{ φ: Actor G}{u:ℤ}{X F:Dec G}{p:Team}{R: High.Recount G}
variable (x:ℝ)
local notation "ΩV"=> rel x
abbrev capU (G:Gauge)(i:SpanT): Latch.Edge G:= Mood G i.val
def huge (p:SpanT):ℝ:=(ΩV).length p
abbrev stout (p:SpanT):= ((huge x p)⁻¹:ℝ)
lemma s_here (i:SpanT): 0< huge x i:= ( rel x |>.pos i )
lemma he_zero : nn ( stout x ):= fun i=> inv_nonneg.mpr ( s_here x i|>.le )
-- power exponent wiggle.Even rank valuations not used Lap?
lemma hymn (p:SpanT)(i j:BH G) : ((ΩV).length p)^((4:ℤ)-wfield i-wfield j)*stout x p=((ΩV).length p)^((3:ℤ)-wfield i-wfield j) := by rw [show (3:ℤ)-wfield i-wfield j=((4:ℤ)-wfield i-wfield j)-1 from (by omega), zpow_sub₀ (( ( ΩV ).pos p ).ne') _ 1,zpow_one ]; exact (div_eq_mul_inv ..)|>.symm
lemma element (i j:BH G): Sharp ΩV (phaseDiff ΩV) (fun _=>firstZone Axis) (fun p=> capU G p i j ) (fun p=> Landau.choir ( Landau.laplace (Landau.low ((ΩV).length p)) ) id i j ) ( fun p=> ((ΩV).length p)^((3:ℤ)-wfield i-wfield j) ) := by
   obtain ht:= lap_meter ( soon x ) (a:= phaseDiff ΩV) (fun i=>le_rfl) i j; refine Eq.mp ?_ ht; congr! 1; funext p; dsimp only; rw [future]; rfl
lemma planetX : CourseK ΩV ( stout x ) ( capU G ):= by intro i j; simp_rw [ hymn ]; exact (element x i j).both.lat
lemma planetV : Sheet ΩV ( stout x ) (fun p=>Rake.spread ( capU G p )):= by intro i j; simp_rw [ hymn ]; apply folding (F:=fun p=> capU G p i j) ( element x i j|>.lattice ) (fun p=> cityLine ( X_stamp _ ) i j) (soon x)
lemma attach1 {F:Wind.Pack G}(h:Fees false u F)(p:SpanT): orbit ( capU G p ) μzone (keeping x F p)= cycle ( Rake.spread ( capU G p ) ) planeF ( keeping x F p ) := by
   let U:=F x; let X:=Mood G p.val; have hp:TouchF U:=(h.stay x).joint; rw [finite_cc μzone ( show Pass _ _ _ from period0 μzone cour0 ( mood_f G ) hp ) ]; funext w; symm; unfold Ccy cycle; simp_rw [degreeF]; apply shineZ; · -- smooth
       obtain hx:= Hz false 0 hp ( station_t (A:=QP) w ) (mood_f G) (contDiff_const (c:=p.val)) contDiff_id; convert! hx.continuous using 1; funext v; simp only [ Orbit.wait,be_0,one_mul, at_trc, id_eq, station_w ]; rfl
   exact homePeriod _ _ w ( X_stamp _ ) (( h.stay x ).perk p.val)
