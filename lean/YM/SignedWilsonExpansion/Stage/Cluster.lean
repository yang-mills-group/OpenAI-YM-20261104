   have hp(i): 𝒜 i (Z i)-𝒜' i ( Z i )=(∑ f,B i f * E i (fun a=> U a (f a))) :=by
       change E i (Z i)=_; nth_rw 1 [show Z i= ( fun a=> ∑ f:Toon G (d a), (U a).coord f (Z i a) • U a f ) from funext fun t=> ( ( U t ).sum_repr _ ).symm]; rw [MultilinearMap.map_sum]; exact Finset.sum_congr rfl fun _ _=> MultilinearMap.map_smul_univ ..
   simp_rw [hp]; refine IsLittleO.sum fun j _=>?_ ; have he:= IsBigO.finsetProd (s:=Finset.univ) (fun a _=> hz a ( ( U a ).coord (j a)) ); simp only [Pi.one_apply,Finset.prod_const_one] at he; apply (( show (fun i=> B i j)=O[ℱ] (1:ι→ℝ) from he ).mul_isLittleO (T j) ).congr' (EventuallyEq.rfl) (Eventually.of_forall fun i=> one_mul _)
