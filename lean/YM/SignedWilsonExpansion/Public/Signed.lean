variable (H)
theorem signed3 (O:OrderS G) (ε:ℝ)(s:0<ε)(e:Axis) : (∀ R:XSpace.Run, ∃ Z:WilsonPrescription G,Z.run=R) ∧ (∃ E:Construction.{u} H ε e O,∀f,∃ V:Vision E f,withPerspective V):=by
   refine ⟨ fun R=>?_,?_ ⟩
   · obtain ⟨Z,h,Q⟩:= perspective H false R; exact ⟨Z,h⟩
   obtain ⟨E⟩:= Construct H ε e O s; refine ⟨ E,fun f=> ?_⟩; obtain ⟨V⟩:= afterElection E f; exact ⟨ V,with_indie V ⟩
abbrev axiallyCalibrated (H:G.Simple):Type _:= Construction.{0} H 1 3 ( leastS G )
theorem signed3run (R:XSpace.Run) :∃ Z:WilsonPrescription G,Z.run=R∧∃ (E:axiallyCalibrated H) (V:Vision E .full),withPerspective V:=by
    obtain ⟨p,U⟩:= signed3.{0} H ( leastS G ) 1 zero_lt_one 3; obtain ⟨E,h⟩:=U; obtain ⟨Z,u⟩:= p R; exact ⟨Z,u,E,h .full⟩
