lemma momentumSettlement : MomentumSettlement X v DAD:=by
    refine ⟨ notebook X v DAD, fun F z s y p q=> projectionSettled X v F DAD y s z p q,climate Q X v hr hp DAD,fun F s w x p q=> studio X v F DAD x s w p q,fun F w=> liftsAll X v F w DAD, fun F u εM S' C' t q ε p=> jointMeter X v F u εM S' C' t q DAD p, fun F y u εM S' C' t q p=>glasses X v F y u εM S' C' t q p DAD ⟩
lemma careerPaid (D₆:6≤D) : CareerPrice Q X v hr hp D₆:=by
    have p : ∀ᶠ i:ℕ in atTop,pricedEra X v hr (ret i) ∧ 0 < i :=by filter_upwards [ eventually_ge_atTop ( ( σ₀ ).overhead+b ),eventually_ge_atTop (1:ℕ) ] with i h₀ h; exact ⟨ ⟨ h₀,h ⟩,h ⟩
    exact ⟨ WorkOrders.deploy Q X v hr hp D₆,custodian X v hr,p,fun Y DAD=> momentumSettlement Q X v hr hp DAD,fun P₀ Y DAD q t=>let M:=EstimatorGeometry X v DAD P₀ q t D₆; ⟨ M,hiredRose P₀ S q,fun m u A h=> pledgeThermometer X v DAD m D₆ A h M t u,fun m y q' s=> dewT X v DAD m D₆ y s q' ⟩ ⟩
end

