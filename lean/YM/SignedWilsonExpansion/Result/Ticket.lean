structure ProjectionSettlement (H':Editorial Q X v hr hp ℬ) : Prop where
    /-- both radius homes in a bill, in the W dictionary and cap `K`. -/
    has_identity (i:ι)(x:Points ( Draft.bill F )): Life Z V false (r i) K (Zy i) x none= Qᵥ (z i) x i
    masks: ∀ᶠ i in ℱ,∀ s:Wedge F,jumped (V:=V) Z v F z s i=carpet F ( jumped (V:=V) Z v F z univ i ) s
    no_jump_if_pinned : prepared F → ∀ᶠ i in ℱ, Zy i=carpet F (z i) s
    identified : ∀ᶠ i in ℱ,∀ j:Fin ( Draft.bill F ), ∃ v₁:E.paths.family.label (K j), Tendsto (fun p:ℕ×ℕ=> Nt (M:=v) F Z.store ( fired F (liftV z) s ) (i,p) j) (V.pupil.Y:Filter (ℕ×ℕ)) (𝓝 v₁) ∧ V.pupil.S.project (K j) v₁= V.pupil.S.project _ (gala E.paths V.pupil.last V.colours (V.Pre Z) (r i) (K j) ( Zy i j ) )
    transfer : ∀ℓ:ι→ℝ,(∀ᶠ i in ℱ,0<ℓ i) → (eraW X v hr F y s (liftV z) .ultraviolet-( fun i:Visual ι=> eraFixed (V:=V) Z v F y s z i.1 i.2 ))=o[ ζL ](liftV ℓ)
    earned_trunc (A:EraY)(t:pricedEra X v hr A)(u:ℝ)(h:0<u): ∀ᶠ i:Visual ι in ζL,∀ x,plots (V:=V) v i.1 F x → ‖ eraW X v hr F (fun _=>x) s ( liftV z ) A i- (τ₀ i.1 x b)‖ ≤ u* ‖Ψ i ^ b‖
    /-- here E.paths & V.colours fixed label, FULL prices also available after identification -/
    regains : ∀ᶠ i in ℱ,Tendsto ( eraFixed (V:=V) Z v F y s z i ) (Homes.track V.pupil.f).fuse (𝓝 (Qᵥ (z i) (ruler (V:=V) v F y i) i))
    full_trunc (b':ℕ): ∃ c:ℝ,0<c ∧ ∀ᶠ i:Visual ι in Track V ℱ,∀ x,plots (V:=V) v i.1 F x → ‖ eraFixed (V:=V) Z v F (fun _=>x) s z i.1 i.2- (τ₀ i.1 x b')‖ ≤ c* ‖Ψ i ^ (b'+1)‖

