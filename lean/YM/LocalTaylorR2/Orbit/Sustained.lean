structure StrongR2 (w:ℝ):Prop where
    plot : Palette.Plot M' Θ' M₀
    carry : Orbit.RelayPaid Θ' Chi.canonical M' M₀ C M₁ lP r o₀ F g' u' w
    canopy : Towed r id A₀ (B).B (B'+1/2) 1∧ (∀ i,Burns o₀ i (A₀ i) (F).p.threshold) ∧
      Towed r Prod.fst Y₀ (B).B (B'+1) s₀ ∧ (∀ i, MergeProof.Accent.Flow o₀ i (Y₀ i) (F).p.threshold) ∧
      (F').push (Q x|>.beta) (Menu.Expense b₀ r F')=Accent.play F C (Y₀) (fun U=>∑ i, A₀ i U)∧
      (∀ i U,(Y₀ i U).part C.quiet=MergeProof.profile (F).activities (fun j=> Complex.ofReal ∘ (F).activities.K j) i U) ∧ ∀ i U j,(Y₀ i U).part (C.fire j)=∑ l,Menu.owl (b₀ l) (Mallow.sandboxK H x) j i U
    divisor : (Real.sqrt (A.B.a.clock.forcedAllowance m))⁻¹*s₀ ≤ tx^(-(lP+1:ℝ))
    -- include full moved marker path and layouts; not constraining rank-dependent polls.
include hE hN hS hP hm g
-- on any `Plot` but also as demand for existing Volant.
set_option maxHeartbeats 840000 in
lemma sailR2 (hb:∀ i,0<r i) (hs:Extra.Multi.Occupancy o₀ (J+1)) (ht:Menu.Offer o b₀ r ((Q x).p.B) ((Q x).p.supportExponent-4) u₀)
    (hl:lP ≤ J) (w:ℝ)(hW:tx^Tail.requested (lP+1) (CalendarStep.loss J) ≤ w):
    StrongR2 H x lP C b₀ o r w:=by
   let Rπ:= houseS H x; have hC:=hS _ _ (A.B.valid.pays m) _ (step_paid A.B.a m)
   let d':=F'; have hD : SoundDoor d' d0:= sounds g hm H x hS
   let Gx:= (minted_same R.shape hP)
   have hK:= Gx.word _ _ (A.B.valid.pays m) _ (step_paid A.B.a m)
   have hz:tx=betaF G y L:= beta_eq A.B.valid m
   have hHop:Palette.shipPrice L Y y (J+1) u₀:= hz.symm ▸ hK.shipping
   have hΞ:= Opera.protocol A.B hm R.pledging.conducts.full (n:=n); obtain ⟨a',ba,q,t',z,F'₀,t₃,t₄,t₅,t₆,k',hB,hA,N₀,hN'⟩:=hC.1.2 _ _ _ _ hΞ (Q x) _ (houseS H x)
   have he : (B).supportExponent+3 ≤ (Ze).earn :=by
        have he':= R.pledging.agenda _ _ (step_paid A.B.a m)|>.1; rw [Rain.jersey (A:=A) (m:=m)|>.2.2.1]; linarith
   have hV:Palette.Plot M' Θ' M₀ := Photo.bidding Rπ C r hb b₀ o hC.1.1 (by rw [Rπ.laws.intake.sizes, Rπ.laws.data.funds.length_eq]; exact hB.covers) (by
        change 4 ≤ (Y).exp+_+_; change 100 ≤ B' at hN; linarith only [he,hN,(Ze).worth,(Ze).first,(Ze).second,(Y).usable,(Y).pos]) hE (hz.symm ▸ hK.nonneg) ht hs hHop
   have hv := Many.usable g hm H x M' M₀ N₀ hS hB hV
   have hw:= crowd2 g hm H x M' M₀ N₀ Gx.hold hB hV
   have hr(i): (b₀ i).s.val.image ((F').ratio.parent ∘ o) ⊆ (M' i).crest.image (F').ratio.parent:=by intro j hj; obtain ⟨i',hi,hj⟩:= mem_image.mp hj; subst j; exact mem_image_of_mem _ (ht.sites _ (mem_image_of_mem _ hi))
   have hb':0≤(B).supportExponent+1:=add_nonneg (B).exponent_pos.le zero_le_one
   obtain ⟨hR,hX,hD',hP',he',hZ',hW'⟩ := Photo.shade_preciseR2 _ _ _ (g') _ _ _ hb d0 b₀ hD hr hv hw rfl hb' (fun i U j=> (by obtain ⟨v,h,_⟩:=hv.gas.bought; exact live H x M' M₀ i U (((h i).works U).choose_spec)))
   have ht(i):= Menu.virtue (b₀ i) r
   have htK(j):(M₁ j).part C.quiet=0:= (ht _).1
   have hX'(i): GridApprox.Nil.Scoped {xΩ| o₀ xΩ∈ (M' i).crest.image (F').ratio.parent} (M₁ i):= GridApprox.Nil.scope_send _ _ _ ((Accent.room _ _ _).2 (hr i)) -- notation o₀ x capture x!! u expression uses x macro.
   have hh:=hP _ _ (A.B.valid.pays m) _ (step_paid A.B.a m); have hs:= Rπ.laws.data.funds
   have ha := hh.2.2 ⟨(F').patch,hs.funds.kernel,hs.length_eq,hs.funds.atStep⟩ lP hl
   have hf:=params_eq A.B.valid m; have hF:(P').order=(X.p.profile Jp).order:=congr_arg RG.Stage.order hf -- X metals shadow?
   have hn:(P').power=(X.p.profile Jp).power:= congr_arg RG.Stage.power hf
   rw [← hF,← hn] at ha; rw [hz] at hW
   have h:= Orbit.charge_at Θ' Chi.canonical M' M₀ C M₁ lP r hb (fun i=> Menu.paid (b₀ i) hb) o₀ hX' (fun i=>(ht i).2) htK (H.result x) (g') hv hw (Ze) he rfl hΞ (u') hW ha -- capture g'
   have he'' := Orbit.stores _ _ _ _ hV C M₁ lP r hb o₀ (fun i=>(ht i).2) htK (H.result x) (g') h hv.temp
   refine ⟨hV,he'', ⟨hR.shrink ?_ ?_ hb,hX,hD',hP',he',hZ',hW'⟩,?_⟩
   · linarith only [he,hB.allow]
   · obtain ⟨_,ha,_,_,hτ⟩:= Palette.field M' Rπ O M₀ hV hB N₀.balance
     have hz := mul_nonneg (mul_nonneg (mul_nonneg zero_le_two (Real.exp_pos ((Y).mark L Cμ y)).le) (show 0 ≤ (1-1/2:ℝ)⁻¹ by norm_num)) (budget_nonneg (ha 0)); linarith only [hB.gains,hz,hτ]
   rw [Blush.glyph_eq,hz]; exact h.hard.2

omit hE hN hS hP g hm
lemma StrongR2.consumer (w:ℝ)(h:StrongR2 H x lP C b₀ o r w): Canopy (F') d0 (o₀) r (B'+1/2) (B'+1) 1 s₀ b₀:=by
   exact ⟨⟨A₀,Y₀,h.canopy⟩⟩
