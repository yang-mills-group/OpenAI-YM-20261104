structure GardenCameo (φ Δ b:ℝ):Prop where
   loyal: Assisted H x lP C b₀ o r ψ φ Δ b
   temple : Orbit.EpochVisit W O M' M₀ C M₁ lP r o₀ Pt g' ψ Ξ (u') (φ+(Δ+φ)) φ
   pension : ∀ (UBook:∀ i:(W).fragrances, Finset (Booking (W) M' lP i))(i:ℕ), i≤lP+1 → (∀ k j,j∈ UBook k→i ≤ ranked (W) M' lP k j)→ scout! (answering W O M' M₀ C M₁ lP UBook (Ξ.plug W ψ lP)) (tx^requested i (u'/2)) ∧ ((∀ k j, j∈ UBook k → ranked (W) M' lP k j ≤ lP) → scout! (chef W O M' M₀ C M₁ lP UBook ψ- answering W O M' M₀ C M₁ lP UBook (Ξ.plug W ψ lP)) (tx^requested (lP+1) u'))

