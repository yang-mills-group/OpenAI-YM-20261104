import YM.OPE.Compatible.Woven.Wool
/-!
# Charge on A0 products in cover variables
-/
set_option autoImplicit false
noncomputable section
namespace YM.OPE.Flume
open Function Lattice Laurent Filter MeasureTheory RG Finset Tree Next.Free Bloch Exterior Precision Planned.PrimaryIntegral295 Planned.PrimaryIntegral295.Carrier
open scoped Topology BigOperators Classical
variable {r:ℕ} {L:Side} {A C η:ℝ}
-- Lines generated by correct K. Leaving param general
abbrev fling (X:Cross L (TypeFace 1) (TypeFace 1))(a b:Axis)(x y:Cover):= X (wrap L x,coord a) (coord b) (y-cellar L x)
abbrev parcelK (X:Fin r→Lines L)(a b: Fin r→Axis)(co:Fin r→Cover)(x y:Bin r) := ∏ i,fling (X i) (a i) (b i) (co i + stepOut x i) (stepOut y i)
def parcelY (co: Fin r→Cover)(L:Side)(x:Bin r) := lace r fun i=> cellar L (co i + stepOut x i)
lemma fling_budget {X:Lines L}(h:X.strip η C)(he:0<η)(a b:Axis)(m:ℕ)(x:Cover): Sack (fun y=>poise m (y-cellar L x)) (fling X a b x) (widthCost η m*C):=by
    have hh:= width_income he (h (wrap L x,coord a) (coord b)) m
    let f y:= X (wrap L x,coord a) (coord b) y; let t:= Equiv.subRight (cellar L x)
    have hv:Sack (liftCost m) f (widthCost η m*C):= by
       unfold Sack; simp_rw [mul_comm (liftCost m _ :ℝ)]; exact hh -- parse
    unfold fling; change Sack _ (f ∘ t) _
    have hg(m): poise (I:=Axis) m=liftCost m := by funext y; unfold poise notch liftCost; push_cast;ring
    exact Eq.mpr (by rw [hg];rfl : Sack (fun y=>poise m (y-cellar L x)) (f∘ t) _ = Sack (liftCost m ∘ t) (f∘ t) _) (hv.adroit t)
lemma parcel_budget {X:Fin r→ Lines L}{p : Fin r→ℝ}(h:∀ i,(X i).strip η (p i))(he:0<η)(a b:Fin r→Axis)(m:ℕ)(co:Fin r→Cover)(x:Bin r): Sack (fun y=> poise m (y-parcelY co L x)) (parcelK X a b co x) (∏ i,widthCost η m*p i):=by
    let c(i: Fin r):= co i + stepOut x i
    let f i:= fling (X i) (a i) (b i) (c i); let u (i)(x:Cover):=poise m (x-cellar L (c i)); have hU i (j:Cover): 1 ≤ u i j:=poise_one m (j-cellar L (c i))
    apply (trellis (f:=f) (u:=u) (fun i=> fling_budget (h i) he _ _ _ _) (hU)).minor (fun i=> zero_le_one.trans (poise_one m _)) ?_ le_rfl; intro i; apply (couple_powers (i-parcelY co L x) m).trans_eq; unfold weave; rfl
lemma advance_petal (A:Lines L)(a b:Axis)(ho:Odd L.val)(i:Axis)(x y:Cover): fling A a b (x+stint i) y - fling A a b x y = fling (forwardC L A i) a b x y:=by
    have hh : stint i=step i:=by ext x; by_cases h:x=i<;> simp [step,stint,h] -- names
    unfold fling; rw [hh,_root_.map_add,wrap_step, Trellis.cellar_step ho]; unfold forwardC; congr! 2; abel
lemma petal (A:Fin r→Lines L)(a b:Fin r→Axis)(ho:Odd L.val)(i:Fin r)(s:Axis)(co: Fin r→ Cover)(x y:Bin r):numDiff (i,s) (fun z=> parcelK A a b co z) x y = parcelK (update A i (forwardC L (A i) s)) a b co x y:=by
   let U j:=fling (A j) (a j) (b j) (co j+stepOut x j) (stepOut y j)
   let Q j:=fling (A j) (a j) (b j) (co j+stepOut (x+stint (i,s)) j) (stepOut y j)
   let V j:=fling ((update A i (forwardC L (A i) s)) j) (a j) (b j) (co j+stepOut x j) (stepOut y j)
   have hu j (h:j∈univ.erase i): Q j=U j :=by
      have hh:= ne_of_mem_erase h
      have he: stepOut (x+stint (i,s)) j=stepOut x j:=by ext p; change x (j,p)+Pi.single (M:=fun _=>ℤ) (i,s) 1 (j,p)=x (j,p); simp [Pi.single_eq_of_ne (show (j,p)≠(i,s) from fun h=>hh (Prod.mk.inj h|>.1))]
      unfold Q U; rw [he]
   have hv j (h:j∈univ.erase i): V j=U j:=by unfold V U; rw [update_of_ne (ne_of_mem_erase h)]
   have hh : V i= Q i-U i:=by
       unfold V Q U; rw [update_self]; have he : stepOut (x+stint (i,s)) i=stepOut x i+stint s:=by
          ext p; change x (i,p)+Pi.single (M:=fun _=>ℤ) (i,s) 1 (i,p) = _+Pi.single (M:=fun _=>ℤ) s 1 p; simp [Pi.single_apply];rfl
       rw [he, ← add_assoc,advance_petal _ _ _ ho s]
   change ((∏ i,Q i)-(∏ i,U i))=∏ i,V i
   rw [← mul_prod_erase _ Q (mem_univ i),← mul_prod_erase _ U (mem_univ i),← mul_prod_erase _ V (mem_univ i),prod_congr rfl hu,prod_congr rfl hv,hh,sub_mul]
end YM.OPE.Flume
