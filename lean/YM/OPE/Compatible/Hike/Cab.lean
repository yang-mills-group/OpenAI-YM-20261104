      rw [linkZ A x y V hs hr H,linkZ A x y V hs hr H]; dsimp only; let Q:= isolate V (bramble V) p.val q.val x y; have hp: isolate V (bramble V) (trellisA G h p).val q.val x y= (fun i=> Ū*Q i):=by
          funext i; change (Vtap (Candy G h p.val) x _)* Vtap q.val y _= _; rw [Speel]; exact mul_assoc Ū _ _
      rw [hp]; exact coin_F _ _ _ _ Q (isolateB _ _ _ _ _ _) (Lid.hat_toll _ H)
