lemma HoldP (S:StepData cκ f)(A:Alps K T i v)(U:Boxes G S.patch S.kernel) (P:Muse G) (hb:Tide P m k r)(g:Train j)(h':4 ≤ j){N:ChartRatio G}(hN:LocalRatio N)(hS:Paver.Paid S.patch S.kernel U A N k 5 m a b)(hx:0≤a) (H:Odd S.ratio.count.val)(t:S.Choices)(y) (l) (F:FibreRep S H U t A y b)(hp: licensed S H U A.clip A.live l A.sky y)(x:Site cκ)(θ:Phase)(ℓ:ℕ):
       Spectre (Vessel Z g G cκ h') (Chart.tangent G (Body 1 cκ)) ((skry (TracePay S H U A t y N m P b x F) θ)- (skry (inkM (Paver.sculpt S.patch S.kernel U A N b P m) m x) θ)) ℓ ((a*r/(cκ.val:ℝ))* censusE G Z h' (glideZ m) 2):=by
            match S with
            | ⟨P',K',hZ⟩=>
                have he:f= cκ*P'.L:= PNat.eq hZ -- f binder shadow; fix
                subst f; exact held_B g h' m hN hS hx P hb l y hp t F x θ
end
