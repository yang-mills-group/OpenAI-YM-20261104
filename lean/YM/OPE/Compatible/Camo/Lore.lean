open Stroke Ibis Borealis Borealis.Galea Lav
variable {L:Host K T} {b a y W:ℝ}{τ:Phase→ℕ}(V:Train j)(hv:4 ≤ j) (C0:CoT L)(Y:Crown.Viewer L){A:ChartRatio G}(hA:LocalRatio A)
-- algebra extraction one-step.Ux.G signs
local notation "Bθ"=> Vessel K.K V G L.c hv
local notation "Yθ"=>Chart.tangent G (Body 1 L.c)
variable (hx:Aware (k+6) τ)(ht:4 ≤ L.i) (X:solar G (k+6) τ)(ho:Y.x=L.Z.ratio.embed C0.x)(hY:Viewer.Pledge Y v (k+6))(h:C0.Note u (k+6))
variable (hy:Licence (Vpass L) (united (Vessel K.K V G L.c hv) L.F.L.Q) L.A.gear K.K)
include hA ho hy in
lemma pullS (w:ℝ)(θ:Phase)(hW:0≤w): Spectre Bθ Yθ (skry (GPY L (Y.scoreV W) A-TracePay L.Z L.H L.U L.A L.k L.g A (k+6) (Goan (Rpaper ht Y W hY hx)) L.b C0.x L.F) θ) k w:=by -- θ adjust
       let H:= Thrill ht Y W hY hx Bθ Yθ hy hA _ ho; have he:= (H.color θ); exact (Spectre.back (he.block.points (by have h:=θ.isLt; omega)) (Ppu _ _ he.hW)).widen hW
lemma spinS {Kw:ℝ}(w:ℝ)(hW:0≤w)(θ:Phase): Spectre Bθ Yθ (skry (C0.hymn Kw b - inkM (Goan (vintage G hx b (C0.Ross V hv Kw h hx))) (k+6) C0.x) θ) k w:=by
        rw [CoT.Day C0 V hv Kw b h hx,add_sub_cancel_left]; have hz:=CoT.Lodge C0 V hv Kw b h θ; exact (Spectre.back hz.block (Ppu _ _ hz.hW)).widen hW
end
