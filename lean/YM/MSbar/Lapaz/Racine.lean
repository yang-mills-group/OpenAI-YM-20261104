      (hK': t* cloudK n1 p A''.m A''.δD A''.payQ +A''.payΔ+ A''.nameP ε p n1 t ≤ 1/2) :
       |Rota.resample F (board F X) (woolModel F X J R Y v W ν A B) (I! A B) (Set.indicator (I! A B) (rave S (t⁻¹^2) t R L Z)) U' - localW F R v J χ X Y U' t Z H' p g s (cycleP F v L)|≤ A''.stamp p n1 t ε ε1:=by
     have h':Vows G R H' χ F v p s0 t _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _:=hS; let D':= A''; have h₀: (0:X₀) ∈ S!:=born F R v J χ X Y U' t Z h ht hU; let V₀:= S!; have hK(x:SpaceP F X G)(hx:x∈V₀):‖x‖ ≤ R₀:=by apply le_of_mul_le_mul_left _ ht; nth_rw 1 [←Real.norm_of_nonneg ht.le]; rw [←norm_smul]; exact ((h.exports U' hU t ht).2.1 _ hx).trans hℋ
     obtain ⟨hq,hf⟩:= honorM F R v J Q χ X Y U' t Z h ht hU H' p L A' a x0 hv hS hp hX hR hT hh hχ hg ‹S.patch.Branches ..› ha hQ hd hf hx hw ho he (fun i hi=>hG i hi|>.1) -- includes ht. params
     let Q₁:= α' (Rewind Q' (A₀)); have hL₁ : ∀ i:SpaceP F X G, Belt p ((α' (Rewind Q' A₀)) i) ≤ A''.payQ * (1+‖i‖)^A''.m ∧ Belt p ((α' (cycleP F v L)) i) ≤ A''.payH*(1+‖i‖)^A''.m:=by
        have hh :0 ≤ A''.payQ:=by apply le_trans _ hφ; unfold loftM; have he':=hY _ le_rfl|>.1.1; positivity
        have hg :0 ≤ A''.payH:=by apply le_trans _ hc; have hp:= (Belt_pos p _).trans (hf 0); simpa only [norm_zero,add_zero,one_pow,mul_one] using hp
        intro i; refine ⟨?_,?_⟩
        · refine (portion F R v J X Y U' t Z i p Q' hY ha (hG 0 h₀|>.1)).trans ?_; apply mul_le_mul hφ (pow_le_pow_right₀ (le_add_of_nonneg_right (norm_nonneg i)) hM) (pow_nonneg (by positivity) _) hh
        exact (hf i).trans (mul_le_mul hc (pow_le_pow_right₀ (le_add_of_nonneg_right (norm_nonneg i)) hM) (by positivity) hg)
