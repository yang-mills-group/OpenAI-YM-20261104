      (hℬ:A''.payQ * (1+R₀)^A''.m ≤ A''.payP)(hℳ:A''.payH*(1+R₀)^A''.m ≤ A''.payT)
      (hi:t*A''.payP ≤ A''.mark)
      (hr : A'.cost t p G S.patch (keepB F X G).card (keepF F X).card ≤ ε)
