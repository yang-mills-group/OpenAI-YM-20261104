       exact ⟨h₁.trans ((mul_le_mul_of_nonneg_left he hv).trans hℬ),h₂.trans ((mul_le_mul_of_nonneg_left he ht).trans hℳ)⟩
     exact fun i hi=>(Jade.logVic F R v J Q χ X Y U' t Z e l ρ h ht 0 i hU H' p hβ hi h₀ hχ hΩ hg hF ‹S.patch.Branches ..› hs₀ hξ s g h' hv h1 hm hZ hG).trans hr
