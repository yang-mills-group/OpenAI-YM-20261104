import YM.MSbar.Grid.Reach

/-! Continuum sewing identities after passing group grids. Include commutator with kinetic linear
transport generated by Ward; transfer to evanescent calculus to be performed separately. -/
set_option autoImplicit false
noncomputable section
namespace YM.MSbar.Loops
open Function Finsupp Super Finset Filter Set MeasureTheory
open scoped BigOperators Classical Topology
variable {C M:Type*} [AddCommGroup M] [MeasurableSpace M] [TopologicalSpace M] {μ:Measure M} (s:Snap M μ)
  {I:Finset C} {f g:Amps C M}{k d e : Bit}{p : C→Bit} [IsTopologicalAddGroup M]
  [T2Space M] [FirstCountableTopology M] [BorelSpace M] [IsLocallyFiniteMeasure μ]
  {R : Row C M} {P B A : Line C M} (hP : Supported P I) (hp:Pace p I 0 P) (hB : Supported B I)(hb:Pace p I k B)
  (hR: Kinetic p I k R) (H:∀ i j, Continuous (R i j))
  (hf : Arc f)(hQ : Quiet f)
local notation "Φ" => (lift (M:=M) p)
namespace Supported
section
include s hf hQ hB hb
lemma bears (hh:Homogeneous Φ d f): Homogeneous Φ (k+d) (loop μ I B f):=by
    refine ((Arc.copies (B:=s) hf hQ).travel hB).homogeneous (fun i=> (((hb.cells (s.layer i)).homogeneous hh).scaling _))
lemma wears (hg:Arc g)(hq:Quiet g)(hh:Homogeneous Φ d f) (hj:Homogeneous Φ e g): Homogeneous Φ (k+d+e) (tree p I d B f g):=by
    let U:=Arc.copies (B:=s) hf hQ; exact (U.tree (hg.copies hq) hB p d).homogeneous fun n=> (hb.cells (s.layer n)).loss hh hj
lemma symmetry (hg:Arc g)(hq:Quiet g)(hh:Homogeneous Φ d f)(hj:Homogeneous Φ e g): tree p I d B f g= sign d e • tree p I e B g f:=by
    have U:=Arc.copies (B:=s) hf hQ; have V:=Arc.copies (B:=s) hg hq
    exact (U.tree V hB p d).copies_eq ((V.tree U hB p e).scale (sign d e)) fun n=>(hb.cells (s.layer n)).swap hh hj
local notation "x" => tree p I 0 P
local notation "y" => tree p I 0 B
local notation "b" => loop μ I B
local notation "a" => loop μ I P
include hp hP
lemma straight (hh:Homogeneous Φ d f) : a (b f)=b (a f):=by
    let U:=Arc.copies (B:=s) hf hQ
    refine ((U.travel hB).travel hP).copies_eq ((U.travel hP).travel hB) fun n=>?_ ; simp only [twig,LinearMap.smul_apply,map_smul]; rw [(hp.cells (s.layer n)).linear (hb.cells (s.layer n)) hh]
lemma quadratic (hh:Homogeneous Φ 0 f): a (y f f)+(2:ℂ) • x f (b f)= b (x f f)+(2:ℂ) • y f (a f):=by
    let U:=Arc.copies (B:=s) hf hQ
    refine (((U.tree U hB p 0).travel hP).plus ((U.tree (U.travel hB) hP p 0).scale (2:ℂ))).copies_eq (((U.tree U hP p 0).travel hB).plus ((U.tree (U.travel hP) hB p 0).scale (2:ℂ))) (fun n=> ?_)
    simp only [twig,LinearMap.smul_apply,map_smul,Pi.add_apply,Pi.smul_apply]; rw [smul_comm (2:ℂ) (↑(s.δ n):ℂ),smul_comm (2:ℂ) (↑(s.δ n):ℂ),← smul_add,← smul_add];exact congr_arg _ ((hp.cells (s.layer n)).quadratic (hb.cells (s.layer n)) hh)
lemma triple (hh:Homogeneous Φ 0 f): x f (y f f)= y f (x f f):=by
    let U:=Arc.copies (B:=s) hf hQ; exact (U.tree (U.tree U hB p 0) hP p 0).copies_eq (U.tree (U.tree U hP p 0) hB p 0) (fun n=> (hp.cells (s.layer n)).cubic (hb.cells (s.layer n)) hh)

-- use dot high, B = dot low as given.
include hR H
lemma linear (he:B=shift p I k R P): (rotate hR).lift (a f) - a ((rotate hR).lift f)=b f:=by
    let U:=Arc.copies (B:=s) hf hQ; refine (((U.travel hP).kinetic hR H).minus ((U.kinetic hR H).travel hP)).copies_eq (U.travel hB) (fun n=>?_)
    simp only [Pi.sub_apply,twig,LinearMap.smul_apply,map_smul,← smul_sub]
    rw [Transport.commute _ (hp.cells _),bank,← he]
lemma rate (he:B=shift p I k R P)(hh:Homogeneous Φ 0 f) : (rotate hR).lift (x f f)= y f f+(2:ℂ) • x f ((rotate hR).lift f):=by
    let U:=Arc.copies (B:=s) hf hQ; apply ((U.tree U hP p 0).kinetic hR H).copies_eq ((U.tree U hB p 0).plus ((U.tree (U.kinetic hR H) hP p 0).scale (2:ℂ)))
    intro t; exact (rotate hR).rates (hp.cells (s.layer t)) (hb.cells (s.layer t)) (by rw [bank,he]) hh
end
end Supported
end YM.MSbar.Loops
