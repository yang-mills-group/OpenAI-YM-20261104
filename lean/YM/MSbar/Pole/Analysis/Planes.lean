import YM.MSbar.Pole.Analysis.Capacity
import Mathlib.Analysis.Calculus.FDeriv.Symmetric

/-! Holomorphic dependence in the dimensional parameter coexists with real variables.
Every tangent test passes through the Cauchy Riemann identities. For clarity use a plane
direction rather than product reassociation. -/

noncomputable section
set_option autoImplicit false
namespace YM.MSbar.Pole
open Function Set Filter MeasureTheory
open scoped Topology ContDiff Classical
variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
variable {τ : Set E} {f : E → ℂ} (J J' : E)

/-- CR in plane generated by (J,J'), no chart junk derivatives without smoothness. -/
def CR (f : E → ℂ) (x : E) := fderiv ℝ f x J' = Complex.I * fderiv ℝ f x J
variable {J J'}
lemma tandem {j : ℂ→E} {z : ℂ} (D : ℂ→L[ℝ] E) (hj : HasFDerivAt j D z)
    (hf : DifferentiableAt ℝ f (j z)) : CR (D 1) (D Complex.I) f (j z) ↔ DifferentiableAt ℂ (f ∘ j) z := by
  have hh := hf.hasFDerivAt.comp z hj
  rw [CR,differentiableAt_complex_iff_differentiableAt_real,and_iff_right hh.differentiableAt,hh.fderiv]
  rfl
lemma coordinates {U : ℂ × E → ℂ} {z : ℂ} {x : E} (hf : DifferentiableAt ℝ U (z,x)) :
    CR (1,(0:E)) (Complex.I,0) U (z,x) ↔ DifferentiableAt ℂ (fun v => U (v,x)) z :=
  tandem (ContinuousLinearMap.inl ℝ ℂ E) ((hasFDerivAt_id (𝕜:=ℝ) z).prodMk (hasFDerivAt_const ..)) hf

/-- Constant real-direction derivative, for easy permutation of differentiated variables. -/
def fieldD (v : E) (f : E → ℂ) (x : E) := fderiv ℝ f x v
lemma field_cr {p q : Price E} {U : Set E} (o : IsOpen U) (h : Packet U p q f) (hh : ∀ x∈U,CR J J' f x)
    (v : E) {x : E} (hx : x∈U) : CR J J' (fieldD v f) x := by
  have hf := (h.fderiv.smooth x hx).differentiableAt (by simp)
  let H := fderiv ℝ (fderiv ℝ f) x
  let I := Complex.I
  have he (y : E) : HasFDerivAt (fieldD y f) ((ContinuousLinearMap.apply ℝ ℂ y).comp H) x :=
    ((ContinuousLinearMap.apply ℝ ℂ y).hasFDerivAt).comp _ hf.hasFDerivAt
  have hb : ContDiffAt ℝ 2 f x := h.localn 2 hx
  have hs := hb.isSymmSndFDerivAt (by simp)
  have ht : fieldD J' f =ᶠ[𝓝 x] fun x => I*fieldD J f x := mem_of_superset (o.mem_nhds hx) (fun y hy => hh y hy)
  have hv := ((he J).const_mul I) -- const_mul permits ℂ mul over ℝ?
  rw [CR,(he v).fderiv]
  change H J' v=I*H J v
  rw [hs.eq,hs.eq J]
  simpa using congr_arg (fun b : E →L[ℝ] ℂ => b v) ((he J').unique (hv.congr_of_eventuallyEq ht))

lemma integral_cr [FiniteDimensional ℝ E] {Z : Type*} [MeasurableSpace Z] {μ : Measure Z} {F : Z → E → ℂ}
    {p q : Price E} (h : Barrel μ τ p q F) {x : E} (hx : x∈τ) (hh : ∀ᵐ u ∂μ,CR J J' (F u) x) :
    CR J J' (fun x => ∫ u,F u x ∂μ) x := by
  rw [CR,(h.exchange hx).fderiv, ContinuousLinearMap.integral_apply (h.derives.integrable hx),
    ContinuousLinearMap.integral_apply (h.derives.integrable hx), ← integral_const_mul]
  exact integral_congr_ae hh
end YM.MSbar.Pole
