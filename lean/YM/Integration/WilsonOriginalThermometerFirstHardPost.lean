theorem received_first_join {depth:ℕ} (test:R.Mode→Prop) {v:V}
    (rests:∀ t:R.Mode,test t→v∈t.val)
    (tariff:Lyric.radiusCost W L (U.p.supportExponent-U.p.supportExponent/8))
    (apart:∀ t:R.Mode,test t→∃a∈t.val,∃b∈t.val,
      depth*(4*U.p.B+2)+2*U.p.B ≤ separation (P.origin a) (P.origin b))
    {gross:ℝ} (earned:WilsonRootedKioskOccupiedSlip.Gross bornRow w Qb (R'.p.supportExponent+1) gross)
    (margin:0<tW) (extra:ℝ) :
    letI:=Scene.crewC X S.ratio S' hS
    let factor:=WilsonRootedKioskFreeRadius.radius extra shiftPrice gross tW
    let shift:=WilsonRootedKioskSlipCharge.roll (Sp) bornRow.shade
    let erased:=WilsonOriginalSeparatedHardSuccessor.without H uV Q (Patrol.picture X T) w
      Kp hw hq hV.quota z y shift test
    WilsonOriginalForcedMarkerPrice.Invoice erased (Kiosk.Second.canopy firstRead shift uV.second) w
      R'.p.B R'.p.supportExponent ((Real.exp ((U.p.supportExponent/8)*depth))⁻¹*(2*(factor^E.count*uB))) := by
  letI:=Scene.crewC X S.ratio S' hS
  have income:=Permit.occupied_inputs (X:=X) (T:=T) (w:=w) (tV:=tV) (hq:=hq) (y:=y) (H:=H)
    (M0:=M0) (hβ:=hβ) (E:=E) (Q:=Q) (D0:=D0) (S':=S') (hS:=hS) (Yv:=Yv) (k':=k')
    (hV:=hV) (hP:=hP) (hK:=hK) (hl:=hl) (Y0:=Y0) (uV:=uV)
  exact WilsonOriginalSeparatedHardRadius.physical H uV Q (Patrol.picture X T) w Kp hw hq
    hV.quota z y (Sp) test bornRow.shade rests tariff apart income.1
    (WilsonOriginalSignedFreshPermit.shade_gross bornRow earned) margin extra

def first_connections (fee extra:ℝ)
    (out:Hard (Affinity.Wallet actors) R'.p R'.activities.forced R'.activities.K
      (S.ratio.parent ∘ P.origin) R) : Prop :=
  letI:=Scene.crewC X S.ratio S' hS
  let shift:=WilsonRootedKioskSlipCharge.roll (Sp) bornRow.shade
  let factor:=WilsonRootedKioskFreeRadius.radius extra shiftPrice fee tW
  out=Kiosk.Second.canopy firstRead shift uV.second ∧ ∀(d:ℕ) (test:R.Mode→Prop) (v:V),
    (∀ t:R.Mode,test t→v∈t.val) →
    Lyric.radiusCost W L (U.p.supportExponent-U.p.supportExponent/8) →
    (∀ t:R.Mode,test t→∃a∈t.val,∃b∈t.val,
      d*(4*U.p.B+2)+2*U.p.B ≤ separation (P.origin a) (P.origin b)) →
    let without:=WilsonOriginalSeparatedHardSuccessor.without H uV Q (Patrol.picture X T) w
      Kp hw hq hV.quota z y shift test
    WilsonOriginalForcedMarkerPrice.Invoice without out w R'.p.B R'.p.supportExponent
      ((Real.exp ((U.p.supportExponent/8)*d))⁻¹*(2*(factor^E.count*uB))) ∧
    (∃ amplified : Hard (Affinity.Wallet actors) R'.p R'.activities.forced R'.activities.K
        (S.ratio.parent ∘ P.origin) R,
      without.Paid w R'.p.B R'.p.supportExponent (factor^E.count*uB) ∧
      amplified.Paid w R'.p.B R'.p.supportExponent (factor^E.count*uB) ∧
      WilsonOriginalForcedMarkerMerger.Related v
        (↑((Real.exp ((U.p.supportExponent/8)*d))⁻¹):ℂ) without out amplified) ∧
    ∀ (J:Type) (lamps:Lamps (Affinity.Wallet actors) J G R'.p (S.ratio.parent ∘ P.origin) R)
      (t:Affinity.Wallet actors) (Z:Config G c),
      let kept:Gallery (Affinity.Wallet actors) J (S.ratio.parent ∘ P.origin) R' R:=⟨lamps,out⟩
      let gone:Gallery (Affinity.Wallet actors) J (S.ratio.parent ∘ P.origin) R' R:=⟨lamps,without⟩
      kept.density t Z-gone.density t Z=
        (Complex.ofReal (Real.exp (R'.exponent Z))) •
          (Poly.pass (lamps.log t Z)*∑' I:Finset ℕ,
           WilsonOriginalSignedHardWithdrawal.selected without out t Z I)

omit [∀ v, Module ℝ (Film v)] [∀ v, AddCommGroup (Film v)] in
include hl in
theorem witnesses {gross:ℝ} (earned:WilsonRootedKioskOccupiedSlip.Gross bornRow w Qb (R'.p.supportExponent+1) gross)
    (margin:0<tW) (extra:ℝ) :
    letI:=Scene.crewC X S.ratio S' hS
    first_connections (actors:=actors) (X:=X) (T:=T) (w:=w) (tV:=tV) (hq:=hq) (y:=y)
      (H:=H) (M0:=M0) (hβ:=hβ) (E:=E) (Q:=Q) (D0:=D0) (S':=S') (hS:=hS) (Yv:=Yv)
      (k':=k') (hV:=hV) (hP:=hP) (hK:=hK) (Y0:=Y0) (uV:=uV) bornRow gross extra
      (Kiosk.Second.canopy firstRead (WilsonRootedKioskSlipCharge.roll (Sp) bornRow.shade) uV.second) := by
  letI:=Scene.crewC X S.ratio S' hS
  refine ⟨rfl,?_⟩
  intro d test v rests tariff apart
  have income:=Permit.occupied_inputs (X:=X) (T:=T) (w:=w) (tV:=tV) (hq:=hq) (y:=y) (H:=H)
      (M0:=M0) (hβ:=hβ) (E:=E) (Q:=Q) (D0:=D0) (S':=S') (hS:=hS) (Yv:=Yv) (k':=k')
      (hV:=hV) (hP:=hP) (hK:=hK) (hl:=hl) (Y0:=Y0) (uV:=uV)
  refine ⟨?_,?_,?_⟩
  · exact received_first_join (actors:=actors) (X:=X) (T:=T) (w:=w) (tV:=tV) (hq:=hq) (y:=y)
      (H:=H) (M0:=M0) (hβ:=hβ) (E:=E) (Q:=Q) (D0:=D0) (S':=S') (hS:=hS) (Yv:=Yv)
      (k':=k') (hV:=hV) (hP:=hP) (hK:=hK) (hl:=hl) (Y0:=Y0) (uV:=uV) bornRow
      test rests tariff apart earned margin extra
  · refine WilsonOriginalRaisedHardPost.issued H uV Q (Patrol.picture X T) w Kp hw hq
      hV.quota z y (Sp) test bornRow.shade rests tariff apart income.1
      (WilsonOriginalSignedFreshPermit.shade_gross bornRow earned) margin extra
  · intro J lamps t Z
    have heard:=WilsonOriginalFirstJoinSource.physical H uV Q (Patrol.picture X T) w Kp hw hq
      hV.quota z y (Sp) test bornRow.shade rests tariff apart income.1
      (WilsonOriginalSignedFreshPermit.shade_gross bornRow earned) margin extra lamps
    exact heard.2 t Z

