/-- The fixed original semester provides the canonical period salary on its own kit. -/
def seller (G:Gauge):ℕ → Gear G → ℝ:=(WilsonVacuumPreResetFiniteHeatHierarchy.original G).choose

theorem financed (paid:WilsonOriginalAllOrderCourse.Paid.{u} a simple ε (prepared s) R T W):
    FundedMarkedCoverRows.prices (seller G) R.kit:=paid.billsPaid.1

theorem original (paid:WilsonOriginalAllOrderCourse.Paid.{u} a simple ε (prepared s) R T W)
    (paths:FundedOriginalVacuumPaths.prices R.kit)
    (role:Fin 3 → Fin 3)(D:Fin 3 → ℕ)(pt:Fin 3 → Chamber)
    (caps:Fin 3 → ℝ)(nonneg:∀v,0 ≤ caps v)(hk:∀v,grades role v < D v)
    (φ:Test 3)(requested A:ℕ)(tol η:ℝ)(tp:0 < tol)(ep:0 < η)(school:ℕ)(tube:LinkTube G)
    (pieces physical:ℕ)(p:Bool → ℕ)(span:U → ℕ)(lag:U → Bool → ℕ):
    let n:=3
    let front:Fin n:=0
    let k:=grades role
    let κ:∀v:Fin 3,Knob (D v):=fun v=>contact (D v)
    let power:=fun _:Fin 3=>0
    let target:=WilsonAddressedPublicFirstRoseTerms.order R requested
    let P:=target+1
    let menu:=terms k power P
    let ask:=programme k power P
    let L:=R.family.path.levels
    let firstPeriod:=appointment R simple k D pt (fun _=>4) tube ask.order ask.order menu.target menu.precision
      (seller G) (financed paid) (WilsonAddressedPublicFirstRanks.original k P).2.2.2.1
    ∃book:WilsonOriginalCensusPhysicalAttendance.Room (prepared s) R simple,
    ∃price:Credit,∃B:ℝ,1 ≤ B ∧ ∀ᶠ o:ℕ in atTop,
    WilsonSingleHardRadius.first R simple ≤ o ∧
    WilsonOriginalCensusCanonicalAppointedClock.opening R simple (seller G) (financed paid) paths
      (Burn.horizon ask.vac) ≤ o ∧
    ∃resident:(N:ℕ) → o ≤ N → Day (prepared s) R simple ask.school o N,
    (∀N:ℕ,∀live:o ≤ N,∃Z:ℕ → SeriesA G,QuietAt (resident N live) price Z) ∧
    ∀ᶠ anchor:ℕ in atTop,∃V:Realm G (menu.order+1) Credit.leanC,∃draw:V.draws=L,
      V.paid=R.metals.O ∧ V.anchor=anchor ∧ ∀δ:ℝ,0 < δ → δ ≤ 1 → ∀ᶠ m:ℕ in atTop,
      ∃old:o ≤ m,∀days:ℕ,3 ≤ days →
      L.S.scale (m+days)-L.S.scale m ≤ (A:ℝ)*(1+Real.log (L.clock.hatBeta (m+1))) →
      let K:=m+days
      ∀ᶠ per:ℕ in atTop,∀N:ℕ,∀valid:K ≤ N,
        let H:=Real.sqrt (R.family.path.β N per (m+1))
        let rate:=H^δ*B^n
        let oldDay:=resident N (by omega)
        Purchased (per:=per) (V:=V) (draw:=draw) (rate:=rate) (allowance:=δ) power P book oldDay κ pt K m valid
          (fun j=>base B caps power (L.clock.hatBeta (j+1))) old φ caps A target η ∧
        WilsonIndependentCollarDatedTeachers.At s R simple V D k (Burn.horizon ask.vac) school δ tube pieces physical p span lag m ∧
        V.anchor ≤ m+1 ∧
        WilsonOriginalCensusSparseRosterOpening.first R simple tube k k (charges power) menu.order menu.order
          menu.target menu.precision menu.enough ≤ m+1 ∧
        Period (R:=R) (V:=V) (per:=per) (grades:=k) power P κ pt K m caps ∧
        WilsonOriginalOneArmCurrentClock.first R simple k power P (2*A) tol η tp ep (Nat.zero_lt_of_lt front.isLt) ≤ m ∧
        R.family.S.a (m+1)/R.family.S.a K ≤ (L.clock.hatBeta (m+1))^(2*A) ∧
        WilsonAddressedPublicFirstOrigin.ceiling R k ≤ menu.order ∧
        WilsonAddressedPublicFirstRoseTerms.At R simple k P (2*A) tol η tp ep (m+1) (K-2) ∧
        WilsonIndependentCollarDatedTeachers.At s R simple V D k (Burn.horizon ask.vac) school δ tube
          pieces physical p span lag (K-2) ∧
        firstPeriod.first ≤ K-2+1 ∧
        firstPeriod.period (K-2+1)
          (WilsonAddressedPublicFirstExtent.extent V.draws (0:Fin 3 → Cover) m (K-2-m)) ≤ per:=by
  classical
  intro n front k κ power target P menu ask L firstPeriod
  have deep (t:Hot (Stock.census (Fin 3))):0 < mass k t.val.val:=by
    change 0<∑a∈t.val.val,k a
    obtain ⟨v,hv⟩:=t.property
    exact Finset.sum_pos' (fun _ _=>Nat.zero_le _) ⟨v,hv,positive role v⟩
  obtain ⟨book,price,B,one,selection⟩:=WilsonReceivedChronologicalFixedWindow.original paid paths n front k D κ pt caps power
    nonneg hk P (2*A) tol η tp ep school tube pieces physical p span lag
  refine ⟨book,price,B,one,?_⟩
  filter_upwards [selection,eventually_ge_atTop (WilsonOriginalCensusCanonicalAppointedClock.opening
    R simple (seller G) (financed paid) paths (Burn.horizon ask.vac))] with o available initial
  obtain ⟨first,resident,quiet,realms⟩:=available
  refine ⟨first,initial,resident,quiet,?_⟩
  filter_upwards [realms] with anchor issued
  obtain ⟨V,draw,metals,center,terms⟩:=issued
  obtain ⟨_C,_positive,fees⟩:=terms A
  refine ⟨V,draw,metals,center,?_⟩
  intro δ dp ds
  filter_upwards [fees δ dp ds,eventually_ge_atTop (eventually_atTop.mp
    (WilsonReceivedChronologicalFixedAperture.original R simple A)).choose,
    eventually_ge_atTop (WilsonReceivedChronologicalDates.stages R simple (2*A)).choose,
    eventually_ge_atTop (WilsonOriginalOneArmCurrentClock.first R simple k power P (2*A) tol η tp ep
      (Nat.zero_lt_of_lt front.isLt)),
    (tendsto_add_atTop_nat 1).eventually (WilsonAddressedPublicFirstRoseTerms.original R simple k P
      (2*A) tol η tp ep),eventually_ge_atTop firstPeriod.first] with m funded mesh clocked current stages released
  obtain ⟨old,older,bought,sparse,teachers,windows⟩:=funded
  refine ⟨old,?_⟩
  intro days many spanFit K
  obtain ⟨rates,_incomes,ports⟩:=windows days many spanFit
  filter_upwards [ports,eventually_ge_atTop (firstPeriod.period (K-2+1)
    (WilsonAddressedPublicFirstExtent.extent V.draws (0:Fin 3 → Cover) m (K-2-m)))] with per opened wide
  intro N valid H rate oldDay
  have qualified:Period (R:=R) (V:=V) (per:=per) (grades:=k) power P κ pt K m caps:=⟨rates,opened.1⟩
  have grants:=(opened.2 N valid).1
  obtain ⟨Z,paidQuiet⟩:=quiet N (by omega)
  have born:m+1 ≤ K-2:=by dsimp [K]; omega
  refine ⟨?_,teachers m le_rfl,older.trans (Nat.le_succ m),sparse.trans (Nat.le_succ m),qualified,current,?_,
    WilsonAddressedPublicFirstRoseTerms.ranked R requested role,stages _ born,
    teachers _ (Nat.le_trans (Nat.le_succ m) born),released.trans (by omega),wide⟩
  · exact WilsonReceivedChronologicalFixedPlaced.original (R:=R) (schedule:=s) (V:=V) (draw:=draw)
      (rate:=rate) (allowance:=δ) (power:=power) (P:=P) (house:=book) (day:=oldDay)
      (κ:=κ) (pt:=pt) (top:=K) (first:=m) (valid:=valid)
      (toll:=fun j=>base B caps power (L.clock.hatBeta (j+1))) (old:=old)
      φ caps nonneg (by omega) (fun cells seed test amount=>grants cells seed 0 test deep amount)
      paidQuiet tube teachers older sparse qualified first (Nat.zero_lt_of_lt front.isLt) A tol η tp ep
      bought mesh spanFit paid.support clocked target rfl
  · exact (eventually_atTop.mp (WilsonReceivedChronologicalFixedAperture.original R simple A)).choose_spec
      m mesh K spanFit

end YM.Integration.WilsonAddressedPublicFirstRoseCampus
