/-- Keep the complete finite original marker and engineering restoration on
the actual independently published proper face at this relative position. -/
def published (s:(J).Mode)(bound:‖WilsonOriginalTwoFlatRosePublishedFigure.profile D s.val A‖≤1)(late p:ℕ)(θ:ℝ):ℂ:=
  restoration R (f:=f) (n:=n) (grades:=grade) x cash s*
    WilsonOlderFreshSoftRoseMarket.row (R:=R) D V s.val N (f+n) c late (i+1)
      (enrolled R D V draw N per c (ck.trans upper) (raw) s.val (test D s.val κ pt A bound))
      (regulatorRun R.family N per (f+n)) (fun i=>entire R (grade i) (f+n) (N,per) (w i)) p θ false

include paid in
theorem original (simple:G.Simple)(ratio:LocalRatio R.metals.O)(center:(X) 0=0)
    (joinedAt:Joined R o (fk) upper (vc.trans ck))(compact:Rolled R o (fk) upper vc ck)
    (s:(J).Mode)(bound:‖WilsonOriginalTwoFlatRosePublishedFigure.profile D s.val A‖≤1)(late p:ℕ)(θ:ℝ):
    socket s p θ=published R D (i:=i) V draw κ pt A o upper ck x w cash s bound late p θ:=by
  unfold WilsonOriginalTwoFlatRoseMerFigure.figure published
  apply congrArg (fun z:ℂ=>restoration R (f:=f) (n:=n) (grades:=grade) x cash s*z)
  have path:(native)=(tape):=(joined draw _).trans joinedAt.1
  have grounded:site R (i:=i) o upper (cut) s=footprint R (pin R (fk) o) (vc.trans ck):=joinedAt.2 _
  rw [path,grounded]
  exact WilsonOriginalTwoFlatRosePublishedFigure.original R D s.val κ pt A V draw paid o (fk) upper
    vc ck bound simple ratio center compact w late p θ

include paid in
theorem positioned (o:Fin 3→Lattice.Cover){B r:ℝ}
    (size:∀a,‖R.family.S.gridPoint f (o a)‖≤B*r)(room:4*(B*r)<R.family.S.a c)
    (simple:G.Simple)(ratio:LocalRatio R.metals.O)
    (s:(J).Mode)(bound:‖WilsonOriginalTwoFlatRosePublishedFigure.profile D s.val A‖≤1)(late p:ℕ)(θ:ℝ):
    let z:=marks R (f:=f) (per:=per) o
    WilsonOriginalTwoFlatRoseMerFigure.figure R (i:=i) (cap:=c) (draw:=draw) κ pt z upper (cut) A x w cash s p θ=
      published R D (i:=i) V draw κ pt A z upper ck x w cash s bound late p θ:=by
  intro z
  have center:pin R ((fk).trans upper) z 0=0:=by
    change (R.family.S.toDepth _ per).embed (wrap _ (o 0-o 0))=0
    rw [sub_self,map_zero]
    exact (R.family.S.toDepth ((fk).trans upper) per).root.map_zero
  apply original R D V draw paid κ pt A z upper vc ck x w cash simple ratio center
    (WilsonOriginalTwoFlatRoseHousedDigits.positioned R o (fk) upper (vc.trans ck) size
      (room.trans_le (R.family.S.strictAnti.antitone vc)))
    (WilsonOriginalTwoFlatRoseCapturedDigits.positioned R o (fk) upper vc ck size room)

