/-- The same two original complete books hear every nonempty proper subface
and the full face on their one appointed wallet. Each retained order is tested
against every physical sparse direction on the original lower torus. -/
theorem original
    (siteU:higher.passport=port ((fine R (j+1) per)) ((chartIn (loose R.family.path.levels (j+1)) sites (cells (j+1)))))(namesU:higher.modelIndex=((s:(YM.Multi.Hot (Stock.census (Fin n))))×(words U s).Roster))
    (inkU:HEq higher.model (mounts U))(siteL:lower.passport=port ((coarse R (j+1) per)) sites)
    (namesL:lower.modelIndex=((s:(YM.Multi.Hot (Stock.census (Fin n))))×(words L s).Roster))(inkL:HEq lower.model (mounts L))
    (pass:Pass D Q R.alloy R.kit)(month:Scholar.Month R.rolls D Q R.alloy.delay)
    {quiet:ℕ → SeriesA G}(read:Read R N m (Burn.horizon k) quiet π Γ){τ cash:ℝ}
    (funded:Issued R N ((j+1)+1) (Burn.horizon k) (quiet ((j+1)+1)) τ cash)
    (legalU:Legal (AllOrder.Floe.Step.tape (Burn.horizon k+2)) (π ((j+1)+1)))
    (legalL:Legal (AllOrder.Floe.Step.tape (Burn.horizon k+2)) (π (j+1)))
    (simple:G.Simple)(fits:ou ≤ Burn.horizon k+1)(narrow:hu ≤ R.alloy.B.a.clock.J (j+1))(retained:ou ≤ q)
    (rates:WilsonOriginalCensusDatedHeldTariff.Rates R grades κ pt (j+1) top q)
    (within:WilsonOriginalCensusFaceAdmission.housed sites R (j+1) per)(gross wind:ℝ)
    (weight:∀s:(YM.Multi.Hot (Stock.census (Fin n))),‖∏w∈s.val.val,(wallet w).val‖*‖touch test s.val.val‖ ≤ gross)
    (opened:∀(s:(YM.Multi.Hot (Stock.census (Fin n))))(v:Fin (q+1)),WilsonOriginalCensusDatedPeriodOpening.Opened R (j+1) per
      (mass grades s.val.val+v.val) (rates.width s.val.val v) (rates.fare s.val.val v) gross wind)
    (height power E:ℕ)(horizon:3*height ≤ ou)(C:Fin n → ℝ)(paid:∀v,‖test v‖ ≤ C v)
    (diameter:ℕ)(covered:2*((univ:Finset (Fin n)).image sites).sup WilsonNeutralTwoPrintPathBoxHome.radius ≤ diameter)
    (selected:(u:Covers R.family.path.levels.S (j+1) ((coarse R (j+1) per))) → Forest (step R (j+1) u.val).ratio)
    (credit:∀s:(YM.Multi.Hot (Stock.census (Fin n))),WilsonOriginalCensusMeasuredStation.CreditAt R κ pt grades C (j+1) top q per diameter
      (((R.alloy.B.a.clock.hatBeta (j+1))^(near power ((WilsonOriginalCensusPhysicalLoad.head (sides grades grades) s.val)) E))⁻¹)):
    ∀(s:(YM.Multi.Hot (Stock.census (Fin n))))(v:Fin n)(e:ℕ),e+((WilsonOriginalCensusPhysicalLoad.head (sides grades grades) s.val)) ≤ 3*height → 
    ∀(Y:Stationary.Link G ((coarse R (j+1) per))),WilsonOriginalSparseDatedHeld.Sample
      ((higher.passport.coarser (R.family.path.levels.clock.op (j+1) per).ratio).origin v)
      ((Ψ (j+1)).p.B/32) (e+((WilsonOriginalCensusPhysicalLoad.head (sides grades grades) s.val))) Y → 
    WilsonOriginalSparseDatedCondition.heard R hk D Q π Γ Ψ books base ahead upperWord lowerWord upper low
      s (AllOrder.Floe.Step.tape (Burn.horizon k+2)) power E wind e Y:=by
  obtain ⟨upperBook,upperVote⟩:=WilsonNeutralTwoPrintPathVotedBook.mounted R hk D Q π Γ Ψ books
    (Nat.le_succ_of_le base) ahead grades ou hu su lawU higher wallet upper ux ug uo uh us ul uf
  obtain ⟨lowerBook,lowerVote⟩:=WilsonNeutralTwoPrintPathVotedBook.mounted R hk D Q π Γ Ψ books
    base ahead grades ol hl sl lawL lower wallet low lx lg lorder lh ls ll lf
  have uWord:=upper.atInput.symm.trans ((congrFun ul upper.x).trans
    ((congrArg lawU ux).trans (funext (upperBook.declared wallet))))
  have lWord:=low.atInput.symm.trans ((congrFun ll low.x).trans
    ((congrArg lawL lx).trans (funext (lowerBook.declared wallet))))
  subst upperWord; subst lowerWord
  rw [eq_of_heq upperVote,eq_of_heq lowerVote]
  exact WilsonNeutralTwoPrintPathPaidSparseFaces.original
