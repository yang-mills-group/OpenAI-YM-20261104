theorem original (simple:G.Simple)(slow:WilsonWindowReportingPace.Slow R.kit)
    (D:Fin 3→ℕ)(e width pow target:ℕ)(A:ℝ)(ap:0≤A):
    let w:=date R width (loss R pow target)
    Tendsto w atTop atTop ∧ ∃gate:ℕ,∀c≥gate,w c≤c ∧ ∀v≥gate,v≤w c →
      ∀(V:Realm G (e+1) Credit.leanC),V.anchor≤v →
      ∀(_draw:V.draws=L), V.paid=R.metals.O → V.y=zz (L) →
      (∀s:Faces,Dormitory V (mass (grade ∘ seat s.val) univ) 0 Credit.leanC) →
      ∀(N per f n:ℕ)(cut:f+n≤N),c≤f+n → v+1≤f+n → R.family.S.a c/R.family.S.a (f+n)≤(H c)^width →
      R.family.S.scale (f+n)-R.family.S.scale v≤A*(1+Real.log (H (v+1))) →
      ∀(req step:ℕ)(B:ℝ)(P:Panel R grade N per f (f+n) (Nat.le_add_right f n) cut req pow step B)
      (file:Filed R grade (f+n)),P.slot=file.station → P.axis=file.A N per →
      ∀(s:(Stock.census (Fin 3)).Mode),s.val.Nonempty →
      ∀(κ:(i:Fin 3)→Knob (D i))(pt:Fin 3→Chamber)(route:Digits L (Fin 3))(home:Fin 3→ Cover)
      (test:Case D)(q:ℕ),q≤e → ∀(θ:ℝ),|θ|≤1 → ∀(r:ℝ)(u:ℕ)(old:u≤f+n)(fee:ℝ),
      ‖observed R cut P s u old-
         figure R grade κ pt N per (f+n) c v route s.val (votes R grade (N:=N) (per:=per) file P.names P.turn) home (touch test s.val) q θ‖≤fee →
      ‖(∏i∈s.val,(r:ℂ)^grade i)*observed R cut P s u old-
         terminal R D V _draw cut P s κ pt route home test q θ r c (w c) v‖≤
        ‖∏i∈s.val,(r:ℂ)^grade i‖*(fee+quota (touch (fun i:s.val=>test i.val) (univ:Finset s.val))*
          (((max 1 B)^3*2^debt R pow)*(regulatorRun R.family N per (f+n))^target)):=by
  classical
  let w:=date R width (loss R pow target)
  obtain ⟨grows,gate,all⟩:=WilsonOlderFreshSoftSocketStationPanelWindow.original R simple slow D e width pow target A ap
  refine ⟨grows,gate,?_⟩
  intro c co
  obtain ⟨capped,window⟩:=all c co
  refine ⟨capped,?_⟩
  intro v vo vw V anchor draw paid heat housed N per f n cut ck vk gear span req step B P
    file station axes s active κ pt route home test q sub θ temp r u old fee issued
  have wallet:=window v vo vw V anchor draw paid heat housed N per f n cut ck vk gear span req step B P s.val active
  apply WilsonOlderFreshSoftSocketStationPanelCell.joined R D V draw paid cut P file station axes s κ pt route home test q θ r
    simple (RunFormalChain.fromRun R).receipt (vw.trans capped) ck old fee _ issued
  exact fun p=>wallet p q sub θ temp

end YM.Integration.WilsonOlderFreshSoftSocketStationPanelHearing
