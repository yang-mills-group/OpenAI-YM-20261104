/-- The deposited old joint row and a genuinely fresh field occupy the same
original chart with all inherited proper faces and a single quiet normalization. -/
theorem original (G:Gauge)(D k:ι → ℕ)(E H:ℕ):
    ∃fare:Gear G → ℝ,∃M:ℝ,0   ≤   M ∧ ∃d:ℕ,∀(R:Run G),G.Simple →
    WilsonPointChildFiledTest.Filed R → WilsonPointChildWindingHierarchy.Filed R →
    WilsonPointChildWindingSchool.Paid R.kit → WilsonReceivedCloseFundedHeat.Quiet R →
    ∀cash:ℕ → Gear G → ℝ,FundedMarkedCoverRows.prices cash R.kit →
    (∀ᶠj:ℕ in atTop,∀J,fare J    ≤    cash (R.family.path.levels.clock.J (j+1)) J) →
    ∀(u:ι → G.ColorIndex)(h:ι → ℕ)(depth:∀s,k s<h s)(_o:Loc G 1),
    ∀_tags:∀j n,(Flat.primary (R.family.path.levels.clock.op j 0).patch R.family.path.levels.clock.kernel n).Choices,
    ∀η:ℝ,0<η → ∀ᶠm:ℕ in atTop,∀N B per,m<N → m ≤ B →
    ∀(v₁ v₂:∀s,Letter (R.family.labels.level (k s)))(p₁ p₂:∀s,Scroll (h s)),
    ∀(L₁ L₂:∀s,ℝ →L[ℝ] Pen D ({s}:Finset ι))(T I:Finset ι),
    ∀y:ι → Cover,∀z:ι → Site (loose R.family.path.levels m).L,
    let A:=R.family.path.levels
    let O:=R.metals.O
    let n:=R.family.side m per
    let fund(s:ι):ℝ →L[ℝ] Pen D {s}:=if s∈T then L₁ s else 0
    let α:=placed (sources R u depth N (m+1) v₁ p₁) fund (chartIn (loose A m) y z)
    let β:=placed (sources R u depth B m v₂ p₂) L₂ y
    let K:=mounted T (logO A O m N α k) β
    let a(s:ι):=(1+‖fund s‖)*((A.clock.hatBeta (m+1))^η*‖physical (p₁ s)‖+(1+‖physical (p₁ s)‖))
    let b(s:ι):=(1+‖L₂ s‖)*((A.clock.hatBeta m)^η*‖physical (p₂ s)‖+(1+‖physical (p₂ s)‖))
    let A₀:=∑s,‖fund s‖*(A.clock.hatBeta (m+1))^η*‖physical (p₁ s)‖
    let C:=allowance M ((zz A m)^d) A₀ a b I
    (∀J⊆I,J⊆T → J.Nonempty → 4*crestCard y J<n.val) →
    Eu k K ∧ K ∅=0 ∧ 1 ≤ C ∧ ∀J⊆I,J.Nonempty → ∀e ≤ E,∀r ≤ H,∀x,
      ‖(repaint K J).1 n e r x‖ ≤ weights (fun _=>C) J ∧
      ‖(K J).1 n e r x-(repaint K J).1 n e r x‖ ≤ rate A m per*weights (fun _=>C) J:=by
  obtain ⟨fare,M,mp,d,prev⟩:=WilsonPointChildPlacedPortfolio.original G D k E H
  refine ⟨fare,M,mp,d,?_⟩
  intro R simple booked enrolled paid quiet cash buy salary u h depth o tags η eta
  let A:=R.family.path.levels
  have joint:=prev R simple booked enrolled paid quiet cash buy salary u h depth o tags η eta
  obtain ⟨j₁,extra⟩:=eventually_atTop.mp (WilsonPointChildPlacedIncome.original R simple booked enrolled paid u depth o tags (D:=D) E eta)
  obtain ⟨j₂,heat⟩:=eventually_atTop.mp ((WardBin.bell A simple).eventually_ge_atTop 1)
  filter_upwards [joint,eventually_ge_atTop (max j₁ j₂),WilsonVacuumPreResetFiniteHeatScale.clock A simple]
    with m noted late clock N B per live newLive v₁ v₂ p₁ p₂ L₁ L₂ T I y z L O n fund α β K a b A₀ C fits
  have older:=noted N per live v₁ p₁ y z fund
  have plant:=extra (m+1) (by omega) N per (by omega) v₁ p₁ (chartIn (loose L m) y z) fund
  have fresh:=extra m (by omega) B per newLive v₂ p₂ y L₂
  have rato:LocalRatio O:=(RunFormalChain.fromRun R).receipt
  have row:=legal T (step_L L O m N α k live simple rato plant.1) fresh.1 (logHush L O m N α k)
  have hp:0 ≤ L.clock.hatBeta (m+1)^η:=Real.rpow_nonneg (zero_le_one.trans (heat _ (by omega))) _
  have ap:0 ≤ A₀:=Finset.sum_nonneg (fun s _=>mul_nonneg (mul_nonneg (norm_nonneg (fund s)) hp) (norm_nonneg _))
  have z0:0 ≤ (zz A m)^d:=pow_nonneg (zero_le_one.trans clock.1) _
  have τ:0 ≤ rate A m per:=(Real.exp_pos _).le 
  have credit:=budget I M ((zz A m)^d) A₀ a b mp z0 ap (fun s=>(plant.2.2.1 s).le) (fun s=>(fresh.2.2.1 s).le)
  refine ⟨row.1,row.2,credit.1,?_⟩
  intro J sub awake e he r hr x
  have g:=credit.2 J sub awake
  by_cases received:J⊆T
  · have read:=older J awake (fits J sub received awake) e he r hr x
    have first:K J=(logO L O m N α k) J:=oldface T J received _ _
    change ‖Carp.plume ((K J).2 e r) n x‖ ≤ _ ∧ ‖(K J).1 n e r x-Carp.plume ((K J).2 e r) n x‖ ≤ _
    rw [first]
    exact ⟨read.1.trans g.1,(read.2.trans (mul_le_mul_of_nonneg_right g.2.1 τ)).trans_eq (mul_comm _ _)⟩
  · have read:=fresh.2.2.2 J e he r x
    have first:K J=β J:=newface T J received _ _
    change ‖Carp.plume ((K J).2 e r) n x‖ ≤ _ ∧ ‖(K J).1 n e r x-Carp.plume ((K J).2 e r) n x‖ ≤ _
    rw [first]
    exact ⟨read.1.trans g.2.2,read.2.trans (mul_le_mul_of_nonneg_left g.2.2 τ)⟩

end YM.Integration.WilsonPointChildReceivedIntake
