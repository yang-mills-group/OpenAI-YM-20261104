theorem original {η:ℝ} {birthF requested pole time:ℕ} {born:birthF≤j+1+1} {B:ℝ}
    (panel:Panel R d N per birthF (j+1+1) born live requested pole time B) (file:Filed R d (j+1+1))
    (station:panel.slot=file.station) (axis:panel.axis=file.A N per)
    (charged:WilsonReceivedChronologicalRosterAssay.Sold (R:=R) (simple:=simple) (d:=d) (P:=P)
      (school:=school) (day:=day) (live:=live) (lens:=lens) (pt:=pt) (toll:=toll) (old:=old)
      (classroom:=classroom) (adult:=adult) η)
    (active:first+1≤j+1+1) (captured:∀i,WilsonReceivedChronologicalMaterialSites.physical R (placed R fine site) active i=0)
    {df:ℕ}{frame:Frame G df} (section_:SectionData frame)(group:Hol G)
    {e:ℕ}(rested:m≤e)(heard:e≤first+1)(eligible:first+1≤j) :
    let w:=WilsonOriginalObservedRoseCorrectedWords.votes R d (N:=N) (per:=per) file panel.names panel.turn
    let H:=R.family.path.levels.clock.hatBeta (j+1+1)
    Price (R:=R) (simple:=simple) (d:=d) (P:=P) (school:=school) (day:=day) (old:=old) (live:=live)
      (lens:=lens) (pt:=pt) (toll:=toll) (classroom:=classroom) (fine:=fine) (site:=site) (votes:=w)
      (doseCap:=fun _=>B*H^pole) (mask:=mask) (paid:=paid) (adult:=adult) (prior:=prior) e η ∧
    (∑q:Selection R d mask.val,‖weight R d N per (j+1+1) w mask.val q‖) ≤
      wallet R d (fun _=>B) mask.val*H^(pole*mask.val.card) := by
  intro w H
  refine ⟨?_,WilsonReceivedChronologicalFixedRoseFittedBank.original R d panel file station axis mask⟩
  exact charged fine site w (fun _=>B*H^pole)
    (WilsonOriginalObservedRoseFittedPurse.column R d panel file station axis)
    mask paid prior active captured section_ group rested heard eligible

