variable {G:Gauge}{E:ℕ}
open WilsonPointChildNamedPortfolio WilsonCoeffUV.Wheel.Address WilsonPointChildMixedGear WilsonPointChildMixedQuote WilsonPointChildFiledPress
def price (Q:Realm G (E+1) Credit.leanC)(m:ℕ)(h k:ι → ℕ)(η:ℝ)(hq:Q.anchor ≤ m)(I:Finset ι):ℝ:=
  WilsonPointChildNamedResponse.salary Q m hq k h
    ((Q.draws.clock.hatBeta (m+2))^η*cap h) ((Q.draws.clock.hatBeta (m+1))^η*cap h) I

theorem original (R:Run G)(simple:G.Simple)(booked:WilsonPointChildFiledTest.Filed R)
    (u:ι → G.ColorIndex){k h:ι → ℕ}(depth:∀s,k s<h s)(o:Loc G 1)
    (tags:∀i n,(Flat.primary (R.family.path.levels.clock.op i 0).patch R.family.path.levels.clock.kernel n).Choices)
    (cash:ℕ → Gear G → ℝ)(funded:FundedMarkedCoverRows.prices cash R.kit)(E:ℕ)
    (reserve:∀ᶠj:ℕ in atTop,∀F:Gear G, WilsonPointChildMixedQuote.fare G h k E F ≤ cash (R.family.path.levels.clock.J (j+1)) F)
    {η:ℝ}(pos:0<η):
    ∀ᶠm:ℕ in atTop,∃Q:Realm G (E+1) Credit.leanC,Q.draws=R.family.path.levels ∧ Q.paid=R.metals.O ∧
    Q.y=zz R.family.path.levels ∧ ∃hq:Q.anchor ≤ m,
    let F:=(Q.mint m hq).gear
    let w:=elixir (narrow F (strip F) (positive F))
    0<w ∧ ∀N B,m+1<N → m+1 ≤ B → ∀(v₁ v₂:∀s,Letter (R.family.labels.level (k s)))(T I:Finset ι)
      (e r:ℕ),e ≤ E → ∀y:ι → Cover,∀(z:ι → Site (loose R.family.path.levels m).L)(z':ι → Site (loose R.family.path.levels (m+1)).L),
      let a:=bank R u depth N (m+2) v₁
      let b:=bank R u depth B (m+1) v₂
      Wig terrain y w (price Q m h k η hq I) I
        ((WilsonPointChildNamedResponse.output R.family.path.levels R.metals.O m N k T a b y z z' I).2 e r):=by
  let L:=R.family.path.levels
  obtain ⟨m₀,buy⟩:=eventually_atTop.mp reserve
  obtain ⟨m₁,ix⟩:=eventually_atTop.mp (WilsonPointChildQuoteWidth.index L)
  obtain ⟨m₂,input⟩:=eventually_atTop.mp (WilsonPointChildNamedPortfolio.original R simple booked u depth o tags cash funded E pos)
  obtain ⟨m₃,clock⟩:=eventually_atTop.mp ((WardBin.bell L simple).eventually_ge_atTop 1)
  filter_upwards [eventually_ge_atTop (max (max m₀ m₁) (max m₂ m₃)),
    FundedMarkedCoverRows.realm R simple cash funded 0 (fun _=>0) (fun _=>1) (fun _=>by decide) E 0 0]
    with m late selection
  obtain ⟨Q,draws,measured,tick,origin,_,_,_,bought⟩:=selection
  have hq:Q.anchor ≤ m:=origin.le
  have hq':Q.anchor ≤ m+1:=by omega
  let F:=(Q.mint m hq).gear
  obtain ⟨rise,crest,payment⟩:=bought (m+1) (by omega) hq'
  have fee:WilsonPointChildMixedQuote.fare G h k E (Q.mint (m+1) hq').gear ≤ Q.cash Credit.leanC (m+1):=
    (buy (m+1) (by omega) _).trans payment
  have k₀:Q.draws.clock.J (m+1) ≤ (Q.draws.S.block m).val:=by rw [draws];exact ix m (by omega)
  have k₁:Q.draws.clock.J (m+2) ≤ (Q.draws.S.block (m+1)).val:=by rw [draws];exact ix (m+1) (by omega)
  have hi:5 ≤ Q.draws.clock.J (m+2):=by rw [draws];exact rise
  have stop:(Q.mint (m+1) hq').σ=crestM Q.draws (m+1) hi:=by simpa only [draws] using crest
  have upper:strip F ≤ width R (m+1):=(min_le_left ..).trans (entered R Q draws m (ix m (by omega)) hq)
  let F':=narrow F (strip F) (positive F)
  have wpos:0<elixir F':=by unfold elixir; linarith [F'.price,F'.holds]
  refine ⟨Q,draws,measured,tick,hq,wpos,?_⟩
  intro N B live live' v₁ v₂ T I e r he y z z' a b
  let A:=(Q.draws.clock.hatBeta (m+2))^η*cap h
  let A':=(Q.draws.clock.hatBeta (m+1))^η*cap h
  have p₁:0≤A:=by dsimp [A];rw [draws];exact mul_nonneg (Real.rpow_pos_of_pos (zero_lt_one.trans_le (clock _ (by omega))) _).le (cap_nonneg h)
  have p₂:0≤A':=by dsimp [A'];rw [draws];exact mul_nonneg (Real.rpow_pos_of_pos (zero_lt_one.trans_le (clock _ (by omega))) _).le (cap_nonneg h)
  have a₀(x):=lawful R u depth o simple N (m+2) (by omega) v₁ x
  have b₀(x):=lawful R u depth o simple B (m+1) live' v₂ x
  have good(x):safeB x (a x) I E ((windowBasis G Q.draws.clock.kernel).width (Q.draws.clock.J (m+2))) A:=by
    dsimp only [A];rw [draws];exact input (m+2) (by omega) N (by omega) v₁ x I _ le_rfl
  have ready(x):safeB x (b x) I E (strip F) A':=by
    dsimp only [A'];rw [draws];exact input (m+1) (by omega) B live' v₂ x I _ upper
  have answer:=WilsonPointChildNamedResponse.covered Q hq live k₀ k₁ hi stop fee T I a b a₀
    (fun x=>(b₀ x).1) A A' p₁ p₂ good ready e r he y
  generalize eqF:(Q.mint m hq).gear=F₀ at answer
  unfold WilsonPointChildNamedResponse.salary at answer
  rw [eqF] at answer
  rw [draws,measured] at answer
  simpa only [price,WilsonPointChildNamedResponse.salary,eqF] using answer z z'

end YM.Integration.WilsonPointChildNamedCampaign
