attribute [local instance] Gauge.frobInner
variable {G:Gauge}(R:Run G)(wood:Primer.Families R.family)(a:hue G){Q m N i:ℕ}
    (dmax:Fin 3 → ℕ)(depth:∀v,WilsonOlderFreshThermometerRoom.weight v<dmax v)(σ:ℕ → ℝ)
    (digit:Fin 3 → ∀i,Site (R.family.S.block i))
    (T:WilsonOlderFreshThermometerSources.Table (m:=m) (N:=N) (Q:=Q) R dmax σ)(lo:m ≤ i)(hi:i<N)
    {I:Type}[Fintype I](owner:I → Fin 3)
    (columns:∀l,Letter (R.family.labels.level (WilsonOlderFreshThermometerRoom.weight (owner l))))
    (films:∀l,Studio (dmax (owner l))) (charge:I→ℂ)
    {n:Side}(sites:Fin 3→Site n)(A:Fin 3→Set ℂ)(t:Wallet A)
    (per:ℕ)(h:n.val∣(fine R i per).val)(F:Forest (step R i per).ratio)(tag:(step R i per).Choices)
local notation "T₁" => WilsonOlderFreshThermometerSources.selected R dmax σ T (lo.trans (Nat.le_succ i)) (Nat.succ_le_of_lt hi) owner columns films
local notation "Z₁" => WilsonOriginalThreeSoldCharts.charts R wood a dmax depth digit (Nat.succ_le_of_lt hi) owner columns films
local notation "grades" => WilsonOlderFreshThermometerRoom.weight
local notation "M" => WilsonOriginalPointCompactRoster.rows owner grades sites T₁ A charge
local notation "J" => Stock.census (Fin 3)
local notation "K" => WilsonVacuumPreResetStationaryChange.model R N i per hi

theorem original (sold:WilsonOlderFreshThermometerSources.Sold R wood a dmax depth σ digit T)
    (positive:0<σ (i+1))(bounded:∀v x,x∈A v→‖x‖≤1)
    {e:ℕ}{quiet:ℕ→SeriesA G}{π:ℕ→Layout G}{Γ:ℕ→Pace.Coin}
    (course:Read R N m e quiet π Γ){τ cash:ℝ}(funded:Issued R N (i+1) e (quiet (i+1)) τ cash)
    (legal:Legal (Step.tape (e+2)) (π (i+1)))(b:Stationary.Link G (coarse R i per))
    (r:ℕ)(retained:r ≤ Q)(grade:r ≤ e+2):
    let B₀:=Stationary.arm G _ 1 b
    let bank:=copyColor h (M) grades (fun z=>(M z).paint t) (π (i+1)) (Step.tape (e+2))
    let actual:=Bulk.Fk (K) F tag bank B₀ r
    let income:=fun z=>WilsonOriginalThreeGaussianIncome.value owner sites A charge R N i per hi F h t Z₁ B₀ z r
    let cov:=(K).covariance F tag
    let computed:=WilsonOriginalGaussianPaidTable.table (Board (J) r) cov income
    Order.ratio actual=Order.ratio computed ∧ Order.logMarked actual=Order.logMarked computed ∧
      ∀s,MeasureTheory.Integrable (WilsonOriginalGaussianPaidTable.presented (Board (J) r) income s) (Gaussian.cloud cov):=by
  have marked:=WilsonOriginalThreeSoldCharts.original R wood a dmax depth σ digit T (lo.trans (Nat.le_succ i))
    (Nat.succ_le_of_lt hi) owner columns films sold
  have stock:=WilsonOriginalPointCompactSalary.stocks owner grades sites T₁ A charge positive.le (fun _=>1)
    (fun _=>zero_lt_one) bounded Q 3 (∑v:Fin 3,grades v) le_rfl le_rfl le_rfl
  exact WilsonOriginalThreeGaussianReturn.original owner grades sites T₁ A charge R N i per hi F tag h t
    (π (i+1)) (Step.tape (e+2)) Z₁ stock positive positive bounded legal marked.1 marked.2.1 marked.2.2
    course lo funded b r retained grade

end YM.Integration.WilsonOriginalThermometerForestTable
