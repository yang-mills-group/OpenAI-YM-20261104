structure Admission (panel:Panel R grades N per f top fine valid request pole cards B)
    (z:WilsonCenteredPhysicalPanel.Sites R (f,per) n)(E:Fin n  →  ℕ)(order:ℕ):Prop where
  positioned : panel.loc=z
  station : panel.slot=file.station
  axes : panel.axis=file.A N per
  original : Reading R grades panel ((mb).trans (atCapture.le.trans born))
  positive : ∀i,1≤panel.M i
  fare : ∀i,Next.Rank.Spindle.paid R.family (grades i) f N per (panel.names i)≤
    panel.M i*(R.family.path.levels.clock.hatBeta f)^(E i)
  room : order+∑i∈s.val,E i≤request

variable {Z:Type}(panel:Z → Panel R grades N per f top fine valid request pole cards B)
open WilsonReceivedChronologicalFixedRoseFigureTerms (Account)
open WilsonReceivedChronologicalFixedRoseNormalizedTerms (account)
theorem original (entry:locations → Z)(rp:0<r)(small:factor R φ*r≤R.family.S.a 0)
    (narrow:8*R.family.S.a f < R.family.S.a (capture R φ r))
    (upper:capture R φ r < top)
    (forests:∀(j:ℕ)(u:Covers R.family.path.levels.S (j+1) (coarse R (j+1) per)),Forest (step R (j+1) u.val).ratio)
    (chosen:∀(j:ℕ)(u:Covers R.family.path.levels.S (j+1) (coarse R (j+1) per)),(step R (j+1) u.val).Choices)
    {df:ℕ}{frame:Frame G df}(section_:SectionData frame)(group:Hol G)
    (E:Z → Fin n → ℕ)(order:ℕ)(refs:∀i j,j≤grades i  →  R.family.ref j≤N)
    (enrolled:∀z:locations,Admission (file:=file) (s:=s) (old:=old) (atCapture:=atCapture) (born:=born)
      (panel:=panel (entry z)) (z:=z.val) (E:=E (entry z)) (order:=order))
    (young:capture R φ r<top-1)(big:2≤R.alloy.B.a.clock.hatBeta (capture R φ r))(licensed:gates (capture R φ r))
    (clocked:(eventually_atTop.mp (WilsonOriginalTwoFlatIRRows.nextClock R simple)).choose≤capture R φ r)
    {p depth E₀:ℕ}(quote:Quote R N per m (first+1) (capture R φ r) p depth ((mb).trans atCapture.le) atCapture.le)
    {C:ℝ}(cp:1≤C)(allowed:allowance≤1)(rent:0≤rate)
    (out:rate≤C*(3*(gC (capture R φ r))⁻¹)^E₀)(cap:∀a,caps a≤C*(3*(gC (capture R φ r))⁻¹)^E₀)
    {α:ℝ}(strip:(R.family.path.rep N per (capture R φ r)).p.supportExponent≤α)
    (ou:Opened R.family 0 m per)(ov:Opened R.family 0 (first+1) per)
    (reach:4*(p+(WilsonOriginalTwoFlatIRHalo.power s.val.card ((∑a,grades a)+1+2+(2+2*n*E₀))+0+2))≤depth)

    (terminalQ goal:ℕ)(cold:g₀≤1)(coldK:gK≤1){C₁:ℝ}{E₁:ℕ}(cp₁:1≤C₁)
    (out₁:rate≤C₁*(3*(g₀)⁻¹)^E₁)(inputs₁:∀a,‖test a‖≤C₁*(3*(g₀)⁻¹)^E₁)
    (kept:goal+debt n E₁ (count₀)≤terminalQ+1)(budget:terminalQ≤q₀):
    let accountAt (t:Z):Account:=account (G:=G) (n:=n) (N:=N) (grades:=grades) (dims:=dims) (R:=R) (per:=per) (V:=V) (draw:=draw) (rate:=rate)
      (allowance:=allowance) (power:=power) (P:=P) (house:=house) (day:=day) (κ:=κ) (pt:=pt)
      (top:=top) (first:=first) (valid:=valid) (toll:=toll) (old:=old) (test:=test) (classroom:=classroom)
      (fine:=fine) (panel:=panel t) (file:=file) (s:=s) (testCap:=testCap) (hd:=hd) (prior:=prior) (σ:=σ)
      r atCapture born order p E₀ terminalQ goal E₁ C α C₁
    let book (z:locations):Account:=accountAt (entry z)
    (∀z:locations,(book z).Paid) ∧
    ‖signed R φ r (f,per) (fun z=>(book z).incumbent-(book z).independent)‖≤
      ∑z:locations,‖μ₀ z.val‖*(((book z).cutoff+(book z).interior+(book z).crossing+
        ‖(book z).basal‖+‖(book z).firstStep‖)+(book z).terminal) ∧
    ∀lo hi:locations → ℝ,(∀z,‖(book z).basal‖≤lo z) → (∀z,‖(book z).firstStep‖≤hi z) →
      ‖signed R φ r (f,per) (fun z=>(book z).incumbent-(book z).independent)‖≤
        ∑z:locations,‖μ₀ z.val‖*(((book z).cutoff+(book z).interior+(book z).crossing+lo z+hi z)+(book z).terminal):=by
  intro accountAt book
  have cash (z:locations):(book z).Paid:=by
    let t:=entry z
    have placed:=enrolled z
    have usedSite:WilsonCenteredCompactBooking.mass R φ r (f,per) (panel t).loc≠0:=by
      rw [show (panel t).loc=z.val from placed.positioned]
      exact (mem_filter.mp z.property).2
    exact WilsonReceivedChronologicalFixedRoseNormalizedTerms.original (G:=G) (n:=n) (N:=N) (grades:=grades) (dims:=dims) (R:=R) (per:=per) (V:=V) (draw:=draw) (rate:=rate)
      (allowance:=allowance) (power:=power) (P:=P) (house:=house) (day:=day) (κ:=κ) (pt:=pt)
      (top:=top) (first:=first) (valid:=valid) (toll:=toll) (old:=old) (test:=test) (classroom:=classroom)
      (fine:=fine) (panel:=panel t) (file:=file) (s:=s) (testCap:=testCap) (hd:=hd) (prior:=prior) (σ:=σ)
      r rp small atCapture born narrow usedSite forests chosen section_ group placed.station placed.axes
      upper placed.original placed.positive (E t) refs placed.fare order placed.room
      young big licensed clocked quote cp allowed rent out cap strip ou ov reach terminalQ goal cold coldK
      cp₁ out₁ inputs₁ kept budget
  have collect (lo hi:locations → ℝ) (hp:∀z,‖(book z).basal‖≤lo z)(hq:∀z,‖(book z).firstStep‖≤hi z):
      ‖signed R φ r (f,per) (fun z=>(book z).incumbent-(book z).independent)‖≤
        ∑z:locations,‖μ₀ z.val‖*(((book z).cutoff+(book z).interior+(book z).crossing+lo z+hi z)+(book z).terminal):=by
    unfold WilsonReceivedChronologicalFixedRoseVariation.signed
    refine (norm_sum_le _ _).trans (sum_le_sum fun z _=>?_ )
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left ((cash z).on_fees (hp z) (hq z)) (norm_nonneg _)
  exact ⟨cash,collect _ _ (fun _=>le_rfl) (fun _=>le_rfl),collect⟩

