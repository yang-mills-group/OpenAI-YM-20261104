theorem original {m e:ℕ}{Z:ℕ→SeriesA G}{π:ℕ→Layout G}{Γ:ℕ→Pace.Coin}
    (course:Agrees R N m e Z π Γ)(lo:m ≤ i)(starts:Γ i 0=0)(simple:G.Simple)
    (s:Finset T)(r d:ℕ)(funded:d ≤ e+2)(kept:d ≤ r)(v:Stationary.Link G (coarse R i per)):
    Adjacent.born (display (k:=k) B old q root y t R N i per hi F tag h x T s r)
        ((Rebirth.caliber (Γ i) starts).back (e+2)) 0 r d v=
      (∏u∈s,(c₁) u.val)*read (coordinates G (coarse R i per)) ((L) (calendar) s) d v:=by
  have wages:=WilsonVacuumPreResetMeasuredCaliber.settled R course lo hi starts
  have divisor:constantCoeff (dated R N i)=1:=
    (coeff_zero_eq_constantCoeff_apply _).symm.trans ((wages.1 0 (Nat.zero_le _)).symm.trans (Rebirth.caliber (Γ i) starts).starts)
  rw [←WilsonReceivedDepositedOrbitalKinetic.restamp B old q root y t R N i per hi F h T well hs fund book inside simple (calendar) s]
  change _ = _*read _ (redo (Blue.back (dated R N i)) _) d v
  rw [←WilsonCapturedPrimaryWeakTrialClockReversion.dated _ divisor]
  apply WilsonNeutralSignedPolynomialRate.original wages.2.2.2 _ _ _ funded kept
  intro l hl z
  exact WilsonReceivedDepositedOrbitalProfile.heard B old q root y t R N i per hi F tag h well hs fund book inside x
    (Stationary.arm G (coarse R i per) 1 (z • v)) T simple r l hl s

