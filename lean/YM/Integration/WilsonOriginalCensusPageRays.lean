open WilsonOriginalCensusPaidForest (ray)
open WilsonOriginalFoldedMarkedRightColumn (before)
def atLift (l:I)(a:Fin (Pages n (fine R i per)))(j:ℕ):ℂ:=
  (∏v∈(binders l).mode.val,(x v).val)*Complex.ofReal (MvPolynomial.eval (Sum.elim z (flatten B)) (coeff j
    (before R N i per hi F (Z l (fine R i per) (page h (binders l).center a).val))))

omit [Fintype I] in
theorem pages (l:I)(j d:ℕ)(shell:∀u,shellK d (Z l (fine R i per) u))
    (pure:∀u,∀j,Pure (Z l (fine R i per) u j)):
    ray binders R N i per hi F h x Z B z l j=∑a,atLift binders R N i per hi F h x Z B z l a j:=by
  unfold WilsonOriginalCensusPaidForest.ray atLift WilsonOriginalFoldedMarkedRightColumn.before
  rw [(sheets h (binders l).center (Z l (fine R i per)) shell pure).2.2]
  simp only [map_sum,Complex.ofReal_sum,Finset.mul_sum]

