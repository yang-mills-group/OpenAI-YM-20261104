    (seats:1≤op.count) (shape:op.count=school.pieces) (phase:school.order+1 ≤ op.stage)
    (enrolled:query.order ≤ school.order) (within:query.letter.toll ≤ school.horizon)
    (high:ℕ) (space:Sycamore.Boot.need high school ≤ R.alloy.B.a.clock.J (i₁+1))
    (path:PlanV.Path D R.alloy Q₀ (Burn.horizon k) N m π Γ)
    (month:Scholar.Month R.rolls D Q₀ R.alloy.delay)
    (narrow:school.horizon≤R.alloy.B.a.clock.J i₁)
    (M₀:WilsonMeasuredRankedMenu.Menu R query.letter.toll) (office:M₀.onset ≤ i₁) (way : WayStation R.kit) 
    
    (prepared : WilsonReportLampForecast.Ready R.family.path.levels)
    (fixed : (R.family.path.levels.budget i₁).supportExponent ≤ 100)
    (date : R.t query.letter.toll ≤ i₁) (late : WilsonCenteredCaptureClock.first R simple ≤ i₁)
    (grossDate : WilsonReceivedSourceGross.opening R simple ≤ i₁)
    (fareDate : WilsonOlderSignedOneMarkPhysicalFare.opening R simple slow.2 prepared ≤ i₁)
    (ready : (q+4)+1+6 ≤ R.alloy.B.a.clock.J i₁) (deep : 2*((q+4)+4+1)+8 ≤ school.order)
    (aged : (q+4)+4+4 ≤ 3*k+2) 
    (opened : WilsonFirstReceivedEarnedFee.opening R simple school.pieces ((q+4)+4) school.order k deep aged
      (tolerance_pos R query.letter.toll (q+4) (WilsonMeasuredRankedMenu.fee_positive R query.letter.toll M₀ (eighth ep))) ≤ i₁)
    (recalled : WilsonCoherentMayerMutationIntake.firstDate R simple school.order (show (0:ℝ)<1 by norm_num)
      le_rfl (tolerance_pos R query.letter.toll (q+4) (WilsonMeasuredRankedMenu.fee_positive R query.letter.toll M₀ (eighth ep))) ≤ i₁)
    (masks : WilsonOlderSignedOneMarkBooked.opening R simple (school.order+school.horizon+2) (q+4) 102
      (show 0 < WilsonMeasuredRankedMenu.fee R query.letter.toll M₀ ((ε/8)/16)/6 from div_pos (WilsonMeasuredRankedMenu.fee_positive R query.letter.toll M₀ (eighth ep)) (by norm_num)) ≤ i₁)
    (soft : WilsonOlderSignedOneMarkCurrency.opening R simple (q+4) (WilsonMeasuredRankedMenu.fee_positive R query.letter.toll M₀ (eighth ep)) ≤ i₁)

    (lowerDate:school.horizon≤R.alloy.B.a.clock.J j)
    (money:WilsonMeasuredLandedCurrency.first R simple≤j)
    (booked:WilsonReceivedMeasuredStampPrice.opening R simple (q+4) school.order k
      (ready_order deep) (ready_age aged) (eighth ep) ≤ i₁)
    (test:Wallet A) {next:ℝ} (positive:0<next) (small:next≤1) :

    ∃ c amp:ℝ,0<c ∧ (0<amp ∧ amp⁻¹ ≤ 2*βhat*(salary pin)) ∧
      WilsonOriginalPrimerStampedRay.Matched T (WilsonOlderFreshPointChart.chart R families a depth (i₁+1) w
        (⟨N,cut,digit⟩,testAt pin)) ∧
      WilsonOlderFreshPointDeclaredPupil.Receipt (N:=N) R query hk D Q₀ π Γ Ψ books floor school ahead A base digit T c amp τ high
        ((ε/8)*g₀^(q+2)*(salary pin)) ∧
      (ε/8)*g₀^(q+2)*(salary pin) ≤ (ε/8)*g₀^(q+2)*(1+massF):=by
  obtain ⟨c,amp,cp,ap,fee,stamp,real⟩:=WilsonOlderFreshPointSuccessor.original (N:=N) R hk D Q₀ π Γ Ψ
    history scroll books chamber floor warm top school op lesson cal ahead hospital (place pin) A families a
    depth w (testAt pin) (q+2) (div_pos ep (by norm_num:0<(8:ℝ))) digit simple cut cap pos bounded pass
    live T wage source seats shape phase enrolled within high space path month narrow M₀ office way slow.2
    prepared fixed date late grossDate fareDate ready deep aged opened recalled masks soft lowerDate money
    booked test positive small
  refine ⟨c,amp,cp,⟨ap,fee⟩,stamp,real,?_⟩
  have heat:= (WilsonMeasuredLandedCurrency.native R simple per cut.le money).2.1
  have test_le:salary pin ≤ 1+massF:=by
    change 1+‖testAt pin‖≤1+‖f‖
    linarith [Dawn.through_le (digit i₁) (Elm.growL R.family.path.levels i₁) f]
  exact mul_le_mul_of_nonneg_left test_le (by positivity)

