theorem original (simple:G.Simple)
    (funded:WilsonOriginalAllOrderCourse.Paid.{u} axis simple ε (prepared schedule) R crop W)
    (physicalPole:ℕ)(physicalCap:ℝ)(cp₀:0≤physicalCap)(E:ℕ)(charge:Faces→ℝ)(positive:∀s,0≤charge s)(target debt width Q:ℕ)
    (retained:cut target E debt width≤Q)(Cφ:ℝ)(cp:0<Cφ)
    (D:Fin 3→ℕ)(fits:∀i,ages i<D i)(X opt tol:ℝ)(xp:0≤X)(op:0≤opt)(tp:0<tol)
    (plan:Plan 3)(M:Fin 3→ℝ)(one:∀i,1≤M i)
    (priced:plan.Affords (WilsonReceivedChronologicalFixedRoseHeldCofactor.demand target physicalPole) (2*E) (WilsonOriginalObservedRosePublicMesh.aperture width) 14):
    let J₀:=cut target E debt width
    let A:=WilsonOriginalObservedRosePublicMesh.aperture width
    ∃start:ℕ,∀ᶠv:ℕ in atTop,∃(V:Realm G (Q+1) Credit.leanC)(draw:V.draws=P),
    V.paid=R.metals.O ∧ V.y=zz P ∧ V.anchor=v ∧ Covered R D Q v start V draw opt tol ∧
    (∀s:Finset (Fin 3),s.Nonempty → Stock R D Q v start V draw opt tol s) ∧
    ∀r γ:ℝ,0≤γ → γ≤1 → ∀(K N per b c requested tag:ℕ)(bk:b≤K)(kn:K≤N),
    0<v → v≤c → c≤b → v+1≤K → σ K-σ (v-1)≤(plan.width:ℝ)*(1+Real.log (β v)) →
    let θ:=g N per v
    ∀(file:Filed R ages K)(φ:Test 3),let D₀:=cells R φ r (b,per)
    ∀panel:D₀ → Panel R ages N per b K bk kn requested plan.pole tag plan.tuition,
    (∀y,(panel y).loc=y.val ∧ (panel y).M=M) →
    ∀(κ:(i:Fin 3)→Knob (D i))(pt:Fin 3→Chamber)(digits:D₀→Digits (P) (Fin 3))
      (atSite:D₀→Fin 3→ Cover)(test:D₀→(s:Faces)→Pen D s→L[ℝ]ℝ),
      (∀y (s:Faces),s.Nonempty → ‖test y s‖≤X*(θ⁻¹)^debt) →
    let w:=fun y:D₀=>votes R ages (N:=N) (per:=per) file (panel y).names (panel y).turn
    (∀y (s:Faces),s.Nonempty → γ^(height ages s)*
      (∑q:Selection R ages s,‖weight R ages N per K (w y) s q‖)≤
      charge s*(θ⁻¹)^(2*E)*(θ⁻¹)^(A*height ages s+1) ∧
      γ^(height ages s)*(∑q:WilsonThermometerPositionTunedSlope.Columns R (fun i:s=>ages i.val),
        ‖WilsonOlderFreshSoftSocketMeasuredCash.packet R ages s (w y) N per K q‖)≤
        charge s*(θ⁻¹)^(2*E)*(θ⁻¹)^(A*height ages s+1)) →
    let row (j:ℕ)(y:D₀)(s:Faces):=normalized R ages κ pt N per K c v (digits y) s (w y) (atSite y) (test y s) j θ
    ∀u:ℕ,∀before:u≤K,
    let source:=fun (y:D₀)(s:Faces)=>WilsonMeasuredPublicEntranceCellWords.physical R ages
      (panel y).names (panel y).turn y.val (bookedFace s) (N:=N)
    let fixed:=fun (y:D₀)(s:Faces)=>WilsonReceivedChronologicalFixedRoseTestSource.fixed R kn before (source y s)
    ∀χ:ℝ,0<χ → θ≤4*χ →
    (∀y (s:Faces),s.Nonempty → γ^(height ages s)*‖fixed y s‖≤physicalCap*(χ⁻¹)^physicalPole) →
    ∀basal first:D₀→Faces→ℂ,
    let register:=fun (y:D₀)(s:Faces)=>written R ages plan (panel y) file v c s (fixed y s) (row Q y s)
      (basal y s) (first y s)
    (∀y (s:Faces),s.Nonempty → (register y s).Paid) →
    (∀y (s:Faces),s.Nonempty → ‖basal y s‖≤low R ages plan K N per v s) →
    (∀y (s:Faces),s.Nonempty → ‖first y s‖≤high R ages plan K N per v s) →
      γ^14*‖signed R φ r (b,per) (fun y=>value (fixed y)-value (row J₀ y))‖≤
        (∫x,‖φ x‖)*(2*θ^target):=by
  classical
  intro J₀ A
  obtain ⟨start,room⟩:=WilsonReceivedChronologicalFixedRoseSplitElection.original (R:=R) simple
    funded E charge positive target debt width plan.width Q retained Cφ cp D fits X opt tol xp op tp
  have paidFaces:=WilsonReceivedChronologicalFixedRoseFittedDebit.original R simple plan
    (WilsonReceivedChronologicalFixedRoseHeldCofactor.demand target physicalPole) (2*E) A priced M one charge positive
  refine ⟨start,?_⟩
  filter_upwards [room,paidFaces,WilsonOriginalOpticalCouplingBand.cold R simple (max 21 (physicalCap*(4:ℝ)^physicalPole))]
    with v rooms spend gate
  obtain ⟨V,draw,oil,zero,posted,old,stock,report⟩:=rooms
  refine ⟨V,draw,oil,zero,posted,old,stock,?_⟩
  intro r γ gp₀ go K N per b c requested tag bk kn vp vc cb later span θ file φ D₀ panel placed κ pt digits atSite
    test young w sourceFee row u before source fixed χ ch ratio gross basal first register known lowFee highFee
  have vn:=vc.trans (cb.trans (bk.trans kn))
  have gp:0<θ:=ActualRunKernelPackets.regulator_pos R N per v vn
  have both (y:D₀):γ^14*‖value (fixed y)-value (row J₀ y)‖≤2*θ^target:=by
    have oldRows:=report γ gp₀ K N per c vc (cb.trans bk) kn later span (w y)
      (fun s hs=>(sourceFee y s hs).1) κ pt (digits y) (atSite y) (test y) (young y)
    have live:=gate N per vn
    have earned:=WilsonReceivedChronologicalFixedRoseHeldCofactor.original (fixed y) (row Q y) gp₀ ch gp ratio
      target physicalPole physicalCap cp₀ ((le_max_left ..).trans live) ((le_max_right ..).trans live) (gross y)
    have fee (s:Faces)(hs:s.Nonempty): γ^(height ages s)*‖fixed y s-row Q y s‖≤
        θ^(WilsonReceivedChronologicalFixedRoseHeldCofactor.demand target physicalPole):=by
      have absolute:‖fixed y s-row Q y s‖≤((register y s).cutoff+(register y s).interior+(register y s).crossing+
          low R ages plan K N per v s+high R ages plan K N per v s)+(register y s).terminal:=
        (known y s hs).on_fees (lowFee y s hs) (highFee y s hs)
      exact (mul_le_mul_of_nonneg_left absolute (pow_nonneg gp₀ _)).trans
        (spend s (per:=per) vp vc cb bk kn span (panel y) file (placed y).2 γ gp₀ go
          (sourceFee y s hs).2 (fixed y s) (row Q y s) (basal y s) (first y s))
    calc _≤γ^14*(‖value (fixed y)-value (row Q y)‖+‖value (row Q y)-value (row J₀ y)‖):=
           mul_le_mul_of_nonneg_left (norm_sub_le_norm_sub_add_norm_sub ..) (pow_nonneg gp₀ _)
         _≤2*θ^target:=by rw [mul_add];linarith only [earned fee,oldRows.2.2]
  let amp:ℂ:=(γ:ℂ)^14
  let change:=fun y:D₀=>value (fixed y)-value (row J₀ y)
  have scalar:‖amp‖=γ^14:=by simp only [amp,norm_pow,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg gp₀]
  have result:=WilsonReceivedChronologicalFixedRoseVariation.original R φ r (b,per) (fun y=>amp*change y)
    (2*θ^target) (by positivity) (fun y=>by rw [norm_mul,scalar];exact both y)
  have pull:signed R φ r (b,per) (fun y=>amp*change y)=amp*signed R φ r (b,per) change:=by
    unfold WilsonReceivedChronologicalFixedRoseVariation.signed
    rw [mul_sum]
    exact sum_congr rfl fun y _=>by ring
  rwa [pull,norm_mul,scalar] at result

end YM.Integration.WilsonReceivedChronologicalFixedRoseCellScale
