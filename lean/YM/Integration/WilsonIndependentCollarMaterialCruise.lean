variable {G:Gauge}{n:ℕ}{R:Run G}{N i e:ℕ}{k:Fin n→ℕ}{σ:ℝ}{side:Side}
  {y:Fin n → Cover}(H:Material R N i e k σ (binder side y))
  (κ:(v:Fin n)→Knob (H.tests v))(pt:Fin n→Chamber)(b:ℕ)
  (cells:Digits R.family.path.levels (Fin n))(seed:(v:Fin n)→Choice R k v)

theorem original (simple:G.Simple)(prior:i≤b)(hi:b≤N)
    (named:∀z S,output H.prior S N z=fixed R k κ pt N b i cells seed z S)
    (S:Finset (Fin n))(f:Pen H.tests S→L[ℝ] ℝ)(z:Fin n → Cover):
    tuftV f (levelsO (fun J=>output H.prior J N z) S)=
      cruises R.family.path.levels R.metals.O N (mass k S) b i
        (tuftV f (levelsO ((start R k κ pt seed) (address R.family.path.levels cells (b-i) i z)) S)):=by
  have same:(fun J=>output H.prior J N z)=fixed R k κ pt N b i cells seed z:=funext (named z)
  obtain ⟨_,_,hire⟩:=WilsonReceivedCanonicalVerseRegister.original R k κ pt e (s:=1) zero_lt_one
  have age:i+(b-i)=b:=by omega
  rw [same]
  simpa only [WilsonReceivedFixedDigitCanonical.fixed,age] using
    WilsonIndependentCollarOrdinaryCruise.original R.family.path.levels R.metals.O simple R.alloy.B.ratio
      N cells (start R k κ pt seed) (hire seed).1 S f (b-i) i z (by omega)

end YM.Integration.WilsonIndependentCollarMaterialCruise
