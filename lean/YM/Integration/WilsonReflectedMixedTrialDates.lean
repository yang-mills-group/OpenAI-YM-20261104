/-- The linear original cutoff chart is open simultaneously on every named
basis station. The gate is chosen before the periods or any fitted vectors. -/
theorem original (simple:G.Simple)(bliss:Bliss F l z H)(slow:WilsonWindowReportingPace.Slow R.kit)
    (D T h:ℕ)(d:I→Fin (D+1)){δ:ℝ}
    (books:(s:{s:ℝ // 0<s ∧ s<δ})→Book F (l:=l) H z D T s.val):
    ∀ᶠr in trail,∀ρ:I→{s:ℝ // 0<s ∧ s<δ},(∀i,r≤(ρ i).val ∧ (ρ i).val≤outer z h r) →
      (∃i,(ρ i).val=r) →∀i b p,
      Opened C (d i).val (WilsonReflectedPublicStationFare.station F ((books (ρ i)).rows (d i)) b) p:=by
  classical
  have doors:∀ᶠ j:ℕ in atTop,∀i:I,∀p,Opened C (d i).val j p:=
    Filter.eventually_all.mpr (fun i=>open_late C simple (d i).val)
  obtain ⟨gate,opened⟩:=eventually_atTop.mp doors
  filter_upwards [WilsonAddressedMixedStationRange.original F simple bliss slow D T h gate d books] with r club
  intro ρ span live i b p
  exact opened _ (((club ρ span live).2 i b).1) i p

