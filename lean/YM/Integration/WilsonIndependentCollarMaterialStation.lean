theorem original (R:Run G)(κ:(v:Fin n)→Knob (D v))(pt:Fin n→Chamber)(simple:G.Simple)(k:Fin n→ℕ)
    (quiet:WilsonReceivedCloseFundedHeat.Quiet R)(salary:ℕ→Gear G→ℝ)(bought:FundedMarkedCoverRows.prices salary R.kit)
    (C:Fin n→ℝ)(charged:∀v,0 ≤ C v)(A:ℕ):
    let L:=R.family.path.levels
    ∀ᶠ m:ℕ in atTop,∀K i:ℕ,m ≤ i → i < K →
      L.S.scale K-L.S.scale m≤(A:ℝ)*(1+Real.log (L.clock.hatBeta (m+1))) →
      ∀(Q:Realm G (q+1) Credit.leanC),Q.anchor ≤ i → Q.draws=L → Q.paid=R.metals.O →
      ∀(s:labels)(M:Fin n→ℝ)(diameter power pole E:ℕ)(external:ℝ),
      let H:=R.alloy.B.a.clock.hatBeta (i+1)
      0 < H → ∀ᶠ per:ℕ in atTop,∀N:ℕ,K ≤ N →
      ∀v:(j:Fin n)→R.family.label (k j),(∀j∈s.val.val,axisFee R k v j≤M j) →
      ∀(y:Fin n → Cover),(2*((univ:Finset (Fin n)).image y).sup radius≤diameter) →
      ∀(cells:Digits L (Fin n))(J:(a:Choices R k s.val.val)→
        Mounted R κ pt N per i K q k y cells (letter R s.val.val a)),(∀a v,‖(J a).film v‖≤C v) →
      ∀(x:Choices R k s.val.val→Wallet (room (Fin n)))(extra:Choices R k s.val.val→ℂ),
      (∀a,‖extra a‖≤external) →
      ∀(tags:(u:Covers L.S i (coarse R i per))→(step R i u.val).Choices),
      ∀(start e:ℕ)(Z:ℕ→SeriesA G)(π:ℕ→Layout G)(Γ:ℕ→Pace.Coin),
      Legal (Step.tape (e+2)) (π (i+1)) → Read R N start e Z π Γ → start ≤ i →
      ∀τ cash:ℝ,Issued R N (i+1) e (Z (i+1)) τ cash → ∀starts:Γ i 0=0,
      ∀r d:ℕ,r≤q → r≤e+2 → d≤r → ∀(node:Stationary.Link G (coarse R i per)),‖node‖≤1 →
      let high:=fun a=>upper (J a) (x a) tags e r d π Γ starts s node
      let low:=fun a=>lower (J a) (x a) d s node
      let coeff:=fun a=>signed R k N per K m v s.val.val a*(extra a)
      (∑a,‖coeff a*(high a-low a)‖)≤(H^(near power pole E))⁻¹ ∧
        ‖(∑a,coeff a*high a)-(∑a,coeff a*low a)‖≤(H^(near power pole E))⁻¹:=by
  intro L
  letI:DecidableEq (labels):=Classical.decEq _
  obtain ⟨_,_,menu⟩:=WilsonIndependentCollarWholeStation.original (I:=labels) (q:=q)
    R κ pt simple k quiet salary bought C charged A
  obtain ⟨floor,bank⟩:=eventually_atTop.1 (WilsonOriginalCensusFixedBank.original (k:=k) R κ pt simple quiet salary bought q)
  filter_upwards [menu,eventually_ge_atTop floor] with m issue late
  intro K i lowerDate finer span Q anchor draw book s M diameter power pole E external H hot
  obtain ⟨δ,pos,_,sale⟩:=issue K i lowerDate finer span Q anchor draw book s.val M diameter power pole E external hot
  filter_upwards [sale] with per tap
  intro N top v dose y housing cells J test x extra spare tags start e Z π Γ legal course live τ cash ordinary starts
    r d retained grade kept node unit up low coeff
  let side:=fine R i per
  let B:=legs R i per y cells
  have authentic(a:Choices R k s.val.val):‖up a-low a‖≤
      (∑S:Finset (labels),‖wages B (x a) s.val S‖)*((Fintype.card (labels)*mass k univ+q+1:ℕ)*δ):=
    heard (bank i (late.trans lowerDate)) (J a) (x a) tags top finer legal course live ordinary starts simple s r d retained grade kept
      (fun _ h=>⟨h.choose,h.choose_spec⟩) node unit C (test a) diameter housing δ pos.le tap.1
  have absolute:=tap.2 N top v dose (fun _=>side) (fun _=>WilsonOriginalCensusFaceSites.port side
    (chartIn (loose L i) y (cells i))) (fun _=>B) x extra up low spare authentic
  have bound:(∑a,‖coeff a*(up a-low a)‖)≤(H^(near power pole E))⁻¹:=by
    simpa only [coeff,mul_assoc] using absolute
  refine ⟨bound,?_⟩
  calc
    _ = ‖∑a,coeff a*(up a-low a)‖:=by rw [←sum_sub_distrib];simp only [mul_sub]
    _ ≤ ∑a,‖coeff a*(up a-low a)‖:=norm_sum_le ..
    _ ≤ _:=bound

end YM.Integration.WilsonIndependentCollarMaterialStation
