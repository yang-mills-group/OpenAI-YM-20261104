variable {side:Side}{σ₀:ℝ}(H:Material R N (j+1) e k σ₀ (binder side y))

private theorem same_frill {P P':Material R N (j+1) e k σ₀ (binder side y)} (equality:P=P')(z:I):
    HEq (P.frill z) (P'.frill z):=by subst P';rfl

theorem original (simple:G.Simple)(vc:atDate≤c)(ck:c≤K)(kn:K≤N)
    (filed:Filed (K:=K) (draw:=draw) (rate:=rate) (δ:=δ) cells κ pt seed side y t H)
    (x:Fin n→ℂ)(g:ℂ)(p:ℕ)(order:p≤e)(S:Finset (Fin n)):
    (crop (fun z:I=>((binder side y) z).mode) (cash H x) g p).part (seat S)=
      whole (R:=R) (N:=N) (K:=K) (c:=c) (j:=j) (draw:=draw) κ pt cells seed y t x g p S:=by
  obtain ⟨test,knob,et,ek,paid,address,named,X,installed,_⟩:=filed
  obtain ⟨_,axes,_,_,_,_⟩:=paid
  subst D
  obtain rfl:=eq_of_heq et
  obtain rfl:=eq_of_heq ek
  have pins:H.pin=pin:=congrArg Material.pin installed
  have roots:H.root=root y:=congrArg Material.root installed
  have frills (z:I):HEq (H.frill z) (frill y z):=same_frill y installed z
  have supplied:=WilsonOriginalTwoFlatIRFlatMeasured.original H knob pt K (path) seed x test simple (vc.trans ck) kn
    named address.ink pins roots frills g p order S
  rw [supplied,WilsonOriginalTwoFlatIRFlatMeasured.reading,whole]
  apply sum_congr rfl
  intro a _
  rw [WilsonOriginalTwoFlatIRFlatFinanced.coeff,WilsonOriginalTwoFlatIRFlatSeries.value]
  have deposited:=continued knob pt (path) seed simple vc ck kn S (touch test S) y
  exact congrArg (fun P:Era G ℝ=>g^a*((∏v∈S,x v)*Complex.ofReal (P.2 a 0 Fin.elim0))) deposited

