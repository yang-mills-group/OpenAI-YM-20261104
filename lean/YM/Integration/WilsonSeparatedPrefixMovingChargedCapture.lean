theorem declared (F:SealR G)(φ:Rarity D)(ψ χ:Rarity F.D)(hψ:ContDiff ℝ ∞ ψ.ψ.val)(hχ:ContDiff ℝ ∞ χ.ψ.val)
    (window:∀p q:Point4,φ.ψ.val p*ψ.ψ.val (q-p)=φ.ψ.val p*(χ.ψ.val q*ψ.ψ.val (q-p))):
    ∃S:𝓢(Euclid,ℂ),S=WilsonSeparatedPrefixMovingJointSpectrum.transformed ψ hψ ∧ (∀a:ℕ,Integrable (fun ξ:Euclid=>(1+‖ξ‖^a)*‖S ξ‖))∧
    ∀(R:Realm G (e+1) C)(_rf:PassportC H R F W V){n m t b N older:ℕ}(Q:Fin (n+1)→SealR G)
      (_rq:HorizonP H R W V Q)(α:Wilt Q)(X:Herit Q)(Z:F.Rider),R.anchor≤b→ older≤b→b≤N→paceT R.draws.S t b≤1→
      ∀(K:ℕ)(_rank:capP Q≤K)(h:ℕ)(γ y:ℝ)(o:CellR)(q r:ℕ)(w:Fin r→YForest G),
      let ε:=paceT R.draws.S t b
      let P:=LodeStar R.draws R.paid α X m b N (paceT R.draws.S m b)
      let near:=AutumnDay R.draws R.paid α X m b N D
      let old:=fun A B=>(cruises R.draws R.paid N (F.h+capP Q) b older (agateV A B)).2 q r w
      let outside:=fun ξ d=>locale o (F.spins R.draws R.paid (sheet χ (angle ξ) d) t b N y Z)
      let vote:=fun ξ:Euclid=>∑c:Bool,∑d:Bool,coefficient (S ξ) c d*
        (cruises R.draws R.paid N (K+F.h) b older (agateV (word (γ • near) (sheet φ (angle ξ) c) ε y o h) (outside ξ d))).2 q r w
      Integrable vote ∧
        γ*(∑s∈canvasM φ ε y,drumB h ε*∫z:CellR,φ.ψ.val (Mer.address ε y o s z.val)*
          old (move s (locale z (F.spins R.draws R.paid ψ t b N ε Z))) (locale z (shifted P s)) ∂dayMeasure)=∫ξ,vote ξ:=by
  obtain ⟨S,identity,salary,sold⟩:=WilsonSeparatedPrefixMovingCorrelatedCapture.declared (H:=H) (C:=C) (W:=W) (V:=V) (e:=e) F φ ψ χ hψ hχ window
  refine ⟨S,identity,salary,?_⟩
  intro R rf n m t b N older Q rq α X Z gate ear top cap K rank h γ y o q r w ε P near old outside vote
  let base:=fun ξ:Euclid=>∑c:Bool,∑d:Bool,coefficient (S ξ) c d*old (outside ξ d) (word near (sheet φ (angle ξ) c) ε y o h)
  have backup:=sold R rf (m:=m) Q rq α X Z gate ear top cap y o h q r w
  have income:Auth (capP Q) P:=cruising R.draws R.hG R.green top le_rfl
    (Hearth_enter rq α X (gate.trans top) (le_refl N) (m:=m) (y:=paceT R.draws.S m b))
  have funded:Auth (capP Q) near:=income.tuft _
  let Ftop:=polarP R.draws R.paid F.ans F.path N t b Z
  have senior:Auth F.h Ftop:=by
    dsimp [Ftop];rw [←rf.lands,←rf.modes]
    exact On_auth (tournure rf.f.arch Z (rf.tap.symm ▸ gate) top)
  have marked (ξ:Euclid)(d:Bool):Auth F.h (outside ξ d):=(placed F.h (sheet χ (angle ξ) d) (Auth_on senior) ε y).tuft _
  have exchanged:vote=(fun ξ:Euclid=>γ*base ξ):=by
    funext ξ
    dsimp only [vote,base]
    simp_rw [Finset.mul_sum]
    apply Finset.sum_congr rfl;intro c _
    apply Finset.sum_congr rfl;intro d _
    have coupon:=WilsonSeparatedPrefixMovingCaptureCharge.original R near (outside ξ d) funded (marked ξ d) ear top K rank
      (sheet φ (angle ξ) c) ε y o h γ
    rw [coupon]
    change coefficient (S ξ) c d*(γ*old (outside ξ d) _) = _
    ring
  have quoted:Integrable base:=backup.1
  rw [exchanged]
  refine ⟨quoted.const_mul _,?_⟩
  rw [integral_const_mul]
  exact congrArg (γ*·) backup.2
theorem original (F:SealR G)(φ:Rarity D)(ψ χ:Rarity F.D)(hψ:ContDiff ℝ ∞ ψ.ψ.val)(hχ:ContDiff ℝ ∞ χ.ψ.val)
    (window:∀p q:Point4,φ.ψ.val p*ψ.ψ.val (q-p)=φ.ψ.val p*(χ.ψ.val q*ψ.ψ.val (q-p))):
    ∃S:𝓢(Euclid,ℂ),(∀a:ℕ,Integrable (fun ξ:Euclid=>(1+‖ξ‖^a)*‖S ξ‖))∧
    ∀(R:Realm G (e+1) C)(_rf:PassportC H R F W V){n m t b N older:ℕ}(Q:Fin (n+1)→SealR G)
      (_rq:HorizonP H R W V Q)(α:Wilt Q)(X:Herit Q)(Z:F.Rider),R.anchor≤b→ older≤b→b≤N→paceT R.draws.S t b≤1→
      ∀(K:ℕ)(_rank:capP Q≤K)(h:ℕ)(γ y:ℝ)(o:CellR)(q r:ℕ)(w:Fin r→YForest G),
      let ε:=paceT R.draws.S t b
      let P:=LodeStar R.draws R.paid α X m b N (paceT R.draws.S m b)
      let near:=AutumnDay R.draws R.paid α X m b N D
      let old:=fun A B=>(cruises R.draws R.paid N (F.h+capP Q) b older (agateV A B)).2 q r w
      let outside:=fun ξ d=>locale o (F.spins R.draws R.paid (sheet χ (angle ξ) d) t b N y Z)
      let vote:=fun ξ:Euclid=>∑c:Bool,∑d:Bool,coefficient (S ξ) c d*
        (cruises R.draws R.paid N (K+F.h) b older (agateV (word (γ • near) (sheet φ (angle ξ) c) ε y o h) (outside ξ d))).2 q r w
      Integrable vote ∧
        γ*(∑s∈canvasM φ ε y,drumB h ε*∫z:CellR,φ.ψ.val (Mer.address ε y o s z.val)*
          old (move s (locale z (F.spins R.draws R.paid ψ t b N ε Z))) (locale z (shifted P s)) ∂dayMeasure)=∫ξ,vote ξ:=by
  obtain ⟨S,_,data⟩:=declared (H:=H) (C:=C) (W:=W) (V:=V) (e:=e) F φ ψ χ hψ hχ window
  exact ⟨S,data⟩
end YM.Integration.WilsonSeparatedPrefixMovingChargedCapture
