theorem original (Φ:Test 3)(simple:G.Simple):∃wall:ℝ,0<wall ∧
    ∀{N per b K c v first:ℕ}(bk:b≤K)(kn:K≤N)(ck:c≤K),v≤c →first+1≤v →
    ∀{r:ℝ},0<r→(a) b≤r→4*(wall*r)<(a) c→
    ∀y:Site ((C).side b per)×Site ((C).side b per),WilsonThermometerAlignedCells.mass (R:=R) r (b,per) Φ y≠0 →
    ∀{Q J0:ℕ}(V:Realm G (Q+1) Credit.leanC)(source:V.draws=(P))(O:Realm G (J0+1) Credit.leanC)
    (draw:O.draws=(P)),O.paid=R.metals.O →
    ∀(D:Fin 3→ℕ)(s:Faces)(κ:(i:Fin 3)→Knob (D i))(pt:Fin 3→Chamber)
    (test:Case D)(w:∀i,(C).label (ages i))(e:ℕ)(θ:ℝ),
    let o:=atOrigin y
    let entry:=tape source bk o
    let cells:=onLevels source entry
    let pins:=address (P) cells (c-v) v (homes (V:=V) entry 0 first (v-1-first))
    let branch:=touch (fun i:s=>test i.val) (Finset.univ:Finset s)
    let high:=WilsonOriginalMicroscopicEntranceGridRow.pin R (bk.trans kn) o
    let probe:=WilsonOlderFreshSoftRoseNodes.enrolled R D O draw N per c (ck.trans kn) (high 1,high 2)
      s (WilsonOriginalObservedRoseProbePlace.ticket D s κ pt test)
    figure R ages κ pt N per K c v cells s w pins (touch test s) e θ=
      (WilsonOriginalObservedRoseProbeRead.quota branch:ℂ)*WilsonOriginalObservedRoseHaarProbe.priced R D O s N K c v probe
        (g N per K) (fun i=>WilsonPositionProgramReportedField.entire R (ages i) K (N,per) (w i)) e θ:=by
  obtain ⟨wall,positive,nodes⟩:=WilsonOriginalObservedRoseProbeNodes.original R Φ
  refine ⟨wall,positive,?_⟩
  intro N per b K c v first bk kn ck vc active r rp fine inside y val Q J0 V source O draw paid D s κ pt test w e θ
    o entry cells pins branch high probe
  have step:v-1+1=v:=by omega
  have home:=nodes bk kn ck (v:=v-1) (first:=first) (by omega) (by omega) rp fine inside y val V source O draw D s κ pt test
  simp only [step] at home
  have selected:WilsonOriginalObservedRoseProbeRead.filed R D s κ pt (fun j (i:s)=>cells j i.val)
      (fun i:s=>pins i.val) O draw branch=probe:=home
  have same:=WilsonOriginalObservedRoseProbeRead.original R D s κ pt N per K c v w e θ O draw paid
    simple (RunFormalChain.fromRun R).receipt vc ck kn cells pins test v
  change figure R ages κ pt N per K c v cells s w pins (touch test s) e θ=
    (WilsonOriginalObservedRoseProbeRead.quota branch:ℂ)*WilsonOlderFreshSoftRoseMarket.row (R:=R)
      D O s N K c v v (WilsonOriginalObservedRoseProbeRead.filed R D s κ pt (fun j (i:s)=>cells j i.val)
           (fun i:s=>pins i.val) O draw branch) _ _ e θ false at same
  rw [selected] at same
  exact same.trans (congrArg ((WilsonOriginalObservedRoseProbeRead.quota branch:ℂ)*·)
    (WilsonOriginalObservedRoseHaarProbe.original R D O s N K c v probe (g N per K)
       (fun i=>WilsonPositionProgramReportedField.entire R (ages i) K (N,per) (w i)) e θ paid v))

