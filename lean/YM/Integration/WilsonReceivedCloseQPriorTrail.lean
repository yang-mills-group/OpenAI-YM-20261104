def Receipt (p q:ℕ) (ε:ℝ) : Prop :=
    ∃ (start:P₀), start.rent=(g j)^p ∧ sold₀ start ∧ served₀ start q ε ∧ pub start ∧ docket start q ε

include course cut pass path in
theorem original (scroll:VowsR.LawScroll G φ) (chamber:VowsR.Chamber scroll R.kit D Q books)
    (month:Scholar.Month R.rolls D Q R.alloy.delay)
    (volume:Volume.Fund D R.rolls Q φ books R.alloy.delay)
    (fits:order ≤ Burn.horizon k+1) (thin:shelf ≤ (A).clock.J m)
    (load:op.count ≤ depth) (packed:order+shelf ≤ depth) (stage:k ≤ (A).clock.J m)
    (p q sh:ℕ) {cap' ε:ℝ} (cp:0 ≤ cap') (ep:0<ε) (dp:2*(p+1)+8 ≤ order) (ap:p+4 ≤ 3*k+2)
    (dates:day p q sh cap' ε cp ep dp ap)
    (close:PaceR.Close R sh cap' m j)
    (storedPower:2*d₀*axes+(q+(2*d₀+1)*axes+1+axes)+3 ≤ p)
    (orderFits:axes+(q+(2*d₀+1)*axes+1) ≤ order+1)
    (retained:WilsonReceivedCloseRetainedWallet.Ready R simple p q (2*d₀+1) axes (fund₀) ε (le_max_left ..) ep j)
    (complete:old∪fresh=univ) (birth:nativeStart p) :
    Receipt (R:=R) (simple:=simple) (request:=request) (freshQ:=freshQ) (u:=u) (μ:=μ) (extra:=extra)
      (D:=D) (income:=income) (K:=K) (hk:=hk) (Q:=Q) (π:=π) (Γ:=Γ) (Ψ:=Ψ) (books:=books)
      (floor:=floor) (cut:=cut) (op:=op) (ahead:=ahead) (way:=way) (ticket:=ticket)
      (warm:=warm) (education:=education) (employment:=employment) (calendar:=calendar) (hospital:=hospital)
      (pass:=pass) (upperJ:=upperJ) (upperQ:=upperQ) (upperLabels:=upperLabels) (upperClock:=upperClock)
      (upperExtra:=upperExtra) (upperOrder:=upperOrder) (order:=order) (shelf:=shelf)
      (upperSites:=upperSites) (upperOrders:=upperOrders) (sites:=sites) (orders:=orders)
      (old:=old) (fresh:=fresh) (span:=span) (height:=height) (angleCap:=angleCap) p q ε := by
  obtain ⟨voter,start,⟨notes,earned,passport,names,whole⟩,rent,aperture⟩:=birth
  let zeroTest:Wallet A₂ := WilsonMixedTestTableau.pair actors freshA
    (fun v=>⟨0,WilsonOriginalMixedTestTableau.zero upperDatum v⟩) (fun v=>⟨0,WilsonOriginalMixedTestTableau.zero datum v⟩)
  have charge:=WilsonReceivedCloseRefundedWindow.original R hk D Q π Γ Ψ books ahead A₂ K₂ mixGrades order shelf op.count
    floor physical start simple course path nextCut pass scroll chamber month hospital volume protection
    fits thin load packed stage zeroTest axes d₀ q p span sh (fund₀) height angleCap cap' ε (le_max_left _ _)
    dp ap capPos cp ep close storedPower orderFits dates (fun v=>aperture v (complete ▸ Finset.mem_univ _)) rent.le
  have pupil : pub start := by
    intro i mi Y L walk x
    let bank:WilsonOriginalCopiedHistory.Values G (Stock.census V) (R.family.side j per):=fun grid div=>declared grid div x
    have atEveryCopy:∀(grid:Side)(div:(R.family.side j per).val∣grid.val)(d:ℕ), d ≤ order → ∀y:Stationary.Link G grid,
        bank grid div d y=peek div (heldPupil j floor start) mixGrades (π (j+1)) T₀ x d y := by
      intro grid div d hd y
      exact WilsonOriginalCalibratedQCoveredTrail.entry (R:=R) (course:=course) (cut:=cut) (pass:=pass)
        (voter:=voter) (earned:=earned) (notes:=notes) (S:=start) (passport:=passport) (names:=names)
        (table:=whole) (month:=month) (fits:=fits) (narrow:=thin.trans ((A).fits.mono (floor.trans (Nat.le_succ j)))) (x:=x)
        (grid:=grid) (multiple:=div) (d:=d) (hd:=hd) (y:=y)
    exact WilsonOriginalCoveredTrail.full R hk D Q π Γ Ψ books ahead A₂ K₂ mixGrades order shelf op.count
