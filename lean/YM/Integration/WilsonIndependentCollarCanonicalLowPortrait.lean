variable {G:Gauge}{n:ℕ}{R:Run G}{N i e:ℕ}{k:Fin n→ℕ}{σ:ℝ}{side:Side}
local notation "J" => Stock.census (Fin n)
local notation "I" => Hot (J)
variable (y:Fin n → Cover)(L:Material R N i e k σ (binder side y))(test:Case L.tests)
  (κ:(v:Fin n)→Knob (L.tests v))(pt:Fin n→Chamber)(b:ℕ)
  (cells:Digits R.family.path.levels (Fin n))(seed:(v:Fin n)→Choice R k v)
  (x:Affinity.Wallet (room (Fin n)))
local notation "current" => fixed R k κ pt N b i cells seed

theorem printed (active:Addressed y L test)(filed:Wellness k (current))
    (s:I)(d:ℕ)(Y:Link G side):
    sideValue L κ pt b cells seed x false s.val d Y =
      (∏v∈s.val.val,(x v).val)*Complex.ofReal (diagonal (mass k s.val.val+d)
        (fun r z=>(touch test s.val.val) (plume (((current) y s.val.val).2 d r) side z)) Y):=by
  unfold sideValue WilsonNeutralTwoPrintPathDatedPolynomial.sheet
  rw [sum_eq_single s]
  · rw [if_pos (show s.val=(binder side y s).mode from rfl)]
    unfold WilsonNeutralTwoPrintPathDatedPolynomial.row
    simp only [Bool.false_eq_true,if_false]
    rw [active.ink s,active.center s]
    let loc:=toe s.val.val (L.pin s) (L.root s) (L.frill s)
    have paid:(current) loc s.val.val=(current) y s.val.val:=filed.filial loc y s.val.val (active.agrees s)
    change (∏v∈s.val.val,(x v).val)*Complex.ofReal (diagonal (mass k s.val.val+d)
      (fun r z=>(touch test s.val.val) (plume (((current) loc s.val.val).2 d r) side
        (jog (binder side y s).center ∘ z))) (Y ∘ jog (binder side y s).center))=_
    rw [paid]
    exact congrArg (fun z:ℝ=>(∏v∈s.val.val,(x v).val)*Complex.ofReal z)
      (recenter (fun r z=>(touch test s.val.val) (plume (((current) y s.val.val).2 d r) side z))
        (mass k s.val.val+d) (binder side y s).center Y)
  · intro t _ different
    exact if_neg (fun equal=>different (Subtype.ext equal.symm))
  · simp

variable {j:ℕ}{D:Fin n→ℕ}{V:Realm G (e+1) Credit.leanC}
    {draw:V.draws=R.family.path.levels}{rate δ:ℝ}
local notation "knobs" D:max => fun v=>contact (D v)

theorem original (lower:Submitted R V draw D k N (j+2) j rate δ σ)
    (bank:Income (k:=k) R (knobs D) pt e j)(top:j+2≤N)
    (δs:Digits V.draws (Fin n))(demand:∀s:I,0 < mass k s.val.val):
    ∃L:Material R N (j+1) e k σ (binder side y),Account V rate δ side y L (present D) ∧
      L.tests=D ∧ Addressed y L (present L.tests) ∧
      (∀z S,output L.prior S N z=fixed R k (knobs L.tests) pt N (j+2) (j+1) (onLevels draw δs) seed z S) ∧
      ∀(wallet:Affinity.Wallet (room (Fin n)))(s:I)(d:ℕ)(Y:Link G side),
        sideValue L (knobs L.tests) pt (j+2) (onLevels draw δs) seed wallet false s.val d Y =
          (∏v∈s.val.val,(wallet v).val)*Complex.ofReal (diagonal (mass k s.val.val+d)
            (fun r z=>(touch (present L.tests) s.val.val)
              (plume ((fixed R k (knobs L.tests) pt N (j+2) (j+1) (onLevels draw δs) seed y s.val.val).2 d r)
                side z)) Y):=by
  obtain ⟨L,realm,tests,amp,slack,named,roots,ink,frills,sales,copy,raw⟩:=
    lower δs (knobs D) pt seed _ side (port side y) (binder side y) pin
      (fun s=>s.property.choose_spec) demand y (present D)
  subst D
  have owned:Addressed y L (present L.tests):=addressed y L (present L.tests) named roots
    (fun s=>eq_of_heq (ink s)) frills
  obtain ⟨s₀,A,pos,one,entries⟩:=bank (j+2) (by omega)
  have checks:=(entries N top (onLevels draw δs) seed).1
  exact ⟨L,⟨realm,rfl,amp,slack,sales,raw⟩,rfl,owned,fun z s=>eq_of_heq (copy z s),
    fun wallet s d Y=>printed y L (present L.tests) (knobs L.tests) pt (j+2) (onLevels draw δs) seed
      wallet owned checks s d Y⟩

