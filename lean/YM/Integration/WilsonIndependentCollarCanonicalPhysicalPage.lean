local notation "zero₀" => Oak.grade0 R hk D Q π Γ hi P.lesson
local notation "stamped" => Mutation.stamp (student) (Γ i) (zero₀) (Burn.horizon k+2) order

open WilsonReceivedCanonicalSocketSeed (contact present)
include course cut in
theorem original (placed:P.passport=Passport.point (o))(names:P.modelIndex=V)(ink:HEq P.model (raw))
    (pass:Pass D Q R.alloy R.kit)(month:Scholar.Month R.rolls D Q R.alloy.delay)(fits:order≤Burn.horizon k+1)
    (narrow:shelf≤R.alloy.B.a.clock.J i){quiet:ℕ→SeriesA G}(actual:Read R N m (Burn.horizon k) quiet π Γ)
    {τ cash:ℝ}(funded:Issued R N (i+1) (Burn.horizon k) (quiet (i+1)) τ cash)(simple:G.Simple)
    (x:Wallet (room V))(tags:∀b:Covers R.family.path.levels.S i (coarse R i per),(step R i b.val).Choices)
    (s:Multi.Hot (J))(u:s.val.val)(v:Stationary.Link G (coarse R i per))(r a:ℕ)(through:r≤order)(kept:a≤r):
    Tendsto (fun b:Covers R.family.path.levels.S i (coarse R i per)=> (∏j∈s.val.val,(x j).val)*
      (∑rank∈Finset.range (mass d s.val.val+a+1),
        copyRead R d (fun j=>contact (heights j)) pt N i q cells s.val.val u.val a rank (coarse R i per)
          (coarse R i b.val) b.prop (y u.val) (fun z:s.val.val.erase u.val=>y z.val-y u.val)
          (Complex.ofRealCLM.comp (WilsonCoeffUV.Wheel.touch (present heights) s.val.val))
          (fun z=>∏j:Fin rank,((coordinates G (coarse R i per)) v (z j):ℂ))))
      (coverFilter R.family.path.levels.S i (coarse R i per))
      (𝓝 ((peek dvd_rfl (stamped) d (π i) (tape₀) x a v).part s.val)):=by
  have paid:=WilsonOriginalCensusCanonicalCofinalReset.original (heights:=heights) R hk D Q π Γ Ψ course
    books hi cut ahead pieces d order shelf seats physical P pt q hd (o) σ placed names ink pass month fits
    narrow actual funded simple x (coarse R i per) dvd_rfl tags s v r a through kept
  apply paid.congr'
  filter_upwards with b
  rw [mul_left_comm]
  exact congrArg (fun z=>(∏j∈s.val.val,(x j).val)*z)
    (WilsonIndependentCollarCanonicalCofinalSeats.original (D:=heights) R d pt q N i per cut y cells
      hd σ b simple (tags b) s.val.val u a v)

end YM.Integration.WilsonIndependentCollarCanonicalPhysicalPage
