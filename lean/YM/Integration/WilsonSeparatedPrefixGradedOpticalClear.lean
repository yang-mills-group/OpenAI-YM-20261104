variable {G:Gauge} {R:Run G} {order:Extraction.Order} {S:Table R.family.book}
    (F:Final R.family order S) {l:Ultrafilter (ℕ×ℕ)} {z:Trace.Terrace.Arch R.family}
    {H:(Bel R.family.book).Hierarchy}
local notation "C₀" => R.family
local notation "lev" => R.family.path.levels
local notation "mesh" => R.family.S.a
local notation "β" => R.family.path.levels.clock.hatBeta

variable {I:Type}[Fintype I][DecidableEq I][Nonempty I]
local notation "J₀" => Marks I
local notation "X" => Unit×(I×Bool)

theorem original (simple:G.Simple) (bliss:Bliss F l z H) (slow:WilsonWindowReportingPace.Slow R.kit)
    (shop:RG05Preconstruction.ReadoutPurchase R.b) (D T:ℕ)(d:I→Fin (D+1))(cater:Cater (C₀) R.doors)
    (wage:WilsonReportLampForecast.Ready (lev))
    (nested:WilsonPositionProgramNestedLengths.Nested R.rolls)(window target:ℕ):
    ∃ t ≥ D+3,∃j₀:ℕ,∀ᶠ r in trail,∀ {k:ℕ}
      {stock:Bank F l D (WilsonThermometerUnitFilingFourPoolShell.radius z T r)
        (dock (WilsonThermometerUnitFilingFourPoolShell.radius z T r)^T)}
      {W:Vane R.family k} {fits:D ≤ k} {U:(i:I)→Spin.change S (d i).val}
      (P:(i:I)→Pair F stock (Nat.le_of_lt_succ (d i).isLt) W fits (U i) r), W.checked order H k → W.wheel.r=r →
    let m:=max stock.j W.k
    let f:=WilsonInvariantActionPosition.berth R 5 m
    ∀p N (live:f<N),∃ (V:(a:Fin (D+1))→Sight C₀ a.val p) (u:(a:Fin (D+1))→Emblems C₀ a.val)
      (view:(a:Fin (D+1))→Opened C₀ a.val f p),
    (∀a,Enrolled R.makes R.doors (WilsonThermometerOffsetLedger.cash R) f N p a.val (digits R N p 0) (V a) (u a)) ∧
    ∀(weak:I→Bool)(v:(i:I)→S.Field (d i).val)(turn:I→Motion)(o:I→Site ((C₀).side f p))
      (j:ℕ)(_late:j₀≤j)(height:j≤f),
    let x:=fun i=>((P i).arm (weak i) (v i)).source (N,p)
    let y:=fun i=>offer R (x i) (view (d i)) live.le
    let b:=fun i=>anchorAt R (o i) N
    let Q:=(C₀).path.rep N p f
    let Z:=fun i=>marked R (N:=N) 0 (turn i) (o i) (V (d i)) (u (d i)) (reduce (y i)) f
    mesh j/mesh f≤(β f)^window → ((lev).params f).supportExponent=100 →
    5≤Q.p.B → (∀a b:I,a≠b → Q.p.B^2+1≤ separation (o a) (o b)) →
    2≤((lev).budget j).supportExponent →
    (∀i,charge (y i) ≤ max 1 (2*(mesh (station F (P i) (weak i))/mesh f)^((d i).val+1)*fee F (P i) (weak i) (v i))) ∧
    (∀i,charge (y i) ≤ max 1 (2*(β f)^((2*T+9)*((d i).val+1))*fee F (P i) (weak i) (v i))) ∧
    WilsonThermometerReflectedRoster.filed R (fun i=>(d i).val) (fun _=>0) turn o (fun i=>reduce (y i))
      (fun i=>V (d i)) (fun i=>u (d i)) J₀ live.le t ∧
    ∀endpoint:Config G ((C₀).side j p),flags ((C₀).path.rep N p j).p.threshold endpoint=∅ → ∀s:(J₀).Mode,
      ‖WilsonSeparatedPrefixCanonicalClearConvolution.readingAt R (N:=N) (fun A=>Q.eval A • actualTransport C₀ (N:=N)
          (fun B=> ∏i∈s.val,((charge (y i):ℝ):ℂ)⁻¹*(C₀).O N p (displayed R (d i).val (x i) (turn i)) (b i) B) live.le A) height endpoint-
       WilsonSeparatedPrefixCanonicalClearConvolution.readingAt R (N:=N) (fun A=>(Q.eval A:ℂ)*∏i∈s.val,(Z i).2.1 A) height endpoint‖ ≤ ((β f)^target)⁻¹:=by
  classical
  obtain ⟨t,above,plans⟩:=WilsonSeparatedPrefixGradedOpticalRoster.original F simple bliss slow shop D T
  obtain ⟨j₀,buyer⟩:=eventually_atTop.mp (WilsonSeparatedPrefixCanonicalClearPublic.original R
    (fun i=>(d i).val) simple shop slow cater wage nested window target t)
  refine ⟨t,above,j₀,?_⟩
  filter_upwards [plans] with r bought k stock W fits U P check age m f p N live
  obtain ⟨V,u,view,enrolled,sale⟩:=bought I d P check age p N live
  refine ⟨V,u,view,enrolled,?_⟩
  intro weak v turn o j late jf x y b Q Z span fixed large apart alpha
  have budget:Q.p=(lev).budget f:=(R.makes.wilson.represents N p f live.le).vac
  have separated (i h:I)(ne:i≠h):((lev).budget f).B^2<separation (o i) (o h):=by
    rw [←budget]
    exact Nat.lt_of_succ_le (apart i h ne)
  obtain ⟨chargeBound,polynomial,filed,_⟩:=sale weak v turn o J₀ separated
  refine ⟨chargeBound,polynomial,filed,?_⟩
  let route:=fun t (a:X)=>WilsonOriginalNullOriginGridRoster.ancestry R p f (o a.2.1) t
  have course:route f=(o∘Prod.fst) ∘ Prod.snd:=funext (fun a=>WilsonOriginalNullOriginGridRoster.starts R p f (o a.2.1))
  have parent(t)(ht:t<f):route t=((lev).clock.op t p).ratio.parent ∘ route (t+1):=
    funext (fun a=>(WilsonOriginalNullOriginGridRoster.route R p f (o a.2.1) ht).symm)
  intro endpoint clearW s
  exact buyer j late N p f jf live (fun i=>V (d i)) (fun i=>u (d i)) (fun i=>view (d i))
    (fun i=>enrolled (d i)) x turn o route filed span fixed large apart course (fun t _=>parent t) alpha endpoint clearW s

end YM.Integration.WilsonSeparatedPrefixGradedOpticalClear
