include course in
omit [Nonempty V] in
/-- The same upper Q vote publishes its full marked cover response. -/
theorem upper_vote (voter : ballot) {credit : ℝ}
    (_earned : Scene.Armada (student voter) w grades cash credit order op.count shelf)
    (_notes : Scene.Armada M w grades agenda b order op.count shelf)
    : FVA1Physical.TwoReset.RepresentsCover R cut (π ((j+1)+1)) T₀ order M grades (student voter) := by
  obtain ⟨stage,_,_⟩ := (course.2 (j+1) hi cut).earns
  let epoch := Oak.era R hk D Q π Γ hi op lesson
  let press := Cruise.funded D R.rolls Q R.alloy φ books op epoch
    (R.alloy.B.a.S.oneStep (j+1) per).exact_size M order voter lesson.entry lesson.studied ahead
  have rich : 1≤elected := (by norm_num : (1:ℝ)≤4).trans (MintClock.Page.roofers ..)
  exact FVA1Physical.TwoReset.exact_mark_binding R D Q books cut op epoch lesson.entry
    lesson.studied stage.laws.data.room.larger M grades order voter press cash (π ((j+1)+1))
    lesson.ticket _notes (Poetry.Agenda.stem ..) (inv_le_one_of_one_le₀ rich)
    (fun t => Air.license (student voter) _ grades w _earned (Poetry.Agenda.stem ..)
      (fun z => _earned.honor z t))
end YM.Integration.WilsonOriginalCalibratedQCover
