include course in
theorem original (way:WayStation R.kit) (ticket:TicketP R.alloy R.kit D bank)
    {u j:ℕ} (floor:m≤u) (age:u ≤ i) (gate:WilsonSingleHardRadius.start R simple 0 (zero_lt_one:0<(1:ℝ))≤u)
    (ju:j≤u) (door:Trace.Physical.GermGraph.Opened R.family 0 u per)
    (qual:WilsonThermometerUnitFilingShapeReceived.Qualified R A simple UV)
    (x:Fin 3→Site (R.family.side N per)) (site:o.origin=atOrigin (offsets x))
    (refs:∀v:Fin 3,R.family.ref (WilsonPositionThermometerGradedSource.grade v).val≤N)
    (q target:ℕ) (α:ℝ) (y:Site (R.family.side i per)) (Q:Poly J) (t:(J).Mode)
    (appointed:actual₂ q target y α Q t)
    (price:(J).Mode→ℝ)
    (arms:∀s,restricted Q (complement t) s≠0→
      Booked R.family N per 0 (Fₓ s) u (age.trans cut.le) ∧ paid price s u j):
    let c:=restricted Q (complement t)
    let model:=fun U=>((Ψ i).eval U:ℂ)*(total (submitted₀ U) Q).part (complement t)
    let cost:=2*|damping t Q| *(units target+5*cost₁ q target α)
    ‖(total (measured R A UV x) Q).part (complement t)-
      WilsonThermometerUnitFilingCoarse.reading R (N:=N) model u age‖ ≤
        (∑s,‖c s‖*price s)+cost:=by
  intro c model cost
  obtain ⟨b,h,blank,tinted,joined⟩:=appointed
  have node : 0≤cost₁ q target α:=by
    have pos:0<g:=by
      have beta:=congrArg Coat.gStep (course.1.walk (i+1) (Nat.le_succ_of_le hi) cut).beta
      exact beta ▸ P.issued.Waffle.soon.1
    positivity
  have trial:=WilsonThermometerReflectedWithdrawal.original R A simple way D bank ticket π Γ Ψ course
    cut.le floor age gate o qual ju door c price arms y model (damping t Q:ℝ) b h node node
    blank.1 tinted.1 blank.2.1 tinted.2.1 (fun U=>by
      rw [←restricted_value]; have balance:=joined U
      exact sub_eq_iff_eq_add.mpr (balance.trans (add_comm ..)))
  have unit (v:Coefficient (F) (R.family.side i per)) (fit:(F).coeffSize v.x≤units target) :
      ‖v.x 0‖≤units target :=
    (Finset.single_le_sum (fun j _=>norm_nonneg (v.x j)) (Finset.mem_univ 0)).trans fit
  have left:=unit b blank.2.2.2
  have right:=unit h tinted.2.2.2
  rw [←restricted_value,site,←WilsonThermometerRegisteredAncestralProperTest.translated_table R A refs x] at trial
  apply trial.trans
  apply add_le_add le_rfl
  simp only [Complex.norm_real,Real.norm_eq_abs]
  dsimp only [cost]
  calc
    _ ≤ |damping t Q| *((units target+5*cost₁ q target α)+(units target+5*cost₁ q target α)) := by
      gcongr
    _ = _ := by ring

