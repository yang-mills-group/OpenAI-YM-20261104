variable {G:Gauge} {ι:Type} [Fintype ι] [DecidableEq ι] {D k:ι → ℕ} {E m N:ℕ} {S:Finset ι}

def bill (G:Gauge)(D k:ι → ℕ)(E:ℕ):ℕ:=
  1+((costXV G E Credit.leanC).d+1)*muralExp G D k E

/-- Charge a deposited connected face at the *next* enrolled seam width, before the child is resampled. -/
theorem prior (Q:Realm G (E+1) Credit.leanC)(h:Q.anchor ≤ m)(live:m+1<N)
    (k₀:Q.draws.clock.J (m+1) ≤ (Q.draws.S.block m).val)
    (k₁:Q.draws.clock.J (m+2) ≤ (Q.draws.S.block (m+1)).val)
    (rise:5 ≤ Q.draws.clock.J (m+2))
    (stop:(Q.mint (m+1) (by omega)).σ=crestM Q.draws (m+1) rise)
    (cash:fare G D k E (Q.mint (m+1) (by omega)).gear ≤ Q.cash Credit.leanC (m+1))
    (K:family G D)(eu:Eu k K)(empty:K ∅=0)(y:ι → Cover)(z:ι → Site (ll Q.draws (m+1)).L)
    (A:ℝ)(ha:0≤A)(income:safeB (chartIn (ll Q.draws (m+1)) y z) K S E
      ((windowBasis G Q.draws.clock.kernel).width (Q.draws.clock.J (m+2))) A):
    safeB y (logO Q.draws Q.paid (m+1) N K k) S E (strip (Q.mint m h).gear)
      ((Q.y (m+1))^bill G D k E * A):=by
  let F:=(Q.mint (m+1) (by omega)).gear
  let b:=(windowBasis G Q.draws.clock.kernel).width (Q.draws.clock.J (m+2))
  have bpos:0<b:=(windowBasis G _).pos _
  let gross:=Q.y (m+1)
  have one:1≤gross:=Q.depth (m+1) (by omega)
  have buy:fare G D k E F ≤ gross:=by
    simpa only [Realm.cash,Credit.leanC,Credit.buy,one_mul,pow_one] using cash
  have stage:Q.draws.clock.J (m+2)∈stages F:=
    Finset.mem_range.mpr (by change Q.draws.clock.J (m+2)<(Q.draws.S.block (m+1)).val+3;omega)
  let credit:=costXV G E Credit.leanC
  have paid:Q.cash credit (m+1) ≤ gross^(credit.d+1):=by
    change credit.x*gross^credit.d ≤ _
    rw [pow_succ']
    exact mul_le_mul_of_nonneg_right ((le_max_left ..).trans buy) (pow_nonneg (zero_le_one.trans one) _)
  have gp:0≤Q.cash credit (m+1):=zero_le_one.trans (Credit.purchase _ one)
  have sal:shrinePost G D k E (narrow F b bpos) ≤ gross:=
    (WilsonPointChildMixedQuote.post F stage).trans buy
  have fee:shrinePost G D k E (narrow F b bpos)*(Q.cash credit (m+1))^muralExp G D k E ≤ gross^bill G D k E:=by
    unfold bill
    rw [pow_add,pow_one,pow_mul]
    exact mul_le_mul sal (pow_le_pow_left₀ gp paid _) (pow_nonneg gp _) (zero_le_one.trans one)
  intro J sub i hi r
  by_cases blank:J=∅
  · subst J
    rw [logHush]
    change Wig _ _ _ _ _ 0
    simp only [card_empty,pow_zero]
    exact Wig.zero.more zero_le_one
  have res:=WilsonPointChildMixedGear.covered Q K eu empty (show Q.anchor ≤ m+1 by omega) live y z b bpos A ha income sub hi (r:=r)
  apply (res.shave (next_strip Q h k₀ rise stop)).more
  rw [mul_pow]
  apply mul_le_mul_of_nonneg_right _ (pow_nonneg ha _)
  apply fee.trans
  nth_rw 1 [←pow_one (gross ^ bill G D k E)]
  exact pow_le_pow_right₀ (one_le_pow₀ one) (card_pos.mpr (nonempty_iff_ne_empty.mpr blank))

omit [Fintype ι] in
/-- The covered old tableau and all fresh disjoint cards are sampled at the same original root tuple. -/
theorem combine (y:ι → Cover)(T:Finset ι)(K A:family G D){w α β:ℝ}
    (ha:0≤α)(hb:0≤β)(u:safeB y K S E w α)(v:safeB y A S E w β):
    safeB y (mounted T K A) S E w (α+β):=by
  intro J sub i hi r
  by_cases old:J⊆T
  · rw [oldface T J old]
    exact (u J sub i hi r).more (pow_le_pow_left₀ ha (le_add_of_nonneg_right hb) _)
  · rw [newface T J old]
    exact (v J sub i hi r).more (pow_le_pow_left₀ hb (le_add_of_nonneg_left ha) _)

