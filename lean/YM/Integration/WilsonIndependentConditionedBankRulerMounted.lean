variable {D T:ℕ}{d:I→Fin (D+1)}{δ:ℝ}
    (books:(s:{s:ℝ // 0<s ∧ s<δ})→Book F (l:=l) ℋ Z D T s.val)
    (ρ:I→{s:ℝ // 0<s ∧ s<δ})(probe:(i:I)→{s:ℝ // 0<s ∧ s<δ}→Bool→Bool→RTable.Field (d i).val)
    (M:I→ℝ)(E:I→ℕ)(choose:J→I)(dim:J→ℕ)(fit:∀s,degrees d choose s<dim s)
    {k e u₀ u b:ℕ}(own:∀s,Rails (degrees d choose s) k u₀ e)
    {V:Realm G (e+1) C}{coins:Prices}{j:ℕ}{port:∀s,Home R₀ ((deck (G:=G) (degrees d choose) dim fit) s) (own s) j}
    (precise:(s:J)→Bool×Bool→Alma (R₀.family.labels.level (degrees d choose s))→ℝ)
    (I₀:Initialize G)(survey plain:J→Bool→Bool)

def Literal {f K N per target:ℕ}{η:ℝ}{up:f≤K}{live:K≤N}
    (phys:Bool)(axes:(i:I)→Bool→R₀.family.label (d i).val≃ₗ[ℂ]R₀.family.label (d i).val)
    (turn:J→Bool→Signed)(hand:J→Bool→Bool)(loc:J→Bool→Site (R₀.family.side f per))(phase:J→Bool→ℂ)
    (r:(s:J)→Bool→Resident R₀ (degrees d choose s) f K N per target up live η):Prop:=
  ∀s a,let i:=choose s;let L:=(books (ρ i)).rows (d i);let arm:=L.arm a (probe i (ρ i) phys a)
    (r s a).station=station F L a ∧ (r s a).axis=axes i a ∧ (r s a).source=arm.source (N,per) ∧
    (r s a).salary=fee F L a (probe i (ρ i) phys a) ∧ (r s a).phase=phase s a ∧
    Printed R₀ (station F L a) (axes i a) (arm.source (N,per)) (turn s a) (hand s a) (loc s a) (r s a).arm

def Posted (m f K target:ℕ)(η:ℝ)(q spatial width power:ℕ)(constant r₀:ℝ)(L M₀:Credit):Prop:=
  ∃up:f<K,∀N per(live:K≤N),
    ∃axes:(i:I)→Bool→R₀.family.label (d i).val≃ₗ[ℂ]R₀.family.label (d i).val,
      ∀(phys:Bool)(turn:J→Bool→Signed)(hand:J→Bool→Bool)(loc:J→Bool→Site (R₀.family.side f per))
        (phase:J→Bool→ℂ), (∀s c,‖phase s c‖≤1) →
      ∃arms:(s:J)→Bool→Resident R₀ (degrees d choose s) f K N per target up.le live η,
        Literal F books ρ probe choose phys axes turn hand loc phase arms ∧
        ∃Y:Assigned R₀ (deck (G:=G) (degrees d choose) dim fit) own V coins j port (fun _=>Bool×Bool)
          (stamps arms m I₀ survey plain dim fit) (wages e arms m plain precise) u b m m K N,
          Enrolled Y L M₀ ∧ Settled Y f per q spatial width power constant r₀

theorem original {n t:ℕ}(effort:I→ℕ){ceiling η:ℝ}{stage target m K:ℕ}
    (bought:WilsonReflectedMixedObservedPanel.Received F D T n t d effort books probe M ceiling η stage target ρ
      (reporter F books ρ) K)
    (sale:∀phys:Bool,Paid F D T d books (fun i s=>probe i s phys) M E ρ (reporter F books ρ))
    (C₁ C₂:J→Credit)(rate L M₀:Credit)(nn:∀s p v,0≤precise s p v)
    (opened:j ≤ m)(home:m ≤ reporter F books ρ)(axes:V.y=zz R₀.family.path.levels)
    (q:ℕ)(order:q ≤ e)(weak:∀N per,K≤N→|regulatorRun R₀.family N per K|≤1)(ζ:ℝ)
    (pos:0≤ζ)(quarter:ζ≤1/4)(et:0≤η)(room:2*η≤ζ/4)(span:((∑s,degrees d choose s:ℕ):ℝ)+ζ<b)
    (spatial width power:ℕ)(constant r₀:ℝ)
    (funds:Wallet R₀ (deck (G:=G) (degrees d choose) dim fit) C₁ C₂ rate L M₀ coins k e u b
      (reporter F books ρ) m K q ζ (fun s=>E (choose s)) (capAt R₀ d choose M precise e) spatial width power constant r₀)
    (supply:∀N per (up:reporter F books ρ≤K)(top:K≤N)
      (arms:(s:J)→Bool→Resident R₀ (degrees d choose s) (reporter F books ρ) K N per target up top η),
      ∃Y:Assigned R₀ (deck (G:=G) (degrees d choose) dim fit) own V coins j port (fun _=>Bool×Bool)
        (stamps arms m I₀ survey plain dim fit) (wages e arms m plain precise) u b m m K N,
        Enrolled Y L M₀ ∧ Earned Y C₁ C₂ rate L M₀):
    Posted (u:=u) (b:=b) (V:=V) (port:=port) (coins:=coins) F books ρ probe choose dim fit own precise I₀ survey plain
      m (reporter F books ρ) K target η q spatial width power constant r₀ L M₀:=by
  classical
  obtain ⟨up,mount⟩:=WilsonIndependentConditionedBankPhysicalPorts.issued F D T n t d effort books probe M
    ceiling η stage target ρ (reporter F books ρ) K bought
  refine ⟨up,?_⟩
  intro N per live
  obtain ⟨matrix,all⟩:=mount N per live
  refine ⟨matrix,?_⟩
  intro phys turn hand loc phase scale
  choose row named using fun s:J=>all (fun i a=>probe i (ρ i) phys a) (fun _=>turn s) (fun _=>hand s)
    (fun _=>loc s) (fun _=>phase s)
  let arms (s:J)(i:Bool):Resident R₀ (degrees d choose s) (reporter F books ρ) K N per target up.le live η:=
    row s (choose s) i
  have registered:Literal F books ρ probe choose phys matrix turn hand loc phase arms:=
    fun s i=>named s (choose s) i
  obtain ⟨Y,old,price⟩:=supply N per up.le live arms
  refine ⟨arms,registered,Y,old,?_⟩
  have filed (s:J)(a:Bool):=(registered s a)
  exact WilsonIndependentConditionedBankRulerReport.original F books ρ (fun i s=>probe i s phys) M E choose dim fit
    own arms precise I₀ survey plain Y C₁ C₂ rate L M₀ price (sale phys) nn phase scale
    (fun s a=>⟨(filed s a).1,(filed s a).2.2.2.1,(filed s a).2.2.2.2.1⟩)
    opened home axes q order (weak N per live) ζ pos quarter et room span spatial width power constant r₀ funds

end YM.Integration.WilsonIndependentConditionedBankRulerMounted
