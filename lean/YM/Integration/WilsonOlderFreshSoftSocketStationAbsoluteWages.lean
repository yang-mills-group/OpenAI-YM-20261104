private theorem splice {r fee z τ:ℝ}(rp:0≤r)(cp:0≤fee)(rich:2≤z)(tp:0≤τ)(small:τ≤1)
    (high middle low:ℂ)(hb:r*‖middle‖≤fee)(hc:r*‖low‖≤fee)(ab:r*‖high-middle‖≤fee*τ)(bc:r*‖middle-low‖≤fee*τ):
    r*‖high‖≤fee*z ∧ r*‖low‖≤fee*z ∧ r*‖high-low‖≤fee*z*τ:=by
  have twice:fee+fee≤fee*z:=by calc _=fee*2:=by ring
                               _≤_:=mul_le_mul_of_nonneg_left rich cp
  have sz:fee*τ≤fee:=mul_le_of_le_one_right cp small
  have norm_high:‖high‖≤‖high-middle‖+‖middle‖:=by calc
    ‖high‖=‖(high-middle)+middle‖:=by rw [sub_add_cancel]
    _≤_:=norm_add_le _ _
  have norm_gap:‖high-low‖≤‖high-middle‖+‖middle-low‖:=by calc
    ‖high-low‖=‖(high-middle)+(middle-low)‖:=by congr 1;ring
    _≤_:=norm_add_le _ _
  refine ⟨?_,hc.trans (by linarith),?_⟩
  · calc _≤r*(‖high-middle‖+‖middle‖):=mul_le_mul_of_nonneg_left norm_high rp
         _=r*‖high-middle‖+r*‖middle‖:=mul_add _ _ _
         _≤fee+fee:=add_le_add (ab.trans sz) hb
         _≤_:=twice
  · calc _≤r*(‖high-middle‖+‖middle-low‖):=mul_le_mul_of_nonneg_left norm_gap rp
         _=r*‖high-middle‖+r*‖middle-low‖:=mul_add _ _ _
         _≤fee*τ+fee*τ:=add_le_add ab bc
         _=(fee+fee)*τ:=by ring
         _≤_:=mul_le_mul_of_nonneg_right twice tp

