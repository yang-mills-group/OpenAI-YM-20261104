theorem original (simple:G.Simple)(bliss:Bliss F l z H)(lead:Leading F Jr)
    (obedient:∀d:ℕ,∀ᶠr in trail,Frame.obedient F H (Jr r) d)
    (slow:WilsonWindowReportingPace.Slow R.kit)(shop:RG05Preconstruction.ReadoutPurchase R.b)
    (cap:∀j,1≤((P).budget j).supportExponent)(upper:∀j,((P).budget j).supportExponent≤100)
    (quote:OPE.Therm.Poetry (P)):
    ∃bank:ℕ,∀target debt mesh:ℕ,∃U:Set ℝ,U∈trail ∧
    let J₀:=stop target (debt+2*bank) mesh
    ∀Q:ℕ,J₀≤Q → ∀L:ℕ,∀D:Fin 3→ℕ,∀X:ℝ,0≤X → ∀ᶠv:ℕ in atTop,
    ∀V:Realm G (Q+1) Credit.leanC,∀draw:V.draws=P,V.paid=R.metals.O → V.y=zz P →
    V.anchor≤v → ∀r∈U,∀{T:ℕ}(B:Book F (l:=l) H z 6 T r),WilsonMovingForkWindowBooks.Priced F B →
    ∀actual:Next.UVStress.Lifts (C) B.k,∀(N per b K c requested power tag:ℕ)(credit:ℝ)(bk:b≤K)(kn:K≤N),b<N →
    v≤c → c≤K → v+1≤K → σ K-σ v≤L*Real.log (β v) →
    let θ:=g N per v
    (a B.W.k)/(a K)≤(θ⁻¹)^mesh → r/(a K)≤(θ⁻¹)^mesh →
    ∀(n:ℕ)(face:Fin n→{s:(J).Mode // s.val.Nonempty})(file:Filed R ages K)
      (panel:Fin n→Panel R ages N per b K bk kn requested power tag credit),
    (∀i,(panel i).slot=file.station) → (∀i,(panel i).axis=file.A N per) →
    (∀i j,(panel i).slot j=B.W.k) →
    (∀i j,(panel i).names j=WilsonNeutralOffsetCutoff.named R (group F Jr Z B actual) N per j) →
    (∀i,Dormitory V (WilsonCoeffUV.Wheel.Mark.mass ages (face i).val.val) 0 Credit.leanC) →
    ∀(κ:Fin n→(i:Fin 3)→Knob (D i))(pt:Fin n→Fin 3→Chamber)(cells:Fin n→Digits V.draws (Fin 3))
      (y:Fin n→Fin 3→ Cover)(test:(i:Fin n)→Pen D (face i).val.val→L[ℝ]ℝ)
      (phase:Fin n→ℂ),(∀i,‖test i‖≤X*(θ⁻¹)^debt) →
    let w i:=votes R ages (N:=N) (per:=per) file (panel i).names (panel i).turn
    let path i:=cast (congrArg (fun q=>Digits q (Fin 3)) draw) (cells i)
    let row i:=normalized R ages (κ i) (pt i) N per K c v (path i) (face i).val.val (w i) (y i) (test i)
    let heard j:=∑i:Fin n,phase i*(r:ℂ)^(height ages (face i).val.val)*row i j θ
    ‖heard Q-heard J₀‖≤(∑i:Fin n,‖phase i‖)*θ^target:=by
  obtain ⟨E,received⟩:=WilsonOriginalObservedRosePublicTail.original F Jr Z simple bliss lead obedient slow shop cap upper quote
  refine ⟨E,?_⟩
  intro target debt mesh
  obtain ⟨U,active,calendar⟩:=received target debt mesh
  refine ⟨U∩Set.Ioi 0,Filter.inter_mem active self_mem_nhdsWithin,?_⟩
  intro J₀ Q retained L D X xp
  have all:=Filter.eventually_all.mpr (fun s:{s:(J).Mode // s.val.Nonempty}=>calendar Q retained L D s.val s.property X xp)
  filter_upwards [all] with v rates
  intro V draw past price anchor r hr T B paid actual N per b K c requested power tag credit bk kn deep vc ck next span θ base tide n face file panel stations axes homes names kinetic κ pt cells y test phase capFee w path row heard
  have entered (i:Fin n):r^(height ages (face i).val.val)*‖row i Q θ-row i J₀ θ‖≤θ^target:=
    rates (face i) V draw past price anchor (kinetic i) r hr.1 B paid actual N per b K c requested power tag credit bk kn deep vc ck next span
      (panel i) file (stations i) (axes i) (homes i) (names i) base tide (κ i) (pt i) (cells i) (y i) (test i) (capFee i)
  have rpos:0≤r:=le_of_lt hr.2
  have exact_sum:heard Q-heard J₀=∑i:Fin n,phase i*(r:ℂ)^(height ages (face i).val.val)*(row i Q θ-row i J₀ θ):=by
    dsimp only [heard]
    rw [←Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro i _
    ring
  rw [exact_sum,Finset.sum_mul]
  apply (norm_sum_le _ _).trans
  apply Finset.sum_le_sum
  intro i _
  rw [norm_mul,norm_mul,norm_pow,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg rpos,mul_assoc]
  exact mul_le_mul_of_nonneg_left (entered i) (norm_nonneg _)

