attribute [local instance] Gauge.frobInner
variable {G:Gauge}(R:Run G)(wood:Primer.Families R.family)(a:hue G){Q m N i:ℕ}
    (dmax:Fin 3 → ℕ)(depth:∀v,WilsonOlderFreshThermometerRoom.weight v<dmax v)(σ:ℕ → ℝ)
    (digit:Fin 3 → ∀i,Site (R.family.S.block i))
    (T:WilsonOlderFreshThermometerSources.Table (m:=m) (N:=N) (Q:=Q) R dmax σ)(lo:m ≤ i)(hi:i<N)
    {I:Type}[Fintype I](owner:I → Fin 3)
    (columns:∀l,Letter (R.family.labels.level (WilsonOlderFreshThermometerRoom.weight (owner l))))
    (films:∀l,Studio (dmax (owner l))) (charge:I→ℂ)
    (per:ℕ)(sites:Fin 3→Site (R.family.side (i+1) per))(A:Fin 3→Set ℂ)(t:Wallet A)
local notation "T₁" => WilsonOlderFreshThermometerSources.selected R dmax σ T (lo.trans (Nat.le_succ i)) (Nat.succ_le_of_lt hi) owner columns films
local notation "Z₁" => WilsonOriginalThreeSoldCharts.charts R wood a dmax depth digit (Nat.succ_le_of_lt hi) owner columns films
local notation "grades" => WilsonOlderFreshThermometerRoom.weight
local notation "M" => WilsonOriginalPointCompactRoster.rows owner grades sites T₁ A charge
local notation "J" => Stock.census (Fin 3)

local notation "Copies" X:max => Covers R.family.path.levels.S i X
variable (grid:Side)(tiles:(R.family.side i per).val ∣ grid.val)
    (chosen : ∀ c : Covers R.family.path.levels.S i grid, Forest (R.family.path.levels.clock.op i c.val).ratio)
    (marked : ∀ c : Covers R.family.path.levels.S i grid, (R.family.path.levels.clock.op i c.val).Choices)
    (b:Stationary.Link G grid)

def phase (r j:ℕ)(c:Copies grid):Poly (J):=
  (((Pages grid (R.family.side i c.val):ℕ):ℝ)⁻¹:ℝ) •
    WilsonOriginalThreeForestObserver.observed R wood a dmax depth digit hi owner columns films charge sites A t c.val
      (tiled R tiles c) (chosen c) (marked c) (convey (coverWin c.prop) b) r j

theorem original (sold:WilsonOlderFreshThermometerSources.Sold R wood a dmax depth σ digit T)
    (positive:0<σ (i+1))(bounded:∀v x,x∈A v→‖x‖≤1)
    {e:ℕ}{quiet:ℕ→SeriesA G}{π:ℕ→Layout G}{Γ:ℕ→Pace.Coin}
    (course:Read R N m e quiet π Γ){τ cash:ℝ}(funded:Issued R N (i+1) e (quiet (i+1)) τ cash)
    (legal:Legal (Step.tape (e+2)) (π (i+1)))(r order j:ℕ)(retained:r ≤ Q)(grade:r ≤ e+2)
    (kept:r ≤ order)(tested:j ≤ r)
    {ν μ:Type}{fineSeat:Passport (R.family.side (i+1) per) (Fin 3)}{lowerSeat:Passport (R.family.side i per) (Fin 3)}
    (given:ν→Row fineSeat (J) G (Wallet A))(student:μ→Row lowerSeat (J) G (Wallet A))
    (site:fineSeat=Passport.point sites)(keys:ν=WilsonOriginalPointCompactRoster.Index owner grades T₁)
    (same:HEq given (M))(voter:RepresentsCover R hi (π (i+1)) (Step.tape (e+2)) order given grades student):
    Tendsto (phase R wood a dmax depth digit hi owner columns films charge per sites A t grid tiles chosen marked b r j)
      (coverFilter R.family.path.levels.S i grid)
      (𝓝 (peek tiles student grades (π (i+1)) (Step.tape (e+2)) t j b)):=by
  let intake:=fun c:Copies grid=>copyColor (tiled R tiles c) (M) grades (fun a=>(M a).paint t) (π (i+1)) (Step.tape (e+2))
  have eq:=WilsonOriginalCopiedContraction.named (R:=R) (Y:=student) (published:=voter)
    (t:=t) (grid:=grid) (multiple:=tiles) (inputs:=intake)
    (matched:=fun c=>WilsonOriginalNamedCompactCover.color site keys same (tiled R tiles c) grades t (π (i+1)) (Step.tape (e+2)))
    (F:=chosen) (tag:=marked) (A:=b) (e:=j) (he:=tested.trans kept)
  apply eq.congr' (Filter.Eventually.of_forall (fun c=>?_))
  unfold WilsonOriginalCopiedContraction.contraction phase
  apply congrArg (fun x:Poly (J)=>(((Pages grid (R.family.side i c.val):ℕ):ℝ)⁻¹:ℝ) • x)
  exact WilsonOriginalThreeForestObserver.original R wood a dmax depth σ digit T lo hi owner columns films charge sites A t
    c.val (tiled R tiles c) (chosen c) (marked c) sold positive bounded course funded legal
    (convey (coverWin c.prop) b) r order j retained grade kept tested

