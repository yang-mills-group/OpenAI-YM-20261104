def demand (target prior:ℕ):ℕ:=target+3*(prior+2)+1

theorem original (actual printed:Faces → ℂ){r χ θ:ℝ}(rp:0≤r)(ch:0<χ)(gp:0<θ)(near:θ≤4*χ)
    (target prior:ℕ)(B:ℝ)(bp:0≤B)(cold:21≤θ⁻¹)(ample:B*(4:ℝ)^prior≤θ⁻¹)
    (gross:∀s:Faces,s.Nonempty → r^(height ages s)*‖actual s‖≤B*(χ⁻¹)^prior)
    (jump:∀s:Faces,s.Nonempty → r^(height ages s)*‖actual s-printed s‖≤θ^(demand target prior)):
    r^14*‖value actual-value printed‖≤θ^target:=by
  let z:=θ⁻¹
  have zp:1≤z:=(by norm_num : (1:ℝ)≤21).trans cold
  have z₂:2≤z:=(by norm_num : (2:ℝ)≤21).trans cold
  have small:θ≤1:=by simpa only [z,inv_mul_cancel₀ gp.ne',one_mul] using mul_le_mul_of_nonneg_right zp gp.le
  have factor:χ⁻¹≤4*z:=by
    rw [←div_eq_mul_inv,le_div_iff₀ gp,inv_mul_eq_div,div_le_iff₀ ch];exact near
  have bought(s:Faces)(hs:s.Nonempty):r^(height ages s)*‖actual s‖≤z^(prior+1):=calc
    _≤B*(χ⁻¹)^prior:=gross s hs
    _≤B*(4*z)^prior:=mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (inv_nonneg.mpr ch.le) factor _) bp
    _=(B*4^prior)*z^prior:=by rw [mul_pow];ring
    _≤z*z^prior:=mul_le_mul_of_nonneg_right ample (pow_nonneg (zero_le_one.trans zp) _)
    _=z^(prior+1):=by rw [pow_succ];ring
  have cost(s:Faces)(hs:s.Nonempty):r^(height ages s)*‖printed s‖≤z^(prior+2):=by
    have placed:=norm_sub_le (actual s) (actual s-printed s)
    rw [sub_sub_cancel] at placed
    have both:=mul_le_mul_of_nonneg_left placed (pow_nonneg rp (height ages s))
    rw [mul_add] at both
    have first:= (bought s hs)
    have second: r^(height ages s)*‖actual s-printed s‖≤1:=(jump s hs).trans (pow_le_one₀ gp.le small)
    have rich:1≤z^(prior+1):=one_le_pow₀ zp
    calc _≤z^(prior+1)+1:=both.trans (add_le_add first second)
         _≤z^(prior+1)*2:=by linarith only [rich]
         _≤z^(prior+1)*z:=mul_le_mul_of_nonneg_left z₂ (pow_nonneg (zero_le_one.trans zp) _)
         _=z^(prior+2):=by rw [pow_succ z (prior+1)]
  let τ:=θ^(demand target prior)
  have top (s:Faces)(hs:s.Nonempty):r^(height ages s)*‖actual s‖≤z^(prior+2):=
    (bought s hs).trans (pow_le_pow_right₀ zp (by omega))
  have gap (s:Faces)(hs:s.Nonempty):r^(height ages s)*‖actual s-printed s‖≤z^(prior+2)*τ:=
    (jump s hs).trans (le_mul_of_one_le_left (pow_nonneg gp.le _) (one_le_pow₀ zp))
  have covered:=WilsonOriginalObservedRoseSevenScale.original actual printed rp zp (pow_nonneg gp.le (demand target prior))
    0 (prior+2) (by simpa only [Nat.zero_mul,Nat.add_zero] using top)
    (by simpa only [Nat.zero_mul,Nat.add_zero] using cost) (by simpa only [Nat.zero_mul,Nat.add_zero] using gap)
  have last:21*z^(3*(prior+2))*τ≤θ^target:=calc
    _≤z*(z^(3*(prior+2)))*τ:=mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right cold (pow_nonneg (zero_le_one.trans zp) _)) (pow_nonneg gp.le _)
    _=θ^target:=by
      dsimp only [τ,z,demand]
      rw [pow_succ θ (target+3*(prior+2)),pow_add θ target,inv_pow]
      field_simp [gp.ne']
  simpa only [Nat.zero_mul,Nat.add_zero] using covered.trans last

end YM.Integration.WilsonReceivedChronologicalFixedRoseHeldCofactor
