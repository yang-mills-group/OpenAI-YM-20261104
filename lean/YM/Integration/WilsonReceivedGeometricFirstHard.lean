include P in
/-- The omitted compulsory account of the independently named signed upper scalar, using precisely
its stored witness and the original Wilson push of the complete source one date earlier. -/
theorem original (live:i<N) (simple:G.Simple) (course:Concourse R.alloy R.kit R.T π Γ m N per k Ψ)
    (scroll:VowsR.LawScroll G φ) (chamber:VowsR.Chamber scroll R.kit D Q books) (pass:Pass D Q R.alloy R.kit)
    (hospital:MintClock.Hospital D R.rolls Q R.kit.target φ books ahead R.alloy.delay) (size:seats ≤ Burn.horizon k+2)
    (way:WayStation R.kit) (M:WilsonMeasuredRankedMenu.Menu R 0)
    (slow:∀ j,((R.family.S.block j).val:ℝ) ≤ Real.log (Lambda R.family.path.levels j))
    (prepared:WilsonReportLampForecast.Ready R.family.path.levels) {σ:ℝ} {T:Campaign R} {W:Campaign.Pillars R T}
    (funded:FundedOriginalProperties.{u} simple σ W)
    (deep:2*(5+4+1)+8 ≤ order) (aged:5+4+4 ≤ 3*k+2)
    (eligible:Ready R simple 0 5 k order shelf M slow prepared (by decide) deep aged i)
    (test:Wallet actors) (singer:MSbar.Heath.Voice G) (axes:Lattice.Order) (q target sourcePower d:ℕ)
    (ε wallet:ℝ) (c:(Stock.census (Fin 3)).Mode→ℂ)
    (program:Wallet actors→Stationary.Link G (R.family.side (i+1) per)→ℕ→Poly (Stock.census (Fin 3)))
    (heard:WilsonReceivedGeometricCoveredPrior.Heard R hk D Q π Γ Ψ books (floor.trans (Nat.le_succ i)) ahead
      order shelf seats actors pieces grades above L test singer axes q target sourcePower d ε wallet c 0 program) :
    let h := Classical.choose heard
    ∃ (z:Coefficient (F₀) (R.family.side i per)) (u:ℝ),
      (z.Format 0 Y₀ (Ψ i) ∧ z.remBound 0 (Ψ i) κ₀ u) ∧ (F₀).coeffSize z.x ≤ u ∧
      GermGraph.transition (C:=R.family) 0 N per i (account h (incoming)) = z.density 0 S₀ (Ψ i) ∧
      (2+4*(R.family.path.levels.params i).columns)*u ≤ L₀^(-(1/8:ℝ))*(rough wallet q target) := by
  let h:=Classical.choose heard
  have data:=Classical.choose_spec heard
  have trueBudget : h.Format 0 Y₀ (incoming) ∧ h.remBound 0 (incoming) κ₁ (rough wallet q target) :=
    ⟨data.1,data.2.1⟩
  exact WilsonMeasuredOwnerStrictReturn.original R hk D Q π Γ Ψ books ahead actors pieces grades order shelf seats
    floor (fun test : Wallet actors => LocalComparison.actualPush R.family N per (i+1) (above test)) P 0 (0:Fin 3) live simple course scroll chamber pass hospital size way M slow prepared
    (funded.2.1.paid.fixed i).le 5 deep aged (by decide) eligible h (rough wallet q target) trueBudget

end YM.Integration.WilsonReceivedGeometricFirstHard
