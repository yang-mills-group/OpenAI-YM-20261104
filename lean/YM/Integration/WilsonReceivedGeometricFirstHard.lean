  (L : WilsonOriginalReceivedChain.Post (N:=N) R hk D Q π Γ Ψ books ahead actors pieces grades
    order shelf seats (i+1) (floor.trans (Nat.le_succ i)) above)
variable (P : WilsonOriginalReceivedChain.Post (N:=N) R hk D Q π Γ Ψ books ahead actors pieces grades
    order shelf seats i floor (fun test : Wallet actors => LocalComparison.actualPush R.family N per (i+1) (above test)))
