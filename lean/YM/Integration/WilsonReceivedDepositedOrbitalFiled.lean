theorem original [Fintype I]{p':Passport n' (Fin n)}{μ:Type}
    (high:μ → Row p' (Stock.census (Fin n)) G (Affinity.Wallet (room (Fin n))))
    (placed:p'=P)(names:μ=((l:I)×((words H) l).Roster))(ink:HEq high (mounts H))
    {w:Fin n → ℝ}{σ₀ expense:ℝ}{order seats shelf:ℕ}
    (stock:Scene.Armada high w k σ₀ expense order seats shelf)(width₀:0 < σ₀)
    (per:ℕ)(F:Forest (step R j per).ratio)(tag:(step R j per).Choices)
    (h:n'.val∣(fine R j per).val)(x:Affinity.Wallet (room (Fin n)))
    {start e:ℕ}{quiet:ℕ → SeriesA G}{π:ℕ → Layout G}{Γ:ℕ → Pace.Coin}
    (legal:Legal (Step.tape (e+2)) (π (j+1)))
    (course:Read R N start e quiet π Γ)(live:start ≤ j){τ cash:ℝ}
    (funded:Issued R N (j+1) e (quiet (j+1)) τ cash)
    (b:Stationary.Link G (coarse R j per))(r:ℕ)(retained:r ≤ q)(grade:r ≤ e+2):
    let A₀:=Stationary.arm G _ 1 b
    let K₀:=model R N j per (show j<N by omega)
    let raw:=Bulk.Fk K₀ F tag (copyColor h high k (fun a=>(high a).paint x) (π (j+1)) (Step.tape (e+2))) A₀ r
    let ready:=WilsonReceivedDepositedOrbitalResponse.report (k:=k) B old q c y t R N j per F h x A₀ r
    let relabel:=WilsonReceivedDepositedAlias.fold (Stock.census (Fin n)) (WilsonReceivedDepositedOrbitalPhases.name B R j per)
    ratio raw=hom relabel r ready ∧ logMarked raw=hom relabel r (connected ready):=by
  intro A₀ K₀ raw ready relabel
  let oldWord:=fun l=>offered old k q y t (B l).mode.val (c l)
  let past:=staged B R N j per (show j<N by omega) F tag h x oldWord A₀ r
  have earned:=WilsonReceivedDepositedOrbitalGaussian.original R Y lo enrolled N X positive limit width B c inside pin
    deep y t closed tickets old well hs base cover bound high placed names ink stock width₀ per F tag h x legal course live funded b r retained grade
  dsimp only at earned
  have salary:=WilsonReceivedDepositedOrbitalResponse.phase B old q c y t R j per well hs base cover pin
  have rename:=WilsonReceivedDepositedOrbitalConditioned.before B k R N j per (show j<N by omega)
    F tag h x oldWord A₀ (fun l u=>(salary l u).1) (fun l u=>(salary l u).2) r
  have named:ratio past=ready:=WilsonReceivedDepositedOrbitalResponse.normalized B old q c y t R N j per
    (show j<N by omega) F tag h well hs base cover pin x A₀ Y.hG r
  have vacant:=WilsonReceivedDepositedOrbitalThermals.original_quiet (Stock.census (Fin n)) (WilsonReceivedDepositedOrbitalPhases.name B R j per)
  have unit:UnitLeading past:=WilsonReceivedDepositedOrbitalConditioned.accepts B R N j per (show j<N by omega)
    F tag h x oldWord A₀ r
  constructor
  · exact earned.1.trans ((congrArg Order.ratio rename.symm).trans
      ((WilsonReceivedDepositedOrbitalThermals.ratio relabel vacant past unit).symm.trans (congrArg (hom relabel r) named)))
  · exact earned.2.1.trans ((congrArg logMarked rename.symm).trans
      ((WilsonReceivedDepositedOrbitalThermals.marked relabel vacant past unit).symm.trans
        (congrArg (hom relabel r) (congrArg connected named))))

