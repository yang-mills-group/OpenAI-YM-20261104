theorem original (simple:G.Simple)(quiet:WilsonReceivedCloseFundedHeat.Quiet R)
    (price:ℕ→Gear G→ℝ)(funded:FundedMarkedCoverRows.prices price R.kit)(e:ℕ):
    ∀ᶠj:ℕ in Filter.atTop,∀ b (_jb:j<b),∃s A:ℝ,0<s ∧ ∃one:1≤A,
    ∃ν C:Finset (Fin n)→Fin (e+1)→ℕ→ℝ,
      (∀J a r,0<ν J a r ∧ 0≤C J a r) ∧
    ∀(N:ℕ)(_live:b≤N)(Y:Realm G (e+1) Credit.leanC)(lo:Y.anchor≤j)(same:Y.draws=R.family.path.levels),
      Y.paid=R.metals.O → (Y.mint (j+1) (by omega)).σ ≤ s → ∀(S:Finset (Fin n))
      (cells:Digits R.family.path.levels (Fin n))(q:(v:Fin n)→Choice R k v),
      let old:=fixed R k κ pt N b (j+1) cells q
      let offsets:=fun (_:Fin n → Cover)=>route R same cells j
      ∃X:Input Y lo S k D A,
    X.offsets=offsets ∧
    (∀y,X.familyAt y=submit old k e (fun v=>(ll Y.draws j).L.val • y v+lift (offsets y v))) ∧
    ∀(δ σ:ℝ)(width:0<σ)(enrolled:Paid R Y lo D k δ σ)
      (_closed:Cloze D k Y Credit.leanC)(_tickets:Insure n (mass k univ) Y Credit.leanC)
      (per:ℕ)(J:Finset (Fin n))(c:Fin n)(inside:J⊆S)(pin:c∈J)(deep:0 < mass k J)
      (o:Cover)(t:Case D)(u:Frill J c)
      (_room:4*crestCard (toe J c o u) J<(R.family.side j per).val)
      {pp:Passport (R.family.side j per) Unit}{marks:Marker.Census Unit}(site:Binder pp marks)
      (actors:Unit→Set ℂ)(_bounded:∀x,‖value actors x‖≤1)(x:Affinity.Wallet actors)
      (layout:Layout G)(tape:Finset Age)(h:Fin (e+1))(direction:Link G (R.family.side j per)),
    let n₀:=R.family.side j per
    let y:=toe J c o u
    let T:=WilsonOlderFreshConnectedBirth.issued R Y lo enrolled N c X inside pin (zero_le_one.trans one)
      (by omega:j<N) deep width.le o t u
    let independent:=fixed R k κ pt N b j cells q y J
    let covered:Gen ℝ (Woods G n₀):=fun r z=>(touch t J) (plume (independent.2 h.val r) n₀ (jog (wrap n₀ o) ∘ z))
    (peek dvd_rfl (T.rows site actors) (fun _=>mass k J) layout tape x h.val direction).part
      (WilsonNeutralRenderedColumn.submitted site).val=
      value actors x*Complex.ofReal (diagonal (mass k J+h.val) covered (direction ∘ jog site.center)) ∧
    ∀r,let upper:=spent R k N j e n₀ old y (cells j) J h.val r
       MarkU y J upper (independent.2 h.val r) (ν J h r) (C J h r) ∧
       (∑z,‖upper z-plume (independent.2 h.val r) n₀ z‖)≤
         tariff (Loc G 1) r (ν J h r) (C J h r)*catchW (ν J h r/512) n₀:=by
  filter_upwards [WilsonNeutralTwoPrintPathBooked.original (h:=D) R k κ pt simple quiet price funded e,
      WilsonNeutralTwoPrintPathItinerary.original (h:=D) R k κ pt simple quiet price funded e] with j admitted budget
  intro b jb
  obtain ⟨s,A,hs,one,mounted⟩:=admitted b jb
  have rent (J:Finset (Fin n))(a:Fin (e+1))(r:ℕ):=budget b jb J a.val r (by omega)
  choose C ν hC hν winding using rent
  refine ⟨s,A,hs,one,ν,C,fun J a r=>⟨hν J a r,hC J a r⟩,?_⟩
  intro N live Y lo same coins width S cells q old offsets
  obtain ⟨X,offsetsPaid,source,head⟩:=mounted N live Y lo same coins width S cells q
  refine ⟨X,offsetsPaid,source,?_⟩
  intro δ σ sw enrolled closed tickets per J c inside pin deep o t u room pp marks site actors bounded x
    layout tape h direction
  dsimp only
  constructor
  · have edge:=WilsonNeutralTwoPrintPathPlaced.original R Y lo enrolled N c X inside pin (zero_le_one.trans one)
      (by omega:j<N) deep sw.le o t u site actors bounded x sw closed tickets layout tape h.val (by omega) direction
    apply edge.trans
    unfold relative
    rw [head _ J h.val (by omega)]
  · intro r
    have same:=winding J h r N live q (R.family.side j per) (toe J c o u) cells
    exact ⟨same,WilsonNeutralTwoPrintPathRankFare.original ⟨c,pin⟩ room (hν J h r) same⟩

