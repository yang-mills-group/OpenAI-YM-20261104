/-- All incoming ordinary angular tables for the next physical date share the
cash, true prior and held positions of the preceding original calculation. -/
theorem original (G:Gauge)(D k:ι → ℕ)(E H:ℕ):
    ∃fare:Gear G → ℝ,∃M:ℝ,0  ≤  M ∧ ∃d:ℕ,∀(R:Run G),G.Simple →
    WilsonPointChildFiledTest.Filed R → WilsonPointChildDigitHierarchy.Filed R →
    WilsonReceivedCloseFundedHeat.Quiet R →
    ∀cash:ℕ → Gear G → ℝ,FundedMarkedCoverRows.prices cash R.kit →
    (∀ᶠj:ℕ in atTop,∀J,fare J   ≤   cash (R.family.path.levels.clock.J (j+1)) J) →
    ∀(u:ι → G.ColorIndex)(depth:∀s,k s<D s)(_o:Loc G 1),
    ∀_tags:∀j n,(Flat.primary (R.family.path.levels.clock.op j 0).patch R.family.path.levels.clock.kernel n).Choices,
    ∀η:ℝ,0<η → ∀ᶠm:ℕ in atTop,∀N per,m<N →
    ∀digit:ι → ∀i,Site (R.family.S.block i),∀v:∀s,Letter (R.family.labels.level (k s)),∀y:ι → Cover,∀z:ι → Site (loose R.family.path.levels m).L,
    let A:=R.family.path.levels
    let O:=R.metals.O
    let n:=R.family.side m per
    let K:=WilsonPointChildCenteredPortfolio.bank R u depth digit N (m+1) v (chartIn (loose A m) y z)
    let a:=WilsonPointChildCenteredIncome.share R (m+1) η D
    let A₀:=(A.clock.hatBeta (m+1))^η*WilsonPointChildCenteredPortfolio.cap D
    ∀I:Finset ι,I.Nonempty → 4*crestCard y I<n.val → ∀e ≤ E,∀r ≤ H,∀x,
    let B:=(logO A O m N K k I)
    let P:=Carp.plume (B.2 e r) n x
    ‖P‖ ≤ 2*M*weights a I+(1+(zz A m)^d)*A₀^I.card ∧
    ‖B.1 n e r x-P‖ ≤ (M*weights a I+A₀^I.card)*rate A m per:=by
  let Addr:={J:Finset ι // J.Nonempty} × Fin (E+1) × Fin (H+1)
  have hs (w:Addr):=WilsonPointChildCenteredFirstJoin.original G D k w.1.val w.1.property E w.2.1.val w.2.2.val (Nat.le_of_lt_succ w.2.1.isLt)
  choose bill M pos d proved using hs
  let fare(J:Gear G):=∑w:Addr,|bill w J|
  let M₀:=∑w:Addr,M w
  let D₀:=Finset.univ.sup d
  refine ⟨fare,M₀,Finset.sum_nonneg (fun w _=>pos w),D₀,?_⟩
  intro R simple booked enrolled quiet cash buy salary u depth o tags η eta
  let L:=R.family.path.levels
  have earns(w:Addr):∀ᶠj:ℕ in atTop,∀J,bill w J ≤ cash (L.clock.J (j+1)) J:=by
    filter_upwards [salary] with j cap J
    exact (le_abs_self _).trans ((Finset.single_le_sum (f:=fun t=>|bill t J|) (fun t _=>abs_nonneg _) (Finset.mem_univ w)).trans (cap J))
  have appointments(w:Addr):=proved w R simple booked enrolled quiet cash buy (earns w) u depth o tags η eta
  filter_upwards [eventually_all.mpr appointments,WilsonVacuumPreResetFiniteHeatScale.clock L simple,
    Filter.eventually_atTop.2 ((Filter.eventually_atTop.1 ((WardBin.bell L simple).eventually_ge_atTop 1)).imp (fun t h j hj=>h (j+1) (by omega)))] with m heard clock hot
  intro N per live digit v y z A O n K a A₀ I active room e he r hr x B P
  let w:Addr:=(⟨I,active⟩,⟨e,Nat.lt_succ_of_le he⟩,⟨r,Nat.lt_succ_of_le hr⟩)
  have vote:=heard w N per live digit v y z
  have budget:=vote.2.2 room x
  have billM: M w ≤ M₀:=Finset.single_le_sum (fun i _=>pos i) (Finset.mem_univ w)
  have order: d w ≤ D₀:=Finset.le_sup (f:=d) (Finset.mem_univ w)
  have thermal:0 ≤ L.clock.hatBeta (m+1)^η:=Real.rpow_nonneg (zero_le_one.trans hot) _
  have fee₀:0 ≤ weights a I:=Finset.prod_nonneg fun t _=>by
    change 0 ≤ 1+L.clock.hatBeta (m+1)^η*WilsonPointChildCenteredFunctional.factor D t+WilsonPointChildCenteredIncome.slack D t
    exact add_nonneg (add_nonneg zero_le_one (mul_nonneg thermal (WilsonPointChildCenteredFunctional.factor_nonneg _ _))) (WilsonPointChildCenteredIncome.slack_nonneg _ _)
  have Apos:0 ≤ A₀:=mul_nonneg thermal (WilsonPointChildCenteredPortfolio.cap_nonneg D)
  have A₁:0 ≤ A₀^I.card:=pow_nonneg Apos _
  have z0:0<zz L m:=zero_lt_one.trans_le clock.1
  have τ₀:0 ≤ rate A m per:=(Real.exp_pos _).le
  have τ₁:rate A m per ≤ 1:=Real.exp_le_one_iff.mpr (div_nonpos_of_nonpos_of_nonneg (by exact neg_nonpos.mpr (Nat.cast_nonneg _)) (by positivity))
  have bb:=pow_le_pow_right₀ clock.1 order
  have ward:Real.exp (-(1/zz L m)*(Syn (tor n) (wrap n ∘ y) I x)) ≤ 1:=Real.exp_le_one_iff.mpr (mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr (one_div_nonneg.mpr z0.le)) (Nat.cast_nonneg _))
  have mb:=mul_le_mul_of_nonneg_right billM fee₀
  have gap:‖B.1 n e r x-P‖ ≤ (M₀*weights a I+A₀^I.card)*rate A m per:=
    budget.trans (mul_le_mul_of_nonneg_right (add_le_add mb le_rfl) τ₀)
  have raw:‖B.1 n e r x‖ ≤ M₀*weights a I+(zz L m)^D₀*A₀^I.card:=by
    refine (vote.1 x).trans (add_le_add ?_ ?_)
    · exact (mul_le_of_le_one_right (mul_nonneg (pos w) fee₀) τ₁).trans mb
    · exact (mul_le_of_le_one_right (mul_nonneg (pow_nonneg z0.le _) A₁) ward).trans (mul_le_mul_of_nonneg_right bb A₁)
  have small:=gap.trans (mul_le_of_le_one_right (add_nonneg (mul_nonneg (Finset.sum_nonneg (fun i _=>pos i)) fee₀) A₁) τ₁)
  refine ⟨?_,gap⟩
  calc
    ‖P‖=‖B.1 n e r x-(B.1 n e r x-P)‖:=by rw [sub_sub_cancel]
    _ ≤ ‖B.1 n e r x‖+‖B.1 n e r x-P‖:=norm_sub_le .. 
    _ ≤ (M₀*weights a I+(zz L m)^D₀*A₀^I.card)+(M₀*weights a I+A₀^I.card):=add_le_add raw small
    _= _:=by ring

end YM.Integration.WilsonPointChildCenteredFaces
