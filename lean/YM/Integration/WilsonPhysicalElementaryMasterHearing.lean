    ∃A:Axes (R:=R) d→Fin n→ℝ,∃E:Axes (R:=R) d→Fin n→ℕ,(∀a i,1≤A a i) ∧ ∀p:ℕ,∀ᶠr in trail,
    ∀ρ:Fin n→{s:ℝ //0<s ∧ s<δ},(∀i,r≤(ρ i).val ∧ (ρ i).val≤outer arch h r)→(∃i,(ρ i).val=r)→
    let f:=reporter F books ρ
    ∀{t u ear K :ℕ}{e E₀:Roster (R:=R) d→ℕ}{tuition:ℝ}{power target:ℕ}
      {wid lo teach}(L:Package R.family wid lo teach)(stop:Stop (C₀) 0 ear u)(window q:ℕ)
      (M:Roster (R:=R) d→ℝ)(one:∀i,1≤M i)(enough:∀a,(∑i:↥(Stock.final (Fin n)).val,E a i.val)+2*p≤q),
      School F D T t (fun w:Roster (R:=R) d=>d w.1) e books (master F J Z d x books) M E₀
        tuition power target (fun w=>ρ w.1) (reporter F books (fun w:Roster (R:=R) d=>ρ w.1)) K →
    ∃gate:ℕ,∃up:f<K,∀(a:Axes (R:=R) d) N per,∀_live:K<N,∀b:Fin n→Bool,
      let grade:=fun i=>(d i).val
      let Y:=fun i=>source F J Z (d i) (books (ρ i)) (x i) (b i) (selected (a i) (b i)) N per
      ∀old:Filed R grade K,
      old.station=(fun i=>WilsonReflectedPublicStationFare.station F ((books (ρ i)).rows (d i)) (b i)) →
      ∀desired requested,2*p≤desired → (∀i,accuracy grade requested i≤e (choice d a i)) →
        desired+∑i,E₀ (choice d a i)≤requested →
      ∀base j apron reserve first,ReadAt R grade base N per apron requested t reserve power (capital R D tuition) first →
      first≤j → base≤j → ∀height:j+2≤f,K=WilsonInvariantActionPosition.berth R reserve f →
      (∀i,first≤old.station i) → base≤u → ∀past:u≤j,Opened (C₀) 0 u per → Opened (C₀) 0 j per →
      ∀c:ℕ,gate≤c → u+2≤c → c+2≤f → (C₀).S.a c/(C₀).S.a f≤(β f)^window →
      ∀o:Fin n→ Cover,(∀i,8*‖(C₀).S.gridPoint f (o i)‖≤(C₀).S.a (c+1)) →
      (Pairwise fun i k=>2*(C₀).S.a f*(((C₀).path.levels.budget f).B:ℝ)^2≤
        ‖(C₀).S.gridPoint f (o i)-(C₀).S.gridPoint f (o k)‖) →
      let loc:=fun i=>wrap ((C₀).side f per) (o i)
      ∀turn:Fin n→Motion,Ground R N per j f apron loc →
      let road:u≤K:=(past.trans (by omega:j≤f)).trans up.le
      let Q:=submitted R grade (N:=N) old up.le Y turn loc (Stock.final (Fin n))
      let raw:=physical R grade (N:=N) Y turn loc (Stock.final (Fin n))
      ‖actualTransport (C₀) (N:=N) Q road 1-(C₀).omega N per raw‖≤
        ((∏i:↥(Stock.final (Fin n)).val,A a i.val)+
          (∏i,ceiling (R:=R) (d i).val (M (choice d a i))))*(wilson arch r)^p:=by
  classical
  obtain ⟨A,E,ones,allP⟩:=WilsonPhysicalElementaryPaidHearing.original F J Z d x books simple bliss slow lead obeys h paid
  refine ⟨A,E,ones,fun p=>?_⟩
  filter_upwards [allP p] with r tariff
  intro ρ span left f t u ear K e E₀ tuition power target wid lo teach L stop win q M hM enough campus
  choose gate up electrode receipt using fun a:Axes (R:=R) d=>tariff ρ span left a L stop win q
    (fun i=>M (choice d a i)) (fun i=>hM (choice d a i)) (enough a)
    (WilsonPhysicalElementaryMasterCampus.original F J Z d x books campus a)
  refine ⟨∑a,gate a,up (fun _=>0),?_⟩
  intro a N per live b grade Y old st desired requested restored acc quota base j apron reserve first read firstJ baseJ
    lower berth stations before past openU openJ c floor cu cf ratio o home apart loc turn ground road Q raw
  let fil:=WilsonMeasuredPublicEntranceCutoffFile.complete R grade old (fun p i=>electrode a p i (b i))
  have cap:gate a≤c:=(Finset.single_le_sum (f:=gate) (fun _ _=>Nat.zero_le _) (Finset.mem_univ a)).trans floor
  have got:=receipt a N per live.le b old st desired requested restored acc quota base j apron reserve first read
    firstJ baseJ lower berth stations before past openU openJ c cap cu cf ratio o home apart turn ground
  have names:(fun i=>(((books (ρ i)).rows (d i)).arm (b i) (heads F J Z d x books a i (ρ i) false (b i))).source (N,per))=Y:=
    funext fun i=>WilsonPhysicalElementaryPaidHearing.named F J Z d x books a i (ρ i) (b i) N per
  have axes:= (WilsonMeasuredPublicEntranceCutoffFile.live R grade old (fun p i=>electrode a p i (b i)) live per).1
  change ‖actualTransport (C₀) (N:=N) (submitted R grade (N:=N) fil _ _ turn loc (Stock.final (Fin n))) road 1-
    (C₀).omega N per (physical R grade (N:=N) _ turn loc (Stock.final (Fin n)))‖≤_ at got
  rw [names] at got
  have swap:submitted R grade (N:=N) fil (up a).le Y turn loc (Stock.final (Fin n))=Q:=by
    unfold submitted Q
    unfold submitted
    change fil.A N per=old.A N per at axes
    rw [axes]
    rfl
  rw [swap] at got
  exact got

