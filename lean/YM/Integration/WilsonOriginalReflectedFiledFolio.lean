variable {G:Gauge}(R:Run G)(d D:Fin 2 → ℕ)(pt:Fin 2 → Chamber)(φ:Test 2)(r:ℝ)
  {K N per u f c v requested tag top:ℕ}(uk:u ≤ K)(fK:f ≤ K)(kn:K ≤ N)
  (plan:Plan 2)(file:Filed R d K)
  (panel:cells R φ r (f,per) → Panel R d N per f K fK kn requested plan.pole tag plan.tuition)
  {X:Realm G (top+1) Credit.leanC}(draw:X.draws=R.family.path.levels)
def mode(s:Finset (Fin 2)):(Stock.census (Fin 2)).Mode:=⟨s,Finset.mem_univ _⟩
def input(y:cells R φ r (f,per))(s:Finset (Fin 2)):ℂ:=
  WilsonReceivedChronologicalFixedRoseTestSource.fixed R kn uk
    (WilsonMeasuredPublicEntranceCellWords.physical R d (panel y).names (panel y).turn y.val (mode s) (N:=N))
def independent (first Q:ℕ)(y:cells R φ r (f,per))(s:Finset (Fin 2)):ℂ:=
  WilsonOlderFreshSoftSocketTotal.normalized R d (fun i=>contact (D i)) pt N per K c v
    (path (R:=R) draw fK y.val) s (votes R d (N:=N) (per:=per) file (panel y).names (panel y).turn)
    (location (R:=R) draw fK y.val c first) (touch (present D) s) Q
    (Pert.Asymptotics.regulatorRun R.family N per v)
def Posted(first Q:ℕ):Prop:=
  ∃basal firstStep:cells R φ r (f,per) → Finset (Fin 2) → ℂ,∀(y:cells R φ r (f,per))(s:Finset (Fin 2)),
    (written R d plan (panel y) file v c s (input R d φ r uk fK kn plan panel y s)
      (independent R d D pt φ r (c:=c) (v:=v) fK kn plan file panel draw first Q y s)
      (basal y s) (firstStep y s)).Paid ∧
    ‖basal y s‖ ≤ WilsonReceivedChronologicalFixedRoseFittedDebit.low R d plan K N per v s ∧
    ‖firstStep y s‖ ≤ WilsonReceivedChronologicalFixedRoseFittedDebit.high R d plan K N per v s
