variable (x:Fin n→ℂ)(t:Case H.tests)
local notation "bank" => fixed R k κ pt N b i cells seed
local notation "caseAt" => (fun S f=>wallet x S (unitSeries t S f))

def cash (z:I)(h:Fin (e+1)):ℂ:=(∏a∈(Sof z),x a)*(occupied H z h:ℂ)
def reading (g:ℂ)(p:ℕ)(S:Finset (Fin n)):ℂ:=
  ∑a∈range (p+1),g^a*PowerSeries.coeff a ((caseAt) S (levelsO ((bank) y) S))

private theorem sameToe (S:Finset (Fin n)){a a':Fin n}{r r':Cover}{f:Frill S a}{f':Frill S a'}
    (point:a=a')(stem:r=r')(word:HEq f f'):toe S a r f=toe S a' r' f':=by
  subst a'; subst r'; cases eq_of_heq word; rfl

include H in
theorem invoice (simple:G.Simple)(ib:i≤b)(high:b≤N)
    (named:∀w S,output H.prior S N w=(bank) w S)
    (test:∀z,H.source z=t)(pins:H.pin=pin)(roots:H.root=root y)
    (frills:∀z,HEq (H.frill z) (frill y z))(z:I)(h:Fin (e+1)):
    cash H x z h=PowerSeries.coeff h.val ((caseAt) (Sof z) ((bank) y (Sof z))):=by
  rw [WilsonOriginalTwoFlatIRFlatFinanced.coeff,WilsonOriginalTwoFlatIRFlatSeries.value]
  unfold cash occupied
  rw [test z,named,sameToe (Sof z) (congrFun pins z) (congrFun roots z) (frills z)]
  obtain ⟨_,_,hire⟩:=WilsonReceivedCanonicalVerseRegister.original R k κ pt e (s:=1) zero_lt_one
  have healthy:=WilsonReceivedFixedDigitHistory.sound R.family.path.levels R.metals.O k N cells simple R.alloy.B.ratio
    (start R k κ pt seed) (hire seed).1 (b-i) i (by omega)
  have loyal:=WilsonOriginalCensusFaceSites.inherited y (bank) healthy z (Sof z) (by rfl)
  exact congrArg (fun Z:Era G (Pen H.tests (Sof z))=>
    (∏a∈(Sof z),x a)*Complex.ofReal (touch t (Sof z) (Z.2 h.val 0 Fin.elim0))) loyal

include H in
theorem original (simple:G.Simple)(ib:i≤b)(high:b≤N)
    (named:∀w S,output H.prior S N w=(bank) w S)
    (test:∀z,H.source z=t)(pins:H.pin=pin)(roots:H.root=root y)
    (frills:∀z,HEq (H.frill z) (frill y z))(g:ℂ)(p:ℕ)(order:p≤e)(S:Finset (Fin n)):
    (crop (fun z:I=>((modes) z).mode) (cash H x) g p).part (seat S)=
      reading H κ pt b cells seed x t g p S:=by
  let source:I→PowerSeries ℂ:=fun z=>(caseAt) (Sof z) ((bank) y (Sof z))
  have low:=WilsonOriginalTwoFlatIRFlatCutAgreement.original (fun z:I=>((modes) z).mode) (cash H x) p order source
    (fun z h _=>invoice H κ pt b cells seed x t simple ib high named test pins roots frills z h) (seat S)
  obtain ⟨_,_,hire⟩:=WilsonReceivedCanonicalVerseRegister.original R k κ pt e (s:=1) zero_lt_one
  have healthy:=WilsonReceivedFixedDigitHistory.sound R.family.path.levels R.metals.O k N cells simple R.alloy.B.ratio
    (start R k κ pt seed) (hire seed).1 (b-i) i (by omega)
  have issued:((ordinary (fun z:I=>((modes) z).mode) source).part (seat S))=(caseAt) S (levelsO ((bank) y) S):=
    (congrFun (WilsonOriginalTwoFlatIRFlatFinanced.original x t ((bank) y) (healthy.quiet' y)) S).symm
  rw [WilsonOriginalTwoFlatIRFlatPolynomial.original,reading]
  apply sum_congr rfl
  intro h hh
  rw [low h (Nat.le_of_lt_succ (mem_range.mp hh)),issued]

