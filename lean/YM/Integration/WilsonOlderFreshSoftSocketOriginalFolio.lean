/-- The stopped ordinary value in the original fiscal root and on the original submitted test. -/
def ear (R:Run G)(D:Fin 3→ℕ)(pt:Fin 3→Chamber)(Φ:Test 3)(r:ℝ)
    {f K c m q requested tag N per day top:ℕ}{opt tol:ℝ}
    (fk:f≤K)(kn:K≤N)(plan:Plan 3)(file:Filed R ages K)
    (Y:cells R Φ r (f,per)→Panel R ages N per f K fk kn requested plan.pole tag plan.tuition)
    {Vc:Realm G (top+1) Credit.leanC}(drawc:Vc.draws=R.family.path.levels)
    (w:ℕ)(office:Badge R D q (m+1) day opt tol)(y:cells R Φ r (f,per))(s:Faces):ℂ:=
  let visit:=path (R:=R) drawc fk y.val
  let pins:=location (R:=R) drawc fk y.val c m
  let test:=touch (fun i:s=>WilsonReceivedCanonicalSocketSeed.present D i.val) (univ:Finset s)
  let probe:=WilsonOriginalObservedRoseProbeRead.filed R D s (fun i=>WilsonReceivedCanonicalSocketSeed.contact (D i)) pt
    (fun j (i:s)=>visit j i.val) (fun i:s=>pins i.val) office.field office.draw test
  let control:=votes R ages (N:=N) (per:=per) file (Y y).names (Y y).turn
  (WilsonOriginalObservedRoseProbeRead.quota test:ℂ)*
    WilsonOlderFreshSoftRoseMarket.row (R:=R) D office.field s N K c w (m+1) probe
      (Pert.Asymptotics.regulatorRun R.family N per K)
      (fun i=>WilsonPositionProgramReportedField.entire R (ages i) K (N,per) (control i))
      q (Pert.Asymptotics.regulatorRun R.family N per (m+1)) true

def Settled (R:Run G)(l:Filter (ℕ×ℕ))(D:Fin 3→ℕ)(pt:Fin 3→Chamber)(Φ:Test 3)
    (dates:Fin 3→ℕ)(labels:∀i:Fin 3,ℕ×ℕ→R.family.label (ages i))(M:Fin 3→ℝ)
    (r γ:ℝ)(sensor:ℂ)(initial margin:ℝ){u f K:ℕ}(uf:u≤f)(fk:f≤K)(c m Q J₀ requested tag src apron:ℕ)
    (plan:Plan 3)(file:Filed R ages K){top day:ℕ}{opt tol:ℝ}{Vc:Realm G (top+1) Credit.leanC}
    (drawc:Vc.draws=R.family.path.levels)(w:ℕ)(office:Badge R D Q (m+1) day opt tol):Prop:=
  ∀ᶠpair:ℕ×ℕ in l,∃(kn:K≤pair.1)(Y:cells R Φ r (f,pair.2)→
      Panel R ages pair.1 pair.2 f K fk kn requested plan.pole tag plan.tuition),
    Named R dates labels M fk plan file Φ r pair.1 pair.2 kn Y ∧
    Located R Φ r fk src apron pair.1 pair.2 kn Y ∧
    Posted R ages D pt Φ r (K:=K) (N:=pair.1) (per:=pair.2) (c:=c) (v:=m+1)
      (uf.trans fk) fk kn plan file Y drawc m Q ∧
    ‖sensor-signed R Φ r (f,pair.2) (fun y=>value (independent R ages D pt Φ r (K:=K) (N:=pair.1)
      (per:=pair.2) (c:=c) (v:=m+1) fk kn plan file Y drawc m J₀ y))‖/γ ≤ initial ∧
    ‖sensor-signed R Φ r (f,pair.2) (fun y=>value (ear R D pt Φ r (c:=c) fk kn plan file Y drawc w office y))‖/γ ≤ margin

theorem original (R:Run G)(l:Filter (ℕ×ℕ))(D:Fin 3→ℕ)(pt:Fin 3→Chamber)(Φ:Test 3)
    (dates:Fin 3→ℕ)(labels:∀i:Fin 3,ℕ×ℕ→R.family.label (ages i))(M:Fin 3→ℝ)
    (r γ:ℝ)(gp:0<γ)(sensor:ℂ)(margin fee:ℝ){u f K:ℕ}(uf:u≤f)(fk:f≤K)(c m Q J₀ requested tag src apron:ℕ)
    (plan:Plan 3)(file:Filed R ages K){top day:ℕ}{opt tol:ℝ}{Vc:Realm G (top+1) Credit.leanC}
    (drawc:Vc.draws=R.family.path.levels)(w:ℕ)(office:Badge R D Q (m+1) day opt tol)
    (sold:Closed R l D pt Φ dates labels M r γ sensor margin uf fk c m Q J₀ requested tag src apron plan file drawc)
    (paid:∀(N per:ℕ)(kn:K≤N)(Y:cells R Φ r (f,per)→Panel R ages N per f K fk kn requested plan.pole tag plan.tuition),
      Named R dates labels M fk plan file Φ r N per kn Y →
      ‖signed R Φ r (f,per) (fun y=>
        value (independent R ages D pt Φ r (K:=K) (N:=N) (per:=per) (c:=c) (v:=m+1) fk kn plan file Y drawc m J₀ y)-
        value (ear R D pt Φ r (c:=c) fk kn plan file Y drawc w office y))‖≤fee):
    Settled R l D pt Φ dates labels M r γ sensor margin (margin+fee/γ) uf fk c m Q J₀ requested tag src apron plan file drawc w office:=by
  filter_upwards [sold] with pair pledged
  obtain ⟨kn,Y,named,proper,posted,original⟩:=pledged
  refine ⟨kn,Y,named,proper,posted,original,?_⟩
  let current:=independent R ages D pt Φ r (K:=K) (N:=pair.1) (per:=pair.2) (c:=c) (v:=m+1) fk kn plan file Y drawc m J₀
  let last:=ear R D pt Φ r (c:=c) fk kn plan file Y drawc w office
  let total (t:cells R Φ r (f,pair.2)→Faces→ℂ):=signed R Φ r (f,pair.2) (fun y=>value (t y))
  have expense:‖total current-total last‖≤fee:=by
    simpa only [total,current,last,signed,mul_sub,Finset.sum_sub_distrib] using paid pair.1 pair.2 kn Y named
  exact (div_le_div_of_nonneg_right (norm_sub_le_norm_sub_add_norm_sub sensor (total current) (total last)) gp.le).trans
    ((add_div ..).le.trans (add_le_add original (div_le_div_of_nonneg_right expense gp.le)))

