def Read (P:upper)(F:lower)(r:ℕ):Prop:=
  ∀(t:Wallet A)(grid:Side)(tiles:(R.family.side j per).val ∣ grid.val)(d:ℕ), d≤r →
    ∀u:Stationary.Link G grid,
    WilsonOriginalCopiedHistory.block R nextCut r
      (WilsonOriginalCopiedHistory.receive
        (WilsonOriginalSoldNestedPupil.prior R L a dmax depth digit live owner columns films charge per sites A t r)
        (π (j+1)) tape₀ grades (Γ (j+1)) (Oak.grade0 R hk D Q₀ π Γ (hi) P.lesson) depth₀ r)
      grid tiles d u =
    peek tiles (Oak.student (n:=per) R hk D Q₀ π Γ books floor F.op F.lesson ahead A F.model (S).order F.voter)
      grades (π (j+1)) tape₀ t d u

def Traced (τ ε:ℝ):Prop:=
  WilsonOriginalThreeAgeDated.Appeared R D Q₀ L a dmax depth digit T hk π Γ Ψ books ahead floor live op lesson
    owner sites columns films A charge τ ε ∧
  ∀(P:upper),P.passport=Passport.point sites → P.modelIndex=WilsonOriginalPointCompactRoster.Index owner grades (T₀) →
    HEq P.model (roster) → ∀(F:lower),
    Filed R hk D Q₀ π Γ Ψ books ahead A (blank) grades (S).order (S).horizon op.count floor (source) P F →
    ∀r:ℕ, r≤Q → r≤(S).order →
      Read R D Q₀ L a dmax depth digit T hk π Γ Ψ books ahead floor live op owner sites columns films A charge P F r

theorem original (simple:G.Simple)(v:ℕ→Gear G→ℝ)(before:FundedMarkedCoverRows.prices v R.kit)
    (vac:FundedOriginalVacuumPaths.prices R.kit)
    (opened:WilsonOriginalPrimerPostCover.opening R simple v before vac (K) ≤ m)
    (sold:WilsonOlderFreshThermometerSources.Sold R L a dmax depth (σ₀) digit T)
    (bounded:∀v x,x∈A v→‖x‖≤1)
    (path:PlanV.Path D R.alloy Q₀ (Burn.horizon (K)) N m π Γ)(pass:Pass D Q₀ R.alloy R.kit)
    (course:Concourse R.alloy R.kit R.T π Γ m N per (K) Ψ)(month:Scholar.Month R.rolls D Q₀ R.alloy.delay)
    {τ ε:ℝ}(issue:WilsonOriginalThreeAgeDated.Appeared R D Q₀ L a dmax depth digit T hk π Γ Ψ books ahead
      floor live op lesson owner sites columns films A charge τ ε):
    Traced R D Q₀ L a dmax depth digit T hk π Γ Ψ books ahead floor live op lesson owner sites columns films A charge τ ε:=by
  refine ⟨issue,?_⟩
  intro P site keys same F file r limit small t grid tiles d dkeep u
  have fits:(S).order≤Burn.horizon (K)+1:=by
    dsimp [WilsonOlderFreshThermometerRoom.semester,WilsonOlderFreshThermometerRoom.horizon,Burn.horizon];omega
  have narrow:(S).horizon ≤ R.alloy.B.a.clock.J (j+1):=(Nat.le_add_left ..).trans ((S).tall.trans (hk.trans (R.alloy.B.a.fits.mono (hi))))
  exact WilsonOriginalSoldNestedPupil.original R L a dmax depth (σ₀) digit T (hi) live owner columns films charge per
    sites A t hk D Q₀ π Γ Ψ course books ahead (blank) (S).order (S).horizon op.count (source) P floor F file
    sold (Poetry.Agenda.stem D φ _ _) bounded simple v before vac opened path pass site keys same month fits narrow
    r limit (small.trans (fits.trans (Nat.le_succ _))) small grid tiles d dkeep u

