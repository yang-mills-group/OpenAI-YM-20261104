theorem same {G : Gauge} {V ι α : Type} [DecidableEq V] [Fintype V] {n f : Side}
    {J : Earn.Passport n V} {r : Census V} (h : n.val∣f.val) (M : ι→Row J r G α) (wts : V→ℕ)
    (L L' : Layout G) (T : Finset Age) (test : α) (d : ℕ) (y : Stationary.Link G f)
    {a : ℝ} {k : ℕ} (staff : Air.Staff M (fun u=>(M u).paint test) wts a k) :
    peek h M wts L T test d y = peek h M wts L' T test d y := by
  exact (total_peek h M wts L T test y d staff).unique (total_peek h M wts L' T test y d staff)

