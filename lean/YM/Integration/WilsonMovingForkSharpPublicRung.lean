def roof {s:ℕ}(price:Fin s  →  ℝ):ℝ:=∑i,|price i|

theorem original (run:Run G)(W:Initialize G)(p:4<D)(pF:4<D')(u e:ℕ)(v:Rails 4 8 (u+16) e)
    (height4:4 ≤ height)(nearData:D ≤ seats)(farData:D' ≤ seats)(sensors:u+16 ≤ seats):
    let H':=hol G
    let M:=publicFrame run
    let Q:=BayV M 4 D' pF
    M.T 4=sectionAt run W false 4 ∧
    ∃capture C₀ C₁ C₂ ledger pay thermal:Credit,∀(chart:ChartRatio G)(kernel:KernelChoices)(V:XSpace.Run)
    (menu:WilsonIndependentEvenPassport.Menu M chart kernel V e height seats j extra)
    (_grant:WilsonIndependentCutJoinPlate.Approved M chart kernel V e height seats j extra menu)
    (phase:4 ≤ j)(κ:ℝ),∀ᶠ z:ℕ in atTop,∀(i:Requests menu.a),i.val=z  → 
      let wall:=WilsonIndependentExactPlate.M V menu.a i
      let cir:=WilsonIndependentExactPlate.S V menu.a menu.positive j phase
      ∃(A:Levels G)(base:ℕ),A.clock.kernel=kernel ∧
        (∀f:Flap (WilsonIndependentExactPlate.M V menu.a),f.volW=i  →  ∀per:ℕ,
          (A.clock.op (base+(wall-(f.offset+1))) per).patch=cir.pactP f) ∧
        ∃(book:ChorusLine H' (M.T 4) p e C C C)(torch:Torch H' (M.T 4) p v C C C),
          torch.L=book.arch ∧ book.arch.V.draws=A ∧ book.arch.V.paid=chart ∧ book.arch.V.anchor=base ∧
          Elected M book.arch.V height seats ∧
          let N:=base+wall
          let m:=base+old V menu.a i.val
          ∀L:ℝ,1 ≤ L  →  L ≤ (V.step i.val).spacing^(-κ)  → 
          ∃t,base ≤ t ∧ t ≤ m ∧ 1 ≤ L/(A.S.a t/A.S.a m) ∧ L/(A.S.a t/A.S.a m) ≤ (V.ratio:ℝ)^(2*menu.a) ∧
          ∀(α:Wilt (inner M p))(X:Herit (inner M p))(B:Fin 2 → ℝ)(nearGap:ℝ),0<nearGap  → 
            (∀s w,s≠w  →  ClearDay (α s) (α w) nearGap)  →  (∀s,Amplitude (α s) (B s))  → 
            let Z:=fence (inner M p) α (roof menu.price) nearGap
            let inputs:=AutumnDay A chart α X m m N D
            let x:=Reports A chart (M.T 4) p α X m m t N 8
            ∃Y:CutsP H' (M.T 4) p v C C C C,Y.L=torch ∧ Y.L'=book ∧ Y.vesselsC=book.arch.V ∧
              Y.N=N ∧ Y.m=t ∧ Y.ceilC=m ∧ Y.pt=inputs ∧
              Y.fuel=max 0 (capture.buy Z*∏s,B s*fee ((inner M p) s) e (X s)) ∧
              Y.springP Y.i=inputs-Shrine Y.Ntop Y.tileP ∧
              WilsonMovingForkSharpRetainedBook.Booked Y m (inner M p) α X Q C₀ C₁ C₂ ledger pay thermal 0 x ∧
              ∀(φ:Rarity D)(ψ χ:Rarity D')(hφ:ContDiff ℝ ∞ φ.ψ.val)(hψ:ContDiff ℝ ∞ ψ.ψ.val)(hχ:ContDiff ℝ ∞ χ.ψ.val),
                (∀p q:Point4,φ.ψ.val p*ψ.ψ.val (q-p)=φ.ψ.val p*(χ.ψ.val q*ψ.ψ.val (q-p)))  → 
                WilsonMovingForkSharpPhysicalRuler.Quoted Y m (inner M p) α X Q C₀ C₁ C₂ ledger pay thermal 0 φ ψ χ
                  (WilsonSeparatedPrefixMovingJointSpectrum.transformed ψ hψ) x (salary φ χ hφ hχ) L ((V.ratio:ℝ)^(2*menu.a)):=by
  classical
  intro H' M Q
  obtain ⟨capture,C₀,C₁,C₂,ledger,pay,thermal,sale⟩:=WilsonMovingForkSharpOpticalFaculty.original M p pF u e v height4 nearData farData sensors
  refine ⟨rfl,capture,C₀,C₁,C₂,ledger,pay,thermal,?_⟩
  intro chart kernel V menu grant phase κ
  filter_upwards [WilsonIndependentFittedExteriorRoom.original (G:=G) V menu.a j menu.positive phase κ] with z earned i zi
  intro wall cir
  obtain ⟨A,base,ker,_leading,periods,_scale,book,torch,joined,draw,quiet,started,_faculty,price,court,desk⟩:=
    sale chart kernel V menu grant phase i
  refine ⟨A,base,ker,periods,book,torch,joined,draw,quiet,started,court,?_⟩
  intro N m L near fine
  obtain ⟨t,lo,hi,inside,rung⟩:=earned i zi A base (fun f hf=>periods f hf 0) L near fine
  refine ⟨t,lo,hi,inside,rung,?_⟩
  intro α X B nearGap pos clear arms Z inputs x
  have idx:old V menu.a i.val ≤ wall:=by change old V menu.a i.val ≤ WilsonIndependentEvenPassport.count V menu.a i.val;unfold WilsonIndependentEvenPassport.count;omega
  have costs:book.arch.V.y m ≤ roof menu.price:=by
    rw [show m=base+old V menu.a i.val from rfl,price _ idx]
    unfold roof
    exact (le_abs_self _).trans (Finset.single_le_sum (f:=fun j:Fin menu.a=>|menu.price j|) (fun _ _=>abs_nonneg _) (Finset.mem_univ _))
  obtain ⟨shape,seatsNear⟩:=WilsonMovingForkSharpNearRoom.original book.arch.V m (inner M p) α B (roof menu.price) nearGap costs pos clear arms
  have back:t+(m-t)=m:=Nat.add_sub_of_le hi
  have next:=desk t (m-t) lo back.le α X B Z
  rw [back] at next
  have reserve:Bough (inner M p) α (paceT A.S m m) Z B:=draw ▸ seatsNear
  obtain ⟨Y,hl,hv,realm,top,beginning,span,actual,income,_,stable,_,paid⟩:=next shape reserve
  have home:Y.ceilC=m:=by change Y.m+Y.i=m;rw [beginning,span,back]
  refine ⟨Y,hl,hv,realm,top,beginning,home,actual,income,?_,paid,?_⟩
  · rw [span];exact stable
  · intro φ ψ χ hφ hψ hχ collar
    have funding: L/paceT Y.ax.S m Y.m ≤ (V.ratio:ℝ)^(2*menu.a):=by
      change L/(Y.vesselsC.draws.S.a Y.m/Y.vesselsC.draws.S.a m) ≤ _
      rw [realm,draw,beginning];exact rung
    exact WilsonMovingForkSharpPhysicalRuler.original Y m (inner M p) α X Q C₀ C₁ C₂ ledger pay thermal 0
      φ ψ χ _ x _ L _ (zero_lt_one.trans_le near) funding (paid φ ψ χ hφ hψ hχ collar).2.2.2

end YM.Integration.WilsonMovingForkSharpPublicRung
