import YM.Integration.WilsonMeasuredPublicEntranceOwnerWallet

/-! The actual singleton's entire forced account times a genuine finite
paid gallery, integrated at the two elected Wilson flats. -/
set_option autoImplicit false
noncomputable section
namespace YM.Integration.WilsonMeasuredPublicEntranceOwnerOptical
open Function Finset Filter Lattice Wilson RG Tree Marker Multi QuadraticLocal Ac MeasureTheory
open Org AllOrder AllOrder.Floe AllOrder.Floe.Step AllOrder.Floe.Step.PlanV AllOrder.Transit
open WheelP AnalyticBridge VerifiedReset PhysicalNext PhysicalNext.Repeat Legato
open Pressure ConnectedActivityE6 Push.AbsoluteSums MergeProof.Accent QuadraticLocal.Advent
open WilsonOriginalOccupiedStencil WilsonOriginalOccupiedCorridor WilsonThermometerMixedCollarSubpower
open Source Labels WilsonOriginalAlternativeHearing WilsonMeasuredCoefficientTransport
open Pert.Asymptotics
open scoped Classical BigOperators
variable {G:Gauge} (R:Run G) (simple:G.Simple)
variable {V:Type} [DecidableEq V] [Fintype V] (marks:Marker.Census V)
local notation "H" j:max => R.family.path.levels.clock.hatBeta j
local notation "κ" j:max => LocalComparison.forcedDivisor R.family j

include simple in
theorem original (n d a p:ℕ) (np:0<n) (load:∀s:marks.Mode,s.val.card ≤ n)
    (C e:ℝ)(cp:0 ≤ C)(ep:0<e):
    ∃start:ℕ,∀ᶠ f:ℕ in atTop,∀ (N per m k b reserve:ℕ) (_top:f+1 ≤ N) (bt:b<f+1),start ≤ b →
    ((f+1-b+reserve:ℕ):ℝ) ≤ C*(1+Real.log (H (f+1)))^d →
    ∀(_way:WayStation R.kit)(D:Roots (G:=G) R.metals.p.profile R.metals.K R.metals.p.kernel)
    (Q:D.Tab R.rolls) (π:ℕ → Layout G) (Γ:ℕ → Pace.Coin) (Ψ:∀j,RG.Rep G (R.family.side j per)),
    Concourse R.alloy R.kit R.T π Γ m N per k Ψ → TicketP R.alloy R.kit D Q →
    ∀(X I:Type) [Countable I] [Nonempty X] (o:V → Site (R.family.side (f+1) per))
    (E:Lamps X I G (Ψ (f+1)).p o marks) (v:V) (degree:ℕ)
    (h:Coefficient (R.family.labels.level degree) (R.family.side (f+1) per)) {M C₀:ℝ},
    h.Format (o v) R.family.params (Ψ (f+1)) → h.remBound (o v) (Ψ (f+1)) (κ (f+1)) M →
    ∀w:V→ℝ,(∀a,0<w a) → E.Paid w (Ψ (f+1)).p.B (Ψ (f+1)).p.supportExponent C₀ →
    let wage:=QuadraticLocal.Stoop.radius w (WilsonMeasuredPublicEntranceOwnerWallet.divisor w v C₀ M)
    ∀(x:X)(s:marks.Mode)(u i:ℕ),(mu:m ≤ u) → (ui:u ≤ i) → (ib:i ≤ b) → WilsonSingleHardRadius.first R simple ≤ u →
    ∀(Z:Support (R.family.side b per))(center:Site (R.family.side b per)),center∈Z →
    (∀a∈s.val,sites R o bt.le a∈Z) →
    let fee:=Poly.toll (wallet R wage bt.le) s
    let roof:=(shards marks s).card+4*(fee+WilsonOriginalFlatOccupiedRate.bill (Ψ b).p Z 1 s.val.card)*
      R.alloy.B.a.clock.hatBeta b*(κ b)
    let gain:=(H (f+1))^a*(Real.exp (n*(reserve:ℝ)*(scale (H (f+1)))^3)*Poly.toll wage s)
    let value:=‖held R.family N per (fun U=>account h (Ψ (f+1)) U*WilsonMeasuredCompanionFace.peers E v s x U)
        (ib.trans bt.le) 1‖
    let budget:=(e*(regulatorRun R.family N per (f+1))^p)*roof
    gain*value ≤ budget ∧ (1 ≤ gain → value ≤ budget):=by
  obtain ⟨start,buy⟩ := WilsonMeasuredPublicEntranceOpticalReserve.original R simple marks n d a p np load C (e/2) cp (half_pos ep)
  obtain ⟨onset,room⟩ := eventually_atTop.mp (WilsonMeasuredOwnerReserve.room R simple)
  refine ⟨start,?_⟩
  filter_upwards [buy,eventually_ge_atTop onset] with f price wake N per m k b reserve top bt sb span way D Q π Γ Ψ course ticket X I count inhabited o E v degree h M C₀ fit remn w wp charge wage x s u i mu ui ib fixed Z center home houses
  let W:=Ψ (f+1)
  have sheet:=course.1.walk (f+1) (((mu.trans ui).trans ib).trans bt.le) top
  have same: (Ψ i).eval=(R.family.path.rep N per i).eval:=(course.1.walk i (mu.trans ui) (ib.trans (bt.le.trans top))).view
  have forms:=sheet.truep.valid.labels
  let rent:Hard.Rent W.activities.forced W.activities.K W.p W.p.supportExponent
      (R.family.path.levels.clock.forcedAllowance (f+1)):=Hard.rentValid forms.forced forms.boundK
  let quiet:Hard X W.p W.activities.forced W.activities.K o marks:=Hard.rent rent
  let added:=WilsonOriginalDepositedHard.joined quiet v h fit (fun _:X=>1)
  let base:Gallery X I o W marks:=⟨E,quiet⟩
  let raised:Gallery X I o W marks:=⟨E,added⟩
  obtain ⟨pos,soft,loan,hard⟩ := WilsonMeasuredPublicEntranceOwnerWallet.original W o E v h fit remn rent
    w wp (room _ (wake.trans (Nat.le_succ f))) charge
  let test (A:Gallery X I o W marks) : ℂ := (((Ψ i).eval 1:ℂ)⁻¹)*
    ((gust R.family.path N per (f+1) (A.density x) i (ib.trans bt.le) 1).part s-
      (gust R.family.path N per (f+1) (fun U=>(W.eval U:ℂ) • Poly.pass (E.log x U)) i (ib.trans bt.le) 1).part s)
  let roof:ℝ:=(shards marks s).card+4*(Poly.toll (wallet R wage bt.le) s+
    WilsonOriginalFlatOccupiedRate.bill (Ψ b).p Z 1 s.val.card)*R.alloy.B.a.clock.hatBeta b*(κ b)
  let gain:ℝ:=(H (f+1))^a*(Real.exp (n*(reserve:ℝ)*(scale (H (f+1)))^3)*Poly.toll wage s)
  let g:=regulatorRun R.family N per (f+1)
  have up:gain*‖test raised‖≤((e/2)*g^p)*roof:=(price N per m k b reserve top bt sb span way D Q π Γ Ψ course ticket X I o raised wage pos soft hard x s u i mu ui ib fixed Z center home houses).1
  have down:gain*‖test base‖≤((e/2)*g^p)*roof:=(price N per m k b reserve top bt sb span way D Q π Γ Ψ course ticket X I o base wage pos soft loan x s u i mu ui ib fixed Z center home houses).1
  let actual:=held R.family N per (fun U=>account h W U*WilsonMeasuredCompanionFace.peers E v s x U) (ib.trans bt.le) 1
  have read:=WilsonMeasuredPublicEntranceOwnerReading.original R (N:=N) W o E v h fit remn rent sheet.truep.valid wage pos soft
    (R.family.localSection degree) x s (ib.trans bt.le)
  have both:actual=test raised-test base:=by
    unfold actual test
    rw [read,same]
    ring
  have gainpos:0≤gain:=mul_nonneg (pow_nonneg (zero_le_one.trans (R.family.path.levels.fits.delayed _).le) _)
    (mul_nonneg (Real.exp_nonneg _) (show 0≤Poly.toll wage s from Finset.prod_nonneg (fun i _=> (pos i).le)))
  have bound:gain*‖actual‖≤(e*g^p)*roof:=by
    rw [both]
    calc
      _≤gain*(‖test raised‖+‖test base‖):=mul_le_mul_of_nonneg_left (norm_sub_le ..) gainpos
      _≤_:=by rw [mul_add];linarith only [up,down]
  exact ⟨bound,fun one=>((le_mul_of_one_le_left (norm_nonneg _) one).trans bound)⟩

end YM.Integration.WilsonMeasuredPublicEntranceOwnerOptical
end
