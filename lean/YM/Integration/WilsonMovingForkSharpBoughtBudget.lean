theorem original (run:Run G)(W:Initialize G)(p:4<D)(pF:4<D')(u e:ℕ)(v:Rails 4 8 (u+16) e)
    (height4:4 ≤ height)(nearData:D ≤ seats)(farData:D' ≤ seats)(sensors:u+16 ≤ seats)(separated:31 ≤ seats):
    let M:=publicFrame run
    let Q:=BayV M 4 D' pF
    M.T 4=sectionAt run W false 4 ∧
    ∃capture C₀ C₁ C₂ first shape chron middle ledger pay thermal C₃ C₄ port folds:Credit,
      ∀(A:Levels G)(chart:ChartRatio G)(base:ℕ)(y:ℕ→ℝ),WilsonIndependentCutJoinPassport.All M A chart y e base height seats →
      ∃(choir:ChorusLine (hol G) (M.T 4) p e C C C)(torch:Torch (hol G) (M.T 4) p v C C C),
      torch.L=choir.arch ∧ torch.L.V.draws=A ∧ torch.L.V.paid=chart ∧ torch.L.V.anchor=base ∧ torch.L.V.y=y ∧
      (∀k₀ u₀:ℕ,∀v₀:Rails 4 k₀ u₀ e,k₀ ≤ seats → u₀ ≤ seats → ∃L:Torch (hol G) (M.T 4) p v₀ C C C,L.L=choir.arch) ∧
      Elected M torch.L.V height seats ∧ WilsonIndependentCutJoinNativeFrames.Funded M torch.L.V height seats ∧
      let R:=torch.L.V
      ∀(t m N:ℕ),base ≤ t → t ≤ m → m ≤ N →
      ∀(α:Wilt (inner M p))(X:Herit (inner M p))(B:Fin 2→ℝ)(Z:ℝ),
      PadRank R m m Z → Bough (inner M p) α (paceT A.S m m) Z B →
      ∀j:(s:Fin 2)→Alma ((inner M p) s).F,
      let x:=Reports A chart (M.T 4) p α X m m t N 8
      let genuine:=AutumnDay A chart α X m m N D
      ∃Y Y₀:CutsP (hol G) (M.T 4) p v C C C C,
        Y₀.L=torch ∧ Y₀.L'=choir ∧ Y₀.vesselsC=R ∧ Y₀.N=N ∧ Y₀.m=t ∧ Y₀.i=m-t ∧ Y₀.ceilC=m ∧
        Y₀.fuel=max 0 (capture.buy Z*∏s,B s) ∧
        Y₀.pt=AutumnDay A chart α (center (inner M p) j) m m N D ∧ Paid Y₀ Q C₀ C₁ C₂ ∧
        Y.fuel=charge (inner M p) X e*Y₀.fuel ∧
        Y.L=torch ∧ Y.L'=choir ∧ Y.vesselsC=R ∧ Y.N=N ∧ Y.m=t ∧ Y.i=m-t ∧ Y.ceilC=m ∧ Y.pt=genuine ∧
        Y.fuel=max 0 (capture.buy Z*∏i,B i*fee ((inner M p) i) e (X i)) ∧
        x=(paceT A.S m m)^4 • steep A chart (M.T 4) p N m (m-m) Y.tileP ∧
        Y.springP (m-t)=genuine-Shrine Y.Ntop Y.tileP ∧ Paid Y Q C₀ C₁ C₂ ∧
        ∀(Φ:Rarity D)(ψ χ:Rarity D')(hΦ:ContDiff ℝ ∞ Φ.ψ.val)(hψ:ContDiff ℝ ∞ ψ.ψ.val)(hχ:ContDiff ℝ ∞ χ.ψ.val),
        (∀s f:Point4,Φ.ψ.val s*ψ.ψ.val (f-s)=Φ.ψ.val s*(χ.ψ.val f*ψ.ψ.val (f-s))) →
          Tariff Y m (inner M p) α X Q C₀ C₁ C₂ first shape chron middle ledger pay thermal 5 0 x Φ ψ χ hΦ hψ hχ ∧
          WilsonMovingForkSharpReportedPortfolio.Approved Y m (inner M p) Q α X C₀ C₁ C₂ first shape chron middle ledger pay thermal
            C₃ C₄ port folds x Φ ψ χ hΦ hψ hχ ∧
          WilsonMovingForkSharpBilledRaw.Issued Y m (inner M p) Q α X C₀ C₁ C₂ first shape chron middle ledger pay thermal
            C₃ C₄ port folds Φ ψ χ hΦ hψ hχ:=by
  intro M Q
  obtain ⟨field,capture,C₀,C₁,C₂,first,shape,chron,middle,ledger,pay,thermal,C₃,C₄,port,folds,desk⟩:=
    WilsonMovingForkSharpRawHelper.original run W p pF u e v height4 nearData farData sensors separated
  refine ⟨field,capture,C₀,C₁,C₂,first,shape,chron,middle,ledger,pay,thermal,C₃,C₄,port,folds,?_⟩
  intro A chart base y grant
  obtain ⟨choir,torch,same,draws,coins,anchor,wages,faculty,house,hired,book⟩:=desk A chart base y grant
  refine ⟨choir,torch,same,draws,coins,anchor,wages,faculty,house,hired,?_⟩
  intro R t m N entry separation upper α X B Z gate fees j x genuine
  obtain ⟨Y,roL,roB,roR,hi,home,dated,born,truth,money,marked,stable,paid,ready⟩:=
    book t m N entry separation upper α X B Z gate fees
  obtain ⟨Y₀,roL₀,roB₀,roR₀,hi₀,home₀,dated₀,born₀,truth₀,money₀,_,_,paid₀,_⟩:=
    book t m N entry separation upper α (center (inner M p) j) B Z gate fees
  have bill:Y.fuel=charge (inner M p) X e*Y₀.fuel:=by
    rw [money,money₀]
    exact WilsonMovingForkSharpNearIncome.captured _ _ _ _ j _ _
  have units:Y₀.fuel=max 0 (capture.buy Z*∏s,B s):=by
    change Y₀.fuel=max 0 (capture.buy Z*∏s,B s*WilsonSeparatedPrefixMovingOwnDate.fee ((inner M p) s) e (center (inner M p) j s)) at money₀
    simpa only [center,WilsonMovingForkSharpExteriorIncome.axis_paid,mul_one] using money₀
  exact ⟨Y,Y₀,roL₀,roB₀,roR₀,hi₀,home₀,dated₀,born₀,units,truth₀,paid₀,bill,
    roL,roB,roR,hi,home,dated,born,truth,money,marked,stable,paid,ready⟩
end YM.Integration.WilsonMovingForkSharpBoughtBudget
