variable {G:Gauge}(R:Run G)(D:Roots (G:=G) R.metals.p.profile R.metals.K R.metals.p.kernel)(Q₀:D.Tab R.rolls)
    {φ:ℕ → ℕ}{V:Type}(queries:V  →  WilsonOlderFreshGraphAllStages.Query)(dmax:V  →  ℕ)
    (depth:∀v,(queries v).letter.toll<dmax v)(a:hue G){k:ℕ}(school:Syl.School k)
local notation "family" => (fun j:ℕ=>Flat.routes (R.family.path.levels.clock.op j 0).patch)
