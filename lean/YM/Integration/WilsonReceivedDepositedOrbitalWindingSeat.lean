local notation "pattern" => loose (levels R) i
local notation "forest" => repeatF (step R i per)
local notation "axes" => fun l:I=>(B l).mode.val
local notation "degrees" => fun l:I=>mass k ((B l).mode.val)
local notation "centers" => fun l:I=>(B l).center
local notation "paidProgram" => WilsonReceivedDepositedOrbitalFixedMoments.program (k:=k) old q (axes) root (fun _:I=>y) (fun _:I=>t)
local notation "touch₁" => fun l:I=>(touch t ((B l).mode.val)).smulRight WilsonReceivedDepositedOrbitalFixedMoments.point
local notation "reader₁" => @WilsonReceivedDepositedOrbitalFixedMoments.reading I

include well hs fund book inside hi tag in
theorem original (simple:G.Simple){grid:Side}(baseGeometry:n'.val=grid.val*(pattern).L.val)
    (project:grid.val∣(coarse R i per).val)(active:Finset I)(pg:active→Fin (Pages n' (ff)))(anchor:active)
    (d:ℕ)(kept:d≤q)(v:Stationary.Link G (coarse R i per)):
    let layout:=seats (pattern) (step R i per).sizes project h active (centers) pg anchor
    let digit:=fun l:I=>(Ratio.mk (pattern).L baseGeometry:Ratio grid n').residue ((B l).center)
    let site:=WilsonReceivedDepositedOrbitalFixedLabels.home active h (centers) pg
    read (coordinates G (coarse R i per)) (listed (k:=k) B old q root y t R N i per (forest) site active) d v=
      Complex.ofReal (diagonal (mass (degrees) active+d)
        (fun r z=>touch (reader₁) active ((spent R (degrees) N i q (coarse R i per) (paidProgram) layout digit active) d r z))
        ((coordinates G (coarse R i per)) v)):=by
  intro layout digit site
  let newSite:=chartIn (pattern) layout digit
  have saved:=WilsonNeutralTwoPrintPathInheritedBlocks.original (k:=k) old well hs fund book (axes) root inside
    (fun _:I=>y) (touch₁)
  have printed:Wellness (degrees) (submit (paidProgram) (degrees) q):=
    (WilsonReceivedCompactVerseEntrance.original (paidProgram) saved.2.1 hs saved.1 saved.2.2).2.1
  have profile:=WilsonReceivedDepositedOrbitalFilteredStep.original R N i per hi (forest) simple tag (q+1)
    ((paidProgram) site) ((submit (paidProgram) (degrees) q) newSite) (saved.2.1.level' _) (printed.level' _)
    (saved.2.1.quiet' _) (printed.quiet' _) (reader₁) active (fun s hs₁ d hd=>
      WilsonNeutralTwoPrintPathFineForest.original R N i per hi (forest) old well hs fund book (axes) root inside
        (fun _:I=>y) (touch₁) (pattern) baseGeometry (step R i per).sizes project h active (centers) pg anchor
        s hs₁ (reader₁) d (Nat.le_of_lt_succ hd))
  have plotted:=congrArg (fun u:POL (Woods G (coarse R i per))=>(MvPolynomial.eval ((coordinates G _) v) u:ℂ))
    (profile d (Nat.lt_succ_of_le kept))
  exact plotted.trans (WilsonOriginalCensusFinitePortrait.submitted R N i per hi (degrees) (reader₁) simple q (paidProgram)
    saved.2.1 hs saved.1 saved.2.2 layout digit active d v)

end YM.Integration.WilsonReceivedDepositedOrbitalWindingSeat
