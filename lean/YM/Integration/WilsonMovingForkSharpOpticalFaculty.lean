variable {a u e:ℕ}{v:Rails h k (u+a) e}
open WilsonSeparatedPrefixMovingTested44 (inner ranks)
open WilsonSeparatedPrefixMovingRelativeMaster (Landed)
open WilsonCoeffUV.Mer.Patrol (BayV)
open WilsonIndependentExactPlate (Requests)
open WilsonIndependentEvenPassport (old count)
open RegulatorIR RegulatorIR.Ledger
variable {D' j extra:ℕ}
open WilsonMovingForkSharpUniform (Earned)
open WilsonSeparatedPrefixMovingSpectralSalary (salary)
theorem original (M:Master H)(p:4<D)(pF:4<D')(u e:ℕ)(v:Rails 4 8 (u+16) e)
    (height4:4 ≤ height)(nearData:D ≤ seats)(farData:D' ≤ seats)(sensors:u+16 ≤ seats)
:
    let Q:=BayV M 4 D' pF
    ∃capture C₀ C₁ C₂ ledger pay thermal:Credit,∀(chart:ChartRatio G)(kernel:KernelChoices)(V:XSpace.Run)
      (menu:WilsonIndependentEvenPassport.Menu M chart kernel V e height seats j extra)
      (_grant:WilsonIndependentCutJoinPlate.Approved M chart kernel V e height seats j extra menu)
      (phase:4 ≤ j)(i:Requests menu.a),
      let wall:=WilsonIndependentExactPlate.M V menu.a i
      let cir:=WilsonIndependentExactPlate.S V menu.a menu.positive j phase
      ∃(A:Levels G)(base:ℕ),A.clock.kernel=kernel ∧
        (∀p:Page (WilsonIndependentExactPlate.M V menu.a),p.bindW=i→A.clock.J (base+(wall-p.downW))=cir.J p) ∧
        (∀f:Flap (WilsonIndependentExactPlate.M V menu.a),f.volW=i→∀per:ℕ,
          (A.clock.op (base+(wall-(f.offset+1))) per).patch=cir.pactP f) ∧
        (A.S.scale (base+wall)-A.S.scale (base+old V menu.a i.val)= -Real.log (V.step i.val).spacing) ∧
        ∃(book:ChorusLine H (M.T 4) p e C C C)(torch:Torch H (M.T 4) p v C C C),
          torch.L=book.arch ∧ book.arch.V.draws=A ∧ book.arch.V.paid=chart ∧ book.arch.V.anchor=base ∧
          (∀k₀ u₀:ℕ,∀v₀:Rails 4 k₀ u₀ e,k₀ ≤ seats → u₀ ≤ seats → ∃L:Torch H (M.T 4) p v₀ C C C,L.L=book.arch) ∧
          (∀z ≤ wall,book.arch.V.y (base+z)=menu.price ⟨i.val%menu.a,Nat.mod_lt _ menu.positive⟩) ∧
          Elected M book.arch.V height seats ∧
          let N:=base+wall
          let m:=base+old V menu.a i.val
          ∀(t s:ℕ),base ≤ t → t+s ≤ m → ∀(α:Wilt (inner M p))(X:Herit (inner M p))(B:Fin 2→ℝ)(Z:ℝ),
            PadRank book.arch.V (t+s) m Z → Bough (inner M p) α (paceT A.S m (t+s)) Z B →
            let genuine:=AutumnDay A chart α X m (t+s) N D
            ∃Y:CutsP H (M.T 4) p v C C C C,
              Y.L=torch ∧ Y.L'=book ∧ Y.vesselsC=book.arch.V ∧ Y.N=N ∧ Y.m=t ∧ Y.i=s ∧ Y.pt=genuine ∧
              Y.fuel=max 0 (capture.buy Z*∏i,B i*fee ((inner M p) i) e (X i)) ∧
              Reports A chart (M.T 4) p α X m (t+s) t N 8=
                (paceT A.S m (t+s))^4 • steep A chart (M.T 4) p N (t+s) (m-(t+s)) Y.tileP ∧
              Y.springP s=genuine-Shrine Y.Ntop Y.tileP ∧ Paid Y Q C₀ C₁ C₂ ∧
              WilsonMovingForkSharpRetainedBook.Booked Y m (inner M p) α X Q C₀ C₁ C₂ ledger pay thermal 0
                (Reports A chart (M.T 4) p α X m (t+s) t N 8):=by
  intro Q
  have en (i:Fin 2):Named M height seats ((inner M p) i):=⟨height4,nearData,rfl⟩
  have ex:Named M height seats Q:=⟨height4,farData,rfl⟩
  have cap:capP (inner M p)=8:=ranks M p
  obtain ⟨capture,C₀,C₁,C₂,purchase⟩:=WilsonMovingForkSharpMaster.original M p (inner M p) Q 16 u e v
    (by change (16:ℕ)=4+4+8;decide) (by decide) cap.le en ex (by omega) sensors
  obtain ⟨ledger,pay,thermal,funded⟩:=WilsonMovingForkSharpRetainedBook.original (H:=H) (n:=1) p (M.T 4) Q v 0
  refine ⟨capture,C₀,C₁,C₂,ledger,pay,thermal,?_⟩
  intro chart kernel V menu grant phase i wall cir
  obtain ⟨A,base,ker,pages,periods,gap,all⟩:=WilsonIndependentMovingRosterAllFinePlate.original M chart kernel V menu grant phase i
  obtain ⟨book,draw,quiet,_salary,started,clock,_auth,_edges,faculty,sold⟩:=all 4 D p height4 nearData
  obtain ⟨torch,same⟩:=faculty 8 (u+16) v (by omega) sensors
  refine ⟨A,base,ker,pages,periods,gap,book,torch,same,draw,quiet,started,faculty,clock,sold,?_⟩
  intro N m t s start entry α X B Z shape earns genuine
  have top:m ≤ N:=by
    change base+old V menu.a i.val ≤ base+WilsonIndependentEvenPassport.count V menu.a i.val
    unfold WilsonIndependentEvenPassport.count
    omega
  have school:Elected M torch.L.V height seats:=same.symm ▸ sold
  have fd:torch.L.V.draws=A:=same.symm ▸ draw
  have fc:torch.L.V.paid=chart:=same.symm ▸ quiet
  obtain ⟨Y,hl,hv,realm,last,first,span,actual,income,report,rest,bought⟩:=
    purchase torch book same.symm school t s m N (by rw [same,started];exact start) entry top α X B Z (same.symm ▸ shape) (fd.symm ▸ earns)
  have house:Elected M Y.vesselsC height seats:=realm.symm ▸ school
  obtain ⟨roster,⟨far⟩⟩:=WilsonIndependentMovingRosterAllFineSeats.roster house (inner M p) Q en ex
  have spring:SpringD Y.vesselsC (4+Q.h) 0 (Q.h+4+(0+(4+1)+2)) C:=by
    change SpringD Y.vesselsC 8 0 15 C
    exact house.spring 8 0 15 (by omega) (by omega) (by omega)
  have dorm:Dormitory Y.vesselsC (4+Q.h) 0 C:=house.dorm 8 0 (by omega) (by omega)
  have hh:Y.ceilC=t+s:=by change Y.m+Y.i=t+s;rw [first,span]
  have nativeA:Y.ax=A:=by change Y.vesselsC.draws=A;rw [realm];exact fd
  have nativeC:Y.tx=chart:=by change Y.vesselsC.paid=chart;rw [realm];exact fc
  let x:=Reports A chart (M.T 4) p α X m (t+s) t N 8
  have reg:x=(paceT Y.ax.S m Y.ceilC)^4 • steep Y.ax Y.tx (M.T 4) p Y.N Y.ceilC (m-Y.ceilC) Y.tileP:=by
    rw [nativeA,nativeC,last,hh];simpa only [fd,fc] using report
  have seen:Y.pt=AutumnDay Y.ax Y.tx α X m Y.ceilC Y.N D:=by
    rw [nativeA,nativeC,last,hh];simpa only [fd,fc] using actual
  refine ⟨Y,hl,hv,realm.trans (congrArg (·.V) same),last,first,span,?_,income,?_,?_,bought,?_⟩
  · simpa only [fd,fc] using actual
  · simpa only [fd,fc] using report
  · simpa only [fd,fc] using rest
  · exact funded Y spring dorm m (inner M p) α X far roster C₀ C₁ C₂ bought (by change 4 ≤ 8;decide)
      cap.le (hh.trans_le entry) (top.trans_eq last.symm) x reg seen
end YM.Integration.WilsonMovingForkSharpOpticalFaculty
