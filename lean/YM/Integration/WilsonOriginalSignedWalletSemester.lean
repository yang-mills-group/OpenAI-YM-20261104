theorem on_wallet (extra:ℝ) (hFilm:Earn.Tableau uK Actor M) (hΛ:Affinity.Taut J.support Actor uK Y'.old)
    (hYp:Affinity.Crown J.support Actor uK Y'.hard)
    (hu:∀v,0<jointRad v) (fit:∀v∈priorKeys,jointRad v ≤ w v)
    {regular gross:ℝ} (salary:birth.Paid jointRad R'.p.B (R'.p.supportExponent+1+1) regular)
    (all:WilsonRootedKioskOccupiedSlip.Gross birth jointRad R'.p.B (R'.p.supportExponent+1) gross)
    (freshTest:Affinity.Taut (joined).support (WilsonMixedTestTableau.actors Actor freshA)
      (WilsonMixedTestTableau.pieces uK freshK) birth) :
    WilsonOriginalBornLedger.priced R' joined Ρ (WilsonMixedTestTableau.actors Actor freshA)
      (WilsonMixedTestTableau.pieces uK freshK) birth (deposited) jointRad
      (Stoop.radius jointRad (WilsonRootedKioskFreeRadius.radius extra shift gross tW))
      totalReg tQ (fun t'=>(pℓ).push U.beta ((Tint.Patrol.picture M Y').density (leftTest t'))) ∧
    Scene.Armada filedRows w T (Bx).afterwards ((Bx).produce (pℓ).ratio.count*b') n₀ r.count κr ∧
    Earn.Tableau uK Actor filedRows ∧ totalReg ≤ 8*ξ*(e'+δ'+incomeH) ∧
    WilsonRootedKioskFreeRadius.radius extra shift gross tW ≤ max (max 1 extra) (ξ^5+gross/tW) := by
  have finance:=hσ
  have revenue:=finance.2
  have bp:0≤b':=budget_nonneg (U₀.suggests 0)
  have dp:0≤δ':=by obtain ⟨_,paid,_⟩:=hδ;exact budget_nonneg (paid.backed 0)
  have valid:=revenue.converted bp hvW
  obtain ⟨employee⟩:=Mentor.crew R D Q A F φ K0 h hE r u U.beta hβ' hm' R' hk hF rfl Yh
  have rules:=Semester.grammar R D Q A F φ K0 h r K u M n₀ Vv X' Qa hF Yh Zj hk κr employee hδ
  obtain ⟨theBook,medal⟩:=Tint.Campus.Investor.pays M Y' w U₀.positive T U₀ valid.breeze
    (show (Bx).inFee G U.p*b' ≤ 2-e' from valid.fits.trans (by linarith))
    (show (Bx).inFee G U.p*b'*Real.exp (-(Bx).limitF)^U.p.B ≤ Gp^r.stage from
      (mul_le_of_le_one_left (by positivity) valid.fits).trans valid.past) hO hK
  have notice:=Semester.readyN R D Q A F φ K0 h hE r K u M w n₀ Vv X' hX Qa hF hU₁ Y' hw hq y
    («r₀»:=2) («r₁»:=1) theBook Yh Zj hk κr hβ' hm' g hcZ
  obtain ⟨permit,same⟩:=Tint.Institute.recorded («X»:=M) («T»:=Y') («w»:=w) («tV»:=T) («hq»:=hq) («y»:=y)
    («H»:=Yh) («M0»:=Zj) («hβ»:=hβ₁) («Q»:=employee.real) («E»:=Bx) («D0»:=p₀)
    («S'»:=R!) («Yv»:=Mk) («k'»:=Θ) («hV»:=U₀) («hP»:=valid) («hK»:=rules) («hr0»:=hr) («hr1»:=hr')
    theBook (le_refl _) medal notice
  let walked:Travel.Walk Yh R' (((F.scout Xz Yz).pair.strong tx U.beta)/8) tP tQ tW:=by
    rw [←PriceCompiler.beta_eq A.B.valid]
    exact uV
  have result:=Tint.Institute.Permit.on_wallet («actors»:=Actor) («pieces»:=uK) («X»:=M)
    («T»:=Y') («w»:=w) («tV»:=T) («hq»:=hq) («y»:=y) («H»:=Yh) («M0»:=Zj) («hβ»:=hβ₁)
    («E»:=Bx) («Q»:=employee.real) («D0»:=p₀) («S'»:=R!) («hS»:=Q*) («Yv»:=Mk) («k'»:=Θ)
    («hV»:=U₀) («hP»:=valid) («hK»:=rules) («hl»:=hO) («Y0»:=permit) («uV»:=walked)
    freshA freshK freshHome priorKeys blank birth jointRad hFilm hΛ hYp hp hY hu fit salary all freshTest
    (Willow.spare_pos _) extra (Classical.choice (Tree.select µ (pℓ).patch.odd_side))
  have debt:Θ⁻¹*shift≤tW:=(Tint.Institute.Permit.energy («X»:=M) («T»:=Y') («w»:=w) («tV»:=T) («hq»:=hq) («y»:=y)
    («H»:=Yh) («M0»:=Zj) («hβ»:=hβ₁) («E»:=Bx) («Q»:=employee.real) («D0»:=p₀)
    («S'»:=R!) («hS»:=Q*) («Yv»:=Mk) («k'»:=Θ) («hV»:=U₀) («hP»:=valid) («hK»:=rules) («Y0»:=permit) («uV»:=walked)).2.2.2
  have strong:0<ξ:=lt_of_lt_of_le (by norm_num:0<(4:ℝ)) revenue.strong
  have fifth:0<Θ:=pow_pos strong _
  have spend:shift/tW≤Θ:=by
    apply (div_le_iff₀ (Willow.spare_pos _)).mpr
    calc
      shift=Θ*(Θ⁻¹*shift):=by rw [←mul_assoc,mul_inv_cancel₀ fifth.ne',one_mul]
      _≤Θ*tW:=mul_le_mul_of_nonneg_left debt fifth.le
  refine ⟨result,Scene.lit M (pℓ).ratio w T R! (Q*) U₀ valid.classUp valid.sale valid.schedule,
    hFilm.grows (pℓ).ratio R! (Q*) (Bx).afterwards,revenue.spend bp valid.sale dp hr.le,?_⟩
  unfold WilsonRootedKioskFreeRadius.radius
  apply max_le_max (le_refl _)
  rw [add_div]
  exact add_le_add spend (le_refl (gross/tW))
