variable {G:Gauge}{s:WilsonOriginalAllOrderCourse.Schedule G}{R:Run G}{simple:G.Simple}
variable {n q p N per m K j:ℕ}{k D:Fin n → ℕ}
variable (room:WilsonOriginalCensusPhysicalAttendance.Room s R simple)
  (ask:Demand q p k)
variable (π:ℕ → Layout G)(Γ:ℕ → Pace.Coin)
  (hk:Burn.horizon ask.vac+2 ≤ (R.alloy.B.a.clock).J m)
  (lessons:∀i,∀(hi:m ≤ i),i < N → Lesson (N:=N) R hk (WilsonOriginalCensusPhysicalAttendance.roots s R simple) (WilsonOriginalCensusPhysicalAttendance.tab s R simple) π Γ hi)
  (Ψ:(i:ℕ) → RG.Rep G (R.family.side i per))
  (record:Receives s R simple ask.school π Γ hk lessons Ψ)
  (young:m ≤ j)(live:j+1 < N)
variable {V:Realm G (q+1) Credit.leanC}{draw:V.draws=R.family.path.levels}{rate δ:ℝ}

/-- A single pair of elected original pupils and filed materials is shared by
every finite pin and each subface of its full ordinary Wilson numerator. -/
def Sold (openings:((Open R simple k ask.school.pieces (ask.school.order+1) ask.load j ∧ Open R simple k ask.school.pieces (ask.school.order+1) ask.load (j+1)))) : Prop :=
  ∃(op0:Mentor.Opportunity ((R.alloy.B.a.clock).J (j+1)) ((R.alloy.B.a.clock).J j))
    (op1:Mentor.Opportunity ((R.alloy.B.a.clock).J (j+2)) ((R.alloy.B.a.clock).J (j+1)))
    (c0:((Oak.Calendar R hk (WilsonOriginalCensusPhysicalAttendance.roots s R simple) (WilsonOriginalCensusPhysicalAttendance.tab s R simple) π Γ Ψ young (N:=N) ((lessons j young (Nat.lt_trans (Nat.lt_succ_self j) live)))))) (c1:((Oak.Calendar R hk (WilsonOriginalCensusPhysicalAttendance.roots s R simple) (WilsonOriginalCensusPhysicalAttendance.tab s R simple) π Γ Ψ (Nat.le_succ_of_le young) (N:=N) ((lessons (j+1) (Nat.le_succ_of_le young) live)))))
    (n0:op0.count=ask.school.pieces)(s0:op0.stage=ask.school.order+1)
    (n1:op1.count=ask.school.pieces)(s1:op1.stage=ask.school.order+1)
    (upper:Submitted R V draw D k N K (j+1) rate δ ((Poetry.Agenda.seed (WilsonOriginalCensusPhysicalAttendance.roots s R simple) MintClock.splits (Burn.horizon ask.vac) (R.alloy.B.a.clock.J (j+2)))))
    (lower:Submitted R V draw D k N K j rate δ ((Poetry.Agenda.seed (WilsonOriginalCensusPhysicalAttendance.roots s R simple) MintClock.splits (Burn.horizon ask.vac) (R.alloy.B.a.clock.J (j+1))))),
    ∀(cells:Digits V.draws (Fin n))(κ:(v:Fin n) → Knob (D v))(pt:Fin n → Chamber)
      (seed:(v:Fin n) → Choice R k v)(y:Fin n → Cover)(test:Case D)
      (deep:∀t:Hot (Stock.census (Fin n)),0 < mass k t.val.val)
      (w0 w1:Fin n → ℝ)(pos0:∀v,0 < w0 v)(pos1:∀v,0 < w1 v)
      (e0 e1:ℝ)(he0:0 < e0)(he1:0 < e1),
      type_of% (WilsonOriginalCensusPairedPublication.original R simple hk (WilsonOriginalCensusPhysicalAttendance.roots s R simple) (WilsonOriginalCensusPhysicalAttendance.tab s R simple) π Γ Ψ
        record.1 (WilsonPhysicalHistoryPriorAperture.law G MintClock.splits) room.books room.ahead room.chamber room.hospital room.warm record.2.1
        room.pass room.way young live op0 ((lessons j young (Nat.lt_trans (Nat.lt_succ_self j) live))) c0 op1 ((lessons (j+1) (Nat.le_succ_of_le young) live)) c1 upper lower
        cells κ pt seed y test deep ask.school.pieces (ask.school.order+1) ask.order ask.shelf p
        ask.load openings n0 s0 n1 s1 w0 w1 pos0 pos1 e0 e1 he0 he1)

include record in
theorem original (openings:((Open R simple k ask.school.pieces (ask.school.order+1) ask.load j ∧ Open R simple k ask.school.pieces (ask.school.order+1) ask.load (j+1))))
    (pair:WilsonOriginalCensusDatedSchools.Paired R V draw D k N K j rate δ ((Poetry.Agenda.seed (WilsonOriginalCensusPhysicalAttendance.roots s R simple) MintClock.splits (Burn.horizon ask.vac) (R.alloy.B.a.clock.J (j+2)))) ((Poetry.Agenda.seed (WilsonOriginalCensusPhysicalAttendance.roots s R simple) MintClock.splits (Burn.horizon ask.vac) (R.alloy.B.a.clock.J (j+1))))) :
    Sold (K:=K) (D:=D) (V:=V) (draw:=draw) (rate:=rate) (δ:=δ)
      room ask π Γ hk lessons Ψ young live openings :=by
  obtain ⟨⟨c0⟩,⟨c1⟩,op0,op1,n0,s0,n1,s1⟩:=record.2.2.2 j young live
  obtain ⟨upper,lower,_⟩:=pair
  refine ⟨op0,op1,c0,c1,n0,s0,n1,s1,upper,lower,?_⟩
  intro cells κ pt seed y test deep w0 w1 pos0 pos1 e0 e1 he0 he1
  exact WilsonOriginalCensusPairedPublication.original R simple hk (WilsonOriginalCensusPhysicalAttendance.roots s R simple) (WilsonOriginalCensusPhysicalAttendance.tab s R simple) π Γ Ψ record.1
    (WilsonPhysicalHistoryPriorAperture.law G MintClock.splits) room.books room.ahead room.chamber room.hospital room.warm record.2.1 room.pass
    room.way young live op0 ((lessons j young (Nat.lt_trans (Nat.lt_succ_self j) live))) c0 op1 ((lessons (j+1) (Nat.le_succ_of_le young) live)) c1 upper lower cells κ pt seed y test deep
    ask.school.pieces (ask.school.order+1) ask.order ask.shelf p ask.load openings n0 s0 n1 s1
    w0 w1 pos0 pos1 e0 e1 he0 he1

