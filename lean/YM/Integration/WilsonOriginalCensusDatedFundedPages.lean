variable {n:ℕ}{G : Gauge} (R : Run G) {m i N per k : ℕ}
  (hk : Burn.horizon k+2 ≤ R.alloy.B.a.clock.J m)
  (D : Roots (G:=G) R.metals.p.profile R.metals.K R.metals.p.kernel) (Q : D.Tab R.rolls)
  (π : ℕ → Layout G) (Γ : ℕ → Pace.Coin) (Ψ : ∀ j, RG.Rep G (R.family.side j per))
  (course : Concourse R.alloy R.kit R.T π Γ m N per k Ψ)
  {φ : ℕ → ℕ} (books : Mentor.Offices.Books D R.rolls Q φ) (hi : m ≤ i) (cut : i < N)
  (ahead : Mentor.Forecast D R.rolls Q φ books) 
  (pieces : (Fin n) → Submodule ℝ ℂ) (grades : (Fin n) → ℕ) (order shelf seats : ℕ)
  (physical : Wallet (room (Fin n)) → Config G (R.family.side (i+1) per) → Poly (Stock.census (Fin n)))
  (P : WilsonOriginalReceivedChain.Post (N:=N) R hk D Q π Γ Ψ books ahead (room (Fin n)) pieces grades
    order shelf seats i hi physical)
local notation "tape" => AllOrder.Floe.Step.tape (Burn.horizon k+2)
local notation "student" => Oak.student (n:=per) R hk D Q π Γ books hi P.op P.lesson ahead (room (Fin n))
  P.model order P.voter
local notation "starts" => Oak.grade0 R hk D Q π Γ hi P.lesson
local notation "stamped" => Mutation.stamp student (Γ i) starts (Burn.horizon k+2) order

variable {I:Type}[Fintype I]{port:Passport (R.family.side (i+1) per) (Fin n)}
  (B:I → Binder port (Stock.census (Fin n))){q:ℕ}{σ:ℝ}
  (H:Material R N (i+1) q grades σ B)

theorem stock (x:Affinity.Wallet (room (Fin n)))(grid:Side)(tiles:(R.family.side i per).val∣grid.val)
    (trees:∀b:Covers R.family.path.levels.S i grid,Forest (step R i b.val).ratio)
    (tags:∀b:Covers R.family.path.levels.S i grid,(step R i b.val).Choices)
    (s:Hot (Stock.census (Fin n)))(r e:ℕ)(Y:Stationary.Link G grid):
    Adjacent.born (fun a z=>(WilsonOriginalCensusGaussianCopies.value R cut B (charts H) x grid tiles trees tags order z a).part s.val)
        ((Rebirth.caliber (Γ i) starts).back (Burn.horizon k+2)) 0 r e Y=
      Adjacent.born (fun a z=>(WilsonOriginalCensusCofinalCopies.value R cut B (charts H) x grid tiles trees tags order z a).part s.val)
        ((Rebirth.caliber (Γ i) starts).back (Burn.horizon k+2)) 0 r e Y:=by
  congr 1
  funext a z
  exact congrArg (fun v:Poly (Stock.census (Fin n))=>v.part s.val)
    (WilsonOriginalCensusCofinalCopies.original R cut B (charts H) x grid tiles trees tags grades
      (fun l n y=>(WilsonOriginalCensusDatedMaterial.admitted H l n y).1)
      (fun l n y=>(WilsonOriginalCensusDatedMaterial.admitted H l n y).2) order z a)

include course in
theorem original (placed:P.passport=port)(names:P.modelIndex=((l:I)×(words H l).Roster))(ink:HEq P.model (mounts H))
    {w:(Fin n) → ℝ}{σ₀ C:ℝ}{p₀ seats₀ shelf₀:ℕ}
    (stock:Scene.Armada P.model w grades σ₀ C p₀ seats₀ shelf₀)(width:0 < σ₀)
    (pass:Pass D Q R.alloy R.kit)(month:Scholar.Month R.rolls D Q R.alloy.delay)
    {quiet:ℕ → SeriesA G}(actual:Read R N m (Burn.horizon k) quiet π Γ){τ cash:ℝ}
    (funded:Issued R N (i+1) (Burn.horizon k) (quiet (i+1)) τ cash)
    (legal:Legal tape (π (i+1)))(fits:order ≤ Burn.horizon k+1)(rank:order ≤ q)(narrow:shelf ≤ R.alloy.B.a.clock.J i)
    (x:Affinity.Wallet (room (Fin n)))(grid:Side)(tiles:(R.family.side i per).val∣grid.val)
    (trees:∀b:Covers R.family.path.levels.S i grid,Forest (step R i b.val).ratio)
    (tags:∀b:Covers R.family.path.levels.S i grid,(step R i b.val).Choices)
    (r:ℕ)(through:r ≤ order)(s:Hot (Stock.census (Fin n)))(e:ℕ)(kept:e ≤ r)(Y:Stationary.Link G grid):
    (peek tiles stamped grades (π i) tape x e Y).part s.val=
    Adjacent.born (fun a z=>(WilsonOriginalCensusCofinalCopies.value R cut B (charts H) x grid tiles trees tags order z a).part s.val)
       ((Rebirth.caliber (Γ i) starts).back (Burn.horizon k+2)) 0 r e Y:=by
  exact (WilsonOriginalCensusDatedReset.original R hk D Q π Γ Ψ course books hi cut ahead pieces grades order shelf seats
    physical P B H placed names ink stock width pass month actual funded legal fits rank narrow x grid tiles trees tags r through s e kept Y).trans
    (WilsonOriginalCensusDatedFundedPages.stock R hk D Q π Γ Ψ books hi cut ahead pieces grades order shelf seats physical P B H x grid tiles trees tags s r e Y)

end YM.Integration.WilsonOriginalCensusDatedFundedPages
