theorem original (simple:G.Simple)(shop:RG05Preconstruction.ReadoutPurchase R.b)
    (cap:∀j,(R.family.path.levels.budget j).supportExponent=100)(quote:OPE.Therm.Poetry R.family.path.levels)
    (D:Fin 3→ℕ)(p target order width:ℕ){η:ℝ}(η0:0<η)(A δ:ℝ)(A0:0≤A)(δ0:0<δ):
    ∃gate:ℕ,∀(ξ:(i:Fin 3)→S.Field (grade i))(ρ quota:Fin 3→ℝ)
      (slots:(i:Fin 3)→Slot F l (grade i) (ξ i) (ρ i) (quota i)),
      (∀i,0≤quota i)→(∀i,gate≤(slots i).j)→
      let j:=fun i=>(slots i).j
      let Y:=fun i=>(slots i).arm.source
      let M:=fun i=>(R.family.S.a (j i))^(grade i)*(quota i*cost F (grade i) (ρ i) (ξ i))
      ∃printed:Finished R grade j order η M Y,
        ∀(t:Finset (Fin 3)),t.Nonempty→∀(v N per K c w₀:ℕ),gate≤v→v≤c→c≤K→K<N→v+1≤K→
        2≤R.family.path.levels.clock.hatBeta K→R.family.S.a v/R.family.S.a K≤R.family.path.levels.clock.hatBeta v^width→
        R.family.S.scale K-R.family.S.scale v≤A*(1+Real.log (R.family.path.levels.clock.hatBeta (v+1)))→
        Sold R p target N per K v→∀(V:Realm G (p+1) Credit.leanC)(draw:V.draws=R.family.path.levels),
        V.paid=R.metals.O→V.y=zz R.family.path.levels→V.anchor≤v→
        Dormitory V (mass (grade ∘ seat t) univ) 0 Credit.leanC→
        ∀(probe:Probe D V t)(before:∀i,j i≤K)(income m C D₁ D₂:Fin 3→ℝ)(q:ℕ),
        let x:=regulatorRun R.family N per K
        let s:=Real.log x⁻¹
        let E:=power R grade (seat t) m η D₁ D₂
        let θ:=regulatorRun R.family N per v
        let w:=fitted R grade j K order η M Y before printed.1 N per
        (∀i,0≤ income i)→(∀i,M i≤C i*Real.exp ((2*m i)*s))→
        (∀i,Real.log (R.family.S.a K/R.family.S.a (j i))⁻¹≤D₁ i*s)→
        (∀i,income i≤Real.exp ((grade i:ℝ)*D₂ i*s))→0≤E+δ→(q:ℝ)+E+δ≤target→
        (∏z:t,income (seat t z))*‖residual R p D V t draw N per K c w₀ v probe w‖≤
          (bill R grade (seat t) C*fee R (grade ∘ seat t) univ*‖probe.test‖*
            fixed R (D ∘ seat t) (grade ∘ seat t) p univ)*((4/3:ℝ)^(E+δ)*θ^q):=by
  obtain ⟨first,settle⟩:=WilsonOlderFreshSoftSocketFitted.original R simple shop D p target A δ A0 δ0
  obtain ⟨second,guarded⟩:=WilsonOriginalMicroscopicGuardedDated.original R simple shop
    (fun j=>by rw [cap j];norm_num) quote grade order η0
  obtain ⟨third,restore⟩:=eventually_atTop.mp (WilsonOlderFreshSoftSocketFigurePower.original R simple width)
  refine ⟨max first (max second third),?_⟩
  intro ξ ρ quota slots pos late j Y M
  have M0 (i):0≤M i:=mul_nonneg (pow_nonneg (R.family.S.a_pos _).le _)
    (mul_nonneg (pos i) (cost_pos ..))
  have printed:Finished R grade j order η M Y:=by
    apply guarded j (fun i=>(le_max_left ..).trans ((le_max_right ..).trans (late i)))
    intro i N per live
    simpa only [WilsonPositionProgramBlockedPublicExperiment.deposited,Next.UVStress.quota,Y,M,j]
      using (slots i).numerical N per live
  refine ⟨printed,?_⟩
  intro t active v N per K c w₀ lateV vc ck live away warm band span sale V draw scheme heat anchor shelf
    probe before income m C D₁ D₂ q x s E θ w inc salary optical external expense spare
  have heard:=settle t active v ((le_max_left ..).trans lateV) j (fun i=>(le_max_left ..).trans (late i))
    (fun i=>(cap _).le) N per K c w₀ vc ck live away warm span sale V draw scheme heat anchor shelf probe
    order η M Y before printed.1 η0.le M0 income m C D₁ D₂ inc salary optical external
  have move:=restore v ((le_max_right ..).trans ((le_max_right ..).trans lateV)) N per K (vc.trans ck) live.le
    band E δ target q expense spare
  let k:=fee R (grade ∘ seat t) (univ:Finset t)
  let h:=fixed R (D ∘ seat t) (grade ∘ seat t) p (univ:Finset t)
  let b:=bill R grade (seat t) C
  have C0 i:0≤C i:=(mul_nonneg_iff_of_pos_right (Real.exp_pos _)).mp ((M0 i).trans (salary i))
  have b0:0≤b:=by
    unfold b WilsonOlderFreshSoftTrialCharge.bill
    apply Finset.prod_nonneg
    intro i _
    unfold WilsonOlderFreshSoftTrialSalary.base WilsonOlderFreshSoftTrialSalary.wrap
    exact mul_nonneg (mul_nonneg (by norm_num) (by positivity)) (C0 _)
  have k0:0≤k:=sum_nonneg fun _ _=>prod_nonneg fun _ _=>sum_nonneg fun _ _=>norm_nonneg _
  have h0:0≤h:=WilsonOlderFreshSoftSocketOptical.fixed_nonneg R _ _ _ _
  have f0:0≤‖probe.test‖:=probe.test.opNorm_nonneg
  calc
    _≤(b*Real.exp (E*s))*(k*(θ^target*(‖probe.test‖*(h*x⁻¹^δ)))):=heard
    _=(b*k*‖probe.test‖*h)*(Real.exp (E*s)*(θ^target*x⁻¹^δ)):=by ring
    _≤_:=mul_le_mul_of_nonneg_left move (by positivity)

end YM.Integration.WilsonOlderFreshSoftSocketPublicSlots
