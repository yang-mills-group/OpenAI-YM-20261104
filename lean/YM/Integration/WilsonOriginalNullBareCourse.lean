include scroll house in
theorem original (simple:G.Simple)(one:1 ≤ school.pieces)(deep:2 ≤ school.order) :
    ∀ᶠ m:ℕ in atTop,∀ N,m≤N → ∀per,∀W:Rep G (R.family.side N per),
      W.p=R.family.path.levels.budget N → W.beta=(R.family.path.rep N per N).beta →
      WilsonOriginalNullBareCapital.Priced W (Poetry.Agenda.seed D φ (Burn.horizon k) (R.alloy.B.a.clock.J N))
        school.order school.horizon school.pieces (budgetR R N) := by
  have paid:=WilsonOlderFreshAuxiliaryCourse.original R D Q₀ scroll books ahead house school simple one deep
  have climb:Tendsto R.family.path.levels.clock.hatBeta atTop atTop:=tendsto_atTop_add_const_left _ _
    (R.family.S.divergent.const_mul_atTop (Gauge.slopeConstant_pos simple))
  obtain ⟨base,large⟩:=eventually_atTop.1 (climb.eventually_ge_atTop 2)
  filter_upwards [paid,eventually_ge_atTop base] with m seats fine
  intro N start per W point same
  obtain ⟨π,Γ,hk,_,issued⟩:=seats (N+1) (Nat.le_succ_of_le start)
  obtain ⟨Ψ,history,_,post⟩:=issued per
  let H:=(post N start (Nat.lt_succ_self N)).some
  exact WilsonOriginalNullBareCapital.appointed R hk D Q₀ π Γ Ψ history books start ahead actors
    (fun _=>(⊥:Submodule ℝ ℂ)) (fun _=>0) school.order school.horizon school.pieces (booked G (Ψ (N+1)))
    H simple (Nat.lt_succ_self N) (large N (fine.trans start)) W point same

end YM.Integration.WilsonOriginalNullBareCourse
