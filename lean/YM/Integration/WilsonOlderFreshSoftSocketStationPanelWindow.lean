variable {G:Gauge}(R:Run G)
local notation "L" => R.family.path.levels
local notation "H" k:max => R.family.path.levels.clock.hatBeta k
local notation "Faces" => {t:Finset (Fin 3)//t.Nonempty}

theorem original (simple:G.Simple)(slow:WilsonWindowReportingPace.Slow R.kit)
    (D:Fin 3→ℕ)(e width pow target:ℕ)(A:ℝ)(ap:0≤A):
    let w:=date R width (loss R pow target)
    Tendsto w atTop atTop ∧ ∃gate:ℕ,∀c≥gate,w c≤c ∧ ∀v≥gate,v≤w c →
      ∀(V:Realm G (e+1) Credit.leanC),V.anchor≤v →
      V.draws=L → V.paid=R.metals.O → V.y=zz (L) →
      (∀s:Faces,Dormitory V (mass (grade ∘ seat s.val) univ) 0 Credit.leanC) →
      ∀(N per f n:ℕ)(cut:f+n≤N),c≤f+n → v+1≤f+n → R.family.S.a c/R.family.S.a (f+n)≤(H c)^width →
      R.family.S.scale (f+n)-R.family.S.scale v≤A*(1+Real.log (H (v+1))) →
      ∀(req step:ℕ)(B:ℝ)(P:Panel R grade N per f (f+n) (Nat.le_add_right f n) cut req pow step B)
      (s:Finset (Fin 3)),s.Nonempty → ∀(p:Probe D V s)(q:ℕ),q≤e → ∀θ:ℝ,|θ|≤1 →
      let g:=regulatorRun R.family N per (f+n)
      let x:=printed R cut P
      ‖row (R:=R) D V s N (f+n) c (w c) v p g x q θ false-row (R:=R) D V s N (f+n) c (w c) v p g x q θ true‖≤
        ((max 1 B)^3*2^debt R pow)*g^target:=by
  classical
  intro w
  have paid:(0:ℝ)≤loss R pow target:=by unfold loss;positivity
  obtain ⟨esc,dates⟩:=WilsonOlderFreshSoftSocketStationCalendar.original R simple slow width (loss R pow target) paid
  obtain ⟨calendar,chooseDate⟩:=eventually_atTop.1 dates
  choose cutoff hearing using fun s:Faces=>eventually_atTop.1
    (WilsonOlderFreshSoftSocketStationPanelStops.original R simple D e s.val s.property A ap)
  refine ⟨esc,max calendar (univ.sup cutoff),?_⟩
  intro c present
  obtain ⟨wc,housing⟩:=chooseDate c ((le_max_left ..).trans present)
  refine ⟨wc,?_⟩
  intro v warm vw V vn draw scheme heat dormant N per f n cut ck vK close budget req step B P s active p q qok θ small g x
  let h:Faces:=⟨s,active⟩
  have start:cutoff h≤v:=(le_sup (f:=cutoff) (mem_univ h)).trans ((le_max_right ..).trans warm)
  have visit:=hearing h v start V vn draw scheme heat (dormant h) N per f n c (w c) cut vw wc ck vK budget
      req pow step B P p q qok θ small
  have old:=WilsonOlderFreshSoftSocketStationPanelCapital.owned R grade cut P 0
  have positive:0<(H (f+n))^pow:=pow_pos (zero_lt_one.trans (R.family.path.levels.fits.delayed _)) _
  have b0:0≤B:=nonneg_of_mul_nonneg_left ((Finset.sum_nonneg (fun _ _=>norm_nonneg _)).trans old) positive
  exact visit.trans (WilsonOlderFreshSoftSocketStationPanelPower.opened R width pow target housing ck cut close s B b0)

end YM.Integration.WilsonOlderFreshSoftSocketStationPanelWindow
