/-- The original regulated conditional terminal is heard on the independent Figure's actual
    doses, fixed-child itinerary, and full N-quiet. Both errors are charged at the same heat. -/
theorem original (active:first≤j)(young:j<top-1){c:ℕ}(before:j+1≤c)(ck:c≤top)(cold:gv≤1)(coldK:gK≤1)
    {C:ℝ}{E:ℕ}(cp:1≤C)(allow:allowance≤1)(rent₀:0≤rate)(rent:rate≤C*(3*(gv)⁻¹)^E)
    (inputs:∀a,‖test a‖≤C*(3*(gv)⁻¹)^E)(p goal:ℕ)(kept:goal+debt n E (ic)≤p+1)(order:p≤q₀)
    (used:mask.val.Nonempty)(Vₚ:Realm G (p+1) Credit.leanC)(drawₚ:Vₚ.draws=R.family.path.levels)(payₚ:Vₚ.paid=R.metals.O)
    (dorm:Dormitory Vₚ (mass grades mask.val) 0 Credit.leanC)(origin:Vₚ.anchor≤j+1)
    (A B:ℝ)(front:PadRank Vₚ c top A)(march:PadRank Vₚ (j+1) c B)(H:ℕ)
    (ranks:∀q:Selection R grades mask.val,degree R grades mask.val (WilsonOlderFreshSoftSocketFaces.fill R grades mask.val q)≤H)
    (crop:H≤p)(kinetic:∀h≤H,WilsonOlderFreshSoftSocketFare.bracket R N per top (j+1) h p≤(gv)^goal):
    ‖(∑q:Selection R grades mask.val,wt q*((gs)*(((wrd q) (j+1)) 1).part mask))-
      figure R grades κ pt N per top c (j+1) (path₀) mask.val labels (pins₀ c) (touch test mask.val) p (gv)‖≤
      ((∑b:Columns R (fun i:mask.val=>grades i),‖packet R grades mask.val labels N per top b‖)*
        WilsonOlderFreshSoftSocketCensus.fee R grades mask.val)*
        ((gv)^goal*(ceiling n (q₀) (∑a,grades a) E (ic) C+
          ‖touch test mask.val‖*gross R dims grades p mask.val A B)):=by
  let E₀:=ceiling n (q₀) (∑a,grades a) E (ic) C
  let pur:= (∑b:Columns R (fun i:mask.val=>grades i),‖packet R grades mask.val labels N per top b‖)*
    WilsonOlderFreshSoftSocketCensus.fee R grades mask.val
  let fig:=figure R grades κ pt N per top c (j+1) (path₀) mask.val labels (pins₀ c) (touch test mask.val) p (gv)
  let normed:=normalized R grades κ pt N per top c (j+1) (path₀) mask.val labels (pins₀ c) (touch test mask.val) p (gv)
  let val (q:Selection R grades mask.val):ℂ:=(gs)*(((wrd q) (j+1)) 1).part mask
  let scalar (q:Selection R grades mask.val):ℂ:=Complex.ofReal (flat (stopped R grades N top c (j+1) (path₀) (pins₀ c)
    mask.val (touch test mask.val) (start R grades κ pt (WilsonOlderFreshSoftSocketFaces.fill R grades mask.val q))) p (gv))
  have same (q:Selection R grades mask.val):‖val q-scalar q‖≤E₀*(gv)^goal:=by
    have Hq:=WilsonOriginalTwoFlatIRSocketPower.original (G:=G) (n:=n) (N:=N) (R:=R) (per:=per) (V:=V) (draw:=draw)
      (rate:=rate) (allowance:=allowance) (power:=power) (P:=P) (house:=house) (day:=day) (κ:=κ) (pt:=pt)
      (top:=top) (first:=first) (valid:=valid) (toll:=toll) (old:=old) (test:=test) (classroom:=classroom)
      (fine:=fine) (z:=z) (s:=mask) (q:=q) (paid:=paid) (hd:=hd) (background:=background) (σ:=σ)
      active young before ck cold cp allow rent₀ rent inputs p goal kept order
    rw [WilsonOriginalTwoFlatRoseMerRestored.normalized (draw:=draw)] at Hq
    have oneMark:WilsonOriginalTwoFlatRoseMerRestored.marked
        (fun a=>((WilsonReceivedChronologicalSocket.lit (V:=Fin n)) a).val) mask.val=1:=by
      change ∏_a∈mask.val,(1:ℂ)=1
      simp
    rw [oneMark,one_mul] at Hq
    exact Hq
  let pathₚ:=cast (congrArg (fun l=>Digits l (Fin n)) drawₚ).symm (path₀)
  have fare:=WilsonOlderFreshSoftSocketFare.original R dims grades p mask.val used Vₚ drawₚ payₚ dorm N per top c (j+1)
    origin before ck valid coldK cold A B front march κ pt labels pathₚ (pins₀ c) (touch test mask.val)
    goal H ranks crop kinetic
  have back:cast (congrArg (fun l=>Digits l (Fin n)) drawₚ) pathₚ=(path₀):=by simp [pathₚ]
  have right:‖normed-fig‖≤pur*((gv)^goal*(‖touch test mask.val‖*gross R dims grades p mask.val A B)):=by
    rw [norm_sub_rev]
    simpa only [back] using fare
  have weightPrice:=WilsonOlderFreshSoftSocketCensus.original R grades N per top valid coldK mask.val labels
  have gp:0≤gv:=(ActualRunKernelPackets.regulator_pos R N per (j+1) (before.trans (ck.trans valid))).le
  have cc:0≤C:=zero_le_one.trans cp
  have nonneg:0≤E₀:=by dsimp [E₀,WilsonOriginalTwoFlatIRSocketPower.ceiling,WilsonOriginalTwoFlatIRFlatWageCap.cap];positivity
  have left:‖(∑q:Selection R grades mask.val,wt q*val q)-normed‖≤pur*(E₀*(gv)^goal):=by
    change ‖(∑q:Selection R grades mask.val,wt q*val q)-∑q:Selection R grades mask.val,wt q*scalar q‖≤_
    rw [←Finset.sum_sub_distrib]
    calc
      _≤∑q:Selection R grades mask.val,‖wt q‖*(E₀*(gv)^goal):=(norm_sum_le _ _).trans (Finset.sum_le_sum fun q _=>by
        rw [←mul_sub,norm_mul];exact mul_le_mul_of_nonneg_left (same q) (norm_nonneg _))
      _≤_:=by rw [←Finset.sum_mul];exact mul_le_mul_of_nonneg_right weightPrice (mul_nonneg nonneg (pow_nonneg gp _))
  exact (norm_sub_le_norm_sub_add_norm_sub _ normed fig).trans ((add_le_add left right).trans_eq (by dsimp [pur,E₀];ring))

