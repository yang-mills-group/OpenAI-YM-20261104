def charge {G:Gauge}{n:ℕ}(R:Run G)(grades power:Fin n → ℕ)(P:ℕ)(C α:ℝ)(E:ℕ)(s:(Stock.census (Fin n)).Mode):ℝ:=
  let intake:=WilsonOriginalTwoFlatIRAddressedCap.coefficient n (terms grades power P).order (∑a,grades a) C (Fintype.card (Multi.Hot (Stock.census (Fin n))))
  let house:=((2:ℝ)^((programme grades power P).order+(programme grades power P).shelf+1))^2*max 1 intake
  let e:=WilsonOriginalTwoFlatIRHalo.power s.val.card ((∑a,grades a)+1+2+(2+2*n*E))+0+2
  WilsonOriginalTwoFlatIRFiled.reserve (WilsonOriginalTwoFlatIRHalo.roof (Stock.census (Fin n)) s (R.family.localSection 0)
    R.family.params α house) 1*3^e

theorem original (r:ℝ)(rp:0<r)(small:factor R φ*r ≤ R.family.S.a 0)(start:first ≤ j)
    (active:j+1 ≤ capture R φ r)(born:capture R φ r ≤ f)(young:j+1<top-1)
    (narrow:8*R.family.S.a f<R.family.S.a (capture R φ r))(cell:WilsonCenteredCompactBooking.mass R φ r (f,per) z≠0)
    (big:2 ≤ R.alloy.B.a.clock.hatBeta (j+1))(board:gates)
    (clocked:(eventually_atTop.mp (WilsonOriginalTwoFlatIRRows.nextClock R simple)).choose ≤ j+1)
    {u v p depth E:ℕ}(uc:u ≤ j+1)(vc:v ≤ j+1)(quote:Quote R N per u v (j+1) p depth uc vc)
    {C:ℝ}(cp:1 ≤ C)(allowed:allowance ≤ 1)(rent:0 ≤ rate)(out:rate ≤ C*(X₀)^E)(cap:∀a,caps a ≤ C*(X₀)^E)
    {α:ℝ}(strip:(rep).p.supportExponent ≤ α)(ou:Opened R.family 0 u per)(ov:Opened R.family 0 v per)
    (reach:∀mask:(marks).Mode,4*(p+(WilsonOriginalTwoFlatIRHalo.power mask.val.card ((∑a,grades a)+1+2+(2+2*n*E))+0+2)) ≤ depth):
    MeasureTheory.Integrable (WilsonReceivedChronologicalMixture.mix (per:=per) (V:=Fin n) (J:=Stock.census (Fin n)) (I:=fun m=>Selection R grades m.val) R amount (sheets) (j+1)) (prior G (R.family.side (j+1) per)) ∧
    ∀mask:(marks).Mode,
    (∀U,(WilsonReceivedChronologicalMixture.mix (per:=per) (V:=Fin n) (J:=Stock.census (Fin n)) (I:=fun m=>Selection R grades m.val) R amount (sheets) top U).part mask=
      ∑y:Selection R grades mask.val,amount mask y*(((ν).eval U:ℂ)*word R grades κ pt (gK) (placed R fine z) mask.val y U)) ∧
    ‖cross R (N:=N) uc vc (face R N per (WilsonReceivedChronologicalMixture.mix (per:=per) (V:=Fin n) (J:=Stock.census (Fin n)) (I:=fun m=>Selection R grades m.val) R amount (sheets)) mask)‖ ≤
      (∑y:Selection R grades mask.val,‖amount mask y‖)*(charge R grades power P C α E mask*
        (regulatorRun R.family N per (j+1))^p):=by
  have filed (mask:(marks).Mode)(y:Selection R grades mask.val):=
    WilsonOriginalTwoFlatIRSocketVisit.original (R:=R) (per:=per) (V:=V) (draw:=draw) (rate:=rate) (allowance:=allowance)
      (power:=power) (P:=P) (house:=house) (day:=day) (κ:=κ) (pt:=pt) (top:=top) (first:=first) (valid:=valid)
      (toll:=toll) (old:=old) (test:=test) (classroom:=classroom) (fine:=fine) (z:=z) (s:=mask) (q:=y)
      (paid:=paid) (hd:=hd) (background:=background) (σ:=σ) r rp small start active born young narrow cell big board clocked
      uc vc quote cp allowed rent out cap strip ou ov (reach mask)
  have liveIncome:∀(mask:(marks).Mode)(y:Selection R grades mask.val),Integrable ((sheets) mask y (j+1)) (prior G _):=
    fun mask y=>(filed mask y).2.1
  refine ⟨WilsonReceivedChronologicalMixture.live (per:=per) (V:=Fin n) (J:=Stock.census (Fin n)) (I:=fun m=>Selection R grades m.val) R amount (sheets) liveIncome,?_⟩
  intro mask
  constructor
  · intro U
    change ∑y:Selection R grades mask.val,amount mask y*((sheets) mask y top U).part mask=_
    apply Finset.sum_congr rfl
    intro y _
    rw [(filed mask y).1 U]
  · have eq:=WilsonReceivedChronologicalReadout.density R N per (WilsonReceivedChronologicalMixture.mix (per:=per) (V:=Fin n) (J:=Stock.census (Fin n)) (I:=fun m=>Selection R grades m.val) R amount (sheets)) mask (j:=j+1) (by omega)
    have bound:=WilsonOriginalTwoFlatIRCapturedBlend.original (G:=G) (N:=N) (per:=per) (c:=j+1) (u:=u) (v:=v)
      (V:=Fin n) (J:=Stock.census (Fin n)) (I:=fun m=>Selection R grades m.val) R amount (sheets) mask
      (face R N per (WilsonReceivedChronologicalMixture.mix (per:=per) (V:=Fin n) (J:=Stock.census (Fin n)) (I:=fun m=>Selection R grades m.val) R amount (sheets)) mask) eq liveIncome uc vc
      (fun _=>charge R grades power P C α E mask*(regulatorRun R.family N per (j+1))^p)
      (fun y=>(filed mask y).2.2)
    simpa only [Finset.sum_mul] using bound

