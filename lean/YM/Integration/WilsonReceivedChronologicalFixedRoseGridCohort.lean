theorem original (simple:G.Simple)(bliss:Bliss F l z H)(slow:WilsonWindowReportingPace.Slow R.kit)
    {T h:ℕ}{δ:ℝ}(dp:0 < δ)(books:(s:{s:ℝ//0 < s ∧ s < δ}) → Book F (l:=l) H z 6 T s.val)
    (x:∀i:Fin 3,RG17.Free C (grade i).val)(extra:∀i:Fin 3,(Spin.comparator (C).book).Field (grade i).val)
    (lead:Leading F Jr)(admitted:∀d:ℕ,∀ᶠr in trail,Frame.obedient F H (Jr r) d)
    (birth:WilsonPhysicalAllGradeWeakElection.Assignment F Jr H l simple)
    {n:ℕ}(positive:0 < n)(ratio:Z.run.ratio=(3:ℕ)^n)(stage:ℕ)(color:G.ColorIndex)
    (paths:FundedOriginalVacuumPaths.prices R.kit)
    (same:∀r,∃live:6 ≤ (birth.day r.val).1,WilsonPhysicalWeakWallBooks.Shared F (books r)
      (WilsonPhysicalWeakSameStation.trim live (birth.day r.val).2))
    (bank:WilsonThermometerClusterProjectionBudget.Ready (P))(lamp:WilsonReportLampForecast.Ready (P))
    (below:(l:Filter (ℕ×ℕ)) ≤ order.fuse)
    (funded:WilsonOriginalAllOrderCourse.Paid.{u₀} axis simple ε (WilsonOriginalOpticalSchedule.prepared σ) R crop W):
    ∃t ≥ 6+3,(∀r,WilsonMovingForkWindowBooks.Priced F (books r)) ∧
    ∃(M:Fin 3 → ℝ)(E:Fin 3 → ℕ),(∀i,1 ≤ M i) ∧ ∀φ:Test 3,∃apron:ℕ,∀(goal physical votes debt:ℕ),
    let arrival:=entrance goal physical
    let requested:=request goal physical E
    let power:=debit goal physical E
    let reserve:=depth ((2*power+∑i,E i)+1) (width T h) 6
    let mesh:=2*T+11+2*h+reserve+1
    let pole:=(∑i,E i)+WilsonAddressedMixedRawTrial.power T h reserve 6
    let tuition:=capital R 6 (max 1 (4*∑i,M i))
    let earned:=middle R goal physical votes debt mesh 1 pole
    let hired:=WilsonAddressedPublicFirstRoseTerms.order R earned
    let last:=terminal goal physical votes mesh
    let Q:=print goal physical votes debt mesh 1
    ∀{I:Type}[Fintype I](D:Fin 3 → ℕ)(pt:Fin 3 → Chamber)(caps:Fin 3 → ℝ), (∀i,‖present D i‖ ≤ caps i) → 
    (∀i,(fun i:Fin 3=>(WilsonPositionThermometerGradedSource.grade i).val) i < D i) → ∀(tol η:ℝ),0 < tol → 0 < η → 
    ∀(_teacher:ℕ)(_tube:LinkTube G)(_pieces _assignment:ℕ)(_orders:Bool → ℕ)(_span:I → ℕ)(_lag:I → Bool → ℕ)
      (loss:ℝ)(sourceFloor fileTariff:ℕ),
    let infrared:=max (crossed (fun i:Fin 3=>(WilsonPositionThermometerGradedSource.grade i).val) earned) (4*(2*⌈loss⌉₊+1))
    let A:=WilsonAddressedPublicFirstRoseSchedule.allowance R simple slow T h reserve infrared
    ∃training:ℝ,1 ≤ training ∧
    let price:=WilsonReceivedChronologicalFixedRoseEnrolledCash.roof training caps
    let plan:=budget (fun i:Fin 3=>(WilsonPositionThermometerGradedSource.grade i).val) (fun _=>0) (hired+1) A pole hired arrival earned 1 last 1 tuition price 100 η η price
    plan.Affords (WilsonReceivedChronologicalFixedRoseHeldCofactor.demand goal physical) (2*votes)
      (WilsonOriginalObservedRosePublicMesh.aperture mesh) 14 ∧
    ∀ᶠu:ℕ in atTop,∀ᶠanchor:ℕ in atTop,∃V:WilsonCoeffUV.Bank.Realm G ((terms (fun i:Fin 3=>(WilsonPositionThermometerGradedSource.grade i).val) (fun _=>0) (hired+1)).order+1)
      Credit.leanC,∃draw:V.draws=R.family.path.levels,
    V.paid=R.metals.O ∧ V.anchor=anchor ∧ ∀(world:XSpace.Run)(stage:ℕ)
      (band:WilsonPositionProgramReporterBand.Band R world stage)(stop:WilsonIndependentCapturedPages.Stop R world band u infrared),
      0 < stage → (C).ref 0 ≤ u → ∀floor:ℕ,∀ᶠr in trail,∀ρ:Fin 3 → {s:ℝ//0 < s ∧ s < δ},
      (∀i,r ≤ (ρ i).val ∧ (ρ i).val ≤ outer z h r) → (∃i,(ρ i).val=r) → 
      let f:=reporter F books ρ
      let K:=berth R reserve f
      let c:=WilsonReceivedChronologicalFixedCellFee.capture R φ r
      ∃w:ℕ,c=band.reporter+w ∧
      let first:=stop.date w-1
      ∃_eqDate:first+1=stop.date w,∃old:u ≤ first,∃crossing:first+1 < c,∃upper:c < f,∃fk:f < K,
      floor+1 ≤ c ∧ stage ≤ first+1 ∧
      WilsonAddressedPublicFirstRoseTicket.Receipt R (WilsonAddressedPublicFirstSites.original R draw φ).choose
        (WilsonReceivedChronologicalFixedCellFee.factor R φ) r (wilson z r) first f K c A ∧
      ∃src:ℕ,sourceFloor ≤ src ∧ u ≤ src ∧ src+2 ≤ f ∧ ∀program:Program R (fun i:Fin 3=>(WilsonPositionThermometerGradedSource.grade i).val) K,
      ∃file:Filed R (fun i:Fin 3=>(WilsonPositionThermometerGradedSource.grade i).val) K,(∀i,file.station i=(home F Jr Z (books (ρ i)) (grade i) (x i)).j) ∧ file.target=fileTariff ∧
      (∀N per wallet seats d,d < K → file.row N per wallet seats d=WilsonMovingForkPrintedFile.row program N per wallet seats d) ∧
      ∀_prior:∀per:ℕ,∀_:cells R φ r (f,per),∀s:Finset (Fin 3),WilsonReceivedCanonicalVersePortfolio.Selection R (fun i:Fin 3=>(WilsonPositionThermometerGradedSource.grade i).val) s → 
        ∀i:ℕ,Config G (R.family.side i per) → Marker.Poly (Stock.census (Fin 3)),
      ∀ᶠpair in (l:Filter (ℕ×ℕ)),∃kn:K ≤ pair.1,
      ∃Y:cells R φ r (f,pair.2) → Panel R (fun i:Fin 3=>(WilsonPositionThermometerGradedSource.grade i).val) pair.1 pair.2 f K fk.le kn requested pole t tuition,
      (∀o,Ground R pair.1 pair.2 src f apron o.val ∧ (Y o).slot=file.station ∧ (Y o).axis=file.A pair.1 pair.2 ∧
        (Y o).M=M ∧ (Y o).loc=o.val ∧ (Y o).turn=(fun _=>WilsonOriginalTwoFlatIRPoolBook.direct) ∧
        (∀i,(Y o).names i=(home F Jr Z (books (ρ i)) (grade i) (x i)).arm.source pair) ∧
        (∀i,displayed R ((fun i:Fin 3=>(WilsonPositionThermometerGradedSource.grade i).val) i) ((Y o).names i) ((Y o).turn i)=(home F Jr Z (books (ρ i)) (grade i) (x i)).arm.source pair) ∧
        ∀i k,k ≤ (fun i:Fin 3=>(WilsonPositionThermometerGradedSource.grade i).val) i → (C).ref k ≤ pair.1) ∧
      Posted R (fun i:Fin 3=>(WilsonPositionThermometerGradedSource.grade i).val) D pt φ r (c:=c) (v:=first+1) ((old.trans (Nat.le_succ first)).trans
        (crossing.le.trans (upper.le.trans fk.le))) fk.le kn plan file Y draw first Q:=by
  classical
  obtain ⟨t,level,costed,M,E,one,source⟩:=WilsonReceivedChronologicalFixedRoseGridSourceBook.original F Jr Z simple bliss slow
    dp books x extra lead admitted birth positive ratio stage color paths same bank lamp funded
  refine ⟨t,level,costed,M,E,one,?_⟩
  intro φ
  obtain ⟨apron,school⟩:=source φ
  refine ⟨apron,?_⟩
  intro goal physical charges debt arrival requested power reserve mesh pole tuition earned hired last Q I _ D pt caps covered labels
    tol η tp ep teacher tube pieces assignment orders span lag loss sourceFloor fileTariff infrared A
  have startCash:0 ≤ tuition:=le_max_left .. 
  have ranks:=WilsonReceivedChronologicalFixedRoseEnrolledRanks.original R goal physical charges debt mesh 1 pole 1 tuition startCash
  have orderTrue:hired=earned:=ranks.1
  have hp:0 < infrared:=lt_of_lt_of_le (by omega : 0 < 4*(2*⌈loss⌉₊+1)) (le_max_right ..)
  have paid:=WilsonReceivedChronologicalFixedRoseGridCampus.original F funded paths id D pt caps
    (fun i=>(norm_nonneg _).trans (covered i)) labels φ earned tol η tp ep teacher tube pieces assignment orders span lag
    bliss slow lamp 6 T h reserve infrared hp grade books
  obtain ⟨room,pay,training,solid,workers⟩:=paid
  refine ⟨training,solid,?_⟩
  intro price plan
  have affordable:=ranks.2.2.2.2.2.2 A price 100 η price
  refine ⟨?_,?_⟩
  · dsimp only [plan]
    rw [orderTrue]
    simpa only [earned,arrival,last] using affordable
  obtain ⟨whole,fromBook⟩:=school goal physical
  obtain ⟨openLevel,sourceAt⟩:=eventually_atTop.mp (fromBook sourceFloor fileTariff)
  let gate:=WilsonReceivedChronologicalFixedRoseGridGates.original R simple (fun i:Fin 3=>(WilsonPositionThermometerGradedSource.grade i).val) (hired+1)
  filter_upwards [workers,eventually_ge_atTop openLevel,eventually_ge_atTop gate.choose,
      eventually_ge_atTop (frontage R (fun i:Fin 3=>(WilsonPositionThermometerGradedSource.grade i).val))] with u appointed older fresh refs
  obtain ⟨oldFloor,active,resident,quiet,leases⟩:=appointed
  filter_upwards [leases] with anchor clerk
  obtain ⟨V,draw,metal,sameAnchor,cal⟩:=clerk
  refine ⟨V,draw,metal,sameAnchor,?_⟩
  intro world worldStage band stop live enough floor
  have appointments:=cal world worldStage band stop live enough earned floor
  filter_upwards [appointments,sourceAt u older u le_rfl,self_mem_nhdsWithin] with r place root pos
  intro ρ spread near f K c
  obtain ⟨w,code,date,old,lower,upper,fk,walk,ks,numerical,phase,geometry₁,geometry₂,travel,window⟩:=place ρ spread near
  let first:=stop.date w-1
  obtain ⟨src,uf,front,up,young,files⟩:=root ρ spread near
  refine ⟨w,code,date,old,lower,upper,fk,numerical,phase,travel,src,front,up,young,?_⟩
  intro program
  obtain ⟨_,file,seats,focus,banked,readings⟩:=files program
  refine ⟨file,seats,focus,banked,?_⟩
  intro prior
  have equality:hired=start R goal physical charges debt mesh 1+2*pole*3:=
    orderTrue
  have enoughQ:Q ≤ (terms (fun i:Fin 3=>(WilsonPositionThermometerGradedSource.grade i).val) (fun _=>0) (hired+1)).order:=by
    rw [orderTrue]
    exact ranks.2.2.2.1
  exact WilsonReceivedChronologicalFixedRoseGridActual.original
    (R:=R) (simple:=simple) (funded:=funded) (history:=paths) (role:=id) (lens:=D) (pt:=pt)
    (caps:=caps) (covered:=covered) (φ:=φ) (requestedClass:=earned) (A:=A)
    (tol:=tol) (η:=η) (tp:=tp) (ep:=ep) (teacher:=teacher) (tube:=tube) (pieces:=pieces) (assignment:=assignment)
    (orders:=orders) (span:=span) (lag:=lag) (book:=room) (training:=training) (resident:=resident)
    (draw:=draw) (old:=old) (dated:=walk) (ks:=ks) (rp:=pos) (before:=lower) (inside:=upper) (fk:=fk) (file:=file)
    order (l:Filter (ℕ×ℕ)) below oldFloor active quiet fresh refs geometry₁ geometry₂ E arrival (whole univ)
    (start R goal physical charges debt mesh 1) earned infrared Q last equality (le_max_left ..)
    ranks.2.2.1 enoughQ window _ readings prior
