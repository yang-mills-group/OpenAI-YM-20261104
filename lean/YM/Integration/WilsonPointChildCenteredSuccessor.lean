/-- The complete two-date occupied finite log is compared with the identical
second Wick log on its folded, genuinely deposited upper family. -/
theorem original (G:Gauge)(D k:ι → ℕ)(I:Finset ι)(E e r:ℕ)(he:e ≤ E):
    ∃fare:Gear G → ℝ,∃M:ℝ,0    ≤    M ∧ ∃d:ℕ,∃Lcost:ℝ,0 ≤ Lcost ∧ ∀(R:Run G),G.Simple →
    WilsonPointChildFiledTest.Filed R → WilsonPointChildDigitHierarchy.Filed R →
    WilsonReceivedCloseFundedHeat.Quiet R →
    ∀cash:ℕ → Gear G → ℝ,FundedMarkedCoverRows.prices cash R.kit →
    (∀ᶠj:ℕ in atTop,∀J,fare J     ≤     cash (R.family.path.levels.clock.J (j+1)) J) →
    ∀(u:ι → G.ColorIndex)(depth:∀s,k s<D s)(_o:Loc G 1),
    ∀_tags:∀j n,(Flat.primary (R.family.path.levels.clock.op j 0).patch R.family.path.levels.clock.kernel n).Choices,
    ∀η:ℝ,0<η → ∀ᶠm:ℕ in atTop,∀N B per,m+1<N → m+1 ≤ B →
    ∀(d₁ d₂:ι → ∀i,Site (R.family.S.block i))(v₁ v₂:∀s,Letter (R.family.labels.level (k s))),
    ∀(T:Finset ι),
    ∀y:ι → Cover,∀z:ι → Site (loose R.family.path.levels (m+1)).L,
    let A:=R.family.path.levels
    let O:=R.metals.O
    let n:=R.family.side m per
    let f:=R.family.side (m+1) per
    let α:=WilsonPointChildCenteredPortfolio.bank R u depth d₁ N (m+2) v₁ (chartIn (loose A (m+1)) y z)
    let β:=WilsonPointChildCenteredPortfolio.bank R u depth d₂ B (m+1) v₂ y
    let K:=mounted T (logO A O (m+1) N α k) β
    let a:=WilsonPointChildCenteredIncome.share R (m+2) η D
    let b:=WilsonPointChildCenteredIncome.share R (m+1) η D
    let A₀:=(A.clock.hatBeta (m+2))^η*WilsonPointChildCenteredPortfolio.cap D
    let C:=allowance M ((zz A (m+1))^d) A₀ a b I
    (∀J⊆I,J⊆T → J.Nonempty → 4*crestCard y J<f.val) →
    Eu k K ∧ K ∅=0 ∧ ∀x,‖(logO A O m N K k I).1 n e r x-
        coilH A O m N n K k (ratioHigh A O N m) I e r x‖ ≤ Lcost*C^I.card*rate A m per:=by
  let H:=WilsonVacuumPreResetFiniteHeatWindow.horizon E (r+2*mass k I)
  obtain ⟨up,M,mp,d,prior⟩:=WilsonPointChildCenteredReentry.original G D k E H
  obtain ⟨low,B₀,b₀,w,run⟩:=WilsonVacuumPreResetMarkedFiledAtRun.original G D I k E e r he
  let fare(F:Gear G):=max (up F) (low F)
  refine ⟨fare,M,mp,d,B₀,b₀,?_⟩
  intro R simple booked enrolled quiet cash buy salary u depth o tags η eta
  let A:=R.family.path.levels
  have first:=salary.mono (fun j cap F=>(le_max_left ..).trans (cap F))
  obtain ⟨j₁,submitted⟩:=eventually_atTop.mp (prior R simple booked enrolled quiet cash buy first u depth o tags η eta)
  obtain ⟨j₂,teacher⟩:=eventually_atTop.mp (quiet E)
  filter_upwards [eventually_ge_atTop (max j₁ j₂),salary,WilsonMarkedIndependentNormalizedScale.original A simple w,
    WilsonVacuumPreResetFiniteHeatScale.clock A simple,
    FundedMarkedCoverRows.realm R simple cash buy 0 (fun _=>0) (fun _=>1) (fun _=>by decide) E 0 0]
    with m late fund scale clock elected
  obtain ⟨Q,draws,measured,ticks,origin,_,_,_,stored⟩:=elected
  intro N B per live newLive d₁ d₂ v₁ v₂ T y z L O n f α β K a b A₀ C fits
  have hq:Q.anchor ≤ m:=origin.le
  let F:=(Q.mint m hq).gear
  have price:low F ≤ Q.cash Credit.leanC m:=(le_max_right ..).trans ((fund F).trans (stored m le_rfl hq).2.2)
  have old:=submitted (m+1) (by omega) N B per live newLive d₁ d₂ v₁ v₂ T I y z fits
  obtain ⟨_,_,_,_,vac⟩:=teacher (m+1) (by omega)
  have less:WilsonVacuumPreResetFiniteHeatScale.rate A (m+1) per ≤ rate A (m+1) per:=by
    apply Real.exp_le_exp.mpr
    change -((A.S.side (m+1) per).val:ℝ)/(16*zz A (m+1)) ≤ -((A.S.side (m+1) per).val:ℝ)/(4096*zz A (m+1))
    have pos:=clock.2.1
    field_simp [show zz A (m+1)≠0 by linarith]
    have fact:(0:ℝ) ≤ (A.S.side (m+1) per).val:=by positivity
    nlinarith
  have small:rate A (m+1) per ≤ 1:=Real.exp_le_one_iff.mpr (div_nonpos_of_nonpos_of_nonneg
    (by exact neg_nonpos.mpr (Nat.cast_nonneg _)) (mul_nonneg (by norm_num) clock.2.1.le))
  have billed:=run R Q m hq draws measured ticks price N per (by omega) ((vac N per (by omega)).1)
    (rate A (m+1) per) less small K old.1 (fun _=>C) (fun _=>zero_lt_one.trans_le old.2.2.1) old.2.2.2
  have positive:0 ≤ gross (zz A m) f:=mul_nonneg (zero_le_one.trans clock.1) (by positivity)
  have absorp:(gross (zz A m) f)^w*rate A (m+1) per ≤ rate A m per:=by
    refine (mul_le_mul_of_nonneg_left (le_add_of_nonneg_right (Real.exp_pos _).le) (pow_nonneg positive w)).trans (scale per)
  have wave:weights (fun _:ι=>C) I=C^I.card:=by simp [weights]
  refine ⟨old.1,old.2.1,fun x=>?_⟩
  calc
    _ ≤ B₀*(gross (zz A m) f)^w*weights (fun _=>C) I*rate A (m+1) per:=billed x
    _=B₀*C^I.card*((gross (zz A m) f)^w*rate A (m+1) per):=by rw [wave];ring
    _ ≤ _:=mul_le_mul_of_nonneg_left absorp (mul_nonneg b₀ (pow_nonneg (zero_le_one.trans old.2.2.1) _))

end YM.Integration.WilsonPointChildCenteredSuccessor
