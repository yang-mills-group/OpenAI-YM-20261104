/-- The original physical sheet of one selected set of funded constituents, with all its child digits. -/
def reading {G:Gauge}{n:ℕ}{D:Fin n→ℕ}{I:Type}[Fintype I][DecidableEq I]
    (R:Run G)(N i per q d:ℕ)(k:Fin n→ℕ)(old:Outerm G D)
    (words:I→Finset (Fin n))(c:I→Fin n)(site:Fin n → Cover)(t:Case D)(address:I→Site (fine R i per))
    (choose:∀J:Finset I,J.Nonempty→J)(u:Finset I)(v:Stationary.Link G (coarse R i per)):ℂ:=
  if hu:u.Nonempty then
    let stages:=loose (levels R) i
    let digit:=fun l:I=>(Ratio.mk stages.L (step R i per).sizes:Ratio (coarse R i per) (fine R i per)).residue (address l)
    let seats:=WilsonNeutralTwoPrintPathFineFiber.seats stages (step R i per).sizes dvd_rfl dvd_rfl u address
      (fun _=>central (fine R i per)) (choose u hu)
    let ranks:=fun l:I=>mass k (words l)
    let prior:=program (k:=k) old q words c (fun _=>site) (fun _=>t)
    let lower:=spent R ranks N i q (coarse R i per) prior seats digit u
    Complex.ofReal (diagonal (mass ranks u+d) (fun a z=>touch (@WilsonReceivedDepositedOrbitalFixedMoments.reading I)
      u (lower d a z)) ((coordinates G (coarse R i per)) v))
  else 0

end YM.Integration.WilsonOriginalCensusFiniteLedger
