local notation "claim₀" obs:max tab:max => WilsonThermometerRegisteredCenteredInvoice.properInvoice obs tab
local notation "fieldAt" obs:max tab:max U:max => ((incoming R A simple cut.le o U)*(claim₀ obs tab)).part full/((Ψ i).eval U:ℂ)

def older (J:Voice G) (axes:Lattice.Order) (q:ℕ) (obs tab:Poly J₃)
    (b h:Coefficient F₀ (R.family.side i per)) (U:Config G (R.family.side i per)):ℂ:=
  ((paperₚ J axes q U)*(claim₀ obs tab)).part full+
    ((damping obs tab:ℂ)*account h (Ψ i) U+(1-(damping obs tab:ℂ))*account b (Ψ i) U)/((Ψ i).eval U:ℂ)

local notation "before₀" J:max axes:max q:max obs:max tab:max b:max h:max =>
  older R A simple cut o hk D bank π Γ Ψ books hi ahead order shelf seats P J axes q obs tab b h

open private proper_unit from YM.Integration.WilsonThermometerRegisteredCenteredInvoice
open WilsonThermometerCenteredScalar

include course hi checks unit station refs in
theorem observation (J:Voice G) (axes:Lattice.Order) (q:ℕ) (obs tab:Poly J₃)
    (sameFiber:obs=measured R A z₀ o.origin) (normalized:tab.part (J₃).quiet=1)
    (b h:Coefficient F₀ (R.family.side i per)) {M:ℝ} (env:RG.Envelope (diff₀ J axes q obs tab b h))
    (paid:(∫U,‖actualTransport R.family (N:=N) (diff₀ J axes q obs tab b h) (le_refl i) U‖ ∂μ₀)≤M):
    Integrable (before₀ J axes q obs tab b h) (μ₀) ∧
      ‖(read (Extra.Trajectories.connected obs) univ-read (Extra.Trajectories.connected tab) univ)-
        ((∫U,(before₀ J axes q obs tab b h) U ∂μ₀)-(tab*(claim₀ obs tab)).part full)‖≤M:=by
  let submitted₀:=inverseMass (claim₀ obs tab)
  have proper:=WilsonThermometerRegisteredSingletonCenter.twice _ (proper_unit obs tab normalized)
  have measuredRead:=WilsonThermometerRegisteredAncestralProperMeasured.at_measure R A simple cut o π Γ Ψ course hi checks unit station refs submitted₀ full
  have raw:Integrable (fun U=>fieldAt obs tab U) (μ₀) ∧
      (obs*(claim₀ obs tab)).part full=∫U,fieldAt obs tab U ∂μ₀:=by
    have raw₂: (measured R A z₀ o.origin*(claim₀ obs tab)).part full=∫U,fieldAt obs tab U ∂μ₀:=by
      simpa only [total,submitted₀,proper] using measuredRead.2
    refine ⟨?_,(congrArg (fun Y:Poly J₃=>(Y*(claim₀ obs tab)).part full) sameFiber).trans raw₂⟩
    simpa only [total,submitted₀,proper] using measuredRead.1
  haveI:IsProbabilityMeasure (μ₀):=OPE.Therm.probability (H:=R.family.path) (p:=per) R.makes.wilson cut.le
  have IX:Integrable (diff₀ J axes q obs tab b h) (μ₀):=Integrable.of_bound env.meas.aestronglyMeasurable env.cost.choose
      (ae_of_all _ env.cost.choose_spec)
  have eq:(fun U=>fieldAt obs tab U)-(before₀ J axes q obs tab b h)=(diff₀ J axes q obs tab b h):=by
    funext U
    dsimp only [Pi.sub_apply,older,WilsonThermometerRegisteredCenteredPrior.discrepancy]
    ring
  have back:(before₀ J axes q obs tab b h)=(fun U=>fieldAt obs tab U)-(diff₀ J axes q obs tab b h):=by rw [←eq];abel
  have Iy:Integrable (before₀ J axes q obs tab b h) (μ₀):=back ▸ raw.1.sub IX
  have mean:‖(obs*(claim₀ obs tab)).part full-∫U,(before₀ J axes q obs tab b h) U ∂μ₀‖≤M:=by
    rw [raw.2,←integral_sub raw.1 Iy]
    change ‖∫U,((fun U=>fieldAt obs tab U)-(before₀ J axes q obs tab b h)) U ∂μ₀‖≤M
    rw [eq]
    exact (norm_integral_le_integral_norm _).trans (by simpa only [actualTransport_base R.family R.makes cut.le] using paid)
  have actualUnit:obs.part (J₃).quiet=1:=sameFiber ▸ WilsonThermometerRegisteredCenteredConnectedTest.measured_unit R A checks unit z₀ station refs o.origin
  rw [WilsonThermometerRegisteredCenteredInvoice.proper obs tab actualUnit normalized,sub_mul]
  refine ⟨Iy,?_⟩
  change ‖((obs*(claim₀ obs tab)).part full-(tab*(claim₀ obs tab)).part full)-
    ((∫U,(before₀ J axes q obs tab b h) U ∂μ₀)-(tab*(claim₀ obs tab)).part full)‖≤M
  rw [show ∀ (x y c:ℂ),(x-c)-(y-c)=x-y by intros;ring]
  exact mean

end YM.Integration.WilsonThermometerRegisteredCenteredMeasured
