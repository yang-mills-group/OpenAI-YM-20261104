def Tariff (Y:CutsP H T p v C C C C)(m:ℕ)(arms:Fin (n+1)→SealR G)(α:Wilt arms)(X:Herit arms)(Q:SealR G)
    (C₀ C₁ C₂ first shape chron middle ledger pay thermal:Credit)(target u':ℕ)(x:Verse F)
    (Φ:Rarity D)(ψ χ:Rarity Q.D)(hΦ:ContDiff ℝ ∞ Φ.ψ.val)(hψ:ContDiff ℝ ∞ ψ.ψ.val)(hχ:ContDiff ℝ ∞ χ.ψ.val):Prop:=
    ∀(older:ℕ),Y.vesselsC.anchor ≤ older →  older ≤ Y.m →  ∀(Z:Q.Rider)(r δ₀ δ₁ DF:ℝ)(B:Fin (n+1) → ℝ),
      Clear Y.vesselsC arms Q α ψ older Y.m Y.ceilC m r δ₀ δ₁ DF B → 
    ∀(y gap out A:ℝ)(o:CellR)(w:Fin 0 → YForest G),Amplitude Φ A → ClearDay Φ χ gap → 0<gap → Φ.radius+|y|+1 ≤ out → χ.radius+|y|+1 ≤ out → 
      let T':=paceT Y.ax.S m Y.m
      let δ:=paceT Y.ax.S m Y.ceilC
      let ε:=paceT Y.ax.S Y.m Y.ceilC
      let S:=WilsonSeparatedPrefixMovingJointSpectrum.transformed ψ hψ
      let credited:=(5*radiusH Φ ε y)^4*A*frontPrice Y.vesselsC arms Q X Z first shape chron middle target older Y.m Y.ceilC m r δ₀ δ₁ DF B
      let near:=|bill Y Q C₀ C₁ C₂ Φ χ Z y gap out older|
      let cohorts:=allowance Y Q Z ledger pay thermal older u' out gap
      let joint:=salary Φ χ hΦ hχ*(∫ξ:Euclid,(1+‖ξ‖^(D+Q.D))*‖S ξ‖)
      let rows:=fun q=>tested Y Q Φ χ Z y o m older q x w S true
      (∀q ≤ e,Integrable (rows q))∧Heard e 0 T'
        ((T'^target)⁻¹*credited+(T'^(-((h:ℝ)+1/4))*δ^((h:ℝ)+1/4))*((near+cohorts)*joint))
        (fun q=>raw Y.vesselsC arms Q α ψ X Z Φ y o Y.m m Y.ceilC older Y.N q 0 w-∫ξ:Euclid,rows q ξ)

theorem original (M:Master H)(p:4<D)(pF:4<D')(u e:ℕ)(v:Rails 4 8 (u+16) e)
    (height4:4 ≤ height)(nearData:D ≤ seats)(farData:D' ≤ seats)(sensors:u+16 ≤ seats)(separated:31 ≤ seats)
    (paint:Rarity D)(ψ χ:Rarity D')(sm:ContDiff ℝ ∞ paint.ψ.val)(hψ:ContDiff ℝ ∞ ψ.ψ.val)(hχ:ContDiff ℝ ∞ χ.ψ.val)
    (collar:∀p q:Point4,paint.ψ.val p*ψ.ψ.val (q-p)=paint.ψ.val p*(χ.ψ.val q*ψ.ψ.val (q-p))):
    let Q:=BayV M 4 D' pF
    ∃S:𝓢(Euclid,ℂ),S=WilsonSeparatedPrefixMovingJointSpectrum.transformed ψ hψ ∧ (∀l:ℕ,Integrable (fun ξ:Euclid=>(1+‖ξ‖^l)*‖S ξ‖))∧
      ∃first shape chron middle ledger pay thermal capture C₀ C₁ C₂:Credit,∀(chart:ChartRatio G)(kernel:KernelChoices)(V:XSpace.Run)
      (menu:WilsonIndependentEvenPassport.Menu M chart kernel V e height seats j extra)
      (_grant:WilsonIndependentCutJoinPlate.Approved M chart kernel V e height seats j extra menu)
      (phase:4 ≤ j)(i:Requests menu.a),
      let wall:=WilsonIndependentExactPlate.M V menu.a i
      let cir:=WilsonIndependentExactPlate.S V menu.a menu.positive j phase
      ∃(A:Levels G)(base:ℕ),A.clock.kernel=kernel ∧
        (∀p:Page (WilsonIndependentExactPlate.M V menu.a),p.bindW=i→A.clock.J (base+(wall-p.downW))=cir.J p) ∧
        (∀f:Flap (WilsonIndependentExactPlate.M V menu.a),f.volW=i→∀per:ℕ,
          (A.clock.op (base+(wall-(f.offset+1))) per).patch=cir.pactP f) ∧
        (A.S.scale (base+wall)-A.S.scale (base+old V menu.a i.val)= -Real.log (V.step i.val).spacing) ∧
        ∃(book:ChorusLine H (M.T 4) p e C C C)(torch:Torch H (M.T 4) p v C C C),
          torch.L=book.arch ∧ book.arch.V.draws=A ∧ book.arch.V.paid=chart ∧ book.arch.V.anchor=base ∧
          (∀k₀ u₀:ℕ,∀v₀:Rails 4 k₀ u₀ e,k₀ ≤ seats → u₀ ≤ seats → ∃L:Torch H (M.T 4) p v₀ C C C,L.L=book.arch) ∧
          (∀z ≤ wall,book.arch.V.y (base+z)=menu.price ⟨i.val%menu.a,Nat.mod_lt _ menu.positive⟩) ∧
          Elected M book.arch.V height seats ∧
          let N:=base+wall
          let m:=base+old V menu.a i.val
          ∀(t s:ℕ),base ≤ t → t+s ≤ m → ∀(α:Wilt (inner M p))(X:Herit (inner M p))(B:Fin 2→ℝ)(Z:ℝ),
            PadRank book.arch.V (t+s) m Z → Bough (inner M p) α (paceT A.S m (t+s)) Z B →
            let genuine:=AutumnDay A chart α X m (t+s) N D
            ∃Y:CutsP H (M.T 4) p v C C C C,
              Y.L=torch ∧ Y.L'=book ∧ Y.vesselsC=book.arch.V ∧ Y.N=N ∧ Y.m=t ∧ Y.i=s ∧ Y.pt=genuine ∧
              Y.fuel=max 0 (capture.buy Z*∏i,B i*fee ((inner M p) i) e (X i)) ∧
              Reports A chart (M.T 4) p α X m (t+s) t N 8=
                (paceT A.S m (t+s))^4 • steep A chart (M.T 4) p N (t+s) (m-(t+s)) Y.tileP ∧
              Y.springP s=genuine-Shrine Y.Ntop Y.tileP ∧ Paid Y Q C₀ C₁ C₂ ∧
              Landed Y m (inner M p) α X Q paint ψ χ S ∧
              Earned Y m (inner M p) α X Q C₀ C₁ C₂ paint ψ χ S (Reports A chart (M.T 4) p α X m (t+s) t N 8) (salary paint χ sm hχ) ∧
              Tariff Y m (inner M p) α X Q C₀ C₁ C₂ first shape chron middle ledger pay thermal 5 0
                (Reports A chart (M.T 4) p α X m (t+s) t N 8) paint ψ χ sm hψ hχ:=by
  intro Q
  have near (i:Fin 2):Named M height seats ((inner M p) i):=⟨height4,nearData,rfl⟩
  have far:Named M height seats Q:=⟨height4,farData,rfl⟩
  have rank:capP (inner M p)=8:=ranks M p
  have grade:Q.h=4:=rfl
  obtain ⟨first,shape,chron,middle,ledger,pay,thermal,full⟩:=WilsonSeparatedPrefixMovingPinnedPupil.original M p (M.T 4) (inner M p) Q v 0 5 (by decide)
    near far rank.le (by rw [grade];decide)
    (by rw [grade,rank];exact separated) (by rw [grade];omega)
  obtain ⟨S,named,booked,capture,C₀,C₁,C₂,issued⟩:=WilsonMovingForkSharpNamedPlate.original M p pF u e v height4 nearData farData sensors paint ψ χ sm hψ hχ collar
  refine ⟨S,named,booked,first,shape,chron,middle,ledger,pay,thermal,capture,C₀,C₁,C₂,?_⟩
  intro chart kernel V menu grant phase i wall cir
  obtain ⟨A,base,draws,bookJ,patches,width,book,torch,shared,draw,coins,anchor,lessons,wages,sold,training⟩:=issued chart kernel V menu grant phase i
  refine ⟨A,base,draws,bookJ,patches,width,book,torch,shared,draw,coins,anchor,lessons,wages,sold,?_⟩
  intro N m t s start formed α X B Z clock school genuine
  obtain ⟨Y,hl,hv,R,rN,rt,rs,rawY,wage,report,stable,paid,landed,fees⟩:=training t s start formed α X B Z clock school
  have top:m ≤ N:=by
    change base+old V menu.a i.val ≤ base+WilsonIndependentEvenPassport.count V menu.a i.val
    unfold WilsonIndependentEvenPassport.count
    omega
  have realized:Elected M Y.vesselsC height seats:=R.symm ▸ sold
  have ax:Y.ax=A:=by change Y.vesselsC.draws=A;rw [R,draw]
  have tx:Y.tx=chart:=by change Y.vesselsC.paid=chart;rw [R,coins]
  have b:Y.ceilC=t+s:=by change Y.m+Y.i=t+s;rw [rt,rs]
  have filed:=full Y realized C₀ C₁ C₂ paid m α X (Reports A chart (M.T 4) p α X m (t+s) t N 8)
    (b ▸ formed) (rN ▸ top) (by simpa only [ax,tx,rN,b] using report)
    (by simpa only [ax,tx,rN,b] using rawY) paint ψ χ sm hψ hχ collar
  exact ⟨Y,hl,hv,R,rN,rt,rs,rawY,wage,report,stable,paid,landed,fees,filed⟩
end YM.Integration.WilsonSeparatedPrefixMovingPinned44
