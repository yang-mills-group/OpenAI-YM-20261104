theorem original (run:Run G)(W:Initialize G)(p:4<D)(pF:4<D')(u e:ℕ)(v:Rails 4 8 (u+16) e)
    (height4:4 ≤ height)(nearData:D ≤ seats)(farData:D' ≤ seats)(sensors:u+16 ≤ seats)(separated:31 ≤ seats):
    let M:=publicFrame run
    let Q:=BayV M 4 D' pF
    M.T 4=sectionAt run W false 4 ∧
    ∃capture C₀ C₁ C₂ first shape chron middle ledger pay thermal C₃ C₄ port folds:Credit,
      ∀(torch:Torch (hol G) (M.T 4) p v C C C)(choir:ChorusLine (hol G) (M.T 4) p e C C C),choir.arch=torch.L →
      let R:=torch.L.V
      Elected M R height seats → ∀(t m N:ℕ),R.anchor ≤ t → t ≤ m → m ≤ N →
      ∀(α:Wilt (inner M p))(X:Herit (inner M p))(B:Fin 2→ℝ)(Z:ℝ),
      PadRank R m m Z → Bough (inner M p) α (paceT R.draws.S m m) Z B →
      let x:=Reports R.draws R.paid (M.T 4) p α X m m t N 8
      let genuine:=AutumnDay R.draws R.paid α X m m N D
      ∃Y:CutsP (hol G) (M.T 4) p v C C C C,
        Y.L=torch ∧ Y.L'=choir ∧ Y.vesselsC=R ∧ Y.N=N ∧ Y.m=t ∧ Y.i=m-t ∧ Y.ceilC=m ∧ Y.pt=genuine ∧
        Y.fuel=max 0 (capture.buy Z*∏i,B i*fee ((inner M p) i) e (X i)) ∧
        x=(paceT R.draws.S m m)^4 • steep R.draws R.paid (M.T 4) p N m (m-m) Y.tileP ∧
        Y.springP (m-t)=genuine-Shrine Y.Ntop Y.tileP ∧ Paid Y Q C₀ C₁ C₂ ∧
        ∀(Φ:Rarity D)(ψ χ:Rarity D')(hΦ:ContDiff ℝ ∞ Φ.ψ.val)(hψ:ContDiff ℝ ∞ ψ.ψ.val)(hχ:ContDiff ℝ ∞ χ.ψ.val),
        (∀s f:Point4,Φ.ψ.val s*ψ.ψ.val (f-s)=Φ.ψ.val s*(χ.ψ.val f*ψ.ψ.val (f-s))) →
          Tariff Y m (inner M p) α X Q C₀ C₁ C₂ first shape chron middle ledger pay thermal 5 0 x Φ ψ χ hΦ hψ hχ ∧
          WilsonMovingForkSharpReportedPortfolio.Approved Y m (inner M p) Q α X C₀ C₁ C₂ first shape chron middle ledger pay thermal
            C₃ C₄ port folds x Φ ψ χ hΦ hψ hχ ∧
          WilsonMovingForkSharpBilledRaw.Issued Y m (inner M p) Q α X C₀ C₁ C₂ first shape chron middle ledger pay thermal
            C₃ C₄ port folds Φ ψ χ hΦ hψ hχ:=by
  intro M Q
  have near (i:Fin 2):Named M height seats ((inner M p) i):=⟨height4,nearData,rfl⟩
  have far:Named M height seats Q:=⟨height4,farData,rfl⟩
  have rank:capP (inner M p)=8:=ranks M p
  have grade:Q.h=4:=rfl
  obtain ⟨capture,C₀,C₁,C₂,issue⟩:=WilsonMovingForkSharpMaster.original M p (inner M p) Q 16 u e v
    (by change (16:ℕ)=4+4+8;decide) (by decide) rank.le near far (by omega) sensors
  obtain ⟨first,shape,chron,middle,ledger,pay,thermal,early⟩:=WilsonSeparatedPrefixMovingPinnedPupil.original M p (M.T 4) (inner M p) Q v 0 5 (by decide)
    near far rank.le (by rw [grade];decide)
    (by rw [grade,rank];exact separated) (by rw [grade];omega)
  obtain ⟨C₃,C₄,port,folds,late⟩:=WilsonMovingForkSharpBilledRaw.original (H:=hol G) p (M.T 4) v Q
  refine ⟨rfl,capture,C₀,C₁,C₂,first,shape,chron,middle,ledger,pay,thermal,C₃,C₄,port,folds,?_⟩
  intro torch choir same R sold t m N live entry top α X B Z gate fees x genuine
  have split:t+(m-t)=m:=by omega
  obtain ⟨Y,root,home,realm,last,initial,span,birth,fuel,stamp,stable,paid⟩:=
    issue torch choir same sold t (m-t) m N live split.le top α X B Z (split.symm ▸ gate) (split.symm ▸ fees)
  rw [split] at birth stamp stable
  have atDate:Y.ceilC=m:=by change Y.m+Y.i=m;rw [initial,span,split]
  have house:Elected M Y.vesselsC height seats:=realm.symm ▸ sold
  have ax:Y.ax=R.draws:=by change Y.vesselsC.draws=R.draws;rw [realm]
  have tx:Y.tx=R.paid:=by change Y.vesselsC.paid=R.paid;rw [realm]
  have upper:m ≤ Y.N:=last.symm ▸ top
  have filed:x=(paceT Y.ax.S m Y.ceilC)^4 • steep Y.ax Y.tx (M.T 4) p Y.N Y.ceilC (m-Y.ceilC) Y.tileP:=by
    rw [ax,tx,atDate,last];exact stamp
  have truth:Y.pt=AutumnDay Y.ax Y.tx α X m Y.ceilC Y.N D:=by rw [ax,tx,atDate,last];exact birth
  refine ⟨Y,root,home,realm,last,initial,span,atDate,birth,fuel,stamp,stable,paid,?_⟩
  intro Φ ψ χ hΦ hψ hχ collar
  have tariff:=early Y house C₀ C₁ C₂ paid m α X x atDate.le upper filed truth Φ ψ χ hΦ hψ hχ collar
  obtain ⟨_,⟨outside⟩⟩:=WilsonIndependentMovingRosterAllFineSeats.roster house (inner M p) Q near far
  have spring:SpringD Y.vesselsC (4+Q.h) 0 (Q.h+4+(0+5+2)) C:=by
    change SpringD Y.vesselsC 8 0 15 C
    exact house.spring 8 0 15 (by omega) (by omega) (by omega)
  have dorm:Dormitory Y.vesselsC (4+Q.h) 0 C:=house.dorm 8 0 (by omega) (by omega)
  exact ⟨tariff,late Y spring dorm outside m (inner M p) α X C₀ C₁ C₂ first shape chron middle ledger pay thermal x
    Φ ψ χ hΦ hψ hχ tariff upper filed⟩
end YM.Integration.WilsonMovingForkSharpRawResident
