theorem ordinary (simple:G.Simple)(r:ℕ)(through:r≤q):
    Order.ratio (physical r)=booked r (flatten U) (wage) (catalog):=by
  have nonzero:constantCoeff (vacuum)=1:=opening _ _ (flat_constant R N i per (by omega) F)
  have nz:(vacuum)≠0:=by
    intro empty
    rw [empty,map_zero] at nonzero
    exact zero_ne_one nonzero
  have done (s:Finset (Fin n)):Wick (Woods G (coarse R i per)) (Q₀) (raiseE (P)*((raised) s))=
      (vacuum)*((catalog) s):=by apply WilsonOriginalCensusPhysicalGaussian.settled <;> assumption
  have law:Equation (raised) (incoming):=by apply WilsonOriginalCensusPhysicalOrdinary.equation (Y:=Y) <;> assumption
  have blank:(catalog) ∅=1:=by
    apply mul_left_cancel₀ nz
    rw [mul_one]
    have erased:=done ∅
    rw [law.1,mul_one] at erased
    exact erased.symm
  rw [WilsonOriginalCensusPhysicalGaussian.raw R Y lo enrolled N X positive limit width per y t deep closed tickets
    old well hs base cover bound F x U tag r through,funext done]
  apply WilsonReceivedDepositedOrdinaryFactor.cancel _ _ _ _ _ (vacuum) nonzero blank
  intro j
  have ne:(J).quiet≠(J).fire j:=Ne.symm ((hot_iff_ne _).mp ⟨j,Finset.mem_singleton_self j⟩)
  simp [WilsonCapturedPrimaryWindingVerseRoster.coefficient,Poly.part_smul,Poly.part_send,ne]

include well hs base cover limit in
theorem cost (simple:G.Simple)(C:Cost):Equation (fun s=>redo C ((catalog) s)) (reading C):=by
  have help:Wellness k (submit old k q):=(WilsonReceivedCompactVerseEntrance.original old well hs base cover).2.1
  simp_rw [WilsonReceivedCanonicalSocketMist.reset R N i per (by omega) F (M) (help.level' y) _ t C simple]
  exact WindE (step R i per) F (upper R N i) (prediction R N i per) R.metals.O (covered R N i per)
    (M) C t (emera_far (levels R) simple R.alloy.B.ratio (by omega : i<N) (f)).1 R.alloy.B.ratio (help.level' y)

include well hs base cover limit in
theorem reset (simple:G.Simple)(C:Cost)(s:Finset (Fin n)):
    redo C ((reading 1) s)=(reading C) s:=by
  have start:Equation (catalog) (reading 1):=by
    have eqn:Equation (fun s=>redo 1 ((catalog) s)) (reading 1):=by apply cost <;> assumption
    simpa only [identity,RingHom.id_apply] using eqn
  have checked:Equation (fun s=>redo C ((catalog) s)) (reading C):=by
    apply cost <;> assumption
  exact congrFun (Equation.unique _ _ _ (start.mapKin (redo C)) checked) s

include well hs base cover bound in
theorem connected (simple:G.Simple)(r:ℕ)(through:r≤q):
    Order.logMarked (physical r)=booked r (flatten U) (wage) (reading 1):=by
  have law:Equation (fun s=>redo 1 ((catalog) s)) (reading 1):=by apply cost <;> assumption
  have live:Equation (catalog) (reading 1):=by simpa only [identity,RingHom.id_apply] using law
  unfold Order.logMarked
  rw [ordinary R Y lo enrolled N X positive limit width per y t deep closed tickets old well hs base cover bound F x U tag simple r through]
  exact WilsonReceivedDepositedOrbitalGrade.logged r (flatten U) (wage) live

