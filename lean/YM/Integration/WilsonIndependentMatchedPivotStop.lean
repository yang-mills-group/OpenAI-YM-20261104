variable {G:Gauge}{h D k e u₀:ℕ}{F:Labels.Frame G h}{H:Hol G}{T:SectionData F}{p:h<D}
    {v:Rails h k u₀ e}{E W K U:Credit}

open WilsonIndependentMatchedCutBudget

open WilsonIndependentMatchedMixBudget WilsonIndependentMatchedPivotSeat
open WilsonIndependentMatchedProxyIncome

open WilsonIndependentEvenPassport (old count)

def Hearing (X:CutsP H T p v E W K U)(P Q:Era G ℝ)(i u:ℕ)(fee:ℝ):Prop:=
  let read:=cruises X.ax X.tx X.N (k+k) (X.m+X.i) i (agateV P Q)
  Flush e u 1 read fee ∧ ∀j ≤ e,∀z:Fin 0→YForest G,‖read.2 j 0 z‖≤fee

theorem issued (u base:ℕ)(s:Credit)(run:XSpace.Run)(B η:ℝ)(nonneg:0≤B)(small:0<η):
    ∀ᶠ idx:ℕ in atTop,∀(X:CutsP H T p v E W K U)(f:ℕ)(P Q:Era G ℝ)(A:ℝ),
    X.vesselsC.anchor=f → X.m=f+old run base idx → X.N=f+count run base idx →
    (∀ j ≤ old run base idx,X.vesselsC.y (f+j)≤B) → Dormitory X.vesselsC (k+k) u s →
    WilsonIndependentMatchedMixBudget.Priced u (field X P Q) (k+k) e A →
    ∀stop ≤ old run base idx,Hearing X P Q (f+stop) u ((run.step idx).spacing^(-η)*A):=by
  filter_upwards [WilsonOriginalPublicPlantedOlderJoin.original G (k+k) e u E s run base B η nonneg small]
    with idx paid X f P Q A origin report top house store received stop older
  have check:=paid X.vesselsC store f origin house stop (old run base idx) older le_rfl
    (field X P Q) received.1 A received.2
  have here:f+stop ≤ X.m:=report ▸ Nat.add_le_add_left older f
  have next:X.m ≤ X.m+X.i:=Nat.le_add_right _ _
  dsimp only at check
  rw [←report,←top] at check
  simp only [field,←cruisesMore X.ax X.tx (agateV P Q) here next] at check
  exact check

theorem original (u b base:ℕ)(w s:Credit)(run:XSpace.Run)(B₀ η:ℝ)(nonneg:0≤B₀)(small:0<η)
    (room:u+b ≤ u₀)(gap:1 ≤ (b:ℝ)-((h+h:ℕ):ℝ)-(1:ℝ)/4):
    ∀ᶠ idx:ℕ in atTop,∀(X:CutsP H T p v E W K U)(a:ℝ)(j:Alma F)(q:ℕ)(φ ψ:Rarity D)
    (y t z B D₀:ℝ)(o:CellR),let δ:=(run.step idx).spacing
    q ≤ e → ∀f:ℕ,X.vesselsC.anchor=f → X.m=f+old run base idx → X.N=f+count run base idx →
    (∀j ≤ old run base idx,X.vesselsC.y (f+j) ≤ B₀) →
    WilsonOriginalPublicPlantedStableCredit.span X X.i=-Real.log δ →
    SpringD X.vesselsC (k+k) u b w → Dormitory X.vesselsC (k+k) u s → Dormitory X.vesselsC (k+h) u s →
    0<t → ClearDay φ ψ t → radiusH φ 1 y ≤ z → radiusH ψ 1 y ≤ z →
    0 ≤ B → 0 ≤ D₀ → Amplitude φ B → Amplitude ψ D₀ →
    let A:=restored X a δ η;let C:=(tariff H T p e u b E W U).buy X.Age
    let P:=seat X a φ y o X.i;let F:=film X j q ψ y o X.i
    ∀stop ≤ old run base idx,
      Hearing X P F (f+stop) u (δ^(-η)*(WilsonIndependentMatchedCoverReception.rate k h e u b h h φ ψ
        y t z δ η A B C D₀*δ^(1/4:ℝ))) ∧
      Hearing X F P (f+stop) u (δ^(-η)*(WilsonIndependentMatchedCoverReception.rate h k e u b h h ψ φ
        y t z δ η C D₀ A B*δ^(1/4:ℝ))):=by
  filter_upwards [WilsonIndependentMatchedPivotBudget.original (H:=H) (T:=T) (p:=p) (v:=v)
      (E:=E) (W:=W) (K:=K) (U:=U) u b w s run B₀ η small room gap,
    issued (H:=H) (T:=T) (p:=p) (v:=v) (E:=E) (W:=W) (K:=K) (U:=U) u base s run B₀ η nonneg small]
    with idx pay late
  intro X a j q φ ψ y t z B D₀ o δ qe f origin report top house clock sale store both ht sep
    pcap qcap hB hD φpaid ψpaid A C P F₀ stop older
  have land:X.vesselsC.y X.m ≤ B₀:=report ▸ house _ le_rfl
  have first:=pay X a j q φ ψ y t z B D₀ o qe land clock sale both ht sep pcap qcap hB hD φpaid ψpaid
  exact ⟨late X f P F₀ _ origin report top house store first.1 stop older,
    late X f F₀ P _ origin report top house store first.2 stop older⟩

end YM.Integration.WilsonIndependentMatchedPivotStop
