theorem sourced (simple:G.Simple)(width travel:ℕ){ξ δ η:ℝ}(xp:0<ξ)(dp:0<δ)(ep:0<η):
    ∀ᶠv:ℕ in atTop,∀(D:Fin 3→ℕ)(p q start order N per K c w₀:ℕ)(opt:ℝ)
    (A₀:Group R.family 6)(_checked:A₀.station.checked ord hier A₀.horizon)(r:ℝ),
    A₀.station.wheel.r=r→v≤A₀.station.k→start≤A₀.station.k→∀(kK:A₀.station.k≤K),
    v≤w₀→w₀≤c→∀(ck:c≤K)(live:K<N),v+1≤K→8≤R.family.path.levels.clock.hatBeta K→
    R.family.S.a A₀.station.k/R.family.S.a K≤R.family.path.levels.clock.hatBeta A₀.station.k^width→
    R.family.S.a v/R.family.S.a K≤R.family.path.levels.clock.hatBeta v^travel→
    R.family.S.scale K-R.family.S.scale v≤opt*(1+Real.log (R.family.path.levels.clock.hatBeta (v+1)))→
    ∀(V:Realm G (p+1) Credit.leanC)(draw:V.draws=R.family.path.levels)(m C M:Fin 3→ℝ)
      (reg:Indexed R grade (fun _=>A₀.station.k) order η M (filed R A₀)),
      (∀i,0 ≤ m i)→(∀i,0≤C i)→(∀i,0≤M i)→(∀i,M i≤C i*(R.family.path.levels.clock.hatBeta K)^(m i))→
      Bought R D p (q+overhead R width ξ η δ m) start v N per K V draw opt δ→
      Hearing R D p q width ξ δ η m C A₀ r order M reg v N per K c w₀ V draw kK ck live:=by
  obtain ⟨age,unit⟩:=eventually_atTop.mp (WilsonOlderFreshSoftSocketStationUnits.original R simple width xp)
  filter_upwards [WilsonOlderFreshSoftSocketFigurePower.original R simple travel,eventually_ge_atTop age] with v restore older
  intro D p q start order N per K c w₀ opt A₀ checked r rr vk startk kK first second ck live away warm planted band span V draw m C M reg m0 C0 M0 salary bought
    t occupied y trial probe w
  let k:=A₀.station.k
  let θ:=regulatorRun R.family N per v
  let x:=regulatorRun R.family N per K
  let s:=Real.log x⁻¹
  let income (i:Fin 3):=(r/R.family.S.a K)^grade i
  let E:=rent R width ξ η m t
  let target:=q+overhead R width ξ η δ m
  have rpos:0<r:=rr ▸ A₀.station.wheel.rad
  have pos i:0 ≤ income i:=pow_nonneg (div_nonneg rpos.le (R.family.S.a_pos _).le) _
  have cash i:M i≤C i*Real.exp ((2*(3*m i/2))*s):=by
    have rate:=WilsonOlderFreshSoftSocketStationScale.heated R N per K live.le warm (m i) (m0 i)
    have h:2*(3*m i/2)=3*m i:=by ring
    rw [h]
    exact (salary i).trans (mul_le_mul_of_nonneg_left rate (C0 i))
  have edges:=unit A₀.station.k (older.trans vk) A₀.station.b checked.high.2 A₀.station.k K N per le_rfl kK live.le warm planted
  have inc i:income i≤Real.exp ((grade i:ℝ)*(3*((width:ℝ)+ξ))*s):=by
    change (r/R.family.S.a K)^_≤_
    rw [←rr]
    exact edges.2 (grade i)
  have heard:=bought t occupied (fun _=>k) (fun _=>startk)
    c w₀ first second ck live away (by linarith only [warm]) span A₀ order η M
    (fun _=>kK) reg ep.le M0 income (fun i=>3*m i/2) C (fun _=>3*(width:ℝ)) (fun _=>3*((width:ℝ)+ξ))
    y trial pos cash (fun _=>edges.1) inc
  have E0:0≤E:=by
    unfold E rent power
    apply Finset.sum_nonneg
    intro i _
    have mi:0 ≤ m (seat t i):=m0 _
    unfold WilsonOlderFreshSoftTrialPower.exposure
    positivity
  have spending:=restore N per K (vk.trans kK) live.le band E δ target q (add_nonneg E0 dp.le) (covers R width ξ η δ m q t)
  let b:=WilsonOlderFreshSoftTrialCharge.bill R grade (seat t) C
  let g:=fee R (grade ∘ seat t) (univ:Finset t)
  let h:=fixed R (D ∘ seat t) (grade ∘ seat t) p (univ:Finset t)
  have b0:0≤b:=by
    unfold b WilsonOlderFreshSoftTrialCharge.bill
    apply Finset.prod_nonneg
    intro i _
    unfold WilsonOlderFreshSoftTrialSalary.base WilsonOlderFreshSoftTrialSalary.wrap
    exact mul_nonneg (mul_nonneg (by norm_num) (by positivity)) (C0 _)
  have g0:0≤g:=sum_nonneg fun _ _=>prod_nonneg fun _ _=>sum_nonneg fun _ _=>norm_nonneg _
  have h0:0≤h:=WilsonOlderFreshSoftSocketOptical.fixed_nonneg R _ _ _ _
  have test0:0≤‖probe.test‖:=probe.test.opNorm_nonneg
  calc
    _≤(b*Real.exp (E*s))*(g*(θ^target*(‖probe.test‖*(h*x⁻¹^δ)))):=heard
    _=(b*g*h*‖probe.test‖)*(Real.exp (E*s)*(θ^target*x⁻¹^δ)):=by ring
    _≤_:=mul_le_mul_of_nonneg_left spending (by positivity)

theorem stopped (simple:G.Simple)(width:ℕ){ξ δ η τ:ℝ}(xp:0<ξ)(dp:0<δ)(ep:0<η):
    ∀ᶠv:ℕ in atTop,∀(D:Fin 3→ℕ)(p surface start order N per K c w:ℕ)(opt:ℝ)
    (A₀:Group R.family 6),A₀.station.checked ord hier A₀.horizon→∀r:ℝ,
    A₀.station.wheel.r=r→v≤A₀.station.k→start≤A₀.station.k→∀(kK:A₀.station.k≤K),
    v≤w→w≤c→∀(ck:c≤K)(live:K<N),v+1≤K→8≤R.family.path.levels.clock.hatBeta K→
    R.family.S.a A₀.station.k/R.family.S.a K≤R.family.path.levels.clock.hatBeta A₀.station.k^width→
    R.family.S.scale K-R.family.S.scale v≤opt*(1+Real.log (R.family.path.levels.clock.hatBeta (v+1)))→
    ∀(V:Realm G (p+1) Credit.leanC)(draw:V.draws=R.family.path.levels)(m C M:Fin 3→ℝ)
      (reg:Indexed R grade (fun _=>A₀.station.k) order η M (filed R A₀)),
      (∀i,0 ≤ m i)→(∀i,0≤C i)→(∀i,0≤M i)→(∀i,M i≤C i*(R.family.path.levels.clock.hatBeta K)^(m i))→
      R.family.S.a c/R.family.S.a w≤Real.exp (-(depth R width ξ η τ δ m surface)*Real.log (regulatorRun R.family N per K)⁻¹)→
      Covered R D p v start V draw opt τ→Paired R D p surface order η C A₀ r M reg v N per K c w V draw kK ck live:=by
  obtain ⟨age,unit⟩:=eventually_atTop.mp (WilsonOlderFreshSoftSocketStationUnits.original R simple width xp)
  filter_upwards [WilsonSeparatedPrefixKineticGeometry.spend R simple 1 0,eventually_ge_atTop age] with v cold older
  intro D p surface start order N per K c w opt A₀ checked r rr vk startk kK first second ck live away warm planted span
    V draw m C M reg m0 C0 M0 salary gap covered tests q cut φ g θ probes x paid Q F
  let s:=Real.log g⁻¹
  have rpos:0<r:=rr ▸ A₀.station.wheel.rad
  have gpos:0<g:=ActualRunKernelPackets.regulator_pos R N per K live.le
  have θpos:0<θ:=ActualRunKernelPackets.regulator_pos R N per v ((vk.trans kK).trans live.le)
  have θ1:|θ|≤1:=by
    rw [abs_of_pos θpos]
    apply (one_le_inv₀ θpos).mp
    simpa only [pow_zero,mul_one] using cold N per ((vk.trans kK).trans live.le)
  have pos i:0 ≤ paid i:=pow_nonneg (div_nonneg rpos.le (R.family.S.a_pos _).le) _
  have cash i:M i≤C i*Real.exp ((2*(3*m i/2))*s):=by
    have rate:=WilsonOlderFreshSoftSocketStationScale.heated R N per K live.le warm (m i) (m0 i)
    have h:2*(3*m i/2)=3*m i:=by ring
    rw [h]
    exact (salary i).trans (mul_le_mul_of_nonneg_left rate (C0 i))
  have edges:=unit A₀.station.k (older.trans vk) A₀.station.b checked.high.2 A₀.station.k K N per le_rfl kK live.le warm planted
  have inc i:paid i≤Real.exp ((grade i:ℝ)*(3*((width:ℝ)+ξ))*s):=by
    change (r/R.family.S.a K)^_≤_
    rw [←rr]
    exact edges.2 (grade i)
  have tall(t:Faces):rent R width ξ η m t+τ+(surface:ℝ)≤depth R width ξ η τ δ m surface/4:=by
    have pre:=WilsonOlderFreshSoftSocketStationSale.covers R width ξ η δ m 0 t
    simp only [Nat.cast_zero,zero_add] at pre
    unfold WilsonOlderFreshSoftSocketStationStops.depth
    linarith only [pre,dp]
  have earned:=covered A₀ (fun _=>A₀.station.k) (fun _=>startk) N per K c w order first second ck live away
    (by linarith only [warm]) span η M (fun _=>kK) reg ep.le M0 paid (fun i=>3*m i/2) C (fun _=>3*(width:ℝ))
    (fun _=>3*((width:ℝ)+ξ)) (depth R width ξ η τ δ m surface) surface pos C0 cash (fun _=>edges.1) inc gap
    (fun t _=>tall t) tests q cut θ θ1 φ r
  apply earned.trans_eq
  change (∑ y:Sites N per×Sites N per,‖WilsonThermometerAlignedCells.mass (R:=R) r (N,per) φ y‖*
    ∑t:Faces,‖WilsonMaxwellThermometerNominatedSecant.bill (actual R A₀ y) (Q y) t‖*fare R t C surface (Real.log g⁻¹))=_
  simp only [money R _ C surface gpos,Finset.sum_mul,mul_assoc]

