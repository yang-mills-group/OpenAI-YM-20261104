variable {G:Gauge}{n e:ℕ}{D k:Fin n→ℕ}(R:Run G){N per K c j:ℕ}
    {V:Realm G (e+1) Credit.leanC}{draw:V.draws=R.family.path.levels}
    (κ:(v:Fin n)→Knob (D v))(pt:Fin n→Chamber)(cells:Digits V.draws (Fin n))(seed:(v:Fin n)→Choice R k v)
    (y:Fin n → Cover)(t:Case D)
local notation "day" => j+1
local notation "path" => onLevels draw cells
local notation "L_" => R.family.path.levels
local notation "K₀" => Pert.Asymptotics.regulatorRun R.family N per K
local notation "A₀" => kinetic (L_) R.metals.O N K (day)
local notation "wage₀" => WilsonReportingAbsoluteInletForecastBooks.mass
local notation "branch" => address (L_) (path) (c-(day)) (day) y
local notation "Z₀" S:max => stopped R k N K c (day) (path) (branch) S (touch t S)
  (WilsonReceivedCanonicalVerseRegister.start R k κ pt seed)
local notation "H₀" S:max => stopped R k N K c (day) (path) (branch) S (touch t S) (raw R k κ pt seed)
local notation "normal₀" x:max g:max p:max S:max => whole (R:=R) (N:=N) (K:=K) (c:=c) (j:=j) (draw:=draw)
  κ pt cells seed y t x (g:ℂ) p S

def marked (x:Fin n→ℂ)(S:Finset (Fin n)):ℂ:=∏v∈S,x v

def gross (x:Fin n→ℂ)(θ:ℝ)(p:ℕ)(S:Finset (Fin n)):ℂ:=
  marked x S*Complex.ofReal (((K₀)^(degree R k S seed))⁻¹*flat (H₀ S) p θ)

def price (θ:ℝ)(p:ℕ)(S:Finset (Fin n)):ℝ:=
  let h:=degree R k S seed
  ((K₀)^h)⁻¹*(θ^(p+1)*((h:ℝ)+2)*(wage₀ p (A₀))^h+
    |(θ*value p (A₀) θ)^h-(K₀)^h|)*wage₀ p (coin (Z₀ S))

theorem normalized (x:Fin n→ℂ)(θ:ℝ)(p:ℕ)(S:Finset (Fin n)):
    (normal₀ x θ p S)=marked x S*Complex.ofReal (flat (Z₀ S) p θ):=by
  unfold whole flat WilsonOlderFreshTerminalProgramme.series
  change ∑a∈range (p+1),(θ:ℂ)^a*((∏v∈S,x v)*Complex.ofReal ((Z₀ S).2 a 0 Fin.elim0))=_
  rw [Complex.ofReal_sum,Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro a _
  rw [Complex.ofReal_mul,Complex.ofReal_pow]
  unfold marked
  ring

theorem original (simple:G.Simple)(ratio:LocalRatio R.metals.O)(vc:day≤c)(ck:c≤K)(live:K≤N)
    (x:Fin n→ℂ)(p:ℕ)(S:Finset (Fin n))(kept:degree R k S seed≤p){θ:ℝ}(θ0:0≤θ)(θ1:θ≤1):
    ‖gross R (N:=N) (per:=per) (K:=K) (c:=c) (j:=j) (draw:=draw) κ pt cells seed y t x θ p S-
      (normal₀ x θ p S)‖≤‖marked x S‖*price R (N:=N) (per:=per) (K:=K) (c:=c) (j:=j) (draw:=draw)
        κ pt cells seed y t θ p S:=by
  have paid:=WilsonOlderFreshSoftSocketRestored.original R k κ pt simple ratio N per K c (day) (path) S
    vc ck live (branch) (touch t S) seed p kept θ0 θ1
  change |((K₀)^(degree R k S seed))⁻¹*flat (H₀ S) p θ-flat (Z₀ S) p θ|≤
    price R (N:=N) (per:=per) (K:=K) (c:=c) (j:=j) (draw:=draw) κ pt cells seed y t θ p S at paid
  rw [normalized (draw:=draw),gross,←mul_sub,←Complex.ofReal_sub,norm_mul,Complex.norm_real,Real.norm_eq_abs]
  exact mul_le_mul_of_nonneg_left paid (norm_nonneg _)

