variable {G:Gauge}{n e:ℕ}{D k:Fin n→ℕ}{R:Run G}{N K c j:ℕ}
    {V:Realm G (e+1) Credit.leanC}{draw:V.draws=R.family.path.levels}{rate δ σ:ℝ}
    (κ:(v:Fin n)→Knob (D v))(pt:Fin n→Chamber)(cells:Digits V.draws (Fin n))(seed:(v:Fin n)→Choice R k v)
    (y:Fin n → Cover)(t:Case D)
local notation "atDate" => j+1
local notation "path" => onLevels draw cells
local notation "bank" => fixed R k κ pt N K c (path) seed
local notation "L_" => R.family.path.levels
local notation "I" => Hot (Stock.census (Fin n))

def whole (x:Fin n→ℂ)(g:ℂ)(p:ℕ)(S:Finset (Fin n)):ℂ:=
  let branch:=address (L_) (path) (c-(atDate)) (atDate) y
  let carried:=cruises (L_) R.metals.O N (mass k S) c (atDate)
    (tuftV (touch t S) (levelsO ((bank) branch) S))
  ∑a∈range (p+1),g^a*((∏v∈S,x v)*Complex.ofReal (carried.2 a 0 Fin.elim0))

theorem original (simple:G.Simple)(vc:atDate≤c)(ck:c≤K)(kn:K≤N)
    (funded:Submitted R V draw D k N K j rate δ σ)(side:Side)
    (positive:∀z:I,0 < mass k ((binder side y) z).mode.val):
    ∃H:Material R N (atDate) e k σ (binder side y),
      H.realm=V ∧ H.tests=D ∧ H.amplitude=rate ∧ H.allowance=δ ∧
      (∀[Fintype (I)](x:Affinity.Wallet (WilsonOriginalMixedBlockRows.room (Fin n)))(s:(Stock.census (Fin n)).Mode),
        WilsonOriginalCensusDatedHeldTariff.salary H x s=(WilsonIndependentCollarLowerMass.copies (binder side y) s:ℝ)*
          (‖∏v∈s.val,(x v).val‖*‖touch t s.val‖)) ∧
      (∀z,Real.exp (σ*((binder side y) z).length)*(1+∑r,(words H z).fare r)≤WilsonReceivedDepositedOrbitalBudget.amount H z) ∧
      ∀(x:Fin n→ℂ)(g:ℂ)(p:ℕ),p≤e→∀(S:Finset (Fin n)),
        (crop (fun z:I=>((binder side y) z).mode) (cash H x) g p).part (seat S)=
          whole (R:=R) (N:=N) (K:=K) (c:=c) (j:=j) (draw:=draw) κ pt cells seed y t x g p S:=by
  obtain ⟨H,realm,axis,gross,rent,pins,roots,tests,frills,salary,banked,expense⟩:=
    funded cells κ pt seed (I) side (port side y) (binder side y) pin
      (fun z=>z.property.choose_spec) positive y t
  refine ⟨H,realm,axis,gross,rent,salary,expense,?_⟩
  subst D
  intro x g p order S
  have named w U:=eq_of_heq (banked w U)
  have supplied:=WilsonOriginalTwoFlatIRFlatMeasured.original H κ pt K (path) seed x t simple (vc.trans ck) kn
    named (fun z=>eq_of_heq (tests z)) pins roots frills g p order S
  rw [supplied,WilsonOriginalTwoFlatIRFlatMeasured.reading,whole]
  apply sum_congr rfl
  intro a _
  rw [WilsonOriginalTwoFlatIRFlatFinanced.coeff,WilsonOriginalTwoFlatIRFlatSeries.value]
  have deposited:=continued κ pt (path) seed simple vc ck kn S (touch t S) y
  exact congrArg (fun P:Era G ℝ=>g^a*((∏v∈S,x v)*Complex.ofReal (P.2 a 0 Fin.elim0))) deposited

end YM.Integration.WilsonOriginalTwoFlatIRFlatEarned
