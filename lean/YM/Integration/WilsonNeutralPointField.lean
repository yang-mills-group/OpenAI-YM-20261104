variable {Df kept:ℕ}(color:hue G)(pad:d<Df){U:ℕ→ℕ}(grant:WilsonWindowFormalPurchase.Canonical U R.kit)
    {passport:Earn.Passport (R.family.side ((j+1)+1) per) Unit}(S:Earn.Binder passport (Stock.census Unit))
    {σ:ℝ}(T:WilsonOlderFreshGraphSlate.Copy G d kept σ)
    (b:Letter (R.family.labels.level d))(f:Studio Df)(digit:∀j,Site (R.family.S.block j))

include grant file course cut pass month fits narrow in
theorem original (id:P.passport=passport)(names:P.modelIndex=T.Roster)(rows:HEq P.model (T.rows S actors))
    (cap:∀t,‖WilsonOlderFreshGraphArmada.value actors t‖≤1)(width:0<σ)
    (published:WilsonOlderFreshPointCommission.Published R wood color pad ((j+1)+1) b (WilsonPointChildFiledPress.Tour.mk N cut digit,f) T)
    (hs:G.Simple)(o:Loc G 1)(v:ℕ→Gear G→ℝ)(funded:FundedMarkedCoverRows.prices v R.kit)
    (paths:FundedOriginalVacuumPaths.prices R.kit)
    (opening:WilsonOriginalPrimerPostCover.opening R hs v funded paths k ≤ m)
    (path:PlanV.Path D R.alloy Q (Burn.horizon k) N m π Γ)
    (working:kept≤order)(hd:d≤(V₀).clock.J ((j+1)+1))

    (e:ℕ)(he:e≤kept)(B:Stationary.Link G grid)
    (base:Site grid)(φ₀:Studio Df)
    (center:S.center=((V₀).clock.op (j+1) per).ratio.assemble (base,(digit (j+1))))
    (tested:f=Dawn.throughW (digit (j+1)) Df (Elm.growL (V₀) (j+1)) φ₀):
    (((V₀).S.block (j+1)).val:ℂ)^d *
      (peek dvd_rfl L.model (fun _=>d) (π (j+1)) tape₀ x e B).part (submitted S).val =
      WilsonOlderFreshGraphArmada.value actors x * (MvPolynomial.eval
        (FreeResolvent.flatten (Stationary.arm G grid 1 B) ∘ Lotus.tint base)
          (coeff e (WilsonOlderFreshPointConvolution.after (N:=N) (i:=j+1) R wood color pad digit b φ₀ grid)):ℝ):=by
  have lower:=WilsonNeutralPointPosition.original R hk D Q π Γ Ψ books ahead actors pieces order shelf seats floor
    physical P L file course cut pass month fits narrow x color pad grant S T b f digit id names rows cap width published
    hs o v funded paths opening path working hd e he B base φ₀ center tested
  have column:=WilsonNeutralPointBanner.original R wood color pad digit grant N (j+1) hs o cut hd b φ₀ grid
  dsimp only at column lower
  rw [lower,WilsonOlderFreshPointConvolution.after,column,PowerSeries.coeff_C_mul]
  simp only [map_mul,MvPolynomial.eval_C,Complex.ofReal_mul,Complex.ofReal_pow,Complex.ofReal_natCast]
  ring

