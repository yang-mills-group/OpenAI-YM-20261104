private theorem separate (f l w b x a c d s t:ℝ)(pos:0≤f):
    l*tab b (x*(f*a)) ((|f*c|+f*d)*s)+w*(f*t)=f*(l*tab b (x*a) ((|c|+d)*s)+w*t):=by
  rw [abs_mul,abs_of_nonneg pos,show x*(f*a)=f*(x*a) by ring,
    show (f*|c|+f*d)*s=f*((|c|+d)*s) by ring,ruler b f _ _ pos]
  ring

theorem original (Y Y₀:CutsP H T p v C C C C)(m:ℕ)(arms:Fin (n+1)→SealR G)(Q:SealR G)(X:Herit arms)
    (C₀ C₁ C₂ first shape chron middle ledger pay thermal U₁ U₂ fund folds:Credit)(u':ℕ)
    (φ:Rarity D)(χ:Rarity Q.D)(hφ:ContDiff ℝ ∞ φ.ψ.val)(hχ:ContDiff ℝ ∞ χ.ψ.val)(S:𝓢(Euclid,ℂ))
    (older:ℕ)(r nearGap farGap DF:ℝ)(B:Fin (n+1)→ℝ)(y gap out A L bound:ℝ) (Z:Q.Rider)
    (j:(s:Fin (n+1))→Alma (arms s).F)(realm:Y.vesselsC=Y₀.vesselsC)
    (home:Y.m=Y₀.m)(capture:Y.ceilC=Y₀.ceilC)(income:Y.fuel=charge arms X e*Y₀.fuel):
    amount Y m arms Q X C₀ C₁ C₂ first shape chron middle ledger pay thermal U₁ U₂ fund folds u' φ χ hφ hχ S older r nearGap farGap DF B y gap out A L bound Z=
    charge arms X e*amount Y₀ m arms Q (center arms j) C₀ C₁ C₂ first shape chron middle ledger pay thermal U₁ U₂ fund folds u' φ χ hφ hχ S older r nearGap farGap DF B y gap out A L bound Z:=by
  have held:bill Y Q C₀ C₁ C₂ φ χ Z y gap out older=charge arms X e*bill Y₀ Q C₀ C₁ C₂ φ χ Z y gap out older:=by
    unfold WilsonSeparatedPrefixMovingJointRows.bill
    rw [realm,capture,income]
    ring
  have persistent:allowance Y Q Z ledger pay thermal older u' out gap=charge arms X e*allowance Y₀ Q Z ledger pay thermal older u' out gap:=by
    unfold WilsonMovingForkSharpBudget.allowance
    rw [realm,capture,income]
    ring
  have annulus:limits Y Q e u' 5 U₁ U₂ fund folds φ χ hφ hχ Z older e out gap S=
      charge arms X e*limits Y₀ Q e u' 5 U₁ U₂ fund folds φ χ hφ hχ Z older e out gap S:=by
    unfold WilsonMovingForkSharpPortfolioAnnulus.limits
    simp only [realm,capture,home,income]
    ring
  have axisDate:Y.ax=Y₀.ax:=congrArg (fun R:Realm G (e+1) C=>R.draws) realm
  dsimp only [amount]
  rw [WilsonMovingForkSharpNearIncome.front Y.vesselsC arms Q X j,held,persistent,annulus,realm,capture,home,axisDate]
  exact separate _ _ _ _ _ _ _ _ _ _ (WilsonMovingForkSharpNearIncome.nonneg arms X e)
