def gross (gain:ℕ)(V:Realm G (e+1) J)(X:Courts (H:=H) (v:=v))(φ:Wilt Q)(fees:Fin 2→ℝ)
    (y space:ℝ)(primary basal:Fin 2→Credit)(terminal:(Fin 2→Bool)→Credit)(m:ℕ):ℝ:=
  charge gain V X φ fees y space primary basal terminal m (fun _=>false)+
    2*fittedFee (X 0) (φ 0) (fees 0) y*fittedFee (X 1) (φ 1) (fees 1) y

theorem original (M:Master H)(Q:Fin 2→SealR G)(cap:capP Q=10)(v:∀i,Rails (Q i).h k u₀ e)
    (height seats gain:ℕ)(surplus:2 ≤ gain)(stage:2*k ≤ 10+gain)(room:10+gain ≤ seats)(width:10+gain ≤ u₀)(heat:1 ≤ e):
    ∃primary basal:Fin 2→Credit,∃terminal:(Fin 2→Bool)→Credit,
    ∀(V:Realm G (e+1) J),Elected M V height seats → ∀(X:Courts (H:=H) (v:=v))
    (m K N:ℕ),stamp V X m K N → V.anchor ≤ m → m ≤ K → K ≤ N → (∀i,On (Q i).h (X i).pt) →
    ∀(φ:Wilt Q)(fees:Fin 2→ℝ)(y space:ℝ),Bough Q φ y space fees → ∀(o:CellR)(ω:Fin 0→YForest G),
    ‖projected V X φ m K N y o ω‖ ≤ gross gain V X φ fees y space primary basal terminal m:=by
  obtain ⟨primary,basal,terminal,joint⟩:=WilsonOriginalObservedRoseBornChiralQuiet.original
    M Q cap v height seats gain surplus stage room width
  choose unary received using (fun i=>WilsonOriginalObservedRoseBornChiralProper.original H (Q i).ans (Q i).path (v i) J J J J)
  refine ⟨primary,basal,terminal,?_⟩
  intro V sale X m K N filed floor past live sound φ fees y space house o ω
  let B (i:Fin 2)(q:ℕ):=atGrade (receiving (X i) 1 (φ i) y o 0) q ω
  let F (i:Fin 2):=fittedFee (X i) (φ i) (fees i) y
  have got (i:Fin 2)(q:ℕ)(hq:q ≤ 1):‖B i q‖ ≤ F i:=
    (received i (X i) (φ i) (fees i) y o (sound i) (house.lanes i) q (hq.trans heat) ω).2.2
  have pair (q r:ℕ)(hq:q ≤ 1)(hr:r ≤ 1):‖B 0 q*B 1 r‖ ≤ F 0*F 1:=by
    rw [norm_mul]
    exact mul_le_mul (got 0 q hq) (got 1 r hr) (norm_nonneg _) ((norm_nonneg _).trans (got 0 q hq))
  let base:=atGrade (stopped V.draws V.paid Q φ (fun i=>home (Q i) (X i)) m K N m y o) 1 ω
  let bill:=charge gain V X φ fees y space primary basal terminal m (fun _=>false)
  have funded:‖base‖ ≤ bill:=joint V sale X m K N filed floor past live sound φ fees y space house o 1 heat ω
  change ‖base-B 0 0*B 1 1-B 0 1*B 1 0‖ ≤ bill+2*F 0*F 1
  calc
    _ ≤ ‖base‖+‖B 0 0*B 1 1‖+‖B 0 1*B 1 0‖ :=
      (norm_sub_le _ _).trans (add_le_add (norm_sub_le _ _) le_rfl)
    _ ≤ bill+F 0*F 1+F 0*F 1:=add_le_add (add_le_add funded (pair 0 1 (by decide) le_rfl)) (pair 1 0 le_rfl (by decide))
    _ = _ := by ring

end YM.Integration.WilsonOriginalObservedRoseBornChiralValue
