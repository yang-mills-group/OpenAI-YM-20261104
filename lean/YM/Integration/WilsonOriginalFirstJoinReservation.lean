  have bp:=budget_nonneg (U₀.suggests 0)
  have dp:0≤δ':=by obtain ⟨_,h_,_⟩:=hδ; exact budget_nonneg (h_.backed 0)
  have valid:=revenue.converted bp hvW
  let employee:=Classical.choice (Mentor.crew R D Q A F φ K0 h hE r u U.beta hβ' hm' R' hk hF rfl Yh)
  have rules:=Semester.grammar R D Q A F φ K0 h r K u M n₀ Vv X' Qa hF Yh Zj hk κr employee hδ
  let Hn B' := readyN R D Q A F φ K0 h hE r K u M w n₀ Vv X' hX Qa hF hU₁ Y' hw hq y (r₀:=2) (r₁:=1) B' Yh Zj hk κr hβ' hm' g hcZ; obtain ⟨U'⟩:=Semester.relates D A F u Yh uV
  obtain ⟨permit⟩:=Tint.Institute.dynamic M Y' w T hq y Yh Zj hβ₁ (Bx) employee.real
    p₀ R! Mk Θ U₀ valid hr hr' hO hK rules Hn
  let walked : Travel.Walk Yh R' (((F.scout Xz Yz).pair.strong tx U.beta)/8) tP tQ tW := by
