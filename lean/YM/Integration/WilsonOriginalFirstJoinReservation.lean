  (r:=r) (K:=K) (u:=u) (Actor:=Actor) (M:=M) (w:=w) (T:=T) (n₀:=n₀)
  (Vv:=Vv) (X':=X') (hX:=hX) (Qa:=Qa) (hF:=hF) (Y':=Y') (hq:=hq) (y:=y) (Yh:=Yh)
  (Zj:=Zj) (hk:=hk) (hc:=hc) (hs:=hs) (κr:=κr) (hκr:=hκr)
  (hβ':=hβ') (hm':=hm') (e':=e') (hδ:=hδ) (b':=b') (U₀:=U₀) (hvW:=hvW) (uV:=uV) T'.hard  := by
