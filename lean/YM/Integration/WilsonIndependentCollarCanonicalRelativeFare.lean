theorem original (F:Ptype)(B:voucher F)
    (receipt:WilsonOriginalCensusCanonicalFiledClock.Returns R hk D Q π Γ Ψ books hi op ahead d q hd o
      order shelf F B)
    {e:ℕ}{σ₀:ℝ}(L:Material R N i e d σ₀ (binder (coarse R i per) y))
    (active:Addressed y L (present L.tests))
    (pt:(Fin n)→Chamber)(x:Wallet (A))(s:Multi.Hot (marks))(u:s.val.val)
    (v:Stationary.Link G (coarse R i per))(r a:ℕ)(through:r≤order)(kept:a≤r)
    (tags:∀b:Covers R.family.path.levels.S i (coarse R i per),(step R i b.val).Choices)
    {orderCap breadthCap:ℕ}{ε:ℝ}(paid:WilsonIndependentCollarCanonicalRelativeMenu.Paid R d
      (fun j=>contact (L.tests j)) pt orderCap breadthCap (present L.tests) ε i per)
    (near:breadth s.val.val u.val 0 (relative s.val.val u.val y)≤breadthCap)
    (included:a≤orderCap)(unit:‖v‖≤1)
    (matched:∀z S,output L.prior S N z=fixed R d (fun j=>contact (L.tests j)) pt N (i+1) i cells q z S)
    {lowPort:Passport (coarse R i per) (Fin n)}{μ:Type}
    (low:μ→Row lowPort (Stock.census (Fin n)) G (Wallet (room (Fin n))))
    (lowPlaced:lowPort=port (coarse R i per) y)(lowNames:μ=((z:Multi.Hot (Stock.census (Fin n)))×(words L z).Roster))
    (lowInk:HEq low (mounts L)){lowW:Fin n→ℝ}{width expense:ℝ}{lowCap lowSeats lowShelf:ℕ}
    (lowPaid:Scene.Armada low lowW d width expense lowCap lowSeats lowShelf)(positive:0<width)
    (keptLow:a≤e):
    let issued:=file F B x
    let student₀:=Oak.student (n:=per) R hk D Q π Γ books hi issued.post.op issued.post.lesson ahead (A)
      issued.post.model issued.order issued.post.voter
    let restamp:=Mutation.stamp student₀ (Γ i) (Oak.grade0 R hk D Q π Γ hi issued.post.lesson)
      (Burn.horizon k+2) issued.order
    ‖(peek dvd_rfl restamp issued.grades (π i) (pay) issued.x a v).part s.val-
      (peek dvd_rfl low d (π i) (pay) x a v).part s.val‖≤‖∏j∈s.val.val,(x j).val‖*ε:=by
  intro issued student₀ restamp
  have high:=WilsonIndependentCollarCanonicalRelativeReading.original R simple hk D Q π Γ Ψ books hi
    cut op ahead d q hd y cells order shelf F B receipt L.tests pt x s u v r a through kept tags paid near
    included unit
  obtain ⟨_,_,seeds⟩:=WilsonReceivedCanonicalVerseRegister.original R d (fun j=>contact (L.tests j))
    pt orderCap (s:=1) zero_lt_one
  have ground:Wellness d (fixed R d (fun j=>contact (L.tests j)) pt N (i+1) i cells q):=
    WilsonReceivedFixedDigitHistory.sound R.family.path.levels R.metals.O d N cells simple
      R.alloy.B.ratio _ (seeds q).1 _ _ (by omega)
  have central:=WilsonIndependentCollarCanonicalLowPortrait.printed y L (present L.tests)
    (fun j=>contact (L.tests j)) pt (i+1) cells q x active ground s a v
  have authenticated:∀z S,WilsonReceivedCoverGrade.Same e (output L.prior S N z)
      (fixed R d (fun j=>contact (L.tests j)) pt N (i+1) i cells q z S):=by
    intro z S
    rw [matched z S]
    exact fun _ _=>rfl
  have lowRead:=WilsonOriginalCensusDatedSheets.original L (fun j=>contact (L.tests j)) pt (i+1)
    cells q x authenticated low lowPlaced lowNames lowInk lowPaid positive (π i) (pay) s a keptLow v
  rw [lowRead.1,central]
  exact high

