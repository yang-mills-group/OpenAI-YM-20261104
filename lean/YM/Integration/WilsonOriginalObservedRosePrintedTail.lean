theorem original (simple:G.Simple)(bliss:Bliss F l z H)(lead:Leading F Jr)
    (obedient:∀d:ℕ,∀ᶠr in trail,Frame.obedient F H (Jr r) d)
    (slow:WilsonWindowReportingPace.Slow R.kit)(shop:RG05Preconstruction.ReadoutPurchase R.b)
    (cap:∀j,1≤((P).budget j).supportExponent)(upper:∀j,((P).budget j).supportExponent≤100)
    (quote:OPE.Therm.Poetry (P))(color:G.ColorIndex)
    (funded:WilsonOriginalAllOrderCourse.Paid.{u} axis simple ε (prepared schedule) R crop W)
    (paths:FundedOriginalVacuumPaths.prices R.kit):
    ∃bank:ℕ,∀(target width:ℕ)(debt:Fin 3→ℕ),∃U:Set ℝ,U∈trail ∧
    let J₀:=cut (target+1) bank ((∑i,debt i)+1) width
    let lower:=J₀+9
    ∀L:ℕ,∀D:Fin 3→ℕ,(∀i,ages i<D i) → ∀(caps:Fin 3→ℝ)(opt tol:ℝ),0≤opt → 0<tol →
    ∃bottom:ℕ,∀Q:ℕ,lower≤Q → ∃start:ℕ,∀ᶠv:ℕ in atTop,
    ∃(V₀:Realm G (lower+1) Credit.leanC)(draw₀:V₀.draws=P),
    V₀.paid=R.metals.O ∧ V₀.y=zz P ∧ V₀.anchor=v ∧ Covered R D lower v bottom V₀ draw₀ opt tol ∧
    (∀s:Finset (Fin 3),s.Nonempty → Stock R D lower v bottom V₀ draw₀ opt tol s) ∧
    ∃(V:Realm G (Q+1) Credit.leanC)(draw:V.draws=P),
    V.paid=R.metals.O ∧ V.y=zz P ∧ V.anchor=v ∧ Covered R D Q v start V draw opt tol ∧
    (∀s:Finset (Fin 3),s.Nonempty → Stock R D Q v start V draw opt tol s) ∧
    ∀r∈U,∀{T:ℕ}(B:Book F (l:=l) H z 6 T r),WilsonMovingForkWindowBooks.Priced F B →
    ∀actual:Next.UVStress.Lifts (C) B.k,let K:=berth R width B.W.k
    v≤B.W.k → ∀(N per b c requested power tag:ℕ)(credit:ℝ)(bk:b≤K)(kn:K≤N),b<N →
    v≤c → c≤K → v+1≤K → σ K-σ v≤L*Real.log (β v) →
    let θ:=g N per v
    ∀(q₁:ℕ)(W:Realm G (q₁+1) Credit.leanC)(source:W.draws=(P))(first:ℕ),first+1≤v →
    ∀(file:Filed R ages K)(Φ:Test 3),
    let μ:=WilsonThermometerAlignedCells.mass (R:=R) r (b,per) Φ
    let Active:Type:={y:Site ((C).side b per) × Site ((C).side b per) // μ y≠0}
    ∀(panel:(o:Active)→{Z:Panel R ages N per b K bk kn requested power tag credit // Z.loc=atOrigin o.val}),
    (∀o,(panel o).val.slot=file.station) → (∀o,(panel o).val.axis=file.A N per) →
    (∀o i,(panel o).val.slot i=B.W.k) →
    (∀o i,(panel o).val.names i=WilsonNeutralOffsetCutoff.named R (group F Jr Z B actual) N per i) →
    ∀(κ:(i:Fin 3)→Knob (D i))(pt:Fin 3→Chamber)
      (test:Active→Case D),(∀o i,‖test o i‖≤caps i*(θ⁻¹)^debt i) →
    let filed o:=tape source bk (panel o).val.loc
    let cells o:=onLevels source (filed o)
    let pins o:=address (P) (cells o) (c-v) v (homes (V:=W) (filed o) 0 first (v-1-first))
    let w o:=votes R ages (N:=N) (per:=per) file (panel o).val.names (panel o).val.turn
    let row j o s:=figure R ages κ pt N per K c v (cells o) s (w o) (pins o) (touch (test o) s) j θ
    let hearing j:=∑o:Active,μ o.val*((r:ℂ)^14*value (row j o))
    ‖hearing Q-hearing lower‖≤(∫z:Points 3,‖Φ z‖)*θ^target:=by
  obtain ⟨bank,booked⟩:=WilsonOriginalObservedRosePrintedTouch.original F Jr Z simple bliss lead obedient slow shop cap upper quote color funded paths
  refine ⟨bank,?_⟩
  intro target width debt
  obtain ⟨U,active,cal⟩:=booked (target+1) width debt
  refine ⟨U,active,?_⟩
  intro J₀ lower L D fits caps opt tol op tp
  obtain ⟨bottom,lowSchool⟩:=cal lower le_rfl L D fits caps opt tol op tp
  refine ⟨bottom,?_⟩
  intro Q order
  obtain ⟨start,highSchool⟩:=cal Q order L D fits caps opt tol op tp
  refine ⟨start,?_⟩
  filter_upwards [lowSchool,highSchool,WilsonSeparatedPrefixKineticGeometry.spend R simple 2 0] with v before after cash
  obtain ⟨V₀,draw₀,scheme₀,heat₀,anchor₀,cover₀,issue₀,lowPay⟩:=before
  obtain ⟨V,draw,scheme,heat,anchor,cover,issue,highPay⟩:=after
  refine ⟨V₀,draw₀,scheme₀,heat₀,anchor₀,cover₀,issue₀,V,draw,scheme,heat,anchor,cover,issue,?_⟩
  intro r hr T B book actual K vj N per b c requested power tag credit bk kn deep vc ck next span θ q₁ W source first old file Φ μ Active panel stations axes heads names κ pt test paid filed cells pins w row hearing
  let ref:=∑o:Active,μ o.val*((r:ℂ)^14*value (fun s=>normalized R ages κ pt N per K c v (cells o) s (w o) (pins o) (touch (test o) s) J₀ θ))
  let price:=∫z:Points 3,‖Φ z‖
  have high:‖hearing Q-ref‖≤price*θ^(target+1):=
    highPay r hr B book actual vj N per b c requested power tag credit bk kn deep vc ck next span q₁ W source first old
      file Φ panel stations axes heads names κ pt test paid
  have low:‖hearing lower-ref‖≤price*θ^(target+1):=
    lowPay r hr B book actual vj N per b c requested power tag credit bk kn deep vc ck next span q₁ W source first old
      file Φ panel stations axes heads names κ pt test paid
  have live:=((vc.trans ck).trans kn)
  have gp:0<θ:=ActualRunKernelPackets.regulator_pos R N per v live
  have rich:2≤θ⁻¹:=by simpa only [pow_zero,mul_one] using cash N per live
  have unit:2*θ≤1:=by simpa only [inv_mul_cancel₀ gp.ne'] using mul_le_mul_of_nonneg_right rich gp.le
  have pp:0≤price:=integral_nonneg (fun _=>norm_nonneg _)
  calc ‖hearing Q-hearing lower‖≤‖hearing Q-ref‖+‖hearing lower-ref‖:=by
         have eqn:hearing Q-hearing lower=(hearing Q-ref)-(hearing lower-ref):=by ring
         rw [eqn]
         exact norm_sub_le _ _
       _≤price*θ^(target+1)+price*θ^(target+1):=add_le_add high low
       _=(price*θ^target)*(2*θ):=by rw [pow_succ];ring
       _≤price*θ^target:=mul_le_of_le_one_right (mul_nonneg pp (pow_nonneg gp.le _)) unit

end YM.Integration.WilsonOriginalObservedRosePrintedTail
