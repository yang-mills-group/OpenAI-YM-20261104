theorem original (simple:G.Simple)(rentOrder p pieces stage requested:ℕ)
    (demand:WilsonOriginalCensusPublicationClock.Load k q q shelf requested grades pieces stage)
    (enrolled:q ≤ Burn.horizon k+1)(depth:2*rentOrder+8 ≤ q)(age:rentOrder+3 ≤ 3*k+2)
    (sized:q ≤ (clock).J (j+1))
    (below:WilsonOriginalCensusPublicationClock.Open R simple grades pieces stage demand j)
    (above:WilsonOriginalCensusPublicationClock.Open R simple grades pieces stage demand (j+1))
    (loSeats:opL.count=pieces)(hiSeats:opU.count=pieces)
    (ready:WilsonReceivedMeasuredStampPrice.opening R simple rentOrder q k depth age
      (by positivity:0<(1:ℝ)) ≤ j+1)
    (paidAge:(eventually_atTop.mp (WilsonEmittedOriginalCalendar.wages R simple)).choose ≤ j+1)
    (charge:Fin n→ℕ)(up:∀v,cashᵤ v ≤ (H₂)^(charge v))(down:∀v,cashₗ v ≤ (H₁)^(charge v))
    (early:(H₂)≤(H₁)^2)(small:tolU ≤ (Pert.Asymptotics.regulatorRun R.family N per (j+2))^rentOrder)
    (tube:LinkTube G)(front:Multi.Hot (Stock.census (Fin n)) → Fin n)
    (owned:∀s,front s∈s.val.val)
    (teacher:0<strip₀ ∧ Real.exp ((strip₀)⁻¹^2)≤(H₁) ∧
      ((Ψ (j+1)).p.supportExponent+2)*(((Ψ (j+1)).p.B:ℝ)⁻¹)≤(strip₀)/2 ∧
      (Real.sqrt (Ψ (j+1)).beta)⁻¹≤1/2 ∧ (Ψ (j+1)).p.B=Nat.ceil ((Real.log (H₁))^2) ∧
      (Ψ (j+1)).p.supportExponent+2≤102)
    (pass:Pass D Q R.alloy R.kit)(month:Scholar.Month R.rolls D Q R.alloy.delay)
    {quiet:ℕ → SeriesA G}(read:Read R N m (Burn.horizon k) quiet π Γ){τ cash:ℝ}
    (funded:Issued R N ((j+1)+1) (Burn.horizon k) (quiet ((j+1)+1)) τ cash)
    (legalU:Legal (AllOrder.Floe.Step.tape (Burn.horizon k+2)) (π ((j+1)+1)))
    (legalL:Legal (AllOrder.Floe.Step.tape (Burn.horizon k+2)) (π (j+1)))
    (rates:WilsonOriginalCensusDatedHeldTariff.Rates R grades κ pt (j+1) top q)
    (within:WilsonOriginalCensusFaceAdmission.housed sites R (j+1) per)
    (target:ℕ)(enough:2*(p+1) ≤ target)
    (ceiling:3*WilsonOriginalFullRosterBookedHearing.roof grades grades (fun v=>2*charge v) target ≤ q)
    (late:WilsonOriginalCensusSparseRosterOpening.first R simple tube grades grades (fun v=>2*charge v) q q target p enough ≤ j+1)
    (gross:ℝ)(weight:∀s:YM.Multi.Hot (Stock.census (Fin n)),‖∏w∈s.val.val,(wallet w).val‖*‖touch test s.val.val‖ ≤ gross)
    (opened:∀(s:YM.Multi.Hot (Stock.census (Fin n)))(v:Fin (q+1)),WilsonOriginalCensusDatedPeriodOpening.Opened R (j+1) per
      (mass grades s.val.val+v.val) (rates.width s.val.val v) (rates.fare s.val.val v) gross (money p))
    (C:Fin n → ℝ)(paid:∀v,‖test v‖ ≤ C v)
    (diameter:ℕ)(covered:2*((univ:Finset (Fin n)).image sites).sup WilsonNeutralTwoPrintPathBoxHome.radius ≤ diameter)
    (selected:(u:Covers R.family.path.levels.S (j+1) (coarse R (j+1) per)) → Forest (step R (j+1) u.val).ratio)
    (credit:∀s:YM.Multi.Hot (Stock.census (Fin n)),WilsonOriginalCensusMeasuredStation.CreditAt R κ pt grades C (j+1) top q per diameter
      (((hat₀)^(near (p+1) (mass₀ s.val) 1))⁻¹))
    (lawU:rows (j+2)=hiWord)(lawL:rows (j+1)=loWord)
    (way:WayStation R.kit)(hospital:MintClock.Hospital D R.rolls Q R.kit.target φ books ahead R.alloy.delay)
    (warm:Spill.Raffle.Warm G D R.alloy.delay φ)(uPos:∀v,0 ≤ tollU v)(lPos:∀v,0 ≤ tollL v)
    {df:ℕ}{frame:Frame G df}(section_:SectionData frame)(group:Hol G)(ticket:TicketP R.alloy R.kit D Q)
    (s:(Stock.census (Fin n)).Mode){b:ℕ}(floor:m ≤ b)(older:b ≤ j+1)
    (np:0<n)(cost P f d:ℕ)
    (tariff:WilsonOriginalCensusPostedWages.debit (debit₀) (fun v=>2*charge v) s ≤ f)
    (grade:(∑v:Fin n,grades v)+1 ≤ d)
    (period:R.family.S.a b/R.family.S.a top ≤ (R.family.path.levels.clock.hatBeta b)^cost)
    (reserve:work n P f d+1+(WilsonOriginalFullRosterCouplingClock.wallet f).pole+1 ≤ rentOrder)
    (station:WilsonOriginalFullRosterDatedReturn.station R simple
      (WilsonOriginalFullRosterBookedHearing.roof grades grades (fun v=>2*charge v) target) (Fintype.card (Fin n)) ≤ j)
    (support:(R.family.path.levels.budget (j+1)).supportExponent=100){η:ℝ}(ep:0<η)
    (opening:WilsonOriginalOneArmOpticalDates.At R simple s n cost P f d (2*s.val.card+((debit₀)+∑v∈s.val,2*charge v))
      p cost₀ η (by exact (show (2:ℝ)^1=2 by norm_num).symm.trans_le (pow_le_pow_right₀ (by norm_num) (by omega))) np
      (fun t=>by simpa only [Fintype.card_fin] using t.val.card_le_univ) ep b (j+1) N per):
    Owned (N:=N) R simple hk D Q π Γ Ψ books ahead rows (j+1) b s P η:=by
  obtain ⟨cal,_,_,⟨faces⟩⟩:=WilsonOriginalOneArmMaterialGrant.original
    (R:=R) (hk:=hk) (D:=D) (Q:=Q) (π:=π) (Γ:=Γ) (Ψ:=Ψ) (course:=course) (books:=books) (base:=base) (ahead:=ahead)
    (digits:=digits) (test:=test) (κ:=κ) (pt:=pt) (top:=top) (seed:=seed) (sites:=sites) (L:=L) (U:=U)
    (low:=low) (high:=high) (wallet:=wallet) (tags:=tags) (later:=later) (valid:=valid)
    (shelf:=shelf) (opL:=opL) (lessonL:=lessonL) (opU:=opU) (lessonU:=lessonU) (tollL:=tollL) (tollU:=tollU)
    (upperFile:=upperFile) (lowerFile:=lowerFile) simple rentOrder p pieces stage requested demand enrolled depth age sized
    below above loSeats hiSeats ready paidAge charge up down early small tube front owned teacher pass month read funded
    legalU legalL rates within target enough ceiling late gross weight opened C paid diameter covered selected credit
  have hv:=(upperFile.choose_spec.2.2.2.2.2.2.2.2.2 wallet).choose_spec
  have lv:=(lowerFile.choose_spec.2.2.2.2.2.2.2.2.2 wallet).choose_spec
  change (hi₀).x=wallet ∧ _ at hv
  change (lo₀).x=wallet ∧ _ at lv
  have hg:(hi₀).grades=grades:=hv.2.1
  have lg:(lo₀).grades=grades:=lv.2.1
  have ho:(hi₀).order=q:=hv.2.2.1
  have hn:(hi₀).seats=pieces:=hv.2.2.2.2.1.trans hiSeats
  have hc:(hi₀).post.op.count=pieces:=(hi₀).post.capacity.trans hn
  have A:2 ≤ cost₀:=by
    exact (show (2:ℝ)^1=2 by norm_num).symm.trans_le (pow_le_pow_right₀ (by norm_num) (by omega))
  have n₀:∀t:(Stock.census (Fin n)).Mode,t.val.card ≤ n:=fun t=>by simpa only [Fintype.card_fin] using t.val.card_le_univ
  apply WilsonOriginalOneArmBoardPair.original (N:=N) R simple hk D Q π Γ Ψ books base ahead rows (hi₀) (lo₀)
    lawU lawL course (later.trans_le valid) way pass month hospital warm
    (fun v=>mul_nonneg (uPos v) (zero_le_one.trans (le_max_left ..)))
    (fun v=>mul_nonneg (lPos v) (zero_le_one.trans (le_max_left ..)))
    cal (fun t _=>faces t) _ section_ group ticket A floor older later valid n cost P f d np n₀ _ _ period reserve support ep
    opening (qc:=requested) _ demand.aged _ above.onset _ _
  · simpa only [hg,lg] using station
  · simpa only [hg,lg,max_self] using tariff
  · simpa only [hg,lg,max_self] using grade
  · simpa only [ho] using demand.deep
  · simpa only [hn] using above.hard
  · simpa only [hc] using above.more
  · simpa only [hc,ho] using above.opened

