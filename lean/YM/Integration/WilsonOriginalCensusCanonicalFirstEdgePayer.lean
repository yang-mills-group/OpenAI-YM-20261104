/-- One realized K-date source, with its complete input accounts on the chosen regulated experiment. -/
structure Source (tol:ℝ) where
  post : Ptype
  book : voucher post
  placed : post.passport=Passport.point (o)
  empty : post.inputIndex=Empty
  event : post.op=op
  weather : post.lesson=lesson
  names : post.modelIndex=(Fin n)
  ink : HEq post.model (M)
  hard : post.input.hard.Paid post.w (H).p.B (H).p.supportExponent (R.family.path.levels.clock.forcedAllowance ((j+1)+1))
  rent : 8*(budgetR R (j+1))^op.count*post.rent ≤ tol
  wallet : ∀v,(post.w v)⁻¹ ≤ max 1 (C₀)*(χ+2^(order+shelf+1+(D₀))*χ^((D₀)+2))
  physicalLaw : ∀x,(Tint.Patrol.picture post.model post.input).density x=(physical) x
  inlet : Legal (pay) (π ((j+1)+1))
  outlet : Legal (pay) (π (j+1))
  clock : WilsonOriginalCensusCanonicalFiledClock.Returns R hk D Q π Γ Ψ books (Nat.le_succ_of_le base)
    op ahead d q hd (o) order shelf post book

local notation "source" t:max => Source R hk D Q π Γ Ψ books base op lesson ahead d q hd y cells order shelf t
include simple course cut cal hospital chamber in
/-- The choice is made once, before the lower income, measured body, decoder and regulator comparison. -/
def original
    (seller:ℕ→Gear G→ℝ)(fund:FundedMarkedCoverRows.prices seller R.kit)(history:FundedOriginalVacuumPaths.prices R.kit)
    (paid:WilsonOriginalCensusCanonicalAppointedClock.opening R simple seller fund history (Burn.horizon k) ≤ m)
    (ticket:TicketP R.alloy R.kit D Q)(path:PlanV.Path D R.alloy Q (Burn.horizon k) N m π Γ)
    (fit:∀j,rank R d (entry R d j (q j)) ≤ order)(slots:Fintype.card (Fin n) ≤ op.count)
    (space:∑j,d j ≤ shelf)(level:shelf ≤ R.alloy.B.a.clock.J (j+1))
    (ord:order ≤ R.alloy.B.a.clock.J (j+1))(stage:order+1 ≤ op.stage)
    (count:op.count ≤ Burn.horizon k+2)(cap:order+(∑j,d j) ≤ Burn.horizon k+2)
    {tol:ℝ}(tp:0 < tol)(x₀:Wallet (A))
    (atBare:Topline (Ψ N) (R.family.path.levels.clock.forcedAllowance N))
    (warm:Spill.Raffle.Warm G D R.alloy.delay φ)(pass:Pass D Q R.alloy R.kit)
    (halo:(eventually_atTop.mp (WilsonOriginalOccupiedRaffleIndependent.halo R simple)).choose ≤ (j+1)+1)
    (onset:WilsonMeasuredSemesterSubpower.onset R 1 (by norm_num:0<(1:ℝ)) ≤ (j+1))
    (p:ℕ)(way:WayStation R.kit)(hardFloor:6*op.count ≤ R.alloy.B.a.clock.J (j+1))
    (deep:2*(p+1)+8 ≤ order)(aged:p+4 ≤ 3*k+2)
    (opened:WilsonFirstReceivedEarnedFee.opening R simple op.count p order k deep aged (by norm_num:0<(1:ℝ)) ≤ (j+1))
    (more:WilsonMeasuredSemesterSubpower.onset R op.count (by norm_num:0<(1:ℝ)) ≤ (j+1))
    (cooled:(eventually_atTop.mp (WilsonReceivedClosePhysicalBirths.cool R simple)).choose ≤ (j+1)+1)
    (fresh:(eventually_atTop.mp (WilsonOriginalOccupiedModeFactors.original R simple
      (Fintype.card (Fin n)) (order+shelf+1+(D₀)) ((D₀)+2))).choose ≤ (j+1))
    (month:Scholar.Month R.rolls D Q R.alloy.delay)
    (tags:∀b:Covers R.family.path.levels.S (j+1) (coarse R (j+1) per),(step R (j+1) b.val).Choices):
    source tol:=by
  classical
  apply Classical.choice
  obtain ⟨F,B,site,empty,event,weather,names,ink,hard,rent,wage,same,lead,arrive,read⟩:=
    WilsonOriginalCensusCanonicalAppointedClock.original R simple hk D Q π Γ Ψ course scroll books
      (Nat.le_succ_of_le base) cut op lesson cal ahead chamber hospital d q hd (o) order shelf seller fund history paid
      ticket path fit slots space level ord stage count cap tp x₀ atBare warm pass halo onset p way hardFloor
      deep aged opened more cooled fresh month tags
  exact ⟨⟨F,B,site,empty,event,weather,names,ink,hard,rent,wage,same,lead,arrive,read⟩⟩

variable {S':Fin n→ℝ}{a':ℕ}(inLow:Config G (R.family.side (j+1) per)→Poly (Stock.census (Fin n)))
  (lower:WilsonOriginalDatedCensusInput.Filed (i:=j) (N:=N) R hk D Q π Γ Ψ books base ahead S' a' inLow)
local notation "lo" => lower.post

local notation "Hhat" => R.alloy.B.a.clock.hatBeta (j+1)
local notation "peak" c:max l:max => 3*WilsonOriginalFullRosterBookedHearing.roof d d c l
local notation "size₀" => WilsonOriginalCensusPhysicalLoad.rank (WilsonOriginalCensusAngularFace.sides d d)
open WilsonOriginalCensusCanonicalSparseBudget (winding)

include simple course cut in
/-- The same selected source pays all the lower real faces and the true next-coupling tolerance. -/
def hearing {tol:ℝ}(ticket:source tol)
    (pt:Fin n→Chamber)(x:Wallet (A))
    (tags:∀b:Covers R.family.path.levels.S (j+1) (coarse R (j+1) per),(step R (j+1) b.val).Choices)
    {length:ℕ}{σ₀:ℝ}(L:Material R N (j+1) length d σ₀ (binder (coarse R (j+1) per) y))
    (active:Addressed y L (present L.tests))
    (matched:∀z S₁,output L.prior S₁ N z=fixed R d (fun v=>contact (L.tests v))
      pt N ((j+1)+1) (j+1) cells q z S₁)
    (lowPlaced:(lo).passport=port (coarse R (j+1) per) y)
    (lowNames:(lo).modelIndex=((z:Multi.Hot (marks))×(words L z).Roster))(lowInk:HEq (lo).model (mounts L))
    (graded:lower.grades=d)(wallet:lower.x=x)
    (positive:0<Poetry.Agenda.seed D φ (Burn.horizon k) (R.alloy.B.a.clock.J (j+1)))
    (s:(marks).Mode)(front:(t:Multi.Hot (marks))→t.val.val)
    (charges:Fin n→ℕ)    (tube:LinkTube G)(target p breadthCap lowOrder:ℕ)
    (depth:2*(p+1)≤target)(lowOrderEq:lower.order=lowOrder)
    (highCap:(peak charges target)≤order)(lowCap:(peak charges target)≤length)
    (lens:Fin n→ℕ)(home:L.tests=lens)
    (menu:WilsonOriginalCensusCanonicalPeriodSchedule.Appointment R simple d lens pt charges tube order lowOrder target p depth)
    (start:menu.first≤j+1)(period:menu.period (j+1) breadthCap≤per)
    (near:∀t:Multi.Hot (marks),t.val.val⊆s.val→
      breadth t.val.val (front t).val (y (front t).val) (relative t.val.val (front t).val y)≤breadthCap):
    PProd (∀w≤p,(Hhat^p)⁻¹≤(Pert.Asymptotics.regulatorRun R.family N per ((j+1)+1))^w)
    (∀t:Multi.Hot (marks),t.val.val⊆s.val→WilsonOriginalSparseCensusEdge.Face R hk D Q π Γ Ψ
      books base ahead _ inLow (file ticket.post ticket.book x) lower t (front t).val charges tube target ((Hhat^p)⁻¹)):=by
  exact WilsonOriginalCensusCanonicalRegulatedFaces.original R simple hk D Q π Γ Ψ course books base cut op ahead
    d q hd y cells order shelf inLow lower ticket.post ticket.book ticket.clock pt x tags L active matched lowPlaced lowNames lowInk
    graded wallet positive s front charges tube target p breadthCap lowOrder ticket.outlet depth lowOrderEq highCap
    lowCap lens home menu start period near

end YM.Integration.WilsonOriginalCensusCanonicalFirstEdgePayer
