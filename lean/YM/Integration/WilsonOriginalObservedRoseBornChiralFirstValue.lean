theorem original (M:Master H)(Q:Fin 2→SealR G)(cap:capP Q=10)(v:∀i,Rails (Q i).h k u₀ e)
    (height seats gain:ℕ)(surplus:2 ≤ gain)(stage:2*k ≤ 10+gain)(room:10+gain ≤ seats)(width:10+gain ≤ u₀)(heat:1 ≤ e):
    ∃originalP originalB homeP homeB unary:Fin 2→Credit,∃originalT homeT:(Fin 2→Bool)→Credit,
    ∀(V:Realm G (e+1) J),Elected M V height seats → ∀(X:Courts (H:=H) (v:=v))
    (m K N:ℕ),stamp V X m K N → V.anchor ≤ m → m ≤ K → K ≤ N → (∀i,On (Q i).h (X i).pt) →
    ∀(φ:Wilt Q)(fees:Fin 2→ℝ)(y space:ℝ),Bough Q φ y space fees → ∀(o:CellR)(ω:Fin 0→YForest G),
    let δ:=(paceT V.draws.S m K)^(1/4:ℝ)
    let settled:=gross gain V X φ fees y space homeP homeB homeT m
    let remainder:=δ*amountDue gain V X φ fees y space δ m originalP originalB unary originalT
    ‖projected V X φ m K N y o ω‖ ≤ settled ∧ ‖first V X φ m K N y o ω‖ ≤ settled+remainder:=by
  obtain ⟨p,b,u,t,spent⟩:=WilsonOriginalObservedRoseBornChiralFirstRate.original
    M Q cap v height seats gain surplus stage room width heat
  obtain ⟨hp,hb,ht,held⟩:=WilsonOriginalObservedRoseBornChiralValue.original
    M Q cap v height seats gain surplus stage room width heat
  refine ⟨p,b,hp,hb,u,t,ht,?_⟩
  intro V sale X m K N filed floor past live sound φ fees y space book o ω δ gain₀ rest
  have firstBill:=spent V sale X m K N filed floor past live sound φ fees y space book o ω
  have homeBill:=held V sale X m K N filed floor past live sound φ fees y space book o ω
  refine ⟨homeBill,?_⟩
  exact (norm_le_norm_sub_add _ _).trans ((add_le_add firstBill homeBill).trans_eq (add_comm rest gain₀))

end YM.Integration.WilsonOriginalObservedRoseBornChiralFirstValue
