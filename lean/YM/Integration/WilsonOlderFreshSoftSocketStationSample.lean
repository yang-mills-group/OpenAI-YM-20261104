def Sampled (D:Fin 3→ℕ)(p q order width:ℕ)(ξ η δ:ℝ)(m C:Fin 3→ℝ)(A₀:Group R.family 6)(r:ℝ)
    (M:Fin 3→ℝ)(reg:Indexed R grade (fun _=>A₀.station.k) order η M (filed R A₀))
    (v N per K c w:ℕ)(V:Realm G (p+1) Credit.leanC)(draw:V.draws=R.family.path.levels)
    (kK:A₀.station.k ≤ K)(ck:c ≤ K)(live:K<N):Prop:=
  ∀(tests:Sites N per×Sites N per→(t:Faces)→TestAt D t)(y:Sites N per×Sites N per),
    let g:=regulatorRun R.family N per K
    let θ:=regulatorRun R.family N per v
    let probes:=fun y t=>enrolled R D V draw N per c (ck.trans live.le) y t (tests y t)
    let x:=vector R grade (fun _=>A₀.station.k) K order η M (filed R A₀) (fun _=>kK) reg N per
    let pay:=fun i=>(r/R.family.S.a K)^(grade i)
    let Q:=table R D V N per K c w v probes g x pay p θ true
    let F:=table R D V N per K c w v probes g x pay p θ false
    let H:=overhead R width ξ η δ m
    let B:=reserve R D p H C
    ‖value (F y)-value (Q y)‖ ≤ cost R C B*g^q

theorem original (D:Fin 3→ℕ)(p q order width:ℕ)(ξ η δ:ℝ)(m C:Fin 3→ℝ)(A₀:Group R.family 6)(r:ℝ)(rp:0<r)
    (M:Fin 3→ℝ)(reg:Indexed R grade (fun _=>A₀.station.k) order η M (filed R A₀))
    (v N per K c w:ℕ)(V:Realm G (p+1) Credit.leanC)(draw:V.draws=R.family.path.levels)
    (kK:A₀.station.k ≤ K)(ck:c ≤ K)(live:K<N)(vN:v ≤ N)
    (low:regulatorRun R.family N per v ≤ 1)(cool:regulatorRun R.family N per K ≤ 1):
    let H:=overhead R width ξ η δ m
    let surface:=q+2*H
    Hearing R D p surface width ξ δ η m C A₀ r order M reg v N per K c w V draw kK ck live →
    Cleared R D p width ξ δ η m C A₀ r order M reg v N per K c V draw kK ck live →
    Compared R D p surface C η A₀ r order M reg v N per K c w V draw kK ck live →
    Sampled R D p q order width ξ η δ m C A₀ r M reg v N per K c w V draw kK ck live:=by
  intro H surface terms bank rows tests site g θ probes x pay Q F H₁ B
  have norm:=WilsonOlderFreshSoftSocketStationSingleton.original R D p surface width ξ δ η m C A₀ r rp order M reg
    v N per K c w V draw kK ck live vN low cool terms bank rows
  have θ0:0 ≤ θ:=(ActualRunKernelPackets.regulator_pos R N per v vN).le
  apply node R (F site) (Q site) C B g (ActualRunKernelPackets.regulator_pos R N per K live.le) cool q H
  · intro s
    by_cases occupied:s.Nonempty
    · have h:=rows p le_rfl θ (by rwa [abs_of_nonneg θ0]) s occupied site (tests site s)
      simpa only [F,Q,WilsonOlderFreshSoftRoseMesh.table,if_pos occupied] using h
    · simp only [F,Q,WilsonOlderFreshSoftRoseMesh.table,if_neg occupied,sub_self,norm_zero,
        WilsonOlderFreshSoftSocketStationStops.ticket,zero_mul,le_refl]
  · intro s occur
    simpa only [Q,WilsonOlderFreshSoftRoseMesh.table,if_pos occur] using norm s occur site (tests site s)

section Sampling
theorem measured (N per:ℕ)(F Q:Sites N per×Sites N per→Faces→ℂ){B:ℝ} {I:Type*}[Fintype I](atSite:I→Sites N per×Sites N per)(weight:I→ℂ)
    (funded:∀y,‖value (F y)-value (Q y)‖≤B):
    ‖∑i:I,weight i*(value (F (atSite i))-value (Q (atSite i)))‖≤(∑i:I,‖weight i‖)*B:=by
  apply (norm_sum_le ..).trans
  rw [Finset.sum_mul]
  apply sum_le_sum;intro i _
  rw [norm_mul]
  exact mul_le_mul_of_nonneg_left (funded (atSite i)) (norm_nonneg _)

theorem on_mesh (N per:ℕ)(F Q:Sites N per×Sites N per→Faces→ℂ){B:ℝ} (front:ℕ)(atSite:Sites front per×Sites front per→Sites N per×Sites N per)(r:ℝ)(φ:YM.Test 3)
    (nonneg:0≤B)(funded:∀y,‖value (F y)-value (Q y)‖≤B):
    ‖∑y:Sites front per×Sites front per,WilsonThermometerAlignedCells.mass (R:=R) r (front,per) φ y*
      (value (F (atSite y))-value (Q (atSite y)))‖≤(∫z:Points 3,‖φ z‖)*B:=
    (measured R N per F Q atSite (WilsonThermometerAlignedCells.mass (R:=R) r (front,per) φ) funded).trans
      (mul_le_mul_of_nonneg_right (WilsonThermometerAlignedCells.variation (R:=R) r (front,per) φ) nonneg)

end Sampling
