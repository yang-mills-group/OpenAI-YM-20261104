open private ink from YM.Integration.WilsonOriginalCensusPolyPages
open private flat_constant from YM.Integration.WilsonReceivedCanonicalSocketWick
local notation "P" => relative R N i per (by omega) F (covered R N i per)
local notation "angle" => Sum.elim z (flatten U)
local notation "wage" => fun v:Fin n=>(x v).val
local notation "incoming" => entered R N i per (by omega) F (M) t
local notation "raised" => fun s:Finset (Fin n)=>before R N i per (by omega) F ((ordinary (M) t s).1 (f))
local notation "receipt" r:max => WilsonOriginalCensusPaidForest.value (binders) R N i per (by omega) F dvd_rfl x (charts (H)) U z r

include well hs base cover limit in
theorem equation:Equation (raised) (incoming):=by
  have help:Wellness k (submit old k q):=(WilsonReceivedCompactVerseEntrance.original old well hs base cover).2.1
  exact (levels_exp (M) (help.level' y) (help.quiet' y) t (f)).mapKin
    (SignedMeasuredSourceSeries.probe (step R i per) F (saddle R N i per F)
      (fderiv ℝ ((model R N i per (by omega)).b F) 0))

include well hs base cover bound in
theorem original (r:ℕ)(through:r≤q):
    Poly.pass (lit (Board (J) r) (receipt r))=
      booked r (angle) (wage) (fun s=>raiseE (P)*((raised) s)):=by
  have law:Equation (raised) (incoming):=by
    apply equation (Y:=Y) <;> assumption
  have vacuum:constantCoeff (P)=0:=flat_constant R N i per (by omega) F
  have ev:constantCoeff (observed (angle) (P))=0:=by
    change MvPolynomial.eval (angle) (constantCoeff (P))=0
    rw [vacuum,map_zero]
  have basezero:(register (J) r (observed (angle) (P))).part (Board (J) r).quiet=0:=by
    rw [←Join.pair_quiet,WilsonVacuumPreResetFiniteRegister.read,if_pos rfl]
    change ((_ : ℕ).factorial:ℂ)*↑(coeff 0 (observed (angle) (P)))=0
    rw [coeff_zero_eq_constantCoeff_apply,ev]
    simp
  have actual:lit (Board (J) r) (receipt r)=
      register (J) r (observed (angle) (P))+booked r (angle) (wage) (incoming):=by
    apply Join.both_parts
    intro s h
    by_cases selected:(Join.pair s h).val.Nonempty
    · rw [part_lit _ ⟨_,selected⟩,WilsonOriginalCensusFaceGenerators.original R Y lo enrolled N X positive limit width
        per y t deep closed tickets old well hs base cover bound F x U z r through ⟨_,selected⟩]
      simp only [Join.left_pair,Join.right_pair,Poly.part_plus,WilsonVacuumPreResetFiniteRegister.read,
        WilsonOriginalCensusOrdinaryRegister.coefficient]
      by_cases live:s.val.Nonempty
      · rw [if_pos live,if_neg ((hot_iff_ne _).mp live),mul_zero,zero_add]
        rfl
      · have blank:s=(J).quiet:=not_not.mp (fun ne=>live ((hot_iff_ne _).mpr ne))
        subst s
        rw [if_neg live,if_pos rfl]
        have mark:(incoming) (J).quiet.val=0:=law.2.1
        simp only [mark,map_zero,Complex.ofReal_zero,mul_zero,add_zero]
        apply congrArg (fun k:ℂ=>(h.val.card.factorial:ℂ)*k)
        simpa only [OriginalRadialSeries.observed,coeff_map,map_one,one_mul] using
          ink R i per F U z 1 (coeff h.val.card (P))
    · have blank:Join.pair s h=(Board (J) r).quiet:=not_not.mp (fun ne=>selected ((hot_iff_ne _).mpr ne))
      rw [blank,part_lit_quiet,Poly.part_plus,basezero,WilsonOriginalCensusOrdinaryRegister.blank,
        law.2.1,map_zero,zero_add]
      rfl
  rw [actual]
  exact WilsonOriginalCensusOrdinaryRegister.original r (angle) (wage) (P) vacuum law

