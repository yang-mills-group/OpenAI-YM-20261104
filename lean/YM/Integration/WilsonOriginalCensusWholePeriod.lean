private theorem tiles (R:Run G)(j per:ℕ)(u:Covers R.family.path.levels.S j (coarse R j per)):
    (fine R j per).val∣(fine R j u.val).val:=by
  rw [(step R j per).sizes,(step R j u.val).sizes]
  exact Nat.mul_dvd_mul_right u.prop _

include well hs base cover bound in
theorem original [Fintype I]{p':Passport (fine R j per) (Fin n)}{μ:Type}
    (high:μ → Row p' (Stock.census (Fin n)) G (Affinity.Wallet (room (Fin n))))
    (placed:p'=P)(names:μ=((l:I)×((words H) l).Roster))(ink:HEq high (mounts H))
    {w:Fin n → ℝ}{σ₀ expense:ℝ}{order seats shelf:ℕ}
    (stock:Scene.Armada high w k σ₀ expense order seats shelf)(width₀:0 < σ₀)

    (tags:∀u:Covers R.family.path.levels.S j (coarse R j per),(step R j u.val).Choices)
    (lead:∀s:Finset I,s.Nonempty→s)(x:Affinity.Wallet (room (Fin n)))
    {start e:ℕ}{quiet:ℕ→SeriesA G}{π:ℕ→Layout G}{Γ:ℕ→Pace.Coin}
    (legal:Legal (Step.tape (e+2)) (π (j+1)))(course:Read R N start e quiet π Γ)(live:start ≤ j)
    {τ cash:ℝ}(funded:Issued R N (j+1) e (quiet (j+1)) τ cash)(starts:Γ j 0=0)
    (r d:ℕ)(retained:r≤q)(grade:r≤e+2)(kept:d≤r)
    (target:(Stock.census (Fin n)).Mode)(v:Stationary.Link G (coarse R j per))(unit:‖v‖ ≤ 1)
    (z:I→Lattice.Cover)(atSite:∀l,wrap (coarse R j per) (z l)=(step R j per).ratio.parent ((B l).center))
    (κ:(a:Fin n)→Knob (D a))(pt:Fin n→Chamber)(K:ℕ)(top:K≤N)
    (cells:WilsonReceivedFixedDigitHistory.Digits R.family.path.levels (Fin n))(seed:(v:Fin n)→WilsonThermometerDeclaredSeeds.Choice R k v)
    (declared:old=WilsonReceivedFixedDigitCanonical.fixed R k κ pt N K (j+1) cells seed)
    (diameter:ℕ)(radius:∀s:Finset I,∀o:s,WilsonNeutralTwoPrintPathBoxHome.breadth s o.val 0
      (WilsonIndependentCollarOrbitalReception.relative s o.val z) ≤ diameter)
    (C:Fin n→ℝ)(inCash:∀a,‖t a‖ ≤ C a)(ε:ℝ)(ep:0≤ε)(simple:G.Simple)
    (paid:WilsonOriginalCensusRosterOpening.opening (I:=I) R κ pt k C j K q per
      (Fintype.card I*mass k Finset.univ+q) diameter ε):
    let covers:=tiles R j per
    let trial:=fun (u:Covers R.family.path.levels.S j (coarse R j per))=>
      let F:=repeatF (step R j u.val)
      let U:Adjacent.Display (Stationary.Link G (coarse R j u.val)):=fun i b=>
        let K₀:=model R N j u.val (show j<N by omega)
        let raw:=Bulk.Fk K₀ F (tags u) (copyColor (covers u) high k (fun a=>(high a).paint x) (π (j+1)) (Step.tape (e+2)))
          (Stationary.arm G _ 1 b) r
        (Order.observe (Stock.census (Fin n)) r (Order.logMarked raw) i).part target
      (Pages (coarse R j per) (coarse R j u.val):ℂ)⁻¹*
        Adjacent.born U ((Rebirth.caliber (Γ j) starts).back (e+2)) 0 r d
          (AllOrder.Ker.convey (coverWin u.prop) v)
    let physical:=∑s:Finset I,wages B x target s*WilsonOriginalCensusFiniteLedger.reading R N j per q d k old
      (modes) c y t (fun l=>(B l).center) lead s v
    let restoring:=∑s:Finset I,‖wages B x target s‖
    let limitFilter:=coverFilter R.family.path.levels.S j (coarse R j per)
    Tendsto trial limitFilter (𝓝 (limUnder limitFilter trial)) ∧
      ‖limUnder limitFilter trial-physical‖ ≤ restoring*((Fintype.card I*mass k Finset.univ+q+1:ℕ)*ε):=by
  intro covers trial physical restoring F
  let namesAt:WilsonOriginalCensusRosterOpening.Patterns I n:=⟨⟨(modes),c⟩,pin⟩
  let maxRank:=Fintype.card I*mass k Finset.univ+q
  let digits:=fun l:I=>(step R j per).ratio.residue ((B l).center)
  let higher:=fun u=>∑s:Finset I,wages B x target s*WilsonOriginalCensusRosterFare.whole
      (ranks) d s lead (fun s o a=>WilsonOriginalCensusRosterMenu.sheets R (ranks) N j q (coarse R j per)
        (reprint) digits s o.val z d a v u)
  let central:=∑s:Finset I,wages B x target s*WilsonOriginalCensusRosterFare.whole
      (ranks) d s lead (fun s o a=>WilsonOriginalCensusRosterMenu.central R (ranks) N j q (coarse R j per)
        (reprint) digits s o.val z d a v)
  have actual:trial=higher:=by
    funext u
    exact WilsonOriginalCensusBoardValue.original R Y lo enrolled N X positive limit width B c inside pin deep y t
      closed tickets old well hs base cover bound high placed names ink stock width₀ u (tags u) (step R j per).sizes
      (covers u) lead x legal course live funded starts r d retained grade kept target v z atSite
  have home:central=physical:=by
    apply Finset.sum_congr rfl
    intro s _
    apply congrArg (fun b:ℂ=>wages B x target s*b)
    exact WilsonNeutralTwoPrintPathBoardCentral.original R N j per (by omega) simple (tags ⟨per,dvd_rfl⟩)
      old q well hs base cover (modes) c pin y t (fun l=>(B l).center) lead s z (fun l _=>atSite l) d
      (kept.trans retained) v
  have doors:=paid namesAt
  have tab:=WilsonOriginalCensusRosterFare.original R κ pt k N j K q per (modes) c C diameter maxRank d ε ep
    (fun s o r'=>doors s o ⟨d,by omega⟩ r')
    (fun s=>WilsonOriginalCensusRosterOpening.orderBound k (modes) s d q (kept.trans retained))
    top seed cells y t inCash (coarse R j per) dvd_rfl digits (fun _ _=>z) radius v unit B x target lead
  rw [actual,←home]
  have after:Tendsto higher F (𝓝 (limUnder F higher)) ∧
      ‖limUnder F higher-central‖ ≤ restoring*((maxRank:ℝ)+1)*ε :=by
    dsimp only at tab
    rw [←declared] at tab
    refine ⟨tab.1,?_⟩
    simpa only [mul_assoc] using tab.2.1
  refine ⟨after.1,after.2.trans_eq ?_⟩
  simp [maxRank,Nat.cast_add,Nat.cast_mul,mul_assoc]

end YM.Integration.WilsonOriginalCensusWholePeriod
