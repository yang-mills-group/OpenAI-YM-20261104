theorem original (simple:G.Simple)(nonbare:i<N)(cap:∀t,‖value A t‖≤1)
    {τ:ℝ}(pos:0<τ)(bounded:τ≤1)(pass:Pass D Q₀ R.alloy R.kit)
    (late:WilsonMeasuredSemesterSubpower.onset R 1 (half_pos (show (0:ℝ)<1 by norm_num)) ≤ i)
    (T:WilsonOlderFreshGraphSlate.Copy G d Q σ₀)
    (filed:WilsonOlderFreshPointRegistry.Filed R L a depth (1/4) digit nonbare w f T)
    (seats:1≤op.count)(shape:op.count=school.pieces)(phase:school.order+1≤op.stage)
    (enrolled:Q ≤ school.order)(order:d ≤ school.horizon)(cut:ℕ)
    (width:Sycamore.Boot.need cut school ≤ R.alloy.B.a.clock.J (i+1))(test:Wallet A)
    (slow:∀j,((R.family.S.block j).val:ℝ) ≤ Real.log (RG16.Lambda R.family.path.levels j))
    (ready:WilsonReportLampForecast.Ready R.family.path.levels)
    (geo:WilsonOriginalNullBareCapital.Priced W₁ σ₀ school.order school.horizon school.pieces (budgetR R (i+1)))
    (fixed:(R.family.path.levels.budget (i+1)).supportExponent=100)
    (time:WilsonOriginalNullBareFunding.first R d simple slow ready ≤ i+1)
    (home:Opened R.family d (i+1) per):
    ∃ (x:(Fr).Coeff) (v z:Coefficient Fr (R.family.side (i+1) per)) (B D₁:ℝ),
      v.Format y Y W₁ ∧ v.remBound y W₁ κ B ∧ z.Format y Y P₁ ∧ z.remBound y P₁ κ D₁ ∧
      projection Fr Y (W₁).p.threshold y v=0 ∧ projection Fr Y (P₁).p.threshold y z=0 ∧
      (fun V=>((W₁).eval V:ℂ)*(Spill.Foundry.uncut (T.rows S A) (Coat.gStep (W₁).beta) test V).part fire)=
        ((calValues (C:=R.family) d N per (i+1) x) ∘ translate y)+(v.density y Sec W₁+z.density y Sec P₁) ∧
      B+D₁ ≤ 2*|unitCost| *(1+R.alloy.B.a.clock.hatBeta ((i+1)+1))^(height+7)*(1+‖f‖) :=by
  obtain ⟨c,amp,cp,wp,original,_,land⟩:=WilsonOlderFreshPointLanded.original R hk D Q₀ π Γ Ψ history
    scroll books chamber hi warm top school op lesson cal ahead hospital y A L a depth w f digit
    simple nonbare cap pos bounded (half_pos (show (0:ℝ)<1 by norm_num)) pass late T filed.1 filed.2.1
    seats shape phase enrolled order cut width test
  obtain ⟨fac,θ,wallet,bid⟩:=geo
  obtain ⟨x,v,z,B,D₁,vf,vp,zf,zp,vn,zn,field,mass⟩:=WilsonOriginalNullBareFunding.original R hk D Q₀ π Γ Ψ
    history books hi nonbare school ahead A (T.rows S A) d simple slow ready land cp wp wallet bid fixed time home test
  refine ⟨x,v,z,B,D₁,vf,vp,zf,zp,vn,zn,field,?_⟩
  have timed:=time
  simp only [WilsonOriginalNullBareFunding.first,max_le_iff] at timed
  have calendar:= (eventually_atTop.mp (WilsonOriginalNullBareScale.original R simple slow ready
    (WilsonCapturedPrimaryDecoder.invoice Fr Y d))).choose_spec (i+1) timed.2.2.2.2.1 per
  obtain ⟨warm,within,_⟩:=calendar
  exact WilsonOriginalNullBareWallet.restored ((by norm_num:(1:ℝ)≤2).trans warm) within wp (norm_nonneg f)
    (by norm_num:(1:ℝ)/2 ≤ 1) (by norm_num:(1:ℝ)/4 ≤ 1) le_rfl original mass
