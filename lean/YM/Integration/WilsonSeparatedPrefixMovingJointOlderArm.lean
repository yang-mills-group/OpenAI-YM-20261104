theorem declared (Q:SealR G)(φ:Rarity D)(ψ χ:Rarity Q.D)(hψ:ContDiff ℝ ∞ ψ.ψ.val)(hχ:ContDiff ℝ ∞ χ.ψ.val)
    (window:∀p q:Point4,φ.ψ.val p*ψ.ψ.val (q-p)=φ.ψ.val p*(χ.ψ.val q*ψ.ψ.val (q-p))):
    ∃S:𝓢(Euclid,ℂ),S=WilsonSeparatedPrefixMovingJointSpectrum.transformed ψ hψ ∧ (∀n:ℕ,Integrable (fun ξ:Euclid=>(1+‖ξ‖^n)*‖S ξ‖))∧
    ∀(R:Realm G (e+1) C)(_rider:PassportC H R Q W V){j t b N older:ℕ}(B:Era G ℝ),
    Auth j B→R.anchor≤b→ older≤b→b≤N→
    ∀(user:Era G ℝ→ₗ[ℝ]ℝ),WilsonSeparatedPrefixMovingJetPrice.eligible Q.D user→
    ∀(x v:ℝ),x≠0→∀(s:Cover)(z o:CellR)(X:Q.Rider),
      let ε:=paceT R.draws.S t b
      let p:=(ε/x) • Mer.address x v o s z.val
      let measure:=fun A=>user (cruises R.draws R.paid N (Q.h+j) b older (agateV A B))
      let waves:=fun ξ=>∑c:Bool,∑d:Bool,cash φ S ξ p c d*
        measure (locale o (Q.spins R.draws R.paid (sheet χ (angle ξ) d) t b N (ε*v/x) X))
      Integrable waves ∧ φ.ψ.val p*measure (move s (locale z (Q.spins R.draws R.paid ψ t b N ε X)))=∫ξ,waves ξ:=by
  obtain ⟨S,identity,salary,board⟩:=WilsonSeparatedPrefixMovingJointOlderBook.declared (G:=G) φ ψ χ hψ hχ window
  refine ⟨S,identity,salary,?_⟩
  intro R rider j t b N older B hb gate ear top user accept x v hx s z o X
  let ε:=paceT R.draws.S t b
  let p:=(ε/x) • Mer.address x v o s z.val
  let P:=polarP R.draws R.paid Q.ans Q.path N t b X
  have hp:Auth Q.h P:=by
    dsimp [P]
    rw [←rider.lands,←rider.modes]
    exact On_auth (tournure rider.f.arch X (rider.tap.symm ▸ gate) top)
  have pay:=board R P B hp hb ear top user accept p ε (ε*v/x) (pace_pos ..) o Q.h
  dsimp only
  rw [WilsonSeparatedPrefixMovingJointAddress.appointed Q R.draws R.paid ψ t b N ε (ε*v/x) s z o X]
  dsimp only [WilsonSeparatedPrefixMovingJointAddress.print]
  rw [WilsonSeparatedPrefixMovingJointAddress.ratio ε x v hx s z o]
  exact pay
theorem original (Q:SealR G)(φ:Rarity D)(ψ χ:Rarity Q.D)(hψ:ContDiff ℝ ∞ ψ.ψ.val)(hχ:ContDiff ℝ ∞ χ.ψ.val)
    (window:∀p q:Point4,φ.ψ.val p*ψ.ψ.val (q-p)=φ.ψ.val p*(χ.ψ.val q*ψ.ψ.val (q-p))):
    ∃S:𝓢(Euclid,ℂ),(∀n:ℕ,Integrable (fun ξ:Euclid=>(1+‖ξ‖^n)*‖S ξ‖))∧
    ∀(R:Realm G (e+1) C)(_rider:PassportC H R Q W V){j t b N older:ℕ}(B:Era G ℝ),
    Auth j B→R.anchor≤b→ older≤b→b≤N→
    ∀(user:Era G ℝ→ₗ[ℝ]ℝ),WilsonSeparatedPrefixMovingJetPrice.eligible Q.D user→
    ∀(x v:ℝ),x≠0→∀(s:Cover)(z o:CellR)(X:Q.Rider),
      let ε:=paceT R.draws.S t b
      let p:=(ε/x) • Mer.address x v o s z.val
      let measure:=fun A=>user (cruises R.draws R.paid N (Q.h+j) b older (agateV A B))
      let waves:=fun ξ=>∑c:Bool,∑d:Bool,cash φ S ξ p c d*
        measure (locale o (Q.spins R.draws R.paid (sheet χ (angle ξ) d) t b N (ε*v/x) X))
      Integrable waves ∧ φ.ψ.val p*measure (move s (locale z (Q.spins R.draws R.paid ψ t b N ε X)))=∫ξ,waves ξ:=by
  obtain ⟨S,_,data⟩:=declared (H:=H) (C:=C) (W:=W) (V:=V) (e:=e) Q φ ψ χ hψ hχ window
  exact ⟨S,data⟩
