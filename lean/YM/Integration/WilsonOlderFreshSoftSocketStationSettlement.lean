def put {front N per:ℕ}(fine:front ≤ N)(y:Sites front per×Sites front per):Sites N per×Sites N per:=
  let root:=WilsonOriginalMicroscopicEntranceGridRow.pin R fine (fun i:Fin 3=>atOrigin y i)
  (root 1,root 2)

section Cells
variable (A:Group R.family 6) {N per front:ℕ}(r:ℝ)(φ:YM.Test 3)(fine:front ≤ N)
local notation "μ" => WilsonThermometerAlignedCells.mass (R:=R) r (front,per) φ
local notation "Jumps" => (Sites front per×Sites front per)
local notation "Valid" => {y:Jumps // μ y ≠ 0}
local notation "place" y:max => put R (per:=per) fine y
local notation "O_" y:max => actual R A (N:=N) (per:=per) (place y)
local notation "report" y:max => reading R A N per (place y) (native R A N per (place y) 0)

abbrev Book := (y:Valid) → Sale (O_ y.val) (report y.val)

def returned (book:Book R A (per:=per) r φ fine)(Q:Sites N per×Sites N per→Faces→ℂ):ℂ:=
  ∑y:Valid,(μ y.val)*(report y.val-value (Q (place y.val)) -
    ∑s:Faces,bill (O_ y.val) (book y).table s*(book y).debit s)

def hearing (book:Book R A (per:=per) r φ fine):ℝ:=
  ∑y:Valid,‖μ y.val‖*WilsonOriginalTwoFlatRoseCellSum.cost (book y)

theorem joined (F Q:Sites N per×Sites N per→Faces→ℂ)(book:Book R A (per:=per) r φ fine)
    (printed:∀y,(book y).table=F (place y.val)){B:ℝ}(nonneg:0 ≤ B)
    (funded:∀y,‖value (F y)-value (Q y)‖ ≤ B):
    ‖returned R A r φ fine book Q‖ ≤ hearing R A r φ fine book+(∫z:Points 3,‖φ z‖)*B:=by
  let delta(y:Valid):ℂ:=(μ y.val)*(value (F (place y.val))-value (Q (place y.val)))
  have separate:returned R A r φ fine book Q=
      (∑y:Valid,(μ y.val)*WilsonOriginalTwoFlatRoseCellSum.residual (book y))+∑y:Valid,delta y:=by
    unfold returned
    rw [←sum_add_distrib]
    apply sum_congr rfl
    intro y _
    dsimp only [delta,WilsonOriginalTwoFlatRoseCellSum.residual]
    rw [←printed y]
    ring
  have compare:‖∑y:Valid,delta y‖ ≤ (∫z:Points 3,‖φ z‖)*B:=by
    apply (WilsonOlderFreshSoftSocketStationSample.measured R N per F Q (fun y:Valid=>place y.val)
      (fun y=>μ y.val) funded).trans
    apply mul_le_mul_of_nonneg_right _ nonneg
    apply le_trans _ (WilsonThermometerAlignedCells.variation (R:=R) r (front,per) φ)
    let inclusion:Valid↪Jumps:=⟨Subtype.val,Subtype.val_injective⟩
    have reindex:(∑y:Valid,‖μ y.val‖)=∑z∈(univ:Finset Valid).map inclusion,‖μ z‖:=by
      rw [sum_map]
      rfl
    rw [reindex]
    exact sum_le_sum_of_subset_of_nonneg (subset_univ _) (fun z _ _=>norm_nonneg _)
  have first:=WilsonOriginalTwoFlatRoseCellSum.tested R A φ r fine book
  rw [separate]
  exact (norm_add_le ..).trans (add_le_add first compare)

end Cells
def Paid (D:Fin 3→ℕ)(p q order width:ℕ)(ξ η δ:ℝ)(m C:Fin 3→ℝ)(A₀:Group R.family 6)(r:ℝ)
    (M:Fin 3→ℝ)(reg:Indexed R grade (fun _=>A₀.station.k) order η M (filed R A₀))
    (v N per K c w:ℕ)(V:Realm G (p+1) Credit.leanC)(draw:V.draws=R.family.path.levels)
    (kK:A₀.station.k ≤ K)(ck:c ≤ K)(live:K<N):Prop:=
  ∀(tests:Sites N per×Sites N per→(t:Faces)→TestAt D t)(φ:YM.Test 3),
    let g:=regulatorRun R.family N per K
    let θ:=regulatorRun R.family N per v
    let probes:=fun y t=>enrolled R D V draw N per c (ck.trans live.le) y t (tests y t)
    let x:=vector R grade (fun _=>A₀.station.k) K order η M (filed R A₀) (fun _=>kK) reg N per
    let pay:=fun i=>(r/R.family.S.a K)^(grade i)
    let Q:=table R D V N per K c w v probes g x pay p θ true
    let F:=table R D V N per K c w v probes g x pay p θ false
    let H:=overhead R width ξ η δ m
    let B:=reserve R D p H C
    ∀(front:ℕ)(fine:front ≤ N)(book:Book R A₀ (per:=per) r φ fine),
    (∀y,(book y).table=F (put R (per:=per) fine y.val)) →
    ‖returned R A₀ r φ fine book Q‖ ≤ hearing R A₀ r φ fine book+(∫z:Points 3,‖φ z‖)*(cost R C B*g^q)


theorem original (D:Fin 3→ℕ)(p q order width:ℕ)(ξ η δ:ℝ)(m C:Fin 3→ℝ)(A₀:Group R.family 6)(r:ℝ)
    (M:Fin 3→ℝ)(reg:Indexed R grade (fun _=>A₀.station.k) order η M (filed R A₀))
    (v N per K c w:ℕ)(V:Realm G (p+1) Credit.leanC)(draw:V.draws=R.family.path.levels)
    (kK:A₀.station.k ≤ K)(ck:c ≤ K)(live:K<N):
    Sampled R D p q order width ξ η δ m C A₀ r M reg v N per K c w V draw kK ck live →
    Paid R D p q order width ξ η δ m C A₀ r M reg v N per K c w V draw kK ck live:=by
  intro sampled tests φ g θ probes x pay Q F H B front fine book printed
  apply joined R A₀ r φ fine F Q book printed _ (sampled tests)
  exact (norm_nonneg _).trans (sampled tests (0,0))

end YM.Integration.WilsonOlderFreshSoftSocketStationSettlement
