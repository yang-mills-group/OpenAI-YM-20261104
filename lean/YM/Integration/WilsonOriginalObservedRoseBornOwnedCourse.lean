theorem original {axis:Axis}{ε:ℝ}{s:WilsonOriginalAllOrderCourse.Schedule G}{campaign:Campaign R}
    {W:Campaign.Pillars R campaign}
    (paid:WilsonOriginalAllOrderCourse.Paid.{u} axis simple ε (WilsonOriginalOpticalSchedule.prepared s) R campaign W)
    {v:Extraction.Order}{S:Table R.family.book}(F:Final R.family v S){l:Ultrafilter (ℕ×ℕ)}
    {H:(Bel R.family.book).Hierarchy}{z:Trace.Terrace.Arch R.family}(J:ℝ→PhysMS.tower S)
    (bliss:Bliss F l z H)(lead:Leading F J)(axes:∀g,∀ᶠr in trail,Frame.obedient F H (J r) g)
    (Z:WilsonPrescription G){n:ℕ}(positive:0<n)(ratio:Z.run.ratio=(3:ℕ)^n)(stage:ℕ)
    (color:G.ColorIndex)(paths:FundedOriginalVacuumPaths.prices R.kit)
    (T:ℕ){δ:ℝ}(dp:0<δ)(books:(r:{r:ℝ // 0<r ∧ r<δ})→Book F (l:=l) H z 6 T r.val)
    (priced:∀r,WilsonMovingForkWindowBooks.Priced F (books r)):
    ∃t ≥ 6+3,
    (∀(h:ℕ)(d:Fin 3→Fin 7)(y:∀i,(Spin.comparator R.family.book).Field (d i).val)
      (x:∀i,RG17.Free R.family (d i).val),
      ∃grant:Registered F 6 T h t d books (field F J Z 6 T d y x books),type_of%
        (WilsonIndependentMeasuredOpticalSchool.original F Z simple bliss
          (WilsonOriginalPhysicalFirstEntryOwnerFinance.attached paid).2.1 (axis:=axis) (ε:=Stroke.epsilonR)
          paid.nested.2 positive ratio stage grant)) ∧
    (∀{a u:ℕ},Stop R.family 0 a u → Facilities R.family v S → (l:Filter _)≤v.fuse →
      ∀h:ℕ,WilsonOriginalTwoFlatIRPoolBook.Tested F J Z (h:=h) books u
        (source R.family (Finset.univ:Finset (Fin 3))) (Rose.test Z.criterion)) ∧
    (∀h:ℕ,type_of% (WilsonOriginalObservedRoseBornThermometer.original F J Z (Rose.test Z.criterion)
      simple bliss lead axes (WilsonOriginalPhysicalFirstEntryOwnerFinance.attached paid).2.1
      (WilsonOriginalPhysicalFirstEntryOwnerFinance.attached paid).1 (fun i=>by rw [paid.support i];norm_num)
      (fun i=>(paid.support i).le) color paid paths T h books priced (source R.family (Finset.univ:Finset (Fin 3))))) ∧
    ∀(B:ℕ)(hB:0<B),∃fine index:ℝ→ℕ,
      ∃clock:WilsonOriginalPositionFineScheme.enrolled (R:=R) (hG:=simple) (B:=B) Z fine index,
        ∀{I:Type}[Fintype I](basis:Module.Basis I ℂ (Sec G 6))(cap:ℝ→ℝ)
          (fronts:ℝ→Set Mesh)(admitted:∀r,fronts r∈Front),type_of%
            (WilsonOriginalObservedRoseBornGround.original R simple hB
              (WilsonOriginalPhysicalFirstEntryOwnerFinance.attached paid).2.1 Z clock basis cap fronts admitted):=by
  obtain ⟨t,large,school⟩:=WilsonPhysicalHousedOpticalSchool.onBooks paid F J bliss lead axes (Fin 3) Z
    positive ratio stage 6
  have income:=WilsonOriginalPhysicalFirstEntryOwnerFinance.attached paid
  refine ⟨t,large,fun h d=>school T h d books priced,?_,?_,?_⟩
  · intro a u stop conditions selected h
    exact WilsonOriginalTwoFlatIRPoolBook.on_book F J Z stop conditions bliss income.2.1 lead axes selected dp books priced h _ _
  · intro h
    exact WilsonOriginalObservedRoseBornThermometer.original F J Z (Rose.test Z.criterion) simple bliss lead
      axes income.2.1 income.1 (fun i=>by rw [paid.support i];norm_num) (fun i=>(paid.support i).le)
      color paid paths T h books priced _
  · intro B hB
    obtain ⟨fine,index,clock⟩:=WilsonOriginalPositionFineScheme.calendar (R:=R) (Z:=Z) (hG:=simple) (B:=B)
      (hB:=hB) (pace:=income.2.1) (WilsonPositionProgramNestedElection.prior paid.nested) positive ratio
    exact ⟨fine,index,clock,fun basis cap fronts h=>WilsonOriginalObservedRoseBornGround.original R simple hB
      income.2.1 Z clock basis cap fronts h⟩

end YM.Integration.WilsonOriginalObservedRoseBornOwnedCourse
