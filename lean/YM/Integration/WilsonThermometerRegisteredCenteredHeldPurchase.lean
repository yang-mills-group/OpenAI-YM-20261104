theorem original (inlet:∀u:Grid,post t mt (offer₀ top u)) (counted:∀u,Countable (inlet u).inputIndex)
    (capNames:∀u v,(inlet u).w v≤1) (refs:∀v:Fin 3,R.family.ref (grade v) ≤ N)
    (path:PlanV.Path D R.alloy tab (Burn.horizon k) N m π Γ)
    (pass:Pass D tab R.alloy R.kit) (month:Scholar.Month R.rolls D tab R.alloy.delay)
    (fits:order ≤ Burn.horizon k+1) (packed:order+shelf ≤ Burn.horizon k+2)
    (q l degree:ℕ) {price:ℝ} (cap:0 ≤ price) (deep:2*(q+2)+8 ≤ order) (aged:q+2+3 ≤ 3*k+2) {i:ℕ}
    (late:WilsonReceivedMeasuredStampPrice.opening R W.simple (q+2) order k deep aged zero_lt_one ≤ i+1)
    (weak:(eventually_atTop.mp (WilsonThermometerAncestralCalendar.weak R simple)).choose ≤ i)
    (mi:m ≤ i) (both:i+2 ≤ t)
    (days:((t-i:ℕ):ℝ) ≤ price*(Real.log (2+Real.log (R.alloy.B.a.clock.hatBeta i)))^degree)
    (booked:(eventually_atTop.mp (WilsonThermometerAncestralFunds.original R simple (degree+1) seats q l cap)).choose ≤ i)
    (oldRent:∀u,(inlet u).rent ≤ (g t)^(q+2)) (start:∀u,(g t)^l ≤ Poly.toll (inlet u).w full) 
    (way:WayStation R.kit) (station:WilsonCenteredCaptureClock.first R simple ≤ i) (sec:R.t 0 ≤ i)
    (slow:∀ j,((R.family.S.block j).val:ℝ) ≤ Real.log (RG16.Lambda R.family.path.levels j))
    (ready:WilsonReportLampForecast.Ready R.family.path.levels)
    (early:(eventually_atTop.mp (WilsonCenteredReporterClock.original R simple slow ready)).choose ≤ i)
    (activated:(eventually_atTop.mp (WilsonRootedKioskPostRadius.original R simple)).choose ≤ i)
    (force:q ≤ R.alloy.B.a.clock.J i)
    (opening:∀c ≤ seats, WilsonFirstReceivedEarnedFee.opening R simple c q order k (by omega) (by omega)
      (show (0:ℝ)<1/4 by norm_num) ≤ i)
    (saved:(eventually_atTop.mp (WilsonFullFaceSignedReserved.original R simple q)).choose ≤ i)
    (stripGrant:strip) (depth:ℕ) (H cap₀:ℝ) (hc:0 ≤ cap₀) (fit:k ≤ R.alloy.B.a.clock.J i)
    (heard:(eventually_atTop.mp (WilsonThermometerCenteredCompensation.original R simple D φ stripGrant order shelf
      k seats depth H cap₀ hc)).choose ≤ i)
    (fund:Volume.Fund D R.rolls tab φ books R.alloy.delay) (p:ℕ) (surplus:(p+1)+(3+(l+2)+87) ≤ q)
    (born:∀u v,(inlet u).passport.origin v=(R.family.S.toDepth top per).parent ((home₀ u).origin v))
    (room:(eventually_atTop.mp (WilsonThermometerRegisteredAbsoluteRoom.spatial R simple profile)).choose ≤ i)
    (space:|r| ≤ R.family.S.a i)
    {η:ℝ} {T:Campaign R} {camp:Campaign.Pillars R T} (funded:FundedOriginalProperties.{u} simple η camp)
    (J:Voice G) (clear:Clear G J) (axes:Lattice.Order) {ε:ℝ} (ep:0<ε)
    (active : max (WilsonJointAxialRoster.opening R simple funded slow J clear (Fintype.card (Fin 3)) width₀ q ep)
      (WilsonReceivedAxialFiling.opening R simple D φ stripGrant order shelf (Fintype.card (Fin 3)) ep) ≤ i)
    (priced : max (WilsonReceivedAxialFinite.opening R simple q ep)
      (WilsonReceivedAxialFinite.massOpening R D ages order shelf seats (k:=k) simple stripGrant) ≤ i)
    (gate : WilsonReportingForestAngularReflection.posted R) (accuracy : ε*((3:ℝ)^q+2)≤1)
    (clockLate : (eventually_atTop.mp (WilsonJointAxialClock.original R simple)).choose ≤ i)
    (rareLate : WilsonJointAxialScalar.opening (V:=Fin 3) R simple gate q width₀
      (p+(3+(l+2))+1+2*width₀*(Fintype.card (Fin 3))) ≤ i)
    (winding : (eventually_atTop.mp (WilsonCoveredOrdinaryWeightedPost.original R simple D φ ages stripGrant
      order shelf k seats 0 (Fintype.card (Fin 3)) (3+(l+2)) (p+1) 1 1 (fee (J₃)) zero_le_one ep)).choose ≤ i)
    (caps:Fin 3→ℕ) (admit:∀v,WilsonOriginalThermometerPalette.levels v<caps v) (test:Case caps):
    let live:i<N:=by omega
    ∃L:∀u:Grid,post i mi (offer₀ live u),
      (∀u:Grid,Reached R simple A top (home₀ u) hk D tab π Γ Ψ books ahead order shelf seats
        W mt (inlet u) (counted u) (q+2) 1 mi (show i ≤ t by omega) (L u)) ∧
      (∀(u:Grid) (v:Fin 3),0<(wallet₀ i (L u)) v ∧ (wallet₀ i (L u)) v≤1) ∧
      (∀(u:Grid) (v:Fin 3),(homes i (L u)) v=(R.family.S.toDepth live.le per).parent ((home₀ u).origin v)) ∧
      (∀u:Grid,(g (i+1))^(l+2) ≤ Poly.toll (L u).w full) ∧
      (∀x:Fine,WilsonThermometerRegisteredCenteredStore.Charged R A simple live (home₀ (cell x)) hk D tab π Γ Ψ
        books mi ahead order shelf seats (L (cell x)) q (p+1) 0 100 (measured R A UV₀ x.val) 1) ∧
      ∀(u:ℕ) (floor:m ≤ u) (atStop:u ≤ i),
        WilsonSingleHardRadius.start R simple 0 (zero_lt_one:0<(1:ℝ)) ≤ u →
        WilsonThermometerUnitFilingShapeReceived.Qualified R A simple UV₀ →
        A.station.checked f H₁ A.horizon →
        (∀j,A.change j ((Bel R.family.book).unit j)=(Bel R.family.book).unit j) →
        A.station.k<N →
        (∀v:Fin 3,‖WilsonThermometerCenteredScalar.read (measured R A UV₀ fun _=>0) {v}‖≤1) →
        TicketP R.alloy R.kit D tab →
    let hub:=measured R A UV₀ (fun _=>0)
    let comp:=corr hub (1:Poly J₃)
    let model:=fun (c:Grid) (U:Config G (R.family.side i per))=>((Ψ i).eval U:ℂ)*((pupil₀ i mi (L c) U)*comp).part full
    let tar:=fun c:Grid=>WilsonThermometerRegisteredCenteredHeldSource.originalCredit R A (home₀ c)
      (WilsonThermometerNominatedConnectedStop.coefficients comp) (atStop.trans live.le)
    let price₂:ℝ:=unit₀*(g (i+1))^(p+1)+5*(|fee (J₃)*stage₀ 100| *(4^q+2)*(g (i+1))^(p+1))
    ‖(∑x:Fine,fineW x.val*tar (cell x))-
      ∑x:Fine,fineW x.val*WilsonThermometerUnitFilingCoarse.reading R (N:=N) (model (cell x)) u atStop‖
      ≤ variation₀*(23*|price₂|):=by
  intro live
  have delivered(u:Grid):=WilsonThermometerRegisteredCenteredProgramme.original R simple A top (home₀ u)
    hk D tab π Γ Ψ books ahead order shelf seats W mt (inlet u) (counted u) refs path pass month fits packed q l degree cap
    deep aged late weak mi both days booked (oldRent u) (start u) way station sec slow ready early activated force opening saved
    stripGrant depth H cap₀ hc fit heard fund p surplus (born u) profile r room space u.val rfl u.property funded J clear
    axes ep active priced gate accuracy clockLate rareLate winding
  choose L trace homesAt paid nominated using delivered
  have capped:(∀(u:Grid) (v:Fin 3),0<(wallet₀ i (L u)) v ∧ (wallet₀ i (L u)) v≤1):=by
    have gclock:=(eventually_atTop.mp (WilsonThermometerAncestralCalendar.weak R simple)).choose_spec i weak N per
        (i+1) (Nat.le_succ i) (by omega)
    intro u
    exact (WilsonThermometerRegisteredInheritedAperture.capped R simple A top (home₀ u)
      hk D tab π Γ Ψ books ahead order shelf seats W mt (inlet u) (counted u) (q+2) 1 refs
      mi (by omega) (L u) (trace u) (capNames u) gclock.1 gclock.2).1
  have charged:∀x:Fine,WilsonThermometerRegisteredCenteredStore.Charged R A simple live (home₀ (cell x)) hk D tab π Γ Ψ
        books mi ahead order shelf seats (L (cell x)) q (p+1) 0 100 (measured R A UV₀ x.val) 1:=by
    intro x
    let phase:=fun _:Fin 3=>(0:ℂ→ₗ[ℝ] ℝ)
    let lift:=fun _:Side₀=>(0:Cover)
    have row:=nominated (cell x) caps admit phase N le_rfl (R.family.side N per) lift x.val test (fun _ _=>0)
    dsimp only at row
    simpa only [WilsonThermometerRegisteredCenteredSelfWeight.zero_source] using row.2.1
  refine ⟨L,trace,capped,homesAt,?_,charged,?_⟩
  · intro u
    exact WilsonThermometerRegisteredCenteredDatedAperture.original R simple A top (home₀ u)
      hk D tab π Γ Ψ books ahead order shelf seats W mt (inlet u) (counted u) q l (degree+1) i cap refs mi both
      (WilsonThermometerAncestralCalendar.counted R simple slow degree cap (by omega) days)
      booked weak (start u) (L u) (trace u)
  · intro u floor atStop gate₀ qual checks honest star means ticket
    exact WilsonThermometerRegisteredCenteredHeldSpan.original R simple A hk D tab π Γ Ψ books ahead order shelf seats
      r profile checks honest star refs W.course way ticket mi live floor atStop gate₀ qual L q p capped charged means

end YM.Integration.WilsonThermometerRegisteredCenteredHeldPurchase
