local notation "h_" S:max q:max => ∑v∈S,WilsonOlderFreshSoftSocketPole.lag R k (full R k q) v

theorem sameGrade (S:Finset (Fin n))(q:Selection R k S):
    (h_ S q)=Kick.depthF Finset.univ (fun j:S=>k j) (home R k S q):=by
  rw [WilsonOriginalPublicNodalOwners.depth,←Finset.sum_attach]
  apply Finset.sum_congr rfl
  intro v _
  dsimp only [WilsonOlderFreshSoftSocketPole.lag]
  rw [WilsonReceivedCanonicalVerseWeighted.chosen R k q v]

variable {j e:ℕ}{V:Realm G (e+1) Credit.leanC}{draw:V.draws=R.family.path.levels}{rate δ σ:ℝ}

theorem original (p:ℕ)(w:(a:Fin n)→R.family.label (k a))(S:Finset (Fin n))(simple:G.Simple)(vc:j+1≤c)(ck:c≤K)(kn:K≤N)
    (funded:Submitted R V draw D k N K j rate δ σ)
    (digits:Digits V.draws (Fin n)){I:Type}{n':Side}{P:Passport n' (Fin n)}
    (B:I→Binder P (Stock.census (Fin n)))(front:I→Fin n)(live:∀z,front z∈(B z).mode.val)
    (positive:∀z,0 < mass k (B z).mode.val)(y:Fin n → Cover)(t:Case D):
    ∃H:Selection R k S→Material R N (j+1) e k σ B,∃axis:∀q,(H q).tests=D,
      (∀q,      (H q).realm=V ∧ (H q).amplitude=rate ∧ (H q).allowance=δ ∧ (H q).pin=front ∧ (H q).root=y ∘ front ∧
      (∀z,HEq ((H q).source z) t) ∧
      (∀l,HEq ((H q).frill l) (WilsonReceivedDepositedOrbitalPrint.front (J:=(B l).mode.val) (front l) y)) ∧
      (∀[Fintype I](x:Affinity.Wallet (WilsonOriginalMixedBlockRows.room (Fin n)))(s:(Stock.census (Fin n)).Mode),
        WilsonOriginalCensusDatedHeldTariff.salary (H q) x s=(WilsonIndependentCollarLowerMass.copies B s:ℝ)*
          (‖∏v∈s.val,(x v).val‖*‖touch t s.val‖)) ∧
      (∀l,Real.exp (σ*(B l).length)*(1+∑r,(words (H q) l).fare r) ≤ WilsonReceivedDepositedOrbitalBudget.amount (H q) l) ∧
      ∀(J:Finset (Fin n))(f:Pen D J→L[ℝ] ℝ)(z:Fin n → Cover),
        Filed (N:=N) (K:=K) (i:=j+1) κ pt (onLevels draw digits) (full R k q) (measured (H q) (axis q) J f z) z J f) ∧
      (∀(z:Fin n → Cover)(u:ℝ),u≠0 → ∀{sid:Side}(U:Config G sid),
        let roots:=address R.family.path.levels (onLevels draw digits) (K-(j+1)) (j+1) z
        WilsonOriginalPublicTrialFigure.measured R (fun l:S=>k l) (regulatorRun R.family N p K)
          (fun l:S=>entire R (k l) K (N,p) (w l)) (fun l:S=>roots l) U=
            ∑q:Selection R k S,weight R k N p K w S q* change R k (N:=N) (p:=p) (K:=K) u S q*
              word R k κ pt u (fun l=>wrap sid (roots l)) S q U) ∧
      ∀(f:Pen D S→L[ℝ]ℝ)(z:Fin n → Cover)(P':XSpace.Period)(tree:P'.Tree)(m:ℕ),
        let roots:=address R.family.path.levels (onLevels draw digits) (K-(j+1)) (j+1) z
        (∑q:Selection R k S,weight R k N p K w S q*
          (PowerSeries.coeff m ((kinetic R.family.path.levels R.metals.O N K (j+1))^(h_ S q)*
            reading (measured (H q) (axis q) S f z).2 (Fin.elim0:Fin 0→YForest G)):ℝ))-
          PowerSeries.coeff m (paid R (fun l:S=>k l)
            (frozen R (fun l:S=>k l) (fun l:S=>entire R (k l) K (N,p) (w l)))
            (finite R (fun l:S=>k l) P' (fun l:S=>roots l) tree))=
        ∑q:Selection R k S,weight R k N p K w S q*(
          (PowerSeries.coeff (m+h_ S q) (reading ((WilsonOlderFreshSoftSocketSubmitted.source
            (N:=N) (K:=K) (i:=j+1) κ pt (onLevels draw digits) (full R k q) z S f).2)
              (Fin.elim0:Fin 0→YForest G)):ℝ)-
          PowerSeries.coeff (m+h_ S q) (sheet R k κ pt S roots 1 q P' tree)):=by
  obtain ⟨H,ax,book,all⟩:=WilsonOlderFreshSoftSocketRoster.original κ pt p w S simple vc ck kn funded
    digits B front live positive y t
  refine ⟨H,ax,book,?_,?_⟩
  · intro z u pos sid U
    exact WilsonOriginalPublicNodalBirth.original R k (p:=p) kn κ pt w S
      (address R.family.path.levels (onLevels draw digits) (K-(j+1)) (j+1) z) u pos U
  · intro f z P' tree m
    dsimp only
    rw [←all f z m 0 (Fin.elim0:Fin 0→YForest G),
      WilsonOriginalPublicNodalIndependent.original R k κ pt (p:=p) kn w S
        (address R.family.path.levels (onLevels draw digits) (K-(j+1)) (j+1) z) P' tree m]
    simp_rw [mul_sub]
    rw [Finset.sum_sub_distrib]
    congr 1
    apply Finset.sum_congr rfl
    intro q _
    rw [sameGrade]

