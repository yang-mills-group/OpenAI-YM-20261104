def Heard (N i per:ℕ)(hi:i<N)(F:Forest (step R i per).ratio)
    (tag:(step R i per).Choices)(M:family G h)(A₀:Case h)(t:Finset I):Prop:=
  let D:=WilsonOriginalRelativeFoldedQuiet.relative R N i per hi F (covered R N i per)
  let C:=(model R N i per hi).covariance F tag
  let x:=WilsonReceivedDepositedSocketRows.entered R N i per hi F M A₀
  Wick (Woods G (coarse R i per)) C (raiseE D*SignedJointSourceMoments.products x t)=
    Wick (Woods G (coarse R i per)) C (raiseE D)*
      flash (filed R N i per F (mass k t)
        ((WilsonReceivedDepositedVerseCensus.ordinary M A₀ t).1 (fine R i per)))

theorem original (simple:G.Simple)(quiet:WilsonReceivedCloseFundedHeat.Quiet R)
    (price:ℕ→Gear G→ℝ)(funded:FundedMarkedCoverRows.prices price R.kit)(e:ℕ):
    ∀ᶠj:ℕ in atTop,∀b,(jb:j<b) → ∀(J:Finset I)(a r:ℕ),a≤e →
    ∃s A C σ:ℝ,0<s ∧ 1≤A ∧ 0≤C ∧ 0<σ ∧
    ∀(N:ℕ),(top:b≤N) → ∀(Y:Realm G (e+1) Credit.leanC)(lo:Y.anchor≤j)
      (same:Y.draws=R.family.path.levels),Y.paid=R.metals.O → (Y.mint (j+1) (by omega)).σ ≤ s →
    ∀(S:Finset I)(cells:Digits R.family.path.levels I)(q:(i:I)→Choice R k i),
    let old:=fixed R k κ pt N b (j+1) cells q
    let offset:=fun (_:I → Cover)=>route R same cells j
    ∃X:Input Y lo S k h A,X.offsets=offset ∧
      (∀y,X.familyAt y=(submit old k e) (fun v=>(ll Y.draws j).L.val • y v+lift (offset y v))) ∧
      (∀y J,Same e (output X J N y) (fixed R k κ pt N b j cells q y J)) ∧
      (∀per (F:Forest (WilsonVacuumPreResetStationaryChange.step R j per).ratio) y A₀,
        WilsonOriginalCensusOrbitalDeposit.Receipt R k N j per F (X.familyAt y) A₀) ∧
      (∀per (F:Forest (step R j per).ratio) tag y A₀ t,
        Heard R k N j per (jb.trans_le top) F tag (X.familyAt y) A₀ t) ∧
      ∀n y,MarkU y J (WilsonNeutralTwoPrintPathCalendar.spent R k N j e n old y (cells j) J a r)
        ((fixed R k κ pt N b j cells q y J).2 a r) σ C :=by
  filter_upwards [WilsonOriginalCensusOrbitalDeposit.original R k κ pt simple quiet price funded e] with j pay
  intro b before J a r keep
  obtain ⟨s,A,C,σ,hs,works,hn,width,rule⟩:=pay b before J a r keep
  refine ⟨s,A,C,σ,hs,works,hn,width,?_⟩
  intro N top Y lo same coins fit S cells q old offset
  obtain ⟨X,layout,source,posted,revert,wound⟩:=rule N top Y lo same coins fit S cells q
  refine ⟨X,layout,source,posted,revert,?_,wound⟩
  intro per F tag y A₀ t
  exact WilsonReceivedDepositedSocketRows.normalized R N j per (before.trans_le top)
    F simple tag (X.familyAt y) (X.degree y) (X.empty y) A₀ t

