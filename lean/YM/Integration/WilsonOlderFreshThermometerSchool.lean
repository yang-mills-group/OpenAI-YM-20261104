def Filed (ε:ℝ):Prop:=
  ∀ᶠ m:ℕ in atTop,∀ N,m+1<N →
    ∃(π:ℕ→Layout G)(Γ:ℕ→Pace.Coin)(hk:Burn.horizon (K)+2 ≤ R.alloy.B.a.clock.J m)
      (lesson:∀i,∀lo:m ≤ i,i<N → Oak.Lesson (N:=N) R hk D Q₀ π Γ lo)(Ψ:∀per i,Rep G (R.family.side i per)),
      PlanV.Path D R.alloy Q₀ (Burn.horizon (K)) N m π Γ ∧
      (∀per,Concourse R.alloy R.kit R.T π Γ m N per (K) (Ψ per) ∧ Topline (Ψ per N) (R.family.path.levels.clock.forcedAllowance N)) ∧
      ∀ digit:Tours,∃T:WilsonOlderFreshThermometerSources.Table (m:=m) (N:=N) (Q:=Q) R dmax (σ₀),
        WilsonOlderFreshThermometerSources.Sold R fams a dmax depth (σ₀) digit T ∧
        (∀v per,WilsonOlderFreshLocatedFork.Arm R (request Q v) a (depth v) q ε m N per (σ₀) (digit v) (T v) (Ψ per)) ∧
        ∀per i(lo:m ≤ i)(live:i<N),∃op:Mentor.Opportunity (R.alloy.B.a.clock.J (i+1)) (R.alloy.B.a.clock.J i),
          op.count=(S).pieces ∧ op.stage=(S).order+1 ∧
          Nonempty (Oak.Calendar (N:=N) R hk D Q₀ π Γ (Ψ per) lo (lesson i lo live)) ∧
          ∀(I:Type)[Fintype I](owner:I→Fin 3)(sites:Fin 3→Site (R.family.side (i+1) per))
            (columns:∀z,Letter (R.family.labels.level (grades (owner z))))(films:∀z,Studio (dmax (owner z)))
            (A:Fin 3→Set ℂ)(charge:I→ℂ)(τ:ℝ),0<τ → τ ≤ 1 → (∀v(t:ℂ),t∈A v → ‖t‖ ≤ 1) → Wallet A →
            WilsonOlderFreshThermometerDated.Paid R D Q₀ fams a dmax depth digit T hk π Γ (Ψ per) books ahead
              lo live op (lesson i lo live) owner sites columns films A charge τ

theorem original (R:Run G)(simple:G.Simple){φ:ℕ → ℕ}(scroll:VowsR.LawScroll G φ)(a:hue G)
    (funded:WilsonOlderFreshLocatedFaculty.Elected R simple scroll a)
    (Q q:ℕ)(order:cut q ≤ Q)(dmax:Fin 3→ℕ)(depth:∀v,WilsonOlderFreshThermometerRoom.weight v<dmax v)
    (loc:Loc G 1)(ε:ℝ)(positive:0<ε):
    ∃(books:Mentor.Offices.Books (H simple R) R.rolls (tab simple R) φ)
      (ahead:Mentor.Forecast (H simple R) R.rolls (tab simple R) φ books),
      Treehouse.VariableHouse R (H simple R) (tab simple R) scroll books R.family.path.levels.clock.kernel.penalty ahead (stages R.metals.p) ∧
      Filed R (H simple R) (tab simple R) books ahead a Q q dmax depth ε:=by
  obtain ⟨books,ahead,house,all⟩:=funded
  have sale:=WilsonOlderFreshThermometerRoom.original R simple scroll a ⟨books,ahead,house,all⟩ Q q order dmax depth loc ε positive
  refine ⟨books,ahead,house,?_⟩
  have late:=eventually_ge_atTop (WilsonMeasuredSemesterSubpower.onset R 1 (by norm_num:0<(1:ℝ)))
  filter_upwards [sale,late] with m annual floor
  intro N live
  obtain ⟨π,Γ,hk,lesson,Ψ,path,std,bank⟩:=annual N live
  refine ⟨π,Γ,hk,lesson,Ψ,path,(fun per=>⟨(std per).1,(std per).2.1⟩),?_⟩
  intro digit
  obtain ⟨T,sold,arms⟩:=bank digit
  refine ⟨T,sold,(fun v per=>arms v per),?_⟩
  intro per i lo lower
  obtain ⟨journey,top,events⟩:=std per
  obtain ⟨cal,op,card,stage⟩:=events i lo lower
  refine ⟨op,card,stage,cal,?_⟩
  intro I inst owner sites columns films A charge τ pos small cap x
  exact WilsonOlderFreshThermometerDated.original R (H simple R) (tab simple R) _ a dmax depth digit T hk π Γ (Ψ per)
    books ahead lo lower op (lesson i lo lower) owner sites columns films A charge simple scroll house sold journey top
    card stage cal.some (floor.trans lo) τ pos small cap x

