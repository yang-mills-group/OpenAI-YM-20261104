private theorem top (K:ℕ)(x:Fin n→Site (R.family.side K per)):
    physical R x (le_refl K)=x:=by
  funext v
  let reg:=R.family.S.toDepth (le_refl K) per
  have gone:reg.embed (x v)=x v:=reg.embed_injective ((Next.Rank.Station.embed_comp reg reg reg _).symm)
  exact (congrArg reg.parent gone).symm.trans (reg.embed_parent _)

theorem original (φ:Test n){r:ℝ}(rp:0<r)
    (hi:Fits R.family.S (WilsonAddressedPublicFirstSites.original R draw φ).choose r m f)
    (lo:Fits R.family.S (factor R φ) r m f)(fine:f≤j+1+1)(early:m≤j)
    (z:Sites R (f,per) n)(occurs:WilsonCenteredCompactBooking.mass R φ r (f,per) z≠0):
    ∀v,parent R (by omega:m+1≤j+1+1) per (placed R fine z) v=0:=by
  let x:=placed R fine z
  let track:=tape draw fine z
  let spots:=homes track (0:Fin n→Lattice.Cover) m (j-m)
  let t:=addresses R (j+1) per spots (onLevels draw track)
  let ratio:=(R.family.path.levels.clock.op (j+1) per).ratio
  have seats:t=x:=(WilsonAddressedPublicFirstSites.original R draw φ).choose_spec.2 r rp hi.small m f per j
    hi.older hi.finer fine hi.margin z occurs early
  have housed:= (WilsonAddressedPublicFirstRoseHomes.original R draw φ rp lo.small lo.older lo.finer
    fine lo.margin z occurs early (b:=m+1) lo.older (Nat.succ_le_succ early)).1
  change ∀v,sites R ((Passport.point t).coarser ratio).origin _ v∈({0}:Support _) at housed
  rw [seats] at housed
  have lowered:((Passport.point x).coarser ratio).origin=physical R x (Nat.le_succ (j+1)):=by
    funext v
    change ratio.parent (x v)=_
    rw [←show physical R x (le_rfl) v=x v from congrFun (top R _ x) v]
    exact (Next.Rank.Station.parent_nested _ _ _ (R.family.S.block_odd (j+1))
      (R.family.S.toDepth_odd (le_refl (j+1+1)) per) _).symm
  rw [lowered, WilsonReceivedChronologicalMaterialSites.descended] at housed
  intro v
  change physical R x (by omega:m+1≤j+1+1) v=0
  exact Finset.mem_singleton.mp (housed v)

end YM.Integration.WilsonReceivedChronologicalFixedRoseGridOrigin
