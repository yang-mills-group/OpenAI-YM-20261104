private theorem positive (caps:Fin 3→ℝ):0<charge caps:=
  Finset.prod_pos fun i _=>lt_of_lt_of_le zero_lt_one (le_max_left 1 (caps i))
private theorem touched {D:Fin 3→ℕ}(t:Case D)(s:Faces){z:ℝ}(live:1≤z)(caps:Fin 3→ℝ)(debt:Fin 3→ℕ)
    (paid:∀i,‖t i‖≤caps i*z^(debt i)):
    ‖touch t s‖≤charge caps*z^(∑i,debt i):=by
  have pos:0≤z:=zero_le_one.trans live
  have resident(i:Fin 3):1 ≤ max 1 (caps i)*z^(debt i):=by
    calc 1=1*1:=by ring
         _≤_:=mul_le_mul (le_max_left ..) (one_le_pow₀ live) zero_le_one (zero_le_one.trans (le_max_left ..))
  calc _≤∏i∈s,‖t i‖:=WilsonIndependentCollarLowerMass.cartesian t s
       _≤∏i∈s,max 1 (caps i)*z^(debt i):=Finset.prod_le_prod (fun i _=>norm_nonneg (t i)) fun i _=>
         (paid i).trans (mul_le_mul_of_nonneg_right (le_max_right ..) (pow_nonneg pos _))
       _≤∏i:Fin 3,max 1 (caps i)*z^(debt i):=Finset.prod_le_prod_of_subset_of_one_le
         (Finset.subset_univ s) (fun i _=>zero_le_one.trans (resident i)) (fun i _ _=>resident i)
       _=charge caps*z^(∑i,debt i):=by rw [Finset.prod_mul_distrib,Finset.prod_pow_eq_pow_sum];rfl


theorem original (Φ:Test 3)(simple:G.Simple)(bliss:Bliss F l z H)(lead:Leading F Jr)
    (obedient:∀d:ℕ,∀ᶠr in trail,Frame.obedient F H (Jr r) d)
    (slow:WilsonWindowReportingPace.Slow R.kit)(shop:RG05Preconstruction.ReadoutPurchase R.b)
    (cap:∀j,1≤((P).budget j).supportExponent)(upper:∀j,((P).budget j).supportExponent≤100)
    (color:G.ColorIndex)
    (funded:WilsonOriginalAllOrderCourse.Paid.{u} axis simple ε (prepared schedule) R crop W)
    (paths:FundedOriginalVacuumPaths.prices R.kit)(T h:ℕ){δ:ℝ}
    (books:(t:{t:ℝ // 0<t ∧ t<δ})→Book F (l:=l) H z 6 T t.val)
    (delivered:∀t,WilsonMovingForkWindowBooks.Priced F (books t))(x:∀i:Fin 3,RG17.Free C (grade i).val):
    ∃edge:ℝ,0<edge ∧ ∃bank:ℕ,∀(target width:ℕ)(debt:Fin 3→ℕ),∃U:Set ℝ,U∈trail ∧
    let J₀:=cut (target+1) bank ((∑i,debt i)+1) (WilsonReceivedChronologicalFixedRosePooledMesh.width width (2*T+11+2*h))
    let lower:=J₀+9
    ∀D:Fin 3→ℕ,(∀i,ages i<D i) → ∀(caps:Fin 3→ℝ)(opt tol:ℝ),0≤opt → 0<tol →
    ∃bottom onset:ℕ,∃school:(v:ℕ)→ onset≤v→WilsonOriginalObservedRoseProbeShelf.Badge R D lower v bottom opt tol,
    ∀Q:ℕ,lower≤Q → ∃start:ℕ,∀ᶠv:ℕ in atTop,∃(entered:onset≤v),
    ∃(V:Realm G (Q+1) Credit.leanC)(draw:V.draws=P),
    V.paid=R.metals.O ∧ V.y=zz P ∧ V.anchor=v ∧ Covered R D Q v start V draw opt tol ∧
    (∀s:Finset (Fin 3),s.Nonempty → Stock R D Q v start V draw opt tol s) ∧
    ∀r∈U,∀ρ:Fin 3→{t:ℝ // 0<t ∧ t<δ},(∀i,r≤(ρ i).val ∧ (ρ i).val≤outer z h r) → (∃i,(ρ i).val=r) →
    let slots i:=reading F Jr Z (books (ρ i)) (grade i) (x i)
    let reporterDate:=reporter F books ρ
    ∀(K N per b c requested power tag:ℕ)(credit:ℝ)(bk:b≤K)(kn:K≤N),b<N →
    v≤reporterDate → reporterDate≤K → v≤c → ∀(live:c≤K), v+1≤K → σ K-σ (v-1)≤width*(1+Real.log (β v)) →
    let θ:=g N per v
    ∀(q₁:ℕ)(W:Realm G (q₁+1) Credit.leanC)(source:W.draws=(P))(first:ℕ),first+1≤v →
    ∀(file:Filed R ages K),0<r→(a) b≤r→4*(edge*r)<(a) c→
    let μ:=WilsonThermometerAlignedCells.mass (R:=R) r (b,per) Φ
    let Active:Type:={y:Site ((C).side b per) × Site ((C).side b per) // μ y≠0}
    ∀(panel:(o:Active)→{Z:Panel R ages N per b K bk kn requested power tag credit // Z.loc=atOrigin o.val}),
    (∀o,(panel o).val.slot=file.station) → (∀o,(panel o).val.axis=file.A N per) →
    (∀o i,(panel o).val.slot i=(slots i).j) →
    (∀o i,(panel o).val.names i=(slots i).arm.source (N,per)) →
    ∀(κ:(i:Fin 3)→Knob (D i))(pt:Fin 3→Chamber)
      (test:Active→Case D),(∀o i,‖test o i‖≤caps i*(θ⁻¹)^debt i) →
    let filed o:=tape source bk (panel o).val.loc
    let cells o:=onLevels source (filed o)
    let pins o:=address (P) (cells o) (c-v) v (homes (V:=W) (filed o) 0 first (v-1-first))
    let w o:=votes R ages (N:=N) (per:=per) file (panel o).val.names (panel o).val.turn
    let row j o s:=figure R ages κ pt N per K c v (cells o) s (w o) (pins o) (touch (test o) s) j θ
    let office:=school v entered
    let branchTest (o:Active)(s:Faces):=touch (fun i:s=>test o i.val) (univ:Finset s)
    let sourceSite (o:Active):=WilsonOriginalMicroscopicEntranceGridRow.pin R (bk.trans kn) (atOrigin o.val)
    let probe (o:Active)(s:Faces):=WilsonOlderFreshSoftRoseNodes.enrolled R D office.field office.draw N per c
      (live.trans kn) ((sourceSite o) 1,(sourceSite o) 2) s
      (WilsonOriginalObservedRoseProbePlace.ticket D s κ pt (test o))
    let occupied (o:Active)(s:Faces):=(WilsonOriginalObservedRoseProbeRead.quota (branchTest o s):ℂ)*
      WilsonOriginalObservedRoseHaarProbe.priced R D office.field s N K c v (probe o s) (g N per K)
        (fun i=>WilsonPositionProgramReportedField.entire R (ages i) K (N,per) (w o i)) lower θ
    let raw:=∑o:Active,μ o.val*((r:ℂ)^14*value (row Q o))
    let low:=∑o:Active,μ o.val*((r:ℂ)^14*value (occupied o))
    (∀(o:Active)(s:Faces) b,WilsonCoeffUV.Mer.Auth (WilsonCoeffUV.Wheel.Mark.mass (WilsonOlderFreshSoftRoseCourse.grade ∘ seat s) (Finset.univ:Finset s))
      (WilsonOriginalObservedRoseHaarProbe.source R D office.field s N K c (probe o s) (XSpace.Bare.chart G) b)) ∧
    (∀o s,WilsonOriginalObservedRoseProbeRead.quota (branchTest o s)≤
      (∏i∈s,max 1 (caps i))*(θ⁻¹)^(∑i∈s,debt i)) ∧ ‖raw-low‖≤(∫z:Points 3,‖Φ z‖)*θ^target:=by
  obtain ⟨edge,hEdge,nodes⟩:=WilsonOriginalObservedRoseProbeNodes.original R Φ
  refine ⟨edge,hEdge,?_⟩
  obtain ⟨bank,booked⟩:=WilsonOriginalObservedRosePooledConnected.original F Jr Z simple bliss lead obedient slow shop cap upper color funded paths T h books delivered x
  refine ⟨bank,?_⟩
  intro target width debt
  obtain ⟨U,active,cal⟩:=booked (target+1) (∑i,debt i) width
  refine ⟨U,active,?_⟩
  intro J₀ lower D fits caps opt tol op tp
  obtain ⟨_,lowPrice⟩:=cal lower le_rfl D fits (charge caps) opt tol (positive caps).le op tp
  obtain ⟨bottom,onset,⟨school⟩⟩:=WilsonOriginalObservedRoseProbeShelf.original simple funded D fits lower opt tol op tp
  refine ⟨bottom,onset,school,?_⟩
  intro Q high
  obtain ⟨start,paidQ⟩:=cal Q high D fits (charge caps) opt tol (positive caps).le op tp
  refine ⟨start,?_⟩
  filter_upwards [paidQ,lowPrice,eventually_ge_atTop onset,WilsonSeparatedPrefixKineticGeometry.spend R simple 2 0]
    with v earned earlier entered income
  obtain ⟨V,draw,scheme,heat,anchor,covered,stock,hear⟩:=earned
  obtain ⟨_,_,_,_,_,_,_,lowHear⟩:=earlier
  refine ⟨entered,V,draw,scheme,heat,anchor,covered,stock,?_⟩
  intro r hr ρ home nearest slots reporterDate K N per b c requested power tag credit bk kn deep vf fk vc ck next span θ q₁ W source first old file radius fine inside μ Active panel stations axes heads names κ pt test paid filed cells pins w row office branchTest sourceSite probe occupied raw low
  have cash:2≤θ⁻¹:=by simpa only [pow_zero,mul_one] using income N per ((vc.trans ck).trans kn)
  have cold:1≤θ⁻¹:=(by norm_num : (1:ℝ)≤2).trans cash
  have gp:0<θ:=ActualRunKernelPackets.regulator_pos R N per v ((vc.trans ck).trans kn)
  have unit:2*θ≤1:=by simpa only [inv_mul_cancel₀ gp.ne'] using mul_le_mul_of_nonneg_right cash gp.le
  refine ⟨fun o s b=>(WilsonOriginalObservedRoseHaarProbe.admitted R D office.field s N K c (probe o s) simple ck kn b).2.2,
    fun o s=>WilsonOriginalObservedRoseProbePurse.original s (test o) caps debt (θ⁻¹) cold (paid o),?_⟩
  have placed (o:Active)(s:Faces):
      WilsonOriginalObservedRoseProbeRead.filed R D s κ pt (fun j (i:s)=>(cells o) j i.val)
        (fun i:s=>(pins o) i.val) office.field office.draw (branchTest o s)=probe o s:=by
    have live:v-1+1=v:=by omega
    have home:=nodes bk kn ck (v:=v-1) (first:=first) (by omega) (by omega) radius fine inside o.val o.property W source
      office.field office.draw D s κ pt (test o)
    simp only [live] at home
    dsimp only [cells,pins,filed,branchTest]
    rw [(panel o).property]
    exact home
  have equality (o:Active)(s:Faces):row lower o s=occupied o s:=by
    have same:=WilsonOriginalObservedRoseProbeRead.original R D s κ pt N per K c v (w o) lower θ office.field office.draw office.paid
      simple (RunFormalChain.fromRun R).receipt vc ck kn (cells o) (pins o) (test o) v
    change row lower o s=(WilsonOriginalObservedRoseProbeRead.quota (branchTest o s):ℂ)*
      WilsonOlderFreshSoftRoseMarket.row (R:=R) D office.field s N K c v v
        (WilsonOriginalObservedRoseProbeRead.filed R D s κ pt (fun j (i:s)=>(cells o) j i.val)
        (fun i:s=>(pins o) i.val) office.field office.draw (branchTest o s)) _ _ lower θ false at same
    rw [placed o s] at same
    refine same.trans ?_
    exact congrArg ((WilsonOriginalObservedRoseProbeRead.quota (branchTest o s):ℂ)*·)
      (WilsonOriginalObservedRoseHaarProbe.original R D office.field s N K c v (probe o s) (g N per K)
        (fun i=>WilsonPositionProgramReportedField.entire R (ages i) K (N,per) (w o i)) lower θ office.paid v)
  have each (o:Active):r^14*‖value (row Q o)-value (occupied o)‖≤θ^target:=by
    let center:=fun p:Faces=>WilsonOlderFreshSoftSocketTotal.normalized R ages κ pt N per K c v
      (cells o) p (w o) (pins o) (touch (test o) p) J₀ θ
    have cost:=fun (p:Faces) (_:p.Nonempty)=>touched (test o) p cold caps debt (paid o)
    have high:r^14*‖value (row Q o)-value center‖≤θ^(target+1):=hear r hr ρ home nearest K N per b c
      requested power tag credit bk kn deep vf fk vc ck next span file (panel o).val (stations o) (axes o)
        (heads o) (names o) κ pt (cells o) (pins o) (fun p=>touch (test o) p) cost
    have low:r^14*‖value (row lower o)-value center‖≤θ^(target+1):=lowHear r hr ρ home nearest K N per b c
      requested power tag credit bk kn deep vf fk vc ck next span file (panel o).val (stations o) (axes o)
        (heads o) (names o) κ pt (cells o) (pins o) (fun p=>touch (test o) p) cost
    rw [←show row lower o=occupied o from funext (equality o)]
    have gap:=norm_sub_le (value (row Q o)-value center) (value (row lower o)-value center)
    rw [sub_sub_sub_cancel_right] at gap
    calc _≤r^14*(‖value (row Q o)-value center‖+‖value (row lower o)-value center‖):=
           mul_le_mul_of_nonneg_left gap (pow_nonneg radius.le 14)
         _≤θ^(target+1)+θ^(target+1):=by rw [mul_add];exact add_le_add high low
         _=(2*θ)*θ^target:=by rw [pow_succ];ring
         _≤_:=by simpa only [one_mul] using mul_le_mul_of_nonneg_right unit (pow_nonneg gp.le target)
  have massBound:(∑o:Active,‖μ o.val‖)≤∫z:Points 3,‖Φ z‖:=by
    apply le_trans _ (WilsonThermometerAlignedCells.variation (R:=R) r (b,per) Φ)
    let ι:Active↪(Site ((C).side b per) × Site ((C).side b per)):=⟨Subtype.val,Subtype.val_injective⟩
    have identical:(∑o:Active,‖μ o.val‖)=∑z∈(Finset.univ:Finset Active).map ι,‖μ z‖:=by rw [Finset.sum_map];rfl
    rw [identical]
    exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _) (fun _ _ _=>norm_nonneg _)
  change ‖(∑o:Active,μ o.val*((r:ℂ)^14*value (row Q o)))-
    ∑o:Active,μ o.val*((r:ℂ)^14*value (occupied o))‖≤_
  rw [←Finset.sum_sub_distrib]
  calc _≤∑o:Active,‖μ o.val‖*θ^target:=by
         apply (norm_sum_le ..).trans
         apply Finset.sum_le_sum
         intro o _
         rw [←mul_sub,←mul_sub,norm_mul,norm_mul,norm_pow,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg radius.le]
         exact mul_le_mul_of_nonneg_left (each o) (norm_nonneg _)
       _=(∑o:Active,‖μ o.val‖)*θ^target:=(Finset.sum_mul ..).symm
       _≤_:=mul_le_mul_of_nonneg_right massBound (pow_nonneg gp.le _)

end YM.Integration.WilsonOriginalObservedRosePooledMarket
