theorem price (z:I):WilsonIndependentCollarMaterialIntensity.price H z≤WilsonOriginalTwoFlatIRFlatBudget.budget H z:=by
  let S:=(binder side y z).mode.val
  let a:=(∏i∈S,‖H.source z i‖)*(R.family.path.levels.clock.hatBeta (j+1)^H.allowance*H.amplitude^S.card)
  have pos:0≤a:=by
    have beta:0<R.family.path.levels.clock.hatBeta (j+1):=zero_lt_one.trans (R.alloy.B.a.fits.delayed (j+1))
    exact mul_nonneg (prod_nonneg fun _ _=>norm_nonneg _)
      (mul_nonneg (Real.rpow_nonneg beta.le _) (pow_nonneg H.nonneg _))
  have one (u:Fin (e+1)):((mass k S+u.val+1:ℕ):ℝ)*a≤((mass k S+e+1:ℕ):ℝ)*a:=by
    apply mul_le_mul_of_nonneg_right _ pos
    exact_mod_cast Nat.add_le_add_right (Nat.add_le_add_left (Nat.le_of_lt_succ u.isLt) _) _
  change (∑u:Fin (e+1),((mass k S+u.val+1:ℕ):ℝ)*a)≤_
  calc
    _ ≤ ∑_:Fin (e+1),((mass k S+e+1:ℕ):ℝ)*a:=sum_le_sum fun u _=>one u
    _ = _:=by simp only [sum_const,card_univ,Fintype.card_fin,nsmul_eq_mul];rfl

theorem literal (housed:∀i,wrap side (y i)=0)(z:I):(binder side y z).length=0:=by
  apply Nat.eq_zero_of_le_zero
  have bound:=WilsonOriginalCensusFaceSites.tariff side y z
  simpa [WilsonOriginalCensusFaceSites.root,housed] using bound

theorem original (filed:Filed (K:=K) (draw:=draw) (rate:=rate) (δ:=δ) cells κ pt seed side y t H)
    (housed:∀i,wrap side (y i)=0):
    ∑z:I,Real.exp (σ₀*(binder side y z).length)*WilsonIndependentCollarSlateIntensity.amount
      (words H z) (binder side y z).center ≤ ∑z:I,head (R:=R) (k:=k) (e:=e) (δ:=δ) (rate:=rate) (j:=j) t z:=by
  apply sum_le_sum
  intro z _
  have raw:=WilsonIndependentCollarMaterialWallet.original H z
  have compact:σ₀*((binder side y z).length:ℝ)-(32*σ₀)*
      (feeH (toe (binder side y z).mode.val (H.pin z) (H.root z) (H.frill z)) (H.pin z) (binder side y z).mode.val:ℝ)≤0:=by
    rw [literal y housed z,Nat.cast_zero,mul_zero,zero_sub]
    exact neg_nonpos.mpr (mul_nonneg (mul_nonneg (by norm_num) H.radius.le) (Nat.cast_nonneg _))
  have nonneg:0≤WilsonIndependentCollarMaterialIntensity.price H z:=by
    apply sum_nonneg;intro u _
    unfold WilsonOlderFreshConnectedRoll.cost
    have beta:0<R.family.path.levels.clock.hatBeta (j+1):=zero_lt_one.trans (R.alloy.B.a.fits.delayed (j+1))
    exact mul_nonneg (Nat.cast_nonneg _) (mul_nonneg (prod_nonneg fun _ _=>norm_nonneg _)
      (mul_nonneg (Real.rpow_nonneg beta.le _) (pow_nonneg H.nonneg _)))
  have bounded:=raw.trans ((mul_le_mul_of_nonneg_right (Real.exp_le_one_iff.mpr compact) nonneg).trans_eq (one_mul _))
  apply (bounded.trans (price y H z)).trans_eq
  obtain ⟨tests,knobs,et,_,paid,address,_⟩:=filed
  obtain ⟨_,axes,gross,rent,_,_⟩:=paid
  subst D
  obtain rfl:=eq_of_heq et
  unfold WilsonOriginalTwoFlatIRFlatBudget.budget WilsonOriginalTwoFlatIRFlatSalary.head
  rw [gross,rent,address.ink z,show (binder side y z).mode=z.val by rfl]
  ring

end YM.Integration.WilsonOriginalTwoFlatIRCapturedSalary
