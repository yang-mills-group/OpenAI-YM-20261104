private theorem splice {r fee z τ:ℝ}(rp:0≤r)(cp:0≤fee)(rich:2≤z)(tp:0≤τ)(small:τ≤1)
    (high middle low:ℂ)(hb:r*‖middle‖≤fee)(hc:r*‖low‖≤fee)(ab:r*‖high-middle‖≤fee*τ)(bc:r*‖middle-low‖≤fee*τ):
    r*‖high‖≤fee*z ∧ r*‖low‖≤fee*z ∧ r*‖high-low‖≤fee*z*τ:=by
  have twice:fee+fee≤fee*z:=by calc _=fee*2:=by ring
                               _≤_:=mul_le_mul_of_nonneg_left rich cp
  have sz:fee*τ≤fee:=mul_le_of_le_one_right cp small
  have norm_high:‖high‖≤‖high-middle‖+‖middle‖:=by calc
    ‖high‖=‖(high-middle)+middle‖:=by rw [sub_add_cancel]
    _≤_:=norm_add_le _ _
  have norm_gap:‖high-low‖≤‖high-middle‖+‖middle-low‖:=by calc
    ‖high-low‖=‖(high-middle)+(middle-low)‖:=by congr 1;ring
    _≤_:=norm_add_le _ _
  refine ⟨?_,hc.trans (by linarith),?_⟩
  · calc _≤r*(‖high-middle‖+‖middle‖):=mul_le_mul_of_nonneg_left norm_high rp
         _=r*‖high-middle‖+r*‖middle‖:=mul_add _ _ _
         _≤fee+fee:=add_le_add (ab.trans sz) hb
         _≤_:=twice
  · calc _≤r*(‖high-middle‖+‖middle-low‖):=mul_le_mul_of_nonneg_left norm_gap rp
         _=r*‖high-middle‖+r*‖middle-low‖:=mul_add _ _ _
         _≤fee*τ+fee*τ:=add_le_add ab bc
         _=(fee+fee)*τ:=by ring
         _≤_:=mul_le_mul_of_nonneg_right twice tp

theorem original (simple:G.Simple)(bliss:Bliss F l z H)(lead:Leading F Jr)
    (obedient:∀d:ℕ,∀ᶠr in trail,Frame.obedient F H (Jr r) d)
    (slow:WilsonWindowReportingPace.Slow R.kit)(shop:RG05Preconstruction.ReadoutPurchase R.b)
    (cap:∀j,1≤((P).budget j).supportExponent)(upper:∀j,((P).budget j).supportExponent≤100)
    (quote:OPE.Therm.Poetry (P))(color:G.ColorIndex)
    (funded:WilsonOriginalAllOrderCourse.Paid.{u} axis simple ε (prepared schedule) R crop W)
    (paths:FundedOriginalVacuumPaths.prices R.kit):
    ∃bank:ℕ,∀target debt width:ℕ,∃U:Set ℝ,U∈trail ∧
    let J₀:=cut target bank (debt+1) width
    ∀Q:ℕ,J₀+9≤Q → ∀L:ℕ,∀D:Fin 3→ℕ,(∀i,ages i<D i) → ∀X opt tol:ℝ,0≤X → 0≤opt → 0<tol →
    ∃start:ℕ,∀ᶠv:ℕ in atTop,∃(V:Realm G (Q+1) Credit.leanC)(draw:V.draws=P),
    V.paid=R.metals.O ∧ V.y=zz P ∧ V.anchor=v ∧ Covered R D Q v start V draw opt tol ∧
    (∀s:Finset (Fin 3),s.Nonempty → Stock R D Q v start V draw opt tol s) ∧
    ∀r∈U,∀{T:ℕ}(B:Book F (l:=l) H z 6 T r),WilsonMovingForkWindowBooks.Priced F B →
    ∀actual:Next.UVStress.Lifts (C) B.k,let K:=berth R width B.W.k
    v≤B.W.k → ∀(N per b c requested power tag:ℕ)(credit:ℝ)(bk:b≤K)(kn:K≤N),b<N →
    v≤c → c≤K → v+1≤K → σ K-σ v≤L*Real.log (β v) →
    let θ:=g N per v
    ∀(file:Filed R ages K)(panel:Panel R ages N per b K bk kn requested power tag credit),
    panel.slot=file.station → panel.axis=file.A N per → (∀i,panel.slot i=B.W.k) →
    (∀i,panel.names i=WilsonNeutralOffsetCutoff.named R (group F Jr Z B actual) N per i) →
    ∀(κ:(i:Fin 3)→Knob (D i))(pt:Fin 3→Chamber)(cells:Digits (P) (Fin 3))(y:Fin 3→ Cover)
      (test:(s:Faces)→Pen D s→L[ℝ]ℝ),(∀s:Faces,s.Nonempty → ‖test s‖≤X*(θ⁻¹)^debt) →
    let w:=votes R ages (N:=N) (per:=per) file panel.names panel.turn
    let row j s:=normalized R ages κ pt N per K c v cells s w y (test s) j θ
    let ink s:=figure R ages κ pt N per K c v cells s w y (test s) Q θ
    r^14*‖value ink-value (row J₀)‖≤θ^target:=by
  obtain ⟨E,offers⟩:=WilsonOriginalObservedRosePublicFigureGross.original F Jr Z simple bliss lead obedient slow shop cap upper quote color funded paths
  refine ⟨E,?_⟩
  intro target debt width
  let A:=WilsonOriginalObservedRosePublicMesh.aperture width
  obtain ⟨U,active,calendar⟩:=offers debt A
  refine ⟨U,active,?_⟩
  intro J₀ Q retained L D fits X opt tol xp op tp
  have all:=Filter.eventually_all.mpr (fun s:{s:(J).Mode // s.val.Nonempty}=>calendar Q J₀ retained L D s.val s.property X xp)
  obtain ⟨start,school⟩:=WilsonOlderFreshSoftSocketFigureRoom.original R funded D fits Q opt tol op tp
  refine ⟨start,?_⟩
  filter_upwards [all,school,WilsonOriginalObservedRosePublicMesh.original R simple slow width L,
    WilsonSeparatedPrefixKineticGeometry.spend R simple 21 0] with v rates bought mesh spend
  obtain ⟨V,draw,scheme,heat,anchor,complete,covered,issued⟩:=bought
  refine ⟨V,draw,scheme,heat,anchor,covered,issued,?_⟩
  intro r hr T B book actual K vj N per b c requested power tag credit bk kn deep vc ck next span θ file panel stations axes homes names κ pt cells y test capFee w row ink
  have top:r/(a K)≤(θ⁻¹)^A:=calc
    _=B.W.wheel.r/(a K):=congrArg (fun x:ℝ=>x/(a K)) B.active.symm
    _≤_:=mesh B.W.k vj B.W.b B.checked.high.2 N per kn span
  have shaped:(a B.W.k)≤r:=(WilsonReflectedPublicBulbBerth.mesh R B.W B.checked).trans B.active.le
  have first: (a B.W.k)/(a K)≤(θ⁻¹)^A:=(div_le_div_of_nonneg_right shaped ((C).S.a_pos K).le).trans top
  let printed:Digits V.draws (Fin 3):=draw.symm ▸ cells
  have same:cast (congrArg (fun q=>Digits q (Fin 3)) draw) printed=cells:=restored draw _
  have enrolled (s:Faces)(hs:s.Nonempty):
      (∀k:ℕ,k≤Q → r^(height ages s)*‖row k s‖≤(θ⁻¹)^(base E debt+A*height ages s)) ∧
      r^(height ages s)*‖row Q s-row J₀ s‖≤(θ⁻¹)^(base E debt+A*height ages s)*θ^J₀ ∧
      r^(height ages s)*‖ink s-row Q s‖≤(θ⁻¹)^(base E debt+A*height ages s)*θ^J₀:=by
    have entry:=rates (⟨maskOf s,hs⟩) V draw scheme heat anchor.le (mass_on s ▸ complete s)
      r hr B book actual N per b K c requested power tag credit bk kn deep vc ck next span panel file stations axes homes names first top κ pt printed y (test s) (capFee s hs)
    simpa only [ink,row,w,θ,maskOf,same] using entry
  have vn:v≤N:=((vc.trans ck).trans kn)
  have gp:0<θ:=ActualRunKernelPackets.regulator_pos R N per v vn
  have cash:21≤θ⁻¹:=by simpa only [pow_zero,mul_one] using spend N per vn
  have rich:1≤θ⁻¹:=(by norm_num : (1:ℝ)≤21).trans cash
  have small:θ≤1:=by
    have cost:1≤1/θ:=by simpa only [one_div] using rich
    simpa using (le_div_iff₀ gp).mp cost
  have kept:J₀≤Q:=by omega
  have radius:0≤r:=B.W.wheel.rad.le.trans B.active.le
  have converted (s:Faces)(hs:s.Nonempty):
      let h:=height ages s
      let fee:=(θ⁻¹)^(base E (debt+1)+A*h)
      r^h*‖ink s‖≤fee ∧ r^h*‖row J₀ s‖≤fee ∧ r^h*‖ink s-row J₀ s‖≤fee*θ^J₀:=by
    intro h fee
    have record:=enrolled s hs
    have degree:base E debt+A*h+1=base E (debt+1)+A*h:=by
      dsimp only [WilsonOriginalObservedRosePublicGross.base]
      omega
    have pay:(θ⁻¹)^(base E debt+A*h)*θ⁻¹=fee:=by rw [←pow_succ,degree]
    have invoice:=splice (pow_nonneg radius h) (pow_nonneg (inv_nonneg.mpr gp.le) (base E debt+A*h))
      ((by norm_num : (2:ℝ)≤21).trans cash) (pow_nonneg gp.le J₀) (pow_le_one₀ gp.le small)
      (ink s) (row Q s) (row J₀ s) (record.1 Q le_rfl) (record.1 J₀ kept) record.2.2 record.2.1
    simpa only [pay] using invoice
  have combined:=WilsonOriginalObservedRoseSevenScale.original ink (row J₀) radius
    rich (pow_nonneg gp.le J₀) A (base E (debt+1)) (fun s hs=>(converted s hs).1)
    (fun s hs=>(converted s hs).2.1) (fun s hs=>(converted s hs).2.2)
  exact combined.trans (paid_cut gp cash target E (debt+1) width)

