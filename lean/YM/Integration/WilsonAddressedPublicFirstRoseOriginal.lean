theorem original {rentLimit tol:ℝ}
    (origin:∀q:Selection R d mask.val,Source R day.hk (roots semester R simple) (tab semester R simple) day.π day.Γ (day.Ψ per)
      school.books (old.trans early) op (day.lessons (j+1) (Nat.le_succ_of_le (old.trans early)) live)
      school.ahead d (seed q) (adult) (spots) (cells) (ask).order (ask).shelf rentLimit)
    (position:(o)=placed R fine panel.loc)
    (tags : ∀t:Covers R.family.path.levels.S (j+1) (sideₗ),(step R (j+1) t.val).Choices)
    (breadthCap:ℕ)
    (fit : (ask).order ≤ Burn.horizon (ask).vac+1)(shelved : (ask).shelf ≤ (clock).J (j+1))
    (count : op.count ≤ Burn.horizon (ask).vac+2)(depth : 2*rentOrder+8 ≤ (ask).order)(age : rentOrder+3 ≤ 3*(ask).vac+2)
    (ready : WilsonReceivedMeasuredStampPrice.opening R simple rentOrder (ask).order (ask).vac depth age
      (by norm_num:0<(1:ℝ)) ≤ j+1)
    (loDepth : lowOrder ≤ (clock).J (j+1))(loShelf : lowShelf ≤ (clock).J j)
    (loSeats : (ask).school.pieces ≤ Burn.horizon (ask).vac+2)
    (halo : (eventually_atTop.mp (WilsonOriginalOccupiedRaffleIndependent.halo R simple)).choose ≤ j+1)
    (income : (eventually_atTop.mp (WilsonEmittedOriginalCalendar.wages R simple)).choose ≤ j+1)
    (upperWidth : scale ≤ 1)
    (sold : (eventually_atTop.mp ((Next.Rank.Station.hat_rate R.family.path.levels simple).eventually_ge_atTop
      (max 1 (WilsonOriginalCensusCanonicalRows.ceiling R d 1)))).choose ≤ j+1)
    (rent : rentLimit ≤ (Pert.Asymptotics.regulatorRun R.family N per (j+1+1))^rentOrder)
    (tube : LinkTube G)(front : (t:Multi.Hot (marks)) → t.val.val)
    (teacher : 0<σₗ ∧ Real.exp ((σₗ)⁻¹^2)≤(Hhat) ∧
      (((day.Ψ per) (j+1)).p.supportExponent+2)*((((day.Ψ per) (j+1)).p.B:ℝ)⁻¹)≤(σₗ)/2 ∧
      (Real.sqrt ((day.Ψ per) (j+1)).beta)⁻¹≤1/2 ∧ ((day.Ψ per) (j+1)).p.B=Nat.ceil ((Real.log (Hhat))^2) ∧
      ((day.Ψ per) (j+1)).p.supportExponent+2≤102)
    (menu : WilsonOriginalCensusCanonicalRelativePeriodSchedule.Appointment R simple d lens pt
      (fun _ : Fin 3=>4) tube (ask).order lowOrder target precision (WilsonAddressedPublicFirstRanks.original d P).2.2.2.1)
    (go : menu.first ≤ j+1)(board : menu.period (j+1) breadthCap ≤ per)
    (near : ∀t : Multi.Hot (marks), breadth t.val.val (front t).val 0
      (relative t.val.val (front t).val (spots)) ≤ breadthCap)
    (pieces:op.count=(ask).school.pieces)
    {u b geomCost roomSize:ℕ}{η:ℝ}(ep:0<η)(tp:0<tol)
    (two:2≤(bound))
    (late:(eventually_atTop.mp (WilsonReceivedChronologicalPanelClock.original R simple ask (charges) P
      geomCost precision target (bound) tol η two tp ep)).choose ≤ b)
    (floorOld:WilsonSingleHardRadius.first R simple ≤ m)(oldEar:m ≤ u)(ub:u≤b)(bj:b≤j)
    (geo:R.family.S.a b/R.family.S.a (j+1+1)≤(R.family.path.levels.clock.hatBeta b)^geomCost)
    (support:∀i,(R.family.path.levels.budget i).supportExponent=100)
    {df:ℕ}{frame:Frame G df}(section_:SectionData frame)(group:Hol G)
    (Z:Support (R.family.side b per))(center:Site (R.family.side b per))(held:center∈Z)
    (homes:∀i∈mask.val,sites R (home) (Nat.le_succ_of_le bj) i∈Z)
    (roof:coverNumber ((day.Ψ per) b).p.B Z ≤ roomSize)
    {e:ℕ}(ue:u≤e)(eb:e≤b)(bf:b≤f)
    (arrival:Reading R d panel (eb.trans bf))(one:∀i,1≤panel.M i)(E:Fin 3→ℕ)
    (refs:∀i t,t≤d i→R.family.ref t≤N)
    (fees:∀i,Next.Rank.Spindle.paid R.family (d i) f N per (panel.names i)≤
      panel.M i*(R.family.path.levels.clock.hatBeta f)^(E i))
    (desired:ℕ)(within:desired+∑i∈mask.val,E i≤requested):

    ‖reading R (N:=N) (credit R.family N per 0 (physical R d panel.names panel.turn panel.loc mask)
          (j+1+1) live) e ((eb.trans bf).trans fine)-
      ∑q:Selection R d mask.val,(wt q)*reading R (N:=N) (fun U=>((row₀ q) (j+1) U).part mask)
        e (Nat.le_succ_of_le (eb.trans bj))‖ ≤
      (∏i∈mask.val,WilsonAddressedHomeDose.ceiling (R:=R) (d i) (panel.M i))*
         ((R.family.path.levels.clock.hatBeta f)^desired)⁻¹+
      (due)*(WilsonReceivedChronologicalLastFlat.wage mask P roomSize η*(gAt b)^P):=by
  classical
  let L:=Selection R d mask.val
  let x:=reading R (N:=N) (credit R.family N per 0 (physical R d panel.names panel.turn panel.loc mask)
          (j+1+1) live) e ((eb.trans bf).trans fine)
  let up:L→ℂ:=fun q=>reading R (N:=N) (fun U=>((row₀ q) (j+1+1) U).part mask) e ((eb.trans bf).trans fine)
  let lo:L→ℂ:=fun q=>reading R (N:=N) (fun U=>((row₀ q) (j+1) U).part mask) e (Nat.le_succ_of_le (eb.trans bj))
  let d₀:L→ℂ:=fun q=>WilsonOriginalJointTrialHearing.fee R N per
      (1:Config G (R.family.side e per)) (row₀ q) (j+1) mask
  have board₀:=WilsonReceivedChronologicalFixedRoseArrival.original
    (R:=R) (N:=N) (per:=per) (grades:=d) (V:=V) (draw:=draw) (rate:=rate) (allowance:=allowance)
    (power:=zeroFee) (P:=P) (house:=school) (day:=day) (κ:=fun i=>contact (lens i)) (pt:=pt)
    (top:=j+1+1) (first:=first) (valid:=live) (toll:=toll) (old:=old) (test:=present lens)
    (classroom:=classroom) (fine:=fine) (panel:=panel) (file:=file) (s:=mask) (testCap:=paid) (hd:=adult)
    (prior:=prior) (σ:=fun _=>scale) station axes (eb.trans bf) arrival one E refs fees desired within
  have issued (q:L):up q-lo q=d₀ q:=by
    obtain ⟨_,_,_,_,_,_,_,hi,low⟩:=WilsonAddressedPublicFirstBank.original (R:=R) (simple:=simple) (d:=d) (P:=P) (school:=school)
      (day:=day) (old:=old) (early:=early) (live:=live) (op:=op) (lens:=lens) (pt:=pt) (toll:=toll)
      (classroom:=classroom) (fine:=fine) (z:=panel.loc) (mask:=mask) (q:=q) (paid:=paid) (hd:=adult)
      (prior:=prior q) (origin:=origin q) (position:=position) (tags:=tags) (breadthCap:=breadthCap)
      (fit:=fit) (shelved:=shelved) (count:=count) (depth:=depth) (age:=age) (ready:=ready)
      (loDepth:=loDepth) (loShelf:=loShelf) (loSeats:=loSeats) (halo:=halo) (income:=income)
      (upperWidth:=upperWidth) (sold:=sold) (rent:=rent) (tube:=tube) (front:=front) (teacher:=teacher)
      (menu:=menu) (go:=go) (board:=board) (near:=near)
      (pieces:=pieces) (s:=mask) (ep:=ep) (tp:=tp) (two:=two) (late:=late) (floorOld:=floorOld)
      (oldEar:=oldEar) (ub:=ub) (bj:=bj) (geo:=geo) (np:=by decide)
      (support:=support) (section_:=section_) (group:=group) (Z:=Z)
      (center:=center) (held:=held) (homes:=homes) (roof:=roof)
    have pool:∀ i : ℕ, j+1 ≤ i → i ≤ j+1+1 → Integrable ((row₀ q) i) (Wilson.prior G _):=by
      intro i start stop
      rcases (show i=j+1 ∨ i=j+1+1 by omega) with h|h
      · subst i; exact low
      · subst i; exact hi
    have readout:=WilsonReceivedChronologicalFixedRoseRange.interval R (row₀ q) mask
      (Nat.le_succ_of_le (eb.trans bj)) (Nat.le_succ (j+1)) live pool
    rw [Finset.sum_Ico_succ_top (show j+1≤j+1 from le_rfl),Finset.Ico_self,Finset.sum_empty,zero_add] at readout
    exact readout
  have paid₀:=WilsonAddressedPublicFirstRoseFee.original (R:=R) (simple:=simple) (d:=d) (P:=P) (school:=school)
      (day:=day) (old:=old) (early:=early) (live:=live) (op:=op) (lens:=lens) (pt:=pt) (toll:=toll)
      (classroom:=classroom) (fine:=fine) (panel:=panel) (file:=file) (mask:=mask) (paid:=paid) (role:=role) (roles:=roles)
      (prior:=prior) (origin:=origin) (position:=position) (tags:=tags) (breadthCap:=breadthCap)
      (fit:=fit) (shelved:=shelved) (count:=count) (depth:=depth) (age:=age) (ready:=ready)
      (loDepth:=loDepth) (loShelf:=loShelf) (loSeats:=loSeats) (halo:=halo) (income:=income)
      (upperWidth:=upperWidth) (sold:=sold) (rent:=rent) (tube:=tube) (front:=front) (teacher:=teacher)
      (menu:=menu) (go:=go) (board:=board) (near:=near)
      (pieces:=pieces) (ep:=ep) (tp:=tp) (two:=two) (late:=late) (floorOld:=floorOld)
      (oldEar:=oldEar) (ub:=ub) (bj:=bj) (geo:=geo) (station:=station) (axes:=axes)
      (support:=support) (section_:=section_) (group:=group) (Z:=Z)
      (center:=center) (held:=held) (homes:=homes) (roof:=roof) e ue eb
  have tally:(∑q:L,(wt q)*up q)-(∑q:L,(wt q)*lo q)=∑q:L,(wt q)*d₀ q:=by
    rw [←sum_sub_distrib]
    exact sum_congr rfl (fun q _=>by rw [←mul_sub,issued])
  let y:=∑q:L,(wt q)*up q
  let z:=∑q:L,(wt q)*lo q
  change ‖x-z‖ ≤ _
  calc
    ‖x-z‖ = ‖(x-y)+(y-z)‖:=by congr 1; abel
    _ ≤ ‖x-y‖ + ‖y-z‖:=norm_add_le _ _
    _ ≤ _:=add_le_add board₀ (by change ‖(∑q:L,(wt q)*up q)-(∑q:L,(wt q)*lo q)‖ ≤ _; rw [tally]; exact paid₀)

end YM.Integration.WilsonAddressedPublicFirstRoseOriginal
