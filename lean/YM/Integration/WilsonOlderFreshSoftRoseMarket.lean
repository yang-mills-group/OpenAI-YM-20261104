theorem physical (paid:WilsonOriginalAllOrderCourse.Paid.{u} a simple ε (prepared s) R crop W):
    RG05Preconstruction.ReadoutPurchase R.b:=by
  obtain ⟨_,sold⟩:=paid.originalSchool
  obtain ⟨_,_,_,_,_,_,_,_,_,_,original,_⟩:=sold
  exact original.2.2.2.2.2.2.1

theorem original (paid:WilsonOriginalAllOrderCourse.Paid.{u} a simple ε (prepared s) R crop W)
    (D:Fin 3→ℕ)(fit:∀i,grade i<D i)(e:ℕ)(A τ:ℝ)(a0:0≤A)(τ0:0<τ):
    ∃start:ℕ,∀ᶠ v:ℕ in atTop,∃V:Realm G (e+1) Credit.leanC,
      V.draws=R.family.path.levels ∧ V.paid=R.metals.O ∧ V.y=zz R.family.path.levels ∧ V.anchor=v ∧
      ∀t:Finset (Fin 3),t.Nonempty → Hearing R grade D e v start V t A τ:=
  WilsonOlderFreshSoftRoseCourse.original paid (physical paid) D fit e A τ a0 τ0

structure Probe {e:ℕ}(D:Fin 3→ℕ)(V:Realm G (e+1) Credit.leanC)(t:Finset (Fin 3)) where
  coeff : (i:t)→Knob (D (seat t i))
  phase : t→Chamber
  digit : Digits V.draws t
  root : t → Cover
  test : Pen (D ∘ seat t) univ→L[ℝ] ℝ
  bound : ‖test‖≤1

def row {e:ℕ}(D:Fin 3→ℕ)(V:Realm G (e+1) Credit.leanC)(t:Finset (Fin 3))
    (N K c w v:ℕ)(p:Probe D V t)(g:ℝ)(x:∀i,(R.family.labels.level (grade i)).Coeff)
    (q:ℕ)(θ:ℝ)(early:Bool):ℂ:=
  let d:=grade ∘ seat t
  let P:=WilsonOlderFreshSoftTrialCut.source R (D ∘ seat t) d N K c V.draws V.paid p.coeff p.phase p.digit p.root univ p.test
  let h:=mass d univ
  let H:=fun b=>cruises V.draws V.paid N h c w (P b)
  let full:=fun b=>cruises V.draws V.paid N h c v (P b)
  if early then WilsonOlderFreshSoftCoveredRead.cost R d V.draws V.paid N w v q θ g (fun i=>x (seat t i)) H
  else reading R d g (fun i=>x (seat t i)) full q θ

def scaled (t:Finset (Fin 3))(pay:Fin 3→ℝ)(z:ℂ):ℂ:=((∏i:t,pay (seat t i)):ℝ)*z

theorem issued {e v start:ℕ}{D:Fin 3→ℕ}{V:Realm G (e+1) Credit.leanC}
    {t:Finset (Fin 3)}{A τ:ℝ}(hearing:Hearing R grade D e v start V t A τ)
    (j:Fin 3→ℕ)(paidJ:∀a,start≤j a)(N per K c w target:ℕ)(vw:v≤w)(wc:w≤c)(cK:c≤K)(KN:K<N)(vK:v+1≤K)
    (warm:2≤R.family.path.levels.clock.hatBeta K)
    (window:R.family.S.scale K-R.family.S.scale v≤A*(1+Real.log (R.family.path.levels.clock.hatBeta (v+1))))
    (η:ℝ)(M:Fin 3→ℝ)(Y:∀a:Fin 3,ℕ×ℕ→R.family.label (grade a))
    (before:∀a,j a≤K)(reg:WilsonOriginalMicroscopicGuardedPageSchool.Indexed R grade j target η M Y)
    (η0:0≤η)(M0:∀a,0≤M a)(pay m C D₁ D₂:Fin 3→ℝ)(B ρ:ℝ):
    let g:=regulatorRun R.family N per K
    let logg:=Real.log g⁻¹
    (∀a,0≤pay a) → (∀a,0≤C a) → (∀a,M a≤C a*Real.exp ((2*m a)*logg)) →
    (∀a,Real.log (R.family.S.a K/R.family.S.a (j a))⁻¹≤D₁ a*logg) →
    (∀a,pay a≤Real.exp ((grade a:ℝ)*D₂ a*logg)) →
    R.family.S.a c/R.family.S.a w≤Real.exp (-B*logg) → power R grade (seat t) m η D₁ D₂+τ+ρ≤B/4 →
    ∀(p:Probe D V t)(q:ℕ),q≤e → ∀θ:ℝ,|θ|≤1 →
    let x:=vector R grade j K target η M Y before reg N per
    ‖scaled t pay (row (R:=R) D V t N K c w v p g x q θ false)-
      scaled t pay (row (R:=R) D V t N K c w v p g x q θ true)‖≤bill R grade (seat t) C*Real.exp (-ρ*logg):=by
  dsimp only
  intro p0 C0 salary stretch doses clip length p q keep θ flat
  have charge:=hearing j paidJ N per K c w target vw wc cK KN vK warm window η M Y before reg η0 M0 pay m C D₁ D₂ B ρ p0 C0 salary stretch doses clip length p.coeff p.phase p.digit p.root p.test p.bound q keep θ flat
  rw [scaled,scaled,←mul_sub,norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg (prod_nonneg fun i _=>p0 _)]
  exact charge

