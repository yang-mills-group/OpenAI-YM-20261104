theorem original (Φ:Test 3)(simple:G.Simple)(bliss:Bliss F l z H)(lead:Leading F Jr)
    (obedient:∀d:ℕ,∀ᶠr in trail,Frame.obedient F H (Jr r) d)
    (slow:WilsonWindowReportingPace.Slow R.kit)(shop:RG05Preconstruction.ReadoutPurchase R.b)
    (cap:∀j,1≤((P).budget j).supportExponent)(upper:∀j,((P).budget j).supportExponent≤100)
    (color:G.ColorIndex)
    (funded:WilsonOriginalAllOrderCourse.Paid.{u} axis simple ε (prepared schedule) R crop W)
    (paths:FundedOriginalVacuumPaths.prices R.kit)(T h:ℕ){δ:ℝ}
    (books:(t:{t:ℝ // 0<t ∧ t<δ})→Book F (l:=l) H z 6 T t.val)
    (delivered:∀t,WilsonMovingForkWindowBooks.Priced F (books t))(x:∀i:Fin 3,RG17.Free C (grade i).val):
    ∃edge:ℝ,0<edge ∧ ∃bank reserve:ℕ,∀(target width:ℕ)(debt:Fin 3→ℕ),∃U:Set ℝ,U∈trail ∧
    let J₀:=cut ((target+1)+1) bank ((∑i,debt i)+1) (WilsonReceivedChronologicalFixedRosePooledMesh.width width (2*T+11+2*h))
    let lower:=J₀+9
    ∀D:Fin 3→ℕ,(∀i,ages i<D i) → ∀(caps:Fin 3→ℝ)(opt tol:ℝ),0≤opt → 0<tol →
    ∃bottom onset:ℕ,∃school:(v:ℕ)→ onset≤v→WilsonOriginalObservedRoseProbeShelf.Badge R D lower v bottom opt tol,
    ∀(power:ℕ)(credit:ℝ),
    let stopOrder:=WilsonOlderFreshSoftSocketStationSevenPower.order (target+1)
      (WilsonOriginalObservedRosePublicGross.base reserve (∑i,debt i)) (WilsonOlderFreshSoftSocketStationPooledFigures.mesh T h width)
    let wStop:=date R (2*width) (loss R power stopOrder)
    Tendsto wStop atTop atTop ∧ ∀Q:ℕ,lower≤Q → ∃start:ℕ,∀ᶠv:ℕ in atTop,∃(entered:onset≤v),
    ∃(V:Realm G (Q+1) Credit.leanC)(draw:V.draws=P),
    V.paid=R.metals.O ∧ V.y=zz P ∧ V.anchor=v ∧ Covered R D Q v start V draw opt tol ∧
    (∀s:Finset (Fin 3),s.Nonempty → Stock R D Q v start V draw opt tol s) ∧
    ∀r∈U,∀ρ:Fin 3→{t:ℝ // 0<t ∧ t<δ},(∀i,r≤(ρ i).val ∧ (ρ i).val≤outer z h r) → (∃i,(ρ i).val=r) →
    let slots i:=reading F Jr Z (books (ρ i)) (grade i) (x i)
    let reporterDate:=reporter F books ρ
    ∀(K N per b c requested tag:ℕ)(bk:b≤K)(kn:K≤N),b<N →
    v≤reporterDate → reporterDate≤K → v≤wStop c → v≤c → ∀(live:c≤K), v+1≤K → σ K-σ (v-1)≤width*(1+Real.log (β v)) →
    let θ:=g N per v
    ∀(q₁:ℕ)(W:Realm G (q₁+1) Credit.leanC)(source:W.draws=(P))(first:ℕ),first+1≤v →
    ∀(file:Filed R ages K),0<r→(a) b≤r→4*(edge*r)<(a) c→
    let μ:=WilsonThermometerAlignedCells.mass (R:=R) r (b,per) Φ
    let Active:Type:={y:Site ((C).side b per) × Site ((C).side b per) // μ y≠0}
    ∀(panel:(o:Active)→{Z:Panel R ages N per b K bk kn requested power tag credit // Z.loc=atOrigin o.val}),
    (∀o,(panel o).val.slot=file.station) → (∀o,(panel o).val.axis=file.A N per) →
    (∀o i,(panel o).val.slot i=(slots i).j) →
    (∀o i,(panel o).val.names i=(slots i).arm.source (N,per)) →
    ∀(κ:(i:Fin 3)→Knob (D i))(pt:Fin 3→Chamber)
      (test:Active→Case D),(∀o i,‖test o i‖≤caps i*(θ⁻¹)^debt i) →
    let filed o:=tape source bk (panel o).val.loc
    let cells o:=onLevels source (filed o)
    let pins o:=address (P) (cells o) (c-v) v (homes (V:=W) (filed o) 0 first (v-1-first))
    let w o:=votes R ages (N:=N) (per:=per) file (panel o).val.names (panel o).val.turn
    let row j o s:=figure R ages κ pt N per K c v (cells o) s (w o) (pins o) (touch (test o) s) j θ
    let office:=school v entered
    let branchTest (o:Active)(s:Faces):=touch (fun i:s=>test o i.val) (univ:Finset s)
    let sourceSite (o:Active):=WilsonOriginalMicroscopicEntranceGridRow.pin R (bk.trans kn) (atOrigin o.val)
    let probe (o:Active)(s:Faces):=WilsonOlderFreshSoftRoseNodes.enrolled R D office.field office.draw N per c
      (live.trans kn) ((sourceSite o) 1,(sourceSite o) 2) s
      (WilsonOriginalObservedRoseProbePlace.ticket D s κ pt (test o))
    let occupied (o:Active)(s:Faces):=(WilsonOriginalObservedRoseProbeRead.quota (branchTest o s):ℂ)*
      WilsonOriginalObservedRoseHaarProbe.priced R D office.field s N K c v (probe o s) (g N per K)
        (fun i=>WilsonPositionProgramReportedField.entire R (ages i) K (N,per) (w o i)) lower θ
    let raw:=∑o:Active,μ o.val*((r:ℂ)^14*value (row Q o))
    let low:=∑o:Active,μ o.val*((r:ℂ)^14*value (occupied o))
    let stopped (o:Active)(s:Faces):=(WilsonOriginalObservedRoseProbeRead.quota (branchTest o s):ℂ)*
      WilsonOlderFreshSoftRoseMarket.row (R:=R) D office.field s N K c (wStop c) v (probe o s) (g N per K)
       (fun i=>WilsonPositionProgramReportedField.entire R (ages i) K (N,per) (w o i)) lower θ true
    let ended:=WilsonOlderFreshSoftSocketStationPortfolio.reading (fun o:Active=>μ o.val) ((r:ℂ)^14) stopped
    (∀(o:Active)(s:Faces) b,WilsonCoeffUV.Mer.Auth (WilsonCoeffUV.Wheel.Mark.mass (WilsonOlderFreshSoftRoseCourse.grade ∘ seat s) (Finset.univ:Finset s))
      (WilsonOriginalObservedRoseHaarProbe.source R D office.field s N K c (probe o s) (XSpace.Bare.chart G) b)) ∧
    (∀o s,WilsonOriginalObservedRoseProbeRead.quota (branchTest o s)≤
      (∏i∈s,max 1 (caps i))*(θ⁻¹)^(∑i∈s,debt i)) ∧ ‖raw-low‖≤(∫y:Points 3,‖Φ y‖)*θ^(target+1) ∧
    ‖low-ended‖≤(∫y:Points 3,‖Φ y‖)*θ^(target+1) ∧
    ‖raw-ended‖≤(∫y:Points 3,‖Φ y‖)*θ^target:=by
  classical
  obtain ⟨edge,edgePos,bank,market⟩:=WilsonOriginalObservedRosePooledMarket.original F Jr Z Φ
    simple bliss lead obedient slow shop cap upper color funded paths T h books delivered x
  obtain ⟨edge',edgePos',posted⟩:=WilsonOlderFreshSoftSocketStationPostedFigure.original (R:=R) Φ simple
  obtain ⟨reserve,gross⟩:=WilsonOlderFreshSoftSocketStationPooledFigures.original F Jr Z simple bliss lead
    obedient slow shop cap upper color funded paths T h books delivered x
  refine ⟨max edge edge',edgePos.trans_le (le_max_left ..),bank,reserve,?_⟩
  intro target width debt
  let due:=∑i,debt i
  let balance:=WilsonOriginalObservedRosePublicGross.base reserve due
  let reach:=WilsonOlderFreshSoftSocketStationPooledFigures.mesh T h width
  let L:=2*width
  obtain ⟨U,valid,next⟩:=market (target+1) width debt
  obtain ⟨U',valid',forecast⟩:=gross due width
  obtain ⟨U'',valid'',calendar⟩:=WilsonReceivedChronologicalFixedRosePooledMesh.original (R:=R) F Jr Z simple bliss slow width 6 T h grade x books
  have near:(Set.Iio (1:ℝ))∈trail:=mem_nhdsWithin_of_mem_nhds (Iio_mem_nhds zero_lt_one)
  refine ⟨((U∩U')∩U'')∩Set.Iio 1,inter_mem (inter_mem (inter_mem valid valid') valid'') near,?_⟩
  intro J₀ lower D fits caps opt tol op tp
  obtain ⟨bottom,onset,school,offer⟩:=next D fits caps opt tol op tp
  refine ⟨bottom,onset,school,?_⟩
  intro power credit stopOrder wStop
  let funds:=(max 1 credit)^3*(2:ℝ)^WilsonOlderFreshSoftSocketStationPanelPower.debt R power
  let tickets:=WilsonOlderFreshSoftSocketStationMeasuredCanvas.charge caps
  have cashPos:0≤funds:=mul_nonneg (pow_nonneg (zero_le_one.trans (le_max_left ..)) _) (by positivity)
  have testPos:0≤tickets:=(WilsonOlderFreshSoftSocketStationMeasuredCanvas.positive caps).le
  obtain ⟨grows,gate,heard⟩:=WilsonOlderFreshSoftSocketStationFacePayment.original R simple slow D lower L power stopOrder L (by positivity)
  refine ⟨grows,?_⟩
  intro Q retained
  obtain ⟨start,bought⟩:=offer Q retained
  refine ⟨start,?_⟩
  have always:=forecast lower (by dsimp only [lower]; omega) D tickets testPos
  filter_upwards [bought,always,calendar,Filter.eventually_ge_atTop gate,
    WilsonSeparatedPrefixKineticGeometry.spend R simple (tickets*funds*(4:ℝ)^stopOrder) 0,
    WilsonSeparatedPrefixKineticGeometry.spend R simple 21 0] with v book ready geometry late payroll cool
  obtain ⟨entered,V,draw,scheme,heat,anchor,covered,stock,read⟩:=book
  refine ⟨entered,V,draw,scheme,heat,anchor,covered,stock,?_⟩
  intro r hr ρ arms nearest slots reporterDate K N per b c requested tag bk kn deep vf fk vw vc ck vk span θ
    q₁ W source first active file rp fine inside μ Active panel stations axes seats names κ pt test tested
    filed cells pins w row office branchTest sourceSite probe occupied raw low stopped ended
  have smaller (x:ℝ)(le:x ≤ max edge edge'):4*(x*r)<(a) c:=
    (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right le rp.le) (by norm_num: (0:ℝ)≤4)).trans_lt inside
  have program:=read r hr.1.1.1 ρ arms nearest K N per b c requested power tag credit bk kn deep vf fk vc ck vk span
    q₁ W source first active file rp fine (smaller edge (le_max_left ..)) panel stations axes seats names κ pt test tested
  obtain ⟨auth,fees,current⟩:=program
  refine ⟨auth,fees,current,?_⟩
  have vn:=vc.trans (ck.trans kn)
  have gp:0<θ:=ActualRunKernelPackets.regulator_pos R N per v vn
  have kp:0<g N per K:=ActualRunKernelPackets.regulator_pos R N per K kn
  have cold:21≤θ⁻¹:=by simpa only [pow_zero,mul_one] using cool N per vn
  have one:1≤θ⁻¹:=(by norm_num : (1:ℝ)≤21).trans cold
  obtain ⟨duration,_,_⟩:=geometry r hr.1.2 ρ arms nearest (K:=K) (N:=N) (per:=per) vf fk kn span
  have room0:=room (R:=R) simple vc L duration
  have cap0:tickets*funds*(4:ℝ)^stopOrder≤θ⁻¹:=by simpa only [pow_zero,mul_one] using payroll N per vn
  have law (o:Active)(s:Faces):row lower o s=occupied o s:=by
    have placed:=posted bk kn ck vc active rp fine (smaller edge' (le_max_right ..)) o.val o.property W source
      office.field office.draw office.paid D s κ pt (test o) (w o) lower θ
    simpa only [row,occupied,branchTest,probe,sourceSite,pins,cells,filed,(panel o).property] using placed
  have head (o:Active)(s:Faces)(hs:s.Nonempty):
      r^(height ages s)*‖occupied o s‖≤2*(θ⁻¹)^(balance+reach*height ages s):=by
    rw [←law o s]
    exact ready office r hr.1.1.2 ρ arms nearest N per b K c requested power tag credit bk kn deep vf fk vc ck vk span
      (panel o).val file (stations o) (axes o) (seats o) (names o) s hs κ pt (cells o) (pins o) (touch (test o) s)
      (WilsonOlderFreshSoftSocketStationMeasuredCanvas.touched (test o) s one caps debt (tested o))
  have invoice (o:Active)(s:Faces)(hs:s.Nonempty):
      ‖occupied o s-stopped o s‖≤WilsonOriginalObservedRoseProbeRead.quota (branchTest o s)*(funds*(g N per K)^stopOrder):=by
    dsimp only [occupied,stopped]
    rw [←mul_sub,norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg (WilsonOriginalObservedRoseProbeRead.positive _).le]
    apply mul_le_mul_of_nonneg_left _ (WilsonOriginalObservedRoseProbeRead.positive _).le
    exact (heard c (late.trans vc)).2 v late vw bottom opt tol office N per b K bk kn ck vk
      room0.1 room0.2 requested tag credit (panel o).val file (stations o) (axes o) s hs (probe o s) lower le_rfl
  have fitted:due+1≤balance:=by simp only [balance,WilsonOriginalObservedRosePublicGross.base];omega
  have paid:=WilsonOlderFreshSoftSocketStationMeasuredCanvas.mesh (fun o:Active=>μ o.val) occupied stopped
    (fun o s=>WilsonOriginalObservedRoseProbeRead.quota (branchTest o s)) caps debt (target+1) balance reach gp cold kp.le
    (WilsonOlderFreshSoftSocketStationFacePayment.comparison R simple (vc.trans ck) kn) rp.le hr.2.le cashPos fitted cap0 head (fun o s _=>fees o s) invoice
  have last:‖low-ended‖≤(∫y:Points 3,‖Φ y‖)*θ^(target+1):=paid.trans
    (mul_le_mul_of_nonneg_right (WilsonOlderFreshSoftSocketStationScan.variation R (f:=b) (per:=per) r Φ) (pow_nonneg gp.le _))
  refine ⟨last,?_⟩
  let variation:=∫y:Points 3,‖Φ y‖
  have nonneg:0≤variation:=MeasureTheory.integral_nonneg fun _=>norm_nonneg _
  have halves:(2:ℝ)*θ≤1:=(le_div_iff₀ gp).mp (by simpa only [one_div] using (show (2:ℝ)≤θ⁻¹ from (by norm_num : (2:ℝ)≤21).trans cold))
  calc ‖raw-ended‖≤‖raw-low‖+‖low-ended‖:=by
         rw [show raw-ended=(raw-low)+(low-ended) by abel];apply norm_add_le
       _≤variation*θ^(target+1)+variation*θ^(target+1):=add_le_add current last
       _=variation*θ^target*(2*θ):=by rw [pow_succ];ring
       _≤_:=mul_le_of_le_one_right (mul_nonneg nonneg (pow_nonneg gp.le _)) halves

end YM.Integration.WilsonOlderFreshSoftSocketStationPooledRestored
