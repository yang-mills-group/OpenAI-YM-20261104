/-- Jointly read the one fiscally enrolled physical panel at both printed degrees. -/
def SignedReading (R:Run G)(l:Filter (ℕ×ℕ))(D:Fin 3→ℕ)(pt:Fin 3→Chamber)(φ:Test 3)
    (r γ:ℝ)(observed:ℂ)(margin:ℝ){u b K:ℕ}(uf:u≤b)(fk:b≤K)
    (c m Q J₀ requested tag:ℕ)(plan:Plan 3)(file:Filed R ages K)
    {top:ℕ}{Vc:Realm G (top+1) Credit.leanC}(drawc:Vc.draws=R.family.path.levels)
    (named:∀(N per:ℕ)(kn:K≤N),(cells R φ r (b,per) →
      Panel R ages N per b K fk kn requested plan.pole tag plan.tuition)→Prop):Prop:=
  (∀ᶠpair:ℕ×ℕ in l,∃(kn:K≤pair.1)(Y:cells R φ r (b,pair.2) →
      Panel R ages pair.1 pair.2 b K fk kn requested plan.pole tag plan.tuition),
    named pair.1 pair.2 kn Y ∧ Posted R ages D pt φ r (K:=K) (N:=pair.1) (per:=pair.2)
      (c:=c) (v:=m+1) (uf.trans fk) fk kn plan file Y drawc m Q) →
  ∀ᶠpair:ℕ×ℕ in l,∃(kn:K≤pair.1)(Y:cells R φ r (b,pair.2) →
      Panel R ages pair.1 pair.2 b K fk kn requested plan.pole tag plan.tuition),
    named pair.1 pair.2 kn Y ∧ Posted R ages D pt φ r (K:=K) (N:=pair.1) (per:=pair.2)
      (c:=c) (v:=m+1) (uf.trans fk) fk kn plan file Y drawc m Q ∧
    let reported:=WilsonReceivedChronologicalFixedRoseGridFolio.independent R ages D pt φ r
      (K:=K) (N:=pair.1) (per:=pair.2) (c:=c) (v:=m+1) fk kn plan file Y drawc m J₀
    ‖observed-signed R φ r (b,pair.2) (fun y=>value (reported y))‖/γ ≤ margin

theorem original (simple:G.Simple)
    {master:EveryPhase.Almanac F}{reader:Orbits.Reader F.sector.derivatives F.sector.turns F.room.kernel.spin}
    {cohort:Ultrafilter (ℕ×ℕ)→Prop}
    (selected:WilsonViewerElectedHierarchy.Selected.{u} F master reader Jr H z l simple cohort)
    (slow:WilsonWindowReportingPace.Slow R.kit)(shop:RG05Preconstruction.ReadoutPurchase R.b)
    (κ₀:ℕ)(powerful:0<κ₀)(ratio:Z.run.ratio=(3:ℕ)^κ₀) (T h:ℕ)
    {δ:ℝ}(books:(s:{s:ℝ // 0<s ∧ s<δ})→Book F (l:=l) H z 6 T s.val)
    (window:∀s,WilsonMovingForkWindowBooks.Priced F (books s))
    (dp:0<δ)
    (funded:WilsonOriginalAllOrderCourse.Paid.{u} axis simple ε (prepared schedule) R crop W):
    ∃B:ℝ,0≤B ∧ ∃(physical E:ℕ)(charge:Faces→ℝ), (∀s,0≤charge s) ∧
    ∀{I:Type} [Fintype I] (paths:FundedOriginalVacuumPaths.prices R.kit)
    (ready:WilsonReportLampForecast.Ready R.family.path.levels)
    (Dc:Fin 3→ℕ)(ptc:Fin 3→Chamber)(caps:Fin 3→ℝ)(_:∀i,0≤caps i)
    (_:∀i,WilsonAddressedPublicSubmittedDates.grades id i < Dc i)
    (requested:ℕ)(tolerance η:ℝ)(_ : 0<tolerance)(_ : 0<η)(school:ℕ)(tube:Comparison.Density.Transport.LinkTube G)
    (pieces assignment:ℕ)(orders:Bool→ℕ)(sizes:I→ℕ)(tariff:I→Bool→ℕ)
    (reserve₀ infrared:ℕ)(_ : 0 < infrared),
    let grant:=WilsonReceivedChronologicalFixedRoseGridCampus.original F funded paths id Dc ptc caps
      ‹∀i,0≤caps i› ‹∀i,WilsonAddressedPublicSubmittedDates.grades id i < Dc i›
      roseTest requested tolerance η ‹0<tolerance› ‹0<η› school tube pieces assignment orders sizes tariff
      selected.bliss slow ready 6 T h reserve₀ infrared ‹0 < infrared› grade books
    let posted:=grant.choose_spec.choose_spec.choose_spec.2
    ∀stage:ℕ,
    ∃band:WilsonPositionProgramReporterBand.Band R Z.run stage,∀ᶠstartLevel:ℕ in atTop,∃u₀:ℕ,
    startLevel≤u₀ ∧ Stop (C) 0 startLevel u₀ ∧
    (∀d:ℕ,Nonempty (WilsonIndependentCapturedPages.Stop R Z.run band u₀ d)) ∧
    faculty posted u₀ ∧ ∃A:ℝ,0≤A ∧ ∀reserve:ℕ,
    let width:=WilsonReceivedChronologicalFixedRosePublicAperture.width reserve (2*T+11+2*h)
    ∃U:Set ℝ,U∈trail ∧ ∀(target debt Q:ℕ) (_ : 2≤target)
    (_:cut target E debt width≤Q)(Cφ:ℝ)(_:0<Cφ)
    (opt tol:ℝ)(_:0≤opt)(_:0<tol)
    (plan:Plan 3)(M:Fin 3→ℝ)(_:∀i,1≤M i)
    (_:plan.Affords (demand target physical) (2*E) (WilsonOriginalObservedRosePublicMesh.aperture width) 14),
    let J₀:=cut target E debt width
    ∃start:ℕ,∀(aperture:ℕ)(margin:ℝ),0< margin →
    ∀ᶠr in trail,∀ρ:Fin 3→{s:ℝ //0<s ∧ s<δ},(∀i,(ρ i).val=r)→
    let b:=reporter F books ρ
    let L:=fun i=>home F Jr Z (books (ρ i)) (grade i) (publicHead i)
    let K:=WilsonInvariantActionPosition.berth R reserve b
    ∀m:ℕ,∀hi lo:ℝ,WilsonReceivedChronologicalFixedCellFee.capture R roseTest r≤b → ∀fk:b<K,
    WilsonAddressedPublicFirstRoseTicket.Receipt R hi lo r (wilson z r) m b K
      (WilsonReceivedChronologicalFixedCellFee.capture R roseTest r) aperture →
    let v:=m+1
    ∃(V:Realm G (Q+1) Credit.leanC)(draw:V.draws=P),
    V.paid=R.metals.O ∧ V.y=zz P ∧ V.anchor=v ∧ Covered R Dc Q v start V draw opt tol ∧
    (∀s:Finset (Fin 3),s.Nonempty → Stock R Dc Q v start V draw opt tol s) ∧
    ∃uf:u₀≤b,∀(c requested tag:ℕ),
    0<v → v≤c → c≤b → v+1≤K → σ K-σ (v-1)≤(plan.width:ℝ)*(1+Real.log (β v)) →
    ∀(file:Filed R ages K){top:ℕ}(Vc:Realm G (top+1) Credit.leanC)(drawc:Vc.draws=P),
    let named (N per:ℕ)(kn:K≤N)(Y:cells R roseTest r (b,per) →
        Panel R ages N per b K fk.le kn requested plan.pole tag plan.tuition):Prop:=
      ∀y,(Y y).loc=y.val ∧ (Y y).M=M ∧ (Y y).slot=file.station ∧ (Y y).axis=file.A N per ∧
        (∀i,(Y y).slot i=(L i).j) ∧ (∀i,(Y y).names i=(L i).arm.source (N,per)) ∧
        ∀i,WilsonReflectedPublicOrientedFaces.displayed R (ages i) ((Y y).names i) ((Y y).turn i)=(L i).arm.source (N,per)
    SignedReading R (l:Filter _) Dc ptc roseTest r (wilson z r)
      (WilsonOriginalTwoFlatIRPoolFirstSignal.smooth F Jr Z publicHead roseTest r)
      margin uf fk.le c m Q J₀ requested tag plan file drawc named:=by
  obtain ⟨B,bp,physical,E,charge,pos,available⟩:=WilsonOriginalTwoFlatIRPoolFolioGrades.original
    F Jr Z simple selected slow shop κ₀ powerful ratio T h books window dp funded
  have clk:=wilson_link F simple selected.bliss.budgets selected.bliss.keen selected.bliss.lies
  refine ⟨B,bp,physical,E,charge,pos,?_⟩
  intro I inst paths ready Dc ptc caps hp lc requested tolerance η tp ep school tube
    pieces assignment orders sizes tariff reserve₀ infrared depth grant posted stage
  obtain ⟨band,offers⟩:=available paths ready Dc ptc caps hp lc requested tolerance η tp ep school tube
    pieces assignment orders sizes tariff reserve₀ infrared depth stage
  refine ⟨band,?_⟩
  filter_upwards [offers] with start witnessed
  obtain ⟨u,ju,stop,moving,purse,A,ap,law⟩:=witnessed
  refine ⟨u,ju,stop,moving,purse,A,ap,?_⟩
  intro reserve width
  obtain ⟨U,up,prepared⟩:=law reserve
  refine ⟨U,up,?_⟩
  intro target debt Q high retention Cφ cp opt tol op semp plan M one booking J₀
  obtain ⟨start,dated⟩:=prepared target debt Q high retention Cφ cp opt tol op semp plan M one booking
  refine ⟨start,?_⟩
  intro aperture margin mp
  let mass:=∫x:Points 3,‖roseTest x‖
  have cost:0 ≤ mass*(B+A+32):=mul_nonneg (integral_nonneg fun _=>norm_nonneg _) (by linarith)
  have lp:0<2*(1+mass*(B+A+32)):=by linarith
  filter_upwards [dated aperture,clk.positive,(clk.conforms simple).eventually (ge_mem_nhds (div_pos mp lp))]
    with r placed gp small
  have short:mass*(B+A+32)*(wilson z r)≤ margin/2:=by
    have bnd:=(le_div_iff₀ lp).mp small
    nlinarith
  intro ρ same b L K m hi lo cb fk ticket v
  obtain ⟨V,draw,oil,zero,anchor,cover,stock,uf,hear⟩:=placed ρ same m hi lo cb fk ticket
  refine ⟨V,draw,oil,zero,anchor,cover,stock,uf,?_⟩
  intro c requested tag vp vc cf later age file top Vc drawc named payroll
  filter_upwards [hear (margin*(wilson z r)/2) (by positivity),payroll] with pair measured issued
  obtain ⟨kn,Y,original,folio⟩:=issued
  refine ⟨kn,Y,original,folio,?_⟩
  have fee:=measured c requested tag fk.le kn (fk.trans_le kn) vp vc cf later age file Y
    original Vc drawc folio
  apply (div_le_iff₀ gp).mpr
  apply fee.trans
  change mass*(B+A+32)*(wilson z r)^2+margin*(wilson z r)/2≤ margin*(wilson z r)
  calc
    _=(mass*(B+A+32)*(wilson z r)+margin/2)*(wilson z r):=by ring
    _≤(margin/2+margin/2)*(wilson z r):=mul_le_mul_of_nonneg_right (add_le_add short le_rfl) gp.le
    _=_:=by ring

end YM.Integration.WilsonOriginalTwoFlatIRPoolThermometerHearing
