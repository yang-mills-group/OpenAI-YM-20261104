theorem original (simple:G.Simple)
    (funded:WilsonOriginalAllOrderCourse.Paid.{u} axis simple ε (prepared schedule) R crop W)
    (E:ℕ)(charge:Faces→ℝ)(positive:∀s,0≤charge s)(target debt width clock Q:ℕ)
    (retained:cut target E debt width≤Q)(Cφ:ℝ)(cp:0<Cφ)
    (D:Fin 3→ℕ)(fits:∀i,ages i<D i)(X opt tol:ℝ)(xp:0≤X)(op:0≤opt)(tp:0<tol):
    let J₀:=cut target E debt width
    let A:=WilsonOriginalObservedRosePublicMesh.aperture width
    ∃start:ℕ,∀ᶠv:ℕ in atTop,∃(V:Realm G (Q+1) Credit.leanC)(draw:V.draws=P),
    V.paid=R.metals.O ∧ V.y=zz P ∧ V.anchor=v ∧ Covered R D Q v start V draw opt tol ∧
    (∀s:Finset (Fin 3),s.Nonempty → Stock R D Q v start V draw opt tol s) ∧
    ∀r:ℝ,0≤r → ∀(K N per b c requested power tag:ℕ)(credit:ℝ)(bk:b≤K)(kn:K≤N),
    v≤c → c≤K → v+1≤K → σ K-σ (v-1)≤(clock:ℝ)*(1+Real.log (β v)) →
    let θ:=g N per v
    ∀(file:Filed R ages K)(φ:Test 3),let D₀:=cells R φ r (b,per)
    ∀panel:D₀ → Panel R ages N per b K bk kn requested power tag credit,
    (∀y,(panel y).loc=y.val) →
    ∀(κ:(i:Fin 3)→Knob (D i))(pt:Fin 3→Chamber)(digits:D₀→Digits (P) (Fin 3))
      (atSite:D₀→Fin 3→ Cover)(test:D₀→(s:Faces)→Pen D s→L[ℝ]ℝ),
      (∀y (s:Faces),s.Nonempty → ‖test y s‖≤X*(θ⁻¹)^debt) →
    let w:=fun y:D₀=>votes R ages (N:=N) (per:=per) file (panel y).names (panel y).turn
    (∀y (s:Faces),s.Nonempty → r^(height ages s)*
      (∑q:Selection R ages s,‖weight R ages N per K (w y) s q‖)≤
      charge s*(θ⁻¹)^(2*E)*(θ⁻¹)^(A*height ages s+1)) →
    let row (j:ℕ)(y:D₀)(s:Faces):=normalized R ages κ pt N per K c v (digits y) s (w y) (atSite y) (test y s) j θ
    ∀u:ℕ,∀before:u≤K,
    let source:=fun (y:D₀)(s:Faces)=>WilsonMeasuredPublicEntranceCellWords.physical R ages
      (panel y).names (panel y).turn y.val (bookedFace s) (N:=N)
    let full:=fun (y:D₀)(s:Faces)=>R.family.omega N per (source y s)
    let fixed:=fun (y:D₀)(s:Faces)=>WilsonReceivedChronologicalFixedRoseTestSource.fixed R kn before (source y s)
    ∀physical:Bool,let current:=if physical then full else fixed
    ∀(bill:D₀ → Faces → Account)(chamber cash₀ cash₁:D₀ → Faces → ℝ),
      (∀y (s:Faces),s.Nonempty → Node (fixed y s) (row Q y s) (bill y s).basal (bill y s).firstStep
        (bill y s).cutoff (bill y s).interior (bill y s).crossing (bill y s).terminal) →
      (∀y (s:Faces),s.Nonempty → physical=true → ‖full y s-fixed y s‖≤chamber y s) →
      (∀y (s:Faces),s.Nonempty → ‖(bill y s).basal‖≤cash₀ y s) →
      (∀y (s:Faces),s.Nonempty → ‖(bill y s).firstStep‖≤cash₁ y s) →
      let cost:=fun (y:D₀)(s:Faces)=>(if physical then chamber y s else 0)+
        (((bill y s).cutoff+(bill y s).interior+(bill y s).crossing+cash₀ y s+cash₁ y s)+(bill y s).terminal)
      (∀y (s:Faces),s.Nonempty →
        r^(height ages s)*‖row Q y s‖≤(θ⁻¹)^(base E debt+A*height ages s)) ∧
      (∀y (s:Faces),s.Nonempty → ‖current y s-row Q y s‖≤cost y s) ∧
      (∀τ:ℝ,0≤τ → τ≤1 →
        (∀y (s:Faces),s.Nonempty → r^(height ages s)*cost y s≤(θ⁻¹)^(base E debt+A*height ages s)*τ) →
        r^14*‖signed R φ r (b,per) (fun y=>value (current y)-value (row J₀ y))‖≤
          (∫x,‖φ x‖)*(21*(θ⁻¹)^(3*(base E debt+1)+A*14)*τ+θ^target)):=by
  classical
  intro J₀ A
  obtain ⟨start,run⟩:=WilsonReceivedChronologicalFixedRoseSplitElection.original (R:=R) simple funded E charge positive
    target debt width clock Q retained Cφ cp D fits X opt tol xp op tp
  refine ⟨start,?_⟩
  filter_upwards [run] with v pay
  obtain ⟨V,draw,oil,zero,start,cover,stock,heard⟩:=pay
  refine ⟨V,draw,oil,zero,start,cover,stock,?_⟩
  intro r rp K N per b c requested power tag credit bk kn vc ck later span θ file φ D₀ panel _placed κ pt digits atSite
    test young w sourceFee row u before source full fixed physical current bill ear cash₀ cash₁ earned listened basal
    firstFee cost
  let change:=fun y:D₀=>value (row Q y)-value (row J₀ y)
  have claims(y:D₀):=heard r rp K N per c vc ck kn later span (w y) (sourceFee y) κ pt (digits y) (atSite y)
    (test y) (young y)
  have low(y:D₀)(s:Faces)(hs:s.Nonempty):r^(height ages s)*‖row Q y s‖≤
      (θ⁻¹)^(base E debt+A*height ages s):=((claims y).2.1 s hs).1 Q le_rfl
  have faceFee(y:D₀)(s:Faces)(hs:s.Nonempty):‖current y s-row Q y s‖≤cost y s:=by
    cases physical with
    | false=>simpa only [current,cost,Bool.false_eq_true,↓reduceIte,zero_add] using
        (earned y s hs).on_fees (basal y s hs) (firstFee y s hs)
    | true=>exact (earned y s hs).at_phase (listened y s hs rfl) (basal y s hs) (firstFee y s hs)
  refine ⟨low,faceFee,?_⟩
  intro τ positive small charged
  have gp:0<θ:=ActualRunKernelPackets.regulator_pos R N per v (vc.trans (ck.trans kn))
  by_cases has:Nonempty D₀
  case neg =>
    have h0:signed R φ r (b,per) (fun y=>value (current y)-value (row J₀ y))=0:=by
      unfold WilsonReceivedChronologicalFixedRoseVariation.signed
      apply sum_eq_zero
      intro i _
      exact False.elim (has ⟨i⟩)
    rw [h0,norm_zero,mul_zero]
    have normφ:0≤∫x,‖φ x‖:=integral_nonneg fun _=>norm_nonneg _
    positivity
  have two:2≤θ⁻¹:=(by norm_num : (2:ℝ)≤21).trans (claims has.some).1
  have capped:=WilsonReceivedChronologicalFixedRoseTestProducts.graded R φ r (b,per) current (row Q) rp two positive small
    (WilsonOriginalObservedRosePublicMesh.aperture width) (base E debt) low (fun y s hs=>
      (mul_le_mul_of_nonneg_left (faceFee y s hs) (pow_nonneg rp _)).trans (charged y s hs))
  have scalar:‖(r:ℂ)^14‖=r^14:=by
    rw [norm_pow,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg rp]
  let amplification:ℂ:=(r:ℂ)^14
  have tail:=WilsonReceivedChronologicalFixedRoseVariation.original R φ r (b,per) (fun y=>amplification*change y)
    (θ^target) (pow_nonneg gp.le _) (fun y=>by
      rw [norm_mul,show ‖amplification‖=r^14 from scalar]
      exact (claims y).2.2)
  have pull:signed R φ r (b,per) (fun y=>amplification*change y)=amplification*signed R φ r (b,per) change:=by
    unfold WilsonReceivedChronologicalFixedRoseVariation.signed
    rw [mul_sum]
    exact sum_congr rfl fun y _=>by ring
  rw [pull,norm_mul,show ‖amplification‖=r^14 from scalar] at tail
  have balance:signed R φ r (b,per) (fun y=>value (current y)-value (row J₀ y))=
      signed R φ r (b,per) (fun y=>value (current y)-value (row Q y))+signed R φ r (b,per) change:=by
    unfold WilsonReceivedChronologicalFixedRoseVariation.signed
    rw [←sum_add_distrib]
    exact sum_congr rfl fun y _=>by dsimp only [change];ring
  rw [balance,mul_add]
  exact (mul_le_mul_of_nonneg_left (norm_add_le _ _) (pow_nonneg rp _)).trans (by
    rw [mul_add]
    exact add_le_add capped tail)

end YM.Integration.WilsonReceivedChronologicalFixedRoseSplitHearing
