  ((ask₀).school.order+1) (ask₀).load (j+1)

include lo hi in
theorem original (big:2 ≤ (clock₀).hatBeta (j+1))(board:gates)(onset:WilsonMeasuredSemesterSubpower.onset R 1 (by norm_num:0<(1:ℝ)) ≤ j+1)
    (clocked:(eventually_atTop.mp (WilsonOriginalTwoFlatIRRows.nextClock R simple)).choose ≤ j+1)
    {u v p depth E:ℕ}(uc:u ≤ j+1)(vc:v ≤ j+1)(quote:Quote R N per u v (j+1) p depth uc vc)
    {C:ℝ}(cp:1 ≤ C)(allowed:allowance ≤ 1)(rent:0 ≤ rate)(out:rate ≤ C*(X₀)^E)(tests:∀a,‖test a‖ ≤ C*(X₀)^E)
    (s:(marks).Mode)(Z:Support (R.family.side (j+1) per))(center:0∈Z)(reside:∀a∈s.val,(port (R.family.side (j+1) per) z).origin a∈Z)
    (rad:ℕ)(near:∀a∈s.val,separation ((port (R.family.side (j+1) per) z).origin a) 0 ≤ rad)
    (inside:rad ≤ (rep).p.B)(housed:Z⊆halo (rep).p.B {0}){α:ℝ}(strip:(rep).p.supportExponent ≤ α)
    (ou:Opened R.family 0 u per)(ov:Opened R.family 0 v per)
    (reach:4*(p+(WilsonOriginalTwoFlatIRHalo.power s.val.card ((∑a,grades a)+1+2+(2+2*n*E))+0+2)) ≤ depth):
    let intake:=WilsonOriginalTwoFlatIRAddressedCap.coefficient n (q₀) (∑a,grades a) C (Fintype.card (Multi.Hot (marks)))
    let h:=((2:ℝ)^((ask₀).order+(ask₀).shelf+1))^2*max 1 intake
    let e:=WilsonOriginalTwoFlatIRHalo.power s.val.card ((∑a,grades a)+1+2+(2+2*n*E))+0+2
    let bill:=WilsonOriginalTwoFlatIRFiled.reserve (roof (marks) s (R.family.localSection 0) R.family.params α h) 1*3^e
    MeasureTheory.Integrable raw (prior G (R.family.side (j+1) per)) ∧ ‖WilsonThermometerUnitFilingCoarse.reading R (N:=N) (p:=per) (b:=j+1) (fun U=>(raw U).part s) u uc-
      WilsonThermometerUnitFilingCoarse.reading R (N:=N) (p:=per) (b:=j+1) (fun U=>(raw U).part s) v vc‖ ≤ bill*(gc)^p:=by
  obtain ⟨ol,count,_,pl⟩:=lo.paid
  obtain ⟨oh,hcount,_,ph⟩:=hi.paid
  obtain ⟨F,_,_,fo,_⟩:=ph 1 zero_lt_one
  have up:∃(source:Wallet (A₀) → Config G (R.family.side (j+1+1) per) → Marker.Poly (marks)),
      ∃S:WilsonOriginalReceivedChain.Post (N:=N) R day.hk (roots₀) (tab₀) day.π day.Γ (day.Ψ per) house.books
          house.ahead (A₀) (zeroes) grades (ask₀).order (ask₀).shelf oh.count (j+1) (Nat.le_succ_of_le ready) source,
        S.op.count ≤ Burn.horizon (ask₀).vac+2:=⟨_,F,by rw [fo,hcount];exact (ask₀).load.count⟩
  rw [hcount,←count] at up
  obtain ⟨source,S,s_count⟩:=up
  have oc:1 ≤ ol.count:=count.symm▸(ask₀).load.occupied
  have slots:Fintype.card (Fin n) ≤ ol.count:=by simpa [count] using (ask₀).load.slots
  have cap:=WilsonOriginalTwoFlatIRRosePower.original κ pt digits seed z test lo.matter per live.le
    lo.filed cp allowed rent out tests
  let target (X:Config G (R.family.side (j+1) per) → Marker.Poly (marks)) : Prop:=
    let intake:=WilsonOriginalTwoFlatIRAddressedCap.coefficient n (q₀) (∑a,grades a) C (Fintype.card (Multi.Hot (marks)))
    let h:=((2:ℝ)^((ask₀).order+(ask₀).shelf+1))^2*max 1 intake
    let e:=WilsonOriginalTwoFlatIRHalo.power s.val.card ((∑a,grades a)+1+2+(2+2*n*E))+0+2
    let bill:=WilsonOriginalTwoFlatIRFiled.reserve (roof (marks) s (R.family.localSection 0) R.family.params α h) 1*3^e
    MeasureTheory.Integrable X (prior G (R.family.side (j+1) per)) ∧ ‖WilsonThermometerUnitFilingCoarse.reading R (N:=N) (p:=per) (b:=j+1) (fun U=>(X U).part s) u uc-
      WilsonThermometerUnitFilingCoarse.reading R (N:=N) (p:=per) (b:=j+1) (fun U=>(X U).part s) v vc‖ ≤ bill*(gc)^p
  change target raw
  apply (congrArg target lo.source).mpr
  dsimp only [target]
  constructor
  · exact WilsonOriginalTwoFlatIRCapturedLive.original (R:=R) (hk:=day.hk) (D:=roots₀) (Q:=tab₀)
      (π:=day.π) (Γ:=day.Γ) (Ψ:=day.Ψ per) (course:=(day.seen per).1) (books:=house.books)
      (hi:=ready) (op:=ol) (ahead:=house.ahead) (hospital:=house.hospital)
      (passport:=port (R.family.side (j+1) per) z) (B:=binder (R.family.side (j+1) per) z) (grades:=grades) (order:=(ask₀).order)
      (shelf:=(ask₀).shelf) (q:=q₀) (M:=lo.matter) simple live source S big house.pass board.level
      s_count onset clocked (ask₀).load.qfit oc slots (ask₀).load.fit wallet
  · exact WilsonOriginalTwoFlatIRAddressedSchool.original R day.hk (roots₀) (tab₀) day.π day.Γ (day.Ψ per)
      (day.seen per).1 house.books ready (Nat.lt_of_succ_lt live) ol (day.lessons j ready (Nat.lt_of_succ_lt live))
      house.ahead house.hospital (port (R.family.side (j+1) per) z) (binder (R.family.side (j+1) per) z) grades (ask₀).order (ask₀).shelf (q₀)
      w lo.matter 1 (pl 1 zero_lt_one) wallet uc vc quote simple live source S big house.pass board.level
      s_count onset clocked (ask₀).load.qfit oc slots (ask₀).load.fit cap s Z center reside rad near inside housed strip ou ov reach

