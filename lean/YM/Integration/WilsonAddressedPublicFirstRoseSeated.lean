    (occurs:WilsonCenteredCompactBooking.mass R φ r (f,per) panel.loc≠0)
    (fit : (ask).order ≤ Burn.horizon (ask).vac+1)
    (ready : WilsonReceivedMeasuredStampPrice.opening R simple rentOrder (ask).order (ask).vac (ask).load.deep (ask).load.aged
      (by norm_num:0<(1:ℝ)) ≤ j+1)
    (loDepth : lowOrder ≤ (clock).J (j+1))
    (income : (eventually_atTop.mp (WilsonEmittedOriginalCalendar.wages R simple)).choose ≤ j+1)
    (sold : (eventually_atTop.mp ((Next.Rank.Station.hat_rate R.family.path.levels simple).eventually_ge_atTop
      (max 1 (WilsonOriginalCensusCanonicalRows.ceiling R d 1)))).choose ≤ j+1)
    (front : (t:Multi.Hot (marks)) → t.val.val)
    {I₀:Type}[Fintype I₀]{courseDepth pieces₀ k₀:ℕ}{pole:Bool → ℕ}{span:I₀ → ℕ}{lag:I₀ → Bool → ℕ}
    (faculty:WilsonIndependentCollarDatedTeachers.At schedule R simple V lens d (Burn.horizon (ask).vac)
      courseDepth allowance tube pieces₀ k₀ pole span lag j)(venue:V.anchor ≤ j+1)
    (go:(publication).first ≤ j+1)(board:(publication).period (j+1) (extent₀) ≤ per)
    {u b geomCost roomSize:ℕ}{η:ℝ}(ep:0<η)(tp:0<tol)
    (two:2 ≤ (bound))
    (late:(eventually_atTop.mp (WilsonReceivedChronologicalPanelClock.original R simple ask (charges) P
      geomCost precision target (bound) tol η two tp ep)).choose ≤ b)
    (floorOld:WilsonSingleHardRadius.first R simple ≤ m)(oldEar:m ≤ u)(ub:u ≤ b)(bj:b ≤ j)
    (geo:R.family.S.a b/R.family.S.a (j+1+1) ≤ (R.family.path.levels.clock.hatBeta b)^geomCost)
    (support:∀i,(R.family.path.levels.budget i).supportExponent=100)
    {df:ℕ}{frame:Frame G df}(section_:SectionData frame)(group:Hol G)
    (Z:Support (R.family.side b per))(center:Site (R.family.side b per))(held:center∈Z)
    (homes:∀i∈mask.val,sites R (home) (Nat.le_succ_of_le bj) i∈Z)
    (roof:coverNumber ((day.Ψ per) b).p.B Z ≤ roomSize)
    {e:ℕ}(ue:u ≤ e)(eb:e ≤ b)(bf:b ≤ f)
    (arrival:Reading R d panel (eb.trans bf))(one:∀i,1 ≤ panel.M i)(E:Fin 3→ℕ)
    (refs:∀i t,t ≤ d i→R.family.ref t ≤ N)
    (fees:∀i,Next.Rank.Spindle.paid R.family (d i) f N per (panel.names i) ≤ panel.M i*(R.family.path.levels.clock.hatBeta f)^(E i))
    (desired:ℕ)(within:desired+∑i∈mask.val,E i ≤ requested):

    ‖reading R (N:=N) (credit R.family N per 0 (physical R d panel.names panel.turn panel.loc mask)
          (j+1+1) live) e ((eb.trans bf).trans fine)-
      ∑q:Selection R d mask.val,(wt q)*reading R (N:=N) (fun U=>((row₀ q) (j+1) U).part mask)
        e (Nat.le_succ_of_le (eb.trans bj))‖ ≤ (∏i∈mask.val,WilsonAddressedHomeDose.ceiling (R:=R) (d i) (panel.M i))*
         ((R.family.path.levels.clock.hatBeta f)^desired)⁻¹+
      (due)*(WilsonReceivedChronologicalLastFlat.wage mask P roomSize η*(gAt b)^P):=by
  classical
  let tags (t:Covers R.family.path.levels.S (j+1) (sideₗ)):(step R (j+1) t.val).Choices:=
    Classical.choice inferInstance
  have upperWidth:scale ≤ 1:=
    WilsonOriginalCensusCanonicalSalary.actual (WilsonOriginalAllOrderCourse.teacher semester)
      R simple MintClock.splits (Burn.horizon (ask).vac) ((clock).J (j+1+1)) (ask).fit
  have teacher:=WilsonReceivedChronologicalFixedQuiet.teacher day per faculty venue (old.trans early)
    (Nat.lt_of_succ_le live)
  obtain ⟨op,pieces,_stage,issue⟩:=WilsonAddressedPublicFirstOrigin.original R simple d school (ask)
    (per:=per) day (old.trans early) live seller fund history activated ranked loDepth stock tags
  have pos:0<gAt (j+1+1):=ActualRunKernelPackets.regulator_pos R N per _ live
  let amount:ℝ:=(gAt (j+1+1))^rentOrder
  have ap:0<amount:=pow_pos pos _
  let high (q:Selection R d mask.val):=Classical.choice (issue (adult) (spots) (cells) (seed q) amount ap)
  have spot: (o)=placed R fine panel.loc:=
    (WilsonAddressedPublicFirstSites.original R draw φ).choose_spec.2 r rp small first f per j
      before between fine narrow panel.loc occurs early
  have near (t:Multi.Hot (marks)):
      breadth t.val.val (front t).val 0 (relative t.val.val (front t).val (spots)) ≤ extent₀:=
    WilsonAddressedPublicFirstExtent.original (track) (0:Fin 3 → Lattice.Cover) first (j-first) t.val.val (front t).val
  exact WilsonAddressedPublicFirstRoseOriginal.original (R:=R) (simple:=simple) (d:=d) (P:=P)
    (school:=school) (day:=day) (old:=old) (early:=early) (live:=live) (op:=op) (lens:=lens) (pt:=pt)
    (toll:=toll) (classroom:=classroom) (fine:=fine) (panel:=panel) (file:=file) (station:=station) (axes:=axes)
    (mask:=mask) (paid:=paid) (role:=role) (roles:=roles) (prior:=prior) (origin:=high) (position:=spot)
    (tags:=tags) (breadthCap:=extent₀) (fit:=fit) (shelved:=stock.level)
    (count:=pieces.trans_le (ask).load.count) (depth:=(ask).load.deep) (age:=(ask).load.aged)
    (ready:=ready) (loDepth:=loDepth) (loShelf:=stock₀.level) (loSeats:=(ask).load.count) (halo:=stock₀.halo)
    (income:=income) (upperWidth:=upperWidth) (sold:=sold) (rent:=le_rfl) (tube:=tube)
    (front:=front) (teacher:=teacher) (menu:=publication) (go:=go) (board:=board) (near:=near)
    (pieces:=pieces) (ep:=ep) (tp:=tp) (two:=two) (late:=late) (floorOld:=floorOld)
    (oldEar:=oldEar) (ub:=ub) (bj:=bj) (geo:=geo) (support:=support)
    (section_:=section_) (group:=group) (Z:=Z) (center:=center) (held:=held)
    (homes:=homes) (roof:=roof) ue eb bf arrival one E refs fees desired within

