def Invoice (paid:WilsonOriginalAllOrderCourse.Paid.{u} a simple ε (prepared s) R T W)
    (paths:FundedOriginalVacuumPaths.prices R.kit)
    (role:Fin 3 → Fin 3)(D:Fin 3 → ℕ)(pt:Fin 3 → Chamber)
    (caps:Fin 3 → ℝ)
    (φ:Test 3)(requested A:ℕ)(tol η:ℝ)(tp:0 < tol)(ep:0 < η)(school:ℕ)(tube:LinkTube G)
    (pieces physical:ℕ)(p:Bool → ℕ)(span:U → ℕ)(lag:U → Bool → ℕ):Prop:=
    let n:=3
    let front:Fin n:=0
    let k:=grades role
    let κ:∀v:Fin 3,Knob (D v):=fun v=>contact (D v)
    let power:=fun _:Fin 3=>0
    let target:=WilsonAddressedPublicFirstRoseTerms.order R requested
    let P:=target+1
    let menu:=terms k power P
    let ask:=programme k power P
    let L:=R.family.path.levels
    let firstPeriod:=appointment R simple k D pt (fun _=>4) tube ask.order ask.order menu.target menu.precision
      (seller G) (financed paid) (WilsonAddressedPublicFirstRanks.original k P).2.2.2.1
    ∃book:WilsonOriginalCensusPhysicalAttendance.Room (prepared s) R simple,
    ∃price:Credit,∃B:ℝ,1 ≤ B ∧ ∀ᶠ o:ℕ in atTop,
    WilsonSingleHardRadius.first R simple ≤ o ∧
    WilsonOriginalCensusCanonicalAppointedClock.opening R simple (seller G) (financed paid) paths
      (Burn.horizon ask.vac) ≤ o ∧
    ∃resident:(N:ℕ) → o ≤ N → Day (prepared s) R simple ask.school o N,
    (∀N:ℕ,∀live:o ≤ N,∃Z:ℕ → SeriesA G,QuietAt (resident N live) price Z) ∧
    ∀ᶠ anchor:ℕ in atTop,∃V:Realm G (menu.order+1) Credit.leanC,∃draw:V.draws=L,
      V.paid=R.metals.O ∧ V.anchor=anchor ∧ ∀δ:ℝ,0 < δ → δ ≤ 1 → ∀ᶠ m:ℕ in atTop,
      ∃old:o ≤ m,∀j:ℕ,∀mj:m+1 ≤ j,
      L.S.scale (j+1+1)-L.S.scale m ≤ (A:ℝ)*(1+Real.log (L.clock.hatBeta (m+1))) →
      let K:=j+1+1
      ∀ᶠ per:ℕ in atTop,∀N:ℕ,∀valid:K ≤ N,
        let H:=Real.sqrt (R.family.path.β N per (m+1))
        let rate:=H^δ*B^n
        let oldDay:=resident N (old.trans ((Nat.le_succ m).trans (mj.trans ((Nat.le_succ j).trans ((Nat.le_succ (j+1)).trans valid)))))
        ∃classroom:Purchased (per:=per) (V:=V) (draw:=draw) (rate:=rate) (allowance:=δ) power P book oldDay κ pt K m valid
          (fun j=>base B caps power (L.clock.hatBeta (j+1))) old φ caps A target η,
        Sold (R:=R) (simple:=simple) (d:=k) (P:=P) (m:=o) (first:=m) (j:=j) (N:=N) (per:=per)
          (schedule:=s) (A:=A) (V:=V) (draw:=draw) (rate:=rate) (allowance:=δ) (φ:=φ) (caps:=caps) (promised:=target) (θ:=η)
          (school:=book) (day:=oldDay) (live:=valid) (lens:=D) (pt:=pt)
          (toll:=fun l=>base B caps power (L.clock.hatBeta (l+1))) (old:=old)
          (classroom:=classroom) (role:=role) (roles:=rfl) η ∧
        WilsonIndependentCollarDatedTeachers.At s R simple V D k (Burn.horizon ask.vac) school δ tube pieces physical p span lag m ∧
        V.anchor ≤ m+1 ∧
        WilsonOriginalCensusSparseRosterOpening.first R simple tube k k (charges power) menu.order menu.order
          menu.target menu.precision menu.enough ≤ m+1 ∧
        Period (R:=R) (V:=V) (per:=per) (grades:=k) power P κ pt K m caps ∧
        WilsonOriginalOneArmCurrentClock.first R simple k power P (2*A) tol η tp ep (Nat.zero_lt_of_lt front.isLt) ≤ m ∧
        R.family.S.a (m+1)/R.family.S.a K ≤ (L.clock.hatBeta (m+1))^(2*A) ∧
        WilsonAddressedPublicFirstOrigin.ceiling R k ≤ menu.order ∧
        WilsonAddressedPublicFirstRoseTerms.At R simple k P (2*A) tol η tp ep (m+1) (K-2) ∧
        WilsonIndependentCollarDatedTeachers.At s R simple V D k (Burn.horizon ask.vac) school δ tube
          pieces physical p span lag (K-2) ∧
        firstPeriod.first ≤ K-2+1 ∧
        firstPeriod.period (K-2+1)
          (WilsonAddressedPublicFirstExtent.extent V.draws (0:Fin 3 → Cover) m (K-2-m)) ≤ per

theorem original (paid:WilsonOriginalAllOrderCourse.Paid.{u} a simple ε (prepared s) R T W)
    (paths:FundedOriginalVacuumPaths.prices R.kit)
    (role:Fin 3 → Fin 3)(D:Fin 3 → ℕ)(pt:Fin 3 → Chamber)
    (caps:Fin 3 → ℝ)(nonneg:∀v,0 ≤ caps v)(hk:∀v,grades role v < D v)
    (φ:Test 3)(requested A:ℕ)(tol η:ℝ)(tp:0 < tol)(ep:0 < η)(school:ℕ)(tube:LinkTube G)
    (pieces physical:ℕ)(p:Bool → ℕ)(span:U → ℕ)(lag:U → Bool → ℕ):
    Invoice paid paths role D pt caps φ requested A tol η tp ep school tube pieces physical p span lag :=by
  classical
  unfold Invoice
  intro n front k κ power target P menu ask L firstPeriod
  obtain ⟨book,price,B,one,sold⟩:=WilsonAddressedPublicFirstRoseCampus.original paid paths role D pt caps nonneg hk
    φ requested A tol η tp ep school tube pieces physical p span lag
  refine ⟨book,price,B,one,?_⟩
  filter_upwards [sold] with o admitted
  obtain ⟨hard,activated,resident,quiet,realms⟩:=admitted
  refine ⟨hard,activated,resident,quiet,?_⟩
  filter_upwards [realms] with anchor roles
  obtain ⟨V,draw,metals,center,windows⟩:=roles
  refine ⟨V,draw,metals,center,?_⟩
  intro δ dp ds
  filter_upwards [windows δ dp ds] with m granted
  obtain ⟨hm,dates⟩:=granted
  refine ⟨hm,?_⟩
  intro j mj length K
  have align:m+(j+1+1-m)=j+1+1:=by omega
  have spanFit:L.S.scale (m+(j+1+1-m))-L.S.scale m ≤ (A:ℝ)*(1+Real.log (L.clock.hatBeta (m+1))):=by
    simpa only [align] using length
  have atK:=dates (j+1+1-m) (by omega) spanFit
  simp only [align] at atK
  filter_upwards [atK] with per purchased
  intro N valid H rate oldDay
  obtain ⟨classroom,firstAt,venue,sparse,period,current,geo,ranked,stages,atj,go,board⟩:=purchased N valid
  refine ⟨classroom,?_,firstAt,venue,sparse,period,current,geo,ranked,stages,atj,go,board⟩
  exact WilsonAddressedPublicFirstRoseOffer.original (R:=R) (simple:=simple) (d:=k) (P:=P)
    (school:=book) (day:=oldDay) (old:=hm) (early:=by omega) (live:=valid) (lens:=D) (pt:=pt)
    (toll:=fun l=>base B caps power (L.clock.hatBeta (l+1))) (classroom:=classroom)
    (role:=role) (roles:=rfl) (seller:=seller G) (fund:=financed paid) (history:=paths)
    (tube:=tube) (ep:=ep) (tp:=tp) (authorized:=stages) (activated:=activated) (ranked:=ranked)
    (faculty:=atj) (venue:=venue.trans (by omega)) (go:=go) (board:=board) (floorOld:=hard)
    (geo:=geo) (support:=paid.support)

end YM.Integration.WilsonAddressedPublicFirstRoseElection
