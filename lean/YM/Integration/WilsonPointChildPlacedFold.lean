omit [DecidableEq ι] in
theorem salary (R:Run G)(simple:G.Simple)(booked:WilsonPointChildFiledTest.Filed R)
    (paid:WilsonPointChildWindingSchool.Paid R.kit)(u:ι → G.ColorIndex){h:ι → ℕ}(depth:∀s,k s<h s)(o:Loc G 1)
    (tags:∀i n,(Flat.primary (R.family.path.levels.clock.op i 0).patch R.family.path.levels.clock.kernel n).Choices)
    (E:ℕ){η:ℝ}(positive:0<η):
    ∀ᶠm:ℕ in atTop,∀N,m ≤ N → ∀v:∀s,Letter (R.family.labels.level (k s)),∀p:∀s,Scroll (h s),
    ∀y:ι → Cover,∀cut:∀s,ℝ →L[ℝ] Pen D ({s}:Finset ι),∀σ:ℝ,σ ≤ width R m →
    let X:=sources R u depth N m v p
    let K:=placed X cut y
    let A:=∑s,‖cut s‖*(R.family.path.levels.clock.hatBeta m)^η*‖physical (p s)‖
    0 ≤ A ∧ ∀I:Finset ι,safeB y K I E σ A:=by
  let path:=R.family.path.levels
  have ready(s:ι):=WilsonPointChildWindingIncome.original R simple booked (u s) (depth s) o tags (fare G) paid E positive
  filter_upwards [eventually_all.mpr ready,(WardBin.bell path simple).eventually_ge_atTop 1] with m shelf beta N live v p y cut σ narrow X K A
  have hp:0 ≤ path.clock.hatBeta m^η:=(Real.rpow_pos_of_pos (zero_lt_one.trans_le beta) η).le
  have tot:0 ≤ A:=Finset.sum_nonneg (fun s _=>mul_nonneg (mul_nonneg (norm_nonneg (cut s)) hp) (norm_nonneg (physical (p s))))
  refine ⟨tot,fun I J inside i hi r=>?_⟩
  by_cases pick:J.card=1
  · obtain ⟨s,rfl⟩:=card_eq_one.mp pick
    have w0:=((Primer.FamilyWindow R.family).pos (path.clock.J m)).le
    have pr:=((shelf s N live (v s) (p s)).2 i hi r).1
    have cr:=(Cork.turn (y s) (rooted w0 pr)).touch (cut s)
    have wt:=abreast _ y s cr w0
    have small:‖cut s‖*(path.clock.hatBeta m^η*‖physical (p s)‖) ≤ A:=by
      rw [←mul_assoc]
      exact Finset.single_le_sum (f:=fun t=>‖cut t‖*(path.clock.hatBeta m)^η*‖physical (p t)‖)
        (fun a _=>mul_nonneg (mul_nonneg (norm_nonneg (cut a)) hp) (norm_nonneg (physical (p a)))) (Finset.mem_univ s)
    rw [Finset.card_singleton,pow_one]
    change Wig terrain y σ A {s} (((placed X cut y) {s}).2 i r)
    rw [field]
    exact (wt.shave narrow).more small
  · have eq:K J=0:=other _ pick
    rw [eq]
    exact Wig.zero.more (pow_nonneg tot _)

omit [Fintype ι] in
/-- The signed folded-input seam on the whole original wick graph for
all nominated roots, before any toron or proper marked face is forgotten. -/
theorem fresh (G:Gauge)(D k:ι → ℕ)(S:Finset ι)(alive:S.Nonempty)(e i r:ℕ)(hi:i ≤ e):
    ∃v σ:Gear G→ℝ,∃d:ℕ,(∀I,0<σ I ∧ (σ I)⁻¹ ≤ v I) ∧
    ∀(Q:Realm G (e+1) Credit.leanC) j N (a:Q.anchor ≤ j),
      v (Q.mint j a).gear ≤ Q.cash Credit.leanC j → j<N →
      ∀(n:Side)(K:family G D),Eu k K → K ∅=0 → ∀y:ι → Cover,∀z:ι → Site (loose Q.draws j).L,
      ∀A:ℝ,0 ≤ A → safeB (chartIn (loose Q.draws j) y z) K S e (WilsonPointChildQuoteWidth.quote (Q.mint j a).gear) A →
      4*crestCard y S<n.val →
      let flat:=(logO Q.draws Q.paid j N K k S).2 i r
      let terms:=coilH Q.draws Q.paid j N n K k (ratioHigh Q.draws Q.paid N j) S i r
      Wig (tor n) (wrap n ∘ y) (σ (Q.mint j a).gear/32/2)
        ((Q.y j)^d*A^S.card*Real.exp (-(n.val:ℝ)/(512*Q.y j))) S (Carp.plume flat n-terms):=by
  obtain ⟨σ,c,U,strip,step⟩:=pledges G e i r hi Credit.leanC Credit.leanC WilsonPointChildQuoteWidth.quote
    WilsonPointChildQuoteWidth.positive (J:=S) (Z:=S) le_rfl D k
  let cost(I:Gear G):=priceM (Hooks G) r (σ I)+tiePay (Hooks G) r (σ I/4)+2
  let v(I:Gear G):=max (c I) (max (cost I) U.x)
  refine ⟨v,σ,U.d+2,fun I=>⟨(strip I).1,(strip I).2.trans (le_max_left ..)⟩,?_⟩
  intro Q j N a wallet live n K auth empty y z A Epos entry he
  let I:=(Q.mint j a).gear
  let y₀:=Q.y j
  have fee:v I ≤ y₀:=by simpa only [Realm.cash,Credit.leanC,Credit.buy,pow_one,one_mul] using wallet
  have approve:c I ≤ Q.cash Credit.leanC j:=(le_max_left ..).trans wallet
  have store:=step Q j N n a live approve K auth empty y z A Epos entry
  have price:=markOrbit store alive he (strip I).1
  apply price.more
  have reserve:0<y₀:=zero_lt_one.trans_le (Q.depth j a)
  have rate:1 ≤ σ I*y₀:=calc
    _=σ I*(σ I)⁻¹:=(mul_inv_cancel₀ (strip I).1.ne').symm
    _ ≤ _:=mul_le_mul_of_nonneg_left ((strip I).2.trans ((le_max_left ..).trans fee)) (strip I).1.le
  have flat:catchW (σ I/32/16) n  ≤  Real.exp (-(n.val:ℝ)/(512*y₀)):=by
    apply Real.exp_le_exp.mpr
    apply (le_div_iff₀ (by positivity:0<512*y₀)).2
    change (-(σ I/32/16)*(n.val:ℝ))*(512*y₀)  ≤  -(n.val:ℝ)
    nlinarith only [mul_le_mul_of_nonneg_right rate (Nat.cast_nonneg n.val (α:=ℝ))]
  have rent:Q.cash U j ≤ y₀^(U.d+1):=by
    change U.x*y₀^U.d ≤ _
    rw [pow_succ']
    exact mul_le_mul_of_nonneg_right ((le_max_right ..).trans ((le_max_right ..).trans fee)) (pow_nonneg reserve.le _)
  have cpay:cost I ≤ y₀:=(le_max_left ..).trans ((le_max_right ..).trans fee)
  have nonneg:0 ≤ Q.cash U j:=zero_le_one.trans (U.purchase (Q.depth j a))
  have overhead:(priceM (Hooks G) r (σ I)+tiePay (Hooks G) r (σ I/4)+1)*(Q.cash U j*A^S.card)+Q.cash U j*A^S.card ≤ y₀^(U.d+2)*A^S.card:=calc
    _ = (cost I)*(Q.cash U j)*A^S.card:=by dsimp [cost];ring
    _  ≤  (y₀*y₀^(U.d+1))*A^S.card:=mul_le_mul_of_nonneg_right (mul_le_mul cpay rent nonneg reserve.le) (pow_nonneg Epos _)
    _ = _:=by rw [←pow_succ']
  exact mul_le_mul overhead flat (catch_hot ..) (mul_nonneg (pow_nonneg reserve.le _) (pow_nonneg Epos _))




omit [Fintype ι] in
theorem deposit (G:Gauge)(D k:ι → ℕ)(S:Finset ι)(_alive:S.Nonempty)(e i r:ℕ)(hi:i ≤ e):
    ∃v σ:Gear G→ℝ,∃d:ℕ,(∀I,0<σ I ∧ (σ I)⁻¹ ≤ v I) ∧
    ∀(Q:Realm G (e+1) Credit.leanC) j N (a:Q.anchor ≤ j),
      v (Q.mint j a).gear ≤ Q.cash Credit.leanC j → j<N →
      ∀(n:Side)(K:family G D),Eu k K → K ∅=0 → ∀y:ι → Cover,∀z:ι → Site (loose Q.draws j).L,
      ∀A:ℝ,0 ≤ A → safeB (chartIn (loose Q.draws j) y z) K S e (WilsonPointChildQuoteWidth.quote (Q.mint j a).gear) A →
      let flat:=(logO Q.draws Q.paid j N K k S).2 i r
      let terms:=coilH Q.draws Q.paid j N n K k (ratioHigh Q.draws Q.paid N j) S i r
      MarkU y S terms flat (σ (Q.mint j a).gear) ((Q.y j)^d*A^S.card):=by
  obtain ⟨σ,c,U,strip,step⟩:=pledges G e i r hi Credit.leanC Credit.leanC WilsonPointChildQuoteWidth.quote
    WilsonPointChildQuoteWidth.positive (J:=S) (Z:=S) le_rfl D k
  let cost(I:Gear G):=priceM (Hooks G) r (σ I)+tiePay (Hooks G) r (σ I/4)+2
  let v(I:Gear G):=max (c I) (max (cost I) U.x)
  refine ⟨v,σ,U.d+2,fun I=>⟨(strip I).1,(strip I).2.trans (le_max_left ..)⟩,?_⟩
  intro Q j N a wallet live n K auth empty y z A Epos entry
  let I:=(Q.mint j a).gear
  let y₀:=Q.y j
  have fee:v I ≤ y₀:=by simpa only [Realm.cash,Credit.leanC,Credit.buy,pow_one,one_mul] using wallet
  have approve:c I ≤ Q.cash Credit.leanC j:=(le_max_left ..).trans wallet
  have store:=step Q j N n a live approve K auth empty y z A Epos entry
  have reserve:0<y₀:=zero_lt_one.trans_le (Q.depth j a)
  have rent:Q.cash U j ≤ y₀^(U.d+1):=by
    change U.x*y₀^U.d ≤ _
    rw [pow_succ']
    exact mul_le_mul_of_nonneg_right ((le_max_right ..).trans ((le_max_right ..).trans fee)) (pow_nonneg reserve.le _)
  apply store.more
  exact mul_le_mul_of_nonneg_right (rent.trans (pow_le_pow_right₀ (Q.depth j a) (by omega))) (pow_nonneg Epos _)

