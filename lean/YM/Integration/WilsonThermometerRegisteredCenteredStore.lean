def Charged (q target:ℕ) (y:Site ((C).side i per)) (α:ℝ) (obs Q:Poly J):Prop:=
  ∃ b h:Coefficient (F) ((C).side i per),
    Bill R A simple cut o hk D bank π Γ Ψ books hi ahead order shelf seats P q target y α 1 b ∧
    Bill R A simple cut o hk D bank π Γ Ψ books hi ahead order shelf seats P q target y α (book₁ obs Q) h ∧
    ∀U:configuration,((incomingAt U)*WilsonThermometerRegisteredCenteredInvoice.properInvoice obs Q).part full=
      ((Ψ i).eval U:ℂ)*((submitted₀ U)*WilsonThermometerRegisteredCenteredInvoice.properInvoice obs Q).part full+
      (damping obs Q:ℂ)*h.density y (S) (Ψ i) U+(1-(damping obs Q:ℂ))*b.density y (S) (Ψ i) U

include course cut in
theorem original (way : WayStation R.kit) (station : WilsonCenteredCaptureClock.first R simple ≤ i)
    (sec : R.t 0 ≤ i)
    (slow : ∀ j, ((R.family.S.block j).val:ℝ) ≤ Real.log (RG16.Lambda R.family.path.levels j))
    (ready : WilsonReportLampForecast.Ready R.family.path.levels)
    (early : (eventually_atTop.mp (WilsonCenteredReporterClock.original R simple slow ready)).choose ≤ i)
    (late : (eventually_atTop.mp (WilsonRootedKioskPostRadius.original R simple)).choose ≤ i)
    (pass : Pass D bank R.alloy R.kit) (hospital : MintClock.Hospital D R.rolls bank R.kit.target φ books ahead R.alloy.delay)
    (narrow : shelf≤R.alloy.B.a.clock.J i) (load : P.op.count≤Burn.horizon k+2)
    (p q : ℕ) (force : q≤R.alloy.B.a.clock.J i) (deep : 2*(p+1)+8≤order) (aged : p+4≤3*k+2)
    {ε : ℝ} (positive : 0<ε) (opened : WilsonFirstReceivedEarnedFee.opening R simple P.op.count p order k deep aged positive ≤ i)
    (small : debt ε p≤1)  (y : Site ((C).side i per)) (Z : Support ((C).side i per)) (center : y∈Z)
    (homes_in : ∀j:Fin 3,homes j∈Z) (rad : ℕ) (near : ∀j:Fin 3,separation (homes j) y≤rad)
    (radius : rad≤(Ψ i).p.B) (box : Z⊆halo (Ψ i).p.B {y}) (α : ℝ) (strength : (Ψ i).p.supportExponent≤α)
    (loss : ℕ) (aperture : g^loss≤Poly.toll P.w full)
    (target:ℕ) (surplus:target+(3+loss+87)≤q) (funded:debt ε p≤g^q)
    (saved:(eventually_atTop.mp (WilsonFullFaceSignedReserved.original R simple q)).choose ≤ i)

    (caps:Fin 3→ℕ) (wcap:∀v,WilsonOriginalThermometerPalette.levels v<caps v)
    (phase:Fin 3→ℂ→ₗ[ℝ]ℝ) (older:ℕ) (issued:older≤N) (volume:Side) (lift:Site (R.family.side N per)→ Cover)
    (given:Fin 3 → Site (R.family.side N per)) (test:Case caps) (sense:∀s:(J).Mode,(s.val→Site (R.family.side N per))→ PChart G volume→ₗ[ℝ] ℂ):
    let Q:=Poly.pass (WilsonThermometerNominatedDeletion.filed R A caps wcap phase older volume lift test sense given)
    let obs:=WilsonThermometerFiniteConnectedCells.measured R A (N,per) given
    damping obs Q = 2*(1+∑s:(J).Mode with s≠WilsonThermometerCenteredAlgebra.full ∧ s≠(J).quiet,Poly.toll wₚ s*
        ‖(WilsonThermometerRegisteredSingletonCenter.invoice obs Q).part s‖) ∧
      Charged R A simple cut o hk D bank π Γ Ψ books hi ahead order shelf seats P q target y α obs Q:=by
  intro Q obs
  have beta:=congrArg Coat.gStep (course.1.walk (i+1) (Nat.le_succ_of_le hi) cut).beta
  have gpos:0<g:=beta ▸ P.issued.Waffle.soon.1
  have each(v):0<(wₚ) v:=mul_pos gpos (P.salary.positive v)
  have qu:Q.part (J).quiet=1:=Poly.pass_part _ ((WilsonThermometerNominatedDeletion.nominated R A simple issued caps wcap phase volume lift test sense).2.1 given)
  refine ⟨WilsonThermometerRegisteredCenteredInvoice.charge wₚ obs Q qu,?_⟩
  have book:=WilsonThermometerRegisteredCenteredInvoice.affordable wₚ obs Q each qu
  have issue (tab:Poly J) (affordable:Poly.price wₚ (inverseMass tab) ≤ fee J):
      ∃h:Coefficient (F) ((C).side i per), Bill R A simple cut o hk D bank π Γ Ψ books hi ahead order shelf seats P q target y α tab h:=
    WilsonThermometerFullSignedOrder.original R A simple cut o hk D bank π Γ Ψ course books hi ahead
      order shelf seats P way station sec slow ready early late pass hospital narrow load p q force deep aged positive
      opened small tab y Z center homes_in rad near radius box α strength loss aperture affordable target surplus funded saved
  obtain ⟨b,left⟩:=issue 1 book.1
  obtain ⟨h,right⟩:=issue (book₁ obs Q) book.2
  refine ⟨b,h,left,right,?_⟩
  intro U
  rw [WilsonThermometerRegisteredCenteredInvoice.reading wₚ obs Q each qu (incomingAt U),
    WilsonThermometerRegisteredCenteredInvoice.reading wₚ obs Q each qu (submitted₀ U),
    left.2.2.1 U,right.2.2.1 U]
  ring

