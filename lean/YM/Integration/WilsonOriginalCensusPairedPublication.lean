variable {G:Gauge} (R:Run G) (simple:G.Simple) {n j m N per K horizon q:ℕ}
  (hk:Burn.horizon horizon+2 ≤ R.alloy.B.a.clock.J m)
  (roots:Roots (G:=G) R.metals.p.profile R.metals.K R.metals.p.kernel)(Q:roots.Tab R.rolls)
  (π:ℕ→Layout G)(Γ:ℕ→Pace.Coin)(Ψ:∀i,RG.Rep G (R.family.side i per))
  (course:Concourse R.alloy R.kit R.T π Γ m N per horizon Ψ)
  (scroll:LawScroll G MintClock.splits)(books:Mentor.Offices.Books roots R.rolls Q MintClock.splits)
  (ahead:Mentor.Forecast roots R.rolls Q MintClock.splits books)
  (chamber:VowsR.Chamber scroll R.kit roots Q books)
  (hospital:MintClock.Hospital roots R.rolls Q R.kit.target MintClock.splits books ahead R.alloy.delay)
  (warm:Spill.Raffle.Warm G roots R.alloy.delay MintClock.splits)
  (atBare:Topline (Ψ N) (R.family.path.levels.clock.forcedAllowance N))
  (pass:Pass roots Q R.alloy R.kit)(way:WayStation R.kit)
  (young:m ≤ j)(live:j+1<N)
  (op₀:Mentor.Opportunity (R.alloy.B.a.clock.J (j+1)) (R.alloy.B.a.clock.J j))
  (lesson₀:Lesson (N:=N) R hk roots Q π Γ young)
  (cal₀:Oak.Calendar R hk roots Q π Γ Ψ young (N:=N) lesson₀)
  (op₁:Mentor.Opportunity (R.alloy.B.a.clock.J (j+2)) (R.alloy.B.a.clock.J (j+1)))
  (lesson₁:Lesson (N:=N) R hk roots Q π Γ (young.trans (Nat.le_succ j)))
  (cal₁:Oak.Calendar R hk roots Q π Γ Ψ (young.trans (Nat.le_succ j)) (N:=N) lesson₁)
  {D k:Fin n→ℕ}{V:Realm G (q+1) Credit.leanC}{draw:V.draws=R.family.path.levels}{rate δ:ℝ}
  (upper:Submitted R V draw D k N K (j+1) rate δ
    (Poetry.Agenda.seed roots MintClock.splits (Burn.horizon horizon) (R.alloy.B.a.clock.J (j+2))))
  (lower:Submitted R V draw D k N K j rate δ
    (Poetry.Agenda.seed roots MintClock.splits (Burn.horizon horizon) (R.alloy.B.a.clock.J (j+1))))
  (cells:Digits V.draws (Fin n))(κ:(v:Fin n)→Knob (D v))(pt:Fin n→Chamber)(seed:(v:Fin n)→Choice R k v)
  (y:Fin n → Cover)(t:Case D)(deep:∀s:Hot (Stock.census (Fin n)),0 < mass k s.val.val)

local notation "labels" => Hot (Stock.census (Fin n))
local notation "grid" => coarse R (j+1) per
local notation "fineSide" => fine R (j+1) per
local notation "parent" => binder (grid) y
local notation "younger" => chartIn (loose R.family.path.levels (j+1)) y (onLevels draw cells (j+1))
local notation "child" => binder (fineSide) (younger)
local notation "σ" => Poetry.Agenda.seed roots MintClock.splits (Burn.horizon horizon) (R.alloy.B.a.clock.J (j+2))
local notation "σₗ" => Poetry.Agenda.seed roots MintClock.splits (Burn.horizon horizon) (R.alloy.B.a.clock.J (j+1))

include simple upper lower course chamber hospital warm atBare pass way live cal₀ cal₁ in
theorem original (pieces stages order shelf p:ℕ)(load:Load horizon q order shelf p k pieces stages)
    (ready:Open R simple k pieces stages load j ∧ Open R simple k pieces stages load (j+1))
    (seats₀:op₀.count=pieces)(stages₀:op₀.stage=stages)(seats₁:op₁.count=pieces)(stages₁:op₁.stage=stages)
    (base₀ base₁:Fin n→ℝ)(wp₀:∀v,0<base₀ v)(wp₁:∀v,0<base₁ v)
    (tol₀ tol₁:ℝ)(tp₀:0<tol₀)(tp₁:0<tol₁):
    ∃(L:Material R N (j+1) q k σₗ (parent))(test:Case L.tests)(knob:(v:Fin n)→Knob (L.tests v))
      (H:Material R N ((j+1)+1) q k σ (child))
      (fund:Paid R H.realm H.start L.tests k H.allowance σ)(closed:Cloze L.tests k H.realm Credit.leanC)
      (X:Input H.realm H.start univ k L.tests H.amplitude),
      HEq test t ∧ HEq knob κ ∧ Account V rate δ (grid) y L t ∧ Addressed y L test ∧
      (∀z s,output L.prior s N z=fixed R k knob pt N K (j+1) (onLevels draw cells) seed z s) ∧
      Account V rate δ (fineSide) (younger) H test ∧
      H=book R H.realm H.start fund N X H.nonneg H.lower H.radius (child) pin (fun _=>subset_univ _)
        (fun s=>s.property.choose_spec) deep (younger) test closed H.tickets ∧
      (∀z s,output X s N z=fixed R k knob pt N K ((j+1)+1) (onLevels draw cells) seed z s) ∧
      Posted R hk roots Q π Γ Ψ books young op₀ lesson₀ ahead (port (grid) y) (parent)
        k order shelf q base₀ L tol₀ ∧
      Posted R hk roots Q π Γ Ψ books (young.trans (Nat.le_succ j)) op₁ lesson₁ ahead
        (port (fineSide) (younger)) (child) k order shelf q base₁ H tol₁ ∧
      ∀(P:Passport (fineSide) (Fin n))(I:Type)
        (printed:I→Row P (Stock.census (Fin n)) G (Affinity.Wallet (room (Fin n)))),
        P=port (fineSide) (younger) → I=((s:labels)×(words H s).Roster) → HEq printed (mounts H) →
      ∀(w:Fin n→ℝ),(∀v,0<w v) → ∀order seats shelf:ℕ,q≤order → 1 ≤ seats → n ≤ seats → (∑v,k v) ≤ shelf →
      ∃F:Mounted R κ pt N per (j+1) K q k y (onLevels draw cells) seed, HEq F.high printed ∧
        F.sheet=P ∧ HEq F.lower L ∧ HEq F.film test ∧ HEq F.knob knob ∧ HEq F.input X ∧
        F.rent=w ∧ F.order=order ∧ F.seats=seats ∧ F.shelf=shelf:=by
  obtain ⟨L,test,knob,H,fund,closed,X,atTest,atKnob,low,placed,issued,high,record,old,admit⟩ :=
    WilsonIndependentCollarMaterialAdmission.original upper lower cells κ pt seed per y t deep
  refine ⟨L,test,knob,H,fund,closed,X,atTest,atKnob,low,placed,issued,high,record,old,?_,?_,admit⟩
  · exact WilsonOriginalCensusPublicationLesson.original R simple hk roots Q π Γ Ψ course scroll books young
      (Nat.lt_trans (Nat.lt_succ_self j) live) op₀ lesson₀ cal₀ ahead chamber hospital
      (port (grid) y) (parent) k order shelf q base₀ L pieces stages p load ready.1
      seats₀ stages₀ wp₀ tp₀ warm atBare pass way
  · exact WilsonOriginalCensusPublicationLesson.original R simple hk roots Q π Γ Ψ course scroll books
      (young.trans (Nat.le_succ j)) live op₁ lesson₁ cal₁ ahead chamber hospital (port (fineSide) (younger))
      (child) k order shelf q base₁ H pieces stages p load ready.2 seats₁ stages₁ wp₁ tp₁ warm atBare pass way

