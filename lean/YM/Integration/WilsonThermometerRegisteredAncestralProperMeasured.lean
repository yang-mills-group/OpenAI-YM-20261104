variable {f:Extraction.Order} {H:(Bel R.family.book).Hierarchy}
    (checks:A.station.checked f H A.horizon) (unit:∀j,A.change j ((Bel R.family.book).unit j)=(Bel R.family.book).unit j)
    (station:A.station.k<N) (refs:∀v:Fin 3,R.family.ref (WilsonPositionThermometerCapStation.index A (WilsonPositionThermometerGradedSource.grade v))≤N)

include course hi checks unit station refs in
theorem at_measure (tab:Poly J₃) (s:(J₃).Mode):
    Integrable (fun U=>physical tab s U) (μ₀) ∧ (score₀ tab s)=∫U,physical tab s U ∂μ₀:=by
  let placed₀:=WilsonThermometerFiniteConnectedCells.placement R z₀ o.origin
  have measuredRead:=WilsonThermometerRegisteredMeasuredStation.original R A simple checks unit z₀ station refs i cut.le o.origin tab s
  have coincide (U):WilsonThermometerCourseResidual.table R A simple cut.le placed₀ U=
      WilsonThermometerCourseResidual.table R A simple cut.le o U:=by
    apply Marker.Poly.ext
    intro a
    rw [WilsonThermometerCourseResidual.observed R A simple cut.le placed₀ refs U a,
        WilsonThermometerCourseResidual.observed R A simple cut.le o refs U a]
    rfl
  have quiet:(Ψ i).eval=(R.family.path.rep N per i).eval:=(QuadraticLocal.Advent.later R π Γ Ψ course hi cut.le).view
  have income:(fun U=>(total (WilsonThermometerCourseResidual.table R A simple cut.le placed₀ U) tab).part s)=
      (fun U=>physical tab s U):=by
    funext U
    rw [coincide U,quiet]
    unfold WilsonThermometerCourseResidual.table total
    rw [smul_mul_assoc,Poly.part_smul,div_eq_inv_mul]
  exact income ▸ measuredRead

def older (J:Voice G) (axes:Lattice.Order) (q:ℕ) (tab:Poly J₃) (t:(J₃).Mode)
    (b h:Coefficient F₀ (R.family.side i per)) (U:Config G (R.family.side i per)):ℂ:=
  (total (paperₚ J axes q U) tab).part (complement t)+
    ((damping t):ℂ)*(account h (Ψ i) U-account b (Ψ i) U)/((Ψ i).eval U:ℂ)

local notation "before₀" J:max axes:max q:max tab:max t:max b:max h:max =>
  older R A simple cut o hk D bank π Γ Ψ books hi ahead order shelf seats P J axes q tab t b h

include course hi checks unit station refs in
theorem observation (J:Voice G) (axes:Lattice.Order) (q:ℕ) (tab:Poly J₃) (t:(J₃).Mode)
    (b h:Coefficient F₀ (R.family.side i per)) {M:ℝ} (env:RG.Envelope (diff₀ J axes q tab t b h))
    (paid:(∫U,‖actualTransport R.family (N:=N) (diff₀ J axes q tab t b h) (le_refl i) U‖ ∂μ₀)≤M):
    Integrable (before₀ J axes q tab t b h) (μ₀) ∧
      ‖(score₀ tab (complement t))-(∫U,(before₀ J axes q tab t b h) U ∂μ₀)‖≤M:=by
  have measuredRead:=at_measure R A simple cut o π Γ Ψ course hi checks unit station refs tab (complement t)
  haveI:IsProbabilityMeasure (μ₀):=OPE.Therm.probability (H:=R.family.path) (p:=per) R.makes.wilson cut.le
  have IX:Integrable (diff₀ J axes q tab t b h) (μ₀):=Integrable.of_bound env.meas.aestronglyMeasurable env.cost.choose
      (ae_of_all _ env.cost.choose_spec)
  have eq:(fun U=>physical tab (complement t) U)-(before₀ J axes q tab t b h)=(diff₀ J axes q tab t b h):=by
    funext U
    dsimp only [Pi.sub_apply,older,WilsonThermometerRegisteredAncestralProperPrior.signed]
    ring
  have back:(before₀ J axes q tab t b h)=(fun U=>physical tab (complement t) U)-(diff₀ J axes q tab t b h):=by rw [←eq];abel
  have Iy:Integrable (before₀ J axes q tab t b h) (μ₀):=back ▸ measuredRead.1.sub IX
  refine ⟨Iy,?_⟩
  rw [measuredRead.2,←integral_sub measuredRead.1 Iy]
  change ‖∫U,((fun U=>physical tab (complement t) U)-(before₀ J axes q tab t b h)) U ∂μ₀‖≤M
  rw [eq]
  exact (norm_integral_le_integral_norm _).trans (by simpa only [actualTransport_base R.family R.makes cut.le] using paid)

