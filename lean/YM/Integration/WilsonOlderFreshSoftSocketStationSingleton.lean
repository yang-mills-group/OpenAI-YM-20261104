def reserve (D:Fin 3→ℕ)(p H:ℕ)(C:Fin 3→ℝ):ℝ:=
  1+∑t:Faces,(|ticket R t C|+|invoice R D p C t| *((4/3:ℝ)^H+1))

private theorem everywhere (D:Fin 3→ℕ)(p H:ℕ)(C:Fin 3→ℝ)(t:Faces):
    |ticket R t C|+|invoice R D p C t| *((4/3:ℝ)^H+1) ≤ reserve R D p H C:=by
  apply le_trans (single_le_sum (f:=fun t:Faces=>|ticket R t C|+|invoice R D p C t| *((4/3:ℝ)^H+1))
    (fun _ _=>by positivity) (mem_univ t))
  unfold reserve
  linarith

theorem cash (F Z Q:ℂ)(a b g θ f E:ℝ)(q H:ℕ)(g0:0<g)(g1:g ≤ 1)(θ0:0 ≤ θ)(θ1:θ ≤ 1)(f0:0 ≤ f)(f1:f ≤ 1)(cap:E ≤ H)
    (FY:‖F-Z‖ ≤ a*f*((4/3:ℝ)^E*θ^q))(price:‖Z‖ ≤ a*f*g⁻¹^E)(cut:‖F-Q‖ ≤ b*g^q):
    ‖Q‖ ≤ (|b|+|a| *((4/3:ℝ)^H+1))*g⁻¹^H:=by
  let X:=g⁻¹^H
  have ginv:1 ≤ g⁻¹:=(one_le_inv₀ g0).mpr g1
  have X1:1 ≤ X:=one_le_pow₀ ginv
  have X₀:0 ≤ X:=zero_le_one.trans X1
  have rate:(4/3:ℝ)^E ≤ (4/3:ℝ)^H:=by simpa only [Real.rpow_natCast] using
      Real.rpow_le_rpow_of_exponent_le (show (1:ℝ) ≤ 4/3 by norm_num) cap
  have fuel:g⁻¹^E ≤ X:=by
    simpa only [Real.rpow_natCast,X] using Real.rpow_le_rpow_of_exponent_le ginv cap
  have one:a*f ≤ |a|:=calc a*f ≤ |a| *f:=mul_le_mul_of_nonneg_right (le_abs_self _) f0
                           _ ≤ |a|:=mul_le_of_le_one_right (abs_nonneg _) f1
  have fired:‖F-Z‖ ≤ |a| *(4/3:ℝ)^H:=FY.trans <| mul_le_mul one
    ((mul_le_of_le_one_right (Real.rpow_nonneg (by norm_num) _) (pow_le_one₀ θ0 θ1)).trans rate)
    (mul_nonneg (Real.rpow_nonneg (by norm_num) _) (pow_nonneg θ0 _)) (abs_nonneg _)
  have bought:‖Z‖ ≤ |a| *X:=price.trans <| mul_le_mul one fuel (Real.rpow_nonneg (inv_nonneg.mpr g0.le) _) (abs_nonneg _)
  have spent:‖F-Q‖ ≤ |b|:=cut.trans <| (mul_le_mul_of_nonneg_right (le_abs_self _) (pow_nonneg g0.le _)).trans
    (mul_le_of_le_one_right (abs_nonneg _) (pow_le_one₀ g0.le g1))
  calc ‖Q‖=‖(Q-F)+(F-Z)+Z‖:=by congr 1;ring
       _ ≤  ‖Q-F‖+‖F-Z‖+‖Z‖:=(norm_add_le ..).trans (add_le_add_left (norm_add_le ..) _)
       _ ≤ |b|+|a| *(4/3:ℝ)^H+|a| *X:=by rw [norm_sub_rev Q F];gcongr
       _ ≤ (|b|+|a| *(4/3:ℝ)^H)*X+|a| *X:=by gcongr;exact le_mul_of_one_le_right (by positivity) X1
       _=_:=by dsimp only [X];ring

theorem original (D:Fin 3→ℕ)(p q width:ℕ)(ξ δ η:ℝ)(m C:Fin 3→ℝ)
    (A₀:Group R.family 6)(r:ℝ)(rp:0<r)(order:ℕ)(M:Fin 3→ℝ)(reg:Indexed R grade (fun _=>A₀.station.k) order η M (filed R A₀))
    (v N per K c w₀:ℕ)(V:Realm G (p+1) Credit.leanC)(draw:V.draws=R.family.path.levels)
    (kK:A₀.station.k ≤ K)(ck:c ≤ K)(live:K<N)(vN:v ≤ N)
    (low:regulatorRun R.family N per v ≤ 1)(narrow:regulatorRun R.family N per K ≤ 1)
    (field:Hearing R D p q width ξ δ η m C A₀ r order M reg v N per K c w₀ V draw kK ck live)
    (bank:Cleared R D p width ξ δ η m C A₀ r order M reg v N per K c V draw kK ck live)
    (stopped:Compared R D p q C η A₀ r order M reg v N per K c w₀ V draw kK ck live):
    let H:=overhead R width ξ η δ m
    let g:=regulatorRun R.family N per K
    let θ:=regulatorRun R.family N per v
    let x:=vector R grade (fun _=>A₀.station.k) K order η M (filed R A₀) (fun _=>kK) reg N per
    let pay:=fun i=>(r/R.family.S.a K)^grade i
    ∀(t:Faces),t.Nonempty→∀(y:Sites N per×Sites N per)(trial:TestAt D t),
      let a:=enrolled R D V draw N per c (ck.trans live.le) y t trial
      ‖scaled t pay (row (R:=R) D V t N K c w₀ v a g x p θ true)‖ ≤ reserve R D p H C*g⁻¹^H:=by
  intro H g θ x pay t occupied y trial a
  let W:=∏i:t,pay (seat t i)
  let E:=rent R width ξ η m t+δ
  let w:=fitted R grade (fun _=>A₀.station.k) K order η M (filed R A₀) (fun _=>kK) reg N per
  let Z:=deposit R p D V t draw N per K c v a w
  let F:=row (R:=R) D V t N K c w₀ v a g x p θ false
  let Q:=row (R:=R) D V t N K c w₀ v a g x p θ true
  have W0:0 ≤ W:=prod_nonneg fun _ _=>pow_nonneg (div_nonneg rp.le (R.family.S.a_pos _).le) _
  have θ0:0 ≤ θ:=(ActualRunKernelPackets.regulator_pos R N per v vN).le
  have g0:0<g:=ActualRunKernelPackets.regulator_pos R N per K live.le
  have xeq:(fun i=>WilsonPositionProgramReportedField.entire R (grade i) K (N,per) (w i))=x:=by
    funext i
    simp only [x,WilsonOriginalPublicTrialInput.vector,if_pos live]
    rfl
  have phase:residual R p D V t draw N per K c w₀ v a w=F-Z:=by
    unfold WilsonOlderFreshSoftSocketFitted.residual
    rw [xeq]
    rfl
  have cap:E ≤ (H:ℝ):=by
    simpa only [Nat.cast_zero,zero_add] using WilsonOlderFreshSoftSocketStationSale.covers R width ξ η δ m 0 t
  have first:=field t occupied y trial
  change W*‖residual R p D V t draw N per K c w₀ v a w‖ ≤ _ at first
  rw [phase] at first
  have FY:‖(W:ℂ)*F-(W:ℂ)*Z‖ ≤ invoice R D p C t*‖a.test‖*((4/3:ℝ)^E*θ^q):=by
    rw [←mul_sub,norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg W0]
    exact first
  have bought:‖(W:ℂ)*Z‖ ≤ invoice R D p C t*‖a.test‖*g⁻¹^E:=by
    rw [norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg W0]
    exact bank t occupied y trial
  have residualFee:=stopped p le_rfl θ (by rwa [abs_of_nonneg θ0]) t occupied y trial
  apply (cash ((W:ℂ)*F) ((W:ℂ)*Z) ((W:ℂ)*Q) (invoice R D p C t) (ticket R t C) g θ ‖a.test‖ E q H
    g0 narrow θ0 low (ContinuousLinearMap.opNorm_nonneg a.test) (by exact trial.bound) cap FY bought residualFee).trans
  exact mul_le_mul_of_nonneg_right (everywhere R D p H C t) (pow_nonneg (inv_nonneg.mpr g0.le) _)

end YM.Integration.WilsonOlderFreshSoftSocketStationSingleton
