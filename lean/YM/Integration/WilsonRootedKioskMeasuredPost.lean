theorem measured_post (extra:ℝ)
    (deposited:Burn.Candor (A.B.a.budget (m+1)) U.activities (Set.range Zj.model)
      (Burn.silver (A.B.a.clock.hatBeta (m+1))) youngFee)
    (marked:Tint.Campus.Investor.Medal M Y' w TL 0 (Gp^r.stage)):
    Nonempty (WilsonRootedKioskSealedPost.Return R' ((pℓ).ratio.parent ∘ J.origin) Ρ w extra
      (WilsonRootedKioskFreeRadius.radius extra shift allFee tW) totalReg tQ
      (WilsonRootedKioskOccupiedSlip.bare nominalRows) (fun mark=>(pℓ).push U.beta ((Tint.Patrol.picture M Y').density mark))) ∧
    totalReg ≤ 8*ξ*(e'+youngFee+incomeH) ∧ ξ≤ Y₁ ∧
    WilsonRootedKioskFreeRadius.radius extra shift allFee tW ≤
      max (max 1 extra) (ξ^5+(Spill.allOver (A.B.a.budget m))^(Bx).cap*ξ/tW):=by
  have actual : Burn.Candor U.p U.activities (Set.range Zj.model)
      (Burn.silver (A.B.a.clock.hatBeta (m+1))) youngFee := by
    rw [hF]
    exact deposited
  obtain ⟨f,remaining⟩:=Tint.Campus.Hearth.cure U (Set.range Zj.model) _ _ actual
  have capacity:=WheelP.capacitor R Q A F h K.paid
  have price : youngFee ≤ ConnectedActivityE6.incomingE G (D.L Xz) (A.B.a.clock.hatBeta m) := by
    rw [PriceCompiler.beta_eq A.B.valid m]
    exact capacity.paid.2
  have initial := QuadraticLocal.Spill.Foundry.empty_lit («w»:=w) U Y' U.p.supportExponent U.p.B
  obtain ⟨f₀,f₁,f₂,f₃⟩:=initial
  have bought : Y'.old.Paid w U.p.B U.p.supportExponent e' :=
    ⟨f₀,f₁,f₂,fun x=>budget_loosen (f₃ x) hr.le⟩
  exact sealed_post («R»:=R) («D»:=D) («Q»:=Q) («A»:=A) («F»:=F) (φ:=φ) («K0»:=K0)
    («h»:=h) («hE»:=hE) («r»:=r) («K»:=K) («u»:=u) («M»:=M) («w»:=w) («T»:=T)
    («n₀»:=n₀) («Vv»:=Vv) («X'»:=X') («hX»:=hX) («Qa»:=Qa) («hF»:=hF) («hU₁»:=hU₁)
    («Y'»:=Y') («hw»:=hw) («hq»:=hq) («y»:=y) («TL»:=TL) («Yh»:=Yh) («Zj»:=Zj)
    («hk»:=hk) («hc»:=hc) («hs»:=hs) (κr:=κr) («hκr»:=hκr) («hβ'»:=hβ') («hm'»:=hm')
    («g»:=g) («hcZ»:=hcZ) («hδ»:=⟨f,remaining,price⟩) («b'»:=b') («U₀»:=U₀)
    («hvW»:=hvW) («hr»:=hr) («hr'»:=hr') («hO»:=bought) («hY»:=hY) («hp»:=hp) («uV»:=uV)
    extra hr.le marked

