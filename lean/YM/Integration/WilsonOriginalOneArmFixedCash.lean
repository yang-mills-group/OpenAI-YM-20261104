theorem regular {u b size:ℕ}{s:(marks).Mode}{P:ℕ}{η:ℝ}
    (charged:Sale R simple hk D Q π Γ Ψ books base ahead rows upper lower u b s P size η):
    Integrable (rows (j+1+1)) (prior G _) ∧ Integrable (rows (j+1)) (prior G _):=by
  cases charged with
  | @issued charges q h target ε δ C course live way pass month hospital warm nn nn' calendar seen budget eps K floor older finer admitted n cost f d count tariff grade period start rentPaid shape jets support p tol tp reserve aged atStation df frame section_ group ticket mature failure past mu ub fixed narrow load one more wide neighbor capture qc hardFloor hardDeep hardAge err ep rented opened np stage load_ok cap Z center atHome resident drift E ep₀ E0 enclosed reg room late span =>
    have available:=R.alloy.B.a.fits.mono (Nat.le_succ_of_le (Nat.le_succ_of_le base))
    have highOrder:upper.order ≤ R.alloy.B.a.clock.J (j+1+1):=calendar.fits.trans
      ((Nat.le_add_right (Burn.horizon k+1) 1).trans (hk.trans available))
    have upperPaid:=WilsonOriginalFreshPrintedGross.original R hk D Q π Γ Ψ course books (Nat.le_succ_of_le base)
      live ahead (actors) (nulls) upper.grades upper.order upper.shelf upper.seats upper.law (high) simple
      warm highOrder calendar.narrow calendar.load (Nat.le_succ_of_le calendar.halo)
    have lowerPaid:=WilsonOriginalFreshPrintedGross.original R hk D Q π Γ Ψ course books base (Nat.lt_of_succ_lt live)
      ahead (actors) (nulls) lower.grades lower.order lower.shelf lower.seats lower.law (low) simple
      warm calendar.depth calendar.shelved calendar.slots calendar.halo
    have hiInt:Integrable (rows (j+1+1)) (prior G _):=by
      rw [←upper.atInput,funext (upper.appointment.declared upper.x)]
      exact upperPaid.2.2 upper.x
    have loInt:Integrable (rows (j+1)) (prior G _):=by
      rw [←lower.atInput,funext (lower.appointment.declared lower.x)]
      exact lowerPaid.2.2 lower.x
    exact ⟨hiInt,loInt⟩

/-- The real two-flat receipt can be spent at a clear finite field W. Its own
gallery supplies the complete signed hard response there. -/
theorem original {u b size:ℕ}{s:(marks).Mode}{P:ℕ}{η:ℝ}
    (issued:WilsonReceivedChronologicalDualInterval.Owned (N:=N) R simple hk D Q π Γ Ψ books ahead rows j u b s P size η):
    (Integrable (rows (j+1+1)) (prior G _) ∧ Integrable (rows (j+1)) (prior G _)) ∧
    ∀W:Config G (R.family.side b per),flags (R.family.path.rep N per b).p.threshold W=∅ →
      (Real.exp (WilsonOriginalDecoderSpring.bill (R.family.path.levels.clock.op b per)
        (R.family.path.β N per (b+1)) W))^2≤2 →
      ‖WilsonOriginalJointTrialHearing.fee R N per W rows (j+1) s‖≤
        (WilsonOriginalOrdinaryFaceOrder.constant s s.val.card+η*2^P*((shards (marks) s).card:ℝ))*(gAt b)^P:=by
  obtain ⟨lo,_,_,_,_,highFile,lowFile,bought⟩:=issued
  exact ⟨regular R simple hk D Q π Γ Ψ books lo ahead rows highFile lowFile bought,
    WilsonOriginalOneArmFixedHearing.original R simple hk D Q π Γ Ψ books lo ahead rows highFile lowFile bought⟩

