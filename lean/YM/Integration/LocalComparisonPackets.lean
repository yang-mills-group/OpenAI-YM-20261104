import YM.Integration.LocalComparisonInterface
import YM.Integration.LocalFormalCoefficients
import YM.Comparison.Density.RenderM.Inflect

/-! Literal curvature packets for the local-comparison interface.

The real function is defined from the packet's paths and coefficient tensors.
Only afterwards is its finite coupling coefficient bank identified with the
independently prescribed `Bulk.Fk` bank. In particular a freely chosen real
function with the same finite jet is not accepted as a rendering.

This file supplies types and definitions. It neither constructs the packets
nor proves a local comparison estimate. Completion terms above the comparison
order remain in `read`; they are not silently discarded.
-/
set_option autoImplicit false
noncomputable section
namespace YM.Integration.LocalComparison
open Lattice Wilson RG Marker MeasureTheory Exterior Precision
open Comparison.Density.RenderM Comparison.RG02
open scoped BigOperators Classical ContDiff

variable {G : Gauge} {n : Side} {V : Type} [DecidableEq V] {R : Census V}
    (D : V → ComparisonDensity.Address.Orbit)

/-- A countable common layout of literal curvature packets. Empty entries
provide padding without introducing a fictitious nonempty marker mode.
The coupling powers are part of the packet data, not recovered from an
arbitrary real completion. -/
structure MarkedPackets (G : Gauge) (n : Side) (R : Census V) where
  mode : ℕ → R.Mode
  rank : ℕ → ℕ
  power : ℕ → ℤ
  packet : (i : ℕ) → Option (Token G n (fun v => (D v).Mood) (rank i))
  marked i T : packet i = some T → mode i ≠ R.quiet
  rankCap : ℕ
  powerCap : ℕ
  rank_bounded i T : packet i = some T → rank i ≤ rankCap
  power_bounded i T : packet i = some T → (power i).natAbs ≤ powerCap
  nonnegative_grade i T : packet i = some T → 0 ≤ power i + (rank i : ℤ)

namespace MarkedPackets
variable {D} (P : MarkedPackets D G n R)

def term (x : TestSpace D) (g : ℝ) (U : Config G n) (i : ℕ) : ℂ :=
  match P.packet i with
  | none => 0
  | some T => (g : ℂ) ^ P.power i * T.read x U

/-- Full unmasked value, including all higher-grade terms generated by the
chosen nonlinear curvature completion. -/
def read [Fintype V] (x : TestSpace D) (g : ℝ) (U : Config G n) : Poly R :=
  ∑' i : ℕ, Poly.send (P.mode i) (P.term x g U i)

/-- Common packet coefficient bounds retain every test address and every
marker root before any independent unit tests are chosen. Exponential path
payments and their actual coupling factors are explicit. -/
structure Paid (p : BudgetPoint) (address : V → Support n)
    (region : Comparison.Density.Testing.Region (fun v => (D v).Mood) n)
    (w : V → ℝ) (g width budget : ℝ) (coverOffset coverSlope : ℕ) : Prop where
  width_pos : 0 < width
  positive v : 0 < w v
  coefficient i T : P.packet i = some T →
    0 ≤ T.coin ∧ ∀ x : IndependentTests D,
      (∑ j, ‖T.gem j (testInclusion D x)‖) ≤ T.coin
  paths i T : P.packet i = some T → ∀ x : TestSpace D,
    (T.re x).length ≤ T.fall ∧ (T.re x).footprint T.root ⊆ T.plot
  addresses i T : P.packet i = some T → ∀ v ∈ (P.mode i).val,
    address v ⊆ T.plot
  symmetry i T : P.packet i = some T → ∀ x U (k : G.El),
    T.touch x (fun i => G.adjoint k (U i)) = T.touch x U
  reads i T : P.packet i = some T → ∀ j,
    Comparison.Density.Testing.Reads region T.plot (P.mode i).val (T.gem j)
  multilinear i T : P.packet i = some T → ∀ j,
    RG3.Held.Letter ℂ (fun v => (D v).Mood) (P.mode i).val (T.gem j)
  roots v : SumBudget
    (fun i => if v ∈ (P.mode i).val then
      match P.packet i with
      | none => 0
      | some T => Poly.toll w (P.mode i) * ‖(g : ℂ) ^ P.power i‖ *
          T.coin * Real.exp (width * T.fall)
      else 0) budget
  cover i T : P.packet i = some T →
    p.B * (coverNumber p.B T.plot : ℝ) ≤ coverOffset * p.B + coverSlope * T.fall
  width_reserved : p.supportExponent * coverSlope / p.B ≤ width / 4

end MarkedPackets

variable {D} {C : Family G} [Fintype V]

/-- Exact finite-order identification of a literal packet completion with
one fixed full formal prescription. The extension is uniquely tied to the
full packet value at every nonzero coupling; it is not a selectable bump.
The fields `inputColors`, the common datum and packet layout all precede the
test quantifier. This is the pre-reset field/coupling convention of the
local formal step; a subsequent coupling reset is a separate operation. No estimate on an actual RG output occurs in this record. -/
structure PrescribedPackets (Y : Bulk.Chain C.path)
    (datum : LocalFormal.Datum C R)
    (inputColors : TestSpace D → Bulk.Colors R G (C.side (datum.level + 1) datum.period))
    (P : MarkedPackets D G (C.side datum.level datum.period) R)
    (order : ℕ) where
  summable (x : TestSpace D) (g : ℝ) (hg : g ≠ 0)
      (U : Config G (C.side datum.level datum.period)) :
    Summable (fun i => Poly.send (P.mode i) (P.term x g U i))
  extension : TestSpace D → ℝ → fieldDir G (C.side datum.level datum.period) 1 → Poly R
  value x g (hg : g ≠ 0) A :
    extension x g A = P.read x g (represent (g • A))
  smooth x A : ContDiffAt ℝ order (fun g : ℝ => extension x g A) 0
  coefficients (x : TestSpace D) (A : fieldDir G (C.side datum.level datum.period) 1)
      (k : ℕ) (hk : k ≤ order) :
    ((k.factorial : ℝ)⁻¹) •
      iteratedFDeriv ℝ k (fun g : ℝ => extension x g A) 0 (fun _ => 1) =
      Order.observe R order
        (({ datum with colors := inputColors x, field := A } : LocalFormal.Datum C R).markedLog
          Y order) k

end YM.Integration.LocalComparison
