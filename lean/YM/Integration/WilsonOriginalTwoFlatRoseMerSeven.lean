theorem price (old:age<top)(order shelf:ℕ)(income:Fin 3→ℝ)(tol:ℝ)
    (posted:∀s y,WilsonOriginalCensusMaterialPosting.Posted R hk D Q π Γ Ψ books hi op lesson ahead
      ((ports) s y) ((binders) s y) grades order shelf q income (M s y) tol)
    (filed:∀s y,Filed (K:=top) (draw:=draw) (rate:=rate) (δ:=δ) (restore)
      κ pt (full R grades y) (side) (home s) t (M s y))
    (vc:age≤cap)(ck:cap≤top)(ratio:LocalRatio R.metals.O)(hg:0≤g)(small:g≤1)
    (p:ℕ)(bound:p≤q)(kept:hasPoles p)(T:FC):
    ‖(held T) (age) 1-(trueFigure T p)‖≤g^(p+1)*((weights T)*(printed))+costFigure T p:=by
  have earned:=WilsonOriginalTwoFlatIRFlatChronicle.original R hk D Q π Γ Ψ course books hi cut op lesson ahead
    grades o v c (ports) (binders) q M (x) previous old order shelf income tol posted hg small p (seat T)
  have exactAt:(nativeAt p T)=(trueAt p T):=by
    apply Finset.sum_congr rfl
    intro y _
    apply congrArg ((wallet) (seat T) y * ·)
    exact WilsonOriginalTwoFlatIRFlatActive.original κ pt (restore) (full R grades y) (home (seat T)) t
      (M (seat T) y) simple vc ck upper (filed (seat T) y) (fun a=>(xx (seat T) a).val) g p bound T
  have scalar:=WilsonOriginalTwoFlatRoseMerFigure.original R (cap:=cap) (draw:=draw) κ pt o upper cut t xx v c
    simple ratio vc ck p (seat T) (kept T) hg small
  calc
    _ ≤ ‖(held T) (age) 1-(trueAt p T)‖+‖(trueAt p T)-(trueFigure T p)‖:=by
      simpa only [dist_eq_norm] using dist_triangle ((held T) (age) 1) (trueAt p T) (trueFigure T p)
    _ ≤ _ :=by
      apply add_le_add _ scalar
      rw [←exactAt]
      exact earned.trans (mul_le_mul_of_nonneg_left
        (WilsonOriginalTwoFlatRoseMerWage.purchased R D cut grades axis κ pt o upper t M (x) v c filed T) (pow_nonneg hg _))

include simple course cut in
theorem original (old:age<top)(order shelf:ℕ)(income:Fin 3→ℝ)(tol:ℝ)
    (posted:∀s y,WilsonOriginalCensusMaterialPosting.Posted R hk D Q π Γ Ψ books hi op lesson ahead
      ((ports) s y) ((binders) s y) grades order shelf q income (M s y) tol)
    (filed:∀s y,Filed (K:=top) (draw:=draw) (rate:=rate) (δ:=δ) (restore)
      κ pt (full R grades y) (side) (home s) t (M s y))
    {u:ℕ}(uc:u≤cap)(vc:age≤cap)(ck:cap≤top)
    (reg:∀s:FC,∀j:ℕ,min u (age)≤j→j≤top→Integrable (numerator R N per j ((held s) j)) (prior G _))
    (ratio:LocalRatio R.metals.O)(hg:0≤g)(small:g≤1)(p:ℕ)(bound:p≤q)(kept:hasPoles p):
    ‖(readAt)-WilsonPositionThermometerConnected.value (fun s:FC=>trueFigure s p)-
      ∑s:FC,(chargeFigure s p)*(invoice u uc vc ck s)‖≤
      ∑s:FC,‖chargeFigure s p‖*(g^(p+1)*((weights s)*(printed))+costFigure s p):=by
  rw [WilsonMaxwellThermometerNominatedCofactor.original,WilsonMaxwellThermometerNominatedSecant.signed,←Finset.sum_sub_distrib]
  apply (norm_sum_le ..).trans (sum_le_sum _)
  intro s _
  have bridge:=WilsonOriginalTwoFlatRoseIdentity.figure R uc vc ck upper (phys s)
    (WilsonOriginalTwoFlatRoseNominated.paid R A₀ (pairAt) s) (held s) (reg s) (trueFigure s p)
  have earned:=price R simple hk D Q π Γ Ψ course books hi cut op lesson ahead
    grades axis κ pt o upper t M xx v c previous old order shelf income tol posted filed vc ck ratio hg small p bound kept s
  change ‖(chargeFigure s p)*((physical) s-(trueFigure s p))-(chargeFigure s p)*(invoice u uc vc ck s)‖≤_
  rw [←mul_sub,bridge,add_sub_cancel_left,norm_mul]
  exact mul_le_mul_of_nonneg_left earned (norm_nonneg _)

