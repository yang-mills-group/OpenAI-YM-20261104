theorem original [Fintype I]{p':Passport n' (Fin n)}{μ:Type}
    (high:μ → Row p' (Stock.census (Fin n)) G (Affinity.Wallet (room (Fin n))))
    (placed:p'=P)(names:μ=((l:I)×((words H) l).Roster))(ink:HEq high (mounts H))
    {w:Fin n → ℝ}{σ₀ expense:ℝ}{order seats shelf:ℕ}
    (stock:Scene.Armada high w k σ₀ expense order seats shelf)(width₀:0 < σ₀)
    {grid:Side}(u:Covers R.family.path.levels.S j grid)(tag:(step R j u.val).Choices)
    (baseGeometry:n'.val=grid.val*(patch).L.val)
    (h:n'.val∣(fine R j u.val).val)(lead:∀s:Finset I,s.Nonempty→s)(x:Affinity.Wallet (room (Fin n)))
    {start e:ℕ}{quiet:ℕ → SeriesA G}{π:ℕ → Layout G}{Γ:ℕ → Pace.Coin}
    (legal:Legal (Step.tape (e+2)) (π (j+1)))
    (course:Read R N start e quiet π Γ)(live:start ≤ j){τ cash:ℝ}
    (funded:Issued R N (j+1) e (quiet (j+1)) τ cash)
    (starts:Γ j 0=0)(r d:ℕ)(retained:r ≤ q)(grade:r ≤ e+2)(kept:d ≤ r)
    (target:(Stock.census (Fin n)).Mode)(v:Stationary.Link G grid)
    (z:I→Lattice.Cover)(atSite:∀l,wrap grid (z l)=(Ratio.mk (patch).L baseGeometry:Ratio grid n').parent ((B l).center)):
    let F:=repeatF (step R j u.val)
    let U:Adjacent.Display (Stationary.Link G (coarse R j u.val)):=fun l b=>
      let K₀:=model R N j u.val (show j<N by omega)
      let raw:=Bulk.Fk K₀ F tag (copyColor h high k (fun a=>(high a).paint x) (π (j+1)) (Step.tape (e+2)))
        (Stationary.arm G _ 1 b) r
      (Order.observe (Stock.census (Fin n)) r (Order.logMarked raw) l).part target

    let centers:=fun l:I=>(B l).center
    let children:=fun l:I=>(Ratio.mk (patch).L baseGeometry:Ratio grid n').residue (centers l)
    let rows:=fun (s:Finset I)(o:s) a=>WilsonOriginalCensusRosterMenu.sheets R (ranks) N j q grid
      (reprint) children s o.val z d a v u
    (Pages grid (coarse R j u.val):ℂ)⁻¹*Adjacent.born U ((Rebirth.caliber (Γ j) starts).back (e+2)) 0 r d
      (AllOrder.Ker.convey (coverWin u.prop) v)=
      ∑s:Finset I,wages B x target s*WilsonOriginalCensusRosterFare.whole (ranks) d s lead rows:=by
  intro F U centers children rows
  have filed:=WilsonNeutralTwoPrintPathBoardReset.original R Y lo enrolled N X positive limit width B c inside
    pin deep y t closed tickets old well hs base cover bound high placed names ink stock width₀ u.val tag
    baseGeometry u.prop h lead x legal course live funded starts r d retained grade kept target v z atSite
  refine filed.trans (Finset.sum_congr rfl fun s _=>?_ )
  apply congrArg (fun a:ℂ=>wages B x target s*a)
  by_cases live:s.Nonempty
  · simp only [WilsonOriginalCensusRosterFare.whole,dif_pos live]
    apply Finset.sum_congr rfl
    intro a ha
    have places:WilsonNeutralTwoPrintPathBoxPlacement.homes (R.family.side j u.val) (z (lead s live))
        (WilsonIndependentCollarOrbitalReception.relative s (lead s live) z)=
        (fun i=>wrap (R.family.side j u.val) (z i.val)):=by
      funext i
      dsimp only [WilsonNeutralTwoPrintPathBoxPlacement.homes,WilsonIndependentCollarOrbitalReception.relative]
      congr 1
      abel
    have field:WilsonIndependentCollarAngularPeg.multiplier (r:=a) v=
        (fun x=>∏k:Fin a,((coordinates G grid) v (x k):ℂ)):=by
      funext x
      simp [WilsonIndependentCollarAngularPeg.multiplier]
    simp only [rows,WilsonOriginalCensusRosterMenu.sheets,WilsonIndependentCollarOrbitalPeg.outer,places,field]
    rfl
  · simp [WilsonOriginalCensusRosterFare.whole,live]

