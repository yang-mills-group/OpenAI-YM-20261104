variable {G : Gauge} {n d : ℕ}
theorem original (A : MS_Data G (OpenAxis.Plot (Press.portDeck G))) (μ : ℝ) (x : Stage n)
    (k : ℕ) (v : Fin n→Sec G d) :
    Equator.wave μ A d n x k v =
    ∑t:Fin n→Dframe.Toon G d,
      MS.Dial.tour A (Dframe.flash ∘ t) μ (Arrival.Schedule.plot x.val) Finset.univ k *
      ∏i:Fin n,(MS.Theater.Daylight (Press.portDeck G) d).repr (v i) (t i) := by
  change Dframe.meteor μ A d x.val k v=_
  simp only [Dframe.meteor,sum_apply,smul_apply,smul_eq_mul,Dframe.sift]
  rfl
