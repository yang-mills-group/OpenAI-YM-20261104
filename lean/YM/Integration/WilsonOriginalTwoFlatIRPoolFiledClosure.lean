/-- The original screened spatial registration, directions and reference threshold. -/
def Located (R:Run G)(φ:Test 3)(r:ℝ){f K:ℕ}(fk:f≤K)
    (src apron N per:ℕ)(kn:K≤N){requested pole tag:ℕ}{B:ℝ}
    (Y:cells R φ r (f,per)→Panel R ages N per f K fk kn requested pole tag B):Prop:=
  ∀o,Ground R N per src f apron o.val ∧ (Y o).turn=(fun _=>WilsonOriginalTwoFlatIRPoolBook.direct) ∧
      ∀i k,k≤ages i→R.family.ref k≤N

/-- The selected finite ordinary cohort, with its actual two endpoint charges and signed report. -/
def Closed (R:Run G)(l:Filter (ℕ×ℕ))(D:Fin 3→ℕ)(pt:Fin 3→Chamber)(φ:Test 3)
    (dates:Fin 3→ℕ)(labels:∀i:Fin 3,ℕ×ℕ→R.family.label (ages i))(M:Fin 3→ℝ)
    (r γ:ℝ)(sensor:ℂ)(margin:ℝ){u f K:ℕ}(uf:u≤f)(fk:f≤K)(c m Q J₀ requested tag src apron:ℕ)
    (plan:Plan 3)(file:Filed R ages K){top:ℕ}{Vc:Realm G (top+1) Credit.leanC}
    (drawc:Vc.draws=R.family.path.levels):Prop:=
  ∀ᶠpair:ℕ×ℕ in l,∃(kn:K≤pair.1)(Y:cells R φ r (f,pair.2) →
        Panel R ages pair.1 pair.2 f K fk kn requested plan.pole tag plan.tuition),
    Named R dates labels M fk plan file φ r pair.1 pair.2 kn Y ∧
    Located R φ r fk src apron pair.1 pair.2 kn Y ∧
    Posted R ages D pt φ r (K:=K) (N:=pair.1) (per:=pair.2) (c:=c) (v:=m+1)
      (uf.trans fk) fk kn plan file Y drawc m Q ∧
    ‖sensor-signed R φ r (f,pair.2) (fun y=>value (independent R ages D pt φ r
      (K:=K) (N:=pair.1) (per:=pair.2) (c:=c) (v:=m+1) fk kn plan file Y drawc m J₀ y))‖/γ ≤ margin

theorem original (R:Run G)(l:Filter (ℕ×ℕ))(D:Fin 3→ℕ)(pt:Fin 3→Chamber)(φ:Test 3)
    (dates:Fin 3→ℕ)(labels:∀i:Fin 3,ℕ×ℕ→R.family.label (ages i))(M:Fin 3→ℝ)
    (r γ:ℝ)(sensor:ℂ)(margin:ℝ){u f K:ℕ}(uf:u≤f)(fk:f≤K)(c m Q J₀ requested tag:ℕ)
    (plan:Plan 3)(file:Filed R ages K){top:ℕ}{Vc:Realm G (top+1) Credit.leanC}
    (drawc:Vc.draws=R.family.path.levels)(src apron:ℕ)(filed:∀i,file.station i=dates i)
    (hearing:WilsonOriginalTwoFlatIRPoolPanelHearing.SignedReading R l D pt φ r γ sensor margin uf fk
      c m Q J₀ requested tag plan file drawc (Named R dates labels M fk plan file φ r))
    (cash:∀ᶠpair:ℕ×ℕ in l,∃(kn:K≤pair.1)(Y:cells R φ r (f,pair.2)→
          Panel R ages pair.1 pair.2 f K fk kn requested plan.pole tag plan.tuition),
      (∀o,Ground R pair.1 pair.2 src f apron o.val ∧ (Y o).slot=file.station ∧ (Y o).axis=file.A pair.1 pair.2 ∧
        (Y o).M=M ∧ (Y o).loc=o.val ∧ (Y o).turn=(fun _=>WilsonOriginalTwoFlatIRPoolBook.direct) ∧
        (∀i,(Y o).names i=labels i pair) ∧
        (∀i,WilsonReflectedPublicOrientedFaces.displayed R (ages i) ((Y o).names i) ((Y o).turn i)=labels i pair) ∧
        ∀i k,k≤ages i→R.family.ref k≤pair.1) ∧
      Posted R ages D pt φ r (K:=K) (N:=pair.1) (per:=pair.2) (c:=c) (v:=m+1)
        (uf.trans fk) fk kn plan file Y drawc m Q):
    Closed R l D pt φ dates labels M r γ sensor margin uf fk c m Q J₀ requested tag src apron plan file drawc:=by
  unfold WilsonOriginalTwoFlatIRPoolPanelHearing.SignedReading at hearing
  filter_upwards [hearing,cash] with pair heard issued
  obtain ⟨kn,Y,stamp,coupon⟩:=issued
  have named:Named R dates labels M fk plan file φ r pair.1 pair.2 kn Y:=by
    intro o
    obtain ⟨_,slot,axis,amount,placed,_,names,shown,_⟩:=stamp o
    exact ⟨placed,amount,slot,axis,fun i=>(congrFun slot i).trans (filed i),names,shown⟩
  refine ⟨kn,Y,named,?_,coupon,heard kn Y named coupon⟩
  intro o
  obtain ⟨site,_,_,_,_,direction,_,_,refs⟩:=stamp o
  exact ⟨site,direction,refs⟩

end YM.Integration.WilsonOriginalTwoFlatIRPoolFiledClosure

