/-- File the same original post under the owner's actual equal all-field entrance law. -/
def named {tol:ℝ}(ticket:source tol)(x:Wallet (A))
    (raw:Config G (R.family.side ((j+1)+1) per)→Poly (marks))
    (same:∀U,(physical) x U=raw U):
    WilsonOriginalDatedCensusInput.Filed (N:=N) R hk D Q π Γ Ψ books (Nat.le_succ_of_le base) ahead (S₀) (e₀) raw:=
  (funext same) ▸ (file ticket.post ticket.book x)

local notation "mounted" t:max x:max f:max e:max => named R hk D Q π Γ Ψ books base op lesson ahead d q hd y cells order shelf t x f e
variable {S':Fin n→ℝ}{a':ℕ}(inLow:Config G (R.family.side (j+1) per)→Poly (Stock.census (Fin n)))
  (lower:WilsonOriginalDatedCensusInput.Filed (i:=j) (N:=N) R hk D Q π Γ Ψ books base ahead S' a' inLow)
local notation "lo" => lower.post

local notation "Hhat" => R.alloy.B.a.clock.hatBeta (j+1)
local notation "peak" c:max l:max => 3*WilsonOriginalFullRosterBookedHearing.roof d d c l
local notation "size₀" => WilsonOriginalCensusPhysicalLoad.rank (WilsonOriginalCensusAngularFace.sides d d)
