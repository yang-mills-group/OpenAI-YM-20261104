variable {G:Gauge}{n:ℕ}{R:Run G}{N i e:ℕ}{k:Fin n→ℕ}{σ:ℝ}{side:Side}
  {y:Fin n → Cover}(H:Material R N i e k σ (binder side y))
  (κ:(v:Fin n)→Knob (H.tests v))(pt:Fin n→Chamber)(b:ℕ)
  (cells:Digits R.family.path.levels (Fin n))(seed:(v:Fin n)→Choice R k v)


local notation "I" => Hot (Stock.census (Fin n))
local notation "modes" => binder side y
local notation "Sof" z:max => ((modes) z).mode.val
local notation "node" z:max => toe (Sof z) (H.pin z) (H.root z) (H.frill z)

def continued (z:I)(c:ℕ):Era G ℝ:=
  cruises R.family.path.levels R.metals.O N (mass k (Sof z)) c i
    (tuftV (WilsonCoeffUV.Wheel.touch (H.source z) (Sof z))
      (levelsO ((fixed R k κ pt N b c cells seed)
        (address R.family.path.levels cells (c-i) i (node z))) (Sof z)))

theorem scalar (simple:G.Simple){c:ℕ}(late:i≤c)(above:c≤b)(hi:b≤N)
    (named:∀w S,output H.prior S N w=fixed R k κ pt N b i cells seed w S)
    (z:I)(one:∃j:Fin n,(Sof z)={j})(h:ℕ):
    occupied H z h=(continued H κ pt b cells seed z c).2 h 0 Fin.elim0:=by
  let L:=R.family.path.levels
  have path:=WilsonIndependentCollarMaterialStop.original H κ pt b cells seed simple late above hi
    named (Sof z) (WilsonCoeffUV.Wheel.touch (H.source z) (Sof z)) (node z)
  have home : (fun J=>output H.prior J N (node z))=(fixed R k κ pt N b i cells seed) (node z):=
    funext (named (node z))
  obtain ⟨_,_,hire⟩:=WilsonReceivedCanonicalVerseRegister.original R k κ pt e (s:=1) zero_lt_one
  have well:=WilsonReceivedFixedDigitHistory.sound L R.metals.O k N cells simple R.alloy.B.ratio
    (start R k κ pt seed) (hire seed).1 (b-i) i (by omega)
  have quiet : levelsO (fun J=>output H.prior J N (node z)) (Sof z)=output H.prior (Sof z) N (node z):=by
    change levelsO (fun J=>output H.prior J N (node z)) (Sof z)=(fun J=>output H.prior J N (node z)) (Sof z)
    rw [home]
    obtain ⟨a,ha⟩:=one
    generalize hg:(node z)=w
    rw [ha]
    exact levSingle (well.quiet' w) (well.level' w) a
  rw [quiet] at path
  exact congrArg (fun (P:Era G ℝ)=>P.2 h 0 Fin.elim0) path

theorem original (simple:G.Simple){c:ℕ}(late:i≤c)(above:c≤b)(hi:b≤N)
    (named:∀w S,output H.prior S N w=fixed R k κ pt N b i cells seed w S)
    (z:I)(one:∃j:Fin n,(Sof z)={j})(g:ℝ)(hg:0≤g)(small:g≤1)(p:ℕ):
    ‖(∑'a:(words H z).Roster,term (words H z) ((modes) z).center g (1:Config G side) a)-
      Complex.ofReal (∑h:Fin (e+1),if h.val≤p then
        g^h.val*(continued H κ pt b cells seed z c).2 h 0 Fin.elim0 else 0)‖≤
      g^(p+1)*(2^(e+mass k (Sof z)+2)*∑h:Fin (e+1),(words H z).fare h):=by
  have paid:=WilsonOriginalTwoFlatIRFlatWage.original H z g hg small p
  simpa only [scalar H κ pt b cells seed simple late above hi named z one] using paid

