private theorem living (valid:K ≤ N)(a:↥(Ico m (K-1))):a.val<N:=by
  have late:=(mem_Ico.mp a.property).2
  omega

def Booked (j:ℕ)(baseAge:m ≤ j)(live:j<N)(y:Fin n → Cover)
    (M:Material R N (j+1) q k (width j) (binder (R.family.side (j+1) per) y))
    (w:Fin n → ℝ)(power:Fin n → ℕ)(tol:ℝ):Prop:=
      ∃op:Mentor.Opportunity (R.alloy.B.a.clock.J (j+1)) (R.alloy.B.a.clock.J j),
      ∃file:Posted R hk (teacher) (metals) π Γ Ψ room.books baseAge op (lessons j baseAge live) room.ahead
        (port (R.family.side (j+1) per) y) (binder (R.family.side (j+1) per) y) k ask.order ask.shelf q w M tol,
        file.choose.input.hard.Paid file.choose.w (Ψ (j+1)).p.B (Ψ (j+1)).p.supportExponent
          (R.family.path.levels.clock.forcedAllowance (j+1))  ∧ 
        ∀x:Affinity.Wallet (WilsonOriginalMixedBlockRows.room (Fin n)),
          let Z:=vote R hk (teacher) (metals) π Γ Ψ room.books baseAge op (lessons j baseAge live) room.ahead
            (port (R.family.side (j+1) per) y) (binder (R.family.side (j+1) per) y) k ask.order ask.shelf q w M file x
          Z.x=x  ∧  Z.grades=k  ∧  Z.order=ask.order  ∧  Z.shelf=ask.shelf  ∧  Z.seats=op.count  ∧  HEq Z.post file.choose  ∧ 
          (8*(budgetR R j)^Z.post.op.count)*Z.post.rent ≤ tol  ∧ 
          ∀mask:(Stock.census (Fin n)).Mode,(Poly.toll Z.post.w mask)⁻¹ ≤ 
            (heat (j+1))^((((∑v,k v)+1)+5)*Fintype.card (Fin n)+∑v∈mask.val,(power v+4))

private theorem purchased (j:ℕ)(baseAge:m ≤ j)(live:j<N)(y:Fin n → Cover)
    (M:Material R N (j+1) q k (width j) (binder (R.family.side (j+1) per) y))
    (w:Fin n → ℝ)(power:Fin n → ℕ)(tol:ℝ)
    (op:Mentor.Opportunity (R.alloy.B.a.clock.J (j+1)) (R.alloy.B.a.clock.J j))
    (file:Posted R hk (teacher) (metals) π Γ Ψ room.books baseAge op (lessons j baseAge live) room.ahead
      (port (R.family.side (j+1) per) y) (binder (R.family.side (j+1) per) y) k ask.order ask.shelf q w M tol)
    (wp:∀v,0 < w v)
    (invoice:∀v,w v*max 1 (WilsonOriginalMixedBlockBudget.roots (binder (R.family.side (j+1) per) y)
      (WilsonIndependentCollarMaterialWallet.bill M w)) ≤ (heat (j+1))^(power v+4)):
    Booked room ask π Γ hk lessons Ψ j baseAge live y M w power tol:=by
  refine ⟨op,file,?_,?_⟩
  · exact file.choose_spec.2.2.2.2.2.2.1
  intro x Z
  have posted:=WilsonNeutralTwoPrintPathPostedWallet.original R hk (teacher) (metals) π Γ Ψ room.books baseAge op
    (lessons j baseAge live) room.ahead (port (R.family.side (j+1) per) y) (binder (R.family.side (j+1) per) y)
    k ask.order ask.shelf q w M file x
  obtain ⟨hx,_,Zpost,_,_,_,rent,cost⟩:=WilsonOriginalFixedTestCensusPaidVote.original R hk (teacher) (metals)
    π Γ Ψ room.books baseAge op (lessons j baseAge live) room.ahead (port (R.family.side (j+1) per) y) (binder (R.family.side (j+1) per) y)
    k ask.order ask.shelf q w M file x wp (heat (j+1))
    (WilsonStartup.Timing.hat_mono R.alloy.B.a (Gauge.slopeConstant_pos simple).le j.le_succ) (fun v=>power v+4) invoice
  exact ⟨hx,posted.2.1,posted.2.2.1,posted.2.2.2.1,posted.2.2.2.2.1,Zpost,rent,cost⟩


theorem original (receipt:Receives s R simple ask.school π Γ hk lessons Ψ) (wide:m+3 ≤ K)(valid:K ≤ N)(bank:ℝ)(one:1 ≤ bank)(cap:Fin n → ℝ)(power:Fin n → ℕ)
    (opened:(eventually_atTop.mp (WilsonReceivedChronologicalMaterialWallet.original (q:=q) R simple k bank cap one power)).choose ≤ m)
    (sales:Sales (D:=D) (V:=V) (draw:=draw) room ask π Γ hk lessons Ψ K (rate₀ bank) δ)
    (dp:0 ≤ δ)(ds:δ ≤ 1)(cells:Digits V.draws (Fin n))(κ:(v:Fin n) → Knob (D v))(pt:Fin n → Chamber)
    (seed:(v:Fin n) → Choice R k v)(ground:Fin n →  Cover)(t:Case D)
    (deep:∀s:Hot (Stock.census (Fin n)),0  <  mass k s.val.val)
    (bounded:∀a∈Ico m (K-1),∀v,‖t v‖ ≤ cap v*(heat (a+1))^(power v))(order:ℕ):
    let z:=fun j:ℕ=>homes cells ground m (j-m)
    ∃M:(a:(domain)) → Material R N (a.val+1) q k (width a.val) (binder (R.family.side (a.val+1) per) (z a.val)),
      ∀a:(domain),
      let side:=R.family.side (a.val+1) per
      let baseAge:=(mem_Ico.mp a.property).1
      let live:=living valid a
      let w:=base bank cap power (heat (a.val+1))
      Filed (K:=K) (draw:=draw) (rate:=(rate₀ bank)) (δ:=δ) cells κ pt seed side (z a.val) t (M a)  ∧ 
      Booked room ask π Γ hk lessons Ψ a.val baseAge live (z a.val) (M a) w power ((gAt (a.val+1))^order):=by
  intro z
  obtain ⟨M,issued⟩:=WilsonReceivedChronologicalMaterialLine.original (j:=m) room ask π Γ hk lessons Ψ receipt
    wide valid sales cells κ pt seed ground t deep
  refine ⟨M,?_⟩
  intro a side baseAge live w
  obtain ⟨entered,op,admitted⟩:=issued a
  have keep:=entered
  obtain ⟨test,knob,same,_,account,located,_,_⟩:=entered
  have finance:=(eventually_atTop.mp (WilsonReceivedChronologicalMaterialWallet.original (q:=q)
    R simple k bank cap one power)).choose_spec m opened a.val baseAge N per (by omega) D t δ
    (width a.val) side (z a.val) V (M a) test account located same dp ds (bounded a.val a.property)
  have young:a.val+1 ≤ N:=by omega
  have tp: 0 < (gAt (a.val+1))^order := pow_pos (ActualRunKernelPackets.regulator_pos R N per (a.val+1) young) order
  exact ⟨keep,purchased room ask π Γ hk lessons Ψ a.val baseAge live (z a.val) (M a) w power _
    op (admitted w finance.1 _ tp) finance.1 finance.2⟩

