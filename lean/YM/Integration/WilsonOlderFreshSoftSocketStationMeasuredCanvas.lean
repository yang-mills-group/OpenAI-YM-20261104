theorem mesh {Y:Type}[Fintype Y](μ:Y→ℂ)(old stopped:Y→Faces→ℂ)(fee:Y→Faces→ℝ)
    (caps:Fin 3→ℝ)(debt:Fin 3→ℕ)(target bank mesh:ℕ)
    {θ heatK r capital:ℝ}(hot:0<θ)(clear:21≤θ⁻¹)(gp:0≤heatK)(ratio:heatK≤4*θ)
    (rp:0≤r)(small:r≤1)(cp:0≤capital)(paid:(∑i,debt i)+1≤bank)
    (rich:charge caps*capital*(4:ℝ)^WilsonOlderFreshSoftSocketStationSevenPower.order target bank mesh≤θ⁻¹)
    (gross:∀y s,s.Nonempty → r^(height ages s)*‖old y s‖≤2*(θ⁻¹)^(bank+mesh*height ages s))
    (budget:∀y s,s.Nonempty →fee y s≤(∏i∈s,max 1 (caps i))*(θ⁻¹)^(∑i∈s,debt i))
    (gap:∀y s,s.Nonempty →‖old y s-stopped y s‖≤fee y s*(capital*heatK^WilsonOlderFreshSoftSocketStationSevenPower.order target bank mesh)):
    ‖WilsonOlderFreshSoftSocketStationPortfolio.reading μ ((r:ℂ)^14) old-WilsonOlderFreshSoftSocketStationPortfolio.reading μ ((r:ℂ)^14) stopped‖≤(∑y:Y,‖μ y‖)*θ^target:=by
  classical
  have one:1≤θ⁻¹:=(by norm_num : (1:ℝ)≤21).trans clear
  unfold WilsonOlderFreshSoftSocketStationPortfolio.reading
  rw [←Finset.sum_sub_distrib,Finset.sum_mul]
  apply (norm_sum_le ..).trans
  apply Finset.sum_le_sum
  intro y _
  rw [←mul_sub,←mul_sub,norm_mul,norm_mul,norm_pow,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg rp]
  apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
  apply WilsonOlderFreshSoftSocketStationSevenPower.original hot clear gp ratio rp small (mul_nonneg (positive caps).le cp)
    target bank mesh (∑i,debt i) paid rich (old y) (stopped y) (gross y)
  intro s hs
  calc
    _≤fee y s*(capital*heatK^WilsonOlderFreshSoftSocketStationSevenPower.order target bank mesh):=gap y s hs
    _≤(charge caps*(θ⁻¹)^(∑i,debt i))*(capital*heatK^WilsonOlderFreshSoftSocketStationSevenPower.order target bank mesh):=
      mul_le_mul_of_nonneg_right ((budget y s hs).trans (restricted s caps debt one)) (mul_nonneg cp (pow_nonneg gp _))
    _=_:=by ring

