theorem restricted (s:Faces)(caps:Fin 3→ℝ)(debt:Fin 3→ℕ){z:ℝ}(one:1≤z):
    (∏i∈s,max 1 (caps i))*z^(∑i∈s,debt i)≤charge caps*z^(∑i,debt i):=by
  have p:(∏i∈s,max 1 (caps i))≤charge caps:=
    Finset.prod_le_prod_of_subset_of_one_le (Finset.subset_univ s)
      (fun i _=>zero_le_one.trans (le_max_left ..)) (fun i _ _=>le_max_left ..)
  have q:(∑i∈s,debt i)≤∑i,debt i:=Finset.sum_le_sum_of_subset (Finset.subset_univ s)
  exact mul_le_mul p (pow_le_pow_right₀ one q) (pow_nonneg (zero_le_one.trans one) _) (positive caps).le

