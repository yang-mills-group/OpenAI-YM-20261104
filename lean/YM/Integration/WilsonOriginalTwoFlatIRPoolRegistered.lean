/-- A single original campus enrolls every occupied cell, every coarser receiving
room and the actual three department films before either physical regulator. -/
theorem original (simple:G.Simple)(bliss:Bliss F l z H)(slow:WilsonWindowReportingPace.Slow R.kit)
    {T h t:ℕ}{δ:ℝ}(books:(s:{s:ℝ//0<s ∧ s<δ})→Book F (l:=l) H z 6 T s.val)
    (x:∀i:Fin 3,RG17.Free C (grade i).val)(extra:∀i:Fin 3,(Spin.comparator (C).book).Field (grade i).val)
    (grant:WilsonMeasuredPublicEntrancePanelSchool.Registered F 6 T h t grade books (field F Jr Z 6 T grade extra x books)):
    ∃(M:Fin 3→ℝ)(E:Fin 3→ℕ),(∀i,1≤M i) ∧ ∀φ:Test 3,∃apron:ℕ,∀(floor:ℕ)(e:Fin 3→ℕ)(pwr target:ℕ),
    (∀i,e i+1≤2*pwr) →
    let τ:=depth ((2*pwr+∑i,E i)+1) (width T h) 6
    let tuition:=max 1 (4*∑i,M i)
    let power:=(∑i,E i)+WilsonAddressedMixedRawTrial.power T h τ 6
    ∀ᶠr in trail,∀ρ:Fin 3→{s:ℝ//0<s ∧ s<δ},(∀i,r≤(ρ i).val ∧ (ρ i).val≤outer z h r)→(∃i,(ρ i).val=r)→
    let f:=reporter F books ρ
    let K:=berth R τ f
    ∃j:ℕ,floor≤j ∧ j+2≤f ∧ ∀program:Program R ages K,
    ∃fk:f<K,∃file:Filed R ages K,
    (∀i,file.station i=(home F Jr Z (books (ρ i)) (grade i) (x i)).j) ∧ file.target=target ∧
    (∀N per w pins j,j<K → file.row N per w pins j=WilsonMovingForkPrintedFile.row program N per w pins j) ∧
    ∀N per (kn:K≤N)(requested:ℕ),
    (∀i,accuracy ages requested i≤e i) →
    ∃panel:cells R φ r (f,per)→Panel R ages N per f K fk.le kn requested power t (capital R 6 tuition),
    ∀o,Ground R N per j f apron o.val ∧ (panel o).slot=file.station ∧ (panel o).axis=file.A N per ∧ (panel o).M=M ∧
      (panel o).loc=o.val ∧ (panel o).turn=(fun _=>direct) ∧
      (∀i,(panel o).names i=(home F Jr Z (books (ρ i)) (grade i) (x i)).arm.source (N,per)) ∧
      (∀i,displayed R (ages i) ((panel o).names i) ((panel o).turn i)=
        (home F Jr Z (books (ρ i)) (grade i) (x i)).arm.source (N,per)) ∧
      (∀i k,k≤ages i → (C).ref k≤N) ∧
      (∀i,Next.Rank.Spindle.paid (C) (ages i) f N per ((panel o).names i)≤(panel o).M i*(β f)^(E i)) :=by
  obtain ⟨M,E,one,purchase⟩:=WilsonMeasuredPublicEntranceAllCutoffs.original F grant
  refine ⟨M,E,one,?_⟩
  intro φ
  obtain ⟨apron,sites⟩:=WilsonOriginalTwoFlatIRPoolSites.original F simple bliss slow books φ h
  refine ⟨apron,?_⟩
  intro floor e pwr target cap τ tuition power
  filter_upwards [sites floor,purchase e pwr target cap] with r located bought
  intro ρ span near f K
  obtain ⟨j,lower,earlier,ground⟩:=located ρ span near
  obtain ⟨_,pinned,_,school⟩:=bought ρ span near
  refine ⟨j,lower,earlier,?_⟩
  intro program
  obtain ⟨fk,file,origin,aim,rows,people⟩:=WilsonOriginalTwoFlatIRPoolPanel.on_course F Jr Z books ρ x extra pinned school program
  refine ⟨fk,file,origin,aim,rows,?_⟩
  intro N per kn requested booked
  obtain ⟨panels,entered⟩:=people N per kn φ r requested booked (fun o=>(ground N per (fk.le.trans kn) o).2)
  exact ⟨panels,fun o=>⟨(ground N per (fk.le.trans kn) o).1,entered o⟩⟩

end YM.Integration.WilsonOriginalTwoFlatIRPoolRegistered
