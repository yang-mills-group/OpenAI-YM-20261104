/-- Evaluate the entire genuinely connected next finite coefficient of the
separately placed cutoff-normalized singleton inputs.  The quiet intake is
the actual previous finite Wilson history at its measured clock. -/
theorem original (G:Gauge)(D k:ι → ℕ)(I:Finset ι)(E e r:ℕ)(he:e ≤ E):
    ∃fare:Gear G → ℝ,∃M:ℝ,0 ≤ M ∧ ∀(R:Run G),G.Simple →
    WilsonPointChildFiledTest.Filed R → WilsonPointChildWindingHierarchy.Filed R →
    WilsonPointChildWindingSchool.Paid R.kit → WilsonReceivedCloseFundedHeat.Quiet R →
    ∀cash:ℕ → Gear G → ℝ,FundedMarkedCoverRows.prices cash R.kit →
    (∀ᶠj:ℕ in atTop,∀J,fare J ≤ cash (R.family.path.levels.clock.J (j+1)) J) →
    ∀(u:ι → G.ColorIndex)(h:ι → ℕ)(depth:∀s,k s<h s)(_o:Loc G 1),
    ∀_tags:∀j n,(Flat.primary (R.family.path.levels.clock.op j 0).patch R.family.path.levels.clock.kernel n).Choices,
    ∀η:ℝ,0<η → ∀ᶠm:ℕ in atTop,∀N per,m<N →
    ∀v:∀s,Letter (R.family.labels.level (k s)),∀p:∀s,Scroll (h s),∀y:ι → Cover,
    ∀cut:∀s,ℝ →L[ℝ] Pen D ({s}:Finset ι),
    let A:=R.family.path.levels
    let O:=R.metals.O
    let n:=R.family.side m per
    let K:=placed (sources R u depth N (m+1) v p) cut y
    let a(s:ι):=(1+‖cut s‖)*((A.clock.hatBeta (m+1))^η*‖physical (p s)‖+(1+‖physical (p s)‖))
    ∀x,‖(logO A O m N K k I).1 n e r x-coilH A O m N n K k (ratioHigh A O N m) I e r x‖ ≤ 
      M*weights a I*rate A m per:=by
  obtain ⟨v₀,M,mp,D₀,run⟩:=WilsonVacuumPreResetMarkedFiledAtRun.original G D I k E e r he
  refine ⟨v₀,M,mp,?_⟩
  intro R simple booked enrolled paid quiet cash buy salary u h depth o tags η eta
  let A:=R.family.path.levels
  obtain ⟨j₀,input⟩:=eventually_atTop.mp (WilsonPointChildPlacedIncome.original R simple booked enrolled paid u depth o tags (D:=D) E eta)
  obtain ⟨j₁,old⟩:=eventually_atTop.mp (quiet E)
  filter_upwards [eventually_ge_atTop (max j₀ j₁),salary,WilsonMarkedIndependentNormalizedScale.original A simple D₀,
    WilsonVacuumPreResetFiniteHeatScale.clock A simple,
    FundedMarkedCoverRows.realm R simple cash buy 0 (fun _=>0) (fun _=>1) (fun _=>by decide) E 0 0] with m top reserve scale clock elect
  obtain ⟨Q,draws,ratio,ticks,origin,_,_,_,fund⟩:=elect
  intro N per live v p y cut L O n K a x
  have hq:Q.anchor ≤ m:=origin.le
  have budget: v₀ (Q.mint m hq).gear ≤ Q.cash Credit.leanC m:=(reserve _).trans (fund m le_rfl hq).2.2
  have hu:=input (m+1) (by omega) N per (by omega) v p y cut
  obtain ⟨_,_,_,_,wl⟩:=old (m+1) (by omega)
  have qr:WilsonVacuumPreResetFiniteHeatScale.rate A (m+1) per ≤ rate A (m+1) per:=by
    apply Real.exp_le_exp.mpr
    change -((A.S.side (m+1) per).val:ℝ)/(16*zz A (m+1)) ≤ -((A.S.side (m+1) per).val:ℝ)/(4096*zz A (m+1))
    have pos:=clock.2.1
    field_simp [show zz A (m+1)≠0 by linarith]
    have fact:(0:ℝ) ≤ (A.S.side (m+1) per).val:=by positivity
    nlinarith
  have small:rate A (m+1) per ≤ 1:=Real.exp_le_one_iff.mpr (div_nonpos_of_nonpos_of_nonneg
    (by exact neg_nonpos.mpr (Nat.cast_nonneg _)) (mul_nonneg (by norm_num) clock.2.1.le))
  have cert:=run R Q m hq draws ratio ticks budget N per live ((wl N per (by omega)).1)
    (rate A (m+1) per) qr small K hu.1 a hu.2.2.1
    (fun J _ _ i hi s _=>hu.2.2.2 J i hi s) x
  let f:=A.S.side (m+1) per
  have pos:0 ≤ gross (zz A m) f:=mul_nonneg (zero_le_one.trans clock.1) (by positivity)
  have down:(gross (zz A m) f)^D₀*rate A (m+1) per ≤ rate A m per:=by
    refine (mul_le_mul_of_nonneg_left (le_add_of_nonneg_right (Real.exp_pos _).le) (pow_nonneg pos D₀)).trans (scale per)
  have a0:0 ≤ weights a I:=Finset.prod_nonneg (fun s _=>(hu.2.2.1 s).le)
  calc
    _  ≤  M*(gross (zz A m) f)^D₀*weights a I*rate A (m+1) per:=cert
    _ = M*weights a I*((gross (zz A m) f)^D₀*rate A (m+1) per):=by ring
    _  ≤  _:=mul_le_mul_of_nonneg_left down (mul_nonneg mp a0)

end YM.Integration.WilsonPointChildPlacedPost
