theorem original [Fintype I]{p':Passport n' (Fin n)}{μ:Type}
    (high:μ → Row p' (Stock.census (Fin n)) G (Affinity.Wallet (room (Fin n))))
    (placed:p'=P)(names:μ=((l:I)×((words H) l).Roster))(ink:HEq high (mounts H))
    {w:Fin n → ℝ}{σ₀ expense:ℝ}{order seats shelf:ℕ}
    (stock:Scene.Armada high w k σ₀ expense order seats shelf)(width₀:0 < σ₀)
    (per:ℕ)(tag:(step R j per).Choices)
    (h:n'.val∣(fine R j per).val)(x:Affinity.Wallet (room (Fin n)))
    {start e:ℕ}{quiet:ℕ → SeriesA G}{π:ℕ → Layout G}{Γ:ℕ → Pace.Coin}
    (legal:Legal (Step.tape (e+2)) (π (j+1)))
    (course:Read R N start e quiet π Γ)(live:start ≤ j){τ cash:ℝ}
    (funded:Issued R N (j+1) e (quiet (j+1)) τ cash)
    (r:ℕ)(retained:r ≤ q)(grade:r ≤ e+2)
    (target:(Stock.census (Fin n)).Mode):
    let U:Adjacent.Display (Stationary.Link G (coarse R j per)):=fun l b=>
      let K₀:=model R N j per (show j<N by omega)
      let raw:=Bulk.Fk K₀ (repeatF (WilsonVacuumPreResetStationaryChange.step R j per)) tag (copyColor h high k (fun a=>(high a).paint x) (π (j+1)) (Step.tape (e+2)))
        (Stationary.arm G _ 1 b) r
      (Order.observe (Stock.census (Fin n)) r (Order.logMarked raw) l).part target
    Adjacent.Charge r (fun l=>((WilsonReceivedDepositedOrbitalGraphDegree.width B k+l:ℕ):ℤ)) U:=by
  intro U l hl
  have highDate:j<N:=by omega
  have intake (b:Stationary.Link G (coarse R j per)):
      U l b=∑g:(u:Finset I)×(u→Fin (Pages n' (fine R j per))),amountAt B R j per x target g*
        read (coordinates G (coarse R j per)) (filing (k:=k) B old q c y t R N j per (repeatF (WilsonVacuumPreResetStationaryChange.step R j per)) h 1 g) l b:=by
    have folded:=WilsonReceivedDepositedOrbitalFiled.original R Y lo enrolled N X positive limit width B c inside pin deep
      y t closed tickets old well hs base cover bound high placed names ink stock width₀ per (repeatF (WilsonVacuumPreResetStationaryChange.step R j per)) tag h x legal course live funded b r retained grade
    exact (congrArg (fun Z=>(Order.observe (Stock.census (Fin n)) r Z l).part target) folded.2).trans
      (WilsonReceivedDepositedOrbitalPlacements.charged B old q c y t R N j per highDate (repeatF (WilsonVacuumPreResetStationaryChange.step R j per)) tag h well hs base cover pin
        x (Stationary.arm G (coarse R j per) 1 b) Y.hG r l hl target)
  rw [funext intake]
  apply Valence.Level.total
  intro g _
  exact (WilsonReceivedDepositedOrbitalGraphDegree.original B old q c y t R N j per highDate h well hs base cover pin
    Y.hG g.1 g.2 l).factor _

