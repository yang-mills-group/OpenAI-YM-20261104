include early in
theorem original {tol:ℝ}(ep:0<θ)(tp:0<tol)
    (authorized:WilsonOriginalReflectedFirstTerms.At R simple d P (2*A) tol θ tp ep (first+1) j)
    (activated:WilsonOriginalCensusCanonicalAppointedClock.opening R simple seller fund history (Burn.horizon (ask).vac) ≤ m)
    (ranked:WilsonAddressedPublicFirstOrigin.ceiling R d ≤ (capital).order)
    {r:ℝ}(rp:0<r)(small:(mult₀)*r ≤ R.family.S.a 0)
    (before:first+1 ≤ capture₀ r)(between:capture₀ r ≤ f)(narrow:8*R.family.S.a f<R.family.S.a (capture₀ r))
    (ensemble:(WilsonReceivedChronologicalFixedRoseVariation.cells R φ r (f,per))→
      WilsonMeasuredPublicEntrancePanel.Panel R d N per f (j+1+1) fine live requested sourcePole names B)
    (whereAt:∀y,(ensemble y).loc=y.val)(homesAt:∀y,(ensemble y).slot=file.station)
    (axesAt:∀y,(ensemble y).axis=file.A N per)
    (priorAt:∀_y:(WilsonReceivedChronologicalFixedRoseVariation.cells R φ r (f,per)),
      ∀s:Finset (Fin 2),Selection R d s→∀i:ℕ,Config G (R.family.side i per)→Marker.Poly (Stock.census (Fin 2)))
    (smallLo:WilsonReceivedChronologicalFixedCellFee.factor R φ*r ≤ R.family.S.a 0)
    (atCapture:first+1 < WilsonReceivedChronologicalFixedCellFee.capture R φ r)
    (withinLo:WilsonReceivedChronologicalFixedCellFee.capture R φ r ≤ f)
    (narrowLo:8*R.family.S.a f<R.family.S.a (WilsonReceivedChronologicalFixedCellFee.capture R φ r))
    (front : (t:Multi.Hot (marks)) → t.val.val)
    {I₀:Type}[Fintype I₀]{courseDepth pieces₀ k₀:ℕ}{pole:Bool → ℕ}{span:I₀ → ℕ}{lag:I₀ → Bool → ℕ}
    (faculty:WilsonIndependentCollarDatedTeachers.At schedule R simple V lens d (Burn.horizon (ask).vac)
      courseDepth allowance tube pieces₀ k₀ pole span lag j)(venue:V.anchor ≤ j+1)
    (go:(publication).first ≤ j+1)(board:(publication).period (j+1) (extent₀) ≤ per)
    (floorOld:WilsonSingleHardRadius.first R simple ≤ m)(fj:first+1 ≤ j)
    (geo:R.family.S.a (first+1)/R.family.S.a (j+1+1) ≤ (R.family.path.levels.clock.hatBeta (first+1))^(2*A))
    (support:∀i,(R.family.path.levels.budget i).supportExponent=100)
    {df:ℕ}{frame:Frame G df}(section_:SectionData frame)(group:Hol G)
    {goal:ℕ}(promise:promised=goal+2*sourcePole*3)
    {oldPrice:Credit}{Z₀:ℕ→ SeriesA G}(quiet:WilsonOriginalCensusFiledAttendance.QuietAt day oldPrice Z₀)
    (basalTeacher:WilsonIndependentCollarDatedTeachers.At schedule R simple V lens d (Burn.horizon (ask).vac)
      courseDepth allowance tube pieces₀ k₀ pole span lag first)
    (basalAnchor:V.anchor≤first+1)
    (sparse:WilsonOriginalCensusSparseRosterOpening.first R simple tube d d (WilsonReceivedChronologicalFixedReserve.charges zeroFee)
      (capital).order (capital).order (capital).target (capital).precision (capital).enough≤first+1)
    (period:WilsonReceivedChronologicalFixedPorts.Period (R:=R) (per:=per) (V:=V) (grades:=d)
      zeroFee P (fun i=>contact (lens i)) pt (j+1+1) first caps)
    (forests:∀i:ℕ,∀u:Covers R.family.path.levels.S (i+1) (coarse R (i+1) per),Forest (step R (i+1) u.val).ratio)
    (chosen:∀i:ℕ,∀u:Covers R.family.path.levels.S (i+1) (coarse R (i+1) per),(step R (i+1) u.val).Choices)
    (current:WilsonOriginalOneArmCurrentClock.first R simple d zeroFee P (2*A) tol θ tp ep (by decide:0<2)≤first)
    (source:∀y,Reading R d (ensemble y) ((old.trans (Nat.le_succ first)).trans (atCapture.le.trans withinLo)))
    (one:∀y i,1≤(ensemble y).M i)(E:Fin 2→ℕ)(refs:∀i k,k≤d i → R.family.ref k≤N)
    (fare:∀y i,Next.Rank.Spindle.paid R.family (d i) f N per ((ensemble y).names i)≤(ensemble y).M i*R.family.path.levels.clock.hatBeta f^(E i))
    (order:ℕ)(room:∀s:Finset (Fin 2),order+∑i∈s,E i≤requested)
    (young:captureHere r<j+1+1-1)(big:2≤R.alloy.B.a.clock.hatBeta (captureHere r))
    (licensed:calendar (captureHere r))
    (clocked:(eventually_atTop.mp (WilsonOriginalTwoFlatIRRows.nextClock R simple)).choose≤captureHere r)
    {p depth E₀:ℕ}(quote:Quote R N per m (first+1) (captureHere r) p depth
       ((old.trans (Nat.le_succ first)).trans atCapture.le) atCapture.le)
    {C:ℝ}(cp:1≤C)(allowed:allowance≤1)(rent:0≤rate)
    (out:rate≤C*(3*(gAt (captureHere r))⁻¹)^E₀)(cap:∀a,caps a≤C*(3*(gAt (captureHere r))⁻¹)^E₀)
    {α:ℝ}(strip:(R.family.path.rep N per (captureHere r)).p.supportExponent≤α)
    (ou:Trace.Physical.GermGraph.Opened R.family 0 m per)(ov:Trace.Physical.GermGraph.Opened R.family 0 (first+1) per)
    (reach:∀s:Finset (Fin 2),4*(p+(WilsonOriginalTwoFlatIRHalo.power s.card ((∑a,d a)+1+2+(2+2*2*E₀))+0+2))≤depth)
    (terminalQ goalEnd:ℕ)(cold:gAt (first+1)≤1)(coldK:gAt (j+1+1)≤1)
    {C₁:ℝ}{E₁:ℕ}(cp₁:1≤C₁)(out₁:rate≤C₁*(3*(gAt (first+1))⁻¹)^E₁)
    (inputs₁:∀a,‖present lens a‖≤C₁*(3*(gAt (first+1))⁻¹)^E₁)
    (kept:goalEnd+debt 2 E₁ (Fintype.card (Multi.Hot (Stock.census (Fin 2))))≤terminalQ+1)
    (enough:terminalQ≤(capital).order):
    let price:=WilsonReceivedChronologicalFixedRoseOriginalAccount.budget d zeroFee P A sourcePole
      promised order p E₀ goalEnd E₁ B C α θ θ C₁
    ∀(y:WilsonReceivedChronologicalFixedRoseVariation.cells R φ r (f,per))(s:Finset (Fin 2)),
    let actual:=entry (simple:=simple) (φ:=φ) (R:=R) (N:=N) (per:=per) (d:=d) (P:=P)
      (school:=school) (day:=day) (old:=old) (live:=live) (lens:=lens) (pt:=pt) (toll:=toll)
      (classroom:=classroom) (fine:=fine) (panel:=ensemble y) (file:=file) (mask:=face s) (paid:=paid)
      (adult:=adult) (prior:=priorAt y s)
      r atCapture withinLo order p E₀ terminalQ goalEnd E₁ C α C₁
    let X:=physical R d (ensemble y).names (ensemble y).turn y.val (face s) (N:=N)
    let F:=fixed R live ((old.trans (Nat.le_succ first)).trans ((atCapture.le.trans withinLo).trans fine)) X
    let registered:=written R d price (ensemble y) file (first+1) (captureHere r) s F actual.independent actual.basal actual.firstStep
    actual.incumbent=F ∧ registered.Paid ∧
      ‖actual.basal‖≤WilsonReceivedChronologicalFixedRoseFittedDebit.low R d price (j+1+1) N per (first+1) s ∧
      ‖actual.firstStep‖≤WilsonReceivedChronologicalFixedRoseFittedDebit.high R d price (j+1+1) N per (first+1) s:=by
  classical
  intro price y s actual X F registered
  have occupied:WilsonCenteredCompactBooking.mass R φ r (f,per) (ensemble y).loc≠0:=by
    rw [whereAt y]
    exact (Finset.mem_filter.mp y.property).2
  have issued:=WilsonOriginalReflectedPhysicalCell.original
    (R:=R) (simple:=simple) (d:=d) (P:=P) (school:=school) (day:=day) (old:=old) (early:=early) (live:=live)
    (lens:=lens) (pt:=pt) (toll:=toll) (classroom:=classroom) (fine:=fine) (panel:=ensemble y) (file:=file)
    (station:=homesAt y) (axes:=axesAt y) (mask:=face s) (paid:=paid) (adult:=adult) (prior:=priorAt y s)
    (seller:=seller) (fund:=fund) (history:=history) (tube:=tube) ep tp authorized activated ranked
    rp small before between narrow occupied smallLo atCapture withinLo narrowLo front faculty venue go board floorOld fj geo
    support section_ group promise quiet basalTeacher basalAnchor sparse period forests chosen current
    (source y) (one y) E refs (fare y) order (room s) young big licensed clocked quote cp allowed rent out cap strip ou ov
    (reach s) terminalQ goalEnd cold coldK cp₁ out₁ inputs₁ kept enough
  have id:actual.incumbent=F:=by
    change reading R (N:=N) (credit R.family N per 0 (physical R d (ensemble y).names (ensemble y).turn (ensemble y).loc (face s)) (j+1+1) live) m _=_
    rw [whereAt y]
    rfl
  refine ⟨id,?_,issued.2.2⟩
  change (written R d price (ensemble y) file (first+1) (captureHere r) s F actual.independent actual.basal actual.firstStep).Paid
  rw [←id]
  exact issued.2.1

