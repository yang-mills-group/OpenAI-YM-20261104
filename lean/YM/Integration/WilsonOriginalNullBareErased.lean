    (time:WilsonOriginalNullBareFunding.first R d simple slow ready ≤ (b+n)+1)
    (home:Opened R.family d ((b+n)+1) per)
    (lower:m ≤ b)(report:axes→ℂ)(wage:ℝ)(q:ℕ){ε total:ℝ}(ep:0 ≤ ε)
    (loc:Stationary.Loc G 1){cashPlan:ℕ→ℕ}(formal:WilsonWindowFormalPurchase.Canonical cashPlan R.kit)
    (point:WilsonNeutralPointForecast.Filed R.kit)(weakly:WilsonNeutralPointWeakForecast.Filed R.kit)
    (origin tol:ℝ)(mass:0≤origin)(target:0<tol)(fees:∀l,‖report l‖≤origin)
    (front:d ≤ R.family.path.levels.clock.J (b+1))
    (start:WilsonOriginalNullBareReady.first R L a depth simple loc formal point weakly Q (height+7) ≤ b)
    (fine:WilsonOriginalNullBareReady.last R L a depth simple loc formal point weakly Q (height+7) start front
      (2*|unitCost| *(1+‖f‖)) origin tol (by positivity) mass target ≤ b+n)
    (grid:∀j≤n+1,sites (b+j)=(R.family.S.toDepth (Nat.le_add_right b j) per).embed (sites b))
    (route:∀j<n+1,sites (b+j)=(R.family.path.levels.clock.op (b+j) per).ratio.parent (sites (b+j+1)))
    (houses:∀j≤n+1,Opened R.family d (b+j) per)
    (gates:∀j<n+1,WilsonOriginalNullPlacedParallel.Joined R.family d (b+(n+1)) per (b+j) Ψ (sites (b+j+1)) ε) :
    let g:=fun j=>Coat.gStep (R.family.path.rep (b+(n+1)) per j).beta
    let book:=WilsonOlderFreshLocatedBook.fixed R σ T sites (orbit R digit (m+1) f) A test (fun j=>Coat.gStep (Ψ j).beta)
    let topTrial:=take R Q (lift R L a depth digit (b+(n+1)) b g (fun l=>PowerSeries.C (report l)) ((b+(n+1))-b))
    let F:=fun j=>earnedValue R (p:=per) L a depth digit (b+(n+1)) (b+(n+1)) Q g topTrial Ψ book (b+j)
    ∀ (_:WilsonOlderFreshLocatedPayment.Full R d L a depth digit (b+(n+1)) per b Q q Ψ sites book wage)
      (bill:ℕ→ℝ)(H:Receipt R d (b+(n+1)) per b (n+1) Ψ sites F bill ε),
      (∑j:Fin (n+1),(H.u j+H.e j)) ≤ total →
    ∀ (h:store R.family d per b)(β:ℝ),h.Format s₀ Y (Ψ b) → h.remBound s₀ (Ψ b) κ₀ β →
      h.density s₀ Sec (Ψ b)=F 0 →
    let anchor:=houses 0 (Nat.zero_le _)
    let x:=(fitting (C:=R.family) d (b+(n+1)) per b R.makes anchor (Nat.le_add_right b (n+1))).symm (projection Fr Y (Ψ b).p.threshold s₀ h)
    ∃ (z v:store R.family d per b)(u e:ℝ),
      z.Format s₀ Y (Ψ b) ∧ z.remBound s₀ (Ψ b) κ₀ u ∧ projection Fr Y (Ψ b).p.threshold s₀ z=0 ∧
      v.Format s₀ Y P₀ ∧ v.remBound s₀ P₀ κ₀ e ∧ projection Fr Y (P₀).p.threshold s₀ v=0 ∧
      u+e ≤ total+tol ∧
      placed R d (b+(n+1)) per b sites 0 x=F 0+z.density s₀ Sec (Ψ b)+v.density s₀ Sec P₀ :=by
  classical
  intro g book topTrial F full bill H charged q₀ s₁ qf qp qfield anchor x
  let amps:=income R L a depth digit (b+(n+1)) (b+(n+1)) Q g topTrial (b+(n+1))
  let price:=2*|unitCost| *(1+R.alloy.B.a.clock.hatBeta ((b+(n+1))+1))^(height+7)*(1+‖f‖)
  let leaf:=(history.1.walk (b+(n+1)) (lower.trans (Nat.le_add_right b (n+1))) le_rfl)
  have geo:=((eventually_atTop.1 (WilsonOriginalNullBareCourse.original R D Q₀ scroll books ahead house school simple one deep)).choose_spec m early)
    (b+(n+1)) (lower.trans (Nat.le_add_right b (n+1))) per (Ψ (b+(n+1))) leaf.truep.point leaf.beta
  obtain ⟨z,v,u,e,zf,zp,zn,vf,vp,vn,stock,field⟩:=
    WilsonOriginalNullBareReleased.original R hk D Q₀ π Γ Ψ history scroll books chamber hi warm top school op lesson cal ahead hospital
      sites A L a depth f digit simple nonbare cap pos bounded pass late T sheets seats shape phase enrolled order cut width test
      slow ready geo fixed time home lower report wage q ep grid route houses gates full bill H charged q₀ s₁ qf qp qfield
  have tail:=WilsonOriginalNullBareReady.granted R L a depth simple loc formal point weakly Q (height+7) start front
    (2*|unitCost| *(1+‖f‖)) origin tol (by positivity) mass target fine digit per report fees
  dsimp only at tail
  have priceExact:price=(2*|unitCost| *(1+‖f‖))*(1+R.alloy.B.a.clock.hatBeta ((b+(n+1))+1))^(height+7):=by
    dsimp only [price];ring
  have dividend:gain R.family b (b+(n+1))*((∑l:axes,‖∑k:Fin (Q+1),amps k l‖)*price) ≤ tol:=by
    rw [priceExact]
    exact tail
  exact ⟨z,v,u,e,zf,zp,zn,vf,vp,vn,stock.trans (add_le_add_right dividend total),field⟩

