def upper:Config G (R.family.side (j+1+1) per)→ℂ:=fun U=>
  ∏i:mask.val,uncut R (d i) N per (j+1+1) (placed R fine site i) (votes i) U

theorem atCut (q:Selection R d mask.val)(U:Config G (R.family.side (j+1+1) per)):
    ((row₀ q) (j+1+1) U).part mask=(((R.family.path.rep N per (j+1+1)).eval U):ℂ)*
      word R d (fun i=>contact (lens i)) pt (gAt (j+1+1)) (placed R fine site) mask.val q U:=
  WilsonReceivedChronologicalFixedSocketLife.atCut (G:=G) (n:=n) (N:=N) (grades:=d) (dims:=lens) (R:=R) (per:=per) (V:=V) (draw:=draw)
    (rate:=rate) (allowance:=allowance) (power:=zeroFee) (P:=P) (house:=school) (day:=day)
    (κ:=fun i=>contact (lens i)) (pt:=pt) (top:=j+1+1) (first:=first) (valid:=live)
    (toll:=toll) (old:=old) (test:=present lens) (classroom:=classroom) (fine:=fine) (z:=site)
    (s:=mask) (q:=q) (paid:=paid) (hd:=adult) (prior:=prior q) (σ:=scale) U

theorem integrable (q : Selection R d mask.val) (i : ℕ) (past : first + 1 ≤ i) (live₀ : i ≤ j + 1 + 1) :
    Integrable ((row₀ q) i) (Wilson.prior G _):=by
  rcases lt_or_eq_of_le live₀ with below|rfl
  · cases i with
    | zero => omega
    | succ a =>
      let age:↥(Finset.Ico first (j+1+1-1)):=⟨a,Finset.mem_Ico.mpr ⟨by omega,by omega⟩⟩
      obtain ⟨row,_⟩:=WilsonReceivedChronologicalFixedSocketLife.atDate (G:=G) (n:=n) (N:=N) (grades:=d) (dims:=lens) (R:=R) (per:=per) (V:=V) (draw:=draw)
        (rate:=rate) (allowance:=allowance) (power:=zeroFee) (P:=P) (house:=school) (day:=day)
        (κ:=fun i=>contact (lens i)) (pt:=pt) (top:=j+1+1) (first:=first) (valid:=live)
        (toll:=toll) (old:=old)
        (classroom:=classroom) (fine:=fine) (z:=site) (s:=mask) (q:=q) (paid:=paid)
        (test:=present lens) (hd:=adult) (prior:=prior q) (σ:=scale) age
      exact WilsonOriginalRegisteredWhole.original (entry:=row) ..
  · unfold WilsonReceivedChronologicalFixedSocketLife.line
    rw [WilsonReceivedChronologicalFixedProgram.cutoff,Function.update_self]
    exact WilsonReceivedChronologicalFixedRoseTop.original R d live mask q adult (placed R fine site) scale
      (gAt (j+1+1)) (fun a=>contact (lens a)) pt

theorem arrival {u:ℕ}(uk:u≤j+1+1):
    actualTransport R.family (N:=N) (upper R d (N:=N) fine site votes mask) uk 1=
      ∑q:Selection R d mask.val,(wt q)*reading R (N:=N)
        (fun U=>((row₀ q) (j+1+1) U).part mask) u uk:=by
  change actualTransport R.family (N:=N) (fun U=>∏i:mask.val,uncut R (d i) N per (j+1+1) (placed R fine site i) (votes i) U) uk 1 = _
  rw [WilsonReceivedCanonicalVersePosterior.original R d (fun i=>contact (lens i)) pt N per (j+1+1)
    live votes (placed R fine site) mask.val u uk 1]
  apply Finset.sum_congr rfl
  intro q _
  rw [show (fun U=>((row₀ q) (j+1+1) U).part mask)=
    (fun U=>(((R.family.path.rep N per (j+1+1)).eval U):ℂ)*word R d
      (fun i=>contact (lens i)) pt (gAt (j+1+1)) (placed R fine site) mask.val q U) from
    funext fun U=>atCut (R:=R) (simple:=simple) (d:=d) (school:=school) (day:=day) (old:=old) (live:=live)
      (lens:=lens) (pt:=pt) (toll:=toll) (classroom:=classroom) (site:=site) (mask:=mask) (prior:=prior) (fine:=fine)
      (paid:=paid) (adult:=adult) (q:=q) (U:=U),WilsonThermometerUnitFilingPosterior.weighted]

