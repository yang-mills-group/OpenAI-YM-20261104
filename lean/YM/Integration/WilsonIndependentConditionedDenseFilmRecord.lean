def word (W:Initialize G)(fit:∀i,d i<lens i)(c qh:ℕ):ℂ:=by
  classical
  exact if yes:Nonempty mask.val then
      letI:=yes
      ∑b:(i:mask.val)→(R.family.labels.level (d i)).Index,payment R d N per K₀ votes mask.val b*
        (((touch (present lens) mask.val) (deposit lens (fun i=>contact (lens i)) pt mask.val)*
          flat (column R W d fit N K₀ c (first+1) (cells) (pins₀ c) mask.val b) qh (gv):ℝ):ℂ)
    else stoppedAt c qh

include simple live in
theorem original (W:Initialize G)(fit:∀i,d i<lens i)(c qh:ℕ)(vc:first+1≤c)(ck:c≤K₀):
    (stoppedAt c qh)=word (R:=R) (d:=d) (P:=P) (N:=N) (j:=j) (per:=per) (first:=first)
      (V:=V) (draw:=draw) (lens:=lens) (pt:=pt) (fine:=fine) (site:=site) (votes:=votes) (mask:=mask) W fit c qh:=by
  classical
  by_cases yes:Nonempty mask.val
  · letI:=yes
    rw [word,dif_pos yes]
    exact WilsonIndependentConditionedFolioScalar.original R W lens d fit (fun i=>contact (lens i)) pt N per
      K₀ c (first+1) (cells) (pins₀ c) mask.val (touch (present lens) mask.val) votes simple R.alloy.B.ratio vc ck live qh (gv)
  · rw [word,dif_neg yes]

