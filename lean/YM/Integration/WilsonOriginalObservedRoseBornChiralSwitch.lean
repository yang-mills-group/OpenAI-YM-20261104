def amountDue (gain:ℕ)(V:Realm G (e+1) J)(X:Courts (H:=H) (v:=v))(φ:Wilt Q)(fees:Fin 2→ℝ)
    (y space δ:ℝ)(m:ℕ)(primary basal unary:Fin 2→Credit)(terminal:(Fin 2→Bool)→Credit):ℝ:=
  let S:=fun i=>unaryBase (X i) (unary i) (φ i) (fees i) y
  let F:=fun i=>fittedFee (X i) (φ i) (fees i) y
  portfolio gain V X φ fees y space primary basal terminal m+2*(S 0*(δ*S 1+F 1)+F 0*S 1)

variable {h H₀:ℕ}(R:Run G)(W:Initialize G)(d D:Fin 2→ℕ)(fit:∀i,d i<D i)
local notation "L" => R.family.path.levels
local notation "O" => R.metals.O

theorem original (M:Master (hol G))(simple:G.Simple)(fields:ℕ→Gear G→ℝ)
    (funded:FundedMarkedCoverRows.prices fields R.kit)(pub:WilsonMaxwellThermometerSurveyIncome.prices W R.kit)
    (big:h<H₀)(rails:Rails h k u₀ e)(roomCap:capP (deck (G:=G) d D fit) ≤ k)
    (cap:capP (port R W d D fit false)=10)(stock:∀i,Rails (d i) k u₀ e)
    (height seats gain:ℕ)(surplus:2 ≤ gain)(stage:2*k ≤ 10+gain)(room:10+gain ≤ seats)
    (width:10+gain ≤ u₀)(heat:1 ≤ e):
    let P:=port R W d D fit false
    ∃A:(i:Fin 2)→Bool→Alma (R.family.labels.level (d i))→ℝ,∃primary basal unary:Fin 2→Credit,
    ∃terminal:(Fin 2→Bool)→Credit,(∀i side a,0≤A i side a) ∧
    ∀ᶠ j:ℕ in atTop,∀(V:Realm G (e+1) J),V.draws=L → V.paid=O → Elected M V height seats →
    ∀m K N,j ≤ m → V.anchor ≤ m → m ≤ K → ∀X:Courts (H:=hol G) (Q:=P) (v:=stock),stamp V X m K N →
    ∃Y:(i:Fin 2)→Bool→CutsP (hol G) (P i).ans (P i).path (stock i) J J J J,
      (∀i side,let c:=input R W d D fit side i m K (home (P i) (X i))
               (Y i side).pt=Shrine (plate ((port R W d D fit side i).ans) (fit i)) c ∧
               (Y i side).fuel=charge e c (A i side) ∧ home (P i) (Y i side)=home (P i) (X i)) ∧
      (∀s:Fin 2→Bool,stamp V (fun i=>Y i (s i)) m K K) ∧
      ∀(φ:Wilt P)(B:Fin 2→ℝ)(y space:ℝ),Bough P φ y space B → ∀(o:CellR)(ω:Fin 0→YForest G)
      (s t:Fin 2→Bool),let δ:=(paceT V.draws.S m K)^(1/4:ℝ)
                        let pair:=fun (a:Fin 2→Bool) i=>Y i (a i)
                        ‖first V (pair s) φ m K K y o ω-first V (pair t) φ m K K y o ω‖ ≤
                          δ*(amountDue gain V (pair s) φ B y space δ m primary basal unary terminal+
                             amountDue gain V (pair t) φ B y space δ m primary basal unary terminal):=by
  intro P
  obtain ⟨A,nn,issued⟩:=WilsonOriginalObservedRoseBornChiralFreshFolio.original
    R W d D fit simple fields funded pub big rails roomCap stock
  obtain ⟨primary,basal,unary,terminal,bound⟩:=WilsonOriginalObservedRoseBornChiralFirstRate.original
    M P cap stock height seats gain surplus stage room width heat
  refine ⟨A,primary,basal,unary,terminal,nn,?_⟩
  filter_upwards [issued] with j sell
  intro V draws chart bought m K N age floor reach X old
  obtain ⟨Y,filed,dates⟩:=sell V draws chart m K N age X old
  refine ⟨Y,(fun i s=>⟨(filed i s).2.2.1,(filed i s).2.2.2.2⟩),dates,?_⟩
  intro φ B y space profile o ω s t δ pair
  have cost (r:Fin 2→Bool):
      ‖first V (pair r) φ m K K y o ω-projected V (pair r) φ m K K y o ω‖ ≤
        δ*amountDue gain V (pair r) φ B y space δ m primary basal unary terminal:=
    bound V bought (pair r) m K K (dates r) floor reach le_rfl
      (fun i=>(filed i (r i)).2.2.2.1) φ B y space profile o ω
  have pivot:=WilsonOriginalObservedRoseBornChiralPivot.original V (pair s) (pair t) φ m K K
    (dates s) (dates t) (fun i=>(filed i (s i)).1.trans (filed i (t i)).1.symm)
    (fun i=>(filed i (s i)).2.2.2.2.2.trans (filed i (t i)).2.2.2.2.2.symm) y o ω
  rw [mul_add]
  apply (show ‖first V (pair s) φ m K K y o ω-first V (pair t) φ m K K y o ω‖ ≤ _ from by
    simpa only [dist_eq_norm] using dist_triangle (first V (pair s) φ m K K y o ω) (projected V (pair s) φ m K K y o ω)
          (first V (pair t) φ m K K y o ω)).trans
  refine add_le_add (cost s) ?_
  rw [pivot,norm_sub_rev]
  exact cost t

end YM.Integration.WilsonOriginalObservedRoseBornChiralSwitch
