theorem original (M:Master H)(Q:Fin 2→SealR G)(cap:capP Q=10)(v:∀i,Rails (Q i).h k u₀ e)
    (height seats gain:ℕ)(surplus:2 ≤ gain)(stage:2*k ≤ 10+gain)(room:10+gain ≤ seats)
    (width:10+gain ≤ u₀):
    ∃primary basal:Fin 2→Credit,∃terminal:(Fin 2→Bool)→Credit,
    ∀(V:Realm G (e+1) J),Elected M V height seats → ∀(X:Courts (H:=H) (v:=v))
    (m K N:ℕ),stamp V X m K N → V.anchor ≤ m → m ≤ K → K ≤ N → (∀i,On (Q i).h (X i).pt) →
    ∀(φ:Wilt Q)(fees:Fin 2→ℝ)(y space:ℝ),Bough Q φ y space fees → ∀(o:CellR)(q:ℕ),q ≤ e →
    ∀ω:Fin 0→YForest G,
    ‖atGrade (stopped V.draws V.paid Q φ (fun i=>home (Q i) (X i)) m K N m y o) q ω‖ ≤
      WilsonOriginalObservedRoseBornChiralRetained.charge gain V X φ fees y space primary basal terminal m (fun _=>false):=by
  obtain ⟨primary,basal,terminal,bound⟩:=WilsonOriginalObservedRoseBornChiralRetained.original
    M Q cap v height seats gain surplus stage room width
  refine ⟨primary,basal,terminal,?_⟩
  intro V sale X m K N filed floor past live sound φ fees y space house o q hq ω
  have paid:=bound V sale X m K N filed floor past live sound φ fees y space house (fun _=>false) o q hq ω
  rw [zero,Real.rpow_zero,one_mul,single V X φ m K N filed past y o] at paid
  exact paid

