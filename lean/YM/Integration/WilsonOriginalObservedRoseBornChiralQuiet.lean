theorem single (V:Realm G (e+1) J)(X:Courts (H:=H) (v:=v))(φ:Wilt Q)(m K N:ℕ)
    (filed:stamp V X m K N)(before:m ≤ K)(y:ℝ)(o:CellR):
    sector V (fun _=>false) X (fun i=>dose (X i) 1) φ y o m K N=
      stopped V.draws V.paid Q φ (fun i=>home (Q i) (X i)) m K N m y o:=by
  rw [WilsonOriginalObservedRoseBornChiralRank.at_upper V X m K N filed]
  have born:=WilsonIndependentMatchedAccruedRestart.first V.draws V.paid X φ m K N m y o
    (fun i=>(filed i).1) (fun i=>(filed i).2.1) (fun i=>(filed i).2.2.1) (fun i=>(filed i).2.2.2.1)
    (fun i=>(filed i).2.2.2.2)
  unfold WilsonIndependentMatchedAccruedRestart.fitted at born
  rw [←cruisesMore _ _ _ le_rfl before] at born
  have same (i:Fin 2):word ((X i).pt-(X i).springP (X i).i) (φ i) (paceT V.draws.S m K) y o (Q i).h=
      receiving (X i) 1 (φ i) y o (X i).i:=by
    have pitch:paceT (X i).ax.S (X i).m ((X i).m+(X i).i)=paceT V.draws.S m K:=by
      change paceT (X i).ax.S (X i).m (X i).ceilC=_
      rw [(filed i).1,(filed i).2.2.1,(filed i).2.2.2.1]
    rw [WilsonIndependentMatchedFittedSeat.inlet,one_smul,pitch,(X i).carve1]
    congr 1
    abel
  rw [funext same] at born
  exact born

