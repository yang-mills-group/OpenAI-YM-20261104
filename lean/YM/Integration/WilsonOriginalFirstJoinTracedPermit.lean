def traced_connections
    (out:Hard (Affinity.Wallet actors) R'.p R'.activities.forced R'.activities.K
      (S.ratio.parent ∘ P.origin) R) : Prop :=
  letI := Scene.crewC X S.ratio S' hS
  out=Kiosk.Second.canopy firstRead (Sp) uV.second ∧ ∀(d:ℕ)(test:R.Mode→Prop)(v:V),
    (∀ t:R.Mode,test t→v∈t.val) →
    Lyric.radiusCost W L (U.p.supportExponent-U.p.supportExponent/8) →
    (∀ t:R.Mode,test t→∃a∈t.val,∃b∈t.val,
      d*(4*U.p.B+2)+2*U.p.B ≤ separation (P.origin a) (P.origin b)) →
    let erased:=WilsonOriginalSeparatedHardSuccessor.without H uV Q (Patrol.picture X T) w
      Kp hw hq hV.quota z y (Sp) test
    ∃ amplified : Hard (Affinity.Wallet actors) R'.p R'.activities.forced R'.activities.K
        (S.ratio.parent ∘ P.origin) R,
      erased.Paid (Stoop.radius w k') R'.p.B R'.p.supportExponent uB ∧
      amplified.Paid (Stoop.radius w k') R'.p.B R'.p.supportExponent uB ∧
      WilsonOriginalForcedMarkerMerger.Related v
        (↑((Real.exp ((U.p.supportExponent/8)*d))⁻¹):ℂ) erased out amplified

include hl in
theorem traced_sources :
    letI:=Scene.crewC X S.ratio S' hS
    traced_connections (actors:=actors) (X:=X) (T:=T) (w:=w) (tV:=tV) (hq:=hq) (y:=y)
      (H:=H) (M0:=M0) (hβ:=hβ) (E:=E) (Q:=Q) (D0:=D0) (S':=S') (hS:=hS) (Yv:=Yv)
      (k':=k') (hV:=hV) (hP:=hP) (hK:=hK) (Y0:=Y0) (uV:=uV) (traced).hard := by
  letI:=Scene.crewC X S.ratio S' hS
  refine ⟨rfl,?_⟩
  intro d test v rests tariff apart
  have he:=Permit.energy X T w tV hq y H M0 hβ E Q D0 S' hS Yv k' hV hP hK Y0 uV
  have paid:=Curtain.paidShift X T w hw hq Kp y H Hp D0 M0 hβ Q ℓ π z ϕ Y0.budget S' Yv X0
    hK.edges Q* hP.location hS E.afterwards hV.quota hl he.1 he.2.1 he.2.2.1
    k' hP.sharpens (fun i=>hK.covers _)
  obtain ⟨f,hF₁,hH⟩:=paid.earned
  have funded : (Sp).Budget (Stoop.radius w k') R'.p.B (R'.p.supportExponent+1) tW :=
    ⟨f,hF₁,fun anchor=>budget_loosen (hH anchor) he.2.2.2⟩
  exact WilsonOriginalRaisedHardPost.at_radius H uV Q (Patrol.picture X T) w Kp hw hq hV.quota z y
    (Sp) (err hX hΛ hF) test rests tariff apart hP.sharpens funded
