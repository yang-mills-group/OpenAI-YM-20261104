variable {G:Gauge}{n q m j K per f:ℕ}(R:Run G){V:Realm G (q+1) Credit.leanC}
  (draw:V.draws=R.family.path.levels)

private theorem cancel {A B:Levels G}(e:A=B)(w:Digits B (Fin n)):onLevels e (onLevels e.symm w)=w:=by
  cases e
  rfl

theorem addressed (start:m+1≤K)(age:m≤j)(live:j+2≤K)(z:Fin n→Site (R.family.side K per))
    (ground:footprint R z start=0):
    addresses R (j+1) per (homes (onLevels draw.symm (digits R z)) (0:Fin n→Lattice.Cover) m (j-m))
      (digits R z)=physical R z live:=by
  obtain ⟨a,rfl⟩:=Nat.exists_eq_add_of_le age
  funext v
  have bound:=((Nat.le_succ _).trans live)
  have seated:=WilsonReceivedChronologicalMaterialSites.itinerary R draw z start a bound v
  rw [ground] at seated
  let i:=m+a+1
  have parent:(R.family.path.levels.clock.op i per).ratio.parent (physical R z live v)=physical R z bound v:=
    (Next.Rank.Station.parent_nested _ _ _ (R.family.S.block_odd i) (R.family.S.toDepth_odd live per) _).symm
  unfold WilsonIndependentCollarCanonicalCofinalSeats.addresses
  rw [Nat.add_sub_cancel_left,seated,←parent,WilsonReceivedChronologicalMaterialSites.digits,dif_pos live]
  exact (R.family.path.levels.clock.op i per).ratio.unpack_at _

theorem original (φ:Test n):∃scale:ℝ,∃_positive:0<scale,∀r:ℝ,0<r→scale*r≤R.family.S.a 0→
    let b:=WilsonCloseCaptureDate.level R.family.S (scale*r)
    ∀(m f K per j:ℕ),m+1≤b→b≤f→∀fine:f≤K,8*R.family.S.a f<R.family.S.a b→
      ∀z:Sites R (f,per) n,WilsonCenteredCompactBooking.mass R φ r (f,per) z≠0→
      ∀_age:m≤j,∀live:j+2≤K,
      let actual:=placed R fine z
      let born:=WilsonReceivedChronologicalMaterialSites.digits R actual
      let cells:=onLevels draw.symm born
      addresses R (j+1) per (homes cells (0:Fin n→Lattice.Cover) m (j-m)) (onLevels draw cells)=physical R actual live:=by
  obtain ⟨scale,positive,geometry⟩:=WilsonReceivedChronologicalMaterialApertures.original R φ
  refine ⟨scale,positive,?_⟩
  intro r rp small b m f K per j early old fine narrow z occurs age live actual born cells
  have normal:footprint R actual (early.trans (old.trans fine))=0:=(geometry r rp small m f K per early old fine narrow z occurs).2.1
  rw [show onLevels draw cells=born from cancel draw born]
  exact addressed R draw _ age live actual normal

