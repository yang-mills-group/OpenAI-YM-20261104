theorem original {Z₀:ℕ→SeriesA G}{price:Credit}(quiet:QuietAt day price Z₀)
    {Types:Type}[Fintype Types]{purchased pieces physical:ℕ}{pole:Bool→ℕ}{span:Types→ℕ}{lag:Types→Bool→ℕ}
    (tube:LinkTube G)(front:Multi.Hot (Stock.census (Fin n))→Fin n)(member:∀s,front s∈s.val.val)
    (faculty:WilsonIndependentCollarDatedTeachers.At schedule R simple V dims grades (Burn.horizon (ask₀).vac)
      purchased allowance tube pieces physical pole span lag j)(anchor:V.anchor≤j+1)
    (lo:∃op:Mentor.Opportunity ((clock).J (j+1)) ((clock).J j),op.count=(ask₀).school.pieces ∧
      op.stage=(ask₀).school.order+1 ∧ ∀t:ℝ,0<t→
      WilsonOriginalCensusMaterialPosting.Posted R day.hk (WilsonOriginalCensusPhysicalAttendance.roots (prepared schedule) R simple)
        (WilsonOriginalCensusPhysicalAttendance.tab (prepared schedule) R simple) day.π day.Γ (day.Ψ per) house.books base
        op (day.lessons j base (by omega)) house.ahead (port (gridₗ) sites) (Bₗ) grades
        (ask₀).order (ask₀).shelf (bill₀).order tollL L t)
    (hi:∃op:Mentor.Opportunity ((clock).J (j+2)) ((clock).J (j+1)),op.count=(ask₀).school.pieces ∧
      op.stage=(ask₀).school.order+1 ∧ ∀t:ℝ,0<t→
      WilsonOriginalCensusMaterialPosting.Posted R day.hk (WilsonOriginalCensusPhysicalAttendance.roots (prepared schedule) R simple)
        (WilsonOriginalCensusPhysicalAttendance.tab (prepared schedule) R simple) day.π day.Γ (day.Ψ per) house.books (Nat.le_succ_of_le base)
        op (day.lessons (j+1) (Nat.le_succ_of_le base) (by omega)) house.ahead (port (gridᵤ) (zU)) (Bᵤ) grades
        (ask₀).order (ask₀).shelf (bill₀).order tollU U t)
    (up:∀v,cashᵤ v ≤ (H₂)^(power v+4))(down:∀v,cashₗ v ≤ (H₁)^(power v+4))
    (uPos:∀v,0<tollU v)(lPos:∀v,0<tollL v)
    (rates:WilsonOriginalCensusDatedHeldTariff.Rates R grades κ pt (j+1) top (bill₀).order)
    (within:WilsonOriginalCensusFaceAdmission.housed sites R (j+1) per)
    (sparse:WilsonOriginalCensusSparseRosterOpening.first R simple tube grades grades (charges power)
      (bill₀).order (bill₀).order (bill₀).target (bill₀).precision (bill₀).enough ≤ j+1)
    (gross:ℝ)(weight:∀s:YM.Multi.Hot (Stock.census (Fin n)),‖∏w∈s.val.val,(wallet w).val‖*‖touch test s.val.val‖ ≤ gross)
    (opened:∀(s:YM.Multi.Hot (Stock.census (Fin n)))(v:Fin ((bill₀).order+1)),
      WilsonOriginalCensusDatedPeriodOpening.Opened R (j+1) per (mass grades s.val.val+v.val)
        (rates.width s.val.val v) (rates.fare s.val.val v) gross (money (bill₀).precision))
    (caps:Fin n→ℝ)(paid:∀v,‖test v‖≤caps v)
    (diameter:ℕ)(covered:2*((univ:Finset (Fin n)).image sites).sup WilsonNeutralTwoPrintPathBoxHome.radius ≤ diameter)
    (selected:(u:Covers R.family.path.levels.S (j+1) (coarse R (j+1) per)) → Forest (step R (j+1) u.val).ratio)
    (credit:∀s:YM.Multi.Hot (Stock.census (Fin n)),WilsonOriginalCensusMeasuredStation.CreditAt R κ pt grades caps
      (j+1) top (bill₀).order per diameter (((hat₀)^(near ((bill₀).precision+1) (mass₀ s.val) 1))⁻¹))
    (lawU:rows (j+2)=hiWord)(lawL:rows (j+1)=loWord)
    {df:ℕ}{frame:Frame G df}(section_:SectionData frame)(group:Hol G)
    (np:0<n)(cost:ℕ)(tol η:ℝ)(tp:0<tol)(ep:0<η)
    (first:WilsonOriginalOneArmCurrentClock.first R simple grades power P cost tol η tp ep np≤j)
    (aperture:R.family.S.a (j+1)/R.family.S.a top≤(R.family.path.levels.clock.hatBeta (j+1))^cost)
    (support:∀i,(R.family.path.levels.budget i).supportExponent=100):
    ∀s:(Stock.census (Fin n)).Mode,
      WilsonOriginalOneArmSchoolWindow.Route (N:=N) R simple day.hk (WilsonOriginalCensusPhysicalAttendance.roots (prepared schedule) R simple)
        (WilsonOriginalCensusPhysicalAttendance.tab (prepared schedule) R simple) day.π day.Γ (day.Ψ per)
        house.books house.ahead rows (j+1) top (j+1) s P η:=by
  have gates:=WilsonOriginalOneArmCurrentClock.settled R simple grades power P cost tol η tp ep np first
  let reserve:=WilsonReceivedChronologicalFixedReserve.original grades power P R simple cost tol η tp ep
  have ordered:=reserve.choose_spec.1
  have meeting:= (eventually_atTop.mp reserve.choose_spec.2.2.choose_spec).choose_spec j gates.1
  obtain ⟨below,above,sized,ready,era,early⟩:=meeting.2 j le_rfl
  obtain ⟨opc,children,_,lowPaid⟩:=lo
  obtain ⟨opp,parents,_,upperPaid⟩:=hi
  have live:j+1<N:=later.trans_le valid
  have lc:0<Pert.Asymptotics.regulatorRun R.family N per (j+1):=
    ActualRunKernelPackets.regulator_pos R N per _ (by omega)
  have uc:0<Pert.Asymptotics.regulatorRun R.family N per (j+2):=
    ActualRunKernelPackets.regulator_pos R N per _ live
  obtain ⟨read,⟨τ,quietFee,issued⟩,legalU,legalL⟩:=WilsonReceivedChronologicalFixedQuiet.original day quiet base live
  have theta:=WilsonReceivedChronologicalFixedQuiet.teacher day per faculty anchor base live
  have lf:=lowPaid _ (pow_pos lc ((bill₀).rent+1))
  have hf:=upperPaid _ (pow_pos uc ((bill₀).rent+1))
  let lowerRank:=fun a:ℕ=>WilsonOriginalCensusMaterialPosting.Posted R day.hk
    (WilsonOriginalCensusPhysicalAttendance.roots (prepared schedule) R simple)
    (WilsonOriginalCensusPhysicalAttendance.tab (prepared schedule) R simple) day.π day.Γ (day.Ψ per) house.books base
    opc (day.lessons j base (by omega)) house.ahead (port (gridₗ) sites) (Bₗ) grades
    a (ask₀).shelf (bill₀).order tollL L ((Pert.Asymptotics.regulatorRun R.family N per (j+1))^((bill₀).rent+1))
  let upperRank:=fun a:ℕ=>WilsonOriginalCensusMaterialPosting.Posted R day.hk
    (WilsonOriginalCensusPhysicalAttendance.roots (prepared schedule) R simple)
    (WilsonOriginalCensusPhysicalAttendance.tab (prepared schedule) R simple) day.π day.Γ (day.Ψ per) house.books (Nat.le_succ_of_le base)
    opp (day.lessons (j+1) (Nat.le_succ_of_le base) (by omega)) house.ahead (port (gridᵤ) (zU)) (Bᵤ) grades
    a (ask₀).shelf (bill₀).order tollU U ((Pert.Asymptotics.regulatorRun R.family N per (j+2))^((bill₀).rent+1))
  have lf':lowerRank (bill₀).order:=(congrArg lowerRank ordered).mp lf
  have hf':upperRank (bill₀).order:=(congrArg upperRank ordered).mp hf
  intro s
  exact WilsonOriginalOneArmCurrentAppointment.original (R:=R) (simple:=simple) (house:=house) (ask:=ask₀) (day:=day)
    (base:=base) (digits:=digits) (test:=test) (κ:=κ) (pt:=pt) (top:=top) (seed:=seed) (sites:=sites) (L:=L) (U:=U)
    (low:=low) (high:=high) (wallet:=wallet) (tags:=tags) (later:=later) (valid:=valid)
    (opL:=opc) (lessonL:=_) (opU:=opp) (lessonU:=_) (tollL:=tollL) (tollU:=tollU)
    (lowerFile:=lf') (upperFile:=hf') (rows:=rows) _ reserve.choose_spec.2.2.choose
    reserve.choose_spec.2.1 sized below above children parents ready era (fun v=>power v+4) up down early le_rfl
    tube front member theta read issued legalU legalL rates within _ (bill₀).enough (bill₀).ceiling sparse gross weight opened
    caps paid diameter covered selected credit lawU lawL (fun v=>(uPos v).le) (fun v=>(lPos v).le)
    section_ group P cost (bill₀).precision tol η tp ep s reserve.choose meeting.1 aperture
    (bill₀).cash np (bill₀).marked support (gates.2 s)

