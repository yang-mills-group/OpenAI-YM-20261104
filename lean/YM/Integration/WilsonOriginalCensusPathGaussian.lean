theorem original {G:Gauge}{n m j:ℕ}{k D:Fin n → ℕ}{S:Finset (Fin n)}{A δ σ:ℝ}
  (R:Run G)(Y:Realm G (m+1) Credit.leanC)(lo:Y.anchor ≤ j+1)(enrolled:Paid R Y lo D k δ σ)
  (N:ℕ)(X:Input Y lo S k D A)(positive:0 ≤ A)(older:j+1 < N)(sw:0 ≤ σ)
  {I:Type}[Fintype I]{n':Side}{P:Passport n' (Fin n)}
  (B:I → Binder P (Stock.census (Fin n)))
  (c:I → Fin n)(inside:∀i,(B i).mode.val ⊆ S)(pin:∀i,c i ∈ (B i).mode.val)
  (deep:∀i,0 < mass k (B i).mode.val)(o:I → Cover)(t:I → Case D)(u:∀i,Frill (B i).mode.val (c i))

    {p':Passport n' (Fin n)}{μ:Type}
    (high:μ → Row p' (Stock.census (Fin n)) G (Affinity.Wallet (room (Fin n))))
    (placed:p'=P)(names:μ=((i:I)×((WilsonNeutralTwoPrintPathCensus.slates R Y lo enrolled N X positive older sw B c inside pin deep o t u) i).Roster))(ink:HEq high (mounted B (fun i=>((WilsonNeutralTwoPrintPathCensus.slates R Y lo enrolled N X positive older sw B c inside pin deep o t u) i).rows (WilsonOlderFreshGraphPointWallet.point (B i).center) disk)))
    {w:Fin n → ℝ}{σ₀ expense:ℝ}{order seats shelf:ℕ}
    (stock:Scene.Armada high w k σ₀ expense order seats shelf)(width:0 < σ₀)(hs:0 < σ)
    (closed:Cloze D k Y Credit.leanC)(tickets:Insure n (mass k univ) Y Credit.leanC)
    (per:ℕ)(hi:j < N)(F:Forest (step R j per).ratio)(tag:(step R j per).Choices)
    (h:n'.val∣(fine R j per).val)(x:Affinity.Wallet (room (Fin n)))
    {start e:ℕ}{quiet:ℕ → SeriesA G}{π:ℕ → Layout G}{Γ:ℕ → Pace.Coin}
    (legal:Legal (Step.tape (e+2)) (π (j+1)))
    (course:Read R N start e quiet π Γ)(live:start ≤ j){τ cash:ℝ}
    (funded:Issued R N (j+1) e (quiet (j+1)) τ cash)
    (b:Stationary.Link G (coarse R j per))(r:ℕ)(retained:r ≤ m)(grade:r ≤ e+2):
    let A₀:=Stationary.arm G _ 1 b
    let K₀:=model R N j per hi
    let raw:=Bulk.Fk K₀ F tag (copyColor h high k (fun a=>(high a).paint x) (π (j+1)) (Step.tape (e+2))) A₀ r
    let income:=fun z=>WilsonOriginalCensusPaidForest.value B R N j per hi F h x (fun i:I=>WilsonNeutralTwoPrintPathCopies.chart Y lo N (c i) X (o i) (t i) (u i)) A₀ z r
    let Q₀:=K₀.covariance F tag
    let computed:=WilsonOriginalGaussianPaidTable.table (Board (Stock.census (Fin n)) r) Q₀ income
    ratio raw=ratio computed ∧ logMarked raw=logMarked computed ∧
      ∀s,MeasureTheory.Integrable (WilsonOriginalGaussianPaidTable.presented (Board (Stock.census (Fin n)) r) income s) (Gaussian.cloud Q₀):=by
  subst p' μ
  cases eq_of_heq ink
  have admitted i:=WilsonNeutralTwoPrintPathCopies.admitted R Y lo enrolled N (c i) X (inside i)
    (pin i) positive older (o i) (t i) (u i)
  have matched (i:I):WilsonOriginalPrimerStampedRay.Matched ((WilsonNeutralTwoPrintPathCensus.slates R Y lo enrolled N X positive older sw B c inside pin deep o t u) i) ((fun i:I=>WilsonNeutralTwoPrintPathCopies.chart Y lo N (c i) X (o i) (t i) (u i)) i):=
    WilsonNeutralTwoPrintPathCopies.coordinates R Y lo enrolled N (c i) X (inside i)
      (pin i) positive older (deep i) sw (o i) (t i) (u i) hs closed tickets
  exact WilsonOriginalCensusGaussianTable.original B k (WilsonNeutralTwoPrintPathCensus.slates R Y lo enrolled N X positive older sw B c inside pin deep o t u) R N j per hi F tag h x (π (j+1)) (Step.tape (e+2))
    (fun i:I=>WilsonNeutralTwoPrintPathCopies.chart Y lo N (c i) X (o i) (t i) (u i)) stock width hs legal (fun i a y=>(admitted i a y).1) (fun i a y=>(admitted i a y).2)
    matched course live funded b r retained grade

