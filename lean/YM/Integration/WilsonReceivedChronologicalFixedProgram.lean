  {schedule:WilsonOriginalAllOrderCourse.Schedule G}(power:Fin n → ℕ)(P:ℕ)
  (house:Room (prepared schedule) R simple)(day:Day (prepared schedule) R simple (programme grades power P).school o N)
  {dims:Fin n → ℕ}{V:Realm G ((terms grades power P).order+1) Credit.leanC}{draw:V.draws=R.family.path.levels}
  {rate allowance:ℝ}(digits:Digits V.draws (Fin n))(test:Case dims)(κ:(v:Fin n) → Knob (dims v))
  (pt:Fin n → Chamber)(seed:(v:Fin n) → Choice R grades v)(wallet:Wallet (room (Fin n)))

local notation "roots₀" => WilsonOriginalCensusPhysicalAttendance.roots (prepared schedule) R simple
local notation "tab₀" => WilsonOriginalCensusPhysicalAttendance.tab (prepared schedule) R simple
local notation "clock₀" => R.alloy.B.a.clock
local notation "ask₀" => programme grades power P
local notation "q₀" => (terms grades power P).order
local notation "grid" a:max => R.family.side ((a)+1) per

open WilsonReceivedChronologicalFixedLedger (Registered before)
local notation "domain" => ↥(Ico m (K-1))
variable (ground:Fin n → Cover)(w:ℕ → Fin n → ℝ)
local notation "place" a:max => homes digits ground m ((a)-m)

open WilsonReceivedChronologicalFixedEnrollment (Cohort)
variable (old:o ≤ m)(valid:K ≤ N)
  (granted:Cohort (K:=K) (per:=per) (draw:=draw) (rate:=rate) (allowance:=allowance) power P house day digits
    test κ pt seed ground w old valid)
  (other:(i:ℕ) → Config G (R.family.side i per) → Marker.Poly (Stock.census (Fin n)))

def printed:=stream (ask₀) (day.Ψ per) (fun i:ℕ=>place i) granted.choose wallet other

theorem registered (a:domain):
    ∃row:Registered (K:=K) (per:=per) (draw:=draw) (rate:=rate) (allowance:=allowance)
      power P house day digits test κ pt seed wallet a.val (old.trans (mem_Ico.mp a.property).1) (before valid a)
        (place a.val) (w a.val) (printed power P house day digits test κ pt seed wallet ground w old valid granted other (a.val+1)),
      row.matter=granted.choose a:=
  granted.choose_spec wallet other a

theorem cutoff:
    printed power P house day digits test κ pt seed wallet ground w old valid granted other K=other K:=by
  cases K with
  | zero=>rfl
  | succ k=>
    apply WilsonReceivedChronologicalMaterialStream.outside
    simp only [Nat.add_sub_cancel,mem_Ico,lt_self_iff_false,and_false,not_false_eq_true]

