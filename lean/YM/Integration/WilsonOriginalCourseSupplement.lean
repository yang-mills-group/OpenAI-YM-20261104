/-! Co-elect a specified pre-length and post-length programme with the factorial calendar and the original source
purchases. Each theorem has the original specification on its one enrolled
run, whose block lengths and post-length invoice are retained alongside it. -/
set_option autoImplicit false
set_option quotPrecheck false
noncomputable section
namespace YM.Integration.WilsonOriginalCourseSupplement
open WilsonLimitConstruction.FundedCompanySelection
open PhysicalNext.Repeat.Legato
variable {G:Gauge}
def Award (more:Prediction G) {claim:∀(R:Run G)(T:Campaign R),Campaign.Pillars R T → Prop}
    (_:∃(R:Run G)(T:Campaign R)(W:Campaign.Pillars R T),claim R T W):Prop:=
  ∃(R:Run G)(T:Campaign R)(W:Campaign.Pillars R T),
    (WilsonEmittedNestedGround.Schedule R ∧ more R.kit) ∧ claim R T W
end YM.Integration.WilsonOriginalCourseSupplement
