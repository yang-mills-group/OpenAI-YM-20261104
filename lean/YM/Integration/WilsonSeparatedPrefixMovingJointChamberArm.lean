theorem declared (Q:SealR G)(φ:Rarity D)(ψ χ:Rarity Q.D)(hψ:ContDiff ℝ ∞ ψ.ψ.val)(hχ:ContDiff ℝ ∞ χ.ψ.val)
    (window:∀p q:Point4,φ.ψ.val p*ψ.ψ.val (q-p)=φ.ψ.val p*(χ.ψ.val q*ψ.ψ.val (q-p))):
    ∃S:𝓢(Euclid,ℂ),S=WilsonSeparatedPrefixMovingJointSpectrum.transformed ψ hψ ∧ (∀n:ℕ,Integrable (fun ξ:Euclid=>(1+‖ξ‖^n)*‖S ξ‖))∧
    ∀(R:Realm G (e+1) C)(_rider:PassportC H R Q W V){j t b N older:ℕ}(B:Era G Lounge),
    Auth j B→R.anchor≤b→ older≤b→b≤N→paceT R.draws.S t b≤1→
    ∀(user:Era G ℝ→ₗ[ℝ]ℝ),WilsonSeparatedPrefixMovingJetPrice.eligible Q.D user→WilsonSeparatedPrefixMovingJetService.eligible Q.D user→
    ∀(x v:ℝ),x≠0→∀(s:Cover)(o:CellR)(X:Q.Rider),
      let ε:=paceT R.draws.S t b
      let p:=fun z:CellR=>(ε/x) • Mer.address x v o s z.val
      let measure:=fun (z:CellR) A=>user (cruises R.draws R.paid N (Q.h+j) b older (agateV A (locale z B)))
      let fire:=fun d (w:CellR×Euclid)=>measure w.1
        (locale o (Q.spins R.draws R.paid (sheet χ (angle w.2) d) t b N (ε*v/x) X))
      let waves:=row S φ p fire
      Integrable waves (dayMeasure.prod volume) ∧
        (∫z,φ.ψ.val (p z)*measure z (move s (locale z (Q.spins R.draws R.paid ψ t b N ε X))) ∂dayMeasure)=
        ∫ξ,∫z,waves (z,ξ) ∂dayMeasure ∂volume:=by
  obtain ⟨S,identity,salary,book⟩:=WilsonSeparatedPrefixMovingJointOlderArm.declared (H:=H) (C:=C) (W:=W) (V:=V) (e:=e) Q φ ψ χ hψ hχ window
  refine ⟨S,identity,salary,?_⟩
  intro R rider j t b N older B hb gate ear top cap user accept wide x v hx s o X ε p measure fire waves
  let P:=polarP R.draws R.paid Q.ans Q.path N t b X
  have hp:Auth Q.h P:=by
    dsimp [P]
    rw [←rider.lands,←rider.modes]
    exact On_auth (tournure rider.f.arch X (rider.tap.symm ▸ gate) top)
  have charged (d):Continuous (fire d) ∧ ∃A:ℝ,0≤A ∧ ∀w:CellR×Euclid,‖fire d w‖≤A*(1+‖w.2‖^Q.D):=
    WilsonSeparatedPrefixMovingJointChamberWord.original R P B hp hb ear top user accept wide χ hχ ε (ε*v/x) (pace_pos ..) cap o Q.h d
  have pc:Continuous p:=by
    dsimp [p,Mer.address]
    fun_prop
  obtain ⟨total,swapped⟩:=WilsonSeparatedPrefixMovingJointChamberFubini.original S salary φ p pc fire Q.D charged
  refine ⟨total,Eq.trans ?_ swapped⟩
  apply integral_congr_ae
  exact Eventually.of_forall fun z=>(book R rider (locale z B) (hb.tuft _) gate ear top user accept x v hx s z o X).2
theorem original (Q:SealR G)(φ:Rarity D)(ψ χ:Rarity Q.D)(hψ:ContDiff ℝ ∞ ψ.ψ.val)(hχ:ContDiff ℝ ∞ χ.ψ.val)
    (window:∀p q:Point4,φ.ψ.val p*ψ.ψ.val (q-p)=φ.ψ.val p*(χ.ψ.val q*ψ.ψ.val (q-p))):
    ∃S:𝓢(Euclid,ℂ),(∀n:ℕ,Integrable (fun ξ:Euclid=>(1+‖ξ‖^n)*‖S ξ‖))∧
    ∀(R:Realm G (e+1) C)(_rider:PassportC H R Q W V){j t b N older:ℕ}(B:Era G Lounge),
    Auth j B→R.anchor≤b→ older≤b→b≤N→paceT R.draws.S t b≤1→
    ∀(user:Era G ℝ→ₗ[ℝ]ℝ),WilsonSeparatedPrefixMovingJetPrice.eligible Q.D user→WilsonSeparatedPrefixMovingJetService.eligible Q.D user→
    ∀(x v:ℝ),x≠0→∀(s:Cover)(o:CellR)(X:Q.Rider),
      let ε:=paceT R.draws.S t b
      let p:=fun z:CellR=>(ε/x) • Mer.address x v o s z.val
      let measure:=fun (z:CellR) A=>user (cruises R.draws R.paid N (Q.h+j) b older (agateV A (locale z B)))
      let fire:=fun d (w:CellR×Euclid)=>measure w.1
        (locale o (Q.spins R.draws R.paid (sheet χ (angle w.2) d) t b N (ε*v/x) X))
      let waves:=row S φ p fire
      Integrable waves (dayMeasure.prod volume) ∧
        (∫z,φ.ψ.val (p z)*measure z (move s (locale z (Q.spins R.draws R.paid ψ t b N ε X))) ∂dayMeasure)=
        ∫ξ,∫z,waves (z,ξ) ∂dayMeasure ∂volume:=by
  obtain ⟨S,_,data⟩:=declared (H:=H) (C:=C) (W:=W) (V:=V) (e:=e) Q φ ψ χ hψ hχ window
  exact ⟨S,data⟩
end YM.Integration.WilsonSeparatedPrefixMovingJointChamberArm
