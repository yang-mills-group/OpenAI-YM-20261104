local notation "stencil" => R.family.params
local notation "field₀" => R.family.labels.level 0
local notation "section₀" => R.family.localSection 0
local notation "J₃" => Stock.census (Fin 3)
local notation "strip" => (∀ a k : ℕ, k ≤ a → ∀ b : ℝ, R.alloy.delay.betaEntry a ≤ b →
  Real.exp ((Poetry.Agenda.seed D φ (Burn.horizon k) a)⁻¹ ^ 2) ≤ b)
local notation "stage₀" α:max => WilsonFullFaceSignedPower.constants section₀ stencil α ((2:ℝ)^(order+shelf+2)+4)
local notation "unit₀" => |testPrice field₀ * fee J₃ * WilsonFullFaceSignedPower.inter *
      (Fintype.card (Multi.parts (J₃)).Mode:ℝ)*125|
local notation "lamps" i:max mi:max L:max => rendered
  (Oak.student (n:=per) R hk D tab π Γ books mi (L).op (L).lesson ahead WilsonThermometerCourseHearing.disks
    (L).model order (L).voter) (Ψ i).p (Coat.gStep (Ψ (i+1)).beta)
local notation "ordinary" L:max => fun v=>((L).model v).paint WilsonThermometerCourseHearing.fired
local notation "roster" i:max L:max => Air.craft (L).model (ordinary L) ages
  (π (i+1)) (AllOrder.Floe.Step.tape (Burn.horizon k+2))
local notation "sheet" i:max => R.family.path.levels.clock.op i per
local notation "homes" i:max L:max => ((L).passport.coarser (sheet i).ratio).origin
local notation "base" i:max => Stationary.arm G (R.family.side i per) 1
local notation "budget₀" i:max => R.family.path.levels.budget i
local notation "topPost" i:max live:max => (RunFormalChain.fromRun R).step N i per live
local notation "canon" i:max => R.family.path.rep N per i
local notation "κ" i:max => LocalComparison.forcedDivisor R.family i

open RG12 XSpace WilsonThermometerAlignedCells

open MSbar.Heath WilsonJointAxialRoster WilsonJointAxialHearing WilsonReceivedWholeFieldHot
open Primitives.GCC.Anchor WilsonReportingForestAngularFare WilsonRegisteredAxialRates WilsonRegisteredAffineHalo WilsonRootedKioskOccupiedSlip
local notation "width₀" => (order+shelf+2)
local notation "reader" i:max mi:max L:max => Air.craft
  (Oak.student (n:=per) R hk D tab π Γ books mi (L).op (L).lesson ahead WilsonThermometerCourseHearing.disks (L).model order (L).voter)
  (fun v=>((Oak.student (n:=per) R hk D tab π Γ books mi (L).op (L).lesson ahead WilsonThermometerCourseHearing.disks (L).model order (L).voter) v).paint fired)
  ages (π i) (AllOrder.Floe.Step.tape (Burn.horizon k+2))
local notation "cost₀" p:max l:max => WilsonReceivedCloseOrdinaryGrade.invoice (J₃) (Fintype.card (Fin 3)) 0
    (p+(3+(l+2))) 1+(4:ℝ)^(p+(3+(l+2))+1+2*width₀*(Fintype.card (Fin 3)))*
      (Fintype.card (Multi.parts (J₃)).Mode)*((2:ℝ)^width₀)^(Fintype.card (Fin 3))

theorem original (inlet:post t mt (faces top)) (counted:Countable inlet.inputIndex)
    (refs:∀v:Fin 3,R.family.ref (grade v) ≤ N)
    (path:PlanV.Path D R.alloy tab (Burn.horizon k) N m π Γ)
    (pass:Pass D tab R.alloy R.kit) (month:Scholar.Month R.rolls D tab R.alloy.delay)
    (fits:order ≤ Burn.horizon k+1) (packed:order+shelf ≤ Burn.horizon k+2)
    (q l degree:ℕ) {price:ℝ} (cap:0 ≤ price) (deep:2*(q+2)+8 ≤ order) (aged:q+2+3 ≤ 3*k+2) {i:ℕ}
    (late:WilsonReceivedMeasuredStampPrice.opening R W.simple (q+2) order k deep aged zero_lt_one ≤ i+1)
    (weak:(eventually_atTop.mp (WilsonThermometerAncestralCalendar.weak R simple)).choose ≤ i)
    (mi:m ≤ i) (both:i+2 ≤ t)
    (days:((t-i:ℕ):ℝ) ≤ price*(Real.log (2+Real.log (R.alloy.B.a.clock.hatBeta i)))^degree)
    (booked:(eventually_atTop.mp (WilsonThermometerAncestralFunds.original R simple (degree+1) seats q l cap)).choose ≤ i)
    (oldRent:inlet.rent ≤ (g t)^(q+2)) (start:(g t)^l ≤ Poly.toll inlet.w full) 
    (way:WayStation R.kit) (station:WilsonCenteredCaptureClock.first R simple ≤ i) (sec:R.t 0 ≤ i)
    (slow:∀ j,((R.family.S.block j).val:ℝ) ≤ Real.log (RG16.Lambda R.family.path.levels j))
    (ready:WilsonReportLampForecast.Ready R.family.path.levels)
    (early:(eventually_atTop.mp (WilsonCenteredReporterClock.original R simple slow ready)).choose ≤ i)
    (activated:(eventually_atTop.mp (WilsonRootedKioskPostRadius.original R simple)).choose ≤ i)
    (force:q ≤ R.alloy.B.a.clock.J i)
    (opening:∀c ≤ seats, WilsonFirstReceivedEarnedFee.opening R simple c q order k (by omega) (by omega)
      (show (0:ℝ)<1/4 by norm_num) ≤ i)
    (saved:(eventually_atTop.mp (WilsonFullFaceSignedReserved.original R simple q)).choose ≤ i)
    (stripGrant:strip) (depth:ℕ) (H cap₀:ℝ) (hc:0 ≤ cap₀) (fit:k ≤ R.alloy.B.a.clock.J i)
    (heard:(eventually_atTop.mp (WilsonThermometerCenteredCompensation.original R simple D φ stripGrant order shelf
      k seats depth H cap₀ hc)).choose ≤ i)
    (fund:Volume.Fund D R.rolls tab φ books R.alloy.delay) (p:ℕ) (surplus:(p+1)+(3+(l+2)+87) ≤ q)
    (born:∀v,inlet.passport.origin v=(R.family.S.toDepth top per).parent (o.origin v))
    (profile:Test 3) (r:ℝ) (room:(eventually_atTop.mp (WilsonThermometerRegisteredTripleRoom.spatial R simple profile)).choose ≤ i)
    (space:|r| ≤ R.family.S.a i) (relative:Site (R.family.side N per) × Site (R.family.side N per))
    (placed:o.origin=atOrigin relative) (massAt:mass (R:=R) r (N,per) profile relative≠0)
    {η:ℝ} {T:Campaign R} {camp:Campaign.Pillars R T} (funded:FundedOriginalProperties.{u} simple η camp)
    (J:Voice G) (clear:Clear G J) (axes:Lattice.Order) {ε:ℝ} (ep:0<ε)
    (active : max (WilsonJointAxialRoster.opening R simple funded slow J clear (Fintype.card (Fin 3)) width₀ q ep)
      (WilsonReceivedAxialFiling.opening R simple D φ stripGrant order shelf (Fintype.card (Fin 3)) ep) ≤ i)
    (priced : max (WilsonReceivedAxialFinite.opening R simple q ep)
      (WilsonReceivedAxialFinite.massOpening R D ages order shelf seats (k:=k) simple stripGrant) ≤ i)
    (gate : WilsonReportingForestAngularReflection.posted R) (accuracy : ε*((3:ℝ)^q+2)≤1)
    (clockLate : (eventually_atTop.mp (WilsonJointAxialClock.original R simple)).choose ≤ i)
    (rareLate : WilsonJointAxialScalar.opening (V:=Fin 3) R simple gate q width₀
      (p+(3+(l+2))+1+2*width₀*(Fintype.card (Fin 3))) ≤ i)
    (winding : (eventually_atTop.mp (WilsonCoveredOrdinaryWeightedPost.original R simple D φ ages stripGrant
      order shelf k seats 0 (Fintype.card (Fin 3)) (3+(l+2)) (p+1) 1 1 (fee (J₃)) zero_le_one ep)).choose ≤ i) :
    let live:i<N:=by omega
    let y₀:=g (i+1)
    ∃L:post i mi (faces live), Reached R simple A top o hk D tab π Γ Ψ books ahead order shelf
      seats W mt inlet counted (q+2) 1 mi (show i ≤ t by omega) L ∧
    (∀v,(homes i L) v=(R.family.S.toDepth live.le per).parent (o.origin v)) ∧
    ∀(a:Stationary.Link G (R.family.side i per)) (z:ℝ),
      |z| ≤ |H| * (Real.log (R.family.path.levels.clock.hatBeta i))^depth*
        (((budget₀ i).B:ℝ)^2*(budget₀ i).threshold)/y₀ →
      (∀e,‖Exterior.collect G ((base i) a) e‖ ≤ cap₀*|z|) →
    let Q:=Order.value (y₀:ℂ) (Order.ratio (PhysicalWilsonPeriodizedMaterial.reference R N i per live ((base i) a) (roster i L) order))
    (∀(f:Forest (sheet i).ratio) (v:(sheet i).Choices),
      Order.value (y₀:ℂ) (Order.ratio (Bulk.Fk (topPost i live) f v (roster i L) ((base i) a) order))=Q) ∧
    let prior:=fun U=>(total (incoming R A simple (Nat.le_of_lt live) o U) Q).part full
    let H₀ := radius R (invoice (Fintype.card (Fin 3)) (q+2*width₀)) 1 i
    let h₀ := (WilsonDegreeFourInheritedRange.height R (q+2*width₀) i)*(4*(Ψ i).p.B+2)+2*(Ψ i).p.B+1
    let cold := House.chilly (G:=G) (plaquettes (homes i L) H₀) (angularCut (R.family.path.levels.clock.hatBeta i))
    let angle := WilsonJointAxialHearing.angleOf (homes i L) h₀ J axes (amplitude R J H₀ N per i) y₀
    let declared := fun U=>∑ s:(J₃).Mode,weight Q s*cold.indicator
      (fun V=>WilsonCoveredOrdinaryPolynomial.evaluated order (fun d=>Air.discharge (reader i mi L) d (angle V)) (y₀:ℂ) s) U
    let debt := |fee (J₃)*stage₀ 100| *(4^q+2)
    let cash := |fee (J₃)*cost₀ p l+ε|+unit₀+debt
    ∃ h:Coefficient field₀ (R.family.side i per), h.Format 0 stencil (Ψ i) ∧
      h.remBound 0 (Ψ i) (κ i) (debt*y₀^(p+1)) ∧ (field₀).coeffSize h.x ≤ unit₀*y₀^(p+1) ∧
      Poly.price (fun v=>y₀*L.w v) (inverseMass Q)≤fee (J₃) ∧
      let error := fun U=>prior U/((Ψ i).eval U:ℂ)-declared U-account h (Ψ i) U/((Ψ i).eval U:ℂ)
      RG.Envelope error ∧ ∀ (b : ℕ) (_hb : b ≤ i) (j : ℕ) (age : j ≤ i),
        (∫U,‖actualTransport R.family (N:=N) error age U‖ ∂scene R.family.path N per j)≤
          ((2:ℝ)^(p+1)*cash)*(g b)^(p+1) := by
  intro live y₀
  have support : (R.family.path.levels.budget i).supportExponent≤100 := (funded.2.1.paid.fixed i).le
  obtain ⟨L,trace,roots,atAnchor⟩:=WilsonThermometerAncestralCapture.original R simple A top o hk D tab π Γ Ψ
    books ahead order shelf seats W mt inlet counted refs path pass month fits packed q l degree cap deep aged late weak
    mi both days booked oldRent start way station sec slow ready early activated force opening saved stripGrant depth H cap₀
    hc fit heard fund (p+1) surplus born profile r room space relative placed massAt support
  have whole := WilsonThermometerAncestralLastWallet.original R simple A top o hk D tab π Γ Ψ books ahead order
    shelf seats W mt inlet counted q refs mi (show i<t by omega) L trace degree l cap slow days weak booked oldRent start
  refine ⟨L,trace,roots,?_⟩
  intro a z rent inside Q
  obtain ⟨datum,h,fmt,paid,size,replay,_physical⟩:=atAnchor a z rent inside
  let f:=WilsonCoeffUV.repeatF (sheet i)
  let ξ:=PhysicalWilsonPeriodizedProgram.branch (sheet i)
  have purchased:=(eventually_atTop.mp (WilsonThermometerCenteredCompensation.original R simple D φ stripGrant
    order shelf k seats depth H cap₀ hc)).choose_spec i heard A hk fit tab π Γ Ψ W.course books W.scroll W.chamber fund
      mi live o ahead L a z rent inside f ξ
  have fixed : Order.value (y₀:ℂ) (Order.ratio (Bulk.Fk (topPost i live) f ξ
      (roster i L) ((base i) a) order))=Q := datum f ξ
  have inverse : Poly.price (fun v=>y₀*L.w v) (inverseMass Q)≤fee (J₃) := by
    rw [← fixed]
    exact purchased.1
  refine ⟨datum,?_⟩
  intro prior H₀ h₀ cold angle declared debt cash
  have prereq : p+(3+(l+2))+1+Fintype.card (Fin 3)≤q := by simpa using (show p+(3+(l+2))+1+3≤q by omega)
  have quoted:=WilsonThermometerReceivedPrior.original R A simple live o hk D tab π Γ Ψ W.course books mi ahead order shelf
    seats L funded slow J clear axes q ep stripGrant W.scroll W.chamber fund active priced pass W.hospital
    (W.narrow.trans (R.alloy.B.a.fits.mono mi)) (L.capacity.le.trans W.load) fit gate p (l+2) prereq (by omega)
    accuracy clockLate rareLate winding whole Q inverse 0 h fmt paid replay
  refine ⟨h,fmt,paid,size,inverse,?_⟩
  intro error
  refine ⟨quoted.1,fun b hb j age=>?_⟩
  have coordinate : ‖h.x 0‖≤(field₀).coeffSize h.x :=
    Finset.single_le_sum (fun v _=>norm_nonneg (h.x v)) (Finset.mem_univ 0)
  have exp₀ : 0≤y₀^(p+1) := pow_nonneg (inv_nonneg.mpr (Real.sqrt_nonneg _)) _
  have rough : (∫U,‖actualTransport R.family (N:=N) error age U‖ ∂scene R.family.path N per j)≤cash*y₀^(p+1) := calc
    _ ≤ (fee (J₃)*cost₀ p l+ε)*y₀^(p+1)+(‖h.x 0‖+debt*y₀^(p+1)) := quoted.2 j age
    _ ≤ |fee (J₃)*cost₀ p l+ε| *y₀^(p+1)+(unit₀*y₀^(p+1)+debt*y₀^(p+1)) :=
      add_le_add (mul_le_mul_of_nonneg_right (le_abs_self _) exp₀) (add_le_add (coordinate.trans size) le_rfl)
    _ = _ := by dsimp only [cash]; ring
  have ratio:=WilsonLocalCompactRichPortUnits.compared R simple (hb.trans (Nat.le_succ i)) live per
  have cp : 0≤cash := by dsimp only [cash,debt]; positivity
  calc
    _ ≤ _ := rough
    _ ≤ cash*(2*g b)^(p+1) :=
      mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (inv_nonneg.mpr (Real.sqrt_nonneg _)) ratio _) cp
    _ = _ := by rw [mul_pow];ring

end YM.Integration.WilsonThermometerAncestralPrior
