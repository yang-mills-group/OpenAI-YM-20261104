private theorem eventually_large (simple:G.Simple):
    ∀ᶠ j₀ : ℕ in atTop, 2 ≤ R.alloy.B.a.clock.hatBeta j₀:=by
  let L:=R.family.path.levels
  have rise:Tendsto L.clock.hatBeta atTop atTop:=
    tendsto_atTop_add_const_left _ _ (L.S.divergent.const_mul_atTop (Gauge.slopeConstant_pos simple))
  exact rise.eventually_ge_atTop 2

def first (simple:G.Simple):ℕ:=(eventually_atTop.mp (eventually_large R simple)).choose

local notation "account" H:max => Oak.figureReal R hk D Q₀ π Γ books hi (H).op (H).lesson ahead school.order school.horizon
local notation "σ" => Poetry.Agenda.seed D φ (Burn.horizon k) (R.alloy.B.a.clock.J (j+1))
local notation "expo" => (Ψ (j+1)).p.supportExponent+2
local notation "height" => school.order+school.horizon+1

include history in
theorem original (simple:G.Simple)(cut:i₁<N)(late:first R simple ≤ i₁)
    (z:child)(T:slate)(H:upper z T):
    Invoice.Supports (Ψ i₁).p (2*(account H).mist) expo (Coat.gStep (Ψ i₁).beta) σ (account H).limitC ∧
    Invoice.price (Ψ i₁).p (2*(account H).mist) height school.pieces expo (account H).limitC G ≤
      (2:ℝ)^height * budgetR R i₁:=by
  have fine:Coat.gStep (Ψ (i₁+1)).beta=regulatorRun R.family N per (i₁+1):=by
    rw [(history.1.walk _ ((hi).trans (Nat.le_succ i₁)) cut).beta]
    rfl
  have low:Coat.gStep (Ψ i₁).beta=regulatorRun R.family N per i₁:=by
    rw [(history.1.walk _ hi cut.le).beta]
    rfl
  have step:Coat.gStep (Ψ (i₁+1)).beta ≤ 2*Coat.gStep (Ψ i₁).beta:=by
    rw [fine,low]
    exact WilsonOlderFreshGraphInvoiceCurrency.ratio R simple cut
  have band:2 ≤ R.alloy.B.a.clock.hatBeta i₁:=
    (eventually_atTop.mp (eventually_large R simple)).choose_spec _ late
  have enough:1 ≤ (R.family.path.rep N per i₁).beta:=by
    have lowBand:R.alloy.B.a.clock.hatBeta i₁/2 ≤ (R.family.path.rep N per i₁).beta:=(R.makes.wilson.represents N per i₁ cut.le).band.1
    linarith only [band,lowBand]
  have limit:Coat.gStep (Ψ i₁).beta ≤ 1:=by
    rw [(history.1.walk _ hi cut.le).beta]
    exact inv_le_one_of_one_le₀ ((Real.one_le_sqrt).mpr enough)
  have gp:0 < Coat.gStep (Ψ i₁).beta:=by
    rw [(history.1.walk _ hi cut.le).beta]
    exact inv_pos.mpr (Real.sqrt_pos.mpr (lt_of_lt_of_le zero_lt_one enough))
  have scopes:=H.issued.Waffle.soon
  have quote:=H.issued.Waffle.quote
  have compat:(account H).afterwards=σ:=by rfl
  rw [compat] at scopes
  have sameSeats:Invoice.price (Ψ i₁).p (account H).mist height school.pieces expo (account H).limitC G ≤ budgetR R i₁:=by
    have sum:Invoice.price (Ψ i₁).p (account H).mist (account H).cap (account H).count
        ((Ψ i₁).p.supportExponent+1+1) (account H).limitC G ≤ budgetR R i₁:=quote.trans H.issued.Beamwork
    have rank:(account H).cap=height:=by rfl
    have width:(account H).count=school.pieces:=H.capacity
    simpa only [rank,width,add_assoc,one_add_one_eq_two] using sum
  constructor
  · exact WilsonOlderFreshGraphInvoiceCurrency.shift (by simpa only [add_assoc,one_add_one_eq_two] using scopes) step gp limit
  · rw [WilsonOlderFreshGraphInvoiceCurrency.quote]
    exact mul_le_mul_of_nonneg_left sameSeats (by positivity)

end YM.Integration.WilsonOlderFreshGraphReceivingFigure
