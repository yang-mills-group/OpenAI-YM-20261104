/-- The native Wilson finite coefficient Ward and the full nonlinear group
gauge germ use precisely the same analytic test maps. -/
theorem nonlinear {G:Gauge}{n:Side}{P Q:Pap (wire G n)}{s:Signed}{b:Site n}
    (h:rollTest P Q s b):Rite P Q s b:=by
  intro U inst a c g ha hc ca cc gauge _fixed localEq
  have event:TurnsG s b g a c:=⟨ca,cc,ha,hc,gauge,by simpa only [WilsonCoeffUV.Bank.Mosaic.mantle_input] using localEq⟩
  have compare:=h event
  rwa [WilsonPointChildEra.train,WilsonPointChildEra.train,WilsonPointChildEra.axes,WilsonPointChildEra.axes] at compare

theorem submitted {G:Gauge}{V:Type}[NormedAddCommGroup V][NormedSpace ℝ V]{k:ℕ}{T:Era G V}
    (bought:Auth k T)(n:Side)(f:V→ₗ[ℝ]ℝ):
    let P:=flash (ply f (T.1 n))
    Rite P P 1 0:=nonlinear (bought.token n f)

omit [Fintype ι] in
/-- Arbitrary physical child digits, finite UV origins and proper faces. The
Ward acts on the full charged source functional before selecting one angle. -/
theorem original (R:Run G)(simple:G.Simple){k h:ι→ℕ}(u:ι→G.ColorIndex)(depth:∀s,k s<h s)
    (o:Loc G 1)(m N B:ℕ)(live:m+1<N)(fresh:m+1≤B)
    (d₁ d₂:ι→∀i,Site (R.family.S.block i))(v₁ v₂:∀s,Letter (R.family.labels.level (k s)))
    (T:Finset ι)(y:ι→ Cover)(z:ι→Site (ll R.family.path.levels m).L)(z':ι→Site (ll R.family.path.levels (m+1)).L)
    (I:Finset ι)(n:Side)(f:Pen h I→ₗ[ℝ]ℝ):
    let A:=R.family.path.levels
    let old:=bank R u depth d₁ N (m+2) v₁
    let birth:=bank R u depth d₂ B (m+1) v₂
    let P:=flash (ply f ((output A R.metals.O m N k T old birth y z z' I).1 n))
    Rite P P 1 0:=by
  intro A old birth P
  let sites:=chartIn (ll A m) y z
  let X:=old (chartIn (ll A (m+1)) sites z')
  let W:=logO A R.metals.O (m+1) N X k
  have first:=WilsonPointChildCenteredPortfolio.lawful R u depth o simple d₁ N (m+2) (by omega) v₁ (chartIn (ll A (m+1)) sites z')
  have last:=WilsonPointChildCenteredPortfolio.lawful R u depth o simple d₂ B (m+1) fresh v₂ sites
  have purchased:Eu k W:=step_L A R.metals.O (m+1) N X k live simple R.alloy.B.ratio first.1
  have empty:W ∅=0:=logHush _ _ _ _ _ _
  have joined:=WilsonPointChildReceivedFace.legal T purchased last.1 empty
  exact submitted ((step_L A R.metals.O m N (mounted T W (birth sites)) k (by omega) simple R.alloy.B.ratio joined.1) I) n f

