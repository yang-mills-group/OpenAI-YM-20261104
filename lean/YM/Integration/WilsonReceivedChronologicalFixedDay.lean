theorem original (paid:WilsonOriginalAllOrderCourse.Paid.{u} a simple ε (prepared s) R T W)
    (paths:FundedOriginalVacuumPaths.prices R.kit)
    (room:WilsonOriginalCensusPhysicalAttendance.Room (prepared s) R simple)
    {n q p:ℕ}{grades:Fin n→ℕ}(ask:Demand q p grades):
    ∃price:Credit,∀ᶠ o:ℕ in atTop,∀N:ℕ,o ≤ N →
      ∃day:Day (prepared s) R simple ask.school o N,∃Z:ℕ → SeriesA G,
        WilsonOriginalCensusFiledAttendance.QuietAt day price Z:=by
  obtain ⟨price,thermal⟩:=WilsonOriginalCensusAttendanceVacuum.original paid paths room ask.vac
  refine ⟨price,?_⟩
  filter_upwards [(WilsonOriginalCensusPhysicalAttendance.original paid).2 ask.vac ask.school ask.deep,thermal]
    with o seated earned
  intro N valid
  obtain ⟨day⟩:=WilsonOriginalCensusAttendanceStation.choose_day seated valid
  obtain ⟨Z,issued,reset,read⟩:=earned N valid
  exact ⟨day,Z,issued,reset,read ask.school day⟩

