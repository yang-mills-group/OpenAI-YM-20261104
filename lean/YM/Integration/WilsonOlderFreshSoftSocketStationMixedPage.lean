variable {p:ℕ}(W:Realm G (p+1) Credit.leanC)(hub:W.draws=R.family.path.levels)
    (sv:V.paid=R.metals.O)(sw:W.paid=R.metals.O)
local notation "booked" => fun y s=>enrolled R D W hub N per c (ck.trans live.le) y s (test D s κ pt A (bound s))

include money sv sw in
theorem original (s:FC)(occupied:s.Nonempty)(late:ℕ)(θ:ℝ):
    stamp (outside r grade cash) s*
      WilsonOriginalTwoFlatRoseFiledVisit.published R D (i:=i) V draw κ pt A o live.le ck costed measured cash
        (WilsonOriginalTwoFlatIRFlatMarked.seat s) (bound s) late p θ =
    table R D W N per top c late (i+1) booked g reading restored p θ false raw s:=by
  simp only [table,if_pos occupied]
  unfold WilsonOriginalTwoFlatRoseFiledVisit.published
  have coord:reading=(fun a=>entire R (grade a) top (N,per) (measured a)):=by
    funext a
    simp only [WilsonOriginalPublicTrialInput.vector,if_pos live]
  rw [←coord,WilsonOlderFreshSoftSocketStationDose.scaled R f n r grade cash money]
  apply congrArg (WilsonOlderFreshSoftRoseMarket.scaled s restored)
  exact WilsonOlderFreshSoftSocketStationRange.same R D q p V W draw hub sv sw N per top c late (i+1) (ck.trans live.le)
    raw s (test D s κ pt A (bound s)) g reading p θ false

