    (o:Fin 3→Site (R.family.side f per))(live:f+n<N)(ck:c≤f+n)
    (r η:ℝ)(order:ℕ)(M:Fin 3→ℝ)(reg:Indexed R grade (fun _=>A₀.station.k) order η M (filed R A₀))
    (kK:A₀.station.k≤f+n)(cash:Fin 3→ℂ)(money:∀a,cash a ≠ 0)
