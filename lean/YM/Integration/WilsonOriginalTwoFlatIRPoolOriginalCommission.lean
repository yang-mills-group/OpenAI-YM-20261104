def OnFile (R:Run G)(l:Filter (ℕ×ℕ))(D:Fin 3→ℕ)(pt:Fin 3→Chamber)(φ:Test 3)
    (dates:Fin 3→ℕ)(labels:∀i:Fin 3,ℕ×ℕ→R.family.label (ages i))(M:Fin 3→ℝ)
    (r γ:ℝ)(sensor:ℂ)(margin:ℝ){u f K:ℕ}(uf:u ≤ f)(fk:f ≤ K)(c m Q J₀ requested tag target src apron:ℕ)
    (plan:Plan 3){top:ℕ}{Vc:Realm G (top+1) Credit.leanC}(drawc:Vc.draws=R.family.path.levels):Prop:=
  ∀program:Program R ages K,∃file:Filed R ages K,(∀i,file.station i=dates i) ∧ file.target=target ∧
    (∀N per wallet seats j,j < K→file.row N per wallet seats j=WilsonMovingForkPrintedFile.row program N per wallet seats j) ∧
    Closed R l D pt φ dates labels M r γ sensor margin uf fk c m Q J₀ requested tag src apron plan file drawc

theorem original (simple:G.Simple)
    {master:EveryPhase.Almanac F}{reader:Orbits.Reader F.sector.derivatives F.sector.turns F.room.kernel.spin}
    {cohort:Ultrafilter (ℕ×ℕ)→Prop}
    (selected:WilsonViewerElectedHierarchy.Selected.{u} F master reader Jr H z l simple cohort)
    (birth:WilsonPhysicalAllGradeWeakElection.Assignment F Jr H l simple)
    (slow:WilsonWindowReportingPace.Slow R.kit)(shop:RG05Preconstruction.ReadoutPurchase R.b)
    (κ₀:ℕ)(positive:0 < κ₀)(ratio:Z.run.ratio=(3:ℕ)^κ₀)(T h:ℕ)
    {δ:ℝ}(dp:0 < δ)(books:(s:{s:ℝ//0 < s ∧ s < δ})→Book F (l:=l) H z 6 T s.val)
    (same:∀r,∃live:6 ≤ (birth.day r.val).1,WilsonPhysicalWeakWallBooks.Shared F (books r)
      (WilsonPhysicalWeakSameStation.trim live (birth.day r.val).2))
    (stage:ℕ)(color:G.ColorIndex)(paths:FundedOriginalVacuumPaths.prices R.kit)
    (bank:WilsonThermometerClusterProjectionBudget.Ready (P))(lamp:WilsonReportLampForecast.Ready (P))
    (extra:∀i:Fin 3,(Spin.comparator (C).book).Field (grade i).val)
    (funded:WilsonOriginalAllOrderCourse.Paid.{u} axis simple ε (prepared schedule) R crop W):
    ∃(t:ℕ)(M:Fin 3→ℝ)(E:Fin 3→ℕ)(physical votes apron:ℕ),9 ≤ t ∧ (∀i,1 ≤ M i) ∧
    ∀(goal debt:ℕ)(_ : 2 ≤ goal),
    let requested:=request goal physical E
    let power:=debit goal physical E
    let reserve:=depth ((2*power+∑i,E i)+1) (WilsonAddressedMixedStationRange.width T h) 6
    let mesh:=2*T+11+2*h+reserve+1
    let pole:=(∑i,E i)+WilsonAddressedMixedRawTrial.power T h reserve 6
    let J₀:=cut goal votes debt mesh
    let Q:=print goal physical votes debt mesh 1
    J₀+9 ≤ Q ∧ ∀{I:Type}[Fintype I](D:Fin 3→ℕ)(pt:Fin 3→Chamber)(caps:Fin 3→ℝ),
    (∀i,‖present D i‖ ≤ caps i)→(∀i,ages i < D i)→∀(tol η:ℝ),0 < tol→0 < η→
    ∀(_teacher:ℕ)(_tube:Comparison.Density.Transport.LinkTube G)(_pieces _assignment:ℕ)(_orders:Bool→ℕ)
    (_sizes:I→ℕ)(_tariff:I→Bool→ℕ)(loss:ℝ)(sourceFloor fileTariff:ℕ),
    let earned:=middle R goal physical votes debt mesh 1 pole
    let infrared:=max (crossed ages earned) (4*(2*⌈loss⌉₊+1))
    ∃plan:Plan 3,plan.Affords (demand goal physical) (2*votes) (WilsonOriginalObservedRosePublicMesh.aperture mesh) 14 ∧
    ∀(level:ℕ),0 < level→∃band:WilsonPositionProgramReporterBand.Band R Z.run level,
    ∀ᶠstartLevel:ℕ in atTop,∃u₀:ℕ,startLevel ≤ u₀ ∧ Stop (C) 0 startLevel u₀ ∧
    ∃move:WilsonIndependentCapturedPages.Stop R Z.run band u₀ infrared,∃shelf:ℕ,
    ∀ᶠanchor:ℕ in atTop,∃top:ℕ,∃Vc:Realm G (top+1) Credit.leanC,∃drawc:Vc.draws=P,
    Vc.paid=R.metals.O ∧ Vc.anchor=anchor ∧ ∀(margin:ℝ),0< margin →
    ∀ᶠr in trail,∀ρ:Fin 3→{s:ℝ//0 < s ∧ s < δ},(∀i,(ρ i).val=r)→
    let f:=reporter F books ρ
    let K:=berth R reserve f
    let c:=WilsonReceivedChronologicalFixedCellFee.capture R roseTest r
    let L:=fun i=>home F Jr Z (books (ρ i)) (grade i) (publicHead i)
    ∃w:ℕ,c=band.reporter+w ∧
    let m:=move.date w-1
    ∃_date:m+1=move.date w,∃old:u₀ ≤ m,∃crossing:m+1 < c,∃upper:c < f,∃fk:f < K,
    shelf+1 ≤ c ∧ level ≤ m+1 ∧
    WilsonAddressedPublicFirstRoseTicket.Receipt R (WilsonAddressedPublicFirstSites.original R drawc roseTest).choose
      (WilsonReceivedChronologicalFixedCellFee.factor R roseTest) r (wilson z r) m f K c plan.width ∧
    ∃(V:Realm G (Q+1) Credit.leanC)(draw:V.draws=P),V.paid=R.metals.O ∧ V.y=zz P ∧ V.anchor=m+1 ∧
      Covered R D Q (m+1) shelf V draw 1 tol ∧ (∀s:Faces,s.Nonempty → Stock R D Q (m+1) shelf V draw 1 tol s) ∧
    ∃src:ℕ,sourceFloor ≤ src ∧ u₀ ≤ src ∧ src+2 ≤ f ∧
    OnFile R (l:Filter _) D pt roseTest (fun i=>(L i).j) (fun i=>(L i).arm.source) M
      r (wilson z r) (WilsonOriginalTwoFlatIRPoolFirstSignal.smooth F Jr Z publicHead roseTest r)
      margin (old.trans ((Nat.le_succ m).trans (crossing.le.trans upper.le))) fk.le
      c m Q J₀ requested t fileTariff src apron plan drawc:=by
  classical
  obtain ⟨t,tn,checked,M,E,one,source⟩:=WilsonReceivedChronologicalFixedRoseGridCohort.original
    F Jr Z simple selected.bliss slow (h:=h) dp books publicHead extra selected.leading selected.obeys birth
    positive ratio stage color paths same bank lamp selected.original funded
  obtain ⟨B,bp,physical,votes,charge,cp,hearing⟩:=WilsonOriginalTwoFlatIRPoolPanelHearing.original
    F Jr Z simple selected slow shop κ₀ positive ratio T h books checked dp funded
  obtain ⟨apron,school⟩:=source roseTest
  refine ⟨t,M,E,physical,votes,apron,tn,one,?_⟩
  intro goal debt high requested power reserve mesh pole J₀ Q
  let tuition:=capital R 6 (max 1 (4*∑i,M i))
  have tuition0:0 ≤ tuition:=le_max_left ..
  have ranks:=WilsonReceivedChronologicalFixedRoseEnrolledRanks.original R goal physical votes debt mesh 1 pole 1 tuition tuition0
  have retained:J₀+9 ≤ Q:=ranks.2.1
  refine ⟨retained,?_⟩
  intro I fin D pt caps paid labels tol η tp ep teacher tube pieces assignment orders sizes tariff loss sourceFloor fileTariff earned infrared
  let hired:=WilsonAddressedPublicFirstRoseTerms.order R earned
  let A:=WilsonAddressedPublicFirstRoseSchedule.allowance R simple slow T h reserve infrared
  have hp:0 < infrared:=lt_of_lt_of_le (by omega : 0 < 4*(2*⌈loss⌉₊+1)) (le_max_right ..)
  have caps0:∀i,0 ≤ caps i:=fun i=>(norm_nonneg _).trans (paid i)
  obtain ⟨training,trained,afford,calendar⟩:=school goal physical votes debt D pt caps paid labels
    tol η tp ep teacher tube pieces assignment orders sizes tariff loss sourceFloor fileTariff
  let price:=WilsonReceivedChronologicalFixedRoseEnrolledCash.roof training caps
  let plan:=WilsonReceivedChronologicalFixedRoseOriginalAccount.budget ages (fun _=>0) (hired+1) A pole hired
    (entrance goal physical) earned 1 (terminal goal physical votes mesh) 1 tuition price 100 η η price
  refine ⟨plan,afford,?_⟩
  intro level lp
  obtain ⟨band,dates⟩:=hearing paths lamp D pt caps caps0 labels earned tol η tp ep teacher tube pieces assignment orders
    sizes tariff reserve infrared hp level
  obtain ⟨minimum,cal⟩:=Filter.eventually_atTop.mp calendar
  refine ⟨band,?_⟩
  filter_upwards [dates,eventually_ge_atTop (max minimum ((C).ref 0))] with start haveDate low
  obtain ⟨u₀,su,original,stops,faculty,ia,ia0,issued⟩:=haveDate
  let move:WilsonIndependentCapturedPages.Stop R Z.run band u₀ infrared:=(stops infrared).some
  obtain ⟨U,up,menu⟩:=issued reserve
  have eligible:J₀ ≤ Q:=(Nat.le_add_right J₀ 9).trans retained
  obtain ⟨shelf,reads⟩:=menu goal debt Q high eligible 1 zero_lt_one 1 tol zero_le_one tp plan M one afford
  refine ⟨u₀,su,original,move,shelf,?_⟩
  have threshold:minimum ≤ u₀:=(le_max_left ..).trans (low.trans su)
  have ref0:(C).ref 0 ≤ u₀:=(le_max_right ..).trans (low.trans su)
  filter_upwards [cal u₀ threshold] with anchor native
  obtain ⟨Vc,drawc,heat,grounding,radius⟩:=native
  refine ⟨_,Vc,drawc,heat,grounding,?_⟩
  intro margin mp
  have clk:=wilson_link F simple selected.bliss.budgets selected.bliss.keen selected.bliss.lies
  filter_upwards [radius Z.run level band move lp ref0 shelf,reads A margin mp,clk.positive,
    (clk.conforms simple).eventually (ge_mem_nhds zero_lt_one)] with r physicalDate weak gp small
  intro ρ equal f K c L
  have admitted:∀i,r ≤ (ρ i).val ∧ (ρ i).val ≤ outer z h r:=by
    intro i
    rw [equal i]
    refine ⟨le_rfl,?_⟩
    have rp:0 < r:=by rw [← equal i]; exact (ρ i).property.1
    have estimate:r ≤ r/(wilson z r)^h:=(le_div_iff₀ (pow_pos gp _)).2
      (mul_le_of_le_one_right rp.le (pow_le_one₀ gp.le small))
    simpa only [outer,div_eq_mul_inv,inv_pow] using estimate
  obtain ⟨w,atCapture,date,old,crossing,upper,fk,shelfRaised,live,ticket,src,front,us,early,files⟩:=
    physicalDate ρ admitted ⟨0,equal 0⟩
  let m:=move.date w-1
  obtain ⟨V,draw,oil,zero,pivot,covered,stock,uf,heard⟩:=weak ρ equal m _ _ upper.le fk ticket
  refine ⟨w,atCapture,date,old,crossing,upper,fk,shelfRaised,live,ticket,V,draw,oil,zero,pivot,covered,stock,src,front,us,early,?_⟩
  intro program
  obtain ⟨file,filed,targetEq,rows,values⟩:=files program
  refine ⟨file,filed,targetEq,rows,?_⟩
  have fundedRead:=heard c requested t (Nat.succ_pos _) crossing.le upper.le
    (Nat.le_trans crossing (upper.le.trans fk.le)) (by
      change R.family.S.scale K - R.family.S.scale m ≤ (A:ℝ)*(1+Real.log (R.family.path.levels.clock.hatBeta (m+1)))
      exact ticket.span) file Vc drawc
  apply WilsonOriginalTwoFlatIRPoolFiledClosure.original R (l:Filter _) D pt roseTest (fun i=>(L i).j)
    (fun i=>(L i).arm.source) M r (wilson z r) _ margin uf fk.le c m Q J₀ requested t
    plan file drawc src apron filed fundedRead
  exact values (fun _ _ _ _ _ _=>0)

end YM.Integration.WilsonOriginalTwoFlatIRPoolOriginalCommission

