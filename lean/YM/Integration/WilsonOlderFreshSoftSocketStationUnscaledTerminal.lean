theorem original (Φ:Test 3)(simple:G.Simple)(bliss:Bliss F l z H)(lead:Leading F Jr)
    (obedient:∀d:ℕ,∀ᶠr in trail,Frame.obedient F H (Jr r) d)
    (slow:WilsonWindowReportingPace.Slow R.kit)(shop:RG05Preconstruction.ReadoutPurchase R.b)
    (cap:∀j,1≤((P).budget j).supportExponent)(upper:∀j,((P).budget j).supportExponent≤100)
    (color:G.ColorIndex)
    (funded:WilsonOriginalAllOrderCourse.Paid.{u} axis simple ε (prepared schedule) R crop W)
    (paths:FundedOriginalVacuumPaths.prices R.kit)(T h:ℕ){δ:ℝ}
    (books:(t:{t:ℝ // 0<t ∧ t<δ})→Book F (l:=l) H z 6 T t.val)
    (delivered:∀t,WilsonMovingForkWindowBooks.Priced F (books t))(x:∀i:Fin 3,RG17.Free C (grade i).val):
    ∃bank:ℕ,∀(target reserve:ℕ)(debt:Fin 3→ℕ),∃U:Set ℝ,U∈trail ∧
    let due:=∑i,debt i
    let mesh:=WilsonOriginalObservedRosePublicMesh.aperture (WilsonReceivedChronologicalFixedRosePublicAperture.width reserve (2*T+11+2*h))
    let balance:=WilsonOriginalObservedRosePublicGross.base bank (due+1)
    ∀(power reach:ℕ)(credit:ℝ),
    let stopOrder:=WilsonOlderFreshSoftSocketStationSevenPower.order (target+1) balance mesh
    let wStop:=date R reach (loss R power stopOrder)
    Tendsto wStop atTop atTop ∧
    ∀(retained Q:ℕ),WilsonOlderFreshSoftSocketStationAbsoluteWages.degree (target+1) bank due mesh≤retained →
    retained+9≤Q → ∀(D:Fin 3→ℕ),(∀i,ages i<D i) → ∀(caps:Fin 3→ℝ)(opt tol:ℝ),0≤opt → 0<tol →
    ∃day onset:ℕ,∃school:(v:ℕ)→ onset≤v→WilsonOriginalObservedRoseProbeShelf.Badge R D Q v day opt tol,
    ∀width:ℕ,∀ᶠv:ℕ in atTop,∃entered:onset≤v,
    ∀r∈U,∀ρ:Fin 3→{t:ℝ // 0<t ∧ t<δ},(∀i,r≤(ρ i).val ∧ (ρ i).val≤outer z h r) → (∃i,(ρ i).val=r) →
    let slots i:=reading F Jr Z (books (ρ i)) (grade i) (x i)
    let b:=reporter F books ρ
    let K:=berth R reserve b
    ∀(N per c requested tag:ℕ)(bk:b≤K)(kn:K≤N),b<N → v≤b → v≤wStop c → v≤c → c≤K → v+1≤K →
    (a c)/(a K)≤(β c)^reach → σ K-σ (v-1)≤width*(1+Real.log (β v)) →
    let θ:=g N per v
    let Active:=cells R Φ r (b,per)
    ∀(file:Filed R ages K)(panel:Active→ Panel R ages N per b K bk kn requested power tag credit),
    (∀y,(panel y).loc=y.val) →
    (∀o,(panel o).slot=file.station) → (∀o,(panel o).axis=file.A N per) →
    (∀o i,(panel o).slot i=(slots i).j) → (∀o i,(panel o).names i=(slots i).arm.source (N,per)) →
    ∀(κ:(i:Fin 3)→Knob (D i))(pt:Fin 3→Chamber)(digits:Active→Digits (P) (Fin 3))
      (pins:Active→Fin 3→ Cover)(test:Active→Case D),(∀o i,‖test o i‖≤caps i*(θ⁻¹)^debt i) →
    let w o:=votes R ages (N:=N) (per:=per) file (panel o).names (panel o).turn
    let row j (o:Active)(s:Faces):=normalized R ages κ pt N per K c v (digits o) s (w o) (pins o) (touch (test o) s) j θ
    let high (o:Active)(s:Faces):=figure R ages κ pt N per K c v (digits o) s (w o) (pins o) (touch (test o) s) Q θ
    let office:=school v entered
    let branchTest (o:Active)(s:Faces):=touch (fun i:s=>test o i.val) (univ:Finset s)
    let probe (o:Active)(s:Faces):=WilsonOriginalObservedRoseProbeRead.filed R D s κ pt
      (fun j (i:s)=>(digits o) j i.val) (fun i:s=>(pins o) i.val) office.field office.draw (branchTest o s)
    let stopped (o:Active)(s:Faces):=(WilsonOriginalObservedRoseProbeRead.quota (branchTest o s):ℂ)*
      WilsonOlderFreshSoftRoseMarket.row (R:=R) D office.field s N K c (wStop c) v (probe o s) (g N per K)
        (fun i=>WilsonPositionProgramReportedField.entire R (ages i) K (N,per) (w o i)) Q θ true
    (∀(o:Active)(s:Faces) b,WilsonCoeffUV.Mer.Auth (WilsonCoeffUV.Wheel.Mark.mass
      (WilsonOlderFreshSoftRoseCourse.grade ∘ seat s) (Finset.univ:Finset s))
      (WilsonOriginalObservedRoseHaarProbe.source R D office.field s N K c (probe o s) (XSpace.Bare.chart G) b)) ∧
    ‖signed R Φ r (b,per) (fun o=>value (row retained o)-value (high o))‖≤(∫y:Points 3,‖Φ y‖)*θ^(target+1) ∧
    ‖signed R Φ r (b,per) (fun o=>value (high o)-value (stopped o))‖≤(∫y:Points 3,‖Φ y‖)*θ^(target+1) ∧
    ‖signed R Φ r (b,per) (fun o=>value (row retained o)-value (stopped o))‖≤(∫y:Points 3,‖Φ y‖)*θ^target:=by
  classical
  obtain ⟨bank,offered⟩:=WilsonOlderFreshSoftSocketStationUnscaledWages.original F Jr Z simple bliss lead obedient slow shop
    cap upper color funded paths T h books delivered x
  refine ⟨bank,?_⟩
  intro target reserve debt
  let due:=∑i,debt i
  let mesh:=WilsonOriginalObservedRosePublicMesh.aperture (WilsonReceivedChronologicalFixedRosePublicAperture.width reserve (2*T+11+2*h))
  obtain ⟨U,pay,old⟩:=offered (target+1) due mesh
  obtain ⟨U',pay',time⟩:=WilsonReceivedChronologicalFixedRosePublicAperture.original F Jr Z simple bliss slow reserve 6 T h grade x books
  have small:(Set.Iio (1:ℝ))∈trail:=mem_nhdsWithin_of_mem_nhds (Iio_mem_nhds zero_lt_one)
  refine ⟨(U∩U')∩Set.Iio 1,inter_mem (inter_mem pay pay') small,?_⟩
  intro due₀ mesh₀ balance₀ power reach credit stopOrder wStop
  have grows: Tendsto wStop atTop atTop :=
    (WilsonOlderFreshSoftSocketStationCalendar.original R simple slow reach (loss R power stopOrder) (by
      unfold WilsonOlderFreshSoftSocketStationPanelPower.loss;positivity)).1
  refine ⟨grows,?_⟩
  intro retained Q affordable extra D fits caps opt tol op tp
  obtain ⟨day,onset,⟨school⟩⟩:=WilsonOriginalObservedRoseProbeShelf.original simple funded D fits Q opt tol op tp
  refine ⟨day,onset,school,?_⟩
  intro width
  let balance:=base bank (due+1)
  let tickets:=WilsonOlderFreshSoftSocketStationMeasuredCanvas.charge caps
  let funds:=(max 1 credit)^3*(2:ℝ)^WilsonOlderFreshSoftSocketStationPanelPower.debt R power
  have cashPos:0≤funds:=mul_nonneg (pow_nonneg (zero_le_one.trans (le_max_left ..)) _) (by positivity)
  obtain ⟨_,gate,faces⟩:=WilsonOlderFreshSoftSocketStationFacePayment.original R simple slow D Q reach power stopOrder (2*width) (by positivity)
  have paid:=old retained affordable Q extra (2*width) D tickets (WilsonOlderFreshSoftSocketStationMeasuredCanvas.positive caps).le
  filter_upwards [paid,time width,eventually_ge_atTop onset,eventually_ge_atTop gate,
    WilsonSeparatedPrefixKineticGeometry.spend R simple (tickets*funds*(4:ℝ)^stopOrder) 0,
    WilsonSeparatedPrefixKineticGeometry.spend R simple 21 0] with v heard calendar entered late payroll cold
  refine ⟨entered,?_⟩
  intro r hr ρ live nearest slots b K N per c req tag bk kn nonbare vb vw vc ck vk reachK span θ Active file panel
    loc stations axes seats names κ pt digits pins test tested w row high office branchTest probe stopped
  have vn:=vc.trans (ck.trans kn)
  have gp:0<θ:=ActualRunKernelPackets.regulator_pos R N per v vn
  have kp:0<g N per K:=ActualRunKernelPackets.regulator_pos R N per K kn
  have cool:21≤θ⁻¹:=by simpa only [pow_zero,mul_one] using cold N per vn
  have one:1≤θ⁻¹:=(by norm_num:(1:ℝ)≤21).trans cool
  have invoice:tickets*funds*(4:ℝ)^stopOrder≤θ⁻¹:=by simpa only [pow_zero,mul_one] using payroll N per vn
  obtain ⟨duration,rents⟩:=calendar r hr.1.2 ρ live nearest (N:=N) (per:=per) vb bk kn span
  have rp:0≤r:=by obtain ⟨i,ih⟩:=nearest;rw [←ih];exact (ρ i).property.1.le
  have room0:=room (R:=R) simple vc (2*width) duration
  have rent (o:Active)(i:Fin 3):(a ((panel o).slot i))/(a K)≤(θ⁻¹)^mesh:=by rw [seats o i];exact rents i
  have allowance (o:Active)(s:Faces):‖touch (test o) s‖≤tickets*(θ⁻¹)^due:=
    WilsonOlderFreshSoftSocketStationMeasuredCanvas.touched (test o) s one caps debt (tested o)
  have basis (o:Active):=
    heard office r hr.1.1 ρ live nearest K N per b c req power tag credit bk kn nonbare bk vc ck vk duration
     file (panel o) (stations o) (axes o) (seats o) (names o) (rent o) κ pt (digits o) (pins o)
     (fun s=>touch (test o) s) (fun s _=>allowance o s)
  have law (o:Active)(s:Faces):
      high o s=(WilsonOriginalObservedRoseProbeRead.quota (branchTest o s):ℂ)*
        WilsonOriginalObservedRoseHaarProbe.priced R D office.field s N K c v (probe o s) (g N per K)
          (fun i=>WilsonPositionProgramReportedField.entire R (ages i) K (N,per) (w o i)) Q θ:=by
    have placed:=WilsonOriginalObservedRoseProbeRead.original R D s κ pt N per K c v (w o) Q θ
      office.field office.draw office.paid simple (RunFormalChain.fromRun R).receipt vc ck kn (digits o) (pins o) (test o) v
    exact placed.trans (congrArg ((WilsonOriginalObservedRoseProbeRead.quota (branchTest o s):ℂ)*·)
      (WilsonOriginalObservedRoseHaarProbe.original R D office.field s N K c v (probe o s) (g N per K)
        (fun i=>WilsonPositionProgramReportedField.entire R (ages i) K (N,per) (w o i)) Q θ office.paid v))
  have unique (o:Active)(s:Faces)(hs:s.Nonempty):
      ‖high o s-stopped o s‖≤WilsonOriginalObservedRoseProbeRead.quota (branchTest o s)*(funds*(g N per K)^stopOrder):=by
    rw [law o s]
    dsimp only [stopped]
    rw [←mul_sub,norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg (WilsonOriginalObservedRoseProbeRead.positive _).le]
    exact mul_le_mul_of_nonneg_left ((faces c (late.trans vc)).2 v late vw day opt tol office N per b K bk kn ck vk
      reachK (by simpa only [Nat.cast_mul,Nat.cast_ofNat] using room0.2) req tag credit (panel o) file (stations o) (axes o) s hs (probe o s) Q le_rfl)
      (WilsonOriginalObservedRoseProbeRead.positive _).le
  let μ:=fun o:Active=>WilsonCenteredCompactBooking.mass R Φ r (b,per) o.val
  let sumAt:=WilsonOlderFreshSoftSocketStationPortfolio.reading μ 1
  let Z₀ :=sumAt (row retained)
  let Z₁ :=sumAt high
  let Z₂ :=sumAt stopped
  let variation:=∫y:Points 3,‖Φ y‖
  have first:‖Z₀-Z₁‖≤variation*θ^(target+1):=by
    apply WilsonOlderFreshSoftSocketStationUnscaledScan.paid R Φ r (b,per) (row retained) high (pow_nonneg gp.le _)
    intro o
    rw [norm_sub_rev]
    simpa only [one_pow,one_mul] using (basis o).2
  have fitted:due+1≤balance:=by dsimp only [balance,WilsonOriginalObservedRosePublicGross.base];omega
  have head (o:Active)(s:Faces)(hs:s.Nonempty):
      (1:ℝ)^(height ages s)*‖high o s‖≤2*(θ⁻¹)^(balance+mesh*height ages s):=
    ((basis o).1 s hs).trans (le_mul_of_one_le_left (pow_nonneg (inv_nonneg.mpr gp.le) _) (by norm_num))
  have last:‖Z₁-Z₂‖≤variation*θ^(target+1):=by
    have entry:=WilsonOlderFreshSoftSocketStationMeasuredCanvas.mesh μ high stopped
      (fun o s=>WilsonOriginalObservedRoseProbeRead.quota (branchTest o s)) caps debt (target+1) balance mesh gp cool kp.le
      (WilsonOlderFreshSoftSocketStationFacePayment.comparison R simple (vc.trans ck) kn) zero_le_one le_rfl cashPos fitted invoice head
      (fun o s _=>WilsonOriginalObservedRoseProbePurse.original s (test o) caps debt (θ⁻¹) one (tested o)) unique
    have paid:=entry.trans (mul_le_mul_of_nonneg_right
      (WilsonOlderFreshSoftSocketStationAbsoluteScan.cap R Φ r (b,per)) (pow_nonneg gp.le _))
    simpa only [Complex.ofReal_one,one_pow] using paid
  have massPos:0≤variation:=MeasureTheory.integral_nonneg fun _=>norm_nonneg _
  have half:2*θ≤1:=(le_div_iff₀ gp).mp (by simpa only [one_div] using (show (2:ℝ)≤θ⁻¹ from (by norm_num:(2:ℝ)≤21).trans cool))
  have total:‖Z₀-Z₂‖≤variation*θ^target:=calc
    _≤‖Z₀-Z₁‖+‖Z₁-Z₂‖:=by rw [show Z₀-Z₂=(Z₀-Z₁)+(Z₁-Z₂) by abel];apply norm_add_le
    _≤variation*θ^(target+1)+variation*θ^(target+1):=add_le_add first last
    _=variation*θ^target*(2*θ):=by rw [pow_succ];ring
    _≤variation*θ^target:=mul_le_of_le_one_right (mul_nonneg massPos (pow_nonneg gp.le _)) half
  refine ⟨fun o s b=>(WilsonOriginalObservedRoseHaarProbe.admitted R D office.field s N K c (probe o s) simple ck kn b).2.2,?_⟩
  simp only [WilsonOlderFreshSoftSocketStationUnscaledScan.expose R Φ r (b,per)]
  exact ⟨first,last,total⟩

end YM.Integration.WilsonOlderFreshSoftSocketStationUnscaledTerminal
