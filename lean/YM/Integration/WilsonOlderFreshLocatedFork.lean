variable {G:Gauge}(R:Run G)(D:Roots (G:=G) R.metals.p.profile R.metals.K R.metals.p.kernel)(Q₀:D.Tab R.rolls)
  {φ:ℕ → ℕ}{k:ℕ}(school:Syl.School k)(query:WilsonOlderFreshGraphAllStages.Query)
  {Dmax:ℕ}(a:hue G)(depth:query.letter.toll<Dmax)
local notation "fams" => (fun j:ℕ=>Flat.routes (R.family.path.levels.clock.op j 0).patch)
local notation "axes" => Letter (R.family.labels.level query.letter.toll)
local notation "widths" => (fun i=>Poetry.Agenda.seed D φ (Burn.horizon k) (R.alloy.B.a.clock.J i))
local notation "Tour" => (∀j,Site (R.family.S.block j))
def Arm (q:ℕ)(ε:ℝ)(m N per:ℕ)(σ:ℕ → ℝ)(digit:Tour)
    (T:WilsonOlderFreshLocatedSplice.Table (m:=m) (N:=N) (d:=query.letter.toll) (D:=Dmax) (Q:=query.order) R σ)
    (Ψ:∀i,Rep G (R.family.side i per)):Prop:=
  ∀A:Unit → Set ℂ,(∀t,‖value A t‖ ≤ 1) →
    ∀sites:∀i,Site (R.family.side i per),
    (∀j,m+1 ≤ j → j<N → sites (j+1)=(R.family.path.levels.clock.op j per).ratio.assemble (sites j,digit j)) →
    ∀(f:Studio Dmax)(_loc:Loc G 1)(x:Wallet A),
    let printed:=fixed R σ T sites (orbit R digit (m+1) f) A x (fun i=>Coat.gStep (Ψ i).beta)
    Full R query.letter.toll fams a depth digit N per (m+1) query.order q Ψ sites printed (fare ε q ‖f‖)

def Paired (q:ℕ)(ε:ℝ):Prop:=
  ∀ᶠ m:ℕ in atTop,∀N,m+1<N →
  ∃(π:ℕ → Layout G)(Γ:ℕ → Pace.Coin)(hk:Burn.horizon k+2 ≤ R.alloy.B.a.clock.J m)
    (lesson:∀i,∀lo:m ≤ i,i<N → Oak.Lesson (N:=N) R hk D Q₀ π Γ lo)
    (Ψ:∀per i,Rep G (R.family.side i per)),
    PlanV.Path D R.alloy Q₀ (Burn.horizon k) N m π Γ ∧
    (∀per,Concourse R.alloy R.kit R.T π Γ m N per k (Ψ per) ∧
      Topline (Ψ per N) (R.family.path.levels.clock.forcedAllowance N) ∧
      ∀i (lo:m ≤ i)(live:i<N),Nonempty (Oak.Calendar (N:=N) R hk D Q₀ π Γ (Ψ per) lo (lesson i lo live)) ∧
        ∃op:Mentor.Opportunity (R.alloy.B.a.clock.J (i+1)) (R.alloy.B.a.clock.J i),op.count=school.pieces ∧ op.stage=school.order+1) ∧
    ∀(first second:Tour)(s:ℕ), (∀i,s ≤ i → i<N → first i=second i) →
      ∃earlier:WilsonOlderFreshLocatedSplice.Table (m:=m) (N:=N) (d:=query.letter.toll) (D:=Dmax) (Q:=query.order) R widths,
        Booked R fams a depth query.order widths m N second earlier ∧
        ∀shared:WilsonOlderFreshLocatedSplice.Table (m:=m) (N:=N) (d:=query.letter.toll) (D:=Dmax) (Q:=query.order) R widths,
          Booked R fams a depth query.order widths m N first shared →
          let joined:=WilsonOlderFreshLocatedSplice.patch R s shared earlier
          Booked R fams a depth query.order widths m N second joined ∧
          ∀per,Arm R query a depth q ε m N per widths first shared (Ψ per) ∧
            Arm R query a depth q ε m N per widths second joined (Ψ per)

theorem original (simple:G.Simple)(slow:WilsonWindowReportingPace.Slow R.kit)
    (scroll:VowsR.LawScroll G φ)(books:Mentor.Offices.Books D R.rolls Q₀ φ)
    (ahead:Mentor.Forecast D R.rolls Q₀ φ books)
    {ZΘ:ℝ}{shape:PhysicalNext.ThroughLaunch.Orders}(house:Treehouse.VariableHouse R D Q₀ scroll books ZΘ ahead shape)
    (within:query.letter.toll ≤ school.horizon)(enrolled:query.order ≤ school.order)
    (q:ℕ){ε:ℝ}(ep:0<ε)(deep:2*((q+4)+4+1)+8 ≤ school.order)
    (aged:(q+4)+4+4 ≤ 3*k+2)(one:0<school.pieces)(awake:1 ≤ Burn.horizon k)(high:ℕ)
    (M₀:WilsonMeasuredRankedMenu.Menu R query.letter.toll)
    (tube:LinkTube G)(programPaid:Covered (program tube) R)
    (strength:∀i,(R.family.path.levels.budget i).supportExponent ≤ 100)(prepared:WilsonReportLampForecast.Ready R.family.path.levels)
    (protection:WilsonPhysicalHistoryPriorAperture.Paid R.rolls D φ R.alloy.delay)
    (enough:3*(2*4+(query.letter.toll+1)+1+(q+3)) ≤ query.order)
    (ledger:WilsonOlderFreshPointHouseRegistry.Ledger R fams a depth query.order (Poetry.Agenda.seed D φ) (1/4))
    {U:ℕ → ℕ}(grant:WilsonWindowFormalPurchase.Canonical U R.kit)
    (v:ℕ → WilsonCoeffUV.Bank.Gear G → ℝ)(funded:FundedMarkedCoverRows.prices v R.kit)(paths:FundedOriginalVacuumPaths.prices R.kit):
    Paired R D Q₀ (φ:=φ) school query a depth q ε:=by
  have load:school.pieces ≤ Burn.horizon k+2:=by obtain ⟨_,_,_,h,_,_⟩:=school;exact h
  have fits:school.order ≤ Burn.horizon k+1:=by obtain ⟨_,_,_,_,h,_⟩:=school;exact h
  let staff:=house.licence
  have sale:=WilsonOlderFreshLocatedIssued.fromDate R simple slow D Q₀ scroll books staff.employed
    house.stamps ahead staff.forecast staff.employed.station.1 staff.monthly staff.employed.ready school
    query high a depth q ep deep aged M₀ tube programPaid strength prepared protection enough enrolled within
    load fits grant v funded paths
  obtain ⟨start,press⟩:=ledger
  have clocks:=WilsonMeasuredPointHouseSeats.original R D Q₀ scroll books ahead house school (by omega)
  filter_upwards [sale,clocks,eventually_ge_atTop start] with m release hosting past
  intro N live
  obtain ⟨π,Γ,hk,lessons,path,phases⟩:=hosting N (by omega)
  choose Ψ state using phases
  refine ⟨π,Γ,hk,lessons,Ψ,path,state,?_⟩
  intro first second s joined
  have stage:k ≤ R.alloy.B.a.clock.J m:=by
    have sub:k ≤ Burn.horizon k+2:=by unfold Burn.horizon;omega
    exact sub.trans hk
  obtain ⟨earlier,registered⟩:=press m past N k second stage awake
  refine ⟨earlier,registered,?_⟩
  intro shared original
  have fused:=WilsonOlderFreshLocatedSplice.original R fams a depth shared earlier joined original registered
  refine ⟨fused,?_⟩
  intro per
  have temp:=state per
  have actual(i:ℕ)(lo:m ≤ i)(stay:i<N):WilsonOlderFreshLocatedCofinal.Seat (N:=N) R D Q₀ school hk π Γ (Ψ per) lo:=by
    have day:=temp.2.2 i lo stay
    let op:=day.2.choose
    obtain ⟨card,degree⟩:=day.2.choose_spec
    exact ⟨op,lessons i lo stay,day.1.some,card.symm ▸ one,card,degree.ge⟩
  constructor
  · intro A bound sites located f loc x
    exact release N first stage awake shared original per hk π Γ (Ψ per) temp.1 temp.2.1 actual path A bound sites located f loc x live
  · intro A bound sites located f loc x
    exact release N second stage awake _ fused per hk π Γ (Ψ per) temp.1 temp.2.1 actual path A bound sites located f loc x live

end YM.Integration.WilsonOlderFreshLocatedFork
