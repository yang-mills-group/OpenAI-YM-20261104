variable {G:Gauge} {ι:Type} [Fintype ι] [DecidableEq ι]
/-- The planted old relative positions and the selected fresh sites share the same ray exactly at the second contraction. -/
theorem original (G:Gauge)(D k:ι → ℕ)(I:Finset ι)(alive:I.Nonempty)(E e r:ℕ)(he:e ≤ E):
    ∃v:Gear G → ℝ,∃d:ℕ,∀(Q:Realm G (E+1) Credit.leanC) m N (hq:Q.anchor ≤ m)
      (_hn:m+1<N)(_low:v (Q.mint m hq).gear ≤ Q.cash Credit.leanC m)
      (_up:v (Q.mint (m+1) (by omega)).gear ≤ Q.cash Credit.leanC (m+1))
      (_k₀:Q.draws.clock.J (m+1) ≤ (Q.draws.S.block m).val)
      (_k₁:Q.draws.clock.J (m+2) ≤ (Q.draws.S.block (m+1)).val)
      (rise:5 ≤ Q.draws.clock.J (m+2))
      (_stop:(Q.mint (m+1) (by omega)).σ=crestM Q.draws (m+1) rise),
    ∀ (n:Side) (T:Finset ι)(α β:family G D),Eu k α → α ∅=0 → Eu k β →
    ∀ y:ι → Cover,∀ z:ι → Site (ll Q.draws m).L,∀ w:ι → Site (ll Q.draws (m+1)).L,
    let g:=chartIn (ll Q.draws m) y z
    let K:=mounted T (logO Q.draws Q.paid (m+1) N α k) β
    ∀A₀ A₁:ℝ,0≤A₀ → 0≤A₁ →
    safeB (chartIn (ll Q.draws (m+1)) g w) α I E
      ((windowBasis G Q.draws.clock.kernel).width (Q.draws.clock.J (m+2))) A₀ →
    safeB g β I E (strip (Q.mint m hq).gear) A₁ → 4*crestCard y I<n.val →
    let rent:=(Q.y (m+1))^(WilsonPointChildMixedSalary.bill G D k E)*A₀+A₁
    ∀x,‖Carp.plume ((logO Q.draws Q.paid m N K k I).2 e r) n x-
      coilH Q.draws Q.paid m N n K k (ratioHigh Q.draws Q.paid N m) I e r x‖ ≤
      (Q.y m)^d*rent^I.card*Real.exp (-(n.val:ℝ)/(512*Q.y m)):=by
  obtain ⟨p,σ,d,as,seam⟩:=WilsonPointChildReceivedGazette.fresh G D k I alive E e r he
  let v(H:Gear G):=max (p H) (WilsonPointChildMixedQuote.fare G D k E H)
  refine ⟨v,d,?_⟩
  intro Q m N hq hn low up k₀ k₁ rise stop n T α β eu empty eu₂ y z w g K A₀ A₁ pos pos' a b fits rent x
  let old:=logO Q.draws Q.paid (m+1) N α k
  have fee:WilsonPointChildMixedQuote.fare G D k E (Q.mint (m+1) (by omega)).gear ≤ Q.cash Credit.leanC (m+1):=
    (le_max_right ..).trans up
  have o:=WilsonPointChildMixedSalary.prior Q hq hn k₀ k₁ rise stop fee α eu empty g w A₀ pos a
  have y₁:0≤Q.y (m+1):=zero_le_one.trans (Q.depth _ (by omega))
  have price:=WilsonPointChildMixedSalary.combine g T old β
    (mul_nonneg (pow_nonneg y₁ _) pos) pos' o b
  have auth:Eu k old:=fun J=>step_L Q.draws Q.paid (m+1) N α k hn Q.hG Q.green eu J
  have zero:old ∅=0:=logHush ..
  obtain ⟨valid,quiet⟩:=legal T auth eu₂ zero
  have ppay:p (Q.mint m hq).gear ≤ Q.cash Credit.leanC m:=(le_max_left ..).trans low
  have nonneg:0≤rent:=add_nonneg (mul_nonneg (pow_nonneg y₁ _) pos) pos'
  have mark:=seam Q m N hq ppay (by omega) n K valid quiet y z rent nonneg price fits
  have sp:= (as (Q.mint m hq).gear).1
  exact (mark.2 x).trans (mul_le_of_le_one_right mark.1 (Real.exp_le_one_iff.mpr (by
    apply mul_nonpos_of_nonpos_of_nonneg _ (Nat.cast_nonneg _)
    linarith)))
end YM.Integration.WilsonPointChildReceivedSeam
