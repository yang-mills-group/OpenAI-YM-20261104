/-- Both scalars use the original filed material, its true physical coupling and the enrolled fixed-child
    action. The product restores each recorded absolute branch fare once. -/
theorem original {c:ℕ}(before:j+1≤c)(cut:c≤K)(kn:K≤N)(cold:gc≤1)
    (p:ℕ)(order:p≤q₀)(S:Finset (Fin n)):
    ‖(W₀:ℂ)⁻¹*(raw 1).part (seat S)-
      whole (R:=R) (N:=N) (K:=K) (c:=c) (j:=j) (draw:=draw) κ pt digits seed z test
        (fun v=>(wallet v).val) (gc) p S‖ ≤
      (gc)^(p+1)*∏i:Multi.Hot (Stock.census (Fin n)),(1+wage (R:=R) (D:=roots₀) (passport:=pass₀)
        (B:=B₀) (grades:=grades) (q:=q₀) reg.matter wallet i):=by
  obtain ⟨op,_,_,paid⟩:=reg.paid
  have posted:=paid 1 zero_lt_one
  obtain ⟨_,_,_,_,terminal⟩:=WilsonOriginalTwoFlatIRFlatPosted.original R day.hk (roots₀) (tab₀)
    day.π day.Γ (day.Ψ per) (day.seen per).1 house.books ready live op (day.lessons j ready live)
    house.ahead (pass₀) (B₀) grades (ask₀).order (ask₀).shelf (q₀) w reg.matter 1 posted wallet
  have small:=WilsonOriginalTwoFlatIRFlatPaidParts.original R (roots₀) (pass₀) (B₀) grades (q₀)
    reg.matter wallet (gc) (ActualRunKernelPackets.regulator_pos R N per (j+1) (by omega)).le cold p (seat S)
  have actual:=WilsonOriginalTwoFlatIRFlatActive.original κ pt digits seed z test reg.matter simple before cut kn reg.filed
    (fun v=>(wallet v).val) (gc) p order S
  have source:=congrArg (fun f:Config G (R.family.side (j+1) per) → Marker.Poly (Stock.census (Fin n)) => (f 1).part (seat S)) reg.source
  change (raw 1).part (seat S)=_ at source
  rw [source,terminal (seat S),←actual]
  exact small

end YM.Integration.WilsonOriginalTwoFlatIRRegisteredTerminal
