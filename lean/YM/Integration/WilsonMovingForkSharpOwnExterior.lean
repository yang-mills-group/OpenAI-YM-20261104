theorem original (H:Hol G)(Q:SealR G)(e:ℕ):
    ∃P₁ P₂:Credit,∀{D k u a n:ℕ}{F:Labels.Frame G 4}{T:SectionData F}{p:4<D}{v:Rails 4 k (u+a) e}
      (Y:CutsP H T p v C C C C)(m:ℕ)(arms:Fin (n+1)→SealR G)(α:Wilt arms)(X:Herit arms)
      (C₀ C₁ C₂ first shape chron middle ledger pay thermal U₁ U₂ fund folds:Credit)
      (φ:Rarity D)(ψ χ:Rarity Q.D)(hφ:ContDiff ℝ ∞ φ.ψ.val)(hψ:ContDiff ℝ ∞ ψ.ψ.val)(hχ:ContDiff ℝ ∞ χ.ψ.val),
      AheadT H Y.vesselsC C C Q C →
      Issued Y m arms Q α X C₀ C₁ C₂ first shape chron middle ledger pay thermal U₁ U₂ fund folds φ ψ χ hφ hψ hχ →
      Y.ceilC=m → Y.m ≤ m → m ≤ Y.N → ∀older:ℕ,Y.vesselsC.anchor ≤ older → older ≤ Y.m →
      ∀(j:Alma Q.F)(r nearGap farGap DF:ℝ)(B:Fin (n+1)→ℝ),
      Clear Y.vesselsC arms Q α ψ older Y.m Y.ceilC m r nearGap farGap DF B →
      ∀(y gap out A L bound:ℝ)(o:CellR)(w:Fin 0→YForest G),Amplitude φ A → ClearDay φ χ gap → 0<gap →
      φ.radius+|y|+1 ≤ out → χ.radius+|y|+1 ≤ out → 1 ≤ L → L/paceT Y.ax.S m Y.m ≤ bound →
      let T':=paceT Y.ax.S m Y.m
      let ρ:=L/T'
      let Z:=PermuteLens Y.ax Y.tx Q Y.N Y.m (brought Y.ax Y.tx Q Y.N Y.m m (axis Q j))
      let B₀:=((Fintype.card (Alma Q.F):ℝ)^2*(e+1))*T'^Q.h*
        P₁.buy (Compar Y.ax.S Y.vesselsC.y Y.m m)*P₂.buy (Y.vesselsC.y m)
      let price:=amount Y m arms Q X C₀ C₁ C₂ first shape chron middle ledger pay thermal U₁ U₂ fund folds 0
        φ χ hφ hχ (transformed ψ hψ) older r nearGap farGap DF B y gap out A L bound
      let scalar:=fun q=>ρ^4*raw Y.vesselsC arms Q α ψ X Z φ y o Y.m m Y.ceilC older Y.N q 0 w
      price Z=fee Q e Z*price (axis Q j) ∧ (∀q ≤ e,‖scalar q‖ ≤ B₀* |price (axis Q j)|) ∧
        ∀(J:ℕ)(g:ℝ),|g| ≤ 1 → ‖∑q∈Finset.Ioc J e,g^q*scalar q‖ ≤ ((Finset.Ioc J e).card:ℝ)*|g|^(J+1)*(B₀* |price (axis Q j)|):=by
  obtain ⟨P₁,P₂,booking⟩:=WilsonIndependentMatchedOwnHomeAxisWage.original H Q e C C C C
  refine ⟨P₁,P₂,?_⟩
  intro D k u a n F T p v Y m arms α X C₀ C₁ C₂ first shape chron middle ledger pay thermal U₁ U₂ fund folds
    φ ψ χ hφ hψ hχ teacher earned born interval cut older live hear j r nearGap farGap DF B legal y gap out A L bound o w
    asm sep pos nr fr lr bracket T' ρ Z B₀ price scalar
  have feePaid:fee Q e Z ≤ B₀:=booking Y.vesselsC teacher Y.m m Y.N Y.ha interval cut j
  have hom:price Z=fee Q e Z*price (axis Q j):=WilsonMovingForkSharpExteriorRoof.original Y m arms Q X C₀ C₁ C₂ first shape chron middle ledger pay thermal U₁ U₂ fund folds
    0 φ χ hφ hχ (transformed ψ hψ) older r nearGap farGap DF B y gap out A L bound Z j
  have within:price Z ≤ B₀* |price (axis Q j)|:=by
    rw [hom]
    exact (mul_le_mul_of_nonneg_left (le_abs_self _) (nonnegative Q e Z)).trans
      (mul_le_mul_of_nonneg_right feePaid (abs_nonneg _))
  have full:=earned born older live hear Z r nearGap farGap DF B legal y gap out A L bound o w asm sep pos nr fr lr bracket
  refine ⟨hom,fun q hq=>(full.1 q hq).trans within,?_⟩
  intro J g small
  exact (full.2 J g small).trans (mul_le_mul_of_nonneg_left within (by positivity))
end YM.Integration.WilsonMovingForkSharpOwnExterior
