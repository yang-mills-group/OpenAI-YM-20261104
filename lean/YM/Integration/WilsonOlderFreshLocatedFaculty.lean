variable {G:Gauge}
local notation "families" R:max => (fun i:ℕ=>Flat.routes ((R:Run G).family.path.levels.clock.op i 0).patch)
local notation "M" => WilsonOlderFreshGraphAllStages.menu G
local notation "H" h:max R:max => WilsonOlderFreshGraphSchool.roots M h (R:Run G).metals.p (R:Run G).metals.K
local notation "tab" h:max R:max => WilsonOlderFreshGraphSchool.rollTab M h (R:Run G).metals (R:Run G).rolls

def Elected (R:Run G)(h:G.Simple){φ:ℕ  →  ℕ}(scroll:VowsR.LawScroll G φ)(a:hue G):Prop:=
  let D:=H h R
  let Q₀:=tab h R
  ∃(books:Mentor.Offices.Books D R.rolls Q₀ φ)(ahead:Mentor.Forecast D R.rolls Q₀ φ books),
    Treehouse.VariableHouse R D Q₀ scroll books R.family.path.levels.clock.kernel.penalty ahead (stages R.metals.p) ∧
    ∀(n:ℕ)(queries:Fin n  →  WilsonOlderFreshGraphAllStages.Query)(dmax:Fin n  →  ℕ)
      (depth:∀v,(queries v).letter.toll<dmax v),Loc G 1  → 
      ∀{k:ℕ}(school:Syl.School k)(q:ℕ)(ε:ℝ),0<ε →
        2*((q+4)+4+1)+8 ≤ school.order → (q+4)+4+4 ≤ 3*k+2 → 0<school.pieces → 1 ≤ Burn.horizon k →
        (∀v,(queries v).letter.toll ≤ school.horizon) → (∀v,(queries v).order ≤ school.order) →
        (∀v,3*(2*4+((queries v).letter.toll+1)+1+(q+3)) ≤ (queries v).order) →
        WilsonOlderFreshLocatedSharedRoom.Filed R D Q₀ (φ:=φ) queries dmax depth a school q ε

theorem original (R:Run G)(simple:G.Simple)(a:hue G){φ U:ℕ  →  ℕ}
    (scroll:VowsR.LawScroll G φ)(split:MintClock.splits   ≤   φ)(base:supply simple scroll split U R.kit)
    (strong:WilsonNeutralPointForecast.Filed R.kit)(weak:WilsonNeutralPointWeakForecast.Filed R.kit)
    (slow:WilsonWindowReportingPace.Slow R.kit)(prepared:WilsonReportLampForecast.Ready R.family.path.levels)
    {T:Campaign R}(W:Campaign.Pillars R T){τ:ℝ}(proper:FundedOriginalProperties.{u} simple τ W)
    (tube:LinkTube G)(covered:Covered (program tube) R)(v:ℕ   →   WilsonCoeffUV.Bank.Gear G   →   ℝ)
    (source:FundedMarkedCoverRows.prices v R.kit)(paths:FundedOriginalVacuumPaths.prices R.kit):
    Elected R simple scroll a:=by
  obtain ⟨books,ahead,house,_,ledger⟩:=WilsonOlderFreshPointHouseRegistry.original R (families R) a simple scroll split base strong weak slow.2
  obtain ⟨⟨_,court⟩,_⟩:=WilsonOlderFreshGraphSchool.on_run M simple
    (WilsonOlderFreshGraphMatrixPrice.jointLaw (course scroll split)) R base.1.1
  have aperture:WilsonPhysicalHistoryPriorAperture.Paid R.rolls (H simple R) φ R.alloy.delay:=court.obligation.2
  refine ⟨books,ahead,house,?_⟩
  intro n queries dmax depth loc k school q ε ep deep aged one awake degrees orders enough
  have budgets(w:Fin n):=WilsonMeasuredRankedMenu.original R (queries w).letter.toll simple W proper slow prepared
  exact WilsonOlderFreshLocatedSharedRoom.original R (H simple R) (tab simple R) queries dmax depth a school simple
    slow scroll books ahead house degrees orders q ep deep aged one awake (q+8)
    (fun w=>(budgets w).some) tube covered (fun i=>(proper.2.1.paid.fixed i).le) prepared aperture
    enough (fun w=>ledger (queries w) (dmax w) (depth w) loc (1/4) (by norm_num)) base.1.2 v source paths

