structure Badge (R:Run G)(D:Fin 3→ℕ)(e v start:ℕ)(opt tol:ℝ) where
  field:Realm G (e+1) Credit.leanC
  draw:field.draws=R.family.path.levels
  paid:field.paid=R.metals.O
  quiet:field.y=zz R.family.path.levels
  date:field.anchor=v
  proper:∀s:Faces,Dormitory field (WilsonCoeffUV.Wheel.Mark.mass (ages ∘ seat s) univ) 0 Credit.leanC
  covered:Covered R D e v start field draw opt tol
  bought:∀s:Faces,s.Nonempty → Stock R D e v start field draw opt tol s

theorem original (simple:G.Simple)(paid:WilsonOriginalAllOrderCourse.Paid.{u} axis simple ε (prepared schedule) R crop W)
    (D:Fin 3→ℕ)(fit:∀i,ages i<D i)(e:ℕ)(opt tol:ℝ)(op:0≤opt)(tp:0<tol):
    ∃start onset:ℕ,Nonempty ((v:ℕ)→ onset≤v→Badge R D e v start opt tol):=by
  obtain ⟨start,school⟩:=WilsonOlderFreshSoftSocketFigureRoom.original R paid D fit e opt tol op tp
  obtain ⟨onset,issued⟩:=eventually_atTop.1 school
  refine ⟨start,onset,⟨fun v live=>Classical.choice ?_⟩⟩
  obtain ⟨field,draw,ink,quiet,date,proper,covered,bought⟩:=issued v live
  exact ⟨⟨field,draw,ink,quiet,date,proper,covered,bought⟩⟩

