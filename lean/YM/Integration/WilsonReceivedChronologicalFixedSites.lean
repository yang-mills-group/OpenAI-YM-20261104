variable {G:Gauge}{n:ℕ}(R:Run G)

theorem original (φ:Test n):∃scale:ℝ,∃positive:0<scale,∀r:ℝ,0<r → scale*r≤R.family.S.a 0 →
    let capture:=WilsonCloseCaptureDate.level R.family.S (scale*r)
    ∀(m f K per:ℕ),m+1≤capture → capture≤f → ∀fine:f≤K,8*R.family.S.a f<R.family.S.a capture →
    ∀z:Sites R (f,per) n,WilsonCenteredCompactBooking.mass R φ r (f,per) z≠0 →
    WilsonCenteredCompactBooking.mass R (dilate (inv_pos.mpr positive) φ) (scale*r) (f,per) z=
      WilsonCenteredCompactBooking.mass R φ r (f,per) z ∧
    ∀(q:ℕ)(V:Realm G (q+1) Credit.leanC)(draw:V.draws=R.family.path.levels)
      (j b:ℕ),m≤j → b≤capture → ∀past:b≤j+1,j+2≤K →
    let actual:=placed R fine z
    let tape:=onLevels draw.symm (digits R actual)
    let y:=homes tape 0 m (j-m)
    let high:=chartIn (loose R.family.path.levels (j+1)) y ((onLevels draw tape) (j+1))
    let port₀:=port (R.family.side (j+2) per) high
    let home:=(port₀.coarser (R.family.path.levels.clock.op (j+1) per).ratio).origin
    (∀v:Fin n,sites R home past v∈({0}:Support (R.family.side b per))) ∧
      ∀B:ℕ,0<B → coverNumber B ({0}:Support (R.family.side b per))≤1:=by
  obtain ⟨scale,positive,within⟩:=WilsonReceivedChronologicalMaterialApertures.original R φ
  refine ⟨scale,positive,?_⟩
  intro r rp small capture m f K per earlier born fine narrow z occurrence
  obtain ⟨mass,ground,allHomes⟩:=within r rp small m f K per earlier born fine narrow z occurrence
  refine ⟨mass,?_⟩
  intro q V draw j b active before past live actual tape y high port₀ home
  have fit:m+1≤K:=by omega
  obtain ⟨a,rfl⟩:=Nat.exists_eq_add_of_le active
  have planned:port₀=port _ (homes tape (footprint R actual fit) m (a+1)):=by
    rw [ground]
    change port _ (chartIn (loose R.family.path.levels (m+a+1)) (homes tape 0 m (m+a-m))
      ((onLevels draw tape) (m+a+1)))=port _ (homes tape 0 m (a+1))
    apply congrArg (port _)
    have leAge:m ≤ m+a:=by omega
    simpa only [show m+a+1-m=a+1 by omega] using
      (WilsonReceivedChronologicalMaterialStream.next (V:=V) (draw:=draw) tape (0 : Fin n → Cover) leAge).symm
  constructor
  · intro v
    have residents:=WilsonReceivedChronologicalMaterialSites.resident R draw actual fit a b live past port₀ planned univ {0}
      (fun i _=>Finset.mem_singleton.mpr (allHomes b before i))
    exact residents v (mem_univ v)
  · intro B width
    exact (Corona.cover_mono (Lattice.halo_subset 0 ({0}:Support (R.family.side b per))) B).trans
      (show coverNumber B (halo 0 {0}:Support (R.family.side b per))≤1 from by simpa using Corona.tile (0:Site _) 0 B width)
end YM.Integration.WilsonReceivedChronologicalFixedSites
