/-- Original dated posts and tests for one basis word. The upper and lower
material are the sources, including the equality to the actual carried word. -/
structure Mounted (R:Run G)(κ:(v:Fin n)→Knob (D v))(pt:Fin n→Chamber)(N per i K q:ℕ)(k:Fin n→ℕ)
    (y:Fin n → Cover)(cells:Digits R.family.path.levels (Fin n))(seed:(v:Fin n)→Choice R k v) where
  lowerWidth : ℝ
  lower : Material R N i q k lowerWidth (binder (coarse R i per) y)
  chart : lower.tests=D
  knob : (v:Fin n)→Knob (lower.tests v)
  correct : HEq knob κ
  film : Case lower.tests
  atSites : Addressed y lower film
  real : Realm G (q+1) Credit.leanC
  late : real.anchor ≤ i+1
  allowance : ℝ
  breadth : ℝ
  funded : Paid R real late lower.tests k allowance breadth
  amount : ℝ
  input : Input real late univ k lower.tests amount
  nonneg : 0≤amount
  cutoff : i+1<N
  positive : 0<breadth
  depth : ∀s:labels,0 < mass k s.val.val
  filed : Cloze lower.tests k real Credit.leanC
  stores : Insure n (mass k univ) real Credit.leanC
  carried : ∀z s,output input s N z=fixed R k knob pt N K (i+1) cells seed z s
  sheet : Passport (fine R i per) (Fin n)
  Kind : Type
  high : Kind → Row sheet (Stock.census (Fin n)) G (Affinity.Wallet (room (Fin n)))
  placed : sheet=port (fine R i per) (chartIn (loose R.family.path.levels i) y (cells i))
  names : Kind=((s:labels)×(words (WilsonReceivedDepositedOrbitalLedger.book R real late funded N input nonneg
    cutoff positive (binder (fine R i per) (chartIn (loose R.family.path.levels i) y (cells i))) pin
    (fun _=>subset_univ _) (fun s=>s.property.choose_spec) depth (chartIn (loose R.family.path.levels i) y (cells i))
    film filed stores) s).Roster)
  mounted : HEq high (mounts (WilsonReceivedDepositedOrbitalLedger.book R real late funded N input nonneg cutoff positive
    (binder (fine R i per) (chartIn (loose R.family.path.levels i) y (cells i))) pin
    (fun _=>subset_univ _) (fun s=>s.property.choose_spec) depth (chartIn (loose R.family.path.levels i) y (cells i))
    film filed stores))
  rent : Fin n→ℝ
  paid : ∀v,0<rent v
  order : ℕ
  seats : ℕ
  shelf : ℕ
  shows : q≤order
  occupied : 1 ≤ seats
  slots : n ≤ seats
  fits : (∑v,k v) ≤ shelf

variable {R:Run G}{κ:(v:Fin n)→Knob (D v)}{pt:Fin n→Chamber}{y:Fin n → Cover}
  {cells:Digits R.family.path.levels (Fin n)}{seed:(v:Fin n)→Choice R k v}

def upper (H:Mounted R κ pt N per i K q k y cells seed)(x:Wallet (room (Fin n)))
    (tags:(u:Covers R.family.path.levels.S i (coarse R i per))→(step R i u.val).Choices)
    (e r d:ℕ)(π:ℕ→Layout G)(Γ:ℕ→Pace.Coin)(start:Γ i 0=0)(s:labels)
    (v:Stationary.Link G (coarse R i per)):ℂ:=
  limUnder (coverFilter R.family.path.levels.S i (coarse R i per)) fun u=>
    page R N i per (show i<N by have:=H.cutoff;omega) H.high k x (π (i+1)) (Γ i) start e r d s.val v u (tags u)

def lower (H:Mounted R κ pt N per i K q k y cells seed)(x:Wallet (room (Fin n)))(d:ℕ)(s:labels)
    (v:Stationary.Link G (coarse R i per)):ℂ:=
  sideValue H.lower H.knob pt K cells seed x true s.val d (coordinates G (coarse R i per) v)

def legs (R:Run G)(i per:ℕ)(y:Fin n → Cover)(cells:Digits R.family.path.levels (Fin n)):=
  binder (fine R i per) (chartIn (loose R.family.path.levels i) y (cells i))

theorem shrink {T:Fin n→ℝ}{ε:ℝ}{d d' kmax:ℕ}(cheap:d≤d')
    (pre:@opening G n D (labels) _ (Classical.decEq _) R κ pt k T i K q per kmax d' ε):
    @opening G n D (labels) _ (Classical.decEq _) R κ pt k T i K q per kmax d ε:=by
  intro shape J o grade r N top letter cells sites t priced grid multiple digit pos h
  exact pre shape J o grade r N top letter cells sites t priced grid multiple digit pos (h.trans cheap)

theorem reindexed {D':Fin n→ℕ}{κ':(v:Fin n)→Knob (D' v)}{T:Fin n→ℝ}{ε:ℝ}{a b:ℕ}(chart:D'=D)(eqn:HEq κ' κ)
    (pre:@opening G n D (labels) _ (Classical.decEq _) R κ pt k T i K q per a b ε):
    @opening G n D' (labels) _ (Classical.decEq _) R κ' pt k T i K q per a b ε:=by
  subst D';rw [eq_of_heq eqn];exact pre

theorem heard (bank:Income (k:=k) R κ pt q i)(H:Mounted R κ pt N per i K q k y cells seed)(x:Wallet (room (Fin n)))
    (tags:(u:Covers R.family.path.levels.S i (coarse R i per))→(step R i u.val).Choices)
    (top:K≤N)(finer:i<K){start e:ℕ}{Z:ℕ→SeriesA G}{π:ℕ→Layout G}{Γ:ℕ→Pace.Coin}
    (legal:Legal (Step.tape (e+2)) (π (i+1)))(course:Read R N start e Z π Γ)(live:start ≤ i)
    {τ cash:ℝ}(ordinary:Issued R N (i+1) e (Z (i+1)) τ cash)(starts:Γ i 0=0)(simple:G.Simple)
    (s:labels)(r d:ℕ)(through:r≤q)(grade:r≤e+2)(kept:d≤r)(choose:∀u:Finset (labels),u.Nonempty→u)
    (v:Stationary.Link G (coarse R i per))(unit:‖v‖≤1)(T:Fin n→ℝ)(fee:∀a,‖H.film a‖≤T a)
    (diameter:ℕ)(survey:2*((univ:Finset (Fin n)).image y).sup radius≤diameter)(δ:ℝ)(pos:0≤δ)
    (pre:@opening G n D (labels) _ (Classical.decEq _) R κ pt k T i K q per
      (Fintype.card (labels)*mass k univ+q) diameter δ):
    ‖upper H x tags e r d π Γ starts s v-lower H x d s v‖≤
      (∑S:Finset (labels),‖wages (legs R i per y cells) x s.val S‖)*((Fintype.card (labels)*mass k univ+q+1:ℕ)*δ):=by
  let recorded:=WilsonReceivedDepositedOrbitalLedger.book R H.real H.late H.funded N H.input H.nonneg H.cutoff H.positive
    (legs R i per y cells) pin (fun _=>subset_univ _) (fun s=>s.property.choose_spec) H.depth
    (chartIn (loose R.family.path.levels i) y (cells i)) H.film H.filed H.stores
  exact (WilsonOriginalCensusMaterialPeriod.original R N per y H.lower H.film H.knob pt K cells seed H.real H.late
    H.funded H.input H.nonneg H.cutoff H.positive H.depth H.filed H.stores H.atSites x tags
    (WilsonOriginalCensusFixedBank.transferred R κ pt H.chart H.knob H.correct bank) finer top
    H.carried recorded rfl H.high H.placed H.names H.mounted H.rent H.paid H.shows H.occupied H.slots H.fits legal
    course live ordinary starts simple s r d through grade kept choose v unit T fee δ pos
    (reindexed H.chart H.correct (shrink survey pre))).2

end YM.Integration.WilsonIndependentCollarMaterialHearing
