def amount (C:Fin 3→ℝ)(B:ℝ):ℝ:=1+|B| +total R C

def cost (C:Fin 3→ℝ)(B:ℝ):ℝ:=
  let A:=amount R C B
  total R C*(7*(A+2*A^2))

def center (N per:ℕ)(r:ℝ)(φ:YM.Test 3)(F Q:Sites N per×Sites N per→Faces→ℂ):ℂ:=
  ∑y:Sites N per×Sites N per,WilsonThermometerAlignedCells.mass (R:=R) r (N,per) φ y*(value (F y)-value (Q y))

theorem node (F Q:Faces→ℂ)(C:Fin 3→ℝ)(B g:ℝ)(g0:0<g)(g1:g ≤ 1)(q H:ℕ)
    (cuts:∀s,‖F s-Q s‖ ≤ ticket R s C*g^(q+2*H))(gross:∀s:Faces,s.Nonempty→‖Q s‖ ≤ B*g⁻¹^H):
    ‖value F-value Q‖ ≤ cost R C B*g^q:=by
  let X:=g⁻¹^H
  let A:=amount R C B
  let fee:=total R C
  have unit:1 ≤ X:=one_le_pow₀ ((one_le_inv₀ g0).mpr g1)
  have X0:0 ≤ X:=zero_le_one.trans unit
  have fee0:0 ≤ fee:=sum_nonneg fun _ _=>abs_nonneg _
  have A1:1 ≤ A:=by change 1 ≤ 1+|B| +fee;linarith [abs_nonneg B]
  have A0:0 ≤ A:=zero_le_one.trans A1
  have AX:1 ≤ A*X:=A1.trans (le_mul_of_one_le_right A0 unit)
  have maxed:max 1 (max (A*X) (A*X))=A*X:=by rw [max_self,max_eq_right AX]
  have single(t:Faces)(visible:t.Nonempty):‖Q t‖ ≤ A*X:=by
    exact (gross t visible).trans <| mul_le_mul_of_nonneg_right
      (show B ≤ A by change B ≤ 1+|B| +fee;linarith [le_abs_self B]) X0
  have priced(t:Faces):ticket R t C ≤ fee:=(le_abs_self _).trans (single_le_sum (f:=fun u:Faces=>|ticket R u C|)
    (fun u _=>abs_nonneg _) (mem_univ t))
  have bound(t:Faces)(visible:t.Nonempty):‖F t‖ ≤ A*X:=by
    have atOne:‖F t-Q t‖ ≤ fee:= (cuts t).trans <| (mul_le_mul_of_nonneg_right (priced t) (pow_nonneg g0.le _)).trans
      (mul_le_of_le_one_right fee0 (pow_le_one₀ g0.le g1))
    calc ‖F t‖=‖(F t-Q t)+Q t‖:=by rw [sub_add_cancel]
         _ ≤ ‖F t-Q t‖+‖Q t‖:=norm_add_le .. 
         _ ≤ fee+B*X:=add_le_add atOne (gross t visible)
         _ ≤ A*X:=by
           have h:=mul_le_mul_of_nonneg_right (le_abs_self B) X0
           have hx:=le_mul_of_one_le_right fee0 unit
           change _ ≤ (1+|B| +fee)*X
           linarith
  have billed:∑s:Faces,‖bill F Q s‖ ≤ 7*(A+2*A^2)*X^2:=by
    have totalBill:=WilsonMaxwellThermometerNominatedSecant.budget F Q (A*X) (A*X)
      (fun t visible _=>bound t visible) (fun i=>single {i} (singleton_nonempty _))
    change _ ≤ 7*(max 1 (max (A*X) (A*X))+2*(max 1 (max (A*X) (A*X)))^2) at totalBill
    rw [maxed] at totalBill
    apply totalBill.trans
    have sq:X ≤ X^2:=by rw [pow_two];exact le_mul_of_one_le_right X0 unit
    have h:=mul_le_mul_of_nonneg_left sq A0
    nlinarith only [h]
  rw [WilsonMaxwellThermometerNominatedSecant.signed F Q]
  calc _ ≤ ∑s:Faces,‖bill F Q s*(F s-Q s)‖:=norm_sum_le ..
       _ ≤ ∑s:Faces,‖bill F Q s‖*(fee*g^(q+2*H)):=by
         apply sum_le_sum;intro s _
         rw [norm_mul]
         exact mul_le_mul_of_nonneg_left ((cuts s).trans (mul_le_mul_of_nonneg_right (priced s) (pow_nonneg g0.le _))) (norm_nonneg _)
       _ ≤ (7*(A+2*A^2)*X^2)*(fee*g^(q+2*H)):=by rw [←sum_mul];exact mul_le_mul_of_nonneg_right billed (by positivity)
       _=_:=by
         change _=(fee*(7*(A+2*A^2)))*g^q
         dsimp only [X]
         rw [pow_add,Nat.mul_comm 2 H,pow_mul,inv_pow]
         field_simp [g0.ne']

theorem heard (N per:ℕ)(r:ℝ)(φ:YM.Test 3)(F Q:Sites N per×Sites N per→Faces→ℂ)(C:Fin 3→ℝ)(B g:ℝ)
    (g0:0<g)(g1:g ≤ 1)(q H:ℕ)(cuts:∀y s,‖F y s-Q y s‖ ≤ ticket R s C*g^(q+2*H))
    (gross:∀y s,s.Nonempty→‖Q y s‖ ≤ B*g⁻¹^H):
    ‖center R N per r φ F Q‖ ≤ (∫z:Points 3,‖φ z‖)*cost R C B*g^q:=by
  let μ:=WilsonThermometerAlignedCells.mass (R:=R) r (N,per) φ
  have bill0:0 ≤ cost R C B*g^q:=by
    let A:=amount R C B
    have f0:0 ≤ total R C:=sum_nonneg fun _ _=>abs_nonneg _
    have A0:0 ≤ A:=by change 0 ≤ 1+|B| +total R C;linarith [abs_nonneg B]
    change 0 ≤ total R C*(7*(A+2*A^2))*g^q
    positivity
  calc _ ≤ ∑y:Sites N per×Sites N per,‖μ y*(value (F y)-value (Q y))‖:=norm_sum_le ..
       _ ≤ ∑y:Sites N per×Sites N per,‖μ y‖*(cost R C B*g^q):=by
         apply sum_le_sum;intro y _
         rw [norm_mul]
         exact mul_le_mul_of_nonneg_left (node R (F y) (Q y) C B g g0 g1 q H (cuts y) (gross y)) (norm_nonneg _)
       _ ≤ _:=by
         rw [←sum_mul,mul_assoc]
         exact mul_le_mul_of_nonneg_right (WilsonThermometerAlignedCells.variation (R:=R) r (N,per) φ) bill0

def Settled (D:Fin 3→ℕ)(p q order width:ℕ)(ξ η δ:ℝ)(m C:Fin 3→ℝ)(A₀:Group R.family 6)(r:ℝ)
    (M:Fin 3→ℝ)(reg:Indexed R grade (fun _=>A₀.station.k) order η M (filed R A₀))
    (v N per K c w:ℕ)(V:Realm G (p+1) Credit.leanC)(draw:V.draws=R.family.path.levels)
    (kK:A₀.station.k ≤ K)(ck:c ≤ K)(live:K<N):Prop:=
  ∀(tests:Sites N per×Sites N per→(t:Faces)→TestAt D t)(φ:YM.Test 3),
    let g:=regulatorRun R.family N per K
    let θ:=regulatorRun R.family N per v
    let probes:=fun y t=>enrolled R D V draw N per c (ck.trans live.le) y t (tests y t)
    let x:=vector R grade (fun _=>A₀.station.k) K order η M (filed R A₀) (fun _=>kK) reg N per
    let pay:=fun i=>(r/R.family.S.a K)^(grade i)
    let Q:=table R D V N per K c w v probes g x pay p θ true
    let F:=table R D V N per K c w v probes g x pay p θ false
    let H:=overhead R width ξ η δ m
    let B:=reserve R D p H C
    ‖center R N per r φ F Q‖ ≤ (∫z:Points 3,‖φ z‖)*cost R C B*g^q

theorem original (D:Fin 3→ℕ)(p q order width:ℕ)(ξ η δ:ℝ)(m C:Fin 3→ℝ)(A₀:Group R.family 6)(r:ℝ)(rp:0<r)
    (M:Fin 3→ℝ)(reg:Indexed R grade (fun _=>A₀.station.k) order η M (filed R A₀))
    (v N per K c w:ℕ)(V:Realm G (p+1) Credit.leanC)(draw:V.draws=R.family.path.levels)
    (kK:A₀.station.k ≤ K)(ck:c ≤ K)(live:K<N)(vN:v ≤ N)
    (low:regulatorRun R.family N per v ≤ 1)(cool:regulatorRun R.family N per K ≤ 1):
    let H:=overhead R width ξ η δ m
    let surface:=q+2*H
    Hearing R D p surface width ξ δ η m C A₀ r order M reg v N per K c w V draw kK ck live →
    Cleared R D p width ξ δ η m C A₀ r order M reg v N per K c V draw kK ck live →
    Compared R D p surface C η A₀ r order M reg v N per K c w V draw kK ck live →
    Settled R D p q order width ξ η δ m C A₀ r M reg v N per K c w V draw kK ck live:=by
  intro H surface terms bank rows tests φ g θ probes x pay Q F H₁ B
  have norm:=WilsonOlderFreshSoftSocketStationSingleton.original R D p surface width ξ δ η m C A₀ r rp order M reg
    v N per K c w V draw kK ck live vN low cool terms bank rows
  have θ0:0 ≤ θ:=(ActualRunKernelPackets.regulator_pos R N per v vN).le
  apply heard R N per r φ F Q C B g (ActualRunKernelPackets.regulator_pos R N per K live.le) cool q H
  · intro y s
    by_cases occupied:s.Nonempty
    · have h:=rows p le_rfl θ (by rwa [abs_of_nonneg θ0]) s occupied y (tests y s)
      simpa only [F,Q,WilsonOlderFreshSoftRoseMesh.table,if_pos occupied] using h
    · simp only [F,Q,WilsonOlderFreshSoftRoseMesh.table,if_neg occupied,sub_self,norm_zero,
        WilsonOlderFreshSoftSocketStationStops.ticket,zero_mul,le_refl]
  · intro y s occur
    simpa only [Q,WilsonOlderFreshSoftRoseMesh.table,if_pos occur] using norm s occur y (tests y s)

