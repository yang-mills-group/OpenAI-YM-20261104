include affordable nonempty early paid prior in
theorem original (r:ℝ)(rp:0 < r)(small:factor R φ*r ≤ R.family.S.a 0)
    (atCapture:first+1 < capture R φ r)(born:capture R φ r ≤ f)(narrow:8*R.family.S.a f < R.family.S.a (capture R φ r))
    (occurs:WilsonCenteredCompactBooking.mass R φ r (f,per) site≠0)
    (before:capture R φ r<K₀)
    (forests:∀(j:ℕ)(u:Covers R.family.path.levels.S (j+1) (coarse R (j+1) per)),Forest (step R (j+1) u.val).ratio)
    (chosen:∀(j:ℕ)(u:Covers R.family.path.levels.S (j+1) (coarse R (j+1) per)),(step R (j+1) u.val).Choices)
    {df:ℕ}{frame:Frame G df}(section_:SectionData frame)(group:Hol G)
    {Z₀:ℕ → SeriesA G}{price:Credit}(quiet:QuietAt day price Z₀)
    {Types:Type}[Fintype Types]{purchased pieces physical:ℕ}{schoolPole:Bool → ℕ}{span:Types → ℕ}{lag:Types → Bool → ℕ}
    (tube:LinkTube G)(front:Multi.Hot (Stock.census (Fin n)) → Fin n)(member:∀t,front t∈t.val.val)
    (faculty:WilsonIndependentCollarDatedTeachers.At schedule R simple V lens d (Burn.horizon (ask).vac)
      purchased allowance tube pieces physical schoolPole span lag first)(anchor:V.anchor ≤ first+1)
    (sparse:WilsonOriginalCensusSparseRosterOpening.first R simple tube d d (WilsonReceivedChronologicalFixedReserve.charges zeroFee)
      (capital).order (capital).order (capital).target (capital).precision (capital).enough ≤ first+1)
    (period:WilsonReceivedChronologicalFixedPorts.Period (R:=R) (per:=per) (V:=V) (grades:=d)
      zeroFee P (fun i=>contact (lens i)) pt K₀ first caps)
    (active:first+3 ≤ K₀)(cost:ℕ)(tol:ℝ)(tp:0<tol)(ep:0<θ)
    (current:WilsonOriginalOneArmCurrentClock.first R simple d zeroFee P cost tol θ tp ep nonempty≤first)
    (aperture:R.family.S.a (first+1)/R.family.S.a K₀ ≤ (R.family.path.levels.clock.hatBeta (first+1))^cost)
    (support:∀i,(R.family.path.levels.budget i).supportExponent=100)

    {C₁:ℝ}{E₁:ℕ}(cold:gv≤1)(pc:1≤C₁)(allowed:allowance≤1)(rent:0≤rate)(salary:rate≤C₁*(3*(gv)⁻¹)^E₁)
    (caps₁:∀a,‖present lens a‖≤C₁*(3*(gv)⁻¹)^E₁)(qh goal:ℕ)
    (kept:goal+debt n E₁ (Fintype.card (Multi.Hot (Stock.census (Fin n))))≤qh+1)(order:qh≤(capital).order)
    {η:ℝ}(sold:WilsonIndependentConditionedLocatedFirstPanels.Sold
      (R:=R) (simple:=simple) (d:=d) (P:=P) (m:=m) (school:=school) (day:=day) (old:=old)
      (live:=live) (lens:=lens) (pt:=pt) (toll:=toll) (classroom:=classroom) (adult:=adult) η)
    (upperFit:WilsonAddressedPublicFirstRoseGeometry.Fits R.family.S
      (WilsonAddressedPublicFirstSites.original R draw φ).choose r first f):
    ‖(actual (atCapture.le.trans (born.trans fine)))-(stopped (capture R φ r) qh)‖≤
      (due)*((interiorCost)+(endCost C₁ E₁ goal)+(basalCost)+(highCost η)) ∧
    ∀(W:Initialize G)(fit:∀i,d i<lens i),
    ‖(actual (atCapture.le.trans (born.trans fine)))-(published W fit (capture R φ r) qh)‖≤
      (due)*((interiorCost)+(endCost C₁ E₁ goal)+(basalCost)+(highCost η)):=by
  have uk:=before
  have inlet:=WilsonIndependentConditionedDenseFilmSameMonths.original
    (R:=R) (simple:=simple) (d:=d) (P:=P) (school:=school) (day:=day) (old:=old) (live:=live)
    (lens:=lens) (pt:=pt) (toll:=toll) (classroom:=classroom) (fine:=fine) (site:=site) (votes:=votes)
    (doseCap:=doseCap) (mask:=mask) (paid:=paid) (adult:=adult) (prior:=prior) (affordable:=affordable) r rp small atCapture born narrow occurs forests chosen section_ group uk
  have cross:‖WilsonOriginalTwoFlatIRSocketBoundary.shift R (N:=N) (amount) (rows_) mask
      (le_refl (first+1)) atCapture‖≤0:=by
    simp [WilsonOriginalTwoFlatIRSocketBoundary.shift]
  have terminal:=WilsonIndependentConditionedDenseFilmTerminal.original
    (R:=R) (simple:=simple) (d:=d) (P:=P) (school:=school) (day:=day) (old:=old) (live:=live)
    (lens:=lens) (pt:=pt) (toll:=toll) (classroom:=classroom) (fine:=fine) (site:=site) (votes:=votes)
    (doseCap:=doseCap) (mask:=mask) (paid:=paid) (adult:=adult) (prior:=prior) (affordable:=affordable) (early:=early) atCapture.le uk.le cold pc allowed rent salary caps₁ qh goal kept order
  have bottom:=WilsonIndependentConditionedDenseFilmLast.original
    (R:=R) (simple:=simple) (d:=d) (P:=P) (school:=school) (day:=day) (old:=old) (live:=live)
    (lens:=lens) (pt:=pt) (toll:=toll) (classroom:=classroom) (fine:=fine) (site:=site) (votes:=votes)
    (doseCap:=doseCap) (mask:=mask) (paid:=paid) (adult:=adult) (prior:=prior) (affordable:=affordable) quiet tube front member faculty anchor sparse period (forests first) (chosen first)
    section_ group active nonempty cost tol tp ep current aperture support
  have topFee:‖WilsonOriginalTwoFlatIRSocketBoundary.first R (N:=N) (u:=first+1) (K:=K₀) (amount)
      (rows_) mask‖≤(due)*(highCost η):=
    sold fine site votes doseCap affordable mask paid prior rp upperFit.small upperFit.older upperFit.finer
      upperFit.margin occurs small atCapture.le born narrow section_ group (old.trans (Nat.le_succ first))
      le_rfl (by omega)
  have billed:=WilsonOriginalTwoFlatIRSocketBoundary.estimate R (N:=N) (K:=K₀) (amount) (rows_) mask
    (le_refl (first+1)) atCapture _ _ _ _ _ inlet terminal cross
  have total:‖(actual (atCapture.le.trans (born.trans fine)))-(stopped (capture R φ r) qh)‖≤
      (due)*((interiorCost)+(endCost C₁ E₁ goal)+(basalCost)+(highCost η)) := by
    calc
      _≤(due)*(interiorCost)+(due)*(endCost C₁ E₁ goal)+0+
          ‖WilsonOriginalTwoFlatIRSocketBoundary.last R (N:=N) (b:=first+1) (amount) (rows_) mask‖+
          ‖WilsonOriginalTwoFlatIRSocketBoundary.first R (N:=N) (K:=K₀) (u:=first+1) (amount) (rows_) mask‖:=billed
      _≤(due)*(interiorCost)+(due)*(endCost C₁ E₁ goal)+0+(due)*(basalCost)+(due)*(highCost η):=
        add_le_add (add_le_add (le_refl _) bottom) topFee
      _=(due)*((interiorCost)+(endCost C₁ E₁ goal)+(basalCost)+(highCost η)):=by simp only [mul_add,add_zero]
  refine ⟨total,?_⟩
  intro W fit
  rw [←WilsonIndependentConditionedDenseFilmRecord.original (R:=R) (simple:=simple) (d:=d) (P:=P)
    (N:=N) (per:=per) (draw:=draw) (first:=first) (live:=live) (lens:=lens) (pt:=pt)
    (fine:=fine) (site:=site) (votes:=votes) (mask:=mask) W fit (capture R φ r) qh atCapture.le uk.le]
  exact total

