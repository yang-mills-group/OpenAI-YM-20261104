theorem registered_hourglass (h0:0< e_E)(hh:e_E≤1): ∃ ξ : Type,Countable ξ ∧ ∃ U':Tint.Incoming κP P' (Affinity.Wallet Actors) ξ R₀, Earn.Scene.Armada tΩ w ηL Φout ((pΩ).produce (µ).count*c_P) jJ Pt.count Vh ∧ Earn.Tableau U Actors tΩ ∧ Affinity.Taut ((K₁.coarser µ).support) Actors U U'.old ∧ Affinity.Crown (κP).support Actors U U'.hard ∧ U'.old.Paid w (P').p.B ( (P').p.supportExponent+1+1 ) ζc ∧ U'.hard.Paid (Stoop.radius w rΩ) (P').p.B ((P').p.supportExponent) wp ∧ (∀ k:Affinity.Wallet Actors, Integration.LocalComparison.actualPush Z N n i ((Tint.Patrol.picture M Z₁).density k)=(Tint.Patrol.report tΩ U' G').density k) ∧ Earn.Earnings.Cashier pΩ G (µ).count (P).p (P').p Ω y₀ G' ∧ Ω ≤ budgetR R i ∧ ζc ≤ 8*Ω*(e_E+FY+ ((pΩ).fidelity)) ∧ U'.hard=returnedHard h0 hh := by
  let booked:=entered h0 hh
  let idx:=Classical.choose booked
  have roots:=Classical.choose_spec booked
  let current:=Classical.choose roots.2
  obtain ⟨soft,hard,small,reading,earning,cashier,first,taut,crown,school,_⟩:=Classical.choose_spec roots.2
  refine ⟨idx,roots.1,current,earning,school,taut,crown,soft,hard,fun t=>?_,cashier,first,small,rfl⟩
  unfold Integration.LocalComparison.actualPush
  rw [show R.family.path.β N n (i+1)=(P).beta from (later R π Γ Ψ v (Nat.le_succ_of_le hℓ) hz).beta.symm]
  exact reading t

