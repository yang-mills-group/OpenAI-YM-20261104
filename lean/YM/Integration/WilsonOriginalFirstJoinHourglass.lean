/-- The reservation supplier is applied once to the real seat and its original Walk.
Its chosen hard roster can be cited by every later coarse reading. -/
noncomputable def first_reservation (h0:0<e_E) (hh:e_E≤1) :=
 let YH := V₂.clock
 let hf:= later R π Γ Ψ v (Nat.le_succ_of_le hℓ) hz
 let hp':= later R π Γ Ψ v hℓ hz.le
