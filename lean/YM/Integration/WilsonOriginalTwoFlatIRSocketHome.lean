theorem original (φ:Test n)(r:ℝ)(rp:0<r)(small:factor R φ*r ≤ R.family.S.a 0)
    {first f K per j q:ℕ}(start:first ≤ j)(active:j+1 ≤ capture R φ r)(born:capture R φ r ≤ f)
    (fine:f ≤ K)(young:j+2 ≤ K)(narrow:8*R.family.S.a f<R.family.S.a (capture R φ r))
    (z:Sites R (f,per) n)(occurrence:WilsonCenteredCompactBooking.mass R φ r (f,per) z≠0)
    (V:Realm G (q+1) Credit.leanC)(draw:V.draws=R.family.path.levels)(a:Fin n):
    wrap (R.family.side (j+1) per) (homes (tape draw fine z) 0 first (j-first) a)=0:=by
  let y:=homes (tape draw fine z) 0 first (j-first)
  let l:=R.family.path.levels
  let ρ:Ratio (R.family.side (j+1) per) (R.family.side (j+2) per):=(l.clock.op (j+1) per).ratio
  let cells:=onLevels draw (tape draw fine z)
  have up:wrap (R.family.side (j+2) per) (chartIn (loose l (j+1)) y (cells (j+1)) a)=
        ρ.assemble (wrap (R.family.side (j+1) per) (y a),cells (j+1) a):=by
    change wrap _ ((loose l (j+1)).L.val • y a+lift (cells (j+1) a))=ρ.embed (wrap _ (y a))+wrap _ (lift (cells (j+1) a))
    rw [map_add,ρ.embed_wrap]
    rfl
  have booked:=(WilsonReceivedChronologicalFixedSites.original R φ).choose_spec.choose_spec
    r rp small first f K per ((Nat.succ_le_succ start).trans active) born fine narrow z occurrence
  have member:=(booked.2 q V draw j (j+1) start active (le_refl _) young).1 a
  simp only [WilsonOriginalOccupiedCorridor.sites,Nat.decreasingInduction_self] at member
  change ρ.parent (wrap (R.family.side (j+2) per) (chartIn (loose l (j+1)) y (cells (j+1)) a)) ∈ ({0}:Finset _) at member
  rw [Finset.mem_singleton, up, ρ.assemble_parent] at member
  exact member

end YM.Integration.WilsonOriginalTwoFlatIRSocketHome
