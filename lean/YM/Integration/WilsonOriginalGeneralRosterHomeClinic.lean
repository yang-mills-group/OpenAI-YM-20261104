def Estimate {world:XSpace.Run}{stage u depth:ℕ}(simple:G.Simple)(slow:WilsonWindowReportingPace.Slow R.kit)
    (run:WilsonPositionProgramReporterBand.Band R world stage)(stop:WilsonIndependentCapturedPages.Stop R world run u depth)
    {ax:I→Axis}{x:I→E4}(B:∀i,Bulb (site (x i)) (ax i))(ψ:I→Test 2)(cap cash:I→ℝ)(house:I→ℝ)
    (target A E P₁ P₂ P₃:I→ℕ)(C₁ θ η:I→ℝ)(turns:ℕ)(ε:ℝ)(T h ask floor reserve:ℕ)
    (d:I→ℕ)(tuition:ℝ)(power:ℕ)(z:Trace.Terrace.Arch R.family)(s:I→ℝ)(f K:ℕ):Prop:=
  ∀i,let room:=2*T+11+2*h
    let basic:=target i+4*power
    WilsonOriginalGeneralRosterHomeFilm.Funded (R:=R) (B i) (ψ i) (s i) (cap i) (date R simple (s i)) f K reserve room turns ε ∧
    WilsonIndependentConditionedWideBirthClock.Issued R run stop ask floor (ψ i) (house i) (s i)
        (wilson z (s i)) (date R simple (s i)) f K (WilsonIndependentConditionedWideBirthClock.span R simple slow room reserve depth) ∧
    WilsonOriginalGeneralRosterHomeHeld.Charged run stop (ψ i) (s i) (wilson z (s i)) (d i) power (target i) f K
        (A i) (basic+P₁ i) (E i) (basic+P₂ i) (basic+P₃ i) tuition (C₁ i) (θ i) (η i) (cash i)

theorem original {h t:ℕ}{d:I→Fin (D+1)}(field:(i:I)→{s:ℝ//0<s ∧ s<δ}→Bool→Bool→S.Field (d i).val)
    (W:XSpace.Initialize G){a k u e:ℕ}(tag:Fin (a+1)→I)(cap₀:Fin (a+1)→ℕ)
    (fit:∀i,(d (tag i)).val<cap₀ i)(kind:Fin (a+1)→Bool)(own:∀i,Rails (d (tag i)).val k u e)
    (bought:Booked F books h t d field W tag cap₀ fit kind own)
    (simple:G.Simple)(bliss:Bliss F l z H)(slow:WilsonWindowReportingPace.Slow R.kit)
    (ready:WilsonReportLampForecast.Ready R.family.path.levels){world:XSpace.Run}{stage oldPhase depth₀:ℕ}
    (run:WilsonPositionProgramReporterBand.Band R world stage)(stop:WilsonIndependentCapturedPages.Stop R world run oldPhase depth₀)
    (active:0<stage)(deep:0<depth₀)(old:R.family.ref 0≤oldPhase):
    ∃(M:I→ℝ)(E:I→ℕ),(∀i,1≤M i) ∧ ∃α:∀i,Alma (R.family.labels.level (d (tag i)).val)→ℝ,
    (∀i b,0≤α i b) ∧ ∃(Z₀ B₀:Fin (a+1)→Credit),∀ᶠgate:ℕ in atTop,
    ∀(J:Type)[Fintype J](main:Row I)(precision:Fin main.size→ℕ)(outside:J→Row I)(home:J→Option I)
     (ax:I→Axis)(x:I→E4)(B:∀i,Bulb (site (x i)) (ax i))(house:I→ℝ), (∀i,0<house i)→
    ∀(target A estate P₁ P₂ P₃:I→ℕ)(C₁ θ η:I→ℝ)(turns ask floor:ℕ)(ε:ℝ),0<ε→
    ∃(ψ:I→Test 2)(cap cash:I→ℝ),(∀i,0≤cap i ∧ (∀y,0≤(ψ i y).re) ∧ 0≤cash i) ∧
      let pair:=ψ ∘ main.stock
      let reserve:=amount T h d E main pair precision outside
      let tuition:=max 1 (4*∑i,M i)
      let power:=(∑i,E i)+WilsonAddressedMixedRawTrial.power T h reserve D
      Window F books h t d field W tag cap₀ fit kind own M E α Z₀ B₀ gate main pair precision outside home
        (fun _ ρ f K=>Estimate simple slow run stop B ψ cap cash house target A estate P₁ P₂ P₃ C₁ θ η
          turns ε T h ask floor reserve (fun i=>(d i).val) tuition power z (fun i=>(ρ i).val) f K):=by
  classical
  letI : Nonempty I := ⟨tag 0⟩
  obtain ⟨M,E,mn,α,an,Z₀,B₀,sales⟩:=WilsonOriginalGeneralRosterHomeClinicCampus.original F books field W tag cap₀ fit kind own bought
  refine ⟨M,E,mn,α,an,Z₀,B₀,?_⟩
  filter_upwards [sales] with gate sale
  intro J _ main precision outside home ax x B house pos target A estate P₁ P₂ P₃ C₁ θ η turns ask floor ε ep
  let draft:Fin main.size→Test 2:=fun _=>(WilsonIndependentConditionedLocatedReflectedFilm.original (B (tag 0)) R simple
    (show 0<1 by decide)).choose
  let reserve:=amount T h d E main draft precision outside
  have positive:0<reserve:=WilsonOriginalGeneralRosterHomeReserve.positive T h d E main draft precision outside
  let tuition:ℝ:=max 1 (4*∑i,M i)
  let power:=(∑i,E i)+WilsonAddressedMixedRawTrial.power T h reserve D
  let basic:=fun i=>target i+4*power
  obtain ⟨ψ,cap,cash,nn,heard⟩:=WilsonOriginalGeneralRosterHomeFilm.original F simple bliss slow ready run stop active deep old
    ask floor h reserve positive d books B house pos (fun _=>tuition) (fun _=>zero_le_one.trans (le_max_left ..))
    (fun _=>power) target A (fun i=>basic i+P₁ i) estate (fun i=>basic i+P₂ i) (fun i=>basic i+P₃ i) C₁ θ η
    (fun i=>Nat.le_add_right ..) (fun i=>Nat.le_add_right ..) (fun i=>Nat.le_add_right ..) turns ep
  let pair:=ψ ∘ main.stock
  have same:amount T h d E main pair precision outside=reserve:=WilsonOriginalGeneralRosterHomeReserve.same T h d E main pair draft precision outside
  refine ⟨ψ,cap,cash,nn,?_⟩
  apply sale _ main pair precision outside home
  dsimp only
  change ∀ᶠr in trail,∀ρ:I→{s:ℝ//0<s ∧ s<δ},(∀i,r≤(ρ i).val ∧ (ρ i).val≤outer z h r)→(∃i,(ρ i).val=r)→
    let f:=reporter F books ρ
    let v:=amount T h d E main pair precision outside
    Estimate simple slow run stop B ψ cap cash house target A estate P₁ P₂ P₃ C₁ θ η turns ε T h ask floor v
      (fun i=>(d i).val) tuition ((∑i,E i)+WilsonAddressedMixedRawTrial.power T h v D) z (fun i=>(ρ i).val) f (berth R v f)
  rw [same]
  exact heard

end YM.Integration.WilsonOriginalGeneralRosterHomeClinic
