import YM.Integration.WilsonThermometerWeakPanelRocket
import YM.Integration.WilsonThermometerWeakCanonicalRoster
import YM.Integration.WilsonThermometerWeakInputNarrow

/-! The reflected, signed, displaced physical source arrives on one printed weak
post with its funded regular and forced families. Each submitted head is the
original raw polynomial of its own Wilson arm. -/
set_option autoImplicit false
noncomputable section
namespace YM.Integration.WilsonThermometerWeakPanelRows
open Function Filter Set MeasureTheory Lattice Wilson Labels RG Source RG12 Extra.Histories
open RG05Readout Native Address Many Records Harvest Push.GridApprox Copper Push Marker
open PhysicalNext.Repeat.Legato MergeProof Accent Motion Bandage Extra.Multi Menu
open Trace.Physical Push.Local GermGraph Next.Rank.Spindle Next.Rank Configuration Normal Rise
open Perch Glimmer LiftMark Beamer Station Atlas Tariffs MvPolynomial Ribbon Asymptotics Tapes Paint
open Thirst Relation Corona Value Glyph Marker Vac.Numbers Alarm Cells Atlas Baler EntryWord Exponential Edition
open WilsonThermometerOffsetTrajectory WilsonThermometerOffsetResidue WilsonThermometerOwnOffsetField
open WilsonThermometerReflectedTrajectory WilsonThermometerOwnOffsetRadii WilsonThermometerWeakCanonicalAllowance
open scoped BigOperators Classical Topology Matrix.Norms.Frobenius
variable {G:Gauge} (R:Run G) {d H:ℕ}
local notation "Rf" => R.family
local notation "A" => R.family.path.levels
local notation "B" => WilsonThermometerOffsetLedger.cash R

theorem original (simple:G.Simple) (shop:RG05Preconstruction.ReadoutPurchase R.b) (S:Rules G)
    (plan:Panel H) (hd:d≤H):
    ∀ᶠ k:ℕ in atTop,∀ N p (hk:k<N),
    let P:=(Rf).path.rep N p k;let s:=clim (A) k;let g:=GaugeScale Rf k N p
    let ξ:=plan.bag ((A).clock.J k);let F:=(Rf).labels.level d;let Z:=Spindle.patch (sizeQ Rf k) (0:Site ((Rf).side k p))
    ∀ (b:ℝ), (∀ j≤d,Accent.generator G j≤b) → ∀ menu:Launch Rf k ξ (-3) b,
    ∀ (Q:Rep G ((Rf).side k p)),survivors Rf N k p menu.pane Q → 8≤ξ.era.coast.Q →
    ∀ (J:Type) (z:J→Site ((Rf).side N p)) (y:J→Palette Rf d) (V:J→Sight Rf d p) (r:J→Emblems Rf d),
    (∀ j,Enrolled R.makes R.doors B k N p d (digits R N p (z j)) (V j) (r j)) →
    ∀ (K:J→Provision Rf d k N p (scouts Rf k) (sizeQ Rf k)) (L:J→poly (Up Rf k p (sizeQ Rf k))),
    let W:=fun j=>sender (K j).length P.p.threshold g (L j)
    (∀ j,size (y j)≤Perch.bill (ξ.credit-1) s) → (∀ j,Spirit (W j)) →
    (∀ (j:J) (Y:Coefficient F ((Rf).side k p)),V j k (y j) (line (primaryLetter d))=invoice Y 0 ((Rf).localSection d) P →
      ∀ U,Healthy (tau (A) k) Z U → ‖Y.exponentialEntry 0 ((Rf).localSection d) P U-signet 0 g (W j) U‖≤
        Perch.bill (1/8-(ξ.taylor:ℝ)) s*size (y j)) →
    ∀ (I:Type) [Fintype I] [DecidableEq I] (base:I→J) (motion:I→Motion) (c:I→Site ((Rf).side k p)),
    let zz:=fun i=>z (base i);let yy:=fun i=>y (base i);let rs:=fun i=>r (base i)
    let O:=WilsonThermometerOwnOffsetJoint.origins R
      (fun i=>WilsonThermometerReflectedRoster.endpoint R (zz i) (motion i) (c i)) k
    (∀ i i',i≠i' → ((A).budget k).B^2<separation (point R (zz i) (motion i) (c i) k) (point R (zz i') (motion i') (c i') k)) →
    ∃ (α β:Type),∃ (_:Fintype α) (_:Fintype β),∃ (file:I→SourceAt G O)
      (ordinary:α→SourceAt G O) (forced:β→Lifted G O Q.p.threshold),
    (∀ i,(file i).extent=swath (motion i).1 (O i) (halo (ξ.era.coast.Q*Q.p.B) {0}) ∧ (file i).fires=slot i ∧
      (file i).value=dot (motion i).2 ∘ signet 0 g (W (base i)) ∘ pull (motion i).1 (O i)) ∧
    WilsonThermometerReflectedRoster.density R (fun _=>d) zz motion c yy rs (Stock.census I) hk.le hk.le=
      dust Q (Sum.elim ordinary file) forced ∧ Background Q forced ∧
      Unpacks ordinary Q.p (fun _=>Perch.bill ξ.f s) (load ξ.era) (Perch.bill (-(ξ.goal:ℝ)) s) ∧
      Alarm.prepared (q:=Q.p) forced (fun _=>Perch.bill ξ.f s) (load ξ.era) (Real.exp (-(trib ξ.era.coast.a s))) :=by
  filter_upwards [WilsonThermometerWeakCanonicalRoster.original R simple shop d plan,
    WilsonThermometerWeakPanelRocket.original R simple shop S d plan.θ (hd.trans plan.enough),
    Many.theta_up (C:=Rf) 1 simple] with k fed rocket one N p hk P s g ξ F Z b priced menu Q receive room J z y V r legal K L W credit spin fit I _ _ base motion c zz yy rs O apart
  let t:=maximum G d+1
  have start:=fed p N hk.le I (fun _=>d) (fun _=>le_rfl) zz (fun i=>V (base i)) rs (fun i=>legal (base i))
    motion c apart (Stock.census I) yy (fun i=>credit (base i))
  obtain ⟨X,fmt,germ,remBound,filed,issue⟩:=WilsonThermometerWeakReflectedRows.original (I:=I) R (fun _=>d) z y V r hk legal
  obtain ⟨vac,vacuum,ι,κ,inst₁,inst₂,reg,hard,regStock,hardStock,reg2,hard2,exactly⟩:=
    issue base motion c t start
  letI:=inst₁;letI:=inst₂
  obtain ⟨rp,under⟩:=WilsonThermometerWeakInputNarrow.purchased R priced one
  have roots (i:I):O i=point R (zz i) (motion i) (c i) k:=
    WilsonThermometerReflectedRoster.parent R _ _ _ le_rfl hk.le
  have spaced:Spaced P.p.B O:=by
    intro i j diff
    rw [roots,roots,show P.p=(A).budget k from (R.makes.wilson.represents N p k hk.le).vac]
    exact (apart i j diff).le
  have θ:ξ.taylor=plan.θ:=plan.stable _
  obtain ⟨α,β,iα,iβ,file,regular,forced,words,allfield,rest⟩:=
    rocket N hk.le p ξ b menu Q receive θ room I O (fun i=>(motion i).1) (fun i=>(motion i).2) spaced
      (fun i=>K (base i)) (fun i=>X (base i)) (fun i=>L (base i)) yy (fun i=>fmt (base i))
      (fun i=>remBound (base i)) (fun i=>germ (base i)) (fun i=>credit (base i)) (fun i=>spin (base i))
      (fun i=>θ ▸ fit (base i) _ (filed (base i))) vac vacuum ι κ reg hard
      (WilsonThermometerWeakInputNarrow.regular reg regStock (fun _=>rp) (fun _=>under))
      (WilsonThermometerWeakInputNarrow.forced hard hardStock (fun _=>rp) (fun _=>under)) reg2 hard2
  exact ⟨α,β,iα,iβ,file,regular,forced,words,exactly.trans allfield,rest⟩

end YM.Integration.WilsonThermometerWeakPanelRows
end
