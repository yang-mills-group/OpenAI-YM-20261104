/-- Evaluate the entire genuinely connected next finite coefficient of the
separately placed cutoff-normalized singleton inputs.  The quiet intake is
the actual previous finite Wilson history at its measured clock. -/
theorem original (G:Gauge)(D k:ι → ℕ)(I:Finset ι)(alive:I.Nonempty)(E e r:ℕ)(he:e  ≤  E):
    ∃fare:Gear G → ℝ,∃M:ℝ,0  ≤  M ∧ ∃d:ℕ,∀(R:Run G),G.Simple →
    WilsonPointChildFiledTest.Filed R → WilsonPointChildWindingHierarchy.Filed R →
    WilsonPointChildWindingSchool.Paid R.kit → WilsonReceivedCloseFundedHeat.Quiet R →
    ∀cash:ℕ → Gear G → ℝ,FundedMarkedCoverRows.prices cash R.kit →
    (∀ᶠj:ℕ in atTop,∀J,fare J  ≤  cash (R.family.path.levels.clock.J (j+1)) J) →
    ∀(u:ι → G.ColorIndex)(h:ι → ℕ)(depth:∀s,k s<h s)(_o:Loc G 1),
    ∀_tags:∀j n,(Flat.primary (R.family.path.levels.clock.op j 0).patch R.family.path.levels.clock.kernel n).Choices,
    ∀η:ℝ,0<η → ∀ᶠm:ℕ in atTop,∀N per,m<N →
    ∀v:∀s,Letter (R.family.labels.level (k s)),∀p:∀s,Scroll (h s),∀y:ι → Cover,∀z:ι → Site (loose R.family.path.levels m).L,
    ∀cut:∀s,ℝ →L[ℝ] Pen D ({s}:Finset ι),
    let A:=R.family.path.levels
    let O:=R.metals.O
    let n:=R.family.side m per
    let K:=placed (sources R u depth N (m+1) v p) cut (chartIn (loose A m) y z)
    let a(s:ι):=(1+‖cut s‖)*((A.clock.hatBeta (m+1))^η*‖physical (p s)‖+(1+‖physical (p s)‖))
    let A₀:=∑s,‖cut s‖*(A.clock.hatBeta (m+1))^η*‖physical (p s)‖
    let coeff:=(logO A O m N K k I)
    (∀x,‖coeff.1 n e r x‖ ≤ M*weights a I*rate A m per+
      (zz A m)^d*A₀^I.card*Real.exp (-(1/zz A m)*(Syn (tor n) (wrap n ∘ y) I x))) ∧
    (∀x,‖coeff.2 e r x‖ ≤ (zz A m)^d*A₀^I.card*Real.exp (-(1/zz A m)*(Syn terrain y I x))) ∧
    (4*crestCard y I<n.val → ∀x,‖coeff.1 n e r x-Carp.plume (coeff.2 e r) n x‖ ≤ 
       (M*weights a I+A₀^I.card)*rate A m per):=by
  obtain ⟨v₀,M,mp,preceding⟩:=WilsonPointChildPlacedPost.original G D k I E e r he
  obtain ⟨w,σ',b,limits,seam⟩:=WilsonPointChildPlacedFold.fresh G D k I alive E e r he
  obtain ⟨v,σ,d,margin,deposit⟩:=WilsonPointChildPlacedFold.deposit G D k I alive E e r he
  let all(J:Gear G):=max (v₀ J) (max (w J) (v J))
  refine ⟨all,M,mp,d,?_⟩
  intro R simple booked enrolled paid quiet cash buy salary u h depth o tags η eta
  have oldCash:=salary.mono (fun j h J=>(le_max_left ..).trans (h J))
  have real:=preceding R simple booked enrolled paid quiet cash buy oldCash u h depth o tags η eta
  let L:=R.family.path.levels
  obtain ⟨m₀,input⟩:=eventually_atTop.mp (WilsonPointChildPlacedFold.salary R simple booked paid u depth o tags (D:=D) E eta)
  obtain ⟨m₁,table⟩:=eventually_atTop.mp (WilsonPointChildPlacedIncome.original R simple booked enrolled paid u depth o tags (D:=D) E eta)
  filter_upwards [eventually_ge_atTop (max m₀ m₁),real,salary,WilsonPointChildQuoteWidth.index L,
    WilsonVacuumPreResetFiniteHeatScale.clock L simple,WilsonMarkedIndependentNormalizedScale.original L simple b,
    FundedMarkedCoverRows.realm R simple cash buy 0 (fun _=>0) (fun _=>1) (fun _=>by decide) E 0 0]
    with m late old fund index clock absorb election
  obtain ⟨Q,draws,measured,tick,origin,_,_,_,funded⟩:=election
  have hq:Q.anchor ≤ m:=origin.le
  let J:=(Q.mint m hq).gear
  have wage:all J ≤ Q.cash Credit.leanC m:=(fund J).trans (funded m le_rfl hq).2.2
  have loan:v J ≤ Q.cash Credit.leanC m:=(le_max_right ..).trans ((le_max_right ..).trans wage)
  have second:w J ≤ Q.cash Credit.leanC m:=(le_max_left ..).trans ((le_max_right ..).trans wage)
  have cap:WilsonPointChildQuoteWidth.quote J ≤ width R (m+1):=entered R Q draws m index hq
  intro N per live vtest p y z cut A O n K a A₀ coeff
  let fine:=chartIn (loose A m) y z
  have store:=input (m+1) (by omega) N (by omega) vtest p fine cut (WilsonPointChildQuoteWidth.quote J) cap
  have body:=table (m+1) (by omega) N per (by omega) vtest p fine cut
  have charged:=old N per live vtest p fine cut
  have fold:=deposit Q m N hq loan live n K body.1 body.2.1
  have spring:=seam Q m N hq second live n K body.1 body.2.1
  generalize branch : (Q.mint m hq).gear = g at fold spring
  rw [draws,measured,tick] at fold spring
  rw [←branch] at fold spring
  have whole:=fold y z A₀ store.1 (store.2 I)
  have oldwave:=spring y z A₀ store.1 (store.2 I)
  have quot: v J ≤ zz L m:=by simpa only [Realm.cash,Credit.leanC,Credit.buy,pow_one,one_mul,tick] using loan
  have diameter:1/(zz L m) ≤ σ J:=by
    have unit:= (margin J).1
    apply (div_le_iff₀ (zero_lt_one.trans_le clock.1)).2
    calc 1=σ J*(σ J)⁻¹:=(mul_inv_cancel₀ unit.ne').symm
         _ ≤ _:=mul_le_mul_of_nonneg_left ((margin J).2.trans quot) unit.le
  have certificate:=whole.mono diameter
  refine ⟨fun x=>?_,certificate.access.2,fun room x=>?_⟩
  · let U:=coilH A O m N n K k (ratioHigh A O N m) I e r x
    calc
      ‖coeff.1 n e r x‖=‖(coeff.1 n e r x-U)+U‖:=by rw [sub_add_cancel]
      _ ≤ ‖coeff.1 n e r x-U‖+‖U‖:=norm_add_le _ _
      _ ≤ _:=add_le_add (charged x) (certificate.bill.2 x)
  · have se:‖Carp.plume (coeff.2 e r) n x-coilH A O m N n K k (ratioHigh A O N m) I e r x‖ ≤ 
        (zz A m)^b*A₀^I.card*Real.exp (-(n.val:ℝ)/(512*zz A m)):=by
      have wh:=oldwave room
      exact (wh.2 x).trans (mul_le_of_le_one_right wh.1 (Real.exp_le_one_iff.mpr (by
        have sp:0<σ' J:=(limits J).1
        exact mul_nonpos_of_nonpos_of_nonneg (by linarith : -(σ' J/32/2) ≤ 0) (Nat.cast_nonneg _))))
    let f:=A.S.side (m+1) per
    have z₀:0 ≤ zz L m:=zero_le_one.trans clock.1
    have mon:zz L m ≤ zz L m*(1+(f.val:ℝ))^4:=le_mul_of_one_le_right z₀ (one_le_pow₀ (le_add_of_nonneg_right (Nat.cast_nonneg _)))
    have flat: (zz A m)^b*Real.exp (-(n.val:ℝ)/(512*zz A m)) ≤ rate A m per:=by
      refine (mul_le_mul (pow_le_pow_left₀ z₀ mon b) (le_add_of_nonneg_left (Real.exp_pos _).le)
        (Real.exp_pos _).le (pow_nonneg (mul_nonneg z₀ (by positivity)) _)).trans (absorb per)
    have sign:‖coilH A O m N n K k (ratioHigh A O N m) I e r x-Carp.plume (coeff.2 e r) n x‖ ≤ A₀^I.card*rate A m per:=by
      rw [norm_sub_rev]
      refine se.trans ?_
      calc (zz A m)^b*A₀^I.card*_ = A₀^I.card*((zz A m)^b*Real.exp (-(n.val:ℝ)/(512*zz A m))):=by ring
           _ ≤ _:=mul_le_mul_of_nonneg_left flat (pow_nonneg store.1 _)
    rw [add_mul]
    let a₁:=coeff.1 n e r x
    let b₁:=coilH A O m N n K k (ratioHigh A O N m) I e r x
    let c₁:=Carp.plume (coeff.2 e r) n x
    calc ‖a₁-c₁‖=‖(a₁-b₁)+(b₁-c₁)‖:=by rw [sub_add_sub_cancel]
         _ ≤ ‖a₁-b₁‖+‖b₁-c₁‖:=norm_add_le .. 
         _ ≤ _:=add_le_add (charged x) sign

end YM.Integration.WilsonPointChildPlacedFirstJoin
