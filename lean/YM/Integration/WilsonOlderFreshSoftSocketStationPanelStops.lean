variable {G:Gauge}(R:Run G)
local notation "L" => R.family.path.levels
local notation "H" j:max => R.family.path.levels.clock.hatBeta j
def rent (pow:ℕ)(s:Finset (Fin 3)):ℕ:=∑i:s,(pow+WilsonOriginalPublicFigureIncome.height R (grade i))

def printed {f n N per req pow step:ℕ}{B:ℝ}(cut:f+n≤N)
    (P:Panel R grade N per f (f+n) (Nat.le_add_right f n) cut req pow step B)(i:Fin 3):=
  entire R (grade i) (f+n) (N,per) (((((R.family.S.a (f+n)):ℂ)^grade i)⁻¹) • coords R grade cut P i)

theorem original (simple:G.Simple)(D:Fin 3→ℕ)(e:ℕ)(s:Finset (Fin 3))(occupied:s.Nonempty)
    (A:ℝ)(ap:0≤A):
    ∀ᶠ v:ℕ in atTop,∀(V:Realm G (e+1) Credit.leanC),V.anchor≤v →
      V.draws=L → V.paid=R.metals.O → V.y=zz (L) → Dormitory V (mass (grade ∘ seat s) univ) 0 Credit.leanC →
    ∀(N per f n c w:ℕ)(cut:f+n≤N),v≤w → w≤c → c≤f+n → v+1≤f+n →
      R.family.S.scale (f+n)-R.family.S.scale v≤A*(1+Real.log (H (v+1))) →
    ∀(req pow step:ℕ)(B:ℝ)(P:Panel R grade N per f (f+n) (Nat.le_add_right f n) cut req pow step B)
      (p:Probe D V s)(q:ℕ),q≤e → ∀θ:ℝ,|θ|≤1 →
    let g:=regulatorRun R.family N per (f+n)
    let x:=printed R cut P
    ‖row (R:=R) D V s N (f+n) c w v p g x q θ false-row (R:=R) D V s N (f+n) c w v p g x q θ true‖≤
      (∏i:s,B*(H (f+n))^(pow+height R (grade i)))*
        (Real.sqrt (R.family.path.β N per (f+n))*(R.family.S.a c/R.family.S.a w)^((4:ℝ)⁻¹)):=by
  classical
  have hs:(univ:Finset s).Nonempty:=by
    obtain ⟨a,ha⟩:=occupied;exact ⟨⟨a,ha⟩,mem_univ _⟩
  have optic:=WilsonOlderFreshSoftFigureOptics.original R (D ∘ seat s) (grade ∘ seat s) simple e univ hs A 1 ap zero_lt_one
  filter_upwards [optic] with v ready
  intro V vn draw scheme heat dormant N per f n c w cut vw wc cK vK window req pow step B P p q kept θ small g x
  let β:=R.family.path.β N per (f+n)
  have band:H (v+1)/2≤β:=by
    have hm:=WilsonReflectedOpticalStock.monotone R simple vK
    have hot:H (f+n)/2≤β:=(R.makes.wilson.represents N per (f+n) cut).band.1
    exact (div_le_div_of_nonneg_right hm (by norm_num)).trans hot
  have law:LocalRatio V.paid:=scheme.symm ▸ (RunFormalChain.fromRun R).receipt
  have base:=ready V vn draw heat dormant N (f+n) c w vw wc cK cut β band window
      p.coeff p.phase p.digit p.root p.test p.bound q kept θ g small (fun i:s=>x i)
  dsimp only at base
  rw [WilsonOlderFreshSoftCoveredRead.original R (grade ∘ seat s) V.draws V.paid simple law N
      (mass (grade ∘ seat s) univ) w v q vw ((wc.trans cK).trans cut) θ g] at base
  rw [Real.rpow_one] at base
  refine base.trans (mul_le_mul_of_nonneg_right (roster R grade cut P s) ?_)
  exact mul_nonneg (Real.sqrt_nonneg _) (Real.rpow_nonneg (div_nonneg (R.family.S.a_pos c).le (R.family.S.a_pos w).le) _)

end YM.Integration.WilsonOlderFreshSoftSocketStationPanelStops
