attribute [local instance] Gauge.frobInner
variable {G:Gauge} (R:Run G) (simple:G.Simple) {m i N per k:ℕ}
  (hk:Burn.horizon k+2 ≤ R.alloy.B.a.clock.J m)
  (D:Roots (G:=G) R.metals.p.profile R.metals.K R.metals.p.kernel) (Q:D.Tab R.rolls)
  (π:ℕ → Layout G) (Γ:ℕ → Pace.Coin) (Ψ:∀ j, RG.Rep G (R.family.side j per))
  (course:Concourse R.alloy R.kit R.T π Γ m N per k Ψ)
  {φ:ℕ → ℕ} (scroll:LawScroll G φ) (books:Mentor.Offices.Books D R.rolls Q φ)
  (hi:m ≤ i) (cut:i < N)
  (op:Mentor.Opportunity (R.alloy.B.a.clock.J (i+1)) (R.alloy.B.a.clock.J i))
  (lesson:Lesson (N:=N) R hk D Q π Γ hi)
  (cal:Oak.Calendar R hk D Q π Γ Ψ hi (N:=N) lesson)
  (ahead:Mentor.Forecast D R.rolls Q φ books)
  (chamber:VowsR.Chamber scroll R.kit D Q books)
  (hospital:MintClock.Hospital D R.rolls Q R.kit.target φ books ahead R.alloy.delay)
  {V:Type}[Fintype V][DecidableEq V](d:V→ℕ)(q:(j:V)→Choice R d j)(hd:∀j,0 < d j)
  (o:V→Site (R.family.side (i+1) per))(order shelf:ℕ)

local notation "H" => Ψ (i+1)
local notation "scale" => Poetry.Agenda.seed D φ (Burn.horizon k) (R.alloy.B.a.clock.J (i+1))
local notation "M" => row R d q hd o scale
local notation "A" => room V
local notation "K₀" => (fun _:V=>(⊥:Submodule ℝ ℂ))
local notation "marks" => Stock.census V
local notation "w₀" => (fun _:V=>(1:ℝ))
local notation "C₀" => charge R d q scale w₀
local notation "g" => Coat.gStep (H).beta
local notation "D₀" => (∑v:V,d v)+1
local notation "χ" => R.alloy.B.a.clock.hatBeta (i+1)
local notation "physical" => fun (x:Wallet (A))(U:Config G (R.family.side (i+1) per))=>
  ((H).eval U:ℂ) • Poly.pass (Spill.Foundry.uncut M (g) x U)
local notation "Ptype" => WilsonOriginalReceivedChain.Post (N:=N) R hk D Q π Γ Ψ books ahead (A) (K₀)
  d order shelf op.count i hi (physical)

local notation "S₀" => (fun _:V=>max 1 (C₀))
local notation "e₀" => ((D₀)+5)*Fintype.card V
local notation "rate" => fun s:(marks).Mode=>(R.alloy.B.a.clock.hatBeta i)^(e₀)*Poly.toll (S₀) s
local notation "pupil" F:max => Oak.student (n:=per) R hk D Q π Γ books hi (F).op (F).lesson
  ahead (A) (F).model order (F).voter


local notation "voucher" F:max => WilsonOriginalCensusAppointment.Book R hk D Q π Γ Ψ books hi ahead
  (A) (K₀) d order shelf op.count (physical) F (rate)
local notation "file" F:max B:max x:max => WilsonOriginalCensusCanonicalFiled.file
  R hk D Q π Γ Ψ books hi op ahead d q hd o order shelf F B x
local notation "pay" => Step.tape (Burn.horizon k+2)


/-- The quiet bank is elected before the physical period, trial, or test wallet. -/
def opening (R:Run G)(simple:G.Simple)(seller:ℕ→Gear G→ℝ)(fund:FundedMarkedCoverRows.prices seller R.kit)
    (history:FundedOriginalVacuumPaths.prices R.kit)(e:ℕ):ℕ:=
  max (eventually_atTop.mp (WilsonOriginalMeasuredOccupiedForest.original R simple seller fund history e).choose_spec).choose
    (eventually_atTop.mp (WilsonConditionalTaylorForestHaar.ready R.family.path)).choose
include simple course cut cal hospital chamber in
theorem original
    (seller:ℕ→Gear G→ℝ)(fund:FundedMarkedCoverRows.prices seller R.kit)(history:FundedOriginalVacuumPaths.prices R.kit)
    (paid:opening R simple seller fund history (Burn.horizon k) ≤ m)
    (ticket:TicketP R.alloy R.kit D Q)(path:PlanV.Path D R.alloy Q (Burn.horizon k) N m π Γ)
    (fit:∀j,rank R d (entry R d j (q j)) ≤ order)(slots:Fintype.card V ≤ op.count)
    (space:∑j,d j ≤ shelf)(level:shelf ≤ R.alloy.B.a.clock.J i)
    (ord:order ≤ R.alloy.B.a.clock.J i)(stage:order+1 ≤ op.stage)
    (count:op.count ≤ Burn.horizon k+2)(cap:order+(∑j,d j) ≤ Burn.horizon k+2)
    {tol:ℝ}(tp:0 < tol)(x₀:Wallet (A))
    (atBare:Topline (Ψ N) (R.family.path.levels.clock.forcedAllowance N))
    (warm:Spill.Raffle.Warm G D R.alloy.delay φ)(pass:Pass D Q R.alloy R.kit)
    (halo:(eventually_atTop.mp (WilsonOriginalOccupiedRaffleIndependent.halo R simple)).choose ≤ i+1)
    (onset:WilsonMeasuredSemesterSubpower.onset R 1 (by norm_num:0<(1:ℝ)) ≤ i)
    (p:ℕ)(way:WayStation R.kit)(hardFloor:6*op.count ≤ R.alloy.B.a.clock.J i)
    (deep:2*(p+1)+8 ≤ order)(aged:p+4 ≤ 3*k+2)
    (opened:WilsonFirstReceivedEarnedFee.opening R simple op.count p order k deep aged (by norm_num:0<(1:ℝ)) ≤ i)
    (more:WilsonMeasuredSemesterSubpower.onset R op.count (by norm_num:0<(1:ℝ)) ≤ i)
    (cooled:(eventually_atTop.mp (WilsonReceivedClosePhysicalBirths.cool R simple)).choose ≤ i+1)
    (fresh:(eventually_atTop.mp (WilsonOriginalOccupiedModeFactors.original R simple
      (Fintype.card V) (order+shelf+1+(D₀)) ((D₀)+2))).choose ≤ i)
    (month:Scholar.Month R.rolls D Q R.alloy.delay)
    (tags:∀b:Covers R.family.path.levels.S i (coarse R i per),(step R i b.val).Choices):
    ∃(F:Ptype)(B:voucher F),F.passport=Passport.point o ∧ F.inputIndex=Empty ∧ F.op=op ∧ F.lesson=lesson ∧
      F.modelIndex=V ∧ HEq F.model (M) ∧
      F.input.hard.Paid F.w (H).p.B (H).p.supportExponent (R.family.path.levels.clock.forcedAllowance (i+1)) ∧
      8*(budgetR R i)^op.count*F.rent ≤ tol ∧
      (∀v,(F.w v)⁻¹ ≤ max 1 (C₀)*(χ+2^(order+shelf+1+(D₀))*χ^((D₀)+2))) ∧
      (∀x,(Tint.Patrol.picture F.model F.input).density x=(physical) x) ∧
      Legal (pay) (π (i+1)) ∧ Legal (pay) (π i) ∧
      WilsonOriginalCensusCanonicalFiledClock.Returns R hk D Q π Γ Ψ books hi op ahead d q hd o order shelf F B:=by
  obtain ⟨F,site,empty,event,weather,names,ink,hard,rent,wage,⟨B⟩,same,_⟩:=
    WilsonOriginalCensusCanonicalFiled.original R simple hk D Q π Γ Ψ course scroll books hi cut op lesson cal
      ahead chamber hospital d q hd o order shelf fit slots space level ord stage count cap tp x₀ atBare warm pass halo
      onset p way hardFloor deep aged opened more cooled fresh
  have paidVac:=(le_max_left ..).trans paid
  have paidForest:=(le_max_right ..).trans paid
  obtain ⟨Z,dates,_,law⟩:=(eventually_atTop.mp
    (WilsonOriginalMeasuredOccupiedForest.original R simple seller fund history (Burn.horizon k)).choose_spec).choose_spec
      m paidVac N (hi.trans cut.le)
  obtain ⟨width,_,_,credit⟩:=dates (i+1) (Nat.le_succ_of_le hi) cut
  have actual:=law D Q π Γ path ticket.pledge.formal
  have large:=(eventually_atTop.mp (WilsonConditionalTaylorForestHaar.ready R.family.path)).choose_spec m paidForest
  have native:=FVA1Physical.TwoReset.authentic R π Γ D Q path ticket.pledge.formal (fun j hj _=>large j hj 0)
  exact ⟨F,B,site,empty,event,weather,names,ink,hard,rent,wage,same,native.legal (i+1) (by omega) cut,
    native.legal i hi cut.le,WilsonOriginalCensusCanonicalFiledClock.onFiled R simple hk D Q π Γ Ψ course
      books hi cut op ahead d q hd o order shelf F B site names ink pass month cap level actual credit tags⟩

end YM.Integration.WilsonOriginalCensusCanonicalAppointedClock
