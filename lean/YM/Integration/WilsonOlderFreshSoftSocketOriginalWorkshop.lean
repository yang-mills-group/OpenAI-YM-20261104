theorem original (Φ:Test 3)(simple:G.Simple)(bliss:Bliss F l z H)(lead:Leading F Jr)
    (obedient:∀d:ℕ,∀ᶠr in trail,Frame.obedient F H (Jr r) d)
    (slow:WilsonWindowReportingPace.Slow R.kit)(shop:RG05Preconstruction.ReadoutPurchase R.b)
    (cap:∀j,1 ≤ ((P).budget j).supportExponent)(upper:∀j,((P).budget j).supportExponent ≤ 100)
    (color:G.ColorIndex)
    (funded:WilsonOriginalAllOrderCourse.Paid.{u} axis simple ε (prepared schedule) R crop W)
    (paths:FundedOriginalVacuumPaths.prices R.kit)(T h:ℕ){δ:ℝ}
    (books:(t:{t:ℝ // 0<t ∧ t<δ}) → Book F (l:=l) H z 6 T t.val)
    (delivered:∀t,WilsonMovingForkWindowBooks.Priced F (books t))(x:∀i:Fin 3,RG17.Free C (grade i).val):
    ∃bank:ℕ,∀reserve:ℕ,
    let mesh:=WilsonOriginalObservedRosePublicMesh.aperture (WilsonReceivedChronologicalFixedRosePublicAperture.width reserve (2*T+11+2*h))
    let balance:=WilsonOriginalObservedRosePublicGross.base bank 1
    let stopOrder:=WilsonOlderFreshSoftSocketStationSevenPower.order 3 balance mesh
    ∃reach:ℕ,∀(plan:Plan 3)(J₀ Q:ℕ),
    WilsonOlderFreshSoftSocketStationAbsoluteWages.degree 3 bank 0 mesh  ≤  J₀  →  J₀+9  ≤  Q  → 
    ∀(D:Fin 3 → ℕ),(∀i,ages i<D i)  →  ∀(caps:Fin 3 → ℝ),(∀i,‖WilsonReceivedCanonicalSocketSeed.present D i‖ ≤ caps i)  → 
    ∀(tol:ℝ),0<tol  → 
    let wStop:=date R reach (loss R plan.pole stopOrder)
    Tendsto wStop atTop atTop ∧ ∃day onset:ℕ,∃school:(v:ℕ) → onset ≤ v → Badge R D Q v day 1 tol,
    ∃floor:ℕ,∃entered:(v:ℕ) → floor ≤ v → onset ≤ v,
    ∀(margin:ℝ),0 < margin → ∀ᶠr in trail,∀(v:ℕ)(mature:floor ≤ v),∀ρ:Fin 3 → {s:ℝ//0<s ∧ s<δ},(∀i,(ρ i).val=r) →
    let f:=reporter F books ρ
    let K:=berth R reserve f
    let c:=WilsonReceivedChronologicalFixedCellFee.capture R Φ r
    let slots i:=reading F Jr Z (books (ρ i)) (grade i) (x i)
    ∀(m:ℕ)(atv:v=m+1)(u₀:ℕ)(uf:u₀ ≤ f)(fk:f ≤ K),c ≤ f  →  f<K  →  v ≤ c  →  v ≤ wStop c  →  v+1 ≤ K  → 
    σ K-σ (v-1) ≤ (plan.width:ℝ)*(1+Real.log (β v))  → 
    (∀N per:ℕ,c ≤ N → 0<g N per v ∧ g N per v ≤ 4*wilson z r)  → 
    ∀(requested tag src apron:ℕ)(pt:Fin 3 → Chamber)(M:Fin 3 → ℝ)(file:Filed R ages K)
      (sensor:ℂ){top:ℕ}{Vc:Realm G (top+1) Credit.leanC}(drawc:Vc.draws=P),
    Closed R (l:Filter _) D pt Φ (fun i=>(slots i).j) (fun i=>(slots i).arm.source) M r (wilson z r) sensor
      (margin/2) uf fk c m Q J₀ requested tag src apron plan file drawc  → 
    WilsonOlderFreshSoftSocketOriginalFolio.Settled R (l:Filter _) D pt Φ (fun i=>(slots i).j)
      (fun i=>(slots i).arm.source) M r (wilson z r) sensor (margin/2) margin uf fk c m Q J₀ requested tag src apron plan file drawc
      (wStop c) (atv ▸ school v (entered v mature)):=by
  classical
  obtain ⟨bank,priced⟩:=WilsonOlderFreshSoftSocketStationUnscaledTerminal.original F Jr Z Φ simple bliss lead obedient
    slow shop cap upper color funded paths T h books delivered x
  refine ⟨bank,?_⟩
  intro reserve mesh balance stopOrder
  obtain ⟨reach,geometry⟩:=WilsonOlderFreshSoftSocketStationCaptureReach.original F Φ simple bliss slow T h reserve books
  obtain ⟨U,radii,earning⟩:=priced 2 reserve (fun _=>0)
  refine ⟨reach,?_⟩
  intro plan J₀ Q retained deep D fits caps legal tol tp wStop
  obtain ⟨grows,offer⟩:=earning plan.pole reach plan.tuition
  have rank:WilsonOlderFreshSoftSocketStationAbsoluteWages.degree (2+1) bank (∑_i:Fin 3,(0:ℕ)) mesh ≤ J₀:=by
    simpa using retained
  obtain ⟨day,onset,school,course⟩:=offer J₀ Q rank deep D fits caps 1 tol zero_le_one tp
  have identity:(∑_i:Fin 3,(0:ℕ))=0:=by simp
  have divs:Tendsto wStop atTop atTop:=by simpa only [identity] using grows
  obtain ⟨floor,lessons⟩:=Filter.eventually_atTop.mp (course plan.width)
  choose enter price using lessons
  refine ⟨divs,day,onset,school,floor,enter,?_⟩
  intro margin mp
  let mass:=∫y:Points 3,‖Φ y‖
  have nonnegative:0 ≤ mass:=MeasureTheory.integral_nonneg fun _=>norm_nonneg _
  have clock:=wilson_link F simple bliss.budgets bliss.keen bliss.lies
  have small:= (clock.conforms simple).eventually (ge_mem_nhds (by positivity:0 < margin/(32*(mass+1))))
  filter_upwards [radii,geometry,clock.positive,(clock.conforms simple).eventually (ge_mem_nhds zero_lt_one),small]
    with r accepted housed gp cold thin
  intro v mature ρ equal f K c slots m atv u₀ uf fk cf fK vc vw vK span heat requested tag src apron pt M file sensor top Vc drawc sold
  subst v
  have admission:∀i,r ≤ (ρ i).val ∧ (ρ i).val ≤ outer z h r:=by
    intro i
    rw [equal i]
    have rp:0<r:=equal i ▸ (ρ i).property.1
    have estimate:r ≤ r/(wilson z r)^h:=(le_div_iff₀ (pow_pos gp _)).2
      (mul_le_of_le_one_right rp.le (pow_le_one₀ gp.le cold))
    simpa only [outer,div_eq_mul_inv,inv_pow] using And.intro (le_refl r) estimate
  have near:∃i,(ρ i).val=r:=⟨0,equal 0⟩
  have reachK:(a c)/(a K) ≤ (β c)^reach:=housed ρ admission near cf
  have uses:m+1 ≤ date R reach (loss R plan.pole (WilsonOlderFreshSoftSocketStationSevenPower.order (2+1)
      (WilsonOriginalObservedRosePublicGross.base bank ((∑_i:Fin 3,(0:ℕ))+1)) mesh)) c:=by
    simpa only [identity] using vw
  let fee:=mass*(4*wilson z r)^2
  have funds:=WilsonOlderFreshSoftSocketOriginalFolio.original R (l:Filter _) D pt Φ (fun i=>(slots i).j)
    (fun i=>(slots i).arm.source) M r (wilson z r) gp sensor (margin/2) fee uf fk c m Q J₀ requested tag src apron
    plan file drawc (wStop c) (school (m+1) (enter (m+1) mature)) sold
  have stocked:=funds (by
    intro N per kn Y named
    have money:=price (m+1) mature r accepted ρ admission near N per c requested tag fk kn (fK.trans_le kn) (vc.trans cf)
      uses vc (cf.trans fk) vK reachK span file Y (fun y=>(named y).1) (fun y=>(named y).2.2.1)
      (fun y=>(named y).2.2.2.1) (fun y=>(named y).2.2.2.2.1) (fun y=>(named y).2.2.2.2.2.1)
      (fun i=>WilsonReceivedCanonicalSocketSeed.contact (D i)) pt
      (fun y=>path (R:=R) drawc fk y.val) (fun y=>location (R:=R) drawc fk y.val c m)
      (fun _=>WilsonReceivedCanonicalSocketSeed.present D) (by intro o i;simpa only [pow_zero,mul_one] using legal i)
    have physical:=heat N per (cf.trans (fk.trans kn))
    exact money.2.2.2.trans (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ physical.1.le physical.2 2) nonnegative))
  have save:margin/2+fee/wilson z r ≤ margin:=by
    have bound:= (le_div_iff₀ (by positivity:0<32*(mass+1))).mp thin
    have one:16*mass*wilson z r ≤ margin/2:=by nlinarith only [bound,gp]
    have square:fee/wilson z r=16*mass*wilson z r:=by
      dsimp only [fee]
      field_simp
      ring
    rw [square]
    linarith only [one]
  filter_upwards [stocked] with pair ok
  obtain ⟨kn,Y,named,located,posted,initial,amount⟩:=ok
  exact ⟨kn,Y,named,located,posted,initial,amount.trans save⟩

end YM.Integration.WilsonOlderFreshSoftSocketOriginalWorkshop
