def Account {G:Gauge}{n e a N:ℕ}{k D:Fin n→ℕ}{R:Run G}{σ:ℝ}
    (V:Realm G (e+1) Credit.leanC)(rate δ:ℝ)(side:Side)(places:Fin n → Cover)
    (H:Material R N a e k σ (binder side places))(test:Case D):Prop:=
  H.realm=V ∧ H.tests=D ∧ H.amplitude=rate ∧ H.allowance=δ ∧
  (∀x s,WilsonOriginalCensusDatedHeldTariff.salary H x s=
    (WilsonIndependentCollarLowerMass.copies (binder side places) s:ℝ)*(‖∏v∈s.val,(x v).val‖*‖touch test s.val‖)) ∧
  ∀l,Real.exp (σ*((binder side places) l).length)*(1+∑a,(words H l).fare a) ≤
    WilsonReceivedDepositedOrbitalBudget.amount H l

variable {G:Gauge}{n e j N K:ℕ}{D k:Fin n→ℕ}{R:Run G}{V:Realm G (e+1) Credit.leanC}
  {draw:V.draws=R.family.path.levels}{rate δ σ σₗ:ℝ}
  (upper:Submitted R V draw D k N K (j+1) rate δ σ)(lower:Submitted R V draw D k N K j rate δ σₗ)
  (cells:Digits V.draws (Fin n))(κ:(v:Fin n)→Knob (D v))(pt:Fin n→Chamber)(seed:(v:Fin n)→Choice R k v)
  (per:ℕ)(y:Fin n → Cover)(t:Case D)(deep:∀s:Hot (Stock.census (Fin n)),0 < mass k s.val.val)
local notation "grid" => coarse R (j+1) per
local notation "sheet" => fine R (j+1) per
local notation "parent" => binder (grid) y
local notation "younger" => chartIn (loose R.family.path.levels (j+1)) y (onLevels draw cells (j+1))
local notation "child" => binder (sheet) (younger)

include upper lower in
theorem original :
    ∃(L:Material R N (j+1) e k σₗ (parent))(test:Case L.tests)(knob:(v:Fin n)→Knob (L.tests v)),
      HEq test t ∧ HEq knob κ ∧ Account V rate δ (grid) y L t ∧ Addressed y L test ∧
      (∀z s,output L.prior s N z=fixed R k knob pt N K (j+1) (onLevels draw cells) seed z s) ∧
      ∃H:Material R N ((j+1)+1) e k σ (child),Account V rate δ (sheet) (younger) H test ∧
        ∃(fund:Paid R H.realm H.start L.tests k H.allowance σ)(closed:Cloze L.tests k H.realm Credit.leanC)
          (X:Input H.realm H.start univ k L.tests H.amplitude),
          H=WilsonReceivedDepositedOrbitalLedger.book R H.realm H.start fund N X H.nonneg H.lower H.radius
            (child) pin (fun _=>subset_univ _) (fun s=>s.property.choose_spec) deep (younger) test closed H.tickets ∧
          ∀z s,output X s N z=fixed R k knob pt N K ((j+1)+1) (onLevels draw cells) seed z s:=by
  obtain ⟨L,realm,tests,amp,slack,named,roots,ink,frills,sales,copy,raw⟩:=
    lower cells κ pt seed _ (grid) (port (grid) y) (parent) pin (fun s=>s.property.choose_spec) deep y t
  subst D
  refine ⟨L,t,κ,HEq.rfl,HEq.rfl,⟨realm,rfl,amp,slack,sales,raw⟩,?_,fun z s=>eq_of_heq (copy z s),?_⟩
  · exact WilsonOriginalCensusFaceIncome.addressed y L t named roots (fun z=>eq_of_heq (ink z)) frills
  obtain ⟨H,realm,tests,amp,slack,sales,raw,installed⟩:=
    WilsonOriginalCensusFaceCapital.original upper cells κ pt seed (sheet) (younger) t deep
  exact ⟨H,⟨realm,tests,amp,slack,sales,raw⟩,installed⟩

