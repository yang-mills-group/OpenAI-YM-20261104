open scoped Classical BigOperators Topology
variable {G:Gauge}{n D h H k u e:ℕ}(R:Run G)(W:Initialize G)(d:Fin (n+1)→ℕ)(fit:∀i,d i<D)
local notation "Q" => named R W (fun _=>false) d fit
local notation "F" i:max => R.family.labels.level (d i)
local notation "L" => R.family.path.levels
local notation "O" => R.metals.O

theorem original (simple:G.Simple)(v:ℕ→Gear G→ℝ)(funded:FundedMarkedCoverRows.prices v R.kit)
    (big:h<H)(rails:Rails h k u e)(cap:capP (deck (G:=G) d (fun _=>D) fit) ≤ k):
    ∃A:(i:Fin (n+1))→Alma (F i)→ℝ, (∀i a,0 ≤ A i a)∧∃M T:Fin (n+1)→Credit,
    ∀ᶠ j₀:ℕ in atTop,∀m K,j₀ ≤ m → m ≤ K → ∀b:Herit Q,
    let fresh (i:Fin (n+1)):Verse (F i):=received L O (Q i) m K K (b i)
    (∀i,ticket L O (Q i) K m K (fresh i)=b i) ∧
    (∀i r,d i ≤ r → projected L O (Q i) m K r (Shrine (plate (R.family.localSection (d i)) (fit i)) (fresh i))=b i) ∧
    (∀i (S:ℝ),0 ≤ S → (∀t ≤ e,∀a,‖coeff t (b i a)‖ ≤ S) → ∀t ≤ e,∀a,
      ‖coeff t (fresh i a)‖ ≤ (M i).buy (age L (zz L) m K)*((Fintype.card (Alma (Q i).F):ℝ)*(T i).buy (zz L m)*S)) ∧
    (∀(φ:Wilt Q)(y:ℝ)(o:CellR)(side:Side),flash ((Ashore Q L O φ (normalized L O Q b m K) m K K y o).1 side)=
      ∏i,stems R W side false (fit i) (fresh i) (φ i) (paceT R.family.path.levels.S m K) y o (d i)) ∧
    ∀N per ear:ℕ,ear ≤ K → K ≤ N → ∀(file:Filed R d K)(Y:∀i,R.family.label (d i))(turn:Fin (n+1)→Extra.Histories.Motion)
      (phase:ℂ→L[ℝ]ℝ)(i:Fin (n+1))(touch:Volume D)(site:Cover),
    ∀(V:Realm G (e+1) Credit.leanC),V.draws=L → V.paid=O → Dormitory V (d i) 0 Credit.leanC →
    V.anchor ≤ ear → ∀z:ℝ,PadRank V ear K z →
    let x:Verse (F i):=WilsonOriginalPhysicalFruitVerse.written (F i) (WilsonPositionProgramReportedField.entire R (d i) K (N,per) (WilsonOriginalObservedRoseCorrectedWords.votes R d (N:=N) (per:=per) file Y turn i)) phase
    let delta:=planted R W false (fit i) touch (x-fresh i) site
    let result (t:Verse (F i)):=cruises L O N (d i) K ear (planted R W false (fit i) touch t site)
    let salary:=‖ContinuousLinearMap.apply ℝ ℝ touch‖*charge e (x-fresh i) (A i)
    result x-result (fresh i)=cruises L O N (d i) K ear delta ∧
    ScalarTrim (result x-result (fresh i)).2=clock L O N K ear (ScalarTrim delta.2)+
      ∑s∈Ico ear K,clock L O N s ear (feed L O N (d i) K s delta) ∧
    ∀j ≤ e,∀θ:ℝ,‖listen j θ (result x)-listen j θ (result (fresh i))‖ ≤ 
      (∑t∈range (j+1),|θ|^t)*((WilsonIndependentCollarOrdinaryWeak.price G (d i) e).buy z*salary):=by
  classical
  choose A nonneg days using fun i=>WilsonOlderFreshSoftSocketVerseHistory.original R W false (fit i) e
  obtain ⟨M,T,_,school⟩:=WilsonIndependentMatchedFreshSection.original R W d fit simple v funded big rails cap
  refine ⟨A,nonneg,M,T,?_⟩
  filter_upwards [school] with j₀ sale
  intro m K live mk b fresh
  obtain ⟨inverse,projection,priced,group⟩:=sale m K live mk b
  refine ⟨inverse,projection,priced,group,?_⟩
  intro N per ear ek kn file Y turn phase i touch site V levels quiet dorm alive z pad x delta result salary
  simpa only [levels,quiet] using days i V dorm N K ear alive ek kn z pad x (fresh i) touch site

end YM.Integration.WilsonOlderFreshSoftSocketMeasuredInverse
