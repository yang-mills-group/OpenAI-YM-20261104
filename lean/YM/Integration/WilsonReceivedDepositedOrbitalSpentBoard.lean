theorem original [Fintype I]{p':Passport n' (Fin n)}{μ:Type}
    (high:μ → Row p' (Stock.census (Fin n)) G (Affinity.Wallet (room (Fin n))))
    (placed:p'=P)(names:μ=((l:I)×((words H) l).Roster))(ink:HEq high (mounts H))
    {w:Fin n → ℝ}{σ₀ expense:ℝ}{order seats shelf:ℕ}
    (stock:Scene.Armada high w k σ₀ expense order seats shelf)(width₀:0 < σ₀)
    (per:ℕ)(tag:(step R j per).Choices)
    {grid:Side}(baseGeometry:n'.val=grid.val*(patch).L.val)(project:grid.val∣(coarse R j per).val)
    (h:n'.val∣(fine R j per).val)(lead:∀s:Finset I,s.Nonempty→s)(x:Affinity.Wallet (room (Fin n)))
    {start e:ℕ}{quiet:ℕ → SeriesA G}{π:ℕ → Layout G}{Γ:ℕ → Pace.Coin}
    (legal:Legal (Step.tape (e+2)) (π (j+1)))
    (course:Read R N start e quiet π Γ)(live:start ≤ j){τ cash:ℝ}
    (funded:Issued R N (j+1) e (quiet (j+1)) τ cash)
    (starts:Γ j 0=0)(r d:ℕ)(retained:r ≤ q)(grade:r ≤ e+2)(kept:d ≤ r)
    (target:(Stock.census (Fin n)).Mode)(v:Stationary.Link G (coarse R j per)):
    let F:=repeatF (step R j per)
    let U:Adjacent.Display (Stationary.Link G (coarse R j per)):=fun l b=>
      let K₀:=model R N j per (show j<N by omega)
      let raw:=Bulk.Fk K₀ F tag (copyColor h high k (fun a=>(high a).paint x) (π (j+1)) (Step.tape (e+2)))
        (Stationary.arm G _ 1 b) r
      (Order.observe (Stock.census (Fin n)) r (Order.logMarked raw) l).part target
    let origin:=fun l:I=>(B l).center
    let digit:=fun l:I=>(Ratio.mk (patch).L baseGeometry:Ratio grid n').residue (origin l)
    let observed:=fun (s₁:Finset I)(sheets:s₁→Fin (Pages n' (fine R j per)))=>
      if keep:s₁.Nonempty then
        let seats₁:=WilsonNeutralTwoPrintPathFineFiber.seats (patch) (step R j per).sizes project h s₁ origin sheets (lead s₁ keep)
        let lower:=spent R (ranks) N j q (coarse R j per) (reprint) seats₁ digit s₁
        Complex.ofReal (diagonal (mass (ranks) s₁+d) (fun a z=>touch (t₁) s₁ (lower d a z))
          ((coordinates G (coarse R j per)) v))
      else (0:ℂ)
    Adjacent.born U ((Rebirth.caliber (Γ j) starts).back (e+2)) 0 r d v=
      ∑s₁:Finset I,wages B x target s₁*∑sheets:s₁→Fin (Pages n' (fine R j per)),observed s₁ sheets:=by
  intro F U origin digit observed
  have highRead:=WilsonReceivedDepositedOrbitalNamedBoard.original R Y lo enrolled N X positive limit width B c inside pin deep
    y t closed tickets old well hs base cover bound high placed names ink stock width₀ per F tag h x
    legal course live funded starts r d retained grade kept target v
  refine highRead.trans (sum_congr rfl (fun s₁ _=>congrArg (wages B x target s₁*·) (sum_congr rfl fun sheets _=>?_)))
  by_cases present:s₁.Nonempty
  · dsimp only [observed]
    rw [dif_pos present]
    exact WilsonReceivedDepositedOrbitalWindingSeat.original (k:=k) B old q c y t R N j per (by omega) tag h
      well hs base cover pin Y.hG baseGeometry project s₁ sheets (lead s₁ present) d (kept.trans retained) v
  · dsimp only [observed]
    rw [dif_neg present]
    have blank:s₁=∅:=Finset.not_nonempty_iff_eq_empty.mp present
    subst s₁
    simp only [WilsonNeutralSignedPolynomialRate.read]
    rw [(WilsonReceivedDepositedOrbitalNamedFiling.course (k:=k) B old q c y t R N j per (by omega) F well hs base cover pin
      (WilsonReceivedDepositedOrbitalFixedLabels.home ∅ h origin sheets) Y.hG).2.1]
    simp

end YM.Integration.WilsonReceivedDepositedOrbitalSpentBoard
