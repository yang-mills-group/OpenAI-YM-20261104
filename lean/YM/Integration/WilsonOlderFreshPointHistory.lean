import YM.Integration.WilsonOlderFreshPointCommission
import YM.Integration.WilsonPointChildWidthHistory
/-! The true all-digit normalized width bound is bought once on the
original quiet bank. Each resulting word catalogue retains the entire
displaced field and its tested angular zero, uniformly over both regulators. -/
set_option autoImplicit false
noncomputable section
namespace YM.Integration.WilsonOlderFreshPointHistory
open Function Filter Finset Lattice Laurent Bloch RG Precision Wilson FormalBulk08
open Next.Free Reef Flat Orb Wick Series Mesa Jets City Cork Bank Wine Dove Dove.Lab
open Exterior Stationary Lotus Shore Gorge Rift Lava Kemp
open Pose Glide Dawn Rial Roof Trellis Aster Borough Elm
open Planned.PrimaryIntegral295 Place Film Carrier Source Source.Drops Labels PowerSeries
open PhysicalNext.Repeat.Legato Next.Foundations PhysicalNext PhysicalNext.Repeat
open RG.Supply Org QuadraticLocal QuadraticLocal.Sunrise QuadraticLocal.Sunrise.Aviary QuadraticLocal.Mentor Push.PriceCompiler
open Primer AllOrder AllOrder.Ink AllOrder.Floe Primitives.TwoWave QuadraticLocal.Poetry
open WilsonOlderFreshGraphSchool WilsonFundedWindowMenu WilsonWindowJointPurchase
open WilsonOlderFreshGraphPainter
open scoped Topology ENNReal BigOperators Classical
variable {G:Gauge} {d D:ℕ} (R:Run G) (L:Primer.Families R.family)
variable (a:hue G) (depth:d<D) (simple:G.Simple)





include simple in
theorem original {φ U:ℕ→ℕ}(I:Unit→Loan)(Q:ℕ)(level:(I ()).toll=d)(d0:0<d)
    (law:VowsR.LawScroll G φ)
    (purchase:Together (@WilsonOlderFreshGraphSchool.grant G φ
       (WilsonOlderFreshGraphMatrixPrice.menu G I d Q level) simple (WilsonOlderFreshGraphMatrixPrice.jointLaw law))
      (@WilsonWindowFormalPurchase.Canonical G U) R.kit)
    (slow:∀j,((R.family.S.block j).val:ℝ)≤Real.log (Lambda R.family.path.levels j))
    (o:Loc G 1)(old:WilsonPointChildWidthHistory.Income R L a depth o Q){η:ℝ}(accuracy:0<η):
    let M:=WilsonOlderFreshGraphMatrixPrice.menu G I d Q level
    let H:=roots M simple R.metals.p R.metals.K
    (∃books,VowsR.Chamber law R.kit H (rollTab M simple R.metals R.rolls) books) ∧
    ∀ᶠj:ℕ in atTop,∀k:ℕ,k ≤ R.alloy.B.a.clock.J j→1 ≤ Burn.horizon k→
      d≤R.family.path.levels.clock.J (j+1)→
      let σ:=Agenda.seed H φ (Burn.horizon k) (R.family.path.levels.clock.J j)
      let β:=R.alloy.B.a.clock.hatBeta j
      ∀(b:Letter (R.family.labels.level d))(p:WilsonOlderFreshPointGauge.Ballot R j D),
        ∃T:WilsonOlderFreshGraphSlate.Copy G d Q σ,
          (∑r,T.fare r)≤Real.sqrt (Real.log β)*(1+(d+Q+1:ℕ)*(β^η*‖p.2‖)) ∧
          WilsonOlderFreshPointCommission.Published R L a depth j b p T:=by
  intro M H
  obtain ⟨h,sale⟩:=WilsonOlderFreshPointCommission.original R L a depth simple I Q level d0 law purchase
  refine ⟨h,?_⟩
  filter_upwards [WilsonPointChildWidthHistory.original R L a depth o simple purchase.2 slow Q old accuracy,
    eventually_ge_atTop 1] with j posted positive
  obtain ⟨i,rfl⟩:=Nat.exists_eq_succ_of_ne_zero (by omega:j≠0)
  intro k fit hk front σ β b p
  have all:=posted p.1.cutoff p.1.live p.1.digit
  have court:=WilsonNeutralPointCourse.original R L a depth p.1.digit p.1.cutoff (i+1) simple o p.1.live front
  have nz:0≤β:=(R.alloy.B.a.fits.delayed (i+1)).le.trans' zero_le_one
  exact sale i k fit hk front o b p (β^η*‖p.2‖) (mul_nonneg (Real.rpow_nonneg nz _) (norm_nonneg _))
    (fun e he r=>all.every court b p.2 e he r.val)

end YM.Integration.WilsonOlderFreshPointHistory
end
