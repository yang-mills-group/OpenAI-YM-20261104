theorem original {start e:ℕ}{Z:ℕ→SeriesA G}{π:ℕ→Layout G}{Γ:ℕ→Pace.Coin}
    (course:Agrees R N start e Z π Γ)(live:start ≤ i)(starts:Γ i 0=0)(simple:G.Simple)
    (s:Finset (Fin n))(r d:ℕ)(through:r≤q)(paid:d≤e+2)(kept:d≤r)(v:Stationary.Link G (coarse R i per)):
    Adjacent.born ((seen) s r) ((Rebirth.caliber (Γ i) starts).back (e+2)) 0 r d v=
      (∏u∈s,(x u).val)*read (coordinates G (coarse R i per)) ((reading (calendar)) s) d v:=by
  have wages:=WilsonVacuumPreResetMeasuredCaliber.settled R course live (by omega : i<N) starts
  have divisor:constantCoeff (dated R N i)=1:=
    (coeff_zero_eq_constantCoeff_apply _).symm.trans ((wages.1 0 (Nat.zero_le _)).symm.trans (Rebirth.caliber (Γ i) starts).starts)
  have stamp:redo (calendar) ((reading 1) s)=(reading (calendar)) s:=by
    apply WilsonOriginalCensusPhysicalReading.reset <;> assumption
  rw [←stamp]
  change _=(∏u∈s,(x u).val)*read _ (redo (Blue.back (dated R N i)) _) d v
  rw [←WilsonCapturedPrimaryWeakTrialClockReversion.dated _ divisor]
  apply WilsonNeutralSignedPolynomialRate.original wages.2.2.2 _ _ _ paid kept
  intro l hl z
  unfold display
  rw [WilsonOriginalCensusPhysicalReading.connected R Y lo enrolled N X positive limit width per y t deep
    closed tickets old well hs base cover bound F x (Stationary.arm G (coarse R i per) 1 (z • v)) tag simple r through]
  exact WilsonReceivedDepositedOrbitalMode.read r _ (wage) (reading 1) s l hl

