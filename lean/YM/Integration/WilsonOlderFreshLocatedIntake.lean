theorem original (simple:G.Simple)(nonbare:i<N)(cap:∀t,‖value A t‖≤1)
    (pass:Pass D Q₀ R.alloy R.kit)
    (late:WilsonMeasuredSemesterSubpower.onset R 1 (half_pos (show (0:ℝ)<1 by norm_num)) ≤ i)
    (T:WilsonOlderFreshGraphSlate.Copy G d Q σ₀)
    (posted:WilsonOlderFreshPointCommission.Published R L a depth (i+1) w (⟨N,nonbare,digit⟩,f) T)
    (seats:1≤op.count)(shape:op.count=school.pieces)(phase:school.order+1≤op.stage)
    (enrolled:Q ≤ school.order)(order:d ≤ school.horizon)(cut:ℕ)
    (width:Sycamore.Boot.need cut school ≤ R.alloy.B.a.clock.J (i+1))(test:Wallet A):
    Integrable (fun U=>((Ψ (i+1)).eval U:ℂ)*
      (Spill.Foundry.uncut (T.rows S A) (Coat.gStep (Ψ (i+1)).beta) test U).part ((Stock.census Unit).fire ())) (prior G _):=by
  obtain ⟨c,amp,_,_,_,_,H,passp,_,_,_,name,model,_⟩:=WilsonOlderFreshPointLanded.original (N:=N)
    R hk D Q₀ π Γ Ψ history scroll books chamber hi warm top school op lesson cal ahead hospital y A
    L a depth w f digit simple nonbare cap (show (0:ℝ)<1 by norm_num) le_rfl
    (half_pos (show (0:ℝ)<1 by norm_num)) pass late T le_rfl posted seats shape phase enrolled order cut width test
  have eq:=WilsonOlderFreshWordReversion.same H.model (T.rows S A) passp name model
  let P(U:Config G (R.family.side (i+1) per)):=Spill.Foundry.uncut (T.rows S A) (Coat.gStep (Ψ (i+1)).beta) test U
  let blank(t:Wallet A)(U:Config G (R.family.side (i+1) per)):=
    ((Ψ (i+1)).eval U:ℂ) • Poly.pass (Spill.Foundry.uncut (T.rows S A) (Coat.gStep (Ψ (i+1)).beta) t U)
  have load:school.pieces≤Burn.horizon k+2:=by obtain ⟨_,_,_,h,_,_⟩:=school;exact h
  have fits:school.order≤Burn.horizon k+1:=by obtain ⟨_,_,_,_,h,_⟩:=school;exact h
  have packed:school.order+school.horizon≤Burn.horizon k+2:=by obtain ⟨_,_,_,_,_,h⟩:=school;exact h
  have income:=WilsonOlderSignedOneMarkAdmitted.original R hk D Q₀ π Γ Ψ history books ahead A
    (fun _:Unit=>(⊥:Submodule ℝ ℂ)) (fun _:Unit=>d) school.order school.horizon school.pieces hi blank H
    nonbare scroll chamber warm top fits load packed cut width test
  let panel(U:Config G (R.family.side (i+1) per)):=Poly.pass (P U)
  have budget:Integrable (fun U=>((Ψ (i+1)).eval U:ℂ) • panel U) (prior G _):=by simpa only [eq] using income
  have read(U:Config G (R.family.side (i+1) per)):(panel U).part ((Stock.census Unit).fire ())=
      (P U).part ((Stock.census Unit).fire ()):=MergeProof.Accent.whisper _ _
        (WilsonOlderFreshWordReversion.quiet (T.rows S A) test (Coat.gStep (Ψ (i+1)).beta) U) ()
  exact (WilsonOlderFreshLocatedFilm.single (d:=d) (p:=per) (i:=i) (N:=N) R 0 1 _ panel _ read budget).1

