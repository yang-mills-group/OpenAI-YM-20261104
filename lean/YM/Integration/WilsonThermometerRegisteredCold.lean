/-- The numerical two-field comparison is tested by the same finite Wilson law at any earlier age,
with an arbitrary integrable older spectator on the original vacuum. -/
theorem original (late:WilsonOriginalThermometerReportedPost.opening R simple (f:=f) (F:=F) fund slow ≤ i)
    (date:A.station.k=i) (checked:A.station.checked f F A.horizon) (near:close R A)
    (shape:op.count=school.pieces) (size:3 ≤ school.pieces) (space:14 ≤ school.horizon)
    (room:WilsonOriginalStarSceneWords.maximum R levels ≤ school.order)
    (opStage:school.order+1 ≤ op.stage) (ranks:6 ≤ R.alloy.B.a.clock.J (i+1))
    (width:Sycamore.Boot.need 0 school ≤ R.alloy.B.a.clock.J (i+2))
    (refs:∀ v,R.family.ref (levels v) ≤ i+2)
    (floor:m ≤ i) (fit:k ≤ R.alloy.B.a.clock.J i)
    (path:PlanV.Path D R.alloy Q (Burn.horizon k) (i+2) m π Γ)
    (pass:Pass D Q R.alloy R.kit) (month:Scholar.Month R.rolls D Q R.alloy.delay)
    (fits:school.order ≤ Burn.horizon k+1) (shelved:school.horizon ≤ R.alloy.B.a.clock.J m)
    (load:school.pieces ≤ Burn.horizon k+2) (packed:school.order+school.horizon ≤ Burn.horizon k+2)
    (tender:WilsonReceivedMeasuredStampPrice.opening R simple q school.order k
      (show 2*q+8 ≤ school.order from by omega) (show q+3 ≤ 3*k+2 from by omega) zero_lt_one ≤ m+1)
    (held:0 < i) (fieldDate:WilsonThermometerRegisteredOrdinary.opening R simple (f:=f) (F:=F) fund slow ≤ i)
    (heard:WilsonThermometerRegisteredPair.opening R simple D school strip q 0 deep aged 1 1 zero_le_one
      (ε:=1) zero_lt_one ≤ i)
    (p:ℕ) (surplus:q=WilsonThermometerRegisteredRate.order (p+1) (e₀)+1)
    (heat:warmDate R simple ≤ m) (funded:priceDate R simple school (p+1) (e₀) ≤ i)
    (rootFee:WilsonMovingMentorRootRadius.Income (M:=R.metals) D φ R.alloy.delay)
    (stencil:reach R ≤ R.alloy.B.a.clock.J (i+2)+1)
    (volume:Volume.Fund D R.rolls Q φ books R.alloy.delay)
    (J:Voice G) (clear:Clear G J) (axes:Lattice.Order)
    (dw:2*((WilsonThermometerRegisteredRent.grade p)+1)+8 ≤ school.order) (aw:(WilsonThermometerRegisteredRent.grade p)+4 ≤ 3*k+2)
    (window:max (WilsonJointAxialRoster.opening R simple fund slow.2 J clear (Fintype.card (Fin 3)) degreeCap (WilsonThermometerRegisteredRent.grade p) (WilsonThermometerRegisteredRent.positive p))
      (WilsonReceivedAxialFiling.opening R simple D φ strip school.order school.horizon (Fintype.card (Fin 3)) (WilsonThermometerRegisteredRent.positive p)) ≤ i)
    (shapeWindow:max (WilsonReceivedAxialFinite.opening R simple (WilsonThermometerRegisteredRent.grade p) (WilsonThermometerRegisteredRent.positive p))
      (WilsonReceivedAxialFinite.massOpening R D levels school.order school.horizon school.pieces (k:=k) simple strip) ≤ i)
    (paidWindow:WilsonThermometerRegisteredWindow.opening R simple D school.order school.horizon school.pieces
      strip (WilsonThermometerRegisteredRent.grade p) dw aw (WilsonThermometerRegisteredRent.positive p) ≤ i)
    (dp:2*((WilsonThermometerRegisteredRent.grade p)+1+1)+8 ≤ school.order) (ap:((WilsonThermometerRegisteredRent.grade p)+1+1)+3 ≤ 3*k+2)
    (enrolled:booking R simple D school (f:=f) (F:=F) fund slow strip p rootFee dp ap ≤ i)
    (paid:WilsonThermometerRegisteredRent.opening R simple p school.pieces ≤ i)
    (y:T₀×T₀) :
    ∃ P:WilsonOriginalReceivedChain.Post (N:=i+2) R hk D Q π Γ Ψ books ahead
      WilsonThermometerCourseHearing.disks S₀ levels school.order school.horizon school.pieces i floor
      (WilsonThermometerCourseHearing.offered R A simple (earlier) (placement (R:=R) (N₀) y)),
    let V:=P.passport.coarser (R.family.path.levels.clock.op i per).ratio
    let H:=radius R (invoice (Fintype.card (Fin 3)) ((WilsonThermometerRegisteredRent.grade p)+2*degreeCap)) 1 i
    let r:=amplitude R J H (i+2) per i
    let h:=(WilsonDegreeFourInheritedRange.height R ((WilsonThermometerRegisteredRent.grade p)+2*degreeCap) i)*(4*(Ψ i).p.B+2)+2*(Ψ i).p.B+1
    let tau:=angularCut (R.family.path.levels.clock.hatBeta i)
    let cold:=House.chilly (G:=G) (plaquettes V.origin H) tau
    let link (U:Config G (R.family.side i per)):=
      WilsonCapturedPrimaryPotential.potential g₁ (r • WilsonJointAxialWindow.direction V.origin h J axes r U)
    let C₀:=max 0 (2*WilsonThermometerRegisteredRent.invoice p+price (rate R) (K₀) (p+1) (e₀))
    ∀ t a b:Fin 3, a≠b → a≠t → b≠t →
      let x:=without t
      let s:(J₀).Mode:=⟨{a,b},mem_univ _⟩
      let student:=Oak.student (n:=per) R hk D Q π Γ books floor P.op P.lesson ahead
        WilsonThermometerCourseHearing.disks P.model school.order P.voter
      let nominal (U:Config G (R.family.side i per)):=
        (Poly.pass (bare (rendered student (Ψ i).p (Coat.gStep (Ψ (i+1)).beta)) x U)).part s
      let source:=cold.indicator (fun U=>nominal U-
          WilsonThermometerRegisteredCompact.prescribed R A π Γ school t a b (link U) y)
      Measurable source ∧ (∀ U,‖source U‖ ≤ C₀*g₁^(p+1)) ∧
        WilsonThermometerCompulsoryReturn.Heard R (top:=i+2) source (C₀*g₁^(p+1)) := by
  obtain ⟨P,paid⟩:=WilsonThermometerRegisteredHeard.original R simple A hk D Q π Γ Ψ history
    scroll books chamber hi warm top school op lesson cal ahead hospital fund slow strip q deep aged
    late date checked near shape size space room opStage ranks width refs floor fit path pass month fits
    shelved load packed tender held fieldDate heard p surplus heat funded rootFee stencil volume J clear
    axes dw aw window shapeWindow paidWindow dp ap enrolled paid y
  refine ⟨P,?_⟩
  intro V H r h tau cold link C₀ t a b ab at' bt' x s student nominal source
  let o:=placement (R:=R) (N₀) y
  let base:=WilsonThermometerCourseHearing.offered R A simple (earlier) o
  let lamps:=rendered student (Ψ i).p (Coat.gStep (Ψ (i+1)).beta)
  have Gs:=WilsonReceivedSourceGross.landed R hk D Q π Γ Ψ books floor ahead
    WilsonThermometerCourseHearing.disks S₀ levels school.order school.horizon school.pieces base P
  letI : Countable P.modelIndex := P.modelCount
  letI students : Countable (Scene.Texts P.model
    (Pane.panel R.alloy i (R.alloy.B.a.S.oneStep i per).exact_size).ratio
    (Cruise.publish D R.rolls Q R.alloy φ books P.op (Oak.era R hk D Q π Γ floor P.op P.lesson)
      (R.alloy.B.a.S.oneStep i per).exact_size P.model school.order P.voter P.lesson.entry)) := Scene.crewC P.model
    (Pane.panel R.alloy i (R.alloy.B.a.S.oneStep i per).exact_size).ratio
    (Cruise.publish D R.rolls Q R.alloy φ books P.op (Oak.era R hk D Q π Γ floor P.op P.lesson)
      (R.alloy.B.a.S.oneStep i per).exact_size P.model school.order P.voter P.lesson.entry)
    (Cruise.funded D R.rolls Q R.alloy φ books P.op (Oak.era R hk D Q π Γ floor P.op P.lesson)
      (R.alloy.B.a.S.oneStep i per).exact_size P.model school.order P.voter P.lesson.entry P.lesson.studied ahead)
  have left:Measurable nominal:=@WilsonReceivedWholeFieldHot.borel _ _ _ _ _ _ _ _ _ _ lamps _ _ _
    P.issued.earning.positive (show 0 ≤ (Ψ i).p.supportExponent+1+1 by linarith only [(Ψ i).p.exponent_pos])
    Gs students x s
  have smooth:=WilsonThermometerRegisteredMeasurable.original R simple A hk D Q π Γ Ψ history scroll
    books chamber hi warm top school op lesson cal ahead hospital fund slow q deep aged late date checked
    near shape size space room opStage ranks width refs floor path pass month fits shelved load packed
    tender heat y t a b
  have ml:Measurable link:=by
    have angular:=(Stationary.arm G (R.family.side i per) 1).symm.continuous.measurable.comp
      (WilsonJointAxialHearing.measuredAngle V.origin h J clear axes r g₁)
    simpa only [WilsonJointAxialHearing.angleOf, Function.comp_def,ContinuousLinearEquiv.symm_apply_apply] using angular
  have meas:Measurable source:=(left.sub (smooth.measurable.comp ml)).indicator (House.bath _)
  have gn : 0 ≤ g₁^(p+1) := pow_nonneg (inv_nonneg.mpr (Real.sqrt_nonneg _)) _
  have bound (U) : ‖source U‖ ≤ C₀*g₁^(p+1):=by
    by_cases hc:U∈cold
    · rw [show source U=_ from Set.indicator_of_mem hc _]
      exact (paid U hc t a b ab at' bt').trans (mul_le_mul_of_nonneg_right (le_max_right ..) gn)
    · rw [show source U=0 from Set.indicator_of_notMem hc _,norm_zero]
      exact mul_nonneg (le_max_left ..) gn
  exact ⟨meas,bound,WilsonThermometerEarlierHearing.original R (by omega) meas bound⟩

end YM.Integration.WilsonThermometerRegisteredCold
