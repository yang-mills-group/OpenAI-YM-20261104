def Purchased (R:Run G)(l:Filter (ℕ×ℕ))(D:Fin 3→ℕ)(pt:Fin 3→Chamber)(φ:Test 3)
    (dates:Fin 3→ℕ)(labels:∀i:Fin 3,ℕ×ℕ→R.family.label (ages i))(M:Fin 3→ℝ)
    (r γ:ℝ)(sensor:ℂ)(margin:ℝ){u f K:ℕ}(uf:u ≤ f)(fk:f ≤ K)(c m Q J₀ requested tag target src apron:ℕ)
    (plan:Plan 3){top:ℕ}{Vc:Realm G (top+1) Credit.leanC}(drawc:Vc.draws=R.family.path.levels)
    (w:ℕ){day:ℕ}{tol:ℝ}(office:Badge R D Q (m+1) day 1 tol):Prop:=
  ∀program:Program R ages K,∃file:Filed R ages K,(∀i,file.station i=dates i) ∧ file.target=target ∧
    (∀N per wallet seats j,j < K →file.row N per wallet seats j=WilsonMovingForkPrintedFile.row program N per wallet seats j) ∧
    Settled R l D pt φ dates labels M r γ sensor (margin/2) margin uf fk c m Q J₀ requested tag src apron plan file drawc w office

def Previous {T:ℕ}{δ:ℝ}(books:(s:{s:ℝ//0<s ∧ s<δ})→Book F (l:=l) H z 6 T s.val) (reserve infrared requested t sourceFloor fileTariff apron J₀ Q:ℕ)
    (M:Fin 3→ℝ)(D:Fin 3→ℕ)(pt:Fin 3→Chamber)(tol:ℝ)(plan:Plan 3):Prop:=
    ∀(level:ℕ),0 < level→∃band:WilsonPositionProgramReporterBand.Band R Z.run level,
    ∀ᶠstartLevel:ℕ in atTop,∃u₀:ℕ,startLevel ≤ u₀ ∧ Stop (C) 0 startLevel u₀ ∧
    ∃move:WilsonIndependentCapturedPages.Stop R Z.run band u₀ infrared,∃shelf:ℕ,
    ∀ᶠanchor:ℕ in atTop,∃top:ℕ,∃Vc:Realm G (top+1) Credit.leanC,∃drawc:Vc.draws=P,
    Vc.paid=R.metals.O ∧ Vc.anchor=anchor ∧ ∀(margin:ℝ),0< margin →
    ∀ᶠr in trail,∀ρ:Fin 3→{s:ℝ//0 < s ∧ s < δ},(∀i,(ρ i).val=r)→
    let f:=reporter F books ρ
    let K:=berth R reserve f
    let c:=WilsonReceivedChronologicalFixedCellFee.capture R roseTest r
    let L:=fun i=>home F Jr Z (books (ρ i)) (grade i) (publicHead i)
    ∃w:ℕ,c=band.reporter+w ∧
    let m:=move.date w-1
    ∃_date:m+1=move.date w,∃old:u₀ ≤ m,∃crossing:m+1 < c,∃upper:c < f,∃fk:f < K,
    shelf+1 ≤ c ∧ level ≤ m+1 ∧
    WilsonAddressedPublicFirstRoseTicket.Receipt R (WilsonAddressedPublicFirstSites.original R drawc roseTest).choose
      (WilsonReceivedChronologicalFixedCellFee.factor R roseTest) r (wilson z r) m f K c plan.width ∧
    ∃(V:Realm G (Q+1) Credit.leanC)(draw:V.draws=P),V.paid=R.metals.O ∧ V.y=zz P ∧ V.anchor=m+1 ∧
      Covered R D Q (m+1) shelf V draw 1 tol ∧ (∀s:Faces,s.Nonempty → Stock R D Q (m+1) shelf V draw 1 tol s) ∧
    ∃src:ℕ,sourceFloor ≤ src ∧ u₀ ≤ src ∧ src+2 ≤ f ∧
    OnFile R (l:Filter _) D pt roseTest (fun i=>(L i).j) (fun i=>(L i).arm.source) M
      r (wilson z r) (WilsonOriginalTwoFlatIRPoolFirstSignal.smooth F Jr Z publicHead roseTest r)
      margin (old.trans ((Nat.le_succ m).trans (crossing.le.trans upper.le))) fk.le
      c m Q J₀ requested t fileTariff src apron plan drawc

def Continued {T:ℕ}{δ:ℝ}(books:(s:{s:ℝ//0<s ∧ s<δ})→Book F (l:=l) H z 6 T s.val) (reserve infrared requested t sourceFloor fileTariff apron J₀ Q:ℕ)
    (M:Fin 3→ℝ)(D:Fin 3→ℕ)(pt:Fin 3→Chamber)(tol:ℝ)(plan:Plan 3) (wStop:ℕ→ℕ)(day onset:ℕ)(school:(v:ℕ)→ onset ≤ v → Badge R D Q v day 1 tol)(floor:ℕ):Prop:=
  ∀(level:ℕ),floor ≤ level → 0 < level → ∃band:WilsonPositionProgramReporterBand.Band R Z.run level,
    ∀ᶠstartLevel:ℕ in atTop,∃u₀:ℕ,startLevel ≤ u₀ ∧ Stop (C) 0 startLevel u₀ ∧
    ∃move:WilsonIndependentCapturedPages.Stop R Z.run band u₀ infrared,∃shelf:ℕ,
    ∀ᶠanchor:ℕ in atTop,∃top:ℕ,∃Vc:Realm G (top+1) Credit.leanC,∃drawc:Vc.draws=P,
    Vc.paid=R.metals.O ∧ Vc.anchor=anchor ∧ ∀(margin:ℝ),0< margin →
    ∀ᶠr in trail,∀ρ:Fin 3→{s:ℝ//0 < s ∧ s < δ},(∀i,(ρ i).val=r)→
    let f:=reporter F books ρ
    let K:=berth R reserve f
    let c:=WilsonReceivedChronologicalFixedCellFee.capture R roseTest r
    let L:=fun i=>home F Jr Z (books (ρ i)) (grade i) (publicHead i)
    ∃w:ℕ,c=band.reporter+w ∧
    let m:=move.date w-1
    ∃_date:m+1=move.date w,∃old:u₀ ≤ m,∃crossing:m+1 < c,∃upper:c < f,∃fk:f < K,
    shelf+1 ≤ c ∧ level ≤ m+1 ∧ m+1 ≤ wStop c ∧ wStop c ≤ c ∧
    WilsonAddressedPublicFirstRoseTicket.Receipt R (WilsonAddressedPublicFirstSites.original R drawc roseTest).choose
      (WilsonReceivedChronologicalFixedCellFee.factor R roseTest) r (wilson z r) m f K c plan.width ∧
    ∃(V:Realm G (Q+1) Credit.leanC)(draw:V.draws=P),V.paid=R.metals.O ∧ V.y=zz P ∧ V.anchor=m+1 ∧
      Covered R D Q (m+1) shelf V draw 1 tol ∧ (∀s:Faces,s.Nonempty → Stock R D Q (m+1) shelf V draw 1 tol s) ∧
    ∃src:ℕ,sourceFloor ≤ src ∧ u₀ ≤ src ∧ src+2 ≤ f ∧
    ∃entered:onset ≤ m+1,Purchased R (l:Filter _) D pt roseTest (fun i=>(L i).j) (fun i=>(L i).arm.source) M
      r (wilson z r) (WilsonOriginalTwoFlatIRPoolFirstSignal.smooth F Jr Z publicHead roseTest r)
      margin (old.trans ((Nat.le_succ m).trans (crossing.le.trans upper.le))) fk.le
      c m Q J₀ requested t fileTariff src apron plan drawc (wStop c) (school (m+1) entered)

def Income {T:ℕ}{δ:ℝ}(books:(s:{s:ℝ//0<s ∧ s<δ})→Book F (l:=l) H z 6 T s.val) (reserve J₀ Q:ℕ)(D:Fin 3→ℕ)(tol:ℝ)(plan:Plan 3) (wStop:ℕ→ℕ)(day onset:ℕ)(school:(v:ℕ)→ onset ≤ v → Badge R D Q v day 1 tol)(floor:ℕ)
    (enter:∀v:ℕ,floor ≤ v → onset ≤ v):Prop:=
    ∀(margin:ℝ),0 < margin → ∀ᶠr in trail,∀(v:ℕ)(mature:floor ≤ v),∀ρ:Fin 3 → {s:ℝ//0<s ∧ s<δ},(∀i,(ρ i).val=r) →
    let f:=reporter F books ρ
    let K:=berth R reserve f
    let c:=WilsonReceivedChronologicalFixedCellFee.capture R roseTest r
    let slots i:=WilsonOriginalObservedRosePooledPurse.reading F Jr Z (books (ρ i)) (grade i) (publicHead i)
    ∀(m:ℕ)(atv:v=m+1)(u₀:ℕ)(uf:u₀ ≤ f)(fk:f ≤ K),c ≤ f  →  f<K  →  v ≤ c  →  v ≤ wStop c  →  v+1 ≤ K  → 
    σ K-σ (v-1) ≤ (plan.width:ℝ)*(1+Real.log (β v))  → 
    (∀N per:ℕ,c ≤ N → 0<g N per v ∧ g N per v ≤ 4*wilson z r)  → 
    ∀(requested tag src apron:ℕ)(pt:Fin 3 → Chamber)(M:Fin 3 → ℝ)(file:Filed R ages K)
      (sensor:ℂ){top:ℕ}{Vc:Realm G (top+1) Credit.leanC}(drawc:Vc.draws=P),
    Closed R (l:Filter _) D pt roseTest (fun i=>(slots i).j) (fun i=>(slots i).arm.source) M r (wilson z r) sensor
      (margin/2) uf fk c m Q J₀ requested tag src apron plan file drawc  → 
    WilsonOlderFreshSoftSocketOriginalFolio.Settled R (l:Filter _) D pt roseTest (fun i=>(slots i).j)
      (fun i=>(slots i).arm.source) M r (wilson z r) sensor (margin/2) margin uf fk c m Q J₀ requested tag src apron plan file drawc
      (wStop c) (atv ▸ school v (enter v mature))

theorem purchased (simple:G.Simple)(slow:WilsonWindowReportingPace.Slow R.kit) {T:ℕ}{δ:ℝ}(books:(s:{s:ℝ//0<s ∧ s<δ})→Book F (l:=l) H z 6 T s.val) (reserve infrared requested t sourceFloor fileTariff apron J₀ Q:ℕ)
    (M:Fin 3→ℝ)(D:Fin 3→ℕ)(pt:Fin 3→Chamber)(tol:ℝ)(plan:Plan 3)
    (reach:ℕ)(charge:ℝ)(ng:0 ≤ charge)(deep:8*(2*⌈charge⌉₊+1) ≤ 2*infrared)
    (day onset:ℕ)(school:(v:ℕ) → onset ≤ v → Badge R D Q v day 1 tol)(floor:ℕ)(enter:∀v:ℕ,floor ≤ v → onset ≤ v)
    (rows:Income F Jr Z books reserve J₀ Q D tol plan (date R reach charge) day onset school floor enter)
    (entry:Previous F Jr Z books reserve infrared requested t sourceFloor fileTariff apron J₀ Q M D pt tol plan):
    Continued F Jr Z books reserve infrared requested t sourceFloor fileTariff apron J₀ Q M D pt tol plan
      (date R reach charge) day onset school floor:=by
  classical
  intro level mature levelp
  obtain ⟨band,started⟩:=entry level levelp
  refine ⟨band,?_⟩
  filter_upwards [started] with startLevel staffed
  obtain ⟨u₀,oldEnough,stopped,move,shelf,staff⟩:=staffed
  obtain ⟨offset₀,shared⟩:=eventually_atTop.1
    (WilsonMovingForkSharedCapture.original R simple slow reach charge ng Z.run band move deep)
  refine ⟨u₀,oldEnough,stopped,move,shelf,?_⟩
  filter_upwards [staff] with anchor fiscal
  obtain ⟨top,Vc,drawc,oil,counter,here⟩:=fiscal
  refine ⟨top,Vc,drawc,oil,counter,?_⟩
  intro margin mp
  have arrived:∀ᶠr in trail,band.reporter+offset₀ ≤ WilsonReceivedChronologicalFixedCellFee.capture R roseTest r:=
    (WilsonAddressedPublicFirstRoseMovingDate.cofinal R roseTest).eventually (eventually_ge_atTop _)
  filter_upwards [here (margin/2) (half_pos mp),rows margin mp,arrived] with r shelter withdraw past
  intro ρ equal f K c slots
  obtain ⟨w,placement,_date,old,crossing,upper,fk,high,levelv,ticket,V,draw,rent,thermal,whereAt,cover,stock,src,srcFloor,exposed,before,files⟩:=shelter ρ equal
  let m:=move.date w-1
  change c=band.reporter+w at placement
  have ready:offset₀ ≤ w:=by change band.reporter+offset₀ ≤ c at past;omega
  obtain ⟨first,second,_⟩:=shared w ready
  rw [← placement] at first second
  have got:m+1 ≤ date R reach charge c:=_date.le.trans first
  have thisDay:floor ≤ m+1:=mature.trans levelv
  refine ⟨w,placement,_date,old,crossing,upper,fk,high,levelv,got,second,ticket,V,draw,rent,thermal,whereAt,
    cover,stock,src,srcFloor,exposed,before,enter (m+1) thisDay,?_⟩
  intro program
  obtain ⟨file,dated,requestedFee,printed,original⟩:=files program
  refine ⟨file,dated,requestedFee,printed,?_⟩
  have actual:=withdraw (m+1) thisDay ρ equal m rfl u₀ (old.trans ((Nat.le_succ m).trans (crossing.le.trans upper.le))) fk.le upper.le fk
    crossing.le got (Nat.succ_le_of_lt (crossing.trans (upper.trans fk))) (by simpa only [Nat.add_sub_cancel] using ticket.span)
    ticket.heat
    requested t src apron pt M file _ drawc original
  exact actual

