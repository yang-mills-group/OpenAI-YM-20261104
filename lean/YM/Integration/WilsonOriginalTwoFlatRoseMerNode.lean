theorem original (old:age<top)(order shelf:ℕ)(income:Fin 3→ℝ)(tol:ℝ)
    (posted:∀s y,WilsonOriginalCensusMaterialPosting.Posted R hk D Q π Γ Ψ books hi op lesson ahead
      ((ports) s y) ((binders) s y) grades order shelf q income (M s y) tol)
    (filed:∀s y,Filed (K:=top) (draw:=draw) (rate:=rate) (δ:=δ) (restore)
      κ pt (full R grades y) (side) (home s) t (M s y))
    {u:ℕ}(uc:u≤cap)(vc:age≤cap)(ck:cap≤top)
    (reg:∀s:FC,∀j:ℕ,min u (age)≤j→j≤top→Integrable (numerator R N per j ((held s) j)) (prior G _))
    (hg:0≤g)(small:g≤1)(p:ℕ)(degree:p≤q):
    ‖(readAt)-WilsonPositionThermometerConnected.value (fun s:FC=>trueAt p s)-
      ∑s:FC,(charge p s)*(invoice u uc vc ck s)‖≤g^(p+1)*∑s:FC,‖charge p s‖*(gross s):=by
  have same:(fun s:FC=>nativeAt p s)=(fun s:FC=>trueAt p s):=by
    funext s
    apply Finset.sum_congr rfl
    intro y _
    apply congrArg ((wallet) (seat s) y * ·)
    exact WilsonOriginalTwoFlatIRFlatActive.original κ pt (restore) (full R grades y) (home (seat s)) t
      (M (seat s) y) simple vc ck upper (filed (seat s) y) (fun a=>(x (seat s) y a).val) g p degree s
  rw [←same]
  exact WilsonOriginalTwoFlatRoseFlatPrice.original R hk D Q π Γ Ψ course books hi cut op lesson ahead
    grades o v c (ports) (binders) q M x previous upper A₀ old order shelf income tol posted
    uc vc ck reg hg small p

