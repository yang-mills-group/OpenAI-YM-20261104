private theorem room (simple:G.Simple){K c v:ℕ}(vc:v≤c)(L:ℕ)(span:σ K-σ v≤(L:ℝ)*Real.log (β v)):
    (a c)/(a K)≤(β c)^L ∧ σ K-σ v≤(L:ℝ)*(1+Real.log (β (v+1))):=by
  have pos (i:ℕ):0<β i:=zero_lt_one.trans ((P).fits.delayed i)
  have hmono:=WilsonStartup.Timing.hat_mono (P) (Gauge.slopeConstant_pos simple).le
  have upper:(a c)/(a K)≤(a v)/(a K):=by
    exact div_le_div_of_nonneg_right (R.family.S.strictAnti.antitone vc) (R.family.S.a_pos _).le
  have distance:σ K-σ v=Real.log ((a v)/(a K)):=by
    rw [Schedule.scale,Schedule.scale,Real.log_inv,Real.log_inv,Real.log_div (R.family.S.a_pos _).ne' (R.family.S.a_pos _).ne']
    ring
  constructor
  · apply upper.trans
    apply (Real.log_le_log_iff (div_pos (R.family.S.a_pos _) (R.family.S.a_pos _)) (pow_pos (pos _) _)).mp
    rw [←distance,Real.log_pow]
    exact span.trans (mul_le_mul_of_nonneg_left (Real.log_le_log (pos _) (hmono vc)) (by positivity))
  · apply span.trans
    apply mul_le_mul_of_nonneg_left _ (by positivity)
    linarith [Real.log_le_log (pos _) (hmono (Nat.le_succ v))]

theorem original (Φ:Test 3)(simple:G.Simple)(bliss:Bliss F l z H)(lead:Leading F Jr)
    (obedient:∀d:ℕ,∀ᶠr in trail,Frame.obedient F H (Jr r) d)
    (slow:WilsonWindowReportingPace.Slow R.kit)(shop:RG05Preconstruction.ReadoutPurchase R.b)
    (cap:∀j,1≤((P).budget j).supportExponent)(upper:∀j,((P).budget j).supportExponent≤100)
    (quote:OPE.Therm.Poetry (P))(color:G.ColorIndex)
    (funded:WilsonOriginalAllOrderCourse.Paid.{u} axis simple ε (prepared schedule) R crop W)
    (paths:FundedOriginalVacuumPaths.prices R.kit):
    ∃edge:ℝ,0<edge ∧ ∃bank:ℕ,∀(target width:ℕ)(debt:Fin 3→ℕ),∃U:Set ℝ,U∈trail ∧
    let J₀:=cut (target+1) bank ((∑i,debt i)+1) width
    let lower:=J₀+9
    ∀L:ℕ,∀D:Fin 3→ℕ,(∀i,ages i<D i) → ∀(caps:Fin 3→ℝ)(opt tol:ℝ),0≤opt → 0<tol →
    ∃bottom onset:ℕ,∃school:(v:ℕ)→ onset≤v→WilsonOriginalObservedRoseProbeShelf.Badge R D lower v bottom opt tol,
    ∀(power stopOrder:ℕ),let wStop:=date R L (loss R power stopOrder)
    Tendsto wStop atTop atTop ∧ ∀Q:ℕ,lower≤Q → ∃start:ℕ,∀ᶠv:ℕ in atTop,∃(entered:onset≤v),
    ∃(V:Realm G (Q+1) Credit.leanC)(draw:V.draws=P),
    V.paid=R.metals.O ∧ V.y=zz P ∧ V.anchor=v ∧ Covered R D Q v start V draw opt tol ∧
    (∀s:Finset (Fin 3),s.Nonempty → Stock R D Q v start V draw opt tol s) ∧
    ∀r∈U,∀{T:ℕ}(B:Book F (l:=l) H z 6 T r),WilsonMovingForkWindowBooks.Priced F B →
    ∀actual:Next.UVStress.Lifts (C) B.k,let K:=berth R width B.W.k
    v≤B.W.k → ∀(N per b c requested tag:ℕ)(credit:ℝ)(bk:b≤K)(kn:K≤N),b<N →
    v≤wStop c → v≤c → ∀(live:c≤K),v+1≤K → σ K-σ v≤L*Real.log (β v) →
    let θ:=g N per v
    ∀(q₁:ℕ)(W:Realm G (q₁+1) Credit.leanC)(source:W.draws=(P))(first:ℕ),first+1≤v →
    ∀(file:Filed R ages K),0<r→(a) b≤r→4*(edge*r)<(a) c→
    let μ:=WilsonThermometerAlignedCells.mass (R:=R) r (b,per) Φ
    let Active:Type:={y:Site ((C).side b per) × Site ((C).side b per) // μ y≠0}
    ∀(panel:(o:Active)→{Z:Panel R ages N per b K bk kn requested power tag credit // Z.loc=atOrigin o.val}),
    (∀o,(panel o).val.slot=file.station) → (∀o,(panel o).val.axis=file.A N per) →
    (∀o i,(panel o).val.slot i=B.W.k) →
    (∀o i,(panel o).val.names i=WilsonNeutralOffsetCutoff.named R (group F Jr Z B actual) N per i) →
    ∀(κ:(i:Fin 3)→Knob (D i))(pt:Fin 3→Chamber)
      (test:Active→Case D),(∀o i,‖test o i‖≤caps i*(θ⁻¹)^debt i) →
    let filed o:=tape source bk (panel o).val.loc
    let cells o:=onLevels source (filed o)
    let pins o:=address (P) (cells o) (c-v) v (homes (V:=W) (filed o) 0 first (v-1-first))
    let w o:=votes R ages (N:=N) (per:=per) file (panel o).val.names (panel o).val.turn
    let row j o s:=figure R ages κ pt N per K c v (cells o) s (w o) (pins o) (touch (test o) s) j θ
    let office:=school v entered
    let branchTest (o:Active)(s:Faces):=touch (fun i:s=>test o i.val) (univ:Finset s)
    let sourceSite (o:Active):=WilsonOriginalMicroscopicEntranceGridRow.pin R (bk.trans kn) (atOrigin o.val)
    let probe (o:Active)(s:Faces):=WilsonOlderFreshSoftRoseNodes.enrolled R D office.field office.draw N per c
      (live.trans kn) ((sourceSite o) 1,(sourceSite o) 2) s
      (WilsonOriginalObservedRoseProbePlace.ticket D s κ pt (test o))
    let occupied (o:Active)(s:Faces):=(WilsonOriginalObservedRoseProbeRead.quota (branchTest o s):ℂ)*
      WilsonOriginalObservedRoseHaarProbe.priced R D office.field s N K c v (probe o s) (g N per K)
        (fun i=>WilsonPositionProgramReportedField.entire R (ages i) K (N,per) (w o i)) lower θ
    let raw:=∑o:Active,μ o.val*((r:ℂ)^14*value (row Q o))
    let low:=∑o:Active,μ o.val*((r:ℂ)^14*value (occupied o))
    let stopped (o:Active)(s:Faces):=(WilsonOriginalObservedRoseProbeRead.quota (branchTest o s):ℂ)*
      WilsonOlderFreshSoftRoseMarket.row (R:=R) D office.field s N K c (wStop c) v (probe o s) (g N per K)
       (fun i=>WilsonPositionProgramReportedField.entire R (ages i) K (N,per) (w o i)) lower θ true
    let ended:=WilsonOlderFreshSoftSocketStationPortfolio.reading (fun o:Active=>μ o.val) ((r:ℂ)^14) stopped
    let salary:ℝ:=(max 1 credit)^3*(2:ℝ)^WilsonOlderFreshSoftSocketStationPanelPower.debt R power*(g N per K)^stopOrder
    (∀(o:Active)(s:Faces) b,WilsonCoeffUV.Mer.Auth (WilsonCoeffUV.Wheel.Mark.mass (WilsonOlderFreshSoftRoseCourse.grade ∘ seat s) (Finset.univ:Finset s))
      (WilsonOriginalObservedRoseHaarProbe.source R D office.field s N K c (probe o s) (XSpace.Bare.chart G) b)) ∧
    (∀o s,WilsonOriginalObservedRoseProbeRead.quota (branchTest o s)≤
      (∏i∈s,max 1 (caps i))*(θ⁻¹)^(∑i∈s,debt i)) ∧ ‖raw-low‖≤(∫z:Points 3,‖Φ z‖)*θ^target ∧
    ‖raw-ended‖≤(∫z:Points 3,‖Φ z‖)*θ^target+
      WilsonOlderFreshSoftSocketStationPortfolio.wallet (fun o:Active=>μ o.val)
        (fun o s=>(WilsonOriginalObservedRoseProbeRead.quota (branchTest o s):ℂ)) ((r:ℂ)^14) occupied stopped salary:=by
  classical
  obtain ⟨wall,positive,bank,market⟩:=WilsonOriginalObservedRoseEnrolledMarket.original F Jr Z Φ
    simple bliss lead obedient slow shop cap upper quote color funded paths
  refine ⟨wall,positive,bank,?_⟩
  intro target width debt
  obtain ⟨U,valid,next⟩:=market target width debt
  refine ⟨U,valid,?_⟩
  intro J₀ lower L D fits caps opt tol op tp
  obtain ⟨bottom,onset,school,offer⟩:=next L D fits caps opt tol op tp
  refine ⟨bottom,onset,school,?_⟩
  intro power stopOrder wStop
  obtain ⟨grows,stage,issued⟩:=WilsonOlderFreshSoftSocketStationPortfolio.original R simple slow D lower L power stopOrder L (by positivity)
  refine ⟨grows,?_⟩
  intro Q retained
  obtain ⟨start,bought⟩:=offer Q retained
  refine ⟨start,?_⟩
  filter_upwards [bought,Filter.eventually_ge_atTop stage] with v book late
  obtain ⟨entered,V,draw,scheme,heat,anchor,covered,stock,read⟩:=book
  refine ⟨entered,V,draw,scheme,heat,anchor,covered,stock,?_⟩
  intro r hr T B priced actual K birth N per b c requested tag credit bk kn deep vw vc ck vk span θ
    q₁ W source first active file rp fine inside μ Active panel stations axes seats names κ pt test tested
    filed cells pins w row office branchTest sourceSite probe occupied raw low stopped ended salary
  have physical:=read r hr B priced actual birth N per b c requested power tag credit bk kn deep vc ck vk span
    q₁ W source first active file rp fine inside panel stations axes seats names κ pt test tested
  obtain ⟨authority,cost,current⟩:=physical
  refine ⟨authority,cost,current,?_⟩
  have optics:=room (R:=R) simple vc L span
  have payout:‖low-ended‖≤WilsonOlderFreshSoftSocketStationPortfolio.wallet (fun o:Active=>μ o.val)
      (fun o s=>(WilsonOriginalObservedRoseProbeRead.quota (branchTest o s):ℂ)) ((r:ℂ)^14) occupied stopped salary:=
    (issued c (late.trans vc)).2 v late vw bottom opt tol office N per b K bk kn ck vk optics.1 optics.2
      requested tag credit Active (fun o=>(panel o).val) file stations axes probe (fun o=>μ o.val) ((r:ℂ)^14)
      (fun o s=>(WilsonOriginalObservedRoseProbeRead.quota (branchTest o s):ℂ)) lower le_rfl
  calc
    _=‖(raw-low)+(low-ended)‖:=by congr 1; abel
    _≤_ := (norm_add_le ..).trans (add_le_add current payout)

