def discrepancy (J:Voice G) (axes:Lattice.Order) (q:ℕ) (obs Q:Poly (J₃))
    (b h:Coefficient F₀ (R.family.side i per)) (U:Config G (R.family.side i per)):ℂ:=
  ((incoming R A simple cut.le o U)*WilsonThermometerRegisteredCenteredInvoice.properInvoice obs Q).part full/((Ψ i).eval U:ℂ)-
    ((published J axes q U)*WilsonThermometerRegisteredCenteredInvoice.properInvoice obs Q).part full-
    ((damping obs Q:ℂ)*account h (Ψ i) U+(1-(damping obs Q:ℂ))*account b (Ψ i) U)/((Ψ i).eval U:ℂ)

private theorem combined {G:Gauge} (R:Run G) {i N per:ℕ} (live:i≤N)
    (f h:Config G (R.family.side i per)→ℂ) (hf:RG.Envelope f) (hh:RG.Envelope h)
    (budget:ℝ) (pf:(∫U,‖f U‖ ∂scene R.family.path N per i)≤budget)
    (ph:(∫U,‖h U‖ ∂scene R.family.path N per i)≤budget) (a c:ℂ):
    let S:=fun U=>a*f U+c*h U
    RG.Envelope S ∧ ∀j (age:j ≤ i),(∫U,‖actualTransport R.family (N:=N) S age U‖ ∂scene R.family.path N per j)≤(‖a‖+‖c‖)*budget:=by
  intro S
  let μ:=scene R.family.path N per i
  haveI:IsProbabilityMeasure μ:=OPE.Therm.probability (H:=R.family.path) (p:=per) R.makes.wilson live
  obtain ⟨mf,V,fv⟩:=hf
  obtain ⟨mh,W,hw⟩:=hh
  have f₀:Integrable f μ:=Integrable.of_bound mf.aestronglyMeasurable V (ae_of_all _ fv)
  have h₀:Integrable h μ:=Integrable.of_bound mh.aestronglyMeasurable W (ae_of_all _ hw)
  have each (U):‖S U‖≤‖a‖*‖f U‖+‖c‖*‖h U‖:=by
    simpa only [norm_mul] using norm_add_le (a*f U) (c*h U)
  have env:RG.Envelope S:=⟨(measurable_const.mul mf).add (measurable_const.mul mh),‖a‖*V+‖c‖*W,fun U=>
    (each U).trans (add_le_add (mul_le_mul_of_nonneg_left (fv U) (norm_nonneg a)) (mul_le_mul_of_nonneg_left (hw U) (norm_nonneg c)))⟩
  refine ⟨env,fun j age=>?_⟩
  calc
    _ ≤ ∫U,‖S U‖ ∂μ:=ActualWilsonAbsoluteTransport.first R.family R.makes live
      (ActualWilsonAbsoluteTransport.weighted R.family R.makes live env) age
    _ ≤ ∫U,‖a‖*‖f U‖+‖c‖*‖h U‖ ∂μ:=integral_mono ((f₀.const_mul a).add (h₀.const_mul c)).norm
      ((f₀.norm.const_mul ‖a‖).add (h₀.norm.const_mul ‖c‖)) each
    _ = ‖a‖*(∫U,‖f U‖ ∂μ)+‖c‖*(∫U,‖h U‖ ∂μ):=by
      rw [integral_add (f₀.norm.const_mul _) (h₀.norm.const_mul _),integral_const_mul,integral_const_mul]
    _ ≤ (‖a‖+‖c‖)*budget:=by rw [add_mul];gcongr

include course cut in
theorem original {η : ℝ} {T : Campaign R} {W : Campaign.Pillars R T}
    (funded : FundedOriginalProperties.{u} simple η W)
    (slow : ∀ m,((R.family.S.block m).val:ℝ) ≤ Real.log (Lambda R.family.path.levels m))
    (J : Voice G) (clear : Clear G J) (axes : Lattice.Order) (q : ℕ) {ε : ℝ} (ep : 0 < ε)
    (width : ∀ j k : ℕ, k ≤ j → ∀ b : ℝ, R.alloy.delay.betaEntry j ≤ b →
      Real.exp ((Poetry.Agenda.seed D φ (Burn.horizon k) j)⁻¹ ^ 2) ≤ b)
    (law : VowsR.LawScroll G φ) (enrolled : VowsR.Chamber law R.kit D bank books)
    (fund : Volume.Fund D R.rolls bank φ books R.alloy.delay)
    (late : max (WilsonJointAxialRoster.opening R simple funded slow J clear (Fintype.card (Fin 3)) n q ep)
        (WilsonReceivedAxialFiling.opening R simple D φ width order shelf (Fintype.card (Fin 3)) ep) ≤ i)
    (finiteLate : max (WilsonReceivedAxialFinite.opening R simple q ep)
      (WilsonReceivedAxialFinite.massOpening R D ages order shelf seats (k:=k) simple width) ≤ i)
    (pass : Pass D bank R.alloy R.kit)
    (hospital : MintClock.Hospital D R.rolls bank R.kit.target φ books ahead R.alloy.delay)
    (narrow : shelf ≤ R.alloy.B.a.clock.J i) (load : P.op.count ≤ Burn.horizon k+2) (fit : k ≤ stage)
    (gate : WilsonReportingForestAngularReflection.posted R) (p l : ℕ)
    (reserve : p+(3+l)+1+Fintype.card (Fin 3) ≤ q) (headroom : q ≤ order)
    (accuracy : ε*((3:ℝ)^q+2) ≤ 1)
    (clockLate : (eventually_atTop.mp (WilsonJointAxialClock.original R simple)).choose ≤ i)
    (rareLate : WilsonJointAxialScalar.opening (V:=Fin 3) R simple gate q n (p+(3+l)+1+2*n*(Fintype.card (Fin 3))) ≤ i)
    (winding : (eventually_atTop.mp (WilsonCoveredOrdinaryWeightedPost.original R simple D φ ages
      width order shelf k seats 0 (Fintype.card (Fin 3)) (3+l) (p+1) 1 1 (fee (J₃)) zero_le_one ep)).choose ≤ i)
    (aperture : gs^l ≤ Poly.toll P.w full) (Q₀ : Poly (J₃))


    (y:Site (R.family.side i per)) (α:ℝ) (obs:Poly J₃) (normalized:Q₀.part (J₃).quiet=1)
    (appointed:Charged R A simple cut o hk D bank π Γ Ψ books hi ahead order shelf seats P q (p+1) y α obs Q₀):
    ∃b h:Coefficient F₀ (R.family.side i per),
      (modelBill q (p+1) y α 1 b) ∧ (modelBill q (p+1) y α (book₁ obs Q₀) h) ∧
      let err:=discrepancy R A simple cut o hk D bank π Γ Ψ books hi ahead order shelf seats P J axes q obs Q₀ b h
      RG.Envelope err ∧ ∀ j (age:j ≤ i),
      (∫U,‖actualTransport R.family (N:=N) err age U‖ ∂scene R.family.path N per j)≤
        (2*(damping obs Q₀)-1)*((fee (J₃)*globalFee p l+ε)*gs^(p+1)+(unit₁ (p+1)+cost₁ q (p+1) α)):=by
  obtain ⟨b,h,blank,tinted,submission⟩:=appointed
  refine ⟨b,h,blank,tinted,?_⟩
  dsimp only
  let src := fun U=>incoming R A simple cut.le o U
  let pay := fun (tab:Poly J₃) (n₀:Coefficient F₀ (R.family.side i per)) U=>
    (total (src U) tab).part full/((Ψ i).eval U:ℂ)-
      (∑s,WilsonThermometerCenteredAlgebra.weight tab s*scalar J axes q s U)-account n₀ (Ψ i) U/((Ψ i).eval U:ℂ)
  let fare:=(fee (J₃)*globalFee p l+ε)*gs^(p+1)+(unit₁ (p+1)+cost₁ q (p+1) α)
  have beta:=congrArg Coat.gStep (course.1.walk (i+1) (Nat.le_succ_of_le hi) cut).beta
  have pos:0<gs:=beta ▸ P.issued.Waffle.soon.1
  have widths(v):0<(wₚ) v:=mul_pos pos (P.salary.positive v)
  have earned:=WilsonThermometerRegisteredCenteredInvoice.affordable wₚ obs Q₀ widths normalized
  have hearing (tab:Poly J₃) (n₀:Coefficient F₀ (R.family.side i per))
      (affordable:Poly.price wₚ (inverseMass tab)≤fee J₃)
      (row:modelBill q (p+1) y α tab n₀):
      RG.Envelope (pay tab n₀) ∧ (∫U,‖pay tab n₀ U‖ ∂scene R.family.path N per i)≤fare:=by
    have issued:=WilsonThermometerReceivedPrior.original R A simple cut o hk D bank π Γ Ψ course books hi ahead order shelf seats
      P funded slow J clear axes q ep width law enrolled fund late finiteLate pass hospital narrow load fit gate p l reserve headroom
      accuracy clockLate rareLate winding aperture tab affordable y n₀ row.1 row.2.1 row.2.2.1
    have unit:‖n₀.x 0‖ ≤ unit₁ (p+1):=
      (Finset.single_le_sum (fun j _=>norm_nonneg (n₀.x j)) (Finset.mem_univ 0)).trans row.2.2.2
    have baseCost:=issued.2 i le_rfl
    simp only [actualTransport_base R.family R.makes cut.le] at baseCost
    have paidAt:(∫U,‖pay tab n₀ U‖ ∂scene R.family.path N per i)≤
        (fee (J₃)*globalFee p l+ε)*gs^(p+1)+(‖n₀.x 0‖+cost₁ q (p+1) α):=baseCost
    exact ⟨issued.1,paidAt.trans (add_le_add le_rfl (add_le_add unit le_rfl))⟩
  have lower:=hearing 1 b earned.1 blank
  have upper:=hearing (book₁ obs Q₀) h earned.2 tinted
  have identity:discrepancy R A simple cut o hk D bank π Γ Ψ books hi ahead order shelf seats P J axes q obs Q₀ b h=
      fun U=>(damping obs Q₀:ℂ)*(pay (book₁ obs Q₀) h U)+(1-(damping obs Q₀:ℂ))*(pay 1 b U):=by
    funext U
    unfold discrepancy
    dsimp only [pay,src]
    rw [WilsonThermometerRegisteredCenteredInvoice.reading wₚ obs Q₀ widths normalized (src U),
        WilsonThermometerRegisteredCenteredInvoice.reading wₚ obs Q₀ widths normalized (published J axes q U),
        value R A simple cut o hk D bank π Γ Ψ books hi ahead order shelf seats P J axes q U (book₁ obs Q₀),
        value R A simple cut o hk D bank π Γ Ψ books hi ahead order shelf seats P J axes q U 1]
    ring
  rw [identity]
  have outcome:=combined R cut.le _ _ upper.1 lower.1 fare upper.2 lower.2 (damping obs Q₀:ℂ) (1-(damping obs Q₀:ℂ))
  have good:1<damping obs Q₀:=by
    have n₀:=Poly.nonnegative (R:=J₃) widths (WilsonThermometerRegisteredCenteredInvoice.properInvoice obs Q₀-1)
    unfold WilsonThermometerRegisteredCenteredInvoice.restoration;linarith
  have gain:‖(damping obs Q₀:ℂ)‖+‖(1-(damping obs Q₀:ℂ))‖=2*(damping obs Q₀)-1:=by
    rw [show (1-(damping obs Q₀:ℂ))=((1-damping obs Q₀:ℝ):ℂ) by push_cast;rfl]
    rw [Complex.norm_real,Complex.norm_real,Real.norm_eq_abs,Real.norm_eq_abs,abs_of_neg (sub_neg.mpr good),
      abs_of_pos (by linarith : 0<damping obs Q₀)]
    ring
  exact gain ▸ outcome

