private theorem rooted {T:Ten ℝ (Cloth α) r}{s A:ℝ}(positive:0 ≤ s)
    (paid:Wig terrain (fun _:Unit=>0) s A {()} T):Cork terrain 0 s A T:=by
  refine ⟨paid.1,fun x=>(paid.2 x).trans (mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr
    (mul_le_mul_of_nonpos_left (Nat.cast_le.mpr ?_) (neg_nonpos.mpr positive))) paid.1)⟩
  let go:Fin (r+1)  →  ({()} : Finset Unit)⊕Fin r:=Fin.cases (.inl ⟨(),mem_singleton_self _⟩) .inr
  have chosen (j:Fin (r+1)):foyer (fun _:Unit=>0) {()} x (go j)=stud 0 x j:=
    Fin.cases rfl (fun _=>rfl) j
  apply league_le
  intro j k
  rw [←chosen j,←chosen k]
  exact leg_le ..

/-- Each prescribed field keeps its own cover address.  The one physical
torus and all actual top cutoffs enter after the uniform reporting date. -/
theorem original (R:Run G)(simple:G.Simple)(booked:WilsonPointChildFiledTest.Filed R)
    (enrolled:WilsonPointChildWindingHierarchy.Filed R)(paid:WilsonPointChildWindingSchool.Paid R.kit)
    (u:G.ColorIndex)(depth:d<D)(o:Loc G 1)
    (tags:∀i n,(Flat.primary (R.family.path.levels.clock.op i 0).patch R.family.path.levels.clock.kernel n).Choices)
    (E:ℕ){η:ℝ}(positive:0<η):
    ∀ᶠm:ℕ in atTop,∀N per,m ≤ N  →  ∀v:Letter (R.family.labels.level d),∀p:Scroll D,
      let X:=ledger R u depth N (N-m) m v p
      let n:=R.family.side m per
      let b:=width R m
      let z:=zz R.family.path.levels m
      let A:=(R.family.path.levels.clock.hatBeta m)^η*‖physical p‖
      ∀(y:ι  →  Cover)(t:ι),Auth d (shifted X (y t)) ∧ ∀e ≤ E,∀r,
      MarkU y {t} ((shifted X (y t)).1 n e r) ((shifted X (y t)).2 e r)
        (min (b/32) (1/(16384*z))) ((priceM (Hooks G) r b+tiePay (Hooks G) r (b/4)+1)*A+(1+‖physical p‖)):=by
  let L:=R.family.path.levels
  have dry:=WilsonPointChildWindingIncome.original R simple booked u depth o tags (fare G) paid E positive
  have tide:=enrolled u d E D depth o tags
  filter_upwards [dry,tide,WilsonVacuumPreResetFiniteHeatScale.clock L simple] with m stamp receipt clock
  intro N per live v p X n b z A y t
  have full:=stamp N live v p
  have good:=WilsonPointChildPairedHistory.original R u depth tags simple o (fare G) paid N (N-m) m (by omega) v p
  refine ⟨full.1.shifted _,?_⟩
  intro e he r
  have bw:0<b:=(Primer.FamilyWindow R.family).pos _
  have center:Cork terrain 0 b A (X.2 e r):=rooted bw.le (full.2 e he r).1
  have travel:Wig terrain y b A {t} ((shifted X (y t)).2 e r):=
    abreast _ y t (Cork.turn _ center) bw.le
  apply WilsonMarkedIndependentMixedSpatial.restore (singleton_nonempty _) bw (lt_of_lt_of_le zero_lt_one clock.1)
    (by positivity) travel
  intro x
  change ‖revolve (wrap n (y t)) (X.1 n e r) x-plume (revolve (y t) (X.2 e r)) n x‖ ≤ _
  rw [plume_shift,Real.norm_eq_abs]
  change |X.1 n e r (jog (-wrap n (y t)) ∘ x)-plume (X.2 e r) n (jog (-wrap n (y t)) ∘ x)| ≤ _
  dsimp only [X]
  rw [good.1 n,good.2]
  exact receipt N per live v p e he r _

