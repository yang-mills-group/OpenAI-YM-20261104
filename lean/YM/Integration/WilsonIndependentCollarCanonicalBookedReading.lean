theorem original (F:Ptype)(B:voucher F)
    (receipt:WilsonOriginalCensusCanonicalFiledClock.Returns R hk D Q π Γ Ψ books hi op ahead d q hd o
      order shelf F B)
    (h:V→ℕ)(pt:V→Chamber)(x:Wallet (A))(s:Multi.Hot (marks))(u:s.val.val)
    (v:Stationary.Link G (coarse R i per))(r a:ℕ)(through:r≤order)(kept:a≤r)
    (tags:∀b:Covers R.family.path.levels.S i (coarse R i per),(step R i b.val).Choices)
    {orderCap breadthCap:ℕ}{ε:ℝ}(paid:WilsonIndependentCollarCanonicalPeriodGrant.Paid R d
      (fun j=>contact (h j)) pt orderCap i per breadthCap (present h) ε)
    (near:breadth s.val.val u.val (y u.val) (relative s.val.val u.val y)≤breadthCap)
    (included:a≤orderCap)(unit:‖v‖≤1):
    let issued:=file F B x
    let student₀:=Oak.student (n:=per) R hk D Q π Γ books hi issued.post.op issued.post.lesson ahead (A)
      issued.post.model issued.order issued.post.voter
    let restamp:=Mutation.stamp student₀ (Γ i) (Oak.grade0 R hk D Q π Γ hi issued.post.lesson)
      (Burn.horizon k+2) issued.order
    ‖(peek dvd_rfl restamp issued.grades (π i) (pay) issued.x a v).part s.val-
      plottedLow R d (fun j=>contact (h j)) pt N i q cells (coarse R i per) y s.val.val a
        (present h) v (∏j∈s.val.val,(x j).val)‖≤‖∏j∈s.val.val,(x j).val‖*ε:=by
  intro issued student₀ restamp
  letI:NeBot (coverFilter R.family.path.levels.S i (coarse R i per)):=coverFilter_neBot R.kit.floor i _
  have high:=receipt h pt x s v r a through kept
  have bound:=paid N cut q cells y s.val.val u.val u.prop near a included v unit (∏j∈s.val.val,(x j).val)
  have offered:Tendsto (repeated R d (fun j=>contact (h j)) pt N i q cells (coarse R i per) y
    s.val.val u.val a (present h) v (∏j∈s.val.val,(x j).val))
      (coverFilter R.family.path.levels.S i (coarse R i per))
      (𝓝 ((peek dvd_rfl restamp issued.grades (π i) (pay) issued.x a v).part s.val)):=by
    apply high.congr'
    filter_upwards with b
    dsimp only
    rw [mul_left_comm]
    exact congrArg (fun z=>(∏j∈s.val.val,(x j).val)*z)
      (WilsonIndependentCollarCanonicalCofinalSeats.original (D:=h) R d pt q N i per cut y cells hd
        (scale) b simple (tags b) s.val.val u a v)
  exact offered.limUnder_eq ▸ bound

