/-- The complete two-date occupied finite log is compared with the identical
second Wick log on its folded, genuinely deposited upper family. -/
theorem original (G:Gauge)(D k:ι → ℕ)(I:Finset ι)(alive:I.Nonempty)(E e r:ℕ)(he:e ≤ E):
    ∃fare:Gear G → ℝ,∃M:ℝ,0    ≤    M ∧ ∃d:ℕ,∃Lcost:ℝ,0 ≤ Lcost ∧ ∀(R:Run G),G.Simple →
    WilsonPointChildFiledTest.Filed R → WilsonPointChildDigitHierarchy.Filed R →
    WilsonReceivedCloseFundedHeat.Quiet R →
    ∀cash:ℕ → Gear G → ℝ,FundedMarkedCoverRows.prices cash R.kit →
    (∀ᶠj:ℕ in atTop,∀J,fare J     ≤     cash (R.family.path.levels.clock.J (j+1)) J) →
    ∀(u:ι → G.ColorIndex)(depth:∀s,k s<D s)(_o:Loc G 1),
    ∀_tags:∀j n,(Flat.primary (R.family.path.levels.clock.op j 0).patch R.family.path.levels.clock.kernel n).Choices,
    ∀η:ℝ,0<η → ∀ᶠm:ℕ in atTop,∀N B per,m+1<N → m+1 ≤ B →
    ∀(d₁ d₂:ι → ∀i,Site (R.family.S.block i))(v₁ v₂:∀s,Letter (R.family.labels.level (k s))),
    ∀(T:Finset ι),
    ∀y₀:ι → Cover,∀z₀:ι → Site (loose R.family.path.levels m).L,∀z:ι → Site (loose R.family.path.levels (m+1)).L,
    let A:=R.family.path.levels
    let O:=R.metals.O
    let y:=chartIn (loose A m) y₀ z₀
    let n:=R.family.side m per
    let f:=R.family.side (m+1) per
    let α:=WilsonPointChildCenteredPortfolio.bank R u depth d₁ N (m+2) v₁ (chartIn (loose A (m+1)) y z)
    let β:=WilsonPointChildCenteredPortfolio.bank R u depth d₂ B (m+1) v₂ y
    let K:=mounted T (logO A O (m+1) N α k) β
    let a:=WilsonPointChildCenteredIncome.share R (m+2) η D
    let b:=WilsonPointChildCenteredIncome.share R (m+1) η D
    let A₀:=(A.clock.hatBeta (m+2))^η*WilsonPointChildCenteredPortfolio.cap D
    let C:=allowance M ((zz A (m+1))^d) A₀ a b I
    let A₁:=(A.clock.hatBeta (m+1))^η*WilsonPointChildCenteredPortfolio.cap D
    let rent:=(zz A (m+1))^(WilsonPointChildMixedSalary.bill G D k E)*A₀+A₁
    (∀J⊆I,J⊆T → J.Nonempty → 4*crestCard y J<f.val) → 4*crestCard y₀ I<n.val →
    Eu k K ∧ K ∅=0 ∧ ∀x,‖(logO A O m N K k I).1 n e r x-
        Carp.plume ((logO A O m N K k I).2 e r) n x‖ ≤
          (Lcost*C^I.card+rent^I.card)*rate A m per:=by
  obtain ⟨v,M,mp,d,H,hp,received⟩:=WilsonPointChildCenteredSuccessor.original G D k I E e r he
  obtain ⟨menu,b,seam⟩:=WilsonPointChildReceivedSeam.original G D k I alive E e r he
  let pay(F:Gear G):=max (v F) (menu F)
  refine ⟨pay,M,mp,d,H,hp,?_⟩
  intro R simple booked enrolled quiet cash buy salary u depth o tags η eta
  have vpay:=salary.mono (fun j f F=>(le_max_left ..).trans (f F))
  have carry:=received R simple booked enrolled quiet cash buy vpay u depth o tags η eta
  let L:=R.family.path.levels
  obtain ⟨m₀,sal⟩:=eventually_atTop.mp salary
  obtain ⟨m₁,ix⟩:=eventually_atTop.mp (WilsonPointChildQuoteWidth.index L)
  obtain ⟨m₂,input⟩:=eventually_atTop.mp (WilsonPointChildCenteredPortfolio.original R simple booked u depth o tags cash buy E eta)
  obtain ⟨m₃,table⟩:=eventually_atTop.mp (WilsonPointChildCenteredIncome.original R simple booked enrolled u depth o tags cash buy E eta)
  obtain ⟨m₄,beta⟩:=eventually_atTop.mp ((WardBin.bell L simple).eventually_ge_atTop 1)
  filter_upwards [eventually_ge_atTop m₄,eventually_ge_atTop (max (max m₀ m₁) (max m₂ m₃)),carry,
    WilsonVacuumPreResetFiniteHeatScale.clock L simple,WilsonMarkedIndependentNormalizedScale.original L simple b,
    FundedMarkedCoverRows.realm R simple cash buy 0 (fun _=>0) (fun _=>1) (fun _=>by decide) E 0 0]
    with m warm late paired clock absorb election
  obtain ⟨Q,draws,measured,tick,origin,_,_,_,bought⟩:=election
  have hq:Q.anchor ≤ m:=origin.le
  have hq':Q.anchor ≤ m+1:=by omega
  let F:=(Q.mint m hq).gear
  let J:=(Q.mint (m+1) hq').gear
  obtain ⟨rise₀,_,paid₀⟩:=bought m le_rfl hq
  obtain ⟨rise₁,crest,paid₁⟩:=bought (m+1) (by omega) hq'
  have lpay:menu F ≤ Q.cash Credit.leanC m:=
    (le_max_right ..).trans ((sal m (by omega) F).trans paid₀)
  have upay:menu J ≤ Q.cash Credit.leanC (m+1):=
    (le_max_right ..).trans ((sal (m+1) (by omega) J).trans paid₁)
  have k₀:Q.draws.clock.J (m+1) ≤ (Q.draws.S.block m).val:=by rw [draws];exact ix m (by omega)
  have k₁:Q.draws.clock.J (m+2) ≤ (Q.draws.S.block (m+1)).val:=by rw [draws];exact ix (m+1) (by omega)
  have rise:5 ≤ Q.draws.clock.J (m+2):=by rw [draws];exact rise₁
  have stop:(Q.mint (m+1) hq').σ=crestM Q.draws (m+1) rise:=by simpa only [draws] using crest
  have cap:WilsonPointChildMixedQuote.strip F ≤ width R (m+1):=
    (min_le_left ..).trans (entered R Q draws m (ix m (by omega)) hq)
  intro N B per hn bn d₁ d₂ v₁ v₂ T y₀ z₀ z A O y n f α β K a b₁ A₀ C A₁ rent fits good
  have left:=paired N B per hn bn d₁ d₂ v₁ v₂ T y z fits
  let x₁:=chartIn (loose A (m+1)) y z
  have above:=input (m+2) (by omega) N (by omega) d₁ v₁ x₁ I (width R (m+2)) le_rfl
  have below:=input (m+1) (by omega) B bn d₂ v₂ y I (WilsonPointChildMixedQuote.strip F) cap
  have α₁:=table (m+2) (by omega) N per (by omega) d₁ v₁ x₁
  have β₁:=table (m+1) (by omega) B per bn d₂ v₂ y
  have report:=seam Q m N hq hn lpay upay k₀ k₁ rise stop n T α β α₁.1 α₁.2.1 β₁.1
  generalize gear : (Q.mint m hq).gear = g at report
  rw [draws,measured,tick] at report
  rw [←gear] at report
  have upper0:0≤A₀:=mul_nonneg (Real.rpow_nonneg (zero_le_one.trans (beta (m+2) (by omega))) _) (WilsonPointChildCenteredPortfolio.cap_nonneg D)
  have lower0:0≤A₁:=mul_nonneg (Real.rpow_nonneg (zero_le_one.trans (beta (m+1) (by omega))) _) (WilsonPointChildCenteredPortfolio.cap_nonneg D)
  have right:=report y₀ z₀ z A₀ A₁ upper0 lower0 above below good
  let f':=A.S.side (m+1) per
  have zpos:0≤zz A m:=zero_le_one.trans clock.1
  have mon:zz A m ≤ zz A m*(1+(f'.val:ℝ))^4:=le_mul_of_one_le_right zpos (one_le_pow₀ (le_add_of_nonneg_right (Nat.cast_nonneg _)))
  have flat:(zz A m)^b*Real.exp (-(n.val:ℝ)/(512*zz A m)) ≤ rate A m per:=by
    refine (mul_le_mul (pow_le_pow_left₀ zpos mon b) (le_add_of_nonneg_left (Real.exp_pos _).le)
      (Real.exp_pos _).le (pow_nonneg (mul_nonneg zpos (by positivity)) _)).trans (absorb per)
  have form:0≤rent:=add_nonneg (mul_nonneg (pow_nonneg (zero_le_one.trans (by rw [←tick];exact Q.depth _ hq' : 1≤zz A (m+1))) _) upper0) lower0
  refine ⟨left.1,left.2.1,fun x=>?_⟩
  let c:=coilH A O m N n K k (ratioHigh A O N m) I e r x
  let V:=(logO A O m N K k I).1 n e r x
  let B:=Carp.plume ((logO A O m N K k I).2 e r) n x
  have last:‖c-B‖ ≤ rent^I.card*rate A m per:=by
    rw [norm_sub_rev]
    refine (right x).trans ?_
    calc (zz A m)^b*rent^I.card*Real.exp (-(n.val:ℝ)/(512*zz A m)) =
            rent^I.card*((zz A m)^b*Real.exp (-(n.val:ℝ)/(512*zz A m))):=by ring
         _ ≤ _:=mul_le_mul_of_nonneg_left flat (pow_nonneg form _)
  calc ‖V-B‖=‖(V-c)+(c-B)‖:=by rw [sub_add_sub_cancel]
       _ ≤ ‖V-c‖+‖c-B‖:=norm_add_le .. 
       _ ≤ H*C^I.card*rate A m per+rent^I.card*rate A m per:=add_le_add (left.2.2 x) last
       _ = _:=by ring
end YM.Integration.WilsonPointChildCenteredWinding
