  (upperFile:WilsonOriginalCensusMaterialPosting.Posted R hk D Q π Γ Ψ books (Nat.le_succ_of_le base) opU lessonU ahead (port (fine R (j+1) per) (chartIn (loose R.family.path.levels (j+1)) sites ((onLevels draw digits) (j+1)))) (binder (fine R (j+1) per) (chartIn (loose R.family.path.levels (j+1)) sites ((onLevels draw digits) (j+1)))) grades q shelf q tollU U tolU)

