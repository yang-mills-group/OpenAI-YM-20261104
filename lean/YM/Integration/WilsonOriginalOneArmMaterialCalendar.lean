local notation "zU" => chartIn (loose R.family.path.levels (j+1)) sites ((onLevels draw digits) (j+1))
local notation "gridᵤ" => fine R (j+1) per
local notation "gridₗ" => coarse R (j+1) per
local notation "H₁" => R.alloy.B.a.clock.hatBeta (j+1)
local notation "H₂" => R.alloy.B.a.clock.hatBeta (j+2)
local notation "clock" => R.alloy.B.a.clock
local notation "strip₀" => Poetry.Agenda.seed D φ (Burn.horizon k) ((clock).J (j+1))
local notation "Bᵤ" => binder (gridᵤ) (zU)
local notation "Bₗ" => binder (gridₗ) sites
local notation "hi₀" => WilsonNeutralTwoPrintPathPostedWallet.vote R hk D Q π Γ Ψ books
  (Nat.le_succ_of_le base) opU lessonU ahead (port (gridᵤ) (zU)) (Bᵤ) grades q shelf q tollU U upperFile wallet
local notation "lo₀" => WilsonNeutralTwoPrintPathPostedWallet.vote R hk D Q π Γ Ψ books
  base opL lessonL ahead (port (gridₗ) sites) (Bₗ) grades q shelf q tollL L lowerFile wallet
local notation "cashᵤ" v:max => tollU v*max 1 (WilsonOriginalMixedBlockBudget.roots (Bᵤ)
    (WilsonIndependentCollarMaterialWallet.bill U tollU))
local notation "cashₗ" v:max => tollL v*max 1 (WilsonOriginalMixedBlockBudget.roots (Bₗ)
    (WilsonIndependentCollarMaterialWallet.bill L tollL))

private theorem lift_dose {x y:ℝ}{u:ℕ}(xp:0≤x)(xy:x≤y^2) :
    x^u≤y^(2*u):=by rw [pow_mul];exact pow_le_pow_left₀ xp xy _

theorem original (simple:G.Simple)(rentOrder level pieces stage requested:ℕ)
    (demand:WilsonOriginalCensusPublicationClock.Load k q q shelf requested grades pieces stage)
    (enrolled:q ≤ Burn.horizon k+1)(depth:2*rentOrder+8 ≤ q)(age:rentOrder+3 ≤ 3*k+2)
    (sized:q ≤ (clock).J (j+1))
    (below:WilsonOriginalCensusPublicationClock.Open R simple grades pieces stage demand j)
    (above:WilsonOriginalCensusPublicationClock.Open R simple grades pieces stage demand (j+1))
    (loSeats:opL.count=pieces)(hiSeats:opU.count=pieces)
    (ready:WilsonReceivedMeasuredStampPrice.opening R simple rentOrder q k depth age
      (by positivity:0<(1:ℝ)) ≤ j+1)
    (paidAge:(eventually_atTop.mp (WilsonEmittedOriginalCalendar.wages R simple)).choose ≤ j+1)
    (charge:Fin n→ℕ)(up:∀v,cashᵤ v ≤ (H₂)^(charge v))(down:∀v,cashₗ v ≤ (H₁)^(charge v))
    (early:(H₂)≤(H₁)^2)(small:tolU ≤ (Pert.Asymptotics.regulatorRun R.family N per (j+2))^rentOrder)
    (tube:LinkTube G)(front:Multi.Hot (Stock.census (Fin n)) → Fin n)
    (owned:∀s,front s∈s.val.val)
    (teacher:0<strip₀ ∧ Real.exp ((strip₀)⁻¹^2)≤(H₁) ∧
      ((Ψ (j+1)).p.supportExponent+2)*(((Ψ (j+1)).p.B:ℝ)⁻¹)≤(strip₀)/2 ∧
      (Real.sqrt (Ψ (j+1)).beta)⁻¹≤1/2 ∧ (Ψ (j+1)).p.B=Nat.ceil ((Real.log (H₁))^2) ∧
      (Ψ (j+1)).p.supportExponent+2≤102) :
    ∃cal:WilsonOriginalSparseCensusEdge.Calendar R simple hk D Q π Γ Ψ books base ahead _ _
      (hi₀) (lo₀) (fun v=>2*charge v) rentOrder 1 (((H₁)^level)⁻¹) ((2:ℝ)^(q+shelf+1)), cal.tube=tube ∧ cal.front=front:=by
  have hv:=(upperFile.choose_spec.2.2.2.2.2.2.2.2.2 wallet).choose_spec
  have lv:=(lowerFile.choose_spec.2.2.2.2.2.2.2.2.2 wallet).choose_spec
  change (hi₀).x=wallet ∧ _ at hv
  change (lo₀).x=wallet ∧ _ at lv
  obtain ⟨_,hg,ho,hs,hn,_,_,hplace,_,_,_,hr⟩:=hv
  obtain ⟨_,lg,lo,ls,ln,_,_,lplace,_⟩:=lv
  have ug:(hi₀).grades=grades:=hg
  have lg':(lo₀).grades=grades:=lg
  have ut:(hi₀).order=q:=ho
  have lt':(lo₀).order=q:=lo
  have uh:(hi₀).shelf=shelf:=hs
  have lh':(lo₀).shelf=shelf:=ls
  have un:(hi₀).seats=opU.count:=hn
  have ln':(lo₀).seats=opL.count:=ln
  have homeU:(hi₀).post.passport=port (gridᵤ) (zU):=hplace
  have homeL:(lo₀).post.passport=port (gridₗ) sites:=lplace
  have hp:1≤H₁:=(R.alloy.B.a.fits.delayed (j+1)).le
  have hh:0≤H₂:=zero_le_one.trans (R.alloy.B.a.fits.delayed (j+2)).le
  obtain ⟨positive,reserve,placed,cool,side,tax⟩:=teacher
  refine
    ⟨
    { fits := ho.le.trans enrolled
      narrow := hs.le.trans above.level
      load := (hi₀).post.capacity.le.trans (by simpa only [un,hiSeats] using demand.count)
      deep := depth.trans ho.ge
      aged := age
      eps_pos := by norm_num
      late := by simpa only [ut] using ready
      depth := lo.le.trans sized
      shelved := ls.le.trans below.level
      slots := (lo₀).post.capacity.le.trans (by simpa only [ln',loSeats] using demand.count)
      halo := below.halo
      placed := placed
      width := positive
      high_degree := by rw [ug]
      low_degree := by rw [lg']
      high_wage := fun v=>(up v).trans (lift_dose hh early)
      low_wage := fun v=>(down v).trans (pow_le_pow_right₀ hp (by omega))
      income := paidAge
      tube := tube
      front := front
      inside := owned
      delta_nn := inv_nonneg.mpr (pow_nonneg (zero_le_one.trans hp) _)
      upper_pole := by rw [ut,uh]
      lower_pole := by rw [lt',lh']
      high_rent := (WilsonOriginalFixedTestCensusOffer.high_rent R hk D Q π Γ Ψ books
        (Nat.le_succ_of_le base) ahead (hi₀) hn hr upperFile.choose_spec.2.2.2.2.2.2.2.1).trans small
      child := ?_
      small := cool
      side := side
      tax := tax
      reserve := reserve },rfl,rfl⟩
  intro u
  rw [homeL,homeU]
  change wrap (gridₗ) (sites u) = (step R (j+1) per).ratio.parent (wrap (gridᵤ) ((zU) u))
  rw [←WilsonIndependentCollarCanonicalCofinalSeats.actual R (j+1) per sites (onLevels draw digits) u]
  change _ = (step R (j+1) per).ratio.parent ((step R (j+1) per).ratio.assemble
    (wrap (gridₗ) (sites u),(onLevels draw digits) (j+1) u))
  exact (Ratio.assemble_parent (step R (j+1) per).ratio
    (wrap (gridₗ) (sites u),(onLevels draw digits) (j+1) u)).symm

