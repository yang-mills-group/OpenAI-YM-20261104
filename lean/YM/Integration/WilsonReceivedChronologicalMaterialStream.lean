private theorem chart {Lv Lw:Levels G}(eq:Lv=Lw)(i:ℕ)(z:Fin n → Cover)(d:Digits Lv (Fin n)):
    chartIn (loose Lv i) z (d i)=chartIn (loose Lw i) z ((onLevels eq d) i):=by
  subst Lw
  rfl

theorem next (cells:Digits V.draws (Fin n))(ground:Fin n → Cover)(valid:m ≤ j):
    homes cells ground m ((j+1)-m)=chartIn (loose R.family.path.levels (j+1))
      (homes cells ground m (j-m)) ((onLevels draw cells) (j+1)):=by
  obtain ⟨a,rfl⟩:=Nat.exists_eq_add_of_le valid
  rw [show m+a+1-m=a+1 by omega,show m+a-m=a by omega]
  exact chart draw _ _ cells

variable (z:ℕ → Fin n → Cover)
  (M:(a:↥(Ico m (K-1))) → Material R N (a.val+1) q k
       (Poetry.Agenda.seed (WilsonOriginalCensusPhysicalAttendance.roots s R simple) MintClock.splits
         (Burn.horizon ask.vac) (R.alloy.B.a.clock.J (a.val+1)))
       (binder (R.family.side (a.val+1) per) (z a.val)))
  (x:Affinity.Wallet (WilsonOriginalMixedBlockRows.room (Fin n)))
  (other:∀i,Config G (R.family.side i per) → Poly (Stock.census (Fin n)))

local notation "stamp" i:max => port (R.family.side (i+1) per) (z i)
local notation "binders" i:max => binder (R.family.side (i+1) per) (z i)

def stream:∀i,Config G (R.family.side i per) → Poly (Stock.census (Fin n))
  | 0 => other 0
  | i+1 => if a:i∈Ico m (K-1) then
      submitted R (teacher) Ψ (stamp i) (binders i) k q (M ⟨i,a⟩) x
    else other (i+1)

theorem entered (a:↥(Ico m (K-1))):
    stream ask Ψ z M x other (a.val+1)=submitted R (teacher) Ψ (stamp a.val) (binders a.val) k q (M a) x:=by
  simp only [stream,dif_pos a.property]

theorem outside (i:ℕ)(before:i∉Ico m (K-1)):
    stream ask Ψ z M x other (i+1)=other (i+1):=by
  simp only [stream,dif_neg before]

include record in
theorem original (a:↥(Ico m (K-1)))(w:Fin n → ℝ)(power:Fin n → ℕ)(tol:ℝ)(live:a.val<N)
    (onCourse:Booked room ask π Γ hk lessons Ψ a.val (mem_Ico.mp a.property).1 live (z a.val) (M a) w power tol):
    let amount:=fun v=>w v*max 1 (WilsonOriginalMixedBlockBudget.roots (binders a.val)
      (WilsonIndependentCollarMaterialWallet.bill (M a) w))
    ∃Z:WilsonOriginalDatedCensusInput.Filed (N:=N) R hk (teacher) (metals) π Γ Ψ room.books (mem_Ico.mp a.property).1
      room.ahead amount ((((∑v,k v)+1)+5)*Fintype.card (Fin n)) (stream ask Ψ z M x other (a.val+1)),
      Z.x=x ∧ Z.grades=k ∧ Z.order=ask.order ∧ Z.shelf=ask.shelf ∧
      (8*(budgetR R a.val)^Z.post.op.count)*Z.post.rent ≤ tol ∧
      (∀mask:(Stock.census (Fin n)).Mode,(Poly.toll Z.post.w mask)⁻¹ ≤
        (heat (a.val+1))^((((∑v,k v)+1)+5)*Fintype.card (Fin n)+∑v∈mask.val,(power v+4))) ∧
      ∀U:Config G (R.family.side (a.val+1) per),∀s:(Stock.census (Fin n)).Mode,
        (((R.family.path.rep N per (a.val+1)).eval U:ℂ)⁻¹)*(stream ask Ψ z M x other (a.val+1) U).part s=
          (word R (teacher) Ψ (stamp a.val) (binders a.val) k q (M a) x U).part s:=by
  intro amount
  rw [entered ask Ψ z M x other a]
  obtain ⟨op,file,_,read⟩:=onCourse
  let Z:=vote R hk (teacher) (metals) π Γ Ψ room.books (mem_Ico.mp a.property).1 op
    (lessons a.val (mem_Ico.mp a.property).1 live) room.ahead (stamp a.val) (binders a.val) k ask.order ask.shelf q w (M a) file x
  obtain ⟨wallet,gr,order,shelf,_,_,cash,range⟩:=read x
  obtain ⟨_,_,_,_,group⟩:=WilsonReceivedChronologicalMaterialEndpoint.original R hk (teacher) (metals)
    π Γ Ψ record.1 room.books (mem_Ico.mp a.property).1 (by omega)
    op (lessons a.val (mem_Ico.mp a.property).1 live) room.ahead (stamp a.val) (binders a.val)
    k ask.order ask.shelf q w (M a) tol file x
  exact ⟨Z,wallet,gr,order,shelf,cash,range,group⟩

