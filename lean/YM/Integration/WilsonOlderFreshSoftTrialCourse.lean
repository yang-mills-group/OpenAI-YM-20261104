variable {s:WilsonOriginalAllOrderCourse.Schedule G} {R:Run G} {crop:Campaign R} {W:Campaign.Pillars R crop}

theorem original (paid:WilsonOriginalAllOrderCourse.Paid.{u} a simple ε (prepared s) R crop W)
    (shop:RG05Preconstruction.ReadoutPurchase R.b)(n:ℕ)(d:Fin 3→ℕ)(child:Fin n→Fin 3)
    (D:Fin n→ℕ)(fit:∀i,d (child i)<D i)(e:ℕ)(T:Finset (Fin n))(hs:T.Nonempty)
    (A τ:ℝ)(a0:0≤A)(τ0:0<τ):
    ∃start:ℕ,∀ᶠ v:ℕ in atTop,∃S:Realm G (e+1) Credit.leanC,
      S.draws=R.family.path.levels ∧ S.paid=R.metals.O ∧ S.y=zz R.family.path.levels ∧ S.anchor=v ∧
      ∀(j:Fin 3→ℕ),(∀a,start≤j a) → (∀a,(R.family.path.levels.budget (j a)).supportExponent≤100) →
    ∀(N per K c w target:ℕ),v≤w → w≤c → c≤K → K<N → v+1≤K →
    2≤R.family.path.levels.clock.hatBeta K →
    R.family.S.scale K-R.family.S.scale v≤A*(1+Real.log (R.family.path.levels.clock.hatBeta (v+1))) →
    ∀(η:ℝ)(M:Fin 3→ℝ)(Y:∀a:Fin 3,ℕ×ℕ→R.family.label (d a))
      (before:∀a,j a≤K)(reg:WilsonOriginalMicroscopicGuardedPageSchool.Indexed R d j target η M Y),
      0≤η → (∀a,0≤M a) → ∀(paid m C D₁ D₂:Fin 3→ℝ)(B ρ:ℝ),
    let g:=regulatorRun R.family N per K
    let s:=Real.log g⁻¹
    (∀a,0≤paid a) → (∀a,0≤C a) → (∀a,M a≤C a*Real.exp ((2*m a)*s)) →
    (∀a,Real.log (R.family.S.a K/R.family.S.a (j a))⁻¹≤D₁ a*s) →
    (∀a,paid a≤Real.exp ((d a:ℝ)*D₂ a*s)) →
    R.family.S.a c/R.family.S.a w≤Real.exp (-B*s) → power R d child m η D₁ D₂+τ+ρ≤B/4 →
    ∀(κ:(i:(Fin n))→Knob (D i))(pt:(Fin n)→Chamber)(cells:Digits S.draws (Fin n))(y:(Fin n) → Cover)(f:Pen D T→L[ℝ] ℝ),‖f‖≤1 →
    let P:=WilsonOlderFreshSoftTrialCut.source R D (d ∘ child) N K c S.draws S.paid κ pt cells y T f
    let x:=fun i=>vector R d j K target η M Y before reg N per (child i)
    let h:=mass (d ∘ child) T
    let H:=fun b=>cruises S.draws S.paid N h c w (P b)
    let full:=fun b=>cruises S.draws S.paid N h c v (P b)
    ∀q≤e,∀t:ℝ,|t|≤1 →
      (∏i,paid (child i))*‖reading R (d ∘ child) g x full q t-WilsonOlderFreshSoftCoveredRead.cost R (d ∘ child) S.draws S.paid N w v q t g x H‖≤
        bill R d child C*Real.exp (-ρ*s):=by
  obtain ⟨start,old⟩:=WilsonOlderFreshSoftTrialCut.original R simple shop d child D e T hs A τ a0 τ0
  refine ⟨start,?_⟩
  filter_upwards [eventually_ge_atTop start,WilsonIndependentCollarCensusCourse.original paid n (d ∘ child) D fit e 0 0]
    with v onset appointment
  obtain ⟨S,draw,scheme,heat,anchor,_,_,shelf,_⟩:=appointment
  refine ⟨S,draw,scheme,heat,anchor,?_⟩
  intro j paidJ support N per K c w target vw wc cK KN vK warm window η M Y before reg η0 M0 paid m C D₁ D₂ B ρ
  dsimp only
  intro p0 C0 salary stretch doses clip length κ pt cells y f probe q keep t t1
  have law:LocalRatio S.paid:=scheme.symm ▸ (RunFormalChain.fromRun R).receipt
  have hearing:=old v j onset paidJ support S anchor.le draw heat (shelf T) N per K c w target vw wc cK KN vK warm window η M Y before reg η0 M0 paid m C D₁ D₂ B ρ p0 C0 salary stretch doses clip length κ pt cells y f probe q keep t t1
  rw [←WilsonOlderFreshSoftCoveredRead.original R (d ∘ child) S.draws S.paid simple law N (mass (d ∘ child) T) w v q vw ((wc.trans cK).trans KN.le) t]
  exact hearing

end YM.Integration.WilsonOlderFreshSoftTrialCourse
