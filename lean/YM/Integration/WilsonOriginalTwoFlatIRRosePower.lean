theorem clock (live:j+1 ≤ N):
    1  ≤  x ∧ R.family.path.levels.clock.hatBeta (j+1)  ≤  x^2:=by
  have band: R.family.path.levels.clock.hatBeta (j+1)/2  ≤  R.family.path.β N per (j+1):=
    (R.makes.wilson.represents N per (j+1) live).band.1
  have pos:0<R.family.path.β N per (j+1):=Overlay.beta_positive R.makes.wilson live
  have rate:1 ≤ R.family.path.levels.clock.hatBeta (j+1):=(R.alloy.B.a.fits.delayed _).le
  have eq:(x)^2=9*R.family.path.β N per (j+1):=by
    change (3*(Real.sqrt (R.family.path.β N per (j+1)))⁻¹⁻¹)^2=_
    rw [inv_inv,mul_pow,Real.sq_sqrt pos.le];ring
  have good:0  ≤  x:=by change 0 ≤ 3*(Real.sqrt _)⁻¹⁻¹;rw [inv_inv];positivity
  constructor <;> nlinarith

theorem original (live:j+1 ≤ N)(filed:Filed (K:=K) (draw:=draw) (rate:=rate) (δ:=δ) cells κ pt seed side y t H)
    {C:ℝ}{E:ℕ}(cp:1 ≤ C)(allow:δ ≤ 1)(rent:0 ≤ rate)(out:rate ≤ C*(x)^E)(test:∀a,‖t a‖ ≤ C*(x)^E):
    ∑z:I,Real.exp (σ₀*(binder side y z).length)*WilsonIndependentCollarSlateIntensity.amount
      (words H z) (binder side y z).center  ≤  WilsonOriginalTwoFlatIRAddressedCap.coefficient n e (∑a,k a) C
        (Fintype.card I)*(x)^(2+2*n*E):=
  WilsonOriginalTwoFlatIRAddressedCap.original κ pt cells seed y t H filed (clock (R:=R) per live).1 cp
    (R.alloy.B.a.fits.delayed _).le (clock (R:=R) per live).2 allow rent out test

theorem six_four_four (s:(Stock.census (Fin 3)).Mode)(d:Fin 3→ℕ)(weights:(∑a,d a) ≤ 14)(P E depth:ℕ)
    (ready:4*(P+69+18*E) ≤ depth):
    4*(P+(power s.val.card ((∑a,d a)+1+2+(2+2*3*E))+0+2)) ≤ depth:=by
  have small:s.val.card ≤ 3:=by simpa using s.val.card_le_univ
  unfold WilsonOriginalTwoFlatIRHalo.power
  interval_cases h:s.val.card <;> omega

