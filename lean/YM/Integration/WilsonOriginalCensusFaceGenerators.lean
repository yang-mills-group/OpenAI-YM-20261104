variable {G:Gauge}{n q i:ℕ}{k D:Fin n→ℕ}{A δ σ:ℝ}
  (R:Run G)(Y:Realm G (q+1) Credit.leanC)(lo:Y.anchor ≤ i+1)(enrolled:Paid R Y lo D k δ σ)
  (N:ℕ)(X:Input Y lo univ k D A)(positive:0≤A)(limit:i+1<N)(width:0<σ)
  (per:ℕ)(y:Fin n → Cover)(t:Case D)
  (deep:∀s:Hot (Stock.census (Fin n)),0 < mass k s.val.val)
  (closed:Cloze D k Y Credit.leanC)(tickets:Insure n (mass k univ) Y Credit.leanC)
local notation "f" => fine R i per
local notation "J" => Stock.census (Fin n)
local notation "I" => Hot (J)
local notation "binders" => binder (f) y
local notation "H" => WilsonReceivedDepositedOrbitalLedger.book R Y lo enrolled N X positive limit width
  (binders) pin (fun _=>subset_univ _) (fun s=>s.property.choose_spec) deep y t closed tickets

theorem addressed:WilsonOriginalCensusFaceSheet.Addressed y (H) t:=
  ⟨fun _=>rfl,fun _=>rfl,fun s=>WilsonReceivedDepositedOrbitalPrint.seated (pin s) y⟩

variable (old:Outerm G D)(well:Wellness k old){α A₀:ℝ}(hs:0<α)(base:1≤A₀)
  (cover:CoverBill old q α A₀)(bound:∀y s,Same q (output X s N y) (old y s))
  (F:Forest (step R i per).ratio)(x:Wallet (room (Fin n)))
  (U:fieldDir G (coarse R i per) 1)(z:Precision.Key F G→ℝ)
local notation "M" => (submit old k q) y

def atom (hi:i<N)(s:(J).Mode)(a:ℕ):ℂ:=
  (∏v∈s.val,(x v).val)*Complex.ofReal (MvPolynomial.eval (Sum.elim z (flatten U))
    (coeff a (entered R N i per hi F (M) t s.val)))

local notation "quoted" => atom (q:=q) (k:=k) R N per y t old F x U z (by omega)
include well hs base cover bound in
theorem row (s:I)(a:ℕ)(through:a≤q):
    WilsonOriginalCensusPaidForest.ray (binders) R N i per (by omega) F dvd_rfl x (charts (H)) U z s a=
      (quoted) s.val a:=by
  have eqn:=WilsonReceivedDepositedOrbitalRay.original R Y lo enrolled N (pin s) X
    (subset_univ s.val.val) s.property.choose_spec positive limit t old well hs base cover bound y per F a through
  exact congrArg (fun p=>(∏v∈s.val.val,(x v).val)*Complex.ofReal (MvPolynomial.eval (Sum.elim z (flatten U)) p)) eqn

local notation "quiet" a:max => Cloud.paint z (SignedRegisteredMarkedProgram.register F U (coeff (a)
  (relative R N i per (by omega) F (covered R N i per))))
include well hs base cover bound in
theorem original (r:ℕ)(through:r≤q)(s:Hot (Board (J) r)):
    let a:=(Join.right s.val).val.card
    WilsonOriginalCensusPaidForest.value (binders) R N i per (by omega) F dvd_rfl x (charts (H)) U z r s=
      (a.factorial:ℂ)*(if (Join.left s.val).val.Nonempty then (quoted) (Join.left s.val) a else quiet a):=by
  intro a
  unfold WilsonOriginalCensusPaidForest.value
  by_cases h:(Join.left s.val).val.Nonempty
  · simp only [if_pos h]
    apply congrArg (fun v=>(a.factorial:ℂ)*v)
    let u:I:=⟨Join.left s.val,h⟩
    rw [sum_eq_single u]
    · rw [if_pos (show (binders u).mode=Join.left s.val from rfl)]
      apply row R Y lo enrolled N X positive limit width per y t deep closed tickets old well hs base cover bound F x U z u
      exact le_trans (by simpa only [Fintype.card_fin] using Finset.card_le_univ (Join.right s.val).val) through
    · intro v _ other
      exact if_neg (fun hit=>other (Subtype.ext hit))
    · simp
  · simp only [if_neg h]
    rfl

