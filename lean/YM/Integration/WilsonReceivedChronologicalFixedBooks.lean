  have late:=(mem_Ico.mp a.property).2
  omega


open WilsonOriginalCensusAttendanceStation (Day)

theorem on_material {o:ℕ}(day:Day s R simple ask.school o N)(old:o ≤ m)(valid:K ≤ N)
    (bank:ℝ)(one:1 ≤ bank)(cap:Fin n → ℝ)(power:Fin n → ℕ)
    (opened:(eventually_atTop.mp (WilsonReceivedChronologicalMaterialWallet.original (q:=q)
      R simple k bank cap one power)).choose ≤ m)
    (dp:0 ≤ δ)(ds:δ ≤ 1)(cells:Digits V.draws (Fin n))(κ:(v:Fin n)→Knob (D v))(pt:Fin n→Chamber)
    (seed:(v:Fin n)→Choice R k v)(ground:Fin n → Cover)(t:Case D)
    (bounded:∀a∈Ico m (K-1),∀v,‖t v‖ ≤ cap v*(heat (a+1))^(power v))
    (gates:∀a:(domain),gate a.val):
    let z:=fun a=>homes cells ground m (a-m)
    ∀M:(a:(domain)) → Material R N (a.val+1) q k (width a.val) (binder (R.family.side (a.val+1) per) (z a.val)),
    (∀a:(domain),Filed (K:=K) (draw:=draw) (rate:=(rate₀ bank)) (δ:=δ) cells κ pt seed
      (R.family.side (a.val+1) per) (z a.val) t (M a)) →
    ∀a:(domain),let side:=R.family.side (a.val+1) per
    let baseAge:=old.trans (mem_Ico.mp a.property).1
    let live:=living valid a
    let w:=base bank cap power (heat (a.val+1))
    (∀v,0<w v) ∧
    (∀v,w v*max 1 (WilsonOriginalMixedBlockBudget.roots (binder side (z a.val))
      (WilsonIndependentCollarMaterialWallet.bill (M a) w)) ≤ (heat (a.val+1))^(power v+4)) ∧
    ∃op:Mentor.Opportunity (R.alloy.B.a.clock.J (a.val+1)) (R.alloy.B.a.clock.J a.val),
      op.count=ask.school.pieces ∧ op.stage=ask.school.order+1 ∧ ∀tol:ℝ,0<tol →
      WilsonOriginalCensusMaterialPosting.Posted R day.hk (teacher) (metals) day.π day.Γ (day.Ψ per) room.books
        baseAge op (day.lessons a.val baseAge live) room.ahead (port side (z a.val)) (binder side (z a.val))
        k ask.order ask.shelf q w (M a) tol:=by
  intro z M given a side baseAge live w
  obtain ⟨test,knob,same,_,account,located,_,_⟩:=given a
  have young: m ≤ a.val:=(mem_Ico.mp a.property).1
  have money:=(eventually_atTop.mp (WilsonReceivedChronologicalMaterialWallet.original (q:=q)
      R simple k bank cap one power)).choose_spec m opened a.val young N per (by omega) D t δ
        (width a.val) side (z a.val) V (M a) test account located same dp ds (bounded a.val a.property)
  have reached:a.val+1<N:=by have hi:=(mem_Ico.mp a.property).2;omega
  obtain ⟨⟨cal⟩,_,op,_,seats,stage,_,_⟩:=(day.seen per).2.2.2 a.val baseAge reached
  refine ⟨money.1,money.2,op,seats,stage,?_⟩
  intro tol positive
  exact WilsonOriginalCensusPublicationLesson.original R simple day.hk (teacher) (metals) day.π day.Γ
    (day.Ψ per) (day.seen per).1 (WilsonPhysicalHistoryPriorAperture.law G MintClock.splits) room.books
    baseAge live op (day.lessons a.val baseAge live) cal room.ahead room.chamber room.hospital
    (port side (z a.val)) (binder side (z a.val)) k ask.order ask.shelf q w (M a) ask.school.pieces
    (ask.school.order+1) p ask.load (gates a) seats stage money.1 positive room.warm (day.seen per).2.1 room.pass room.way

