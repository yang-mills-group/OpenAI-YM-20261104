variable {G : Gauge} {n q : ℕ} (R : Run G) (simple : G.Simple) (d : Fin n → ℕ)
  (B : ℝ) (cap : Fin n → ℝ)
local notation "H" i:max => R.family.path.levels.clock.hatBeta (i)
local notation "rate" N:max per:max m:max δ:max => (Real.sqrt (R.family.path.β N per (m+1)))^(δ:ℝ)*B^n
local notation "tickets" M:max b:max geom:max => fun v=>b v*max 1
  (WilsonOriginalMixedBlockBudget.roots geom (WilsonIndependentCollarMaterialWallet.bill M b))

include simple in
theorem original (one : 1 ≤ B) (power : Fin n → ℕ) (positive : ∀v, 0 < d v) :
    ∀ᶠ m : ℕ in atTop, ∀j, m ≤ j → ∀N per, j+2 ≤ N →
    ∀(lens : Fin n → ℕ) (pt : Fin n → Chamber) (δ σ : ℝ)
      (V : Realm G (q+1) Credit.leanC) (draw : V.draws = R.family.path.levels)
      (digits : Digits V.draws (Fin n)) (seed : (v : Fin n) → Choice R d v)
      (y : Fin n → Cover),
    Submitted R V draw lens d N (j+2) j (rate N per m δ) δ σ →
    Income (k:=d) R (fun v=>contact (lens v)) pt q j → 0 ≤ δ → δ ≤ 1 →
    (∀v, ‖present lens v‖ ≤ cap v*(H (j+1))^(power v)) →
    let side := R.family.side (j+1) per
    let geom := binder side y
    let b := base B cap power (H (j+1))
    ∃L : Material R N (j+1) q d σ geom,
      Account V (rate N per m δ) δ side y L (present lens) ∧ L.tests=lens ∧
      Addressed y L (present L.tests) ∧
      (∀z S, output L.prior S N z =
        fixed R d (fun v=>contact (L.tests v)) pt N (j+2) (j+1) (onLevels draw digits) seed z S) ∧
      (∀S : Hot (Stock.census (Fin n)), Real.exp (σ*(geom S).length)*
        WilsonIndependentCollarSlateIntensity.amount (words L S) (geom S).center ≤
          WilsonIndependentCollarMaterialIntensity.price L S) ∧
      (∀v,0 < b v) ∧ (∀v,(tickets L b geom) v ≤ (H (j+1))^(power v+4)) ∧
      ∀(x : Affinity.Wallet (room (Fin n))) (S : Hot (Stock.census (Fin n))) (a : ℕ)
        (Y : Link G side), sideValue L (fun v=>contact (L.tests v)) pt (j+2)
          (onLevels draw digits) seed x false S a Y =
        (∏v∈S.val.val,(x v).val)*Complex.ofReal (diagonal (mass d S.val.val+a)
          (fun r z=>(touch (present L.tests) S.val.val)
            (plume ((fixed R d (fun v=>contact (L.tests v)) pt N (j+2) (j+1)
              (onLevels draw digits) seed y S.val.val).2 a r) side z)) Y) := by
  filter_upwards [WilsonReceivedChronologicalMaterialWallet.original (q:=q) R simple d B cap
    one power] with m paid
  intro j mj N per live lens pt δ σ V draw digits seed y submitted bank dp ds price side geom b
  have occupied (S : Hot (Stock.census (Fin n))) : 0 < mass d S.val.val :=
    Finset.sum_pos (fun v _=>positive v) S.property
  obtain ⟨L,account,tests,located,reported,_,reads⟩ :=
    WilsonCapturedPrimaryWeakTrialSubmittedSource.original (side:=side) y pt seed submitted
      bank (by omega) live digits occupied
  have xt : HEq (present L.tests) (present lens) := by rw [tests]
  obtain ⟨pos,charge⟩ := paid j mj N per (by omega) lens (present lens) δ σ side y V L
    (present L.tests) account located xt dp ds price
  exact ⟨L,account,tests,located,reported,
    fun S=>WilsonOriginalFixedTestCensusGeometry.submitted y L (present L.tests) located S,
    pos,charge,reads⟩

end YM.Integration.WilsonAddressedPublicSubmittedPort
