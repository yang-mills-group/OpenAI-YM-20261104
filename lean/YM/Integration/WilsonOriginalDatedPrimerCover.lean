variable {G:Gauge} (R:Run G)

def Invoice (m N i e:ℕ) (π:ℕ→Layout G)(Γ:ℕ→Pace.Coin):Prop:=
  ∃ (Z:ℕ→SeriesA G)(μ B:ℝ),0<μ ∧ Read R N m e Z π Γ ∧ Issued R N (i+1) e (Z (i+1)) μ B

theorem prepaid (simple:G.Simple)(v:ℕ→Gear G→ℝ)(funded:FundedMarkedCoverRows.prices v R.kit)
    (paths:FundedOriginalVacuumPaths.prices R.kit)(e:ℕ):
    ∀ᶠ m:ℕ in atTop,∀N:ℕ,m≤N→
    ∀(D:Roots (G:=G) R.metals.p.profile R.metals.K R.metals.p.kernel)(T:D.Tab R.rolls)
      (π:ℕ→Layout G)(Γ:ℕ→Pace.Coin),PlanV.Path D R.alloy T e N m π Γ→TicketP R.alloy R.kit D T→
      ∀i:ℕ,m ≤ i → i < N → Invoice R m N i e π Γ:=by
  obtain ⟨_,dates⟩:=WilsonOriginalMeasuredOccupiedForest.original R simple v funded paths e
  filter_upwards [dates] with m paid
  intro N cut D T π Γ path ticket i lo hi
  obtain ⟨Z,banks,_,course⟩:=paid N cut
  obtain ⟨μ,pos,_,bank⟩:=banks (i+1) (by omega) hi
  exact ⟨Z,μ,_,pos,course D T π Γ path ticket.pledge.formal,bank⟩

theorem named {d D Q:ℕ}(L:Primer.Families R.family)(a:hue G)(depth:d<D)(i:ℕ)
    (letter:Letter (R.family.labels.level d))(p:WilsonOlderFreshGraphPainter.Ballot i D){σ:ℝ}
    (T:WilsonOlderFreshGraphSlate.Copy G d Q σ)
    (published:WilsonOlderFreshGraphDatedSalary.Published R L a depth i letter p T):
    WilsonOriginalPrimerStampedRay.Matched T (chart R L a depth i letter p):=by
  intro j hj n z A
  rw [WilsonElectedPrimaryTensor.named]
  exact published ⟨j,Nat.lt_succ_of_le hj⟩ n A (pin z)

