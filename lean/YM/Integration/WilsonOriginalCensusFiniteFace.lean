    (course:Agrees R N start e Z π Γ)(live:start ≤ i)(starts:Γ i 0=0)(simple:G.Simple)
    (s:Hot (Stock.census (Fin n)))(r d:ℕ)(through:r≤q)(paid:d≤e+2)(kept:d≤r)
    (v:Stationary.Link G (coarse R i per)):
    Adjacent.born ((seen) s.val.val r) ((Rebirth.caliber (Γ i) starts).back (e+2)) 0 r d v=
      sideValue L κ pt top cells seed x true s.val d ((coordinates G (coarse R i per)) v):=by
  exact (WilsonOriginalCensusFiniteView.original R Y lo enrolled N X positive limit width per y (cells i) t
    deep closed tickets old well hs base cover bound x tag course live starts simple s.val.val r d through paid kept v).trans
    (WilsonOriginalCensusFaceFold.original y L t κ pt top cells seed active old declared well hs base cover
      x s d ((coordinates G (coarse R i per)) v)).symm

