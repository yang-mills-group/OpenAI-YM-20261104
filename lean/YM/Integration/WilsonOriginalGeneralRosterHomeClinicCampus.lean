def Window (h t:ℕ)(d:I→Fin (D+1))(field:(i:I)→{s:ℝ//0<s ∧ s<δ}→Bool→Bool→S.Field (d i).val)
    (W:XSpace.Initialize G){a k u e:ℕ}(tag:Fin (a+1)→I)(cap:Fin (a+1)→ℕ)
    (fit:∀i,(d (tag i)).val<cap i)(kind:Fin (a+1)→Bool)(own:∀i,Rails (d (tag i)).val k u e)
    (M:I→ℝ)(E:I→ℕ)(α:∀i,Alma (R.family.labels.level (d (tag i)).val)→ℝ)(Z₀ B₀:Fin (a+1)→Credit)(floor:ℕ)
    {B:Type}[Fintype B](main:Row I)(pair:Fin main.size→Test 2)(p:Fin main.size→ℕ)(outside:B→Row I)(home:B→Option I)
    (located:ℝ→(I→{s:ℝ//0<s ∧ s<δ})→ℕ→ℕ→Prop):Prop:=
  let grade:=fun i=>(d (tag i)).val
  let rows:=menu main pair p outside
  ∀target:ℕ,
    let e:=need d E rows
    let pwr:=univ.sup e+1
    let reserve:=depth ((2*pwr+∑i,E i)+1) (width T h) D
    let tuition:=max 1 (4*∑i,M i)
    let power:=(∑i,E i)+WilsonAddressedMixedRawTrial.power T h reserve D
    ∀ lo : ℕ, ∃ (base j₀ ear₀ j₁ ear₁ : ℕ), lo ≤ base ∧ floor ≤ base ∧ base ≤ j₀ ∧ j₀ ≤ ear₀ ∧ ear₀ < ear₁ ∧ j₁ ≤ ear₁ ∧ Stop (C) 0 j₀ ear₀ ∧ Stop (C) 0 j₁ ear₁ ∧
    ∀ᶠr in trail,
      ∀ρ:I→{s:ℝ//0<s ∧ s<δ},(∀i,r≤(ρ i).val ∧ (ρ i).val≤outer z h r)→(∃i,(ρ i).val=r)→
      let f:=reporter F books ρ
      let K:=berth R reserve f
      ∃A:∀_N _per:ℕ,(i:I)→Bool→((C).label (d i).val≃ₗ[ℂ](C).label (d i).val),
      located r ρ f K ∧
       (∀mode:Bool,WilsonReflectedMixedLocatedSchool.Paid F D T d books (fun i s=>field i s mode) M E ρ f) ∧
      (∀(m N per:ℕ),floor ≤ m → m ≤ K → K ≤ N →
       ∀(family branch:Fin (a+1)→Bool)(spin:Fin (a+1)→Motion)(home:Fin (a+1)→ℝ)
         (label:Fin (a+1)→ℂ)(phase:Fin (a+1)→ℂ→L[ℝ]ℝ),
       let dates:=fun i=>WilsonReflectedPublicStationFare.station F ((books (ρ (tag i))).rows (d (tag i))) (branch i)
       let raw:=fun i=>(((books (ρ (tag i))).rows (d (tag i))).arm (branch i)
         (field (tag i) (ρ (tag i)) (family i) (branch i))).source (N,per)
       WilsonOriginalGeneralRosterHomeFiling.Enrolled R W grade cap fit kind own α Z₀ B₀ m K N per dates
         (fun i=>A N per (tag i) (branch i)) raw spin home label phase) ∧
      ∀w:Unit⊕(Fin main.size⊕B),∃j:ℕ,ear₁≤j ∧ j+2≤f ∧ ∀mode branch:I→Bool,
        Returned F books field (ρ:=ρ) (rows w).stock (mode ∘ (rows w).stock) (branch ∘ (rows w).stock) A M E tuition power target t
          f K base j ear₀ ear₁ (request E (rows w)) (rows w).desired (rows w).test (dilation main (fun i=>(ρ i).val) r home w)

theorem original {h t:ℕ}{d:I→Fin (D+1)}(field:(i:I)→{s:ℝ//0<s ∧ s<δ}→Bool→Bool→S.Field (d i).val)
    (W:XSpace.Initialize G){a k u e:ℕ}(tag:Fin (a+1)→I)(cap:Fin (a+1)→ℕ)
    (fit:∀i,(d (tag i)).val<cap i)(kind:Fin (a+1)→Bool)(own:∀i,Rails (d (tag i)).val k u e)
    (bought:Booked F books h t d field W tag cap fit kind own):
    ∃(M:I→ℝ)(E:I→ℕ),(∀i,1≤M i) ∧ ∃α:∀i,Alma (R.family.labels.level (d (tag i)).val)→ℝ,
    (∀i p,0≤α i p) ∧ ∃(Z₀ B₀:Fin (a+1)→Credit),∀ᶠfloor:ℕ in atTop,
    ∀(B:Type)[Fintype B](main:Row I)(pair:Fin main.size→Test 2)(p:Fin main.size→ℕ)(outside:B→Row I)(home:B→Option I)
     (located:ℝ→(I→{s:ℝ//0<s ∧ s<δ})→ℕ→ℕ→Prop),
      (∀ᶠr in trail,∀ρ:I→{s:ℝ//0<s ∧ s<δ},(∀i,r≤(ρ i).val ∧ (ρ i).val≤outer z h r)→(∃i,(ρ i).val=r)→
        let f:=reporter F books ρ
        located r ρ f (berth R (WilsonOriginalGeneralRosterHomeReserve.amount T h d E main pair p outside) f))→
      Window F books h t d field W tag cap fit kind own M E α Z₀ B₀ floor main pair p outside home located:=by
  classical
  letI : Nonempty I := ⟨tag 0⟩
  obtain ⟨M,E,mn,α,an,Z₀,B₀,ready⟩:=bought
  refine ⟨M,E,mn,α,an,Z₀,B₀,?_⟩
  filter_upwards [ready] with floor buy
  intro B _ main pair p outside home located paid
  let rows:=menu main pair p outside
  intro target ask power reserve tuition rate lo
  obtain ⟨base,j₀,u,j₁,v,above,live,older,first,ordered,second,old,new,campus⟩:=buy _ rows target lo
  refine ⟨base,j₀,u,j₁,v,above,live,older,first,ordered,second,old,new,?_⟩
  filter_upwards [campus,paid] with r market settled
  intro ρ range root f K
  obtain ⟨A,fees,stock,rowsHere⟩:=market ρ range root
  refine ⟨A,settled ρ range root,fees,stock,?_⟩
  intro w
  obtain ⟨j,vj,late,heard⟩:=rowsHere w
  have up:=(range (Classical.arbitrary I)).1.trans (range _).2
  have place:=WilsonOriginalGeneralRosterHomeMenu.housed main (fun i=>(ρ i).val) r _ home up range w
  exact ⟨j,vj,late,fun mode branch=>heard _ place.1 place.2 (mode ∘ (rows w).stock) (branch ∘ (rows w).stock)⟩

end YM.Integration.WilsonOriginalGeneralRosterHomeClinicCampus
