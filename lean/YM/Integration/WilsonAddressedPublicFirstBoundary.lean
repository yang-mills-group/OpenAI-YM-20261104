theorem original {rentLimit tol:ℝ}
    (origin:Source R day.hk (roots semester R simple) (tab semester R simple) day.π day.Γ (day.Ψ per)
      school.books (old.trans early) op (day.lessons (j+1) (Nat.le_succ_of_le (old.trans early)) live)
      school.ahead d (seed) hd (spots) (cells) (ask).order (ask).shelf rentLimit)
    (position:(o)=placed R fine z)
    (tags : ∀t:Covers R.family.path.levels.S (j+1) (sideₗ),(step R (j+1) t.val).Choices)
    (breadthCap:ℕ)
    (fit : (ask).order ≤ Burn.horizon (ask).vac+1)(shelved : (ask).shelf ≤ (clock).J (j+1))
    (count : op.count ≤ Burn.horizon (ask).vac+2)(depth : 2*rentOrder+8 ≤ (ask).order)(age : rentOrder+3 ≤ 3*(ask).vac+2)
    (ready : WilsonReceivedMeasuredStampPrice.opening R simple rentOrder (ask).order (ask).vac depth age
      (by norm_num:0<(1:ℝ)) ≤ j+1)
    (loDepth : lowOrder ≤ (clock).J (j+1))(loShelf : lowShelf ≤ (clock).J j)
    (loSeats : (ask).school.pieces ≤ Burn.horizon (ask).vac+2)
    (halo : (eventually_atTop.mp (WilsonOriginalOccupiedRaffleIndependent.halo R simple)).choose ≤ j+1)
    (income : (eventually_atTop.mp (WilsonEmittedOriginalCalendar.wages R simple)).choose ≤ j+1)
    (upperWidth : scale ≤ 1)
    (sold : (eventually_atTop.mp ((Next.Rank.Station.hat_rate R.family.path.levels simple).eventually_ge_atTop
      (max 1 (WilsonOriginalCensusCanonicalRows.ceiling R d 1)))).choose ≤ j+1)
    (rent : rentLimit ≤ (Pert.Asymptotics.regulatorRun R.family N per (j+1+1))^rentOrder)
    (tube : LinkTube G)(front : (t:Multi.Hot (marks)) → t.val.val)
    (teacher : 0<σₗ ∧ Real.exp ((σₗ)⁻¹^2)≤(Hhat) ∧
      (((day.Ψ per) (j+1)).p.supportExponent+2)*((((day.Ψ per) (j+1)).p.B:ℝ)⁻¹)≤(σₗ)/2 ∧
      (Real.sqrt ((day.Ψ per) (j+1)).beta)⁻¹≤1/2 ∧ ((day.Ψ per) (j+1)).p.B=Nat.ceil ((Real.log (Hhat))^2) ∧
      ((day.Ψ per) (j+1)).p.supportExponent+2≤102)
    (menu : WilsonOriginalCensusCanonicalRelativePeriodSchedule.Appointment R simple d lens pt
      (fun _ : Fin n=>4) tube (ask).order lowOrder target precision (WilsonAddressedPublicFirstRanks.original d P).2.2.2.1)
    (go : menu.first ≤ j+1)(board : menu.period (j+1) breadthCap ≤ per)
    (near : ∀t : Multi.Hot (marks), breadth t.val.val (front t).val 0
      (relative t.val.val (front t).val (spots)) ≤ breadthCap)
    (pieces:op.count=(ask).school.pieces)
    (s:(marks).Mode){u b geomCost roomSize:ℕ}{η:ℝ}(ep:0<η)(tp:0<tol)
    (two:2≤(bound))
    (late:(eventually_atTop.mp (WilsonReceivedChronologicalPanelClock.original R simple ask (charges) P
      geomCost precision target (bound) tol η two tp ep)).choose ≤ b)
    (floorOld:WilsonSingleHardRadius.first R simple ≤ m)(oldEar:m ≤ u)(ub:u≤b)(bj:b≤j)
    (geo:R.family.S.a b/R.family.S.a (j+1+1)≤(R.family.path.levels.clock.hatBeta b)^geomCost)
    (np:0<n)
    (support:∀i,(R.family.path.levels.budget i).supportExponent=100)
    {df:ℕ}{frame:Frame G df}(section_:SectionData frame)(group:Hol G)
    (Z:Support (R.family.side b per))(center:Site (R.family.side b per))(held:center∈Z)
    (homes:∀i∈s.val,sites R (home) (Nat.le_succ_of_le bj) i∈Z)
    (roof:coverNumber ((day.Ψ per) b).p.B Z ≤ roomSize) :

    ∀e,u≤e→e≤b→
      ‖WilsonOriginalJointTrialHearing.fee R N per (1:Config G (R.family.side e per)) (rows) (j+1) s‖
        ≤WilsonReceivedChronologicalLastFlat.wage s P roomSize η*(gAt b)^P:=by
  classical
  let a:{a:ℕ//a∈Finset.Ico first (j+1+1-1)}:=⟨j,Finset.mem_Ico.mpr ⟨early,by omega⟩⟩
  obtain ⟨reg,_matter⟩:=WilsonReceivedChronologicalFixedSocketLife.atDate (power:=zeroFee) (P:=P)
    (κ:=fun i=>contact (lens i)) (pt:=pt) (top:=j+1+1) (first:=first) (house:=school) (day:=day) (toll:=toll) (valid:=live) (old:=old) (test:=present lens)
    (classroom:=classroom) (fine:=fine) (z:=z) (s:=mask) (q:=q) (paid:=paid) (hd:=hd) (prior:=prior) (σ:=scale) a
  have raw:=WilsonAddressedPublicFirstLive.atSource (power:=zeroFee) (P:=P) (κ:=fun i=>contact (lens i)) (pt:=pt) (top:=j+1+1) (first:=first) (house:=school)
    (day:=day) (valid:=live) (old:=old) (toll:=toll) (test:=present lens) (classroom:=classroom)
    (fine:=fine) (z:=z) (s:=mask) (q:=q) (paid:=paid) (hd:=hd) (prior:=prior) (σ:=scale)
    ((old.trans early).trans (Nat.le_add_right j 2)) (o) position
  obtain ⟨cash,jet,regular,accuracy,_deep,cap⟩:=WilsonAddressedPublicFirstRanks.original d P
  have page:(ask).order=length:=max_eq_left (capital).deep
  obtain ⟨⟨hi,lo,sale⟩,_reads⟩:=WilsonAddressedPublicFirstSocket.original R simple d P school day
    (old.trans early) live op (seed) hd (spots) (track) lens pt (wallet₀) (toll j) (rows) reg origin raw
    tags rentOrder precision target breadthCap fit shelved count depth age ready loDepth loShelf
    loSeats halo income upperWidth sold rent tube front teacher accuracy (page.symm ▸ cap) cap
    menu go board near pieces s ep tp two late floorOld oldEar ub bj geo np cash jet regular support
    section_ group Z center held homes roof
  intro e ue eb
  exact WilsonReceivedChronologicalTwoFlatSale.paid R simple day.hk (roots semester R simple)
    (tab semester R simple) day.π day.Γ (day.Ψ per) school.books (old.trans early)
    school.ahead (rows) hi lo sale ue eb

