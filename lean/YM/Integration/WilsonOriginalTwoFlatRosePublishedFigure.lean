local notation "FC" => Finset (Fin 3)
variable {G:Gauge}(R:Run G)(D:Fin 3→ℕ)(s:FC)(κ:(a:Fin 3)→Knob (D a))(pt:Fin 3→Chamber)
    (A:Case D){e f K N per c v:ℕ}(V:Realm G (e+1) Credit.leanC)
    (draw:V.draws=R.family.path.levels)(paid:V.paid=R.metals.O)
    (o:Fin 3→Site (R.family.side f per))(fk:f≤K)(kn:K≤N)(vc:v+1≤c)(ck:c≤K)
local notation "P" => pin R fk o
local notation "X" => pin R (fk.trans kn) o
local notation "raw" => ((X) 1,(X) 2)
local notation "tape" => WilsonReceivedChronologicalMaterialSites.digits R (P)
local notation "root" => WilsonIndependentCollarOrdinaryCruise.address R.family.path.levels (tape) (c-(v+1)) (v+1)
  (footprint R (P) (vc.trans ck))
def profile (D:Fin 3→ℕ)(s:FC)(A:Case D):Pen (D ∘ seat s) (Finset.univ:Finset s) →L[ℝ] ℝ:=
  touch (fun i:s=>A i.val) (Finset.univ:Finset s)

def test (unit:‖profile D s A‖≤1):TestAt D s where
  coeff:=fun i=>κ i.val
  phase:=fun i=>pt i.val
  test:=profile D s A
  bound:=unit

private theorem undone {α:Type*}(F:α→Type*){u v:α}(same:u=v)(x:F v):
    cast (congrArg F same) (same.symm ▸ x)=x:=by cases same;rfl


private def scalar (N per K c b p:ℕ)(w:(i:Fin 3)→R.family.label (grade i))(θ:ℝ)
    (C:Digits R.family.path.levels s)(Y:s → Lattice.Cover):ℂ:=
  WilsonOlderFreshSoftFigureReading.reading R (grade ∘ seat s) (regulatorRun R.family N per K)
    (fun i:s=>entire R (grade i.val) K (N,per) (w i.val))
    (fun a=>WilsonOlderFreshSoftSocketRestored.stopped R (grade ∘ seat s) N K c b C Y univ (profile D s A)
      (stencil R (D ∘ seat s) (grade ∘ seat s) a (fun j:s=>κ j.val) (fun j:s=>pt j.val))) p θ

private theorem chart (L:Levels G)(O:ChartRatio G)(drawL:L=R.family.path.levels)(paidO:O=R.metals.O)
    (N per K c b p:ℕ)(w:(i:Fin 3)→R.family.label (grade i))(θ:ℝ)(C:Digits L s)(Y:s → Lattice.Cover):
    WilsonOlderFreshSoftFigureReading.reading R (grade ∘ seat s) (regulatorRun R.family N per K)
      (fun i:s=>entire R (grade i.val) K (N,per) (w i.val))
      (fun a=>cruises L O N (mass (grade ∘ seat s) univ) c b
        (WilsonOlderFreshSoftTrialCut.source R (D ∘ seat s) (grade ∘ seat s) N K c L O
          (fun j:s=>κ j.val) (fun j:s=>pt j.val) C Y univ (profile D s A) a)) p θ=
      scalar R D s κ pt A N per K c b p w θ (cast (congrArg (fun l=>Digits l s) drawL) C) Y:=by
  subst L O
  rfl

private theorem located (T:TestAt D s)(center:(X) 0=0)(rooms:Rolled R o fk kn vc ck):
    cast (congrArg (fun (g:Levels G)=>Digits g s) draw) (enrolled R D V draw N per c (ck.trans kn) (raw) s T).digit=(fun j (a:s)=>(tape) j a.val) ∧
      (enrolled R D V draw N per c (ck.trans kn) (raw) s T).root=(fun a:s=>(root) a.val):=by
  have atNode:atOrigin (raw)=(X):=by
    funext i;fin_cases i <;> simp [atOrigin,center]
  obtain ⟨digits,placed⟩:=rooms
  constructor
  · calc
      _=fun j (a:s)=>WilsonOriginalPublicFixedCourse.digits R (N:=N) per (atOrigin (raw)) j (seat s a):=
        undone (fun L:Levels G=>Digits L s) draw _
      _=fun j (a:s)=>(tape) j a.val:=by rw [atNode,digits];rfl
  · change (fun i:s=>WilsonOriginalPublicFixedCourse.home R (N:=N) per c (ck.trans kn)
      (atOrigin (raw)) (anchor s) (seat s i))=_
    rw [atNode,placed (anchor s)]
    rfl

include draw paid in
private theorem page (unit:‖profile D s A‖≤1)(w:(i:Fin 3)→R.family.label (grade i))(late p:ℕ)(θ:ℝ):
    WilsonOlderFreshSoftRoseMarket.row (R:=R) D V s N K c late (v+1) (enrolled R D V draw N per c (ck.trans kn) (raw) s (test D s κ pt A unit)) (regulatorRun R.family N per K)
      (fun i=>entire R (grade i) K (N,per) (w i)) p θ false=
      scalar R D s κ pt A N per K c (v+1) p w θ (cast (congrArg (fun l=>Digits l s) draw) (enrolled R D V draw N per c (ck.trans kn) (raw) s (test D s κ pt A unit)).digit)
        (enrolled R D V draw N per c (ck.trans kn) (raw) s (test D s κ pt A unit)).root:=by
  exact chart R D s κ pt A V.draws V.paid draw paid N per K c (v+1) p w θ (enrolled R D V draw N per c (ck.trans kn) (raw) s (test D s κ pt A unit)).digit (enrolled R D V draw N per c (ck.trans kn) (raw) s (test D s κ pt A unit)).root

include draw paid in
theorem original (unit:‖profile D s A‖≤1)(simple:G.Simple)(ratio:LocalRatio R.metals.O)(center:(X) 0=0)
    (rooms:Rolled R o fk kn vc ck)(w:(i:Fin 3)→R.family.label (grade i))(late p:ℕ)(θ:ℝ):
    WilsonOlderFreshSoftSocketTotal.figure R grade κ pt N per K c (v+1) (tape) s w (root) (touch A s) p θ=
      WilsonOlderFreshSoftRoseMarket.row (R:=R) D V s N K c late (v+1) (enrolled R D V draw N per c (ck.trans kn) (raw) s (test D s κ pt A unit)) (regulatorRun R.family N per K)
        (fun i=>entire R (grade i) K (N,per) (w i)) p θ false:=by
  have pos:=located R D s V draw o fk kn vc ck (test D s κ pt A unit) center rooms
  have node:=congrArg₂ (scalar R D s κ pt A N per K c (v+1) p w θ) pos.1 pos.2
  have income:=page R D s κ pt A (v:=v) V draw paid o fk kn ck unit w late p θ
  refine Eq.trans ?_ (node.symm.trans income.symm)
  exact WilsonOriginalTwoFlatRoseRestrictedFigure.original R D grade s κ pt N per K c (v+1) (tape)
    (root) A simple ratio ck kn w p θ

