theorem original (inlet:post t mt (faces top)) (counted:Countable inlet.inputIndex)
    (refs:∀v:Fin 3,R.family.ref (grade v) ≤ N)
    (path:PlanV.Path D R.alloy tab (Burn.horizon k) N m π Γ)
    (pass:Pass D tab R.alloy R.kit) (month:Scholar.Month R.rolls D tab R.alloy.delay)
    (fits:order ≤ Burn.horizon k+1) (packed:order+shelf ≤ Burn.horizon k+2)
    (q l degree:ℕ) {price:ℝ} (cap:0 ≤ price) (deep:2*(q+2)+8 ≤ order) (aged:q+2+3 ≤ 3*k+2) {i:ℕ}
    (late:WilsonReceivedMeasuredStampPrice.opening R W.simple (q+2) order k deep aged zero_lt_one ≤ i+1)
    (weak:(eventually_atTop.mp (WilsonThermometerAncestralCalendar.weak R simple)).choose ≤ i)
    (mi:m ≤ i) (both:i+2 ≤ t)
    (days:((t-i:ℕ):ℝ) ≤ price*(Real.log (2+Real.log (R.alloy.B.a.clock.hatBeta i)))^degree)
    (booked:(eventually_atTop.mp (WilsonThermometerAncestralFunds.original R simple (degree+1) seats q l cap)).choose ≤ i)
    (oldRent:inlet.rent ≤ (g t)^(q+2)) (start:(g t)^l ≤ Poly.toll inlet.w full) 
    (way:WayStation R.kit) (station:WilsonCenteredCaptureClock.first R simple ≤ i) (sec:R.t 0 ≤ i)
    (slow:∀ j,((R.family.S.block j).val:ℝ) ≤ Real.log (RG16.Lambda R.family.path.levels j))
    (ready:WilsonReportLampForecast.Ready R.family.path.levels)
    (early:(eventually_atTop.mp (WilsonCenteredReporterClock.original R simple slow ready)).choose ≤ i)
    (activated:(eventually_atTop.mp (WilsonRootedKioskPostRadius.original R simple)).choose ≤ i)
    (force:q ≤ R.alloy.B.a.clock.J i)
    (opening:∀c ≤ seats, WilsonFirstReceivedEarnedFee.opening R simple c q order k (by omega) (by omega)
      (show (0:ℝ)<1/4 by norm_num) ≤ i)
    (saved:(eventually_atTop.mp (WilsonFullFaceSignedReserved.original R simple q)).choose ≤ i)
    (stripGrant:strip) (depth:ℕ) (H cap₀:ℝ) (hc:0 ≤ cap₀) (fit:k ≤ R.alloy.B.a.clock.J i)
    (heard:(eventually_atTop.mp (WilsonThermometerCenteredCompensation.original R simple D φ stripGrant order shelf
      k seats depth H cap₀ hc)).choose ≤ i)
    (fund:Volume.Fund D R.rolls tab φ books R.alloy.delay) (p:ℕ) (surplus:(p+1)+(3+(l+2)+87) ≤ q)
    (born:∀v,inlet.passport.origin v=(R.family.S.toDepth top per).parent (o.origin v))
    (profile:Test 3) (r:ℝ) (room:(eventually_atTop.mp (WilsonThermometerRegisteredAbsoluteRoom.spatial R simple profile)).choose ≤ i)
    (space:|r| ≤ R.family.S.a i) (relative:Site (R.family.side N per) × Site (R.family.side N per))
    (placed:o.origin=atOrigin relative) (massAt:WilsonThermometerRegisteredAbsoluteRoom.mass R r (N,per) profile relative≠0)
    {η:ℝ} {T:Campaign R} {camp:Campaign.Pillars R T} (funded:FundedOriginalProperties.{u} simple η camp)
    (J:Voice G) (clear:Clear G J) (axes:Lattice.Order) {ε:ℝ} (ep:0<ε)
    (active : max (WilsonJointAxialRoster.opening R simple funded slow J clear (Fintype.card (Fin 3)) width₀ q ep)
      (WilsonReceivedAxialFiling.opening R simple D φ stripGrant order shelf (Fintype.card (Fin 3)) ep) ≤ i)
    (priced : max (WilsonReceivedAxialFinite.opening R simple q ep)
      (WilsonReceivedAxialFinite.massOpening R D ages order shelf seats (k:=k) simple stripGrant) ≤ i)
    (gate : WilsonReportingForestAngularReflection.posted R) (accuracy : ε*((3:ℝ)^q+2)≤1)
    (clockLate : (eventually_atTop.mp (WilsonJointAxialClock.original R simple)).choose ≤ i)
    (rareLate : WilsonJointAxialScalar.opening (V:=Fin 3) R simple gate q width₀
      (p+(3+(l+2))+1+2*width₀*(Fintype.card (Fin 3))) ≤ i)
    (winding : (eventually_atTop.mp (WilsonCoveredOrdinaryWeightedPost.original R simple D φ ages stripGrant
      order shelf k seats 0 (Fintype.card (Fin 3)) (3+(l+2)) (p+1) 1 1 (fee (J₃)) zero_le_one ep)).choose ≤ i) :
    let live:i<N:=by omega
    let y₀:=g (i+1)
    ∃L:post i mi (faces live), Reached R simple A top o hk D tab π Γ Ψ books ahead order shelf
      seats W mt inlet counted (q+2) 1 mi (show i ≤ t by omega) L ∧
    (∀v,(homes i L) v=(R.family.S.toDepth live.le per).parent (o.origin v)) ∧
    (∀(a:Stationary.Link G (R.family.side i per)) (z:ℝ),
      |z| ≤ |H| * (Real.log (R.family.path.levels.clock.hatBeta i))^depth*
        (((budget₀ i).B:ℝ)^2*(budget₀ i).threshold)/y₀ →
      (∀e,‖Exterior.collect G ((base i) a) e‖ ≤ cap₀*|z|) →
    let Q:=Order.value (y₀:ℂ) (Order.ratio (PhysicalWilsonPeriodizedMaterial.reference R N i per live ((base i) a) (roster i L) order))
    (∀(f:Forest (sheet i).ratio) (v:(sheet i).Choices),
      Order.value (y₀:ℂ) (Order.ratio (Bulk.Fk (topPost i live) f v (roster i L) ((base i) a) order))=Q) ∧

    Poly.price (w₀ i L) (inverseMass Q)≤fee (J₃)) ∧
    ∀ (caps:Fin 3→ℕ) (admit:∀v,WilsonOriginalThermometerPalette.levels v<caps v)
      (phase:Fin 3→ℂ→ₗ[ℝ] ℝ) (older:ℕ) (_dated:older≤N) (volume:Side) (lift:Site (R.family.side N per) → Cover)
      (given:Fin 3→Site (R.family.side N per)) (test:Case caps)
      (sense:∀s:(J₃).Mode,(s.val→Site (R.family.side N per))→ PChart G volume→ₗ[ℝ] ℂ),
    let Q:=Poly.pass (WilsonThermometerNominatedDeletion.filed R A caps admit phase older volume lift test sense given)
    let obs:=WilsonThermometerFiniteConnectedCells.measured R A (N,per) given
    let restoration:=restore₀ i L obs Q
    let debt := |fee (J₃)*stage₀ 100| *(4^q+2)
    let cash := |fee (J₃)*cost₀ p l+ε|+unit₀+debt
    restoration = 2*(1+∑s:(J₃).Mode with s≠WilsonThermometerCenteredAlgebra.full ∧ s≠(J₃).quiet,
      Poly.toll (w₀ i L) s*‖(WilsonThermometerRegisteredSingletonCenter.invoice obs Q).part s‖) ∧
    WilsonThermometerRegisteredCenteredStore.Charged R A simple live o hk D tab π Γ Ψ books mi ahead order shelf seats L q (p+1) 0 100 obs Q ∧
    ∃b h:Coefficient field₀ (R.family.side i per),
      (model₀ mi live L q (p+1) 1 b) ∧ (model₀ mi live L q (p+1) (paper₀ i L obs Q) h) ∧
      let error := error₀ mi live L J axes q obs Q b h
      RG.Envelope error ∧ ∀ (report:ℕ) (_hr:report ≤ i) (j:ℕ) (age:j ≤ i),
        (∫U,‖actualTransport R.family (N:=N) error age U‖ ∂scene R.family.path N per j)≤
          (restoration*(2:ℝ)^(p+2)*cash)*(g report)^(p+1) :=by
  intro live y₀
  have small:∀j,i ≤ j → j ≤ N → 0<g j ∧ g j ≤ 1:=
    (eventually_atTop.mp (WilsonThermometerAncestralCalendar.weak R simple)).choose_spec i weak N per
  have it:i ≤ t:=by omega
  have close:=WilsonThermometerAncestralCalendar.counted R simple slow degree cap it days
  obtain ⟨L,trace,paid,wallet⟩:=WilsonThermometerAncestralWallet.original R simple A top o hk D tab π Γ Ψ books
    ahead order shelf seats W mt inlet counted refs path pass month fits packed q l (degree+1) cap deep aged late
    small mi both close booked oldRent start
  have homesAt:=WilsonThermometerAncestralHomes.placed R simple A top o hk D tab π Γ Ψ books ahead
    order shelf seats W mt inlet counted q refs born mi it L trace
  have point:=(W.course.1.walk i mi live.le).truep.point
  have shape:=(eventually_atTop.mp (WilsonThermometerRegisteredAbsoluteRoom.spatial R simple profile)).choose_spec i room N per
    live.le r space relative massAt
  have distance(v:Fin 3):separation ((homes i L) v) 0 ≤ (Ψ i).p.B:=by
    rw [homesAt v,placed,point];exact shape v
  let Z:=halo (Ψ i).p.B {(0:Site (R.family.side i per))}
  have center:(0:Site (R.family.side i per))∈Z:=halo_spec.mpr ⟨0,Finset.mem_singleton_self _,by simp⟩
  have sites(v): (homes i L) v∈Z:=halo_spec.mpr ⟨0,Finset.mem_singleton_self _,by simpa only [separation_comm] using distance v⟩
  have strength:(Ψ i).p.supportExponent ≤ 100:=by rw [point];exact (funded.2.1.paid.fixed i).le
  have gp:=small (i+1) (by omega) (by omega)
  have budget:(8*(headroom mi L)^L.op.count)*L.rent+(1/4)*y₀^q ≤ y₀^q:=by
    change (8*(headroom mi L)^L.op.count)*L.rent ≤ (1/4)*y₀^q at paid
    linarith only [paid,pow_nonneg gp.1.le q]
  have low:=budget.trans (pow_le_one₀ gp.1.le gp.2)
  refine ⟨L,trace,homesAt,?_,?_⟩
  · intro a z allowed inside Q
    obtain ⟨datum,inverse,_all⟩:=WilsonThermometerRegisteredAncestralProperStore.original R A simple live o
      hk D tab π Γ Ψ W.course books mi ahead order shelf seats L way station sec slow ready early activated pass W.hospital
      (W.narrow.trans (R.alloy.B.a.fits.mono mi)) (L.capacity.le.trans W.load) q q force (by omega) (by omega)
      (by norm_num:(0:ℝ)<1/4) (opening L.op.count L.capacity.le) low 0 Z center sites (Ψ i).p.B distance le_rfl
      (by rfl) 100 strength (l+2) wallet (p+1) surplus budget saved stripGrant depth H cap₀ hc heard W.scroll W.chamber fund fit a z allowed inside
    exact ⟨datum,inverse⟩
  intro caps admit phase older dated volume lift given test sense Q obs restoration debt cash
  have issued:=WilsonThermometerRegisteredCenteredStore.original R A simple live o
    hk D tab π Γ Ψ W.course books mi ahead order shelf seats L way station sec slow ready early activated pass W.hospital
    (W.narrow.trans (R.alloy.B.a.fits.mono mi)) (L.capacity.le.trans W.load) q q force (by omega) (by omega)
    (by norm_num:(0:ℝ)<1/4) (opening L.op.count L.capacity.le) low 0 Z center sites (Ψ i).p.B distance le_rfl
    (by rfl) 100 strength (l+2) wallet (p+1) surplus budget saved caps admit phase older dated volume lift given test sense
  obtain ⟨charged,withdrawn⟩:=issued
  have qu:Q.part (J₃).quiet=1:=Poly.pass_part _ ((WilsonThermometerNominatedDeletion.nominated R A simple dated caps admit phase volume lift test sense).2.1 given)
  have prereq:p+(3+(l+2))+1+Fintype.card (Fin 3)≤q:=by simpa using (show p+(3+(l+2))+1+3≤q by omega)
  obtain ⟨b,h,left,right,env,quoted⟩:=WilsonThermometerRegisteredCenteredPrior.original R A simple live o hk
    D tab π Γ Ψ W.course books mi ahead order shelf seats L funded slow J clear axes q ep stripGrant W.scroll W.chamber
    fund active priced pass W.hospital (W.narrow.trans (R.alloy.B.a.fits.mono mi)) (L.capacity.le.trans W.load) fit gate p
    (l+2) prereq (by omega) accuracy clockLate rareLate winding wallet Q 0 100 obs qu withdrawn
  have localPrices(v:Fin 3):0<(w₀ i L) v:=mul_pos gp.1 (L.salary.positive v)
  have widthgood:2 ≤ restoration:=by
    have nn:=Poly.nonnegative (R:=J₃) localPrices (WilsonThermometerRegisteredCenteredInvoice.properInvoice obs Q-1)
    change 2≤2*(1+Poly.price (w₀ i L) (WilsonThermometerRegisteredCenteredInvoice.properInvoice obs Q-1))
    linarith
  have good:0 ≤ restoration:=(WilsonThermometerRegisteredCenteredInvoice.positive (w₀ i L) obs Q localPrices).le
  have cashpos:0≤cash:=by dsimp only [cash,debt];positivity
  have price : (fee (J₃)*cost₀ p l+ε)*y₀^(p+1)+(unit₀*y₀^(p+1)+debt*y₀^(p+1)) ≤ cash * y₀^(p+1) := by
    calc
      _ ≤ |fee (J₃)*cost₀ p l+ε| * y₀^(p+1)+(unit₀*y₀^(p+1)+debt*y₀^(p+1)) :=
        add_le_add (mul_le_mul_of_nonneg_right (le_abs_self _) (pow_nonneg gp.1.le _)) le_rfl
      _ = _ :=by dsimp only [cash];ring
  refine ⟨charged,withdrawn,b,h,left,right,env,?_⟩
  intro report hr j age
  have ratio:=WilsonLocalCompactRichPortUnits.compared R simple (hr.trans (Nat.le_succ i)) live per
  calc
    _ ≤ restoration*(2*((fee (J₃)*cost₀ p l+ε)*y₀^(p+1)+(unit₀*y₀^(p+1)+debt*y₀^(p+1)))) :=by
      have priorCost:=quoted j age
      have farepos:0≤(fee (J₃)*cost₀ p l+ε)*y₀^(p+1)+(unit₀*y₀^(p+1)+debt*y₀^(p+1)):=by
        by_contra! bad
        have neg: (2*restoration-1)*((fee (J₃)*cost₀ p l+ε)*y₀^(p+1)+(unit₀*y₀^(p+1)+debt*y₀^(p+1)))<0:=
          mul_neg_of_pos_of_neg (by linarith only [widthgood]) bad
        exact (not_lt_of_ge ((integral_nonneg (fun U=>norm_nonneg _)).trans priorCost)) neg
      refine priorCost.trans ?_
      calc
        _ ≤ (2*restoration)*((fee (J₃)*cost₀ p l+ε)*y₀^(p+1)+(unit₀*y₀^(p+1)+debt*y₀^(p+1))):=
          mul_le_mul_of_nonneg_right (show 2*restoration-1≤2*restoration from sub_le_self _ zero_le_one) farepos
        _ = _ :=by ring
    _ ≤ restoration*(2*(cash*y₀^(p+1))):=mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left price (by norm_num)) good
    _ = (restoration*2*cash)*y₀^(p+1):=by ring
    _ ≤ (restoration*2*cash)*(2*g report)^(p+1):=mul_le_mul_of_nonneg_left (pow_le_pow_left₀ gp.1.le ratio _) (by positivity)
    _ = _:=by rw [mul_pow];simp only [pow_succ, mul_assoc];ring

end YM.Integration.WilsonThermometerRegisteredCenteredProgramme
