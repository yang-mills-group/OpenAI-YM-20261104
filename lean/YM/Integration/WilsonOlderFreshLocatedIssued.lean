theorem fromDate (q:ℕ){ε:ℝ}(ep:0<ε)(deep:2*((q+4)+4+1)+8  ≤  school.order)(aged:(q+4)+4+4  ≤  3*k+2)
    (M₀:WilsonMeasuredRankedMenu.Menu R query.letter.toll)(tube:LinkTube G)(programPaid:Covered (program tube) R)
    (strength:∀i,(R.family.path.levels.budget i).supportExponent ≤ 100)(prepared:WilsonReportLampForecast.Ready R.family.path.levels)
    (protection:WilsonPhysicalHistoryPriorAperture.Paid R.rolls D φ R.alloy.delay)(enough:3*(wanted q)  ≤  query.order)
    (enrolled:query.order  ≤  school.order)(within:query.letter.toll  ≤  school.horizon)(load:school.pieces  ≤  Burn.horizon k+2)(fits:school.order  ≤  Burn.horizon k+1)
    {U:ℕ  →  ℕ}(grant:WilsonWindowFormalPurchase.Canonical U R.kit)
    (v:ℕ  →  WilsonCoeffUV.Bank.Gear G  →  ℝ)(funded:FundedMarkedCoverRows.prices v R.kit)(paths:FundedOriginalVacuumPaths.prices R.kit):
    ∀ᶠ m:ℕ in atTop,∀(N:ℕ)(digit:∀i,Site (R.family.S.block i)),
      k  ≤  R.alloy.B.a.clock.J m  →  1  ≤  Burn.horizon k  → 
      ∀T:∀i,m  ≤  i  →  i  ≤  N  →  axes  →  Studio dmax  →  WilsonOlderFreshGraphSlate.Copy G query.letter.toll query.order (σ i),
       WilsonOlderFreshLocatedRoster.Booked R families a depth query.order (fun i=>σ i) m N digit T →
    ∀(per:ℕ)(hk:Burn.horizon k+2  ≤  R.alloy.B.a.clock.J m)(π:ℕ  →  Layout G)(Γ:ℕ  →  Pace.Coin)
       (Ψ:(i:ℕ)  →  Rep G (R.family.side i per))(_history:Concourse R.alloy R.kit R.T π Γ m N per k Ψ)
       (_top:Topline (Ψ N) (R.family.path.levels.clock.forcedAllowance N))
       (_host:∀i (lo:m ≤ i),i<N  →  Seat (N:=N) R D Q₀ school hk π Γ Ψ lo)
       (_path:PlanV.Path D R.alloy Q₀ (Burn.horizon k) N m π Γ)(A:Unit  →  Set ℂ)(_cap:∀t,‖value A t‖ ≤ 1)
       (sites:∀i,Site (R.family.side i per))
       (_centers:∀i,m+1 ≤ i  →  i<N  →  sites (i+1)=(R.family.path.levels.clock.op i per).ratio.assemble (sites i,digit i))
       (profile:Studio dmax)(_loc:Loc G 1)(x:Wallet A),m+1<N  → 
       let field:=fixed R (fun i=>σ i) T sites (orbit R digit (m+1) profile) A x (fun i=>Coat.gStep (Ψ i).beta)
       Full R query.letter.toll families a depth digit N per (m+1) query.order q Ψ sites field
         (fare ε q ‖profile‖):=by
  have activation:=WilsonMeasuredPointQueryCalendar.funded R simple slow school q query high ep deep aged
    tube programPaid strength enough prepared M₀
  obtain ⟨start,bought⟩:=eventually_atTop.mp activation
  filter_upwards [eventually_ge_atTop (WilsonOriginalPrimerPostCover.opening R simple v funded paths k),
    eventually_ge_atTop (start+1),
    eventually_ge_atTop (WilsonMeasuredSemesterSubpower.onset R 1 (half_pos (show (0:ℝ)<1 by norm_num)))] with m opening first active
  intro N digit _stage _awake T registered per hk π Γ Ψ history top host path A cap sites centers profile loc x exposed
  have filed:=WilsonOlderFreshLocatedRoster.original R families a depth query.order (fun i=>σ i) m N digit T registered
  let f:=orbit R digit (m+1) profile
  let heat(i:ℕ):=Coat.gStep (Ψ i).beta
  let book:=fixed R (fun i=>σ i) T sites f A x heat
  let g(i:ℕ):=Coat.gStep (R.family.path.rep N per i).beta
  let total:=fare ε q ‖profile‖
  change Full R query.letter.toll families a depth digit N per (m+1) query.order q Ψ sites book total
  have edge (j:ℕ)(lo:m ≤ j)(cut:j+1<N)(t:Fin (query.order+1))(w:axes):
      WilsonOlderFreshLocatedFields.Event (N:=N) R families a depth digit query.order t w (Ψ ((j+1)+1)).eval
        (Ψ (j+1)) (sites (j+1)) (book ((j+1)+1) w) (book (j+1)) (total*(g (j+1))^q):=by
    let here:=j+1
    have hi:m ≤ here:=lo.trans (Nat.le_succ j)
    have after:m+1 ≤ here:=by omega
    have dates:=bought j (by omega)
    obtain ⟨source,wage,priors,budget,forward,_⟩:=filed (j+1) hi cut w (f here)
    let seat:=host here hi cut
    let upper:=T (here+1) (hi.trans (Nat.le_succ _)) cut w (Dawn.throughW (digit here) dmax (Elm.growL R.family.path.levels here) (f here))
    let lower:=fun v:axes=>T here hi cut.le v (f here)
    have paid:=WilsonOlderFreshLocatedSource.original (N:=N) (R:=R) (query:=query) (hk:=hk) (D:=D) (Q₀:=Q₀)
      (π:=π) (Γ:=Γ) (Ψ:=Ψ) (history:=history) (scroll:=scroll) (books:=books) (chamber:=chamber) (floor:=lo)
      (warm:=warm) (top:=top) (school:=school) (op:=seat.op) (lesson:=seat.lesson) (cal:=seat.cal) (ahead:=ahead)
      (A:=A) (a:=a) (depth:=depth) (w:=w) (f:=f here) (base:=sites here) (ep:=ep) (digit:=digit) (simple:=simple) (slow:=slow)
      q hospital cut cap pass seat.seats seat.shape seat.phase enrolled within high path month M₀ way prepared deep aged tube programPaid
      strength protection enough load t loc fits (Poetry.Agenda.stem D φ _ _) dates upper lower source wage priors budget forward
      grant v funded paths opening x
    have topAt:book (here+1) w=word upper ((R.family.path.levels.clock.op here per).ratio.assemble (sites here,digit here)) A x (heat (here+1)):=by
      apply (at_date R _ T sites f A x heat (hi.trans (Nat.le_succ here)) cut w).trans
      have nextTest:f (here+1)=Dawn.throughW (digit here) dmax (Elm.growL R.family.path.levels here) (f here):=
        next R digit after profile
      rw [nextTest,centers here after cut]
    have bottom:book here=fun v:axes=>word (lower v) (sites here) A x (heat here):=by
      funext v
      exact at_date R _ T sites f A x heat hi cut.le v
    have enrolledNow:=bought j (by omega)
    obtain ⟨_,currency,_⟩:=enrolledNow
    obtain ⟨_,gp,_,ratio⟩:=WilsonMeasuredLandedCurrency.native R simple per cut.le currency
    have gn:0 ≤ g here:=(inv_pos.mpr (Real.sqrt_pos.mpr (Overlay.beta_positive R.makes.wilson cut.le))).le
    exact WilsonOlderFreshLocatedFields.reprice (N:=N) R families a depth digit query.order t w _
      (Ψ here) (sites here) (book (here+1) w) (book here) topAt bottom
      (reserve gp.le gn ep (norm_nonneg _) ratio (mass R digit (m+1) profile here) q) paid
  constructor
  · intro i lo cut w
    by_cases initial:i=m+1
    · subst i
      have canon:Filed R families a depth (1/4) digit exposed.le w profile
        (T (m+1) (Nat.le_succ _) exposed.le w profile):=registered.1 (m+1) (Nat.le_succ m) exposed.le w profile
      let seat:=host m le_rfl (by omega)
      have priorDate:=bought (m-1) (by omega)
      obtain ⟨_,_,_,_,_,_,_,_,_,_,_,_,_,_,_,_,_,_,_,_,_,_,_,_,space,_⟩:=priorDate
      have boot:Sycamore.Boot.need high school ≤ R.alloy.B.a.clock.J (m+1):=by
        have eq:((m-1)+1)+1=m+1:=by omega
        rwa [eq] at space
      have based:book (m+1) w=word (T (m+1) (Nat.le_succ m) cut w profile) (sites (m+1)) A x (heat (m+1)):=by
        apply (at_date R _ T sites f A x heat (Nat.le_succ m) cut w).trans
        rw [show f (m+1)=profile from head R digit (m+1) profile]
      rw [based]
      exact WilsonOlderFreshLocatedIntake.original (N:=N) R hk D Q₀ π Γ Ψ history scroll books chamber le_rfl warm top
        school seat.op seat.lesson seat.cal ahead hospital (sites (m+1)) A families a depth w profile digit simple
        (show m<N by omega) cap pass active _ canon.2.1 seat.seats seat.shape seat.phase enrolled within high boot x
    · obtain ⟨j,hj⟩:∃j,i=(j+1)+1:=⟨i-2,by omega⟩
      subst i
      exact (edge j (by omega) (by omega) 0 w).1
  · intro i lo cut t w
    cases i with
    | zero=>omega
    | succ j=>exact (edge j (by omega) cut t w).2

end YM.Integration.WilsonOlderFreshLocatedIssued
