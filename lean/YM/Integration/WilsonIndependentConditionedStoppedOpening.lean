theorem original [Nonempty I](simple:G.Simple)(bliss:Bliss F l Z H)(slow:WilsonWindowReportingPace.Slow R.kit)
    {D T:ℕ}(d:I→Fin (D+1))(h:ℕ){limit:ℝ}
    (books:(s:{s:ℝ // 0<s ∧ s<limit})→Book F (l:=l) H Z D T s.val)
    (cap:J→ℝ)(pc:∀s,0≤cap s)(Q:J→SealR G)(C₁ C₂:J→Credit)(rate L M:Credit)(coins:Prices)
    (old u b A q spatial width:ℕ)(ζ constant:ℝ){ε:ℝ}(ep:0<ε):
    ∀ᶠr in trail,∀ρ:I→{s:ℝ // 0<s ∧ s<limit},(∀i,r≤(ρ i).val ∧ (ρ i).val≤outer Z h r) →
      (∃i,(ρ i).val=r) →
      let m:=date R simple r
      let f:=reporter F books ρ
      let K:=berth R A f
      ∀{first v},first ≤ v → v ≤ m →
      R.family.S.scale K-R.family.S.scale first ≤ (old:ℝ)*(1+WilsonIndependentConditionedActualCredit.badge R v) →
      ∀j:ℕ,j≤f → ∀(t z:ℝ)(B:J→ℝ),
        let bound:=constant*(1+r/R.family.S.a m)^spatial*(R.family.path.levels.clock.monitor j)^width
        |t⁻¹|≤bound → |z|≤bound → (∀s,|B s|≤bound) →
        Heard (k:=k) (e:=e) R Q C₁ C₂ rate L M coins u b q v m K ζ cap B t z ((thermal R f)^(-ε)):=by
  obtain ⟨P,pay⟩:=WilsonIndependentConditionedStoppedSplit.original (k:=k) (e:=e) R simple slow cap pc
    Q C₁ C₂ rate L M coins u b A old q ζ
  obtain ⟨η,eta,grant⟩:=WilsonIndependentConditionedEarlierThermal.original R simple P ep
  have prices:=WilsonIndependentConditionedEarlierReflection.four R simple spatial width constant eta
  have pick (proposition:ℕ→Prop)(opened:∀ᶠ f in atTop,proposition f):=
    WilsonIndependentConditionedActualOpening.before F simple bliss slow d h books opened
  have program:=pick _ pay
  have cash:=pick _ grant
  have rent:=pick _ prices
  have station:=WilsonIndependentConditionedGramSpatialCourse.original F simple bliss slow
    D T h A spatial d (ε:=η/8) (by positivity) books
  filter_upwards [program,cash,rent,station] with r able thermalBill coord housed
  intro ρ positions near m f K first v fv vm span j before t z B bound ti size amplitudes
  let page:=((housed ρ positions near).1)
  have lev:bound≤(thermal R f)^(-η):=(coord ρ positions near) j before
    (1+r/R.family.S.a m) (by linarith only [page.root_one]) (page.root_power.trans page.block_power)
  have move:=(thermalBill ρ positions near) t z B (ti.trans lev) (size.trans lev)
    (fun s=>(amplitudes s).trans lev)
  have fees:=(able ρ positions near) fv vm page.before span t z B
  exact ⟨fees.1.trans move,fun φ y room=>(fees.2 φ y room).trans move⟩

end YM.Integration.WilsonIndependentConditionedStoppedOpening
