  (D:Roots (G:=G) R.metals.p.profile R.metals.K R.metals.p.kernel) (Q:D.Tab R.rolls)
  {φ:ℕ→ℕ} (scroll:VowsR.LawScroll G φ) (books:Mentor.Offices.Books D R.rolls Q φ)
  (ahead:Mentor.Forecast D R.rolls Q φ books) {ZΘ:ℝ} {profile:PhysicalNext.ThroughLaunch.Orders}
  (house:Treehouse.VariableHouse R D Q scroll books ZΘ ahead profile)
  (income:WilsonMovingMentorRootRadius.Income (M:=R.metals) D φ R.alloy.delay)
  (hire:∀d,MintClock.Employment D φ d (R.rolls.L d))

def Folded : Prop :=
  ∀ {B:MS.Local.Physical.Deck G} {V:Type} [DecidableEq V] [Fintype V] [Nonempty V]
    (request upperJ:Request V) (freshQ upperQ:MS.Land.Prescription B)
    (u upperLabels:V→MS.Rake.Label B) (μ upperClock:ℝ) (extra upperExtra:V→ℕ)
    (K upperOrder:ℕ) (old fresh:Finset V) (_sep:Disjoint old fresh)
    (comparison span shape:ℕ) (height angleCap cap ε:ℝ),
    0≤angleCap → 0≤cap → 0<ε →
    old∪fresh=univ →
    gradeTotal old (fun _:V=>WilsonOriginalProjectedCurvatureLoan.toll (R:=R) upperLabels)
      (fun _:V=>WilsonOriginalProjectedCurvatureLoan.toll (R:=R) u) ≤
      Fintype.card V*WilsonOriginalProjectedCurvatureLoan.toll (R:=R) upperLabels →
    WilsonReceivedCloseQFoldedProgram.Heard R simple D Q scroll books ahead house income hire request upperJ
      freshQ upperQ u upperLabels μ upperClock extra upperExtra K upperOrder old fresh comparison span
      shape height angleCap cap ε

theorem folded (program:WilsonReceivedCloseNamedSourceElection.Named R simple D Q scroll books ahead house income hire) :
    Folded R simple D Q scroll books ahead house income hire := by
  intro B V ed ec ne request upperJ freshQ upperQ u upperLabels μ upperClock extra upperExtra K upperOrder old fresh sep
    comparison span shape height angleCap cap ε hp cp ep allFaces load
  exact WilsonReceivedCloseQFoldedProgram.on_course R simple D Q scroll books ahead house income hire
    request upperJ freshQ upperQ u upperLabels μ upperClock extra upperExtra K upperOrder old fresh comparison span
    shape height angleCap cap ε hp ep (program request upperJ freshQ upperQ u upperLabels μ upperClock extra upperExtra
      K upperOrder old fresh sep comparison span shape height angleCap cap (ε/2) hp cp (half_pos ep) allFaces load)

end YM.Integration.WilsonReceivedCloseFundedOrdinary
