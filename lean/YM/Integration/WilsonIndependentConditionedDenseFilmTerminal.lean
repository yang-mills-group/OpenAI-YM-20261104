include affordable early in
theorem original {c:ℕ}(before:first+1≤c)(ck:c≤K₀)(cold:gv≤1)
    {C:ℝ}{E:ℕ}(cp:1≤C)(allow:allowance≤1)(rent₀:0≤rate)(rent:rate≤C*(3*(gv)⁻¹)^E)
    (inputs:∀a,‖present lens a‖≤C*(3*(gv)⁻¹)^E)(qh goal:ℕ)
    (kept:goal+debt n E (ic)≤qh+1)(order:qh≤q₀):
    ‖WilsonOriginalTwoFlatIRSocketBoundary.held R (N:=N) (b:=first+1) (amount) (rows_) mask-
      output (R:=R) (d:=d) (P:=P) (N:=N) (j:=j) (per:=per) (first:=first) (V:=V) (draw:=draw)
        (lens:=lens) (pt:=pt) (fine:=fine) (site:=site) (votes:=votes) (mask:=mask) c qh‖≤
      (due)*(ceiling n (q₀) (∑a,d a) E (ic) C*(gv)^goal):=by
  let E₀:=ceiling n (q₀) (∑a,d a) E (ic) C
  let val (q:Selection R d mask.val):ℂ:=(gs)*(((row₀ q) (first+1)) 1).part mask
  let scalar (q:Selection R d mask.val):ℂ:=Complex.ofReal (flat (stopped R d N K₀ c (first+1) (path₀) (pins₀ c)
    mask.val (touch (present lens) mask.val) (start R d (fun a=>contact (lens a)) pt (WilsonOlderFreshSoftSocketFaces.fill R d mask.val q))) qh (gv))
  have same (q:Selection R d mask.val):‖val q-scalar q‖≤E₀*(gv)^goal:=by
    have Hq:=WilsonOriginalTwoFlatIRSocketPower.original (G:=G) (n:=n) (N:=N) (R:=R) (per:=per) (V:=V) (draw:=draw)
      (rate:=rate) (allowance:=allowance) (power:=zeroFee) (P:=P) (house:=school) (day:=day) (κ:=fun a=>contact (lens a)) (pt:=pt)
      (j:=first) (top:=K₀) (first:=first) (valid:=live) (toll:=toll) (old:=old) (test:=present lens) (classroom:=classroom)
      (fine:=fine) (z:=site) (s:=mask) (q:=q) (paid:=paid) (hd:=adult) (background:=prior q) (σ:=scale)
      le_rfl (by omega) before ck cold cp allow rent₀ rent inputs qh goal kept order
    rw [WilsonOriginalTwoFlatRoseMerRestored.normalized (draw:=draw)] at Hq
    have oneMark:WilsonOriginalTwoFlatRoseMerRestored.marked
        (fun a=>((WilsonReceivedChronologicalSocket.lit (V:=Fin n)) a).val) mask.val=1:=by
      change ∏_a∈mask.val,(1:ℂ)=1
      simp
    rw [oneMark,one_mul] at Hq
    exact Hq

  have nonneg:0≤E₀*(gv)^goal:=(norm_nonneg _).trans (same (fun _=>Sum.inl ()))
  have purse:=WilsonReceivedCanonicalVersePortfolio.priced R d N per K₀ live votes mask.val doseCap (fun i _=>affordable i)
  change ‖(∑q:Selection R d mask.val,(wt q)*val q)-∑q:Selection R d mask.val,(wt q)*scalar q‖≤_
  rw [←Finset.sum_sub_distrib]
  calc
    _≤∑q:Selection R d mask.val,‖wt q‖*(E₀*(gv)^goal):=(norm_sum_le _ _).trans (Finset.sum_le_sum fun q _=>by
      rw [←mul_sub,norm_mul];exact mul_le_mul_of_nonneg_left (same q) (norm_nonneg _))
    _≤_:=by rw [←Finset.sum_mul];exact mul_le_mul_of_nonneg_right purse nonneg

