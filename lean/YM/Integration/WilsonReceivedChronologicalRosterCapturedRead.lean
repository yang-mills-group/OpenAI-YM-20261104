variable {G : Gauge} {n m first j f : ℕ} {R : Run G} {simple : G.Simple}
  {schedule : WilsonOriginalAllOrderCourse.Schedule G} {grades : Fin n → ℕ}
  (power : Fin n → ℕ) (P : ℕ) (house : Room (prepared schedule) R simple)
  (resident : (N : ℕ) → m ≤ N → Day (prepared schedule) R simple (programme grades power P).school m N)
  {V : Realm G ((terms grades power P).order+1) Credit.leanC} {draw : V.draws = R.family.path.levels}
  (rate : ℕ → ℕ → ℝ) (allowance : ℝ) {dims : Fin n → ℕ} (test : Case dims)
  (κ : (v : Fin n) → Knob (dims v)) (pt : Fin n → Chamber)
  (toll : ℕ → Fin n → ℝ) (old : m ≤ first) (early : first+1 ≤ j)
  (φ : Test n) (caps : Fin n → ℝ) (A target : ℕ) (η : ℝ)
  (paid : ∀v, ‖test v‖ ≤ caps v) (fine : f ≤ j+1+1)

private theorem residentAt {m first j N : ℕ} (old : m ≤ first) (early : first+1 ≤ j)
    (valid : j+1+1 ≤ N) : m ≤ N := by omega

local notation "K" => j+1+1
local notation "issuedDay" N:max valid:max => resident N (residentAt old early valid)
private theorem birthAt {first j:ℕ} (early:first+1 ≤ j) : first+1 ≤ j+1+1 :=
  early.trans ((Nat.le_succ j).trans (Nat.le_succ (j+1)))
local notation "supports" => WilsonReceivedChronologicalRosterCapturedArchive.Occupied (n:=n) R fine (birthAt early)
local notation "active" => (show first+1 ≤ K by omega)
local notation "camp" N:max per:max valid:max => Purchased (per:=per) (V:=V) (draw:=draw)
  (rate:=rate N per) (allowance:=allowance) power P house (issuedDay N valid) κ pt K first valid toll old φ caps A target η
local notation "admission" => fun N per (valid : K ≤ N) => camp N per valid

local notation "liveRow" enrolledArg:max nodeArg:max faceArg:max choiceArg:max legalArg:max historyArg:max heatArg:max =>
  WilsonReceivedChronologicalFixedSocketLife.line (R:=R) (V:=V) (draw:=draw) (power:=power) (P:=P)
    (house:=house) (κ:=κ) (pt:=pt) (top:=K) (first:=first) (toll:=toll) (old:=old) (test:=test)
    (classroom:=enrolledArg) (fine:=fine) (z:=(nodeArg).val) (s:=faceArg) (q:=choiceArg) (paid:=paid) (hd:=legalArg) (prior:=historyArg) (σ:=heatArg)


open WilsonThermometerUnitFilingCoarse (reading)
open WilsonReceivedCanonicalVersePortfolio (weight)

private theorem approved {first top : ℕ} (a : Ages first top) : a.val+1 < top := by
  have ha := (mem_Ico.mp a.property).2
  omega

variable {N per : ℕ} (valid : K ≤ N) (pupil : camp N per valid)

local notation "priorAt" periodArg:max s:max => Selection R grades (s).val →
  (i : ℕ) → Config G (R.family.side i periodArg) → Marker.Poly (Stock.census (Fin n))

theorem original :
    ∃ book : Catalogue R grades K, ∀ (N per : ℕ) (valid : K ≤ N) (pupil : camp N per valid)
      (y : supports per) (s : (Stock.census (Fin n)).Mode) (votes : ∀i, R.family.label (grades i))
      (hd : ∀v, 0 < grades v) (prior : priorAt per s) (σ : ℝ),
      let ξ := placed R fine y.val
      let rows := fun q : Selection R grades s.val => liveRow pupil y s q hd (prior q) σ
      (∀ q U, (rows q K U).part s = ((R.family.path.rep N per K).eval U : ℂ) *
        WilsonReceivedCanonicalVersePosterior.word R grades κ pt (regulatorRun R.family N per K) ξ s.val q U) ∧
      ∀ a : Ages first K, WilsonReceivedChronologicalRosterMoment.Heard R grades (N:=N)
        book votes ξ (approved a) s (fun q => rows q (a.val+1)) := by
  obtain ⟨book, filings⟩ := WilsonReceivedChronologicalRosterCapturedFields.original (R:=R) (V:=V) (draw:=draw)
    power P house resident rate allowance test κ pt toll old early φ caps A target η paid fine
  refine ⟨book, ?_⟩
  intro N per valid pupil y s votes hd prior σ ξ rows
  refine ⟨?_, ?_⟩
  · intro q U
    exact WilsonReceivedChronologicalFixedSocketLife.atCut (R:=R) (per:=per) (V:=V) (draw:=draw)
      (power:=power) (P:=P) (house:=house) (day:=issuedDay N valid) (κ:=κ) (pt:=pt)
      (top:=K) (first:=first) (valid:=valid) (toll:=toll) (old:=old) (test:=test)
      (classroom:=pupil) (fine:=fine) (z:=y.val) (s:=s) (q:=q) (paid:=paid) (hd:=hd)
      (prior:=prior q) (σ:=σ) U
  · intro a
    apply WilsonReceivedChronologicalRosterMoment.original
    intro q
    have item:=filings N per valid pupil y s q a
    exact ⟨_,item.1,item.2 hd (prior q) σ⟩

