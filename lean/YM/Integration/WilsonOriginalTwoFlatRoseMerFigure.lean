variable {G:Gauge}(R:Run G){e:ℕ}{axis grades:Fin 3→ℕ}{V:Realm G (e+1) Credit.leanC}
    {draw:V.draws=R.family.path.levels}{N per f n i cap:ℕ}
    (κ:(a:Fin 3)→Knob (axis a))(pt:Fin 3→Chamber)(o:Fin 3→Site (R.family.side f per))
    (upper:f+n≤N)(cut:i+1≤N)(t:Case axis)
    (x:(s:(Stock.census (Fin 3)).Mode)→Wallet (WilsonOriginalMixedBlockRows.room (Fin 3)))
    (v:∀a:Fin 3,R.family.label (grades a))(c:Fin 3→ℂ)
local notation "J" => Stock.census (Fin 3)
local notation "top" => f+n
local notation "day" => i+1
local notation "path" => cells R (draw:=draw) o upper
local notation "nativePath" => onLevels draw (path)
local notation "root" s:max => address R.family.path.levels (nativePath) (cap-(day)) (day) (site R o upper cut s)
local notation "affine" s:max => (touch t (Subtype.val s))
local notation "normalized₀" s:max p:max θ:max =>
  WilsonOlderFreshSoftSocketTotal.normalized R grades κ pt N per (top) cap (day) (nativePath) (Subtype.val s) v (root s) (affine s) p θ

def restoration (s:(J).Mode):ℂ:=
  WilsonOriginalMicroscopicEntranceDoseGrid.mass c s*units R grades (top) s*
    marked (fun a=>(x s a).val) s.val

def figure (s:(J).Mode)(p:ℕ)(θ:ℝ):ℂ:=restoration R (f:=f) (n:=n) (grades:=grades) x c s*
  WilsonOlderFreshSoftSocketTotal.figure R grades κ pt N per (top) cap (day) (nativePath) s.val v (root s) (affine s) p θ

def expense (s:(J).Mode)(p:ℕ)(θ:ℝ):ℝ:=‖restoration R (f:=f) (n:=n) (grades:=grades) x c s‖*
  ∑y:Selection R grades s.val,‖weight R grades N per (top) v s.val y‖*
    WilsonOlderFreshSoftSocketTotal.cost R grades κ pt N per (top) cap (day) (nativePath) s.val
      (root s) (affine s) p θ y

local notation "sale" s:max p:max => retained (R:=R) (cap:=cap) (draw:=draw) cut grades axis κ pt o upper t
  (fun s _=>x s) v c p s
local notation "asFigure" s:max p:max θ:max => figure R (i:=i) (cap:=cap) (draw:=draw) κ pt o upper cut t x v c s p θ
local notation "cost₀" s:max p:max θ:max => expense R (i:=i) (cap:=cap) (draw:=draw) κ pt o upper cut t x v c s p θ
local notation "g₀" => Pert.Asymptotics.regulatorRun R.family N per (day)

theorem traced (s:(J).Mode)(p:ℕ):
    (sale s p)=restoration R (f:=f) (n:=n) (grades:=grades) x c s*(normalized₀ s p (g₀)):=by
  unfold retained WilsonOlderFreshSoftSocketTotal.normalized
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro y _
  rw [WilsonOriginalTwoFlatRoseMerRestored.normalized (draw:=draw)]
  change ((WilsonOriginalMicroscopicEntranceDoseGrid.mass c s*units R grades (top) s)*weight R grades N per (top) v s.val y)*
    (marked (fun a=>(x s a).val) s.val*_)=(WilsonOriginalMicroscopicEntranceDoseGrid.mass c s*units R grades (top) s*
      marked (fun a=>(x s a).val) s.val)*(weight R grades N per (top) v s.val y*_)
  rw [show full R grades y=WilsonOlderFreshSoftSocketFaces.fill R grades s.val y from rfl]
  ring

theorem original (simple:G.Simple)(ratio:LocalRatio R.metals.O)(vc:day≤cap)(ck:cap≤top)(p:ℕ)(s:(J).Mode)
    (kept:∀y:Selection R grades s.val,degree R grades s.val (full R grades y)≤p)(hg:0≤g₀)(small:g₀≤1):
    ‖(sale s p)-(asFigure s p (g₀))‖≤cost₀ s p (g₀):=by
  have bought:=WilsonOlderFreshSoftSocketTotal.original R grades κ pt N per (top) cap (day) (nativePath)
    s.val v (root s) (affine s) simple ratio vc ck upper p kept hg small
  rw [traced (draw:=draw),figure,←mul_sub,norm_mul]
  apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
  rwa [norm_sub_rev]

