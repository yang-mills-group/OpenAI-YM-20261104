theorem original (simple:G.Simple)(bliss:Bliss F l z H)(slow:WilsonWindowReportingPace.Slow R.kit)
    {T h t:ℕ}{δ:ℝ}(books:(s:{s:ℝ//0<s ∧ s<δ})→Book F (l:=l) H z 6 T s.val)
    (x:∀i:Fin 3,RG17.Free C (grade i).val)(extra:∀i:Fin 3,(Spin.comparator (C).book).Field (grade i).val)
    (lead:Leading F Jr)(admitted:∀d:ℕ,∀ᶠr in trail,Frame.obedient F H (Jr r) d)
    (window:∀s,WilsonMovingForkWindowBooks.Priced F (books s))
    (bank:WilsonThermometerClusterProjectionBudget.Ready (P))(lamp:WilsonReportLampForecast.Ready (P))
    (funded:WilsonOriginalAllOrderCourse.Paid.{u₀} axis simple ε σ R crop W)
    (registrar:WilsonMeasuredPublicEntrancePanelSchool.Registered F 6 T h t grade books (field F Jr Z 6 T grade extra x books)):
    ∃(M:Fin 3→ℝ)(E:Fin 3→ℕ),(∀i,1≤M i) ∧ ∀φ:Test 3,∃apron:ℕ,∀(aim physical:ℕ),let requested:=request aim physical E
    let pwr:=debit aim physical E
    let τ:=depth ((2*pwr+∑i,E i)+1) (width T h) 6
    let tuition:=max 1 (4*∑i,M i)
    let power:=(∑i,E i)+WilsonAddressedMixedRawTrial.power T h τ 6
    (∀s:Finset (Fin 3),entrance aim physical+∑i∈s,E i≤requested) ∧
    ∀(floor target:ℕ),∀ᶠ old:ℕ in atTop,∀u:ℕ,old≤u → ∀ᶠr in trail,∀ρ:Fin 3→{s:ℝ//0<s ∧ s<δ},(∀i,r≤(ρ i).val ∧ (ρ i).val≤outer z h r)→(∃i,(ρ i).val=r)→
    let f:=reporter F books ρ
    let K:=berth R τ f
    ∃j:ℕ,∃uf:u≤f,floor≤j ∧ u≤j ∧ j+2≤f ∧ ∀program:Program R ages K,
    ∃fk:f<K,∃file:Filed R ages K,
    (∀i,file.station i=(home F Jr Z (books (ρ i)) (grade i) (x i)).j) ∧ file.target=target ∧
    (∀N per w pins j,j<K → file.row N per w pins j=WilsonMovingForkPrintedFile.row program N per w pins j) ∧
    ∀N per (kn:K≤N),
    ∃panel:cells R φ r (f,per)→Panel R ages N per f K fk.le kn requested power t (capital R 6 tuition),
    ∀o,Reading R ages (panel o) uf ∧ Ground R N per j f apron o.val ∧ (panel o).slot=file.station ∧ (panel o).axis=file.A N per ∧ (panel o).M=M ∧
      (panel o).loc=o.val ∧ (panel o).turn=(fun _=>direct) ∧
      (∀i,(panel o).names i=(home F Jr Z (books (ρ i)) (grade i) (x i)).arm.source (N,per)) ∧
      (∀i,displayed R (ages i) ((panel o).names i) ((panel o).turn i)=
        (home F Jr Z (books (ρ i)) (grade i) (x i)).arm.source (N,per)) ∧
      (∀i k,k≤ages i → (C).ref k≤N) ∧
      (∀i,Next.Rank.Spindle.paid (C) (ages i) f N per ((panel o).names i)≤(panel o).M i*(β f)^(E i)) :=by
  classical
  have costs:=WilsonOriginalPhysicalFirstEntryOwnerFinance.attached funded
  obtain ⟨_,faculty⟩:=WilsonMeasuredPublicEntranceMasterUpper.original R simple costs.2.1 costs.2.2.2
    costs.2.2.1 bank lamp costs.1 funded
  obtain ⟨age,openEar⟩:=eventually_atTop.mp (open_late R.family simple 0)
  obtain ⟨M,E,one,chosen⟩:=WilsonReceivedChronologicalFixedRoseSourceRanks.original F Jr Z simple bliss slow books x extra registrar
  refine ⟨M,E,one,?_⟩
  intro φ
  obtain ⟨apron,source⟩:=chosen φ
  refine ⟨apron,?_⟩
  intro aim physical requested pwr τ tuition power
  obtain ⟨purse,matter⟩:=source aim physical
  refine ⟨purse,?_⟩
  intro floor target
  have size:Fintype.card (Fin 3)≤3:=by simp
  let edge:=threshold R simple costs.2.1 costs.2.2.2 costs.2.2.1 bank lamp costs.1 ages 3 apron requested t τ power
    (capital R 6 tuition) (by decide) size
  have positive:0≤capital R 6 tuition:=le_max_left .. 
  obtain ⟨_,_,_,roots⟩:=WilsonOriginalTwoFlatIRPoolOrigins.original F Jr Z simple bliss slow lead admitted 6 T h edge grade x books window
  filter_upwards [faculty 3 6 requested,eventually_ge_atTop age] with old day late
  intro u oldU
  let gate:=max edge (max floor u)
  filter_upwards [matter gate target,roots] with r placed ready
  intro ρ span near f K
  obtain ⟨j,good,young,registered⟩:=placed ρ span near
  have uj:u≤j:=(le_max_right floor u).trans ((le_max_right ..).trans good)
  have fj:floor≤j:=(le_max_left floor u).trans ((le_max_right ..).trans good)
  have here:edge≤j:=(le_max_left ..).trans good
  have jf:j≤f:=(Nat.le_add_right j 2).trans young
  refine ⟨j,uj.trans jf,fj,uj,young,?_⟩
  intro program
  obtain ⟨fk,file,homes,focus,course,purchase⟩:=registered program
  refine ⟨fk,file,homes,focus,course,?_⟩
  intro N per kn
  obtain ⟨panel,paid⟩:=purchase N per kn
  refine ⟨panel,?_⟩
  have oldN:=oldU.trans (uj.trans (jf.trans (fk.le.trans kn)))
  obtain ⟨_,_,_,applyRead⟩:=day N oldN
  have live:=applyRead (Fin 3) ages (by decide) size (fun i=>Nat.le_of_lt_succ (grade i).isLt) apron requested t τ power
    (capital R 6 tuition) positive per
  intro o
  have submitted:=paid o
  have stations(i:Fin 3):edge≤(panel o).slot i:=by
    rw [submitted.2.1,homes]
    exact (ready ρ span near i).1
  have ground:Ground R N per j f apron (panel o).loc:=by
    rw [submitted.2.2.2.2.1]
    exact submitted.1
  refine ⟨?_,submitted⟩
  exact live j f K here (oldU.trans uj) young rfl fk.le kn (panel o) stations (Or.inr ground)
    u oldU uj (openEar u (late.trans oldU) per) (openEar j (late.trans (oldU.trans uj)) per)
end YM.Integration.WilsonReceivedChronologicalFixedRoseSourceRead
