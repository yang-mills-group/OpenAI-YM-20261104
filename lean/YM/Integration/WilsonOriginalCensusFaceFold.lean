variable {G:Gauge}{n q i:ℕ}{k:Fin n→ℕ}{σ:ℝ}{R:Run G}{N:ℕ}{side:Side}
  (y:Fin n → Cover)(L:Material R N i q k σ (binder side y))(t:Case L.tests)
  (κ:(v:Fin n)→Knob (L.tests v))(pt:Fin n→Chamber)(top:ℕ)(cells:Digits R.family.path.levels (Fin n))
  (seed:(v:Fin n)→Choice R k v)
local notation "previous" => fixed R k κ pt N top (i+1) cells seed

theorem original (active:Addressed y L t)(old:Outerm G L.tests)(declared:old=(previous))
    (well:Wellness k old){α A:ℝ}(hs:0<α)(base:1≤A)(cover:CoverBill old q α A)
    (x:Wallet (room (Fin n)))(s:Hot (Stock.census (Fin n)))(d:ℕ)(v:Link G side):
    sideValue L κ pt top cells seed x true s.val d v=
      (∏u∈s.val.val,(x u).val)*Complex.ofReal (diagonal (mass k s.val.val+d)
        (fun l z=>touch t s.val.val ((spent R k N i q side old y (cells i) s.val.val) d l z)) v):=by
  have law:Wellness k (submit old k q):=(WilsonReceivedCompactVerseEntrance.original old well hs base cover).2.1
  subst old
  exact WilsonOriginalCensusFaceSheet.original y L t κ pt top cells seed x active law s d v

