variable {G:Gauge}{n:ℕ}{D k:Fin n→ℕ}{R:Run G}{N K c i:ℕ}
  (κ:(v:Fin n)→Knob (D v))(pt:Fin n→Chamber)(cells:Digits R.family.path.levels (Fin n))
  (seed:(v:Fin n)→Choice R k v)
local notation "L_" => R.family.path.levels
local notation "raw_" => WilsonOlderFreshSoftSocketPole.raw R k κ pt seed
local notation "h_" S:max => ∑v∈S,WilsonOlderFreshSoftSocketPole.lag R k seed v
def source (z:Fin n → Cover)(S:Finset (Fin n))(f:Pen D S→L[ℝ]ℝ):Era G ℝ:=
  printed (WilsonReceivedFixedDigitHistory.itinerary (L_) R.metals.O k N cells (K-i) i (independent (raw_))) S f z

def Filed (Y:Era G ℝ)(z:Fin n → Cover)(S:Finset (Fin n))(f:Pen D S→L[ℝ]ℝ):Prop:=
  let high:=source (N:=N) (K:=K) (i:=i) κ pt cells seed z S f
  let coin:=clock (L_) R.metals.O N K i (PowerSeries.X^(h_ S))
  (∀p,high.1 p=WilsonCoeffUV.Cosmos.affix coin (Y.1 p)) ∧
  high.2=WilsonCoeffUV.Cosmos.affix coin Y.2 ∧
  ∀e r (v:Fin r→YForest G),PowerSeries.coeff (e+h_ S) (reading high.2 v)=
    PowerSeries.coeff e ((kinetic (L_) R.metals.O N K i)^(h_ S)*reading Y.2 v)

theorem restored (simple:G.Simple)(ik:i≤K)(kn:K≤N)(S:Finset (Fin n))(f:Pen D S→L[ℝ]ℝ)
    (z:Fin n → Cover)(Y:Era G ℝ)(issued:Y=tuftV f (levelsO (fixed R k κ pt N K i cells seed z) S)):
    Filed (N:=N) (K:=K) (i:=i) κ pt cells seed Y z S f:=by
  let cut:=K-i
  have date:i+cut=K:=by dsimp [cut]; omega
  have both:=WilsonOlderFreshSoftSocketCourse.original R k κ pt seed (L_) R.metals.O simple
    R.alloy.B.ratio N cells S f cut i (date.le.trans kn) z
  subst Y
  have allSide:=both.1
  have covered:=both.2
  rw [date] at allSide covered
  refine ⟨allSide,covered,?_⟩
  intro e r v
  change PowerSeries.coeff (e+h_ S) (reading ((printed _ S f z).2) v)=_
  rw [covered]
  exact WilsonOlderFreshSoftSocketKinetic.discharged (L_) R.metals.O N K i (h_ S) ik _ v e

variable {j e:ℕ}{V:Realm G (e+1) Credit.leanC}{draw:V.draws=R.family.path.levels}{rate δ σ:ℝ}

theorem original (simple:G.Simple)(vc:j+1≤c)(ck:c≤K)(kn:K≤N)
    (funded:Submitted R V draw D k N K j rate δ σ)
    (digits:Digits V.draws (Fin n)){I:Type}{n':Side}{P:Passport n' (Fin n)}
    (B:I→Binder P (Stock.census (Fin n)))(front:I→Fin n)(live:∀z,front z∈(B z).mode.val)
    (positive:∀z,0 < mass k (B z).mode.val)(y:Fin n → Cover)(t:Case D):
    ∃H:Material R N (j+1) e k σ B,∃axis:H.tests=D,
      H.realm=V ∧ H.amplitude=rate ∧ H.allowance=δ ∧ H.pin=front ∧ H.root=y ∘ front ∧
      (∀z,HEq (H.source z) t) ∧
      (∀l,HEq (H.frill l) (WilsonReceivedDepositedOrbitalPrint.front (J:=(B l).mode.val) (front l) y)) ∧
      (∀[Fintype I](x:Affinity.Wallet (WilsonOriginalMixedBlockRows.room (Fin n)))(s:(Stock.census (Fin n)).Mode),
        WilsonOriginalCensusDatedHeldTariff.salary H x s=(WilsonIndependentCollarLowerMass.copies B s:ℝ)*
          (‖∏v∈s.val,(x v).val‖*‖touch t s.val‖)) ∧
      (∀l,Real.exp (σ*(B l).length)*(1+∑r,(words H l).fare r) ≤ WilsonReceivedDepositedOrbitalBudget.amount H l) ∧
      ∀(S:Finset (Fin n))(f:Pen D S→L[ℝ] ℝ)(z:Fin n → Cover),
        Filed (N:=N) (K:=K) (i:=j+1) κ pt (onLevels draw digits) seed (measured H axis S f z) z S f:=by
  obtain ⟨H,axis,realm,gross,rent,pin,root,profile,frills,bill,book,all⟩:=
    WilsonIndependentCollarSubmittedStop.original κ pt seed simple vc ck kn funded digits B front live positive y t
  refine ⟨H,axis,realm,gross,rent,pin,root,profile,frills,bill,book,?_⟩
  intro S f z
  exact restored κ pt (onLevels draw digits) seed simple (vc.trans ck) kn S f z _ <|
    (all S f z).trans (WilsonIndependentCollarSubmittedStop.continued κ pt (onLevels draw digits) seed
      simple vc ck kn S f z).symm

