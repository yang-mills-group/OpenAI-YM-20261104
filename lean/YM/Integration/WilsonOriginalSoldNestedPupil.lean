    (π:ℕ→Layout G)(Γ:ℕ→Pace.Coin)(Ψ:∀l,RG.Rep G (R.family.side l per))
    (route:Concourse R.alloy R.kit R.T π Γ m N per k Ψ)
    {φ:ℕ→ℕ}(books:Mentor.Offices.Books D R.rolls Q₀ φ)(ahead:Mentor.Forecast D R.rolls Q₀ φ books)
    (pieces:Fin 3→Submodule ℝ ℂ)(order shelf seats:ℕ)
    (physical:Wallet A → Config G (R.family.side ((j+1)+1) per)→Poly (J))
    (P:WilsonOriginalReceivedChain.Post (N:=N) R hk D Q₀ π Γ Ψ books ahead A pieces grades order shelf seats (j+1) lo physical)
variable (floor:m≤j)
local notation "allotted" => Burn.horizon k+2
local notation "tape₀" => AllOrder.Floe.Step.tape allotted
local notation "nextCut" => Nat.lt_trans (Nat.lt_succ_self j) hi
local notation "starts" => Oak.grade0 R hk D Q₀ π Γ lo P.lesson
local notation "previous" r:max => prior R wood a dmax depth digit hi owner columns films charge per sites A t r
include route in
theorem original (L:WilsonOriginalReceivedChain.Post (N:=N) R hk D Q₀ π Γ Ψ books ahead A pieces grades order shelf seats j floor (fun x:Wallet A => LocalComparison.actualPush R.family N per (j+1) (physical x)))
  (file:WilsonOriginalReceivedChain.Filed R hk D Q₀ π Γ Ψ books ahead A pieces grades order shelf seats floor physical P L)
    (sold:WilsonOlderFreshThermometerSources.Sold R wood a dmax depth σ digit T)
    (positive:0<σ ((j+1)+1))(bounded:∀v x,x∈A v→‖x‖≤1)(simple:G.Simple)
    (v:ℕ→Gear G→ℝ)(before:FundedMarkedCoverRows.prices v R.kit)(vac:FundedOriginalVacuumPaths.prices R.kit)
    (opened:WilsonOriginalPrimerPostCover.opening R simple v before vac k ≤ m)
    (path:PlanV.Path D R.alloy Q₀ (Burn.horizon k) N m π Γ)(pass:Pass D Q₀ R.alloy R.kit)
    (site:P.passport=Passport.point sites)(keys:P.modelIndex=WilsonOriginalPointCompactRoster.Index owner grades T₁)
    (same:HEq P.model (M))(month:Scholar.Month R.rolls D Q₀ R.alloy.delay)
    (fits:order≤Burn.horizon k+1)(narrow:shelf≤R.alloy.B.a.clock.J (j+1))
    (r:ℕ)(retained:r ≤ Q)(grade:r ≤ Burn.horizon k+2)(kept:r ≤ order)
    (grid:Side)(tiles:(R.family.side j per).val ∣ grid.val)(d:ℕ)(dkeep:d≤r)(u:Stationary.Link G grid):
    WilsonOriginalCopiedHistory.block R nextCut r
      (WilsonOriginalCopiedHistory.receive (previous r) (π (j+1)) tape₀ grades (Γ (j+1)) starts allotted r)
      grid tiles d u =
    peek tiles (Oak.student (n:=per) R hk D Q₀ π Γ books floor L.op L.lesson ahead A L.model order L.voter)
      grades (π (j+1)) tape₀ t d u:=by
  have earned (fine:Side)(multiple:(R.family.side (j+1) per).val ∣ fine.val) :
