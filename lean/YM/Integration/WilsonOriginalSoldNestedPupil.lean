    (columns:∀l,Letter (R.family.labels.level (WilsonOlderFreshThermometerRoom.weight (owner l))))
    (films:∀l,Studio (dmax (owner l))) (charge:I→ℂ)
    (per:ℕ)(sites:Fin 3→Site (R.family.side ((j+1)+1) per))(A:Fin 3→Set ℂ)(t:Wallet A)
