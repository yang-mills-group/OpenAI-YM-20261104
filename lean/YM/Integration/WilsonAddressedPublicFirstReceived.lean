  (base:m≤j)(cut:j+1<N)
  (op:Mentor.Opportunity (R.alloy.B.a.clock.J (j+1+1)) (R.alloy.B.a.clock.J (j+1)))
  (q:(v:Fin n)→Choice R d v)(hd:∀v,0<d v)(y:Fin n→Lattice.Cover)
  (cells:WilsonReceivedFixedDigitHistory.Digits R.family.path.levels (Fin n))
