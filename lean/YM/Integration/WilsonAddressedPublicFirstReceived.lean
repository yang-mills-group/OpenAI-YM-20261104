local notation "clock" => R.alloy.B.a.clock
local notation "Hhat" => (clock).hatBeta (j+1)
local notation "σₗ" => Poetry.Agenda.seed (roots semester R simple) MintClock.splits (Burn.horizon ask.vac) ((clock).J (j+1))
local notation "sideₗ" => coarse R (j+1) per
local notation "geom" => binder (sideₗ) y
variable {rentLimit tol : ℝ}(origin : WilsonOriginalCensusCanonicalFirstEdgePayer.Source R day.hk (roots semester R simple) (tab semester R simple) day.π day.Γ (day.Ψ per) school.books base op (day.lessons (j+1) (Nat.le_succ_of_le base) cut) school.ahead d q hd y cells ask.order ask.shelf rentLimit) (x : Wallet (room (Fin n)))
  (rawHigh : Config G (R.family.side (j+1+1) per) → Marker.Poly (Stock.census (Fin n)))
  (same : ∀U, ((((day.Ψ per) (j+1+1)).eval U:ℂ) • Poly.pass (Spill.Foundry.uncut (row R d q hd (WilsonIndependentCollarCanonicalCofinalSeats.addresses R (j+1) per y cells) (Poetry.Agenda.seed (roots semester R simple) MintClock.splits (Burn.horizon ask.vac) (R.alloy.B.a.clock.J ((j+1)+1)))) (Coat.gStep ((day.Ψ per) (j+1+1)).beta) x U))=rawHigh U)
  (opL : Mentor.Opportunity (R.alloy.B.a.clock.J (j+1)) (R.alloy.B.a.clock.J j))
  (length lowOrder lowShelf : ℕ) (bills : Fin n → ℝ)
  (Mₗ : Material R N (j+1) length d (Poetry.Agenda.seed (roots semester R simple) MintClock.splits (Burn.horizon ask.vac) (R.alloy.B.a.clock.J (j+1))) (binder (coarse R (j+1) per) y))
local notation "high" => WilsonOriginalCensusCanonicalTranslatedPayer.named R day.hk (roots semester R simple) (tab semester R simple) day.π day.Γ (day.Ψ per) school.books base
  op (day.lessons (j+1) (Nat.le_succ_of_le base) cut) school.ahead d q hd y cells ask.order ask.shelf origin x rawHigh same
local notation "bill" => WilsonIndependentCollarMaterialWallet.bill Mₗ bills
local notation "lowCash" => fun v=>bills v*max 1 (WilsonOriginalMixedBlockBudget.roots
  (geom) (bill))
local notation "loRaw" => WilsonAddressedPublicFirstLower.value R (N:=N) (j:=j+1) (per:=per) d y ((day.Ψ per) (j+1)) Mₗ x
local notation "power₀" => ((∑v:Fin n,d v)+1+5)*Fintype.card (Fin n)
local notation "peak" c:max => 3*WilsonOriginalFullRosterBookedHearing.roof d d (fun _ : Fin n=>4) c
local notation "bound" => max ((2:ℝ)^(ask.order+ask.shelf+1)) ((2:ℝ)^(lowOrder+lowShelf+1))

variable (past:∀i:ℕ,Config G (R.family.side i per)→Marker.Poly (Stock.census (Fin n)))
local notation "dated" => Function.update (Function.update past (j+1) (loRaw)) (j+1+1) rawHigh
local notation "charges" => fun _ : Fin n=>4
local notation "rk" => (∑v:Fin n,d v)+1
local notation "home" => ((Passport.point (o)).coarser (R.family.path.levels.clock.op (j+1) per).ratio).origin
local notation "gAt" b:max => Pert.Asymptotics.regulatorRun R.family N per b
include origin same in
theorem original (posted : WilsonOriginalFixedTestCensusFiledBook.Ready R day.hk (roots semester R simple) (tab semester R simple) day.π day.Γ (day.Ψ per) school.books base
      opL (day.lessons j base ((Nat.lt_succ_self j).trans cut)) school.ahead (port (sideₗ) y) (geom) d lowOrder lowShelf length bills Mₗ tol)
    (submitted : ∀v, (lowCash) v ≤ (Hhat)^4)
    (pt : Fin n → Chamber) (lens : Fin n→ℕ) (test : Mₗ.tests=lens)
    (lives : Addressed y Mₗ (present Mₗ.tests))
    (fixed : ∀z S, output Mₗ.prior S N z=WilsonReceivedFixedDigitCanonical.fixed R d
      (fun v=>contact (Mₗ.tests v)) pt N (j+1+1) (j+1) cells q z S)
    (tags : ∀b:Covers R.family.path.levels.S (j+1) (sideₗ),(step R (j+1) b.val).Choices)
    (rentOrder precision target breadthCap : ℕ)
    (fit : ask.order ≤ Burn.horizon ask.vac+1)(shelved : ask.shelf ≤ (clock).J (j+1))
    (count : op.count ≤ Burn.horizon ask.vac+2)(depth : 2*rentOrder+8 ≤ ask.order)(age : rentOrder+3 ≤ 3*ask.vac+2)
    (ready : WilsonReceivedMeasuredStampPrice.opening R simple rentOrder ask.order ask.vac depth age
      (by norm_num:0<(1:ℝ)) ≤ j+1)
    (loDepth : lowOrder ≤ (clock).J (j+1))(loShelf : lowShelf ≤ (clock).J j)
    (loSeats : opL.count ≤ Burn.horizon ask.vac+2)
    (halo : (eventually_atTop.mp (WilsonOriginalOccupiedRaffleIndependent.halo R simple)).choose ≤ j+1)
    (income : (eventually_atTop.mp (WilsonEmittedOriginalCalendar.wages R simple)).choose ≤ j+1)
    (upperWidth : scale ≤ 1)
    (sold : (eventually_atTop.mp ((Next.Rank.Station.hat_rate R.family.path.levels simple).eventually_ge_atTop
      (max 1 (WilsonOriginalCensusCanonicalRows.ceiling R d 1)))).choose ≤ j+1)
    (rent : rentLimit ≤ (Pert.Asymptotics.regulatorRun R.family N per (j+1+1))^rentOrder)
    (tube : LinkTube G)(front : (t:Multi.Hot (marks)) → t.val.val)
    (teacher : 0<σₗ ∧ Real.exp ((σₗ)⁻¹^2)≤(Hhat) ∧
      (((day.Ψ per) (j+1)).p.supportExponent+2)*((((day.Ψ per) (j+1)).p.B:ℝ)⁻¹)≤(σₗ)/2 ∧
      (Real.sqrt ((day.Ψ per) (j+1)).beta)⁻¹≤1/2 ∧ ((day.Ψ per) (j+1)).p.B=Nat.ceil ((Real.log (Hhat))^2) ∧
      ((day.Ψ per) (j+1)).p.supportExponent+2≤102)
    (accuracy : 2*(precision+1) ≤ target) (highCap : peak target ≤ ask.order)(lowCap : peak target ≤ length)
    (menu : WilsonOriginalCensusCanonicalRelativePeriodSchedule.Appointment R simple d lens pt
      (fun _ : Fin n=>4) tube ask.order lowOrder target precision accuracy)
    (go : menu.first ≤ j+1)(board : menu.period (j+1) breadthCap ≤ per)
    (near : ∀t : Multi.Hot (marks), breadth t.val.val (front t).val 0
      (relative t.val.val (front t).val y) ≤ breadthCap)
    (nn:∀v,0≤bills v)(pieces:op.count=ask.school.pieces)
    (s:(marks).Mode){u b P geomCost p roomSize:ℕ}{η:ℝ}(ep:0<η)(tp:0<tol)
    (two:2≤(bound))
    (late:(eventually_atTop.mp (WilsonReceivedChronologicalPanelClock.original R simple ask (charges) P
      geomCost p target (bound) tol η two tp ep)).choose ≤ b)
    (floorOld:WilsonSingleHardRadius.first R simple ≤ m)(oldEar:m ≤ u)(ub:u≤b)(bj:b≤j)
    (geo:R.family.S.a b/R.family.S.a (j+1+1)≤(R.family.path.levels.clock.hatBeta b)^geomCost)
    (np:0<n)
    (cash:work n P (fare d (charges)) (rk)+1+(WilsonOriginalFullRosterCouplingClock.wallet (fare d (charges))).pole+1 ≤ rentOrder)
    (jet:work n P (fare d (charges)) (rk)+1+1≤precision)
    (regular:work n P (fare d (charges)) (rk)+2≤p)
    (support:∀i,(R.family.path.levels.budget i).supportExponent=100)
    {df:ℕ}{frame:Frame G df}(section_:SectionData frame)(group:Hol G)
    (Z:Support (R.family.side b per))(center:Site (R.family.side b per))(held:center∈Z)
    (homes:∀i∈s.val,sites R (home) (Nat.le_succ_of_le bj) i∈Z)
    (roof:coverNumber ((day.Ψ per) b).p.B Z ≤ roomSize) :
  (∃hi : WilsonOriginalDatedCensusInput.Filed (N:=N) R day.hk (roots semester R simple)
      (tab semester R simple) day.π day.Γ (day.Ψ per) school.books (Nat.le_succ_of_le base)
      school.ahead (S₀) (power₀) ((dated) (j+1+1)),
    ∃lo : WilsonOriginalDatedCensusInput.Filed (N:=N) R day.hk (roots semester R simple)
      (tab semester R simple) day.π day.Γ (day.Ψ per) school.books base
      school.ahead (lowCash) (power₀) ((dated) (j+1)),
    WilsonReceivedChronologicalTwoFlatSale.Sale R simple day.hk (roots semester R simple) (tab semester R simple)
      day.π day.Γ (day.Ψ per) school.books base school.ahead (dated) hi lo u b s P roomSize η) ∧
  ∀e, u≤e → (eb:e≤b) →
      ‖WilsonOriginalJointTrialHearing.read R N per (1:Config G (R.family.side e per))
          ((eb.trans bj).trans (Nat.le_add_right j 2)) rawHigh s-
        WilsonOriginalJointTrialHearing.read R N per (1:Config G (R.family.side e per))
          (Nat.le_succ_of_le (eb.trans bj)) (loRaw) s‖≤
        WilsonReceivedChronologicalLastFlat.wage s P roomSize η*(gAt b)^P := by
  classical
  obtain ⟨low,hx,hg,ho,hs,atLow,c,tubeEq,frontEq,price,⟨faces⟩⟩ := WilsonAddressedPublicFirstCalendar.original
    R simple day.hk (roots semester R simple) (tab semester R simple) day.π day.Γ (day.Ψ per)
    (day.seen per).1 school.books base cut op (day.lessons (j+1) (Nat.le_succ_of_le base) cut) school.ahead
    d q hd y cells ask.order ask.shelf origin x rawHigh same opL (day.lessons j base ((Nat.lt_succ_self j).trans cut))
    length lowOrder lowShelf bills Mₗ posted submitted pt lens test lives fixed tags rentOrder precision target breadthCap
    fit shelved count depth age ready loDepth loShelf loSeats halo income upperWidth sold rent tube front teacher
    accuracy highCap lowCap menu go board near
  obtain ⟨gu,hu,sh,counted,placed,tariff⟩ := WilsonOriginalOneArmCanonicalBook.original R day.hk
    (roots semester R simple) (tab semester R simple) day.π day.Γ (day.Ψ per) school.books base op
    (day.lessons (j+1) (Nat.le_succ_of_le base) cut) school.ahead d q hd y cells ask.order ask.shelf
    x rawHigh (high) origin same rfl
  have upperAt : rawHigh=(dated) (j+1+1):=by simp
  have lowerAt : (loRaw)=(dated) (j+1):=by simp
  let C:=max ((2:ℝ)^(ask.order+ask.shelf+1)) ((2:ℝ)^(low.order+low.shelf+1))
  have ceq:C=(bound):=by simp only [C,ho,hs]
  have two' :2≤C:=ceq.symm ▸ two
  have appointed:(eventually_atTop.mp (WilsonReceivedChronologicalPanelClock.original R simple ask
    (charges) P geomCost p target C tol η two' tp ep)).choose ≤ b:=by simpa only [ceq] using late
  have upperCash : ∀v,0≤(S₀) v:=fun _=>zero_le_one.trans (le_max_left _ _)
  have lowerCash : ∀v,0≤(lowCash) v:=fun v=>mul_nonneg (nn v) (zero_le_one.trans (le_max_left _ _))
  obtain ⟨⟨hi,lo,idHi,idLo,sale⟩,ears⟩ := WilsonAddressedPublicFirstDay.original ask school day base
    (dated) rawHigh (loRaw) (high) low upperAt lowerAt s (charges) P geomCost p target precision rentOrder
    roomSize C tol η two' tp ep appointed floorOld oldEar ub bj (K:=j+1+1) (Nat.lt_succ_self (j+1)) cut geo
    np upperCash lowerCash gu hg hu sh ((high).post.capacity.symm.trans (counted.trans pieces))
    c (fun t _=>faces t) cash jet regular support section_ group Z center held (by simpa only [placed] using homes)
    roof
  exact ⟨⟨hi,lo,sale⟩,fun v uv vb=>(ears v uv vb).2⟩

