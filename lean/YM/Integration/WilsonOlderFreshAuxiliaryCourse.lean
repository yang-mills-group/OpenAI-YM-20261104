  {k:ℕ}(school:Syl.School k)
open WilsonOlderFreshAuxiliaryPost

def Sold (m N per i:ℕ)(hk:Burn.horizon k+2 ≤ R.alloy.B.a.clock.J m)
    (π:ℕ → Layout G)(Γ:ℕ → Pace.Coin)(Ψ:∀j,Rep G (R.family.side j per))(lo:m ≤ i):Prop:=
  Nonempty (WilsonOriginalReceivedChain.Post (N:=N) (V:=Unit) (X:=fun _=>ℂ) R hk D Q₀ π Γ Ψ
    books ahead actors (fun _=>(⊥:Submodule ℝ ℂ)) (fun _=>0) school.order school.horizon
    school.pieces i lo (booked G (Ψ (i+1))))

include scroll house in
theorem original (simple:G.Simple)(one:1 ≤ school.pieces)(deep:2 ≤ school.order):
    ∀ᶠ m:ℕ in atTop,∀M, m ≤ M →
      ∃(π:ℕ → Layout G)(Γ:ℕ → Pace.Coin)(hk:Burn.horizon k+2 ≤ R.alloy.B.a.clock.J m),
        PlanV.Path D R.alloy Q₀ (Burn.horizon k) M m π Γ ∧
        ∀per, ∃ Ψ:∀i,Rep G (R.family.side i per),
          Concourse R.alloy R.kit R.T π Γ m M per k Ψ ∧
          Topline (Ψ M) (R.family.path.levels.clock.forcedAllowance M) ∧
          ∀i,∀lo:m ≤ i,i<M → Sold R D Q₀ books ahead school m M per i hk π Γ Ψ lo:=by
  have visit:=WilsonMeasuredPointHouseSeats.original R D Q₀ scroll books ahead house school deep
  have late:=R.family.path.levels.fits.deep.eventually (Filter.eventually_ge_atTop (Sycamore.Boot.need 0 school))
  filter_upwards [visit,late] with m funded large
  intro M top
  obtain ⟨π,Γ,hk,lessons,path,periods⟩:=funded M top
  refine ⟨π,Γ,hk,path,?_⟩
  intro per
  obtain ⟨Ψ,journey,full,office⟩:=periods per
  refine ⟨Ψ,journey,full,?_⟩
  intro i lo live
  have resource:=office i lo live
  obtain ⟨op,card,order⟩:=resource.2
  have width:=large.trans (R.alloy.B.a.fits.mono (Nat.le_succ_of_le lo))
  have staff:=house.licence
  have sold:=WilsonOlderFreshAuxiliaryPost.original (N:=M) R hk D Q₀ π Γ Ψ journey scroll books
    staff.employed lo house.stamps full school op (lessons i lo live) resource.1.some ahead staff.forecast
    simple live staff.employed.station.1 (card.symm ▸ one) card order.ge width
  change Nonempty _ at sold
  simpa only [Sold,card] using sold

