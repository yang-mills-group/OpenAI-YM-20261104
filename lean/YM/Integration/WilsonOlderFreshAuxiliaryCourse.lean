variable {G:Gauge}(R:Run G)(D:Roots (G:=G) R.metals.p.profile R.metals.K R.metals.p.kernel)
  (Q₀:D.Tab R.rolls){φ:ℕ → ℕ}(scroll:VowsR.LawScroll G φ)
