include well hs base cover bound in
theorem original [Fintype I]{p':Passport n' (Fin n)}{μ:Type}
    (high:μ → Row p' (Stock.census (Fin n)) G (Affinity.Wallet (room (Fin n))))
    (placed:p'=P)(names:μ=((l:I)×((words H) l).Roster))(ink:HEq high (mounts H))
    {w:Fin n → ℝ}{σ₀ expense:ℝ}{order seats shelf:ℕ}
    (stock:Scene.Armada high w k σ₀ expense order seats shelf)(width₀:0 < σ₀)
    (per:ℕ)(F:Forest (step R j per).ratio)(tag:(step R j per).Choices)
    (h:n'.val∣(fine R j per).val)(x:Affinity.Wallet (room (Fin n)))
    {start e:ℕ}{quiet:ℕ → SeriesA G}{π:ℕ → Layout G}{Γ:ℕ → Pace.Coin}
    (legal:Legal (Step.tape (e+2)) (π (j+1)))
    (course:Read R N start e quiet π Γ)(live:start ≤ j){τ cash:ℝ}
    (funded:Issued R N (j+1) e (quiet (j+1)) τ cash)
    (b:Stationary.Link G (coarse R j per))(r:ℕ)(retained:r ≤ q)(grade:r ≤ e+2):
    let A₀:=Stationary.arm G _ 1 b
    let K₀:=model R N j per (show j<N by omega)
    let raw:=Bulk.Fk K₀ F tag (copyColor h high k (fun a=>(high a).paint x) (π (j+1)) (Step.tape (e+2))) A₀ r
    let income:=fun z=>WilsonOriginalCensusPaidForest.value B R N j per (show j<N by omega) F h x
      (fun l=>offered old k q y t (B l).mode.val (c l)) A₀ z r
    let Q₀:=K₀.covariance F tag
    let computed:=WilsonOriginalGaussianPaidTable.table (Board (Stock.census (Fin n)) r) Q₀ income
    ratio raw=ratio computed ∧ logMarked raw=logMarked computed ∧
      ∀s,MeasureTheory.Integrable (WilsonOriginalGaussianPaidTable.presented (Board (Stock.census (Fin n)) r) income s) (Gaussian.cloud Q₀):=by
  subst p' μ
  cases eq_of_heq ink
  let a:=Stationary.arm G _ 1 b
  have read:=WilsonOriginalCensusGaussianTable.original B k (words H) R N j per (show j<N by omega) F tag h x (π (j+1)) (Step.tape (e+2))
    (charts H) stock width₀ width legal (fun l n x=>(admitted H l n x).1) (fun l n x=>(admitted H l n x).2)
    (matched H) course live funded b r retained grade
  dsimp only at read ⊢
  have earned:(fun z=>WilsonOriginalCensusPaidForest.value B R N j per (show j<N by omega) F h x (charts H) a z r)=
      fun z=>WilsonOriginalCensusPaidForest.value B R N j per (by omega) F h x
        (fun l=>offered old k q y t (B l).mode.val (c l)) a z r:=by
    funext z slot
    exact WilsonReceivedDepositedOrbitalLedger.original R Y lo enrolled N X positive limit width B c inside pin
      deep y t closed tickets old well hs base cover bound per F h x a z r retained slot
  rw [←earned]
  exact read

