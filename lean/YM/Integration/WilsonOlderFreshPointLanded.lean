local notation "βhat"=>R.alloy.B.a.clock.hatBeta (i+1)

variable (digit:∀h,Site (R.family.S.block h))
include history scroll chamber warm top cal hospital in
theorem original (simple:G.Simple)(nonbare:i<N)(cap:∀t,‖value A t‖≤1)
    {τ δ:ℝ}(pos:0<τ)(bounded:τ≤1)(positive:0<δ)(pass:Pass D Q₀ R.alloy R.kit)
    (late:WilsonMeasuredSemesterSubpower.onset R 1 positive ≤ i)
    {B:ℝ}(T:WilsonOlderFreshGraphSlate.Copy G d Q σ₀)(salary:(∑r,T.fare r)≤B)
    (posted:WilsonOlderFreshPointCommission.Published R L a depth (i+1) w (⟨N,nonbare,digit⟩,f) T)
    (seats:1≤op.count)(shape:op.count=school.pieces)(phase:school.order+1≤op.stage)
    (enrolled:Q ≤ school.order)(order:d ≤ school.horizon)(cut:ℕ)
    (width:Sycamore.Boot.need cut school ≤ R.alloy.B.a.clock.J (i+1))(test:Wallet A):
    ∃c amp:ℝ,0<c ∧ 0<amp ∧ amp⁻¹≤βhat^δ*(1+B) ∧
      WilsonOlderFreshPointCommission.Published R L a depth (i+1) w (⟨N,nonbare,digit⟩,f) T ∧
      WilsonOlderFreshGraphHostTarget.Landed (d:=d) (N:=N) R hk D Q₀ π Γ Ψ books hi school ahead A
        (J₀:=T.Roster) (P:=letterPost) (T.rows S A) τ c amp cut:=by
  have budget:school.order+d ≤ Burn.horizon k+2:=(Nat.add_le_add_left order _).trans school.tall
  obtain ⟨Ωpos,expense⟩:=WilsonOlderFreshGraphActualFare.original R hk D Q₀ π Γ Ψ history books hi school op lesson
    ahead hospital y A T nonbare cap seats shape phase enrolled order budget pass δ positive late
  have awake:=Poetry.Agenda.stem D φ (Burn.horizon k) (R.alloy.B.a.clock.J (i+1))
  obtain ⟨c,amp,hc,hw,amount,received⟩:=WilsonOlderFreshGraphPointPost.original R hk D Q₀ π Γ Ψ history scroll
    books chamber hi warm top school op lesson cal ahead hospital y σ₀ T A simple nonbare rfl awake.le cap
    pos bounded Ωpos salary seats shape phase enrolled order budget cut width test
  have β0:1≤βhat:=(R.alloy.B.a.fits.delayed (i+1)).le
  have maxfee:max 1 Ω₀≤βhat^δ:=max_le (Real.one_le_rpow β0 positive.le) expense
  have nz:0≤1+B:=by
    by_contra! negative
    have loss:=mul_nonpos_of_nonneg_of_nonpos (zero_le_one.trans (le_max_left 1 Ω₀)) negative.le
    exact (inv_pos.mpr hw).not_ge (amount.trans loss)
  exact ⟨c,amp,hc,hw,amount.trans (mul_le_mul_of_nonneg_right maxfee nz),posted,received⟩

