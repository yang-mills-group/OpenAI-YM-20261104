private theorem transport {i:ℕ}{y w:Fin n→Site (R.family.side i per)}(same:y=w)
    (H:Sheet R N i y){raw:Config G (R.family.side i per)→Marker.Poly (Stock.census (Fin n))}
    (admitted:Received H raw):Received (same ▸ H : Sheet R N i w) raw:=by
  subst w
  exact admitted

variable (active:first+1≤top)(located:∀v,parent R active per (placed R fine z) v=0)
  (a:↥(Finset.Ico first (top-1)))

local notation "geometry" => WilsonMovingForkStencilLine.pinned (first:=first) (top:=top) (m:=m) (N:=N)
  (power:=power) (P:=P) (draw:=draw) (R:=R) (ξ:=placed R fine z) active located a

def deposit:Sheet R N (a.val+1)
    (parent R (by have range:=Finset.mem_Ico.mp a.property;omega:a.val+1≤top) per (placed R fine z)):=
  geometry ▸ WilsonMovingForkPostedMaterial.file ((purchase).choose.choose a) (x₀)

theorem received:
    Received (z:=parent R (by have h:=Finset.mem_Ico.mp a.property;omega:a.val+1≤top) per (placed R fine z)) (deposit (j:=j) (R:=R) (N:=N) (per:=per) (grades:=grades) (V:=V) (draw:=draw) (rate:=rate)
      (allowance:=allowance) (power:=power) (P:=P) (house:=house) (day:=day)
      (κ:=κ) (pt:=pt) (top:=top) (first:=first) (valid:=valid) (toll:=toll) (old:=old)
      (test:=test) (classroom:=classroom) (fine:=fine) (z:=z) (s:=s) (q:=q)
      (paid:=paid) active located a) ((rows₀) (a.val+1)):=by
  obtain ⟨entry,posted⟩:=WilsonReceivedChronologicalFixedSocketLife.atDate (R:=R) (per:=per)
    (V:=V) (draw:=draw) (rate:=rate) (allowance:=allowance) (power:=power) (P:=P)
    (house:=house) (day:=day) (κ:=κ) (pt:=pt) (top:=top) (first:=first) (valid:=valid)
    (toll:=toll) (old:=old) (test:=test) (classroom:=classroom) (fine:=fine) (z:=z)
    (s:=s) (q:=q) (paid:=paid) (hd:=hd) (prior:=prior) (σ:=σ) a
  have admitted:=WilsonMovingForkRegisteredMaterial.original power P house day (cells₀) test κ pt (seed₀) (x₀)
    a.val (old.trans (Finset.mem_Ico.mp a.property).1) (WilsonReceivedChronologicalFixedLedger.before valid a)
    _ _ _ entry
  unfold deposit
  apply transport geometry
  rw [←posted]
  exact admitted

