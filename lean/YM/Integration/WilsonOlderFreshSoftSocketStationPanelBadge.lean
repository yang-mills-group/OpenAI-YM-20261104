private theorem heat (simple:G.Simple):∀ᶠv:ℕ in atTop,∀N≥v,∀per:ℕ,|regulatorRun R.family N per v|≤1:=by
  filter_upwards [(Next.Rank.Station.hat_rate R.family.path.levels simple).eventually_ge_atTop 8] with v warm N live per
  change |(Real.sqrt (R.family.path.β N per v))⁻¹|≤1
  rw [abs_of_nonneg (inv_nonneg.mpr (Real.sqrt_nonneg _))]
  apply inv_le_one_of_one_le₀
  apply Real.one_le_sqrt.mpr
  have band:=(R.makes.wilson.represents N per v live).band.1
  change (H v)/2≤R.family.path.β N per v at band
  linarith

theorem original (simple:G.Simple)(slow:WilsonWindowReportingPace.Slow R.kit)
    (D:Fin 3→ℕ)(e width pow target:ℕ)(A:ℝ)(ap:0≤A):
    let w:=date R width (loss R pow target)
    Tendsto w atTop atTop ∧ ∃gate:ℕ,∀c≥gate,w c≤c ∧ ∀v≥gate,v≤w c →
      ∀(start:ℕ)(opt tol:ℝ)(office:WilsonOriginalObservedRoseProbeShelf.Badge R D e v start opt tol),
      ∀(N per f n:ℕ)(cut:f+n≤N),c≤f+n → v+1≤f+n → R.family.S.a c/R.family.S.a (f+n)≤(H c)^width →
      R.family.S.scale (f+n)-R.family.S.scale v≤A*(1+Real.log (H (v+1))) →
      ∀(req step:ℕ)(B:ℝ)(P:Panel R grade N per f (f+n) (Nat.le_add_right f n) cut req pow step B)
      (file:Filed R grade (f+n)),P.slot=file.station → P.axis=file.A N per →
      ∀(s:(Stock.census (Fin 3)).Mode),s.val.Nonempty →
      ∀(κ:(i:Fin 3)→Knob (D i))(pt:Fin 3→Chamber)(route:Digits L (Fin 3))(home:Fin 3→ Cover)
      (test:Case D)(q:ℕ),q≤e → let θ:=regulatorRun R.family N per v
      ∀(r:ℝ)(u:ℕ)(old:u≤f+n)(fee:ℝ),
      ‖observed R cut P s u old-
         figure R grade κ pt N per (f+n) c v route s.val (votes R grade (N:=N) (per:=per) file P.names P.turn) home (touch test s.val) q θ‖≤fee →
      ‖(∏i∈s.val,(r:ℂ)^grade i)*observed R cut P s u old-
         terminal R D office.field office.draw cut P s κ pt route home test q θ r c (w c) v‖≤
        ‖∏i∈s.val,(r:ℂ)^grade i‖*(fee+quota (touch (fun i:s.val=>test i.val) (univ:Finset s.val))*
          (((max 1 B)^3*2^debt R pow)*(regulatorRun R.family N per (f+n))^target)):=by
  classical
  let w:=date R width (loss R pow target)
  obtain ⟨grows,gate,hear⟩:=WilsonOlderFreshSoftSocketStationPanelHearing.original R simple slow D e width pow target A ap
  obtain ⟨start,warm⟩:=eventually_atTop.mp (heat R simple)
  refine ⟨grows,max gate start,?_⟩
  intro c co
  obtain ⟨capped,roll⟩:=hear c ((le_max_left ..).trans co)
  refine ⟨capped,?_⟩
  intro v vo vw stage opt tol office N per f n cut ck vk gear span req step B P file station axes s hs
    κ pt route home test q sub θ r u old fee issued
  have contains:v≤N:=((vw.trans capped).trans ck).trans cut
  have cold:=warm v ((le_max_right ..).trans vo) N contains per
  exact roll v ((le_max_left ..).trans vo) vw office.field office.date.le office.draw office.paid office.quiet
    (fun s=>office.proper s.val) N per f n cut ck vk gear span req step B P file station axes s hs κ pt route home test
    q sub θ cold r u old fee issued

