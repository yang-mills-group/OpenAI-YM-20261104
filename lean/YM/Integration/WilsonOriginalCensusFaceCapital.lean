variable {G:Gauge}{n e j N K:ℕ}{D k:Fin n→ℕ}{R:Run G}{V:Realm G (e+1) Credit.leanC}
  {draw:V.draws=R.family.path.levels}{rate δ σ:ℝ}(purchased:Submitted R V draw D k N K j rate δ σ)
  (cells:Digits V.draws (Fin n))(κ:(v:Fin n)→Knob (D v))(pt:Fin n→Chamber)(seed:(v:Fin n)→Choice R k v)
  (side:Side)(y:Fin n → Cover)(t:Case D)
  (deep:∀s:Hot (Stock.census (Fin n)),0 < mass k s.val.val)
local notation "roster" => binder side y
local notation "previous" => fixed R k κ pt N K (j+1) (onLevels draw cells) seed

include purchased in
theorem original:
    ∃H:Material R N (j+1) e k σ (roster),H.realm=V ∧ H.tests=D ∧ H.amplitude=rate ∧ H.allowance=δ ∧
      (∀x s,WilsonOriginalCensusDatedHeldTariff.salary H x s=
        (WilsonIndependentCollarLowerMass.copies (roster) s:ℝ)*(‖∏v∈s.val,(x v).val‖*‖touch t s.val‖)) ∧
      (∀l,Real.exp (σ*((roster) l).length)*(1+∑a,(words H l).fare a)≤WilsonReceivedDepositedOrbitalBudget.amount H l) ∧
      ∃(fund:Paid R H.realm H.start D k H.allowance σ)(closed:Cloze D k H.realm Credit.leanC)
        (X:Input H.realm H.start univ k D H.amplitude),
        H=WilsonReceivedDepositedOrbitalLedger.book R H.realm H.start fund N X H.nonneg H.lower H.radius
          (roster) pin (fun _=>subset_univ _) (fun s=>s.property.choose_spec) deep y t closed H.tickets ∧
        ∀(z:Fin n → Cover)(s:Finset (Fin n)), output X s N z=(previous) z s:=by
  obtain ⟨H,realm,tests,amp,slack,named,roots,ink,frills,sales,copy,raw⟩:=
    purchased cells κ pt seed _ side (port side y) (roster) pin (fun s=>s.property.choose_spec) deep y t
  refine ⟨H,realm,tests,amp,slack,sales,raw,?_⟩
  subst D
  obtain ⟨X,prior,book⟩:=WilsonOriginalCensusFaceIncome.installed y H t named roots
    (fun s=>eq_of_heq (ink s)) frills
  exact ⟨H.paid,H.closed,X,book,fun z s=>(prior z s).trans (eq_of_heq (copy z s))⟩

