abbrev Post (floor:m ≤ i) (y:T₀×T₀) := WilsonOriginalReceivedChain.Post (N:=i+2)
  R hk D Q π Γ Ψ books ahead WilsonThermometerCourseHearing.disks S₀ levels school.order
    school.horizon school.pieces i floor (WilsonThermometerCourseHearing.offered R A simple
      (Nat.lt_succ_of_lt (Nat.lt_succ_self i)) (placement (R:=R) (N₀) y))

def charged (floor:m ≤ i) (y:T₀×T₀)
    (P:Post R simple A hk D Q π Γ Ψ books school ahead floor y)
    (J:Voice G) (axes:Lattice.Order) (p:ℕ) (t a b:Fin 3) (U:Config G (R.family.side i per)) : ℂ :=
  let V:=P.passport.coarser (R.family.path.levels.clock.op i per).ratio
  let qW:=WilsonThermometerRegisteredRent.grade p
  let H:=radius R (invoice (Fintype.card (Fin 3)) (qW+2*degreeCap)) 1 i
  let r:=amplitude R J H (i+2) per i
  let h:=(WilsonDegreeFourInheritedRange.height R (qW+2*degreeCap) i)*(4*(Ψ i).p.B+2)+2*(Ψ i).p.B+1
  let cold:=House.chilly (G:=G) (plaquettes V.origin H) (angularCut (R.family.path.levels.clock.hatBeta i))
  let x:=without t
  let s:(J₀).Mode:=⟨{a,b},mem_univ _⟩
  let student:=Oak.student (n:=per) R hk D Q π Γ books floor P.op P.lesson ahead
    WilsonThermometerCourseHearing.disks P.model school.order P.voter
  cold.indicator (fun Z =>
      let ξ:=WilsonJointAxialWindow.direction V.origin h J axes r Z
      let link:=WilsonCapturedPrimaryPotential.potential g₁ (r • ξ)
      (Poly.pass (bare (rendered student (Ψ i).p (Coat.gStep (Ψ (i+1)).beta)) x Z)).part s -
        WilsonThermometerRegisteredCompact.prescribed R A π Γ school t a b link y) U

include history chamber warm top cal hospital in
/-- The full signed compact test against the pair is bounded in the actual older Wilson integral.
One can vary both relative child positions in the test without a lattice-volume price. -/
theorem original (late:WilsonOriginalThermometerReportedPost.opening R simple (f:=f) (F:=F) fund slow ≤ i)
    (date:A.station.k=i) (checked:A.station.checked f F A.horizon) (near:close R A)
    (shape:op.count=school.pieces) (size:3 ≤ school.pieces) (space:14 ≤ school.horizon)
    (room:WilsonOriginalStarSceneWords.maximum R levels ≤ school.order)
    (opStage:school.order+1 ≤ op.stage) (ranks:6 ≤ R.alloy.B.a.clock.J (i+1))
    (width:Sycamore.Boot.need 0 school ≤ R.alloy.B.a.clock.J (i+2))
    (refs:∀ v,R.family.ref (levels v) ≤ i+2)
    (floor:m ≤ i) (fit:k ≤ R.alloy.B.a.clock.J i)
    (path:PlanV.Path D R.alloy Q (Burn.horizon k) (i+2) m π Γ)
    (pass:Pass D Q R.alloy R.kit) (month:Scholar.Month R.rolls D Q R.alloy.delay)
    (fits:school.order ≤ Burn.horizon k+1) (shelved:school.horizon ≤ R.alloy.B.a.clock.J m)
    (load:school.pieces ≤ Burn.horizon k+2) (packed:school.order+school.horizon ≤ Burn.horizon k+2)
    (tender:WilsonReceivedMeasuredStampPrice.opening R simple q school.order k
      (show 2*q+8 ≤ school.order from by omega) (show q+3 ≤ 3*k+2 from by omega) zero_lt_one ≤ m+1)
    (held:0 < i) (fieldDate:WilsonThermometerRegisteredOrdinary.opening R simple (f:=f) (F:=F) fund slow ≤ i)
    (heard:WilsonThermometerRegisteredPair.opening R simple D school strip q 0 deep aged 1 1 zero_le_one
      (ε:=1) zero_lt_one ≤ i)
    (p:ℕ) (surplus:q=WilsonThermometerRegisteredRate.order (p+1) (e₀)+1)
    (heat:warmDate R simple ≤ m) (funded:priceDate R simple school (p+1) (e₀) ≤ i)
    (rootFee:WilsonMovingMentorRootRadius.Income (M:=R.metals) D φ R.alloy.delay)
    (stencil:reach R ≤ R.alloy.B.a.clock.J (i+2)+1)
    (volume:Volume.Fund D R.rolls Q φ books R.alloy.delay)
    (J:Voice G) (clear:Clear G J) (axes:Lattice.Order)
    (dw:2*((WilsonThermometerRegisteredRent.grade p)+1)+8 ≤ school.order) (aw:(WilsonThermometerRegisteredRent.grade p)+4 ≤ 3*k+2)
    (window:max (WilsonJointAxialRoster.opening R simple fund slow.2 J clear (Fintype.card (Fin 3)) degreeCap (WilsonThermometerRegisteredRent.grade p) (WilsonThermometerRegisteredRent.positive p))
      (WilsonReceivedAxialFiling.opening R simple D φ strip school.order school.horizon (Fintype.card (Fin 3)) (WilsonThermometerRegisteredRent.positive p)) ≤ i)
    (shapeWindow:max (WilsonReceivedAxialFinite.opening R simple (WilsonThermometerRegisteredRent.grade p) (WilsonThermometerRegisteredRent.positive p))
      (WilsonReceivedAxialFinite.massOpening R D levels school.order school.horizon school.pieces (k:=k) simple strip) ≤ i)
    (paidWindow:WilsonThermometerRegisteredWindow.opening R simple D school.order school.horizon school.pieces
      strip (WilsonThermometerRegisteredRent.grade p) dw aw (WilsonThermometerRegisteredRent.positive p) ≤ i)
    (dp:2*((WilsonThermometerRegisteredRent.grade p)+1+1)+8 ≤ school.order) (ap:((WilsonThermometerRegisteredRent.grade p)+1+1)+3 ≤ 3*k+2)
    (enrolled:booking R simple D school (f:=f) (F:=F) fund slow strip p rootFee dp ap ≤ i)
    (paid:WilsonThermometerRegisteredRent.opening R simple p school.pieces ≤ i)
    : ∃ P : ∀ y:T₀×T₀, Post R simple A hk D Q π Γ Ψ books school ahead floor y,
      ∀ t a b:Fin 3, a≠b → a≠t → b≠t → ∀ (r:ℝ) (test:Test 3),
      let C₀:=max 0 (2*WilsonThermometerRegisteredRent.invoice p+price (rate R) (K₀) (p+1) (e₀))
      let two:=fun U => ∑ y:T₀×T₀, WilsonThermometerAlignedCells.mass (R:=R) r (N₀) test y *
        charged R simple A hk D Q π Γ Ψ books school ahead floor y (P y) J axes p t a b U
      WilsonThermometerCompulsoryReturn.Heard R (top:=i+2) two
        ((∫x:Points 3,‖test x‖)*(C₀*g₁^(p+1))) := by
  choose P post using fun (y:T₀×T₀) => WilsonThermometerRegisteredCold.original R simple A hk D Q π Γ Ψ history
    scroll books chamber hi warm top school op lesson cal ahead hospital fund slow strip q deep aged
    late date checked near shape size space room opStage ranks width refs floor fit path pass month fits
    shelved load packed tender held fieldDate heard p surplus heat funded rootFee stencil volume J clear
    axes dw aw window shapeWindow paidWindow dp ap enrolled paid y
  refine ⟨P,?_⟩
  intro t a b ab at' bt' r test C₀ two
  let w:=WilsonThermometerAlignedCells.mass (R:=R) r (N₀) test
  let f (y:T₀×T₀):=charged R simple A hk D Q π Γ Ψ books school ahead floor y (P y) J axes p t a b
  have row (y:T₀×T₀) : Measurable (f y) ∧ (∀ U, ‖f y U‖ ≤ C₀*g₁^(p+1)) :=
    ⟨(post y t a b ab at' bt').1, (post y t a b ab at' bt').2.1⟩
  have cap:0 ≤ C₀*g₁^(p+1):=mul_nonneg (le_max_left ..) (pow_nonneg (inv_nonneg.mpr (Real.sqrt_nonneg _)) _)
  have measurable:Measurable two:=Finset.measurable_fun_sum _ (fun y _=>
    measurable_const.mul (row y).1)
  apply WilsonThermometerEarlierHearing.original R (Nat.le_add_right i 2) measurable
  intro U
  calc
    ‖two U‖ ≤ ∑ y:T₀×T₀, ‖w y*(f y U)‖:=norm_sum_le ..
    _ = ∑ y:T₀×T₀, ‖w y‖*‖f y U‖:=by simp only [norm_mul]
    _ ≤ ∑ y:T₀×T₀, ‖w y‖*(C₀*g₁^(p+1)):=Finset.sum_le_sum fun y _ =>
      mul_le_mul_of_nonneg_left ((row y).2 U) (norm_nonneg _)
    _ = (∑ y:T₀×T₀, ‖w y‖)*(C₀*g₁^(p+1)):=by rw [Finset.sum_mul]
    _ ≤ _:=mul_le_mul_of_nonneg_right (WilsonThermometerAlignedCells.variation (R:=R) r (N₀) test) cap

end YM.Integration.WilsonThermometerRegisteredIntegral
