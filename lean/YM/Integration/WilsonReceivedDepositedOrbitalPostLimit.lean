variable {start prec:ℕ}(grant:Burn.horizon prec+2≤R.alloy.B.a.clock.J start)
  (roots₀:Roots (G:=G) R.metals.p.profile R.metals.K R.metals.p.kernel)(tab:roots₀.Tab R.rolls)
  (π:ℕ→Layout G)(Γ:ℕ→Pace.Coin)(Ψ:∀i,RG.Rep G (R.family.side i run))
  (lessons:Concourse R.alloy R.kit R.T π Γ start N run prec Ψ)
  {φ:ℕ→ℕ}(books:Mentor.Offices.Books roots₀ R.rolls tab φ)(live:start≤j)
  (ahead:Mentor.Forecast roots₀ R.rolls tab φ books)(pieces:Fin n→Submodule ℝ ℂ)
  (order shelf seats:ℕ)(physical:Affinity.Wallet (room (Fin n)) → Config G (R.family.side (j+1) run) → Poly (Stock.census (Fin n)))
