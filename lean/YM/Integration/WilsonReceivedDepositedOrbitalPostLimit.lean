    order shelf seats j live physical)
local notation "pupil" => Oak.student (n:=run) R grant roots₀ tab π Γ books live Z.op Z.lesson ahead (room (Fin n)) Z.model order Z.voter
local notation "zeroFiled" => Oak.grade0 R grant roots₀ tab π Γ live Z.lesson
local notation "depth₀" => Burn.horizon prec+2
local notation "tape₀" => AllOrder.Floe.Step.tape (depth₀)
local notation "outgoing" => Mutation.stamp (pupil) (Γ j) (zeroFiled) (depth₀) order
include well hs base cover bound lessons in
theorem original [Fintype I](placed:Z.passport=P)(names:Z.modelIndex=((l:I)×((words H) l).Roster))
    (ink:HEq Z.model (mounts H))(pass:Pass roots₀ tab R.alloy R.kit)(month:Scholar.Month R.rolls roots₀ tab R.alloy.delay)
    (fits:order≤Burn.horizon prec+1)(narrow:shelf≤R.alloy.B.a.clock.J j)(retained:order≤q)
    {quiet:ℕ→SeriesA G}(course:Read R N start (Burn.horizon prec) quiet π Γ){τ cash:ℝ}
    (funded:Issued R N (j+1) (Burn.horizon prec) (quiet (j+1)) τ cash)
    (x:testRoom)(grid:Side)(multiple:(R.family.side j run).val∣grid.val)
    (tags:∀b:Covers R.family.path.levels.S j grid,(step R j b.val).Choices)
    (r d:ℕ)(small:r≤order)(kept:d≤r)(s:Multi.Hot (J))(v:Stationary.Link G grid):
    let colors:=fun b:Covers R.family.path.levels.S j grid=>copyColor (tiled R multiple b) Z.model k
      (fun a=>(Z.model a).paint x) (π (j+1)) (tape₀)
    let trees:=fun b:Covers R.family.path.levels.S j grid=>repeatF (step R j b.val)
    Tendsto (fun b=>share R grid b*Adjacent.born (fieldRow R (show j<N by omega) order grid colors trees tags s.val b)
      ((Rebirth.caliber (Γ j) (zeroFiled)).back (depth₀)) 0 r d (convey (coverWin b.prop) v))
        (coverFilter R.family.path.levels.S j grid) (𝓝 ((peek multiple (outgoing) k (π j) (tape₀) x d v).part s.val)):=by
  intro colors trees
  have highDate:j<N:=by omega
  have voted:=WilsonOriginalReceivedCopiedCover.published R grant roots₀ tab π Γ Ψ lessons books live highDate ahead
    (room (Fin n)) pieces k order shelf seats physical Z
  have settled:=WilsonOriginalRetainedStamp.original (R:=R) (hk:=grant) (course:=lessons) (cut:=highDate)
    (pass:=pass) (month:=month) (fits:=fits) (narrow:=narrow) (issued:=Z.issued.earning)
    (x:=x) (h:=multiple) (small:=small) (kept:=kept) (s:=s) (z:=v)
    (value:=fun a y=>peek multiple (pupil) k (π (j+1)) (tape₀) x a y)
    (source:=fun _ _ _=>rfl)
  have legal:Legal (tape₀) (π (j+1)):=by
    rw [Z.lesson.ticket]
    exact AllOrder.Floe.Step.PlanV.audited R.rolls roots₀ _ _ _ Z.lesson.entry
  rw [settled]
  exact WilsonReceivedDepositedOrbitalVoted.original R Y lo enrolled N X positive limit width B c inside pin deep
    y t closed tickets old well hs base cover bound Z.model placed names ink Z.salary (Poetry.Agenda.stem ..)
    legal course live funded order retained (by omega) (pupil) voted x grid multiple tags _ r d small s v

