/-- On the original compact cell the first edge has the same one-site housing as the
selected interior programme at its common earlier flat. -/
theorem original (φ:Test n){r:ℝ}(rp:0<r)(small:factor R φ*r ≤ R.family.S.a 0)
    (before:m+1 ≤ capture R φ r)(span:capture R φ r ≤ f)(fine:f ≤ j+1+1)
    (narrow:8*R.family.S.a f<R.family.S.a (capture R φ r))(z:Sites R (f,per) n)
    (occurs:WilsonCenteredCompactBooking.mass R φ r (f,per) z≠0)(early:m ≤ j)
    {b:ℕ}(bb:b ≤ capture R φ r)(live:b ≤ j+1):
    let track:=tape draw fine z
    let spots:=homes track (0:Fin n → Lattice.Cover) m (j-m)
    let o:=addresses R (j+1) per spots (onLevels draw track)
    let home:=((Passport.point o).coarser (R.family.path.levels.clock.op (j+1) per).ratio).origin
    (∀v:Fin n,sites R home live v∈({0}:Support (R.family.side b per))) ∧
      ∀B:ℕ,0<B → coverNumber B ({0}:Support (R.family.side b per)) ≤ 1:=by
  intro track spots o home
  obtain ⟨_,posted⟩:=(WilsonReceivedChronologicalFixedSites.original R φ).choose_spec.2 r rp small m f (j+1+1)
    per before span fine narrow z occurs
  have h:=posted q V draw j b early bb live le_rfl
  have points:o=fun v=>wrap (R.family.side (j+1+1) per)
      (chartIn (loose R.family.path.levels (j+1)) spots ((onLevels draw track) (j+1)) v):=
    funext (WilsonIndependentCollarCanonicalCofinalSeats.actual R (j+1) per spots (onLevels draw track))
  dsimp only [home]
  rw [points]
  exact h

end YM.Integration.WilsonAddressedPublicFirstRoseHomes
