private theorem mass_on (s:Faces):
    WilsonCoeffUV.Wheel.Mark.mass (WilsonOlderFreshSoftRoseCourse.grade ∘ seat s) Finset.univ=
      WilsonCoeffUV.Wheel.Mark.mass ages s:=by
  change (∑i:s,ages i.val)=∑i∈s,ages i
  exact Finset.sum_coe_sort s _

private theorem restored {L M:Levels G}(h:L=M)(x:Digits M (Fin 3)):
    cast (congrArg (fun q=>Digits q (Fin 3)) h) (show Digits L (Fin 3) from h.symm ▸ x)=x:=by cases h;rfl

theorem original (simple:G.Simple)(bliss:Bliss F l z H)(lead:Leading F Jr)
    (obedient:∀d:ℕ,∀ᶠr in trail,Frame.obedient F H (Jr r) d)
    (slow:WilsonWindowReportingPace.Slow R.kit)(shop:RG05Preconstruction.ReadoutPurchase R.b)
    (cap:∀j,1≤((P).budget j).supportExponent)(upper:∀j,((P).budget j).supportExponent≤100)
    (quote:OPE.Therm.Poetry (P))(color:G.ColorIndex)
    (funded:WilsonOriginalAllOrderCourse.Paid.{u} axis simple ε (prepared schedule) R crop W)
    (paths:FundedOriginalVacuumPaths.prices R.kit):
    ∃bank:ℕ,∀debt width:ℕ,∃U:Set ℝ,U∈trail ∧
    ∀(Q:ℕ),9≤Q → ∀(L:ℕ)(D:Fin 3→ℕ)(X:ℝ),0≤X → ∀ᶠv:ℕ in atTop,
    ∀{start:ℕ}{opt tol:ℝ}(_office:WilsonOriginalObservedRoseProbeShelf.Badge R D Q v start opt tol),
    ∀r∈U,∀{T:ℕ}(B:Book F (l:=l) H z 6 T r),WilsonMovingForkWindowBooks.Priced F B →
    ∀actual:Next.UVStress.Lifts (C) B.k,let K:=berth R width B.W.k
    v≤B.W.k → ∀(N per b c requested power tag:ℕ)(credit:ℝ)(bk:b≤K)(kn:K≤N),b<N →
    v≤c → c≤K → v+1≤K → σ K-σ v≤L*Real.log (β v) →
    ∀(panel:Panel R ages N per b K bk kn requested power tag credit)(file:Filed R ages K),
    panel.slot=file.station →panel.axis=file.A N per →(∀i,panel.slot i=B.W.k) →
    (∀i,panel.names i=WilsonNeutralOffsetCutoff.named R (group F Jr Z B actual) N per i) →
    let θ:=g N per v
    ∀(s:Faces),s.Nonempty →∀(κ:(i:Fin 3)→Knob (D i))(pt:Fin 3→Chamber)(cells:Digits (P) (Fin 3))
    (pins:Fin 3→ Cover)(test:Pen D s→L[ℝ]ℝ),‖test‖≤X*(θ⁻¹)^debt →
    let w:=votes R ages (N:=N) (per:=per) file panel.names panel.turn
    r^(height ages s)*‖figure R ages κ pt N per K c v cells s w pins test Q θ‖≤
      2*(θ⁻¹)^(base bank debt+(WilsonOriginalObservedRosePublicMesh.aperture width)*height ages s):=by
  classical
  obtain ⟨bank,gross⟩:=WilsonOriginalObservedRosePublicFigureGross.original F Jr Z simple bliss lead obedient slow shop cap upper quote color funded paths
  refine ⟨bank,?_⟩
  intro debt width
  obtain ⟨U,valid,offer⟩:=gross debt (WilsonOriginalObservedRosePublicMesh.aperture width)
  refine ⟨U,valid,?_⟩
  intro Q high L D X xp
  have all:=Filter.eventually_all.mpr (fun s:{s:(J).Mode // s.val.Nonempty}=>offer Q 0 high L D s.val s.property X xp)
  filter_upwards [all,WilsonOriginalObservedRosePublicMesh.original R simple slow width L] with v sale mesh
  intro start opt tol office r hr T B priced actual K vj N per b c req power tag credit bk kn deep vc ck next span P0 file
    stations axes homes names θ s active κ pt cells pins test capFee w
  have top:r/(a K)≤(θ⁻¹)^(WilsonOriginalObservedRosePublicMesh.aperture width):=calc
    _=B.W.wheel.r/(a K):=congrArg (fun x:ℝ=>x/(a K)) B.active.symm
    _≤_:=mesh B.W.k vj B.W.b B.checked.high.2 N per kn span
  have shape:(a B.W.k)≤r:=(WilsonReflectedPublicBulbBerth.mesh R B.W B.checked).trans B.active.le
  have small:(a B.W.k)/(a K)≤(θ⁻¹)^(WilsonOriginalObservedRosePublicMesh.aperture width):=(div_le_div_of_nonneg_right shape (R.family.S.a_pos _).le).trans top
  let J_s:(J).Mode:=⟨s,Finset.mem_univ _⟩
  let pressed:Digits office.field.draws (Fin 3):=office.draw.symm ▸ cells
  have same:cast (congrArg (fun q=>Digits q (Fin 3)) office.draw) pressed=cells:=restored office.draw _
  obtain ⟨crops,_,cleared⟩:=sale ⟨J_s,active⟩ office.field office.draw office.paid office.quiet office.date.le
    (mass_on s ▸ office.proper s) r hr B priced actual N per b K c req power tag credit bk kn deep vc ck next span P0 file
    stations axes homes names small top κ pt pressed pins test capFee
  dsimp only at crops cleared
  simp only [J_s,same,pow_zero,mul_one] at crops cleared
  have weight:0≤r^(height ages s):=pow_nonneg ((R.family.S.a_pos _).le.trans shape) _
  have rr:=crops Q le_rfl
  let F0:=figure R ages κ pt N per K c v cells s w pins test Q θ
  let Z0:=normalized R ages κ pt N per K c v cells s w pins test Q θ
  have triangle:‖F0‖≤‖F0-Z0‖+‖Z0‖:=by
    calc _=‖(F0-Z0)+Z0‖:=by rw[sub_add_cancel]
         _≤_:=norm_add_le .. 
  calc
    _≤r^(height ages s)*(‖F0-Z0‖+‖Z0‖):=mul_le_mul_of_nonneg_left triangle weight
    _=r^(height ages s)*‖F0-Z0‖+r^(height ages s)*‖Z0‖:=mul_add .. 
    _≤_:=by rw[two_mul];exact add_le_add cleared rr

