/-- One genuine receipt and one fixed winding menu serve the entire ordinary subset. -/
def original (F:Ptype)(B:voucher F)
    (receipt:WilsonOriginalCensusCanonicalFiledClock.Returns R hk D Q π Γ Ψ books (Nat.le_succ_of_le base)
      op ahead d q hd (o) order shelf F B)
    (pt:Fin n→Chamber)(x:Wallet (A))
    (tags:∀b:Covers R.family.path.levels.S (j+1) (coarse R (j+1) per),(step R (j+1) b.val).Choices)
    {length:ℕ}{σ₀:ℝ}(L:Material R N (j+1) length d σ₀ (binder (coarse R (j+1) per) y))
    (active:Addressed y L (present L.tests))
    (matched:∀z S₁,output L.prior S₁ N z=fixed R d (fun v=>contact (L.tests v))
      pt N ((j+1)+1) (j+1) cells q z S₁)
    (lowPlaced:(lo).passport=port (coarse R (j+1) per) y)
    (lowNames:(lo).modelIndex=((z:Multi.Hot (marks))×(words L z).Roster))(lowInk:HEq (lo).model (mounts L))
    (graded:lower.grades=d)(wallet:lower.x=x)
    (positive:0<Poetry.Agenda.seed D φ (Burn.horizon k) (R.alloy.B.a.clock.J (j+1)))
    (s:(marks).Mode)(front:(t:Multi.Hot (marks))→t.val.val)
    (charges:Fin n→ℕ)(tube:LinkTube G)(target power E cap depth breadthCap:ℕ)(outputTolerance windingFee:ℝ)
    (enough:cap≤depth+1)(highCap:depth≤order)(lowCap:depth≤length)
    (paid:WilsonIndependentCollarCanonicalRelativeMenu.Paid R d (fun v=>contact (L.tests v))
      pt depth breadthCap (present L.tests) windingFee (j+1) per)
    (near:∀t:Multi.Hot (marks),t.val.val⊆s.val→
      breadth t.val.val (front t).val 0 (relative t.val.val (front t).val y)≤breadthCap)
    (budget:∀t:Multi.Hot (marks),t.val.val⊆s.val→WilsonOriginalSparseDatedFinance.Budget R hk D Q π Γ Ψ
      books base ahead _ inLow (file F B x) lower t charges tube target outputTolerance power E windingFee cap):
    ∀t:Multi.Hot (marks),t.val.val⊆s.val→WilsonOriginalSparseCensusEdge.Face R hk D Q π Γ Ψ
      books base ahead _ inLow (file F B x) lower t (front t).val charges tube target outputTolerance:=by
  intro t own
  apply WilsonOriginalCensusCanonicalSparseFace.printed R hk D Q π Γ Ψ books base ahead _ inLow (file F B x) lower
    t (front t).val charges tube target outputTolerance power E windingFee cap depth enough (budget t own)
  intro e he Y unit
  have salary:Scene.Armada (lo).model (lo).w d (Poetry.Agenda.seed D φ (Burn.horizon k) (R.alloy.B.a.clock.J (j+1))) (lo).cost lower.order (lo).op.count lower.shelf:=by
    rw [←graded]
    exact (lo).salary
  have earned:=WilsonIndependentCollarCanonicalRelativeFare.original R simple hk D Q π Γ Ψ books (Nat.le_succ_of_le base)
    cut op ahead d q hd y cells order shelf F B receipt L active pt x t (front t) Y e e (he.trans highCap) le_rfl
    tags paid (near t own) he unit matched (lo).model lowPlaced lowNames lowInk salary positive (he.trans lowCap)
  simpa only [graded,wallet,WilsonOriginalCensusCanonicalFiled.file] using earned
end YM.Integration.WilsonIndependentCollarCanonicalRelativeFaces
