variable {Df kept:ℕ}(color:hue G)(depth:d<Df){U:ℕ→ℕ}(grant:WilsonWindowFormalPurchase.Canonical U R.kit)
local notation "grid"=> R.family.side i per
local notation "V₀"=> R.family.path.levels
local notation "A₀"=> destination R.family.path.levels N i
local notation "wood"=> (fun j:ℕ=>Flat.routes ((V₀).clock.op j 0).patch)
variable {passport:Earn.Passport (R.family.side (i+1) per) Unit}(S:Earn.Binder passport (Stock.census Unit))
    {σ:ℝ}(T:WilsonOlderFreshGraphSlate.Copy G d kept σ)
    (b:Letter (R.family.labels.level d))(f:Studio Df)
local notation "charted" => WilsonElectedPrimaryTensor.chart R wood color depth (i+1) b (⟨N,cut⟩,f)

include course grant in
theorem original (id:P.passport=passport)(names:P.modelIndex=T.Roster)(rows:HEq P.model (T.rows S actors))
    (cap:∀t,‖WilsonOlderFreshGraphArmada.value actors t‖≤1)(width:0<σ)(earned:Matched T charted)
    (hs:G.Simple)(o:Loc G 1)(v:ℕ→Gear G→ℝ)(funded:FundedMarkedCoverRows.prices v R.kit)
    {Z:ℕ→SeriesA G}(quiet:Read R N m (Burn.horizon k) Z π Γ)
    {μ cash₀:ℝ}(bank:Issued R N (i+1) (Burn.horizon k) (Z (i+1)) μ cash₀)
    (legal:Legal tape (π (i+1)))(working:order≤kept)(hr:order≤Burn.horizon k+2)(hd:d≤(V₀).clock.J (i+1))
    (arm:Wallet actors)(j:ℕ)(hj:j≤order)(B:Stationary.Link G grid):
    let z:=WilsonOriginalPrimerFiledPages.sites S.center (grid*(A₀).L)
    let r:Ratio grid (grid*(A₀).L):=Ratio.mk (A₀).L rfl
    let w:=Primer.densityCoeff R.family wood color N (i+1)
    let Y:=Primer.fieldCoeffs R.family color wood depth N (i+1) b f
    let lower:=Kemp.braise A₀ (wood i) w (Kemp.work (lift (r.residue z)) Y) R.metals.O ((V₀).blocks i 0).branches d
    (peek dvd_rfl student (fun _=>d) (π (i+1)) tape arm j B).part (submitted S).val=
      WilsonOlderFreshGraphArmada.value actors arm*
      (MvPolynomial.eval (FreeResolvent.flatten (Stationary.arm G grid 1 B) ∘ Lotus.tint (r.parent z))
        (coeff j (Kemp.banner d lower grid)):ℝ):=by
  intro z r w Y lower
  let F (c:Covers (V₀).S i grid):Forest ((V₀).clock.op i c.val).ratio:=Classical.arbitrary _
  let tag (c:Covers (V₀).S i grid):((V₀).clock.op i c.val).Choices:=Classical.arbitrary _
  let tags (h:ℕ)(n:Side):(primary ((V₀).clock.op h 0).patch (V₀).clock.kernel n).Choices:=Classical.arbitrary _
  obtain ⟨F',_,copies⟩:=WilsonOriginalStampedPrimerCover.original R color depth grant N i per cut b f S
    actors arm P.model T id names rows cap width earned tags hs v funded order working hr quiet hi bank legal F
  let u (c:Covers (V₀).S i grid):(primary (A₀).patch (V₀).clock.kernel (R.family.side i c.val)).Choices:=Classical.arbitrary _
  exact WilsonNeutralMeasuredChildPupil.fixed R hk D Q π Γ Ψ course books hi cut ahead actors pieces (fun _=>d)
    order shelf seats physical P wood color depth grant hs o hd F tag F' u b f z arm (submitted S)
    (WilsonOlderFreshGraphArmada.value actors arm) j hj B (.of_forall (copies u tag j hj B))

