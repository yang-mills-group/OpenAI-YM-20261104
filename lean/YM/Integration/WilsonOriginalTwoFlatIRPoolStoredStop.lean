def classroom (R:Run G)(earned:ℕ):ℕ:=
  (WilsonReceivedChronologicalFixedReserve.terms ages (fun _=>0)
    (WilsonAddressedPublicFirstRoseTerms.order R earned+1)).order

/-- These are the actual class and plan originally booked on the selected course. -/
def owns (simple:G.Simple)(funded:WilsonOriginalAllOrderCourse.Paid.{u} axis simple ε (prepared schedule) R crop W)
    (φ:Test 3)(D:Fin 3→ℕ)(pt:Fin 3→Chamber)(caps:Fin 3→ℝ)(paid:∀i,‖present D i‖ ≤ caps i)
    (tol η:ℝ)(tp:0<tol)(ep:0<η){I:Type}[Fintype I]
    (teacher:ℕ)(tube:Comparison.Density.Transport.LinkTube G)(pieces assignment:ℕ)(orders:Bool→ℕ)
    (sizes:I→ℕ)(tariff:I→Bool→ℕ)(goal physical votes mesh pole earned:ℕ)(M:Fin 3→ℝ)(plan:Plan 3):
    Holding R (classroom R earned):=fun Vc drawc {_ _ _ _} old fk r deposited=>
  ∃training:ℝ,1 ≤ training ∧
    (let tuition:=capital R 6 (max 1 (4*∑i,M i))
     let price:=WilsonReceivedChronologicalFixedRoseEnrolledCash.roof training caps
     let hired:=WilsonAddressedPublicFirstRoseTerms.order R earned
     plan=WilsonReceivedChronologicalFixedRoseOriginalAccount.budget ages (fun _=>0) (hired+1)
       plan.width pole hired (entrance goal physical) earned 1 (terminal goal physical votes mesh) 1 tuition price 100 η η price) ∧
    WilsonReceivedChronologicalFixedRoseGridWitness.Occupied (R:=R) (simple:=simple) (funded:=funded)
      (role:=id) (lens:=D) (pt:=pt) (caps:=caps) (covered:=paid) (φ:=φ)
      (requestedClass:=earned) (A:=plan.width) (tol:=tol) (θ:=η) (tp:=tp) (ep:=ep)
      (teacher:=teacher) (tube:=tube) (pieces:=pieces) (groundPrice:=assignment)
      (pole:=orders) (span:=sizes) (lag:=tariff) (training:=training) (V:=Vc) (draw:=drawc)
      (old:=old) (r:=r) fk deposited

theorem original (simple:G.Simple)
    {master:EveryPhase.Almanac F}{reader:Orbits.Reader F.sector.derivatives F.sector.turns F.room.kernel.spin}
    {cohort:Ultrafilter (ℕ×ℕ)→Prop}
    (selected:WilsonViewerElectedHierarchy.Selected.{u} F master reader Jr H z l simple cohort)
    (birth:WilsonPhysicalAllGradeWeakElection.Assignment F Jr H l simple)
    (slow:WilsonWindowReportingPace.Slow R.kit)(shop:RG05Preconstruction.ReadoutPurchase R.b)
    (κ₀:ℕ)(positive:0 < κ₀)(ratio:Z.run.ratio=(3:ℕ)^κ₀)(T h:ℕ)
    {δ:ℝ}(dp:0 < δ)(books:(s:{s:ℝ//0 < s ∧ s < δ})→Book F (l:=l) H z 6 T s.val)
    (same:∀r,∃live:6 ≤ (birth.day r.val).1,WilsonPhysicalWeakWallBooks.Shared F (books r)
      (WilsonPhysicalWeakSameStation.trim live (birth.day r.val).2))
    (stage:ℕ)(color:G.ColorIndex)(paths:FundedOriginalVacuumPaths.prices R.kit)
    (bank:WilsonThermometerClusterProjectionBudget.Ready (P))(lamp:WilsonReportLampForecast.Ready (P))
    (extra:∀i:Fin 3,(Spin.comparator (C).book).Field (grade i).val)
    (funded:WilsonOriginalAllOrderCourse.Paid.{u} axis simple ε (prepared schedule) R crop W):
    ∃(ledger t:ℕ)(M:Fin 3→ℝ)(E:Fin 3→ℕ)(physical votes apron:ℕ),9 ≤ t ∧ (∀i,1 ≤ M i) ∧
    ∀(goal:ℕ)(_ : 4+3*WilsonOriginalObservedRosePublicGross.base ledger 1 ≤ goal),
    let debt:ℕ:=0
    let requested:=request goal physical E
    let power:=debit goal physical E
    let reserve:=depth ((2*power+∑i,E i)+1) (WilsonAddressedMixedStationRange.width T h) 6
    let mesh:=2*T+11+2*h+reserve+1
    let pole:=(∑i,E i)+WilsonAddressedMixedRawTrial.power T h reserve 6
    let J₀:=cut goal votes debt mesh
    let Q:=print goal physical votes debt mesh 1
    let stopOrder:=WilsonOlderFreshSoftSocketStationSevenPower.order 3
      (WilsonOriginalObservedRosePublicGross.base ledger 1) (WilsonOriginalObservedRosePublicMesh.aperture mesh)
    let charge:=loss R pole stopOrder
    J₀+9 ≤ Q ∧ ∃reach:ℕ,∀{I:Type}[Fintype I](D:Fin 3→ℕ)(pt:Fin 3→Chamber)(caps:Fin 3→ℝ),
    ∀(_paid:∀i,‖present D i‖ ≤ caps i)(_dims:∀i,ages i < D i)(tol η:ℝ)(_tp:0 < tol)(_ep:0 < η),
    ∀(_teacher:ℕ)(_tube:Comparison.Density.Transport.LinkTube G)(_pieces _assignment:ℕ)(_orders:Bool→ℕ)
    (_sizes:I→ℕ)(_tariff:I→Bool→ℕ)(sourceFloor fileTariff:ℕ),
    let earned:=middle R goal physical votes debt mesh 1 pole
    let infrared:=max (crossed ages earned) (4*(2*⌈charge⌉₊+1))
    ∃plan:Plan 3,Issued R plan pole (WilsonAddressedPublicFirstRoseSchedule.allowance R simple slow T h reserve infrared)
      earned (entrance goal physical) (terminal goal physical votes mesh) caps (capital R 6 (max 1 (4*∑i,M i))) η ∧
      plan.Affords (demand goal physical) (2*votes) (WilsonOriginalObservedRosePublicMesh.aperture mesh) 14 ∧
    let wStop:=date R reach charge
    Tendsto wStop atTop atTop ∧ ∃day onset:ℕ,∃school:(v:ℕ) → onset ≤ v → Badge R D Q v day 1 tol,
    ∃floor:ℕ,After F Jr Z books reserve infrared requested t sourceFloor fileTariff apron J₀ Q M D pt tol plan
      wStop day onset school floor (classroom R earned)
      (owns simple funded roseTest D pt caps _paid tol η _tp _ep _teacher _tube _pieces _assignment _orders
        _sizes _tariff goal physical votes mesh pole earned M plan) :=by
  classical
  have lo (j:ℕ):1 ≤ ((P).budget j).supportExponent:=by rw [funded.support j];norm_num
  have hi (j:ℕ):((P).budget j).supportExponent ≤ 100:=by rw [funded.support j]
  have windows:∀s,WilsonMovingForkWindowBooks.Priced F (books s):=fun s=>(same s).choose_spec.1.1
  obtain ⟨ledger,registration⟩:=WilsonOlderFreshSoftSocketOriginalWorkshop.original F Jr Z roseTest simple
    selected.bliss selected.leading selected.obeys slow shop lo hi color funded paths T h books windows publicHead
  obtain ⟨t,M,E,physical,votes,apron,tn,one,origin⟩:=WilsonOriginalTwoFlatIRPoolCertified.original F Jr Z
    simple selected birth slow shop κ₀ positive ratio T h dp books same stage color paths bank lamp extra funded
  refine ⟨ledger,t,M,E,physical,votes,apron,tn,one,?_⟩
  intro goal fit debt requested power reserve mesh pole J₀ Q stopOrder charge
  have small:2 ≤ goal:=by omega
  obtain ⟨retained,contact⟩:=origin goal debt small
  obtain ⟨reach,station⟩:=registration reserve
  have gradePay:WilsonOlderFreshSoftSocketStationAbsoluteWages.degree 3 ledger 0
      (WilsonOriginalObservedRosePublicMesh.aperture mesh) ≤ J₀:=by
    dsimp only [WilsonOlderFreshSoftSocketStationAbsoluteWages.degree,J₀,WilsonOriginalObservedRosePublicConnected.cut,debt]
    change 3+(3*WilsonOriginalObservedRosePublicGross.base ledger 1+WilsonOriginalObservedRosePublicMesh.aperture mesh*14)+1 ≤ goal+(3*WilsonOriginalObservedRosePublicGross.base votes 0+WilsonOriginalObservedRosePublicMesh.aperture mesh*14)+1
    omega
  refine ⟨retained,reach,?_⟩
  intro I inst D pt caps paid dimensions tol η tp ep teacher tube pieces assignment orders sizes tariff sourceFloor fileTariff earned infrared
  obtain ⟨plan,issued,affords,entry⟩:=contact D pt caps paid dimensions tol η tp ep teacher tube
    pieces assignment orders sizes tariff charge sourceFloor fileTariff
  obtain ⟨grows,day,onset,school,floor,enter,rows⟩:=station plan J₀ Q gradePay retained D dimensions caps paid tol tp
  have officeDate:loss R plan.pole stopOrder=charge:=by rw [issued.1]
  have ng:0 ≤ charge:=by dsimp [charge,WilsonOlderFreshSoftSocketStationPanelPower.loss];positivity
  have deep:8*(2*⌈charge⌉₊+1) ≤ 2*infrared:=by
    dsimp only [infrared];omega
  refine ⟨plan,issued,affords,?_,day,onset,school,floor,?_⟩
  · change Tendsto (date R reach (WilsonOlderFreshSoftSocketStationPanelPower.loss R plan.pole stopOrder)) atTop atTop at grows
    simpa only [officeDate] using grows
  let custody:=owns simple funded roseTest D pt caps paid tol η tp ep teacher tube pieces assignment orders
    sizes tariff goal physical votes mesh pole earned M plan
  have kept:Before F Jr Z books reserve infrared requested t sourceFloor fileTariff apron J₀ Q M D pt tol plan
      (classroom R earned) custody:=by
    intro level positiveLevel
    obtain ⟨band,staff⟩:=entry level positiveLevel
    refine ⟨band,?_⟩
    filter_upwards [staff] with base staffed
    obtain ⟨u₀,oldEnough,stop,move,shelf,rooms⟩:=staffed
    refine ⟨u₀,oldEnough,stop,move,shelf,?_⟩
    filter_upwards [rooms] with anchor room
    obtain ⟨Vc,drawc,rent,year,read⟩:=room
    refine ⟨Vc,drawc,rent,year,?_⟩
    intro margin mp
    filter_upwards [read margin mp] with r observed
    intro ρ equal f K c slots
    obtain ⟨w,placed,due,old,cross,upper,fk,floorDate,opened,ticket,V,draw,cost,code,epoch,cover,stock,
      src,srcFloor,exposed,front,deposited,training,one,price,occupied,sale⟩:=observed ρ equal
    exact ⟨w,placed,due,old,cross,upper,fk,floorDate,opened,ticket,V,draw,cost,code,epoch,cover,stock,
      src,srcFloor,exposed,front,deposited,⟨training,one,price,occupied⟩,sale⟩
  apply WilsonOriginalTwoFlatIRPoolStoredCampus.original F Jr Z simple slow books reserve infrared requested t sourceFloor fileTariff apron
    J₀ Q M D pt tol plan reach charge ng deep day onset school floor enter _ (classroom R earned) custody kept
  rw [← officeDate]
  exact rows


end YM.Integration.WilsonOriginalTwoFlatIRPoolStoredStop
