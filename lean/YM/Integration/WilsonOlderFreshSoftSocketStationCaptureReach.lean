theorem original (Φ:Test 3)(simple:G.Simple)(bliss:Bliss F l z H)
    (slow:WilsonWindowReportingPace.Slow R.kit)(T h reserve:ℕ){δ:ℝ}
    (books:(t:{t:ℝ // 0<t ∧ t<δ})→Book F (l:=l) H z 6 T t.val):
    ∃reach:ℕ,∀ᶠr in trail,∀ρ:Fin 3→{t:ℝ//0<t ∧ t<δ},
      (∀i,r≤(ρ i).val ∧ (ρ i).val≤outer z h r) → (∃i,(ρ i).val=r) →
      let b:=reporter F books ρ
      let K:=WilsonInvariantActionPosition.berth R reserve b
      let c:=capture R Φ r
      c≤b → (a c)/(a K)≤((P).clock.hatBeta c)^reach:=by
  let trust:=2*T+11+2*h
  obtain ⟨reach,priced⟩:=WilsonMovingForkOpticalStops.original R simple slow reserve (trust+2) 0
  refine ⟨reach,?_⟩
  let M:=factor R Φ
  have positive:0<M:=WilsonReceivedChronologicalFixedCellFee.positive R Φ
  have chart:=WilsonOriginalTwoFlatPublicMixedMesh.original F simple bliss slow 6 T h grade books
  obtain ⟨floor,clock⟩:=eventually_atTop.mp priced
  obtain ⟨onset,heat⟩:=eventually_atTop.mp ((hat_rate (P) simple).eventually_ge_atTop (max (3*M) 2))
  have dates:=WilsonAddressedPublicFirstRoseMovingDate.cofinal R Φ
  filter_upwards [chart,dates.eventually_ge_atTop (max floor onset),
    Ioc_mem_nhdsGT (div_pos (R.family.S.a_pos 0) positive)] with r panel late small
  intro ρ sold nearest b K c cb
  have cf:floor≤c:=(le_max_left _ _).trans late
  have co:onset≤c:=(le_max_right _ _).trans late
  have cp:0<r:=small.1
  have room:M*r≤a 0:=by simpa only [mul_comm] using (le_div_iff₀ positive).mp small.2
  obtain ⟨i,center⟩:=nearest
  have quoteR:r≤((P).clock.hatBeta b)^trust*a b:=center ▸ (panel ρ sold ⟨i,center⟩).2 i
  have ab:(a c)/(a b)≤((P).clock.hatBeta b)^(trust+2):=WilsonAddressedPublicFirstRoseCaptureWidth.original R
    simple slow cp positive cb (WilsonCloseCaptureDate.bracket R.family.S (mul_pos positive cp) room).1
    ((le_max_left _ _).trans (heat b (co.trans cb))) quoteR
  have hc:(2:ℝ)≤(P).clock.hatBeta c:=(le_max_right _ _).trans (heat c co)
  have band:((P).clock.hatBeta c)/2≤(C).path.β c 0 c:=(R.makes.wilson.represents c 0 c le_rfl).band.1
  have beta:1≤(C).path.β c 0 c:=by linarith only [hc,band]
  have money:1≤(g c 0 c)⁻¹:=by
    change 1≤((Real.sqrt ((C).path.β c 0 c))⁻¹)⁻¹
    rw [inv_inv];exact Real.one_le_sqrt.mpr beta
  exact (clock b (cf.trans cb) c c c 0 cb le_rfl le_rfl ab
    (by simp only [sub_self,Nat.cast_zero,mul_zero,zero_add,mul_one]; exact mul_nonneg (by norm_num) (Real.log_nonneg money))).1

end YM.Integration.WilsonOlderFreshSoftSocketStationCaptureReach
