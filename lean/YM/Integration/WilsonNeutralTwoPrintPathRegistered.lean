variable {G:Gauge}{n:ℕ}{k D:Fin n→ℕ}(R:Run G)(κ:(v:Fin n)→Knob (D v))(pt:Fin n→Chamber)

set_option maxHeartbeats 1800000 in
theorem original (simple:G.Simple)(quiet:WilsonReceivedCloseFundedHeat.Quiet R)
    (price:ℕ→Gear G→ℝ)(funded:FundedMarkedCoverRows.prices price R.kit)(e:ℕ):
    ∃(A:ℝ)(one:1 ≤ A), ∀ᶠj:ℕ in Filter.atTop,∃ν B:ℝ,0<ν ∧ 1≤B ∧
    ∀(Y:Realm G (e+1) Credit.leanC)(lo:Y.anchor≤j)(same:Y.draws=R.family.path.levels),Y.paid=R.metals.O →
      (Y.mint (j+1) (by omega)).σ≤1 → ∀(S:Finset (Fin n))(cells:Digits R.family.path.levels (Fin n))
      (q:(v:Fin n)→Choice R k v),∃X:Input Y lo S k D A,
    X.offsets=(fun _=>parcel R same cells j) ∧
    (∀N y J,output X J N y=WilsonReceivedFixedDigitCanonical.fixed R k κ pt N (j+1) j cells q y J) ∧
    ∀(δ σ:ℝ)(width:0<σ)(enrolled:Paid R Y lo D k δ σ)
      (_closed:Cloze D k Y Credit.leanC)(_tickets:Insure n (mass k univ) Y Credit.leanC)
      (N:ℕ)(live:j<N)(per:ℕ)(J:Finset (Fin n))(c:Fin n)(inside:J⊆S)(pin:c∈J)(deep:0 < mass k J)
      (o:Cover)(t:Case D)(u:Frill J c)
      (_room:4*crestCard (toe J c o u) J<(R.family.side j per).val)
      {pp:Passport (R.family.side j per) Unit}{marks:Marker.Census Unit}(site:Binder pp marks)
      (actors:Unit→Set ℂ)(_bounded:∀x,‖value actors x‖≤1)(x:Affinity.Wallet actors)
      (layout:Layout G)(tape:Finset Age)(h:ℕ)(_through:h≤e)(direction:Link G (R.family.side j per)),
    let n₀:=R.family.side j per
    let T:=WilsonOlderFreshConnectedBirth.issued R Y lo enrolled N c X inside pin (zero_le_one.trans one)
      live deep width.le o t u
    let independent:=WilsonReceivedFixedDigitCanonical.fixed R k κ pt N (j+1) j cells q (toe J c o u) J
    let cover:Gen ℝ (Woods G n₀):=fun r z=>(touch t J) (Carp.plume (independent.2 h r) n₀ (jog (wrap n₀ o) ∘ z))
    let finite:Gen ℝ (Woods G n₀):=fun r z=>(touch t J) (independent.1 n₀ h r (jog (wrap n₀ o) ∘ z))
    (peek dvd_rfl (T.rows site actors) (fun _=>mass k J) layout tape x h direction).part
      (WilsonNeutralRenderedColumn.submitted site).val=
      value actors x*Complex.ofReal (diagonal (mass k J+h) cover (direction ∘ jog site.center)) ∧
    ∀r (w:(Fin r→Woods G n₀)→ℝ),
      |∑z,w z*(cover r z-finite r z)| ≤ ∑z,|w z| * bill (G:=G) c o t u r ν (B^J.card) z:=by
  obtain ⟨A,one,finance⟩:=WilsonNeutralTwoPrintPathFixed.original (d:=k) R κ pt simple quiet price funded e
  refine ⟨A,one,?_⟩
  filter_upwards [finance] with j clock
  obtain ⟨ν,B,hs,hB,bought⟩:=clock
  refine ⟨ν,B,hs,hB,?_⟩
  intro Y lo same coins wage S cells q
  obtain ⟨X,digits,_,receipt,source⟩:=bought Y lo same coins wage S cells q
  refine ⟨X,digits,receipt,?_⟩
  intro δ σ width enrolled closed tickets N live per J c inside pin deep o t u room pp marks site actors bounded x layout tape h through direction
  dsimp only
  rw [←receipt]
  constructor
  · exact WilsonNeutralTwoPrintPathPlaced.original R Y lo enrolled N c X inside pin (zero_le_one.trans one)
      live deep width.le o t u site actors bounded x width closed tickets layout tape h through direction
  · intro r w
    rw [←Real.norm_eq_abs]
    apply (norm_sum_le _ _).trans
    apply Finset.sum_le_sum
    intro z _
    rw [Real.norm_eq_abs,abs_mul]
    exact mul_le_mul_of_nonneg_left (WilsonNeutralTwoPrintPathQuoted.coefficient Y lo N c X pin o t u
      h r hs room (source N live per _ J h through r) z) (abs_nonneg _)

end YM.Integration.WilsonNeutralTwoPrintPathRegistered
