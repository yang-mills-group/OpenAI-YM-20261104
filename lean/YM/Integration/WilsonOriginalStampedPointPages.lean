local notation "charted" => WilsonOlderFreshPointChart.chart R wood a depth (i+1) letter (ticketₚ)
variable {n:Side}(h:n.val∣(fine R i per).val){P P':Earn.Passport n Unit}
variable {H:Marker.Census Unit}(S:Earn.Binder P H)(E:Unit→Set ℂ)(x:Affinity.Wallet E)
variable {I:Type}(M:I→Earn.Row P' H G (Affinity.Wallet E))
variable {σ:ℝ}(C:WilsonOlderFreshGraphSlate.Copy G d Q σ)

include grant in
theorem appointed (passport:P'=P)(names:I=C.Roster)(rows:HEq M (C.rows S E))
    (cap:∀t,‖value E t‖≤1)(σ0:0<σ)(filed:WilsonOlderFreshPointCommission.Published R wood a depth (i+1) letter (ticketₚ) C)
    (tags:∀j n,(primary ((V).clock.op j 0).patch (V).clock.kernel n).Choices)
    (simple:G.Simple)(v:ℕ→Gear G→ℝ)(funded:FundedMarkedCoverRows.prices v R.kit)
    {m e:ℕ}(r:ℕ)(hr:r≤Q)(height:r≤e+2)
    {Z:ℕ→SeriesA G}{π:ℕ→Layout G}{Γ:ℕ→Pace.Coin}(course:Read R N m e Z π Γ)(lo:m ≤ i)
    {μ cash:ℝ}(bank:Issued R N (i+1) e (Z (i+1)) μ cash)(legal:Legal (Step.tape (e+2)) (π (i+1)))
    (F:Forest (S₀).ratio):
    ∃F':Forest (Flat.primary (P₀).patch (V).clock.kernel n₀).ratio,HEq F F' ∧
    ∀(t:(Flat.primary (P₀).patch (V).clock.kernel n₀).Choices)(tag:(S₀).Choices)(B₀:Link G n₀),
    let Y:=copyColor h M (fun _=>d) (fun j=>(M j).paint x) (π (i+1)) (Step.tape (e+2))
    let B:=Stationary.arm G n₀ 1 B₀
    let raw:=Bulk.Fk (model R N i per hi) F tag Y B r
    let readings:=∑u:Fin (Pages n f₀),WilsonNeutralPointAngle.reading R wood a depth digit N i n₀ F' t letter f
      (sites (page h S.center u).val (n₀*(P₀).L))
    let field:=observed (FreeResolvent.flatten B) readings
    let term:=token H r (submitted S).val*(value E x • register H r field)
    ratio raw=1+term ∧ logMarked raw=term ∧ ∀j≤r,
      (Order.observe H r (logMarked raw) j).part (submitted S).val=value E x*((coeff j field:ℝ):ℂ):=by
  obtain ⟨F',Fid,hinge⟩:=WilsonOriginalPointFiledPages.original R a depth digit grant N i per hi
    tags simple v funded F
  refine ⟨F',Fid,?_⟩
  intro t tag B₀ Y B raw readings field term
  let T:=located h S.center (charted f₀)
  have parts:=WilsonOlderFreshPointChart.admitted R wood a depth (i+1) letter (ticketₚ)
  have sp:=sheets h S.center (charted f₀) (fun z=>(parts f₀ z).1) (fun z=>(parts f₀ z).2)
  have echo:=WilsonOlderFreshPointRay.original C R wood a depth N i per hi digit letter f F h S E x M
    passport names rows cap σ0 (π (i+1)) (Step.tape (e+2)) filed r hr B
  have well:Bulk.Well Y:=by
    subst P'
    subst I
    cases eq_of_heq rows
    have staff:=WilsonOriginalPrimerCourseRead.salary S C.roll C.fare σ C.paid C.legal C.positive E cap x σ0
    exact (copy_standard h (C.rows S E) (fun _=>d) (fun j=>((C.rows S E) j).paint x)
      (π (i+1)) (Step.tape (e+2)) staff legal).1
  have src:flash (WilsonOriginalFoldedMarkedRightColumn.filed R N i per F d T)=readings:=
    hinge t letter f (fun u:Fin (Pages n f₀)=>(page h S.center u).val)
  have exactRead:=WilsonOriginalEarnedUnarySheet.normalized R N i per hi F tag Y B₀ (submitted S) (value E x) T r
    simple d height sp.1 sp.2.1 course lo bank well echo
  change ratio raw=1+token H r (submitted S).val*(value E x • register H r (observed (FreeResolvent.flatten B) readings)) ∧
    logMarked raw=token H r (submitted S).val*(value E x • register H r (observed (FreeResolvent.flatten B) readings)) ∧ _
  rw [←src]
  refine ⟨exactRead.1,exactRead.2,?_⟩
  intro j hj
  have projected:=WilsonOriginalEarnedUnarySheet.projected R N i per hi F tag Y B₀ (submitted S) (value E x) T r
    simple d height sp.1 sp.2.1 course lo bank well echo j hj
  change _=value E x*((coeff j (observed (FreeResolvent.flatten B) readings):ℝ):ℂ)
  rw [←src]
  exact projected

end YM.Integration.WilsonOriginalStampedPointPages
