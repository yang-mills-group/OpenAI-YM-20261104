theorem original {G:Gauge}{H:Hol G}{D k u a e n:ℕ}{F:Labels.Frame G 4}{T:SectionData F}{p:4<D}{v:Rails 4 k (u+a) e}
    (Y:CutsP H T p v C C C C)(m:ℕ)(arms:Fin (n+1)→SealR G)(Q:SealR G)(α:Wilt arms)(X:Herit arms)
    (C₀ C₁ C₂ first shape chron middle ledger pay thermal:Credit)(u':ℕ)(x:Verse F)
    (Φ:Rarity D)(ψ χ:Rarity Q.D)(hΦ:ContDiff ℝ ∞ Φ.ψ.val)(hψ:ContDiff ℝ ∞ ψ.ψ.val)(hχ:ContDiff ℝ ∞ χ.ψ.val)
    (sold:Tariff Y m arms α X Q C₀ C₁ C₂ first shape chron middle ledger pay thermal 5 u' x Φ ψ χ hΦ hψ hχ)
    (born:Y.ceilC=m)(older:ℕ)(live:Y.vesselsC.anchor ≤ older)(ear:older ≤ Y.m)(Z:Q.Rider)(r δ₀ δ₁ DF:ℝ)(B:Fin (n+1)→ℝ)
    (clear:Clear Y.vesselsC arms Q α ψ older Y.m Y.ceilC m r δ₀ δ₁ DF B)
    (y gap out A L bound:ℝ)(o:CellR)(w:Fin 0→YForest G)
    (amp:Amplitude Φ A)(sep:ClearDay Φ χ gap)(lo:0<gap)(nearBox:Φ.radius+|y|+1 ≤ out)(farBox:χ.radius+|y|+1 ≤ out)
    (reach:1 ≤ L)(bracket:L/paceT Y.ax.S m Y.m ≤ bound)
    (far:PassportC H Y.vesselsC Q C C)(J:ℕ)(g:ℝ)(pos:0≤g)(small:g≤1):
    let T':=paceT Y.ax.S m Y.m
    let ρ:=L/T'
    let ε:=paceT Y.ax.S Y.m Y.ceilC
    let S:=WilsonSeparatedPrefixMovingJointSpectrum.transformed ψ hψ
    let early:=(5*radiusH Φ ε y)^4*A*frontPrice Y.vesselsC arms Q X Z first shape chron middle 5 older Y.m Y.ceilC m r δ₀ δ₁ DF B
    let near:=|bill Y Q C₀ C₁ C₂ Φ χ Z y gap out older|
    let cohorts:=allowance Y Q Z ledger pay thermal older u' out gap
    let late:=(near+cohorts)*(salary Φ χ hΦ hχ*(∫ξ:Euclid,(1+‖ξ‖^(D+Q.D))*‖S ξ‖))
    let price:=tab bound early late
    let bornRow:=fun q=>raw Y.vesselsC arms Q α ψ X Z Φ y o Y.m m Y.ceilC older Y.N q 0 w
    let c:=inputs Y x m older
    let M:=film Y Q Φ χ Z y o older w S
    ‖(Complex.ofReal (ρ^4))*measured e g (PowerSeries.mk bornRow)-
       ∑j,measured e g (c j)*((Complex.ofReal (ρ^4))*measured e g (M j))‖ ≤
      ((J+1:ℕ):ℝ)*(L^(-((4:ℝ)+1/4))*price) + (e+1:ℕ)*(g^(J+1)*(L^(-(4:ℝ))*price))+
      |ρ^4| *(2*|g|^(e+1)*annulus Y Q Φ χ Z y o m older e x w S):=by
  classical
  intro T' ρ ε S early near cohorts late price bornRow c M
  have bought:=WilsonSeparatedPrefixMovingPinnedPhysical.original Y m arms Q α X C₀ C₁ C₂ first shape chron middle
    ledger pay thermal u' x Φ ψ χ hΦ hψ hχ sold born older live ear Z r δ₀ δ₁ DF B clear y gap out A L bound
    o w amp sep lo nearBox farBox reach bracket
  obtain ⟨_,rfl,stock,_⟩:=WilsonSeparatedPrefixMovingJointSpectrum.declared ψ hψ
  let f:=fun q=>bornRow q-∫ξ:Euclid,tested Y Q Φ χ Z y o m older q x w S true ξ
  let scalar:=fun q=>ρ^4*f q
  have head (q:ℕ)(hq:q≤e)(_hj:q≤J):‖scalar q‖≤L^(-((4:ℝ)+1/4))*price:=by
    simpa only [pow_zero,inv_one,one_mul] using (bought.2.1.1 q hq)
  have smallRow:=WilsonMovingForkSharpThermalSplit.original e J g scalar (L^(-((4:ℝ)+1/4))*price)
    ((e+1:ℕ)*(g^(J+1)*(L^(-(4:ℝ))*price))) pos small head (bought.2.2 g pos small J)
  have source:=WilsonMovingForkSharpNumericalLedger.original Y Q far Φ χ hΦ hχ Z y o m older e ear x w S stock
    g (by rwa [abs_of_nonneg pos]) bornRow
  let tot:=measured e g (PowerSeries.mk bornRow) - assembled Y Q Φ χ Z y o m older e x g w S
  have fee:‖(Complex.ofReal (ρ^4))*tot-measured e g (PowerSeries.mk scalar)‖ ≤
      |ρ^4| *(2*|g|^(e+1)*annulus Y Q Φ χ Z y o m older e x w S):=by
    change ‖(Complex.ofReal (ρ^4))*tot-measured e g (PowerSeries.mk (fun q=>ρ^4*f q))‖ ≤ _
    rw [WilsonMovingForkSharpThermalSplit.multiple,←mul_sub,norm_mul,Complex.norm_real,Real.norm_eq_abs]
    exact mul_le_mul_of_nonneg_left source (abs_nonneg _)
  have fair:(Complex.ofReal (ρ^4))*tot=(Complex.ofReal (ρ^4))*measured e g (PowerSeries.mk bornRow)-
      ∑j,measured e g (c j)*((Complex.ofReal (ρ^4))*measured e g (M j)):=by
    unfold tot WilsonMovingForkSharpNumericalLedger.assembled
    rw [mul_sub,Finset.mul_sum]
    congr 1
    apply Finset.sum_congr rfl
    intro j _
    dsimp only [c,M]
    ring
  rw [←fair]
  calc
    _=‖((Complex.ofReal (ρ^4))*tot-measured e g (PowerSeries.mk scalar))+measured e g (PowerSeries.mk scalar)‖:=by rw [sub_add_cancel]
    _≤_ :=norm_add_le .. 
    _≤_ :=(add_le_add fee smallRow).trans_eq (add_comm ..)
end YM.Integration.WilsonMovingForkSharpComputedRegression
