/-- One genuine receipt and one fixed winding menu serve the entire ordinary subset. -/
def original (F:Ptype)(B:voucher F)
    (receipt:WilsonOriginalCensusCanonicalFiledClock.Returns R hk D Q π Γ Ψ books (Nat.le_succ_of_le base)
      op ahead d q hd (o) order shelf F B)
    (pt:Fin n→Chamber)(x:Wallet (A))
    (tags:∀b:Covers R.family.path.levels.S (j+1) (coarse R (j+1) per),(step R (j+1) b.val).Choices)
    {length:ℕ}{σ₀:ℝ}(L:Material R N (j+1) length d σ₀ (binder (coarse R (j+1) per) y))
    (active:Addressed y L (present L.tests))
    (matched:∀z S₁,output L.prior S₁ N z=fixed R d (fun v=>contact (L.tests v))
      pt N ((j+1)+1) (j+1) cells q z S₁)
    (lowPlaced:(lo).passport=port (coarse R (j+1) per) y)
    (lowNames:(lo).modelIndex=((z:Multi.Hot (marks))×(words L z).Roster))(lowInk:HEq (lo).model (mounts L))
    (graded:lower.grades=d)(wallet:lower.x=x)
    (positive:0<Poetry.Agenda.seed D φ (Burn.horizon k) (R.alloy.B.a.clock.J (j+1)))
    (s:(marks).Mode)(front:(t:Multi.Hot (marks))→t.val.val)
    (charges:Fin n→ℕ)    (tube:LinkTube G)(target p breadthCap lowOrder:ℕ)(lawful:Legal (pay) (π (j+1)))
    (depth:2*(p+1)≤target)(lowOrderEq:lower.order=lowOrder)
    (highCap:(peak charges target)≤order)(lowCap:(peak charges target)≤length)
    (late:WilsonOriginalCensusSparseRosterOpening.first R simple tube d d charges order lowOrder target p depth≤j+1)
    (period:WilsonIndependentCollarCanonicalRelativeMenu.Paid R d (fun v=>contact (L.tests v))
      pt (peak charges target) breadthCap (present L.tests) (winding Hhat p (size₀)) (j+1) per)
    (near:∀t:Multi.Hot (marks),t.val.val⊆s.val→
      breadth t.val.val (front t).val 0 (relative t.val.val (front t).val y)≤breadthCap):
    ∀t:Multi.Hot (marks),t.val.val⊆s.val→WilsonOriginalSparseCensusEdge.Face R hk D Q π Γ Ψ
      books base ahead _ inLow (file F B x) lower t (front t).val charges tube target ((Hhat^p)⁻¹):=by
  apply WilsonIndependentCollarCanonicalRelativeFaces.original R simple hk D Q π Γ Ψ books base cut op ahead
    d q hd y cells order shelf inLow lower F B receipt pt x tags L active matched lowPlaced lowNames lowInk
    graded wallet positive s front charges tube target (p+1) 1 (peak charges target) (peak charges target)
    breadthCap ((Hhat^p)⁻¹) (winding Hhat p (size₀)) (Nat.le_succ _) highCap lowCap period near
  intro t own
  have billed:=WilsonOriginalCensusCanonicalSparseBudget.original R simple hk D Q π Γ Ψ books base ahead
    _ inLow (file F B x) lower t charges tube target course cut.le lawful p (peak charges target)
    (by simpa only [graded,WilsonOriginalCensusCanonicalFiled.file] using
        WilsonOriginalCensusSparseRosterOpening.ceiling d d charges target t.val) depth
    (by simpa only [WilsonOriginalCensusCanonicalSparseBudget.opening,WilsonOriginalCensusSparseRosterOpening.face,
          graded,lowOrderEq,WilsonOriginalCensusCanonicalFiled.file] using
        (WilsonOriginalCensusSparseRosterOpening.onset R simple tube d d charges order lowOrder target p depth t.val).trans late)
  simpa only [graded,WilsonOriginalCensusCanonicalFiled.file] using billed

