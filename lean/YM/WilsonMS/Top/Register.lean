import YM.WilsonMS.Top.Coupling

/-!
# Finite-regulator field insertion equality (tree vs Master)

Pay Laurent powers before reexpressing. No assumptions about overlaps or
relative locations of insertions, or that various field amplitudes start at
zero. Use the module generated by individual shifted fields. A
`Correspond` pair means a *sum of insertions* agreeing order by order
before any Wick operation (on the respective field variables with the field
support and shift as specified here).
-/

set_option autoImplicit false
noncomputable section
namespace YM.WilsonMS.Rescaled
open Root Coupling Quo Precision Lattice Function XSpace XSpace.Period
open MS MS.Koszul MS.Cylinder MS.Cylinder.Lab MS.Cylinder.Taylor MS.Native MS.Native.Wilsonian
open MS.Book MS.Book.Convolve MS.Book.Program MS.Plane MS.Orbit MS.Orbit.Cog MS.Orbit.LogReal MS.Fleet
open MS.Swirl MS.Swirl.Near MS.Puff MS.Puff.Actors MS.Puff.SplitP MS.Puff.Engine MS.Puff.Mom
open scoped Topology ContDiff BigOperators

variable {P : Period} (T : P.Tree) (G : Gauge) (φ : Team) (x : ℝ)
local notation "N" => P.side
local notation "Σ'" => σbranch (G := G) (n := N)
local notation "Λ" => Master G N true
local notation "BS" => XSpace.Bare.Series T G
local notation "BVφ" => NRG (Stripped φ) x N G true
local notation "Oils" => PermV Σ'

abbrev Obs :=
  Wilson.Config G P.side → ℝ

abbrev inscription (O : Obs (P := P) G) :=
  ink (glow G (Site P.side)).e0 (in_chart G O)

/-- Real analytic germ on Wilson log links with minimum-degree and gauge
requirements. `aligned` in `MarkedLPT` proves the Correspond condition for
actual Bᵃ fields (which may also use sums over lower Wick slots). -/
structure Offered (O : Obs (P := P) G) (d : ℕ) : Prop where
  starts : From (inscription G O) d
  valid : germ (in_chart G O)
  invariant (a : Site P.side → G.El) (h : ∀ x, a (-x) = a x) (u) : O (Lattice.gauge a u) = O u

section product
open Filter Set Finset
open Root
open XSpace Taylor
open PowerSeries (coeff)
variable {d l : ℕ}
variable {O Z : Obs (P := P) G} (ho : Offered G O d) (hz : Offered G Z l)
include ho

abbrev tested_function (O : Obs (P := P) G) : T.Field G → ℝ :=
  ((asTree G O ∘ raised G) ∘ plantL T G)

lemma testGerm : germ (tested_function T G O) := by
  rw [tested_function]
  exact
    ContDiffAt.comp (f := ⇑(plantL T G)) 0
      (by
        rw [map_zero]
        exact stencilG G O ho.valid)
      (plantL T G).contDiff.contDiffAt

lemma smaller : From (ink (T.basis G) (tested_function T G O)) d := by
  have hs : From (stamped T G (asTree G O)) d := carries_from T G O d ho.valid ho.starts
  let f := asTree G O ∘ raised G
  let v := Darboux.a (U := GhostI T G) ∘ freeI T G
  have he : ink (T.basis G) (f ∘ plantL T G) = ink ((coordinates T G).e0 ∘ v) f := by
    rw [ink_ctrl_one _ _ (stencilG G O ho.valid)]
    congr 1
    funext i
    exact plantA_basis T G i
  rw [tested_function, he]
  classical
  rw [← include_specialize v]
  intro u hu
  rw [specialize_inclusion]
  exact hs (u.map v) (by simpa using hu)

theorem laurent :
    Root.bareMark T G (asTree G O) d * PowerSeries.X ^ d =
      XSpace.Taylor.expandTaylor (T.basis G) (Complex.ofRealCLM ∘ tested_function T G O) := by
  refine PowerSeries.ext fun n => ?_
  by_cases h : d ≤ n
  · obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_le h
    rw [show n = k + d by omega, PowerSeries.coeff_mul_X_pow, bareMark, XSpace.Taylor.expandTaylor,
      PowerSeries.coeff_mk, PowerSeries.coeff_mk]
  rw [PowerSeries.coeff_mul_X_pow', if_neg h, XSpace.Taylor.expandTaylor, PowerSeries.coeff_mk]
  apply Symbols.encode_injective (T.Key G)
  rw [map_zero, Symbols.encode_expansion _ _ (testGerm T G ho)]
  ext u
  by_cases he : (u.length : ℤ) = (n : ℤ)
  swap
  · exact (strange _ he).symm
  rw [enough _ he]
  exact (smaller T G ho u (by omega)).symm
include hz

lemma Offered.products : Offered G (O * Z) (d + l) := by
  refine
    ⟨?_, ho.valid.mul hz.valid, fun a h u =>
      congr_arg₂ (· * ·) (ho.invariant a h u) (hz.invariant a h u)⟩
  have hx := ink_mul (glow G (Site N)).e0 (glow G (Site N) |>.never) ho.valid hz.valid
  rw [show inscription G (O * Z) = _ from hx, Nat.cast_add]
  exact ho.starts.pair hz.starts

lemma fourier_product :
    fourierMark G φ x (O * Z) (d + l) = (Oils).core (fourierMark G φ x O d) (fourierMark G φ x Z l) := by
  let U := promote (specialize (Position.fourier G N))
  have h : Tether U Oils Oils := (specialize_tether (Position.role G)).Extrapolation useN
  have hs : Tether (substitute (shift φ x)) Oils Oils := tether (actor Σ') (share φ x)
  have hv : letterField G (O * Z) (d + l) = (Oils).core (letterField G O d) (letterField G Z l) := by
    change rankLevel _ (ink _ _) = _
    rw [show ink _ (in_chart G (O * Z)) = product Σ' (inscription G O) (inscription G Z) from
        ink_mul _ (glow G (Site N) |>.never) ho.valid hz.valid,
      Nat.cast_add]
    ext1 i
    exact (pairLevel (p := Σ') i ho.starts hz.starts).symm
  unfold fourierMark
  rw [hv]
  rw [show promote _ _ = _ from h.craft (letterField G O d) (letterField G Z l)]
  apply hs.craft

lemma bare_product :
    bareMark T G (asTree G (O * Z)) (d + l) =
      bareMark T G (asTree G O) d * bareMark T G (asTree G Z) l := by
  apply Symbols.turn_injective
  rw [bare_coeff _ _ _ _ (stencilG G (O * Z) (ho.products G hz).valid), Symbols.turn_mul,
    bare_coeff _ _ _ _ (stencilG G O ho.valid), bare_coeff _ _ _ _ (stencilG G Z hz.valid)]
  let i (F : Obs (P := P) G) := ink (T.basis G) (tested_function T G F)
  let p := Symbols.plain (T.Key G)
  change rankLevel _ (i _) = (PermV p).core _ _
  rw [show i (O * Z) = product p (i O) (i Z) from
      ink_mul (T.basis G) (fun _ h => Bool.noConfusion h) (testGerm T G ho) (testGerm T G hz),
    Nat.cast_add]
  ext1 j
  exact (pairLevel j (smaller T G ho) (smaller T G hz)).symm

lemma lit_mul : litMark T G φ x (O * Z) (d + l) = litMark T G φ x O d * litMark T G φ x Z l := by
  unfold litMark
  rw [bare_product T G ho hz, comp_mul (share φ x)]
end product

section scalar
variable {E F Y : Type} [AddCommGroup E] [AddCommGroup F] [AddCommGroup Y] [Module ℂ E] [Module ℂ F]
  [Module ℂ Y]

abbrev priced (u : Cn) (f : MS.Book.Convolve.T E) :=
  pairW (LinearMap.lsmul ℂ E) (Coupling.read u) f

lemma scalesL (u : Cn) (B : E →ₗ[ℂ] F →ₗ[ℂ] Y) (f g) :
    pairW B (priced u f) g = priced u (pairW B f g) := by
  funext n
  simp only [priced, paired, map_sum, map_smul, LinearMap.lsmul_apply, LinearMap.sum_apply,
    LinearMap.smul_apply]
  exact (associate (fun i j k => (Coupling.read u) i • B (f j) (g k)) n).symm

lemma scalesR (u : Cn) (B : E →ₗ[ℂ] F →ₗ[ℂ] Y) (f g) :
    pairW B f (priced u g) = priced u (pairW B f g) :=
  MS.Menus.olio ..

lemma scaleLinear (u : Cn) (t : E →ₗ[ℂ] F) (f) : promote t (priced u f) = priced u (promote t f) := by
  funext i
  simp only [promised, priced, paired, map_sum, map_smul, LinearMap.lsmul_apply]

lemma read_times (u v : Cn) : Coupling.read (u * v) = priced u (Coupling.read v) :=
  funext fun _ => PowerSeries.coeff_mul ..

lemma self_price (c : ℂ) (X : MS.Book.Convolve.T E) : priced (PowerSeries.C c) X = c • X := by
  funext n
  unfold priced
  rw [paired, Finset.sum_eq_single_of_mem (0, n) (by simp)]
  · rw [LinearMap.lsmul_apply]
    unfold Coupling.read
    simp
  intro j hj he
  have hv : j.1 ≠ 0 := fun h =>
    he
      (Prod.ext h
        (by
          dsimp
          obtain ht := Finset.mem_antidiagonal.mp hj
          omega))
  simp only [LinearMap.lsmul_apply, Coupling.read, PowerSeries.coeff_C, if_neg hv, zero_smul]

lemma self_mark (c : ℂ) (a : BS) : XSpace.Bare.scalar T (PowerSeries.C c) * a = c • a := by
  rw [XSpace.Bare.scalar, PowerSeries.map_C, ← PowerSeries.algebraMap_apply]
  exact (Algebra.smul_def ..).symm
end scalar

inductive Correspond : SpecB (FixedMode G P.side) → BS → Prop
  | start (O : Obs (P := P) G) (d : ℕ) (h : Offered G O d) :
    Correspond (fourierMark G φ x O d) (litMark T G φ x O d)
  | zero : Correspond 0 0
  | unit : Correspond (Oils).unit 1
  | add {X Y a b} : Correspond X a → Correspond Y b → Correspond (X + Y) (a + b)
  | scale {X a} (u : Cn) : Correspond X a → Correspond (priced u X) (XSpace.Bare.scalar T u * a)
namespace Correspond
variable {T G φ x} {X Y : SpecB (FixedMode G P.side)} {a b : XSpace.Bare.Series T G}

lemma join (h : Correspond T G φ x X a) (hv : Correspond T G φ x Y b) :
    Correspond T G φ x ((Oils).core X Y) (a * b) := by
  induction h generalizing Y b with
  | start O k hp =>
    induction hv with
    | start R n hR =>
      rw [← fourier_product G φ x hp hR, ← lit_mul T G φ x hp hR]
      exact start _ _ (hp.products G hR)
    | zero =>
      rw [map_zero, mul_zero]
      exact zero
    | unit =>
      rw [(Oils).identityR, mul_one]
      exact start _ _ hp
    | add _ _ h1 h2 =>
      rw [map_add, mul_add]
      exact h1.add h2
    | @scale Z b c h ih =>
      rw [show (Oils).core _ (priced c Z) = _ from scalesR c (product Σ') (fourierMark G φ x O k) Z,
        mul_left_comm]
      exact scale c ih
  | zero =>
    rw [map_zero, LinearMap.zero_apply, zero_mul]
    exact zero
  | unit =>
    rw [(Oils).identityK, one_mul]
    exact hv
  | add _ _ h1 h2 =>
    rw [map_add, LinearMap.add_apply, add_mul]
    exact (h1 hv).add (h2 hv)
  | @scale U c f h ih =>
    rw [show (Oils).core (priced f U) Y = _ from scalesL f (product Σ') U Y, mul_assoc]
    exact scale f (ih hv)

lemma scales (h : Correspond T G φ x X a) (r : ℂ) : Correspond T G φ x (r • X) (r • a) := by
  rw [← self_price r X, ← self_mark T G r a]
  exact scale _ h

lemma sum {J : Type*} (s : Finset J) {X : J → SpecB (FixedMode G P.side)} {v : J → BS}
    (h : ∀ i ∈ s, Correspond T G φ x (X i) (v i)) :
    Correspond T G φ x (∑ i ∈ s, X i) (∑ i ∈ s, v i) := by
  classical
    induction s using Finset.induction_on with
  | empty => simpa only [Finset.sum_empty] using (zero (T := T) (φ := φ) (x := x) (G := G))
  | insert i s hi H =>
    rw [Finset.sum_insert hi, Finset.sum_insert hi]
    exact add (h _ (by simp)) (H fun j hj => h _ (Finset.mem_insert_of_mem hj))

lemma guard (h : Correspond T G φ x X a) : X ∈ (Oils).guard := by
  induction h with
  | start O d _ =>
    let U := Position.fourier G N
    have hx : ∀ j : ℕ, Pure Σ' false (specialize U (letterField G O d j)) := fun j => by
      let Z := letterField G O d j
      let V : Cyl (FixedMode G N) ℂ := region.symm Z
      change Pure _ _ (specialize U V.val)
      rw [specialize_shade U V]
      apply (Position.role G).pure
      change Pure _ _ (mask _ (inscription G O))
      intro l hl
      by_cases he : (l.length : ℤ) = j + d
      rw [enough _ he]
      exact ink_p (glow G (Site N)).e0 (glow G (Site N) |>.never) _ l hl
      exact strange _ he
    intro j _
    change Pure _ _ (substitute _ _ j)
    rw [rules]
    exact Pure.sum (Finset.Iic j) fun i _ => Pure.smul _ (hx i)
  | zero => exact (Oils).guard.zero_mem
  | unit => exact (Oils).holds
  | add _ _ h₁ h₂ => exact (Oils).guard.add_mem h₁ h₂
  | scale u h ih =>
    exact fun j _ =>
      Pure.sum (Finset.antidiagonal j)
        (fun i _ => by
          rw [LinearMap.lsmul_apply]
          exact Pure.smul _ (ih i.2 (Set.mem_univ i.2)))

lemma numerator (h : Correspond T G φ x X a) :
    ℶV Λ ((Oils).core (exp0 Σ' BVφ) X) = Coupling.read (gaussian T G φ x a) := by
  induction h with
  | start O d h => exact common_numerator T G φ x O d h.valid h.invariant h.starts
  | zero =>
    rw [map_zero, map_zero, map_zero]
    exact funext fun i => Eq.symm (map_zero _)
  | unit =>
    rw [(Oils).identityR]
    exact vacuum_answer T G φ x
  | add _ _ h1 h2 =>
    rw [map_add, map_add, h1, h2, map_add]
    exact funext fun i => Eq.symm (map_add (PowerSeries.coeff i) _ _)
  | @scale U v c h ih =>
    rw [show (Oils).core _ (priced c U) = priced c ((Oils).core (exp0 Σ' BVφ) U) from
        scalesR c (product Σ') (exp0 Σ' BVφ) U,
      show ℶV Λ _ = priced c (ℶV Λ ((Oils).core _ U)) from scaleLinear c (View Λ) _, ih,
      gaussian_scalar, read_times]
end Correspond

variable {W : Type} [LinearOrder W] (V : W → Actor G) (A : Cover) (c : W → Cover)
  (X : W → XSpace.Bare.Series T G)
variable (h : ∀ i : W, Correspond T G φ x (promote (Mark_T G P.side A (c i)) (V i x)) (X i))
include h

lemma tribute (s : Finset W) : Correspond T G φ x (Font Σ' (Marks V x N A c) s) (∏ i ∈ s, X i) := by
  let Y := Marks V x N A c
  have av (p : Finset W) (hp : p.card ≠ 1) : Y p = 0 := mark_off hp ..
  induction s using Finset.induction_on with
  | empty =>
    rw [show Font Σ' Y ∅ = (Oils).unit from Stencil.simple_E _ _ _ (av ∅ (by simp)),
      Finset.prod_empty]
    exact Correspond.unit
  | insert i s hi H =>
    have ht (w : Finset W) : Y w ∈ (Oils).guard := by
      by_cases he : w.card = 1
      · obtain ⟨j, rfl⟩ := Finset.card_eq_one.mp he
        unfold Y
        rw [mark_me]
        exact (h j).guard
      rw [av w he]
      exact (Oils).guard.zero_mem
    rw [Finset.prod_insert hi,
      show Font Σ' Y (insert i s) = (Oils).core (Y { i }) (Font Σ' Y s) from
        Stencil.cheers _ ht av s i hi,
      show Y { i } = _ from mark_me x N A c (V := V) i]
    exact (h i).join H

/-- Main finite-top theorem: any positive marks genuinely prescribed by the
periodic Wilson chart and stencils as above, through any order. The answer is
the tree coefficient using the stencils (all shifts and prefactors), with one
common vacuum. -/
theorem finite_top (s : Finset W) :
    PhysicalSum G φ x N true s c A V (Coupling.read (expectation T G φ x (∏ i ∈ s, X i))) := by
  let Y := (∏ i ∈ s, X i)
  change Endμ _ _ _ _ _
  rw [Endμ, (tribute T G φ x V A c X h s).numerator]
  rw [vacuum_answer T G φ x]
  rw [← vacuum_times T G φ x Y]
  exact funext fun i => PowerSeries.coeff_mul ..
end YM.WilsonMS.Rescaled
