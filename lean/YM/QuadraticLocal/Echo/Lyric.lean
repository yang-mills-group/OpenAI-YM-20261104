lemma contribution (n:ℕ): Catch.Cover T n (graded (j+1)) (fun i=>(b i)⁻¹) (fun i=> Qs i j- Wake.voice W M S R v s j i ∘ Desk.night) x := by
 let a:= graded (j+1); let Y' i:=Page.portrait (W i) M (S i) (K' i) j; let f i:= V₁ j i; let g i:= voice W M S R v s j i ∘ Desk.night; let H' := Wake.ships m W M S h R v s n₀ hx b x hb hp hO K' Vd hK hxZ hv hm hc hr n a
 let hb(i:ℕ)(hi:i≤j): Catch.Cover T n a ξ (fun x=> Mx j i x- Bx i x ∘ Desk.night) x := by
    obtain ⟨c,hp',hP⟩:= Vd.grant i hi; obtain ⟨_,_,_,hK⟩:= hK.rows i hi; exact Wake.pours W M S h R v s n₀ hx c hp' hP hK b x hb hp hx' hi n
 let f'(k:ℕ)(i:ι):= Mx j k i - Bx k i ∘ Desk.night
 apply Catch.Cover.home (H'.add (Catch.Cover.booking (p:=ξ) («F»:=f') J' (fun i hi=> hb i (Nat.le_of_lt_succ (Finset.mem_range.mp hi))) (hp.mono fun _ hi=> inv_nonneg.mpr hi.le)))
 apply Eventually.of_forall; intro i; unfold receiver voice f'; simp only; ext1 z; simp only [Pi.add_apply,Pi.sub_apply,Finset.sum_apply,Function.comp_apply, Finset.sum_sub_distrib]; abel

