    Catch.Cover T n (graded (j+1)) (fun i=>(b i)⁻¹) (fun i=> Page.hostel (W i) M (S i)- Wake.voice W M S R v s j i ∘ Desk.night) x := by
   let H':= Page.stipend (K:=K) f W M S h hO p hg H1 hU hv hs₁ hR K' hm hc j j' n ht hxZ hE hy hP b hp hb
