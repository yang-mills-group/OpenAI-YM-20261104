 have hF: Looks G LΩ T (fun i=>(f i).whenP):= by
    refine ⟨(Pair.time_l.comp hV.tends).congr h', hV.same.trans (Eventually.of_forall fun i=>?_)⟩; exact congr_arg (fun u₀:ℝ=> betaF G u₀ (LΩ)) (h' i)
