lemma logTrace (hpz: Progress.DirectedRecipe.Payments.Rates (V).B W₁ Ws (softNeed G V (s).clip (s).width (s).paths α 0) yℓ)
    (ht:Progress.DirectedRecipe.Payments.Rates (V).B W₁ Ws (softNeed G V (s).clip (s).width (s).paths α 0+zℓ) yℓ): Benchmark R Q A F hk X' x K F₁ L₁ Z ℓ₀ Hc zℓ W₁:= by
 let s':=(s); let hP:=hKx.licensed; have hs : (s)=p:= (params_eq A.B.valid m).symm
 obtain ⟨hρ,hη⟩:= wide R Q A F h (n:=n) (m:=m); -- wide fields check
 have hM := (K.laws.data.room.buys); obtain ⟨hX,hX0,hw⟩:= paint R Q A F h g0 hm hk X' hh x hx (show 4≤ (c!).val from (by omega));
 have hwL:= ( low_tent R Q A F h hm π K ); have hv: (Λ).Bounds (s).clip (s).width (s).paths (A.B.a.clock.loopCap m):=hs.symm ▸ hwL.1 -- syntax orientation
 have hV:Width ( Rosary.pearl V ) (s).clip (s).width:= hs.symm ▸ (bless R Q A F h hk).1
 let yV:= (V); have hc:Width (V) (s).clip (s).width:=⟨hV.1,hV.2.1, (div_le_div_of_nonneg_right (show yV.supportExponent+1≤(pearl yV).supportExponent+1 from (by unfold pearl preExponent; dsimp; linarith)) (Nat.cast_nonneg yV.B)).trans hV.2.2⟩
 have hd:= Guard.Dusk.affix hP.paid g0 hv (hs.symm ▸ hwL.2.2.2.2) hc hη α M0o Y₁ yℓ x ℓ₀ hX hX0 W₁ hpz hw zℓ ht
 obtain ⟨E₁,X₀,tν,hν⟩:= hKx.debts; obtain ⟨T₁,ht'⟩:= hd.photos; refine ⟨hd,?_,?_, (by change x+(Φ-x)= Φ; ring)⟩
 · funext U'; rw [hd.depiction U', hP.same]
 · refine ⟨⟨ E₁,X₀,(L₁.read Z),tν,T₁ ⟩,?_⟩; unfold Travel.DualExponent; simp only; rw [hν]; exact ht' -- defeq Real.exp ∘
