include v hk hℓ hl he hb A H hq hy g
lemma constitutes : Eon.Output R hk D Q π Γ Ψ v hℓ Actors U w η Z' Q0 Qa s ε program hb hl (u_ hl) (v_ hl.le):= by
    have ht(i:ℕ)(h:m≤ i)(hv:i<b):= H.bill i h hv
    have hp'(i:ℕ)(h:m≤ i)(hv:i<b):= print_key R D π Γ Ψ v h (hv.le.trans hb) R₀ Actors U w η Z' ( K i h hv.le ) ( K (i+1) (Nat.le_succ_of_le h) hv ) s ε ( ht i h hv ) -- sig
    have h':= ht _ hℓ hl; have hg:= hp' _ hℓ hl;
    have hi:=Nat.le_succ_of_le hℓ; have he' : ∃ a c d,Key (N:=N) R Ψ Actors U w ( K (i+1) hi hl ) a c d:= by
       cases lt_or_eq_of_le (show i+1≤b from hl)
       next hv=> exact ⟨_,_,_,hp' _ hi hv⟩
       next hv=> subst b; rw [H.current.beginning]; exact ⟨_,_,_,( Eon.launch_key R hk D π Γ Ψ v hi hb Actors U w η Z' Ξ A he ).1⟩
    obtain ⟨a,c,d,hk'⟩:= he'
    refine ⟨?_, h',hg, Eon.line R D π Γ Ψ v hℓ R₀ Actors U w η Z' _ _ s ε h' hN hk' hg ⟩ -- hN etc
    exact Eon.clips R g hk D Q π Γ Ψ v C Q0 hℓ Actors U w η Z' _ Qa hq _ hy ε program hl ( H.current.graduates i hℓ hl ) hN
-- same chart, no hidden smaller Semester at q'.
