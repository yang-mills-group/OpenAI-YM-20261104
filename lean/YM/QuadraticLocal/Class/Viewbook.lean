local notation "Lp"=> (envelopeProduct («R»:=R₀) U₀)
include hk' hc hu hf
set_option maxHeartbeats 500000
lemma payment : Nonempty (RelativeBudget p (µ' (Display.taste (Zr))) w₀ (forcedDivisor Z i) (envelopeProduct U₀) (4*A₀) d) ∧ Nonempty (RelativeBudget p (µ' ( Display.taste (Σ_) )) w₀ (forcedDivisor Z i) (envelopeProduct U₀) (4*A₁) d):=by
    obtain ⟨T₁⟩:= hk'.entry.receipt; obtain ⟨T₂⟩:= hk'.residual.receipt; rw [hc] at T₁ T₂
    exact ⟨QuadraticLocal.Shell.restore hf (µ' (Wa)) U₀ hu ( Lens.pullCost F T₁ ),QuadraticLocal.Shell.restore hf _ U₀ hu ( Lens.pullCost F T₂ )⟩
omit hk' hc hu hf
