def ray : (Σ i:Earn.Width.Glass X S.ratio U.p.B Hp, Patrol.Signs X i.val)≃ Job X Hp S U where
 toFun v:= ⟨⟨v.1.val,v.2⟩,v.1.prop⟩
 invFun v:= ⟨⟨v.val.fst,v.prop⟩, v.val.snd⟩
 left_inv _:=rfl
 right_inv _:=rfl
