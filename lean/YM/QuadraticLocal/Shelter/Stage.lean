    toFun v:= ⟨Ray ⟨v.1,v.2.fst⟩,v.2.snd⟩
    invFun v:= ⟨((Ray).symm v.fst).fst, ((Ray).symm v.fst).snd, v.snd⟩
    left_inv _:=rfl
    right_inv _:=rfl
