    have ha : ( (R.family.path.levels.clock.op i n).ratio.count )= L:= PriceCompiler.block_eq R.alloy.B.valid i; let Pz:= ((R.family.side i n).val); have hu: c_P * (Ψ' Pz) ≤ (Ψ' Pz):= by apply mul_le_of_le_one_left _ hp; unfold Breeze.areaBudget; positivity
    let Lp:= (w₀) * Δ₀; let f:= Volume.cutRank (Burn.horizon k+4) ((x★)^ (Y:ℕ)); -- replace κ
    have ht: (V₁).entry.self.paid= ConnectedActivityE6.loopBill G ( R.rolls.L Y ) ( R.alloy.B.a.clock.hatBeta i ):= V₁.studied.books.fisc; have hL :0≤ Lp:= by unfold Lp; change 0 ≤ Wharf.rate _ H_ (V₁.entry.self.paid) (C₁)*AllOrder.Ink.Money.dearth φℓ (C₁); have hP:0 ≤ w*:= hz.2.1.le; unfold Wharf.rate AllOrder.Ink.Money.dearth; positivity
    have hC : 0 ≤ f:= abs_nonneg _; calc
      f₀ ≤ Ψℓ:= by
            unfold Tutoring.bill Tutoring.duty Volume.spare; dsimp only; rw [← ht,ha]; change _ ≤ Lp*f*_; refine mul_le_mul (mul_le_mul_of_nonneg_left  ?_ hL) ?_ ?_ (mul_nonneg hL hC)
            · exact (pow_le_pow_left₀ (by positivity) (add_le_add_right hk _) _).trans (le_abs_self _)
            · exact mul_le_mul_of_nonneg_left hu (by positivity)
            unfold Air.united Breeze.areaBudget; positivity
      _ ≤ _:= by
         rw [PriceCompiler.beta_eq R.alloy.B.valid]; apply hV.supports (x:=Y) (y:=I) Pt E! (t:=y★) ( R.alloy.B.valid.pays i ) (R.family.side i n) -- bound

         let B:=((A).B.a.budget i).B; let z':=((F).target Y I|>.halo); have he : B= Pressure.radiusB ( R.alloy.B.a.clock.hatBeta i ):= rfl; let u := Radii.window z' Pt.count Pt.stage B; let v:= Radii.survey z' Pt.count Pt.stage B; have hyτ : 2*u+1 ≤ Trio.base (Radii.occupancy z' Pt.count Pt.stage) B:= ( Radii.side z' Pt.count Pt.stage _ ((A).B.a.budget i).B_pos ).2.1; have hp :5*B ≤ u:= ( Radii.first z' Pt.count Pt.stage B).trans ( Radii.second ..); have hz : 2*Trio.base (Radii.occupancy z' Pt.count Pt.stage) B < (R.family.side i n).val:= Mentor.spacing D R.rolls Q A F φ Q0 Y'.education Pt; omega
