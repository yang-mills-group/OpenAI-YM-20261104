include hq
private lemma ruby (i:Patrol.Shift X T)(uT:Config G n): (Ω).Knows {i} (fun a=> ((brand (P!) a i).ingredient uT)):=by
    change (∀ x∈ ({i}:Multiset (Patrol.Shift X T)), _ ) → _ -- parse
    intro hi; obtain ⟨i,rfl⟩:= (Patrol.member X C T σ i).1 (hi i (Multiset.mem_singleton_self i)); let A(i:Club.Keys X C):= Patrol.enter X T (Patrol.ticketA X C i,σ i); let A':=(Patrol.ticketA X C i,σ i);
    have he j:Pure.Ray (fun a:α=> p₁ a i) (fun x=> (((P! (A i)).angle x).ingredient j)):=by
         simp_rw [show ∀ x,(((P! (A i)).angle x).ingredient j) = _ from fun x=> (congr_fun (Enroll.unitBeam X T w hw hq B x A') j)]
         let v':= (V₀ i); let Xv:=(Enroll.grainR (U:=U) X A' j)
         refine ⟨ Week.chip X C w i * Xv,funext fun b=> ?_⟩; change (p₁ b i * Week.chip X C w i) * Xv= _; dsimp only; ring
    change Pure.Ray _ _; simp_rw [Multiset.map_singleton, Multiset.prod_singleton, Week.reading X C T w hw σ i]; exact he uT
variable {b_v:ℕ}
include hm Q
lemma honor (he:p∈ ( MT i))(U_:Config G c)(hp:Healthy R'.p.threshold ((Campus.theater X T w hw hq B y H).halls p) U_) : Pure.Ray (Week.fuel X C σ) (fun i=>(Campus.theater X T w hw hq B y H).solvent i p U_) := by
    rw [Q.pole] at hp
    have hr:= (RemainderComparison.Collar.dew H O P! (Ω) (fun U i=>ruby X C T w hw hq B σ i U) y (fun _=>1) Set.univ 0 (Q.pad.S.N) U_ p hp).self_of_nhds
    let W:= Week.color X C T σ; have hf: (Yo).marks p=(pulp X C T σ).val:=BoxOf.grace P! y H Π M O (fun _=>1) Set.univ 0 ((BoxOf.shine ..).1 he).fair
    have hh : ∀ a∈(Yo).marks p,a∈ (Π:Set (Patrol.Shift X T)):= by rw [hf]; exact fun a hi=> hi
    have hv : Pure.Ray (fun b:α=> Multiset.prod (Multiset.map (fun i=> W i b) ((Yo).marks p))) (fun b=>(Yo).solvent b p U_):= hr hh
    rw [hf,show (fun b:α=> Multiset.prod _) = Week.fuel X C σ from (by
       funext b; change ∏ i∈Π, W i b=_; unfold pulp Week.fuel; rw [Finset.prod_image (g:=Patrol.out X C T σ) ((Patrol.enroll X C T σ).injOn)]; unfold W; simp_rw [fun i:K=> Week.reading X C T w hw σ i])] at hv
    exact hv
