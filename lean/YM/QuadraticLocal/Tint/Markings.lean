    let j:=(MΓ u).turn; change _⊆ Matter.areas U A _ _ (j.badge S)
    rw [Wing.badge_area]; exact Subset.trans (Finset.image_subset_image (f:=S.ratio.parent) (show (MΓ u).crest⊆ inspected (j.support U) from Finset.subset_union_left)) (halo_subset _ _)

