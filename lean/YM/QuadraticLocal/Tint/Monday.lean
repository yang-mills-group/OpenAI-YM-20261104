   let P₀:= (ZL.solute (a₁ σ) t); let CΓ:= (Π); let κ:=Kc ⟨C,σ⟩; let s:= Campus.blades X C T w hw hq B y σ H D0 M0 hβ κ; let V:= Week.present X C T w hw hq B y σ H D0 M0 hβ κ t x; have hv:V=Week.pack X C w*Week.fuel X C σ t *vₗ x+P₀ x:= Week.Semester.signal ZL (a₁ σ) t x hp; simp_rw [Semester.mark_value X C T w hw hq B y H Hp D0 M0 hβ Q Kc hz hm ht t x] -- args replace
   change ∑ i:↥s,fΓ* (↑( (Yo).solvent t i.val x):ℂ)= _+fΓ * ↑(P₀ x)
   rw [← Finset.mul_sum,← Complex.ofReal_sum, Finset.sum_coe_sort (f:=fun i: E!=> (Yo).solvent t i x)]; rw [show ∑ i∈s,(Yo).solvent t i x= V from rfl, hv]; push_cast; ring

