lemma plumed (i:Club X): Club.alliance X i≠R.quiet :=by
   let q:= Club.lowest X i; let v:=(Club.troops X i q).binder; have he: v.front∈(Club.alliance X i).val:= Club.earn X i _ (Club.attends X i q) v.east; intro hx; rw [hx] at he; exact Finset.notMem_empty _ he

def backed : Work*↪ (Primary X T w hw hq B y H m):=by
    refine ⟨(fun v=>?_), ?_⟩ -- defer
    · exact ⟨(v.snd.val,Club.alliance X v.1.val.1),((actLives X T w hw hq B y H Hp D0 M0 hβ Kc hm v).1.1|>.1),plumed X w hw hq _, homes X T w hw hq B y H Hp D0 M0 hβ Kc hm v⟩
    exact fun u v h=> (ensemble X T w hw hq B y H Hp D0 M0 hβ Kc).injective (congr_arg (Prod.fst ∘ Subtype.val) h) -- type binder β includes R.F.Eq
