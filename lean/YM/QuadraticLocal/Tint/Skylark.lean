def reflux : Lefts X T w hw hq B y H Hp D0 M0 hβ Kc m ↪ Primary X T w hw hq B y H m:= ⟨(fun i=>⟨i.val,i.prop.1.1.1,i.prop.2⟩), fun i j h=> Subtype.ext (congr_arg (fun (i:p₀)=> i.val) h)⟩
local notation "k₂"=> Hearth.reflux X T w hw hq B y H Hp D0 M0 hβ Kc m -- #check m implicit refl
local notation "κ₁"=> (q₁ ⊕ (Work*))

def relate : (Lefts X T w hw hq B y H Hp D0 M0 hβ Kc m ⊕ Perfor X T w hw hq B y H Hp D0 M0 hβ Kc) ↪ Primary X T w hw hq B y H m:=by
    let A:= fun (i:pM)=> i.val.fst ∈(s₁); have he(i:Work*): A ((k₁) i):= (actLives X T w hw hq B y H Hp D0 M0 hβ Kc hm i).1.2; have h(i:q₁): ¬ A (reflux (m:=m) X T w hw hq B y H Hp D0 M0 hβ Kc i):= i.prop.1.2
    let k₂':= reflux (m:=m) X T w hw hq B y H Hp D0 M0 hβ Kc; refine ⟨Sum.elim k₂' (k₁), ?_⟩; rintro (i|i) (j|j) hp; exact congr_arg Sum.inl (k₂'.injective hp); exact (h i ((show k₂' i=(k₁) j from hp).symm ▸ he j)).elim; exact (h j ((show (k₁) i=k₂' j from hp) ▸ he i)).elim; exact congr_arg Sum.inr ((k₁).injective hp)
