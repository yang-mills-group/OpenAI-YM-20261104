structure Semester (Kc : Campus.Batch X→ℕ)(U':Width.Viewer X W' v' U.p.B)(g:ℝ) (X0:ℕ) where
   solute : Job X Hp S U→ α→ Config G c→ℝ
   study (j: Job X Hp S U) : Pure.Coherent R'.p (neighbors X0 (Club.roof X j.val.fst S.ratio)) (Week.fuel X j.val.fst j.val.snd) (2*(g*Week.pack X j.val.fst w)) (solute j)
   signal (j:Job X Hp S U) (t:α)(u:Config G c)(hp: Healthy R'.p.threshold (neighbors X0 (Club.roof X j.val.fst S.ratio)) u): Week.present X j.val.fst T w hw hq B y j.val.snd H D0 M0 hβ (Kc j.val) t u=(Week.pack X j.val.fst w*Week.fuel X j.val.fst j.val.snd t)*(Width.suite X j.val.fst S.ratio W' U' (Coat.gStep U.beta) u)+solute j t u
