lemma reach (he:Width.Together X C S.ratio U.p.B Hp): ∀ᶠ n:ℕ in atTop, ∃ ZL:α→ Config G c→ℝ, Pure.Coherent R'.p (neighbors X0 (Club.roof X C S.ratio)) (Week.fuel X C σ) (2*(g₀*Week.pack X C w)) ZL ∧ ∀ t:α,∀ u:Config G c, Healthy R'.p.threshold (neighbors X0 (Club.roof X C S.ratio)) u→ Week.present X C T w hw hq B y σ H D0 M0 hβ n t u=(Week.pack X C w*Week.fuel X C σ t)*(Width.suite X C S.ratio W' U' Z u)+ ZL t u := by
   apply (Law.bears C he σ).mono; intro i he; apply Pure.coherent (pu) Outp (Week.fuel X C σ) (π₀ i) (P₁) 1 (fun t=> Week.small X C w hw σ t hy0) (Week.pack X C w) (mul_nonneg hg (Week.strict X C w hw).le) ?_ he
   intro z hz; let Xq:= Campus.blades X C T w hw hq B y σ H D0 M0 hβ i
   change Pure.Ray E₀ (fun t=> ∑ q∈ Xq,(Yo).solvent t q z); apply Pure.script Xq; intro q hq'; apply Week.honor X C T w hw hq B y σ H D0 M0 hβ Q hm q hq' -- arg order.Q BEFORE? inspect
   exact hz.mono_left ((Campus.seats X C T w hw hq B y σ H D0 M0 hβ q hq').trans (Lattice.Corona.halo_mono hL (Subset.refl _)))
