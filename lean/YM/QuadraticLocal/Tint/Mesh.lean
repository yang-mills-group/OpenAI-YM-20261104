lemma appoint (B0:ℕ) : ∃ Kc: Campus.Batch X→ℕ,(∀ i,Rayon X Hp S U i→ B0≤Kc i) ∧ Nonempty (Semester X T w hw hq B y H Hp D0 M0 hβ W' Kc U' g₀ X0 (R':=R')):=by
   let Q' := Job X Hp S U; have ht (i:Q'):= (Week.reach X i.val.1 T w hw hq B y i.val.snd H Hp D0 M0 hβ Q hm hy0 W' U' X0 hg Law hL i.prop); choose f hf Zν hp hv using fun p:Q'=>(((Filter.eventually_ge_atTop B0).and (ht p)).exists)
   let e(i:Campus.Batch X):= if h:Rayon X Hp S U i then f ⟨i,h⟩ else B0; refine ⟨e,fun i hi=> (show e i=f ⟨i,hi⟩ from dif_pos hi).symm ▸ (show B0 ≤ f ⟨i,hi⟩ from hf _),⟨Zν,hp, fun i v T' h' =>?_ ⟩⟩; dsimp only [e]; rw [dif_pos i.prop]; exact hv i v T' h'
