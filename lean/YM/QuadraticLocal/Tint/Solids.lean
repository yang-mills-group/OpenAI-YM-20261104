include hg hg' hm' ht hQ
lemma obligates (he:0≤t2) : (R0).Paid w R'.p.B t2 (Week.maxFee S.ratio.count m Hp X0 t2 θ' *κ*g₀):=by
    refine ⟨fun i=> ‖Tx i‖*(2*(g₀*Week.pack X i.val.fst w)),?_,?_,?_⟩; rotate_left
    · intro i x z hz; exact debts X T w hw hq B y H Hp D0 M0 hβ Kc hm W' U' X0 ZL hS i x z hz
    · have hw'(i:Job X Hp S U): Poly.toll w (F' i.val.fst)*(‖Tx i‖*(2*(g₀*Week.pack X i.val.fst w))) = 2*(g₀* Week.pack X i.val.fst w):=by change Poly.toll w _ * (‖Patrol.price X i.val.fst w i.val.snd‖*(2*_))=_; rw [← mul_assoc,Patrol.worth X _ w hw,one_mul]
      have hm:= Week.charge X w hw R'.p S Hp X0 θ' hg' hm' hm he ht hg hQ
      convert hm using 1 <;> first | rfl| (ext1 i; exact hw' i)
    intro i; exact mul_nonneg (norm_nonneg _) (mul_nonneg zero_le_two (mul_nonneg hg (Week.strict X _ w hw).le))
