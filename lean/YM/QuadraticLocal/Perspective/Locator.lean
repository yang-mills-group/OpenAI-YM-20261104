lemma issued : Nonempty (Locator.Calendar (N:=N) R hk D Q π Γ hℓ V₁ (U:=U) e F₁):= by
 let X' := U₁; have h':X'.beta=U.beta:=rfl
 have hp':=lodged R hp
 obtain ⟨K,hK⟩:= Tracks.hires (U:=X') R hℓ hz U.beta h' hp' hw; have hF:= V₁.studied
 have he:= PriceCompiler.beta_eq R.alloy.B.valid i; obtain ⟨T',hT'⟩:= headed R hk D Q π Γ hℓ V₁ e hp T₁ hT -- order
 have he': e ≤ AllOrder.High.serving (betaF G (Φ i) L_):=he ▸ hσV
 obtain ⟨U',s₁,ℓ₀,hE⟩:= WheelP.coming D Q R.alloy R.kit hP.employed.station.pledge g hz (hx) Θ₁ hF U.beta hw h' hp' T' he' (he ▸ hT') K hK Ψp F₁ -- transport he
 have hv : Arrival D Q R.alloy R.kit hx Θ₁ U.beta K F₁ U' s₁ ℓ₀ Yφ:= by rw [he]; exact hE
 exact ⟨⟨U',s₁,ℓ₀,K,hK,hv, WheelP.compensated D Q (A) (F) hP.employed.station.pledge g hz hx Θ₁ hF _ hw _ _ _ _ _ _ hv hP.employed.bears⟩⟩ -- infer hg

