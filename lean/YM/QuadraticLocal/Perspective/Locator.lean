   rw [← V₁.ticket]; let hv : U.p=Wp:=hp.point; have hC : Burn.Candor U.p U.activities (Set.range T₁.model) (Burn.silver Λ) e:=by rw [hv]; exact hT
   have ht:= Sunday.Filing.occupied U (hp.valid.labels) T₁ hC; exact ⟨Z₁,Eq.mp (congr_arg (fun p:BudgetPoint=> Burn.Candor p (U₁).activities (Set.range (Z₁).model) (Burn.silver Λ) e) hv) ht ⟩ -- use Eq.mp!
