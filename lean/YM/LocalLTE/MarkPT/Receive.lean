lemma whereX (i:ℕ) (h: (Pℓ).H i ≠ 0) : ∃ x:Fan.Metering M H X₁ Qt b',∃ y:Fan.Metering M' H Y₁ Qt b',(eX x=i) ∧ reporter M H X₁ Qt b' x=reporter M' H Y₁ Qt b' y ∧
      (Pℓ).support i=(Pν).support (eY y)∧ (Pℓ).rays i=(Pν).rays (eY y)∧ (Pℓ).H i=(Pν).H (eY y):=by
    by_cases he':i∈ Set.range eX; swap; · exact (h (by unfold Fan.ghost Fan.opalescence; dsimp only; exact blank _ _ he')).elim
    obtain ⟨u,rfl⟩:=he'; obtain ⟨z,hz⟩:=u; rcases z with ⟨⟨z,b⟩,k⟩
    let a:IQ:=⟨(⟨z,b⟩,k),hz⟩; obtain ⟨ht,h1,h2⟩:= Fan.shelf M H rA P' X₁ Qt k' b' v' C (fun _ _=>0) a
    have hu: (Pℓ).H (eX a) = Fan.chimes M H rA P' Qt k' a.val.1 a.val.2:= h2
    change (Pℓ).H (eX a) ≠0 at h; rw [hu] at h
    let i:=a.val.1
    have hF: Candor M i.1 i.2 q n r₀ A' :=by
       apply he i; intro he; apply h; unfold i at he; unfold Fan.chimes; rw [he, show Complex.ofReal ∘ (0:Config G c→ℝ)=0 from funext fun _=> Complex.ofReal_zero,smul_zero]
    let W:=Fan.recloak M H z b q n r₀ A' hF M' hm; let j:Stars H M':= ⟨z,W⟩
    have hV:=choirT M H z b q n r₀ A' hF M' hm
    have hB: X₁ i= Y₁ ⟨z,W⟩:=by unfold sitesP; rw [if_pos (show fitsP M H q n r₀ A' i from hF),if_pos (show fitsP M' H q n r₀ A' j from hV)]
    have he':k.val.image b'⊆ Y₁ ⟨z,W⟩:= hz.2.trans hB.le
    have hA: Fan.chimes M H rA P' Qt k' ⟨z,b⟩ k=Fan.chimes M' H K' Q' Qt Zv (⟨z,W⟩) k:=by
       unfold chimes; rw [notesJ M H z b q n r₀ A' hF rA hr Qt k' M' hm K' Zv hζ hr', hs ⟨z,b⟩ hF]
    let v:IΥ:=⟨(⟨z,W⟩,k),hz.1,he'⟩; obtain ⟨hx,hV,hK⟩:= Fan.shelf M' H K' Q' Y₁ Qt Zv b' v' C (fun _ _=>0) v
    have ht:(Pℓ).support (eX a)=X₁ a.val.1:= ht; have hx': (Pν).support (eY v) = Y₁ v.val.1:= hx
    refine ⟨a,v,rfl,rfl,ht.trans (hB.trans hx'.symm),?_,?_⟩
    · exact (show (Pℓ).rays (eX a)=k from h1).trans (show (Pν).rays (eY v)=k from hV).symm
    exact hu.trans (hA.trans (show (Pν).H (eY v)=Fan.chimes M' H K' Q' Qt Zv v.val.1 v.val.2 from hK).symm)
