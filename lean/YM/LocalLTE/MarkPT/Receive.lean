lemma cables (U:E→ℂ) : Infra H Qt (Port.augment (Pℓ) U) (Port.augment (Pν) U) IQ IΥ eX eY B₀ B₂:=by
    let T (i:I₀)(j:I₁): Prop:=∃ x y,eX x=i.val∧ eY y=j.val∧ B₀ x=B₂ y
    have ht(i:I₀):∃ j:I₁,T i j ∧ (Pℓ).rays i=(Pν).rays j.val ∧ (Pℓ).H i=(Pν).H j∧ (Pℓ).support i.val=(Pν).support j.val:=by
        obtain ⟨x,y,hx,hy,hq,hR,hE⟩:= Fan.whereX M H q n r₀ A' rA hr l₁ Qt k' b' M' hm K' Zv hζ hr' P' Q' C v' hs he i i.property
        exact ⟨⟨eY y,hE ▸ (show (Pℓ).H i≠0 from i.property)⟩,⟨x,y,hx,rfl,hy⟩,hR,hE,hq⟩
    choose f hf hR hF ht using ht
    have hX : Injective f:=by
       intro i j H'; obtain ⟨x,y,hx,hy,hv⟩:= hf i; obtain ⟨u,v,hu,hk,hg⟩:= hf j
       have he: y=v:= (eY).injective (hy.trans ((congr_arg Subtype.val H').trans hk.symm)); have ht:x=u:= Fan.repr_inj M H X₁ Qt b' (hv.trans ((congr_arg B₂ he).trans hg.symm))
       exact Subtype.ext (hx.symm.trans ((congr_arg eX ht).trans hu))
    have hI : Surjective f:=by
       intro j; obtain ⟨v,w,hx,hV,hP,hR,hE⟩:= Fan.whereX M' H q n r₀ A' K' hK l₁ Qt Zv b' M (fun i hv=> (hm i hv).symm) rA k' (fun i hv=> (hζ i hv).symm) (fun i hv=> (hr' i hv).symm) Q' P' C v' (by intro i hh; let u:=recloak M' H i.1 i.2 q n r₀ A' hh M (fun i hv=> (hm i hv).symm); let v:Stars H M:= ⟨i.1,u⟩; have he:=hs v (choirT M' H i.1 i.2 q n r₀ A' hh M (fun i hv=> (hm i hv).symm)); exact he.symm) hY j.val j.property -- auxSym
       let b:I₀:= ⟨eX w,hE ▸ (show (Pν).H j.val≠0 from j.property)⟩; obtain ⟨u, y,hy,hD,hP⟩:=hf b
       have hu:u=w:= (eX).injective hy; have ht:v=y:= Fan.repr_inj M' H Y₁ Qt b' (hV.trans ((congr_arg B₀ hu.symm).trans hP))
       exact ⟨b,Subtype.ext (hD.symm.trans ((congr_arg eY ht.symm).trans hx))⟩
    exact ⟨rfl,rfl,Equiv.ofBijective _ ⟨hX,hI⟩, fun i=>⟨hF i,hR i,ht i,hf i⟩⟩
end list
