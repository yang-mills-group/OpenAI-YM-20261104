lemma ornate : RootedH N m n u S hm hv Qt T1 v Y Kh ζ' Φ Ψ X' Ψ':=by
   have ht(i)(h:E₁ i): Y.menu i=X'.menu i ∧ Ψ i= Ψ' i:=by
       rcases i with i|i
       · exact ⟨congr_fun (congr_arg Petunia.menu hT) i,congr_fun hX i⟩
       simp [Port.star] at h
   have he i (h:E₁ i): χM i=χX i:= congr_arg (fun j=> j.M) (ht i h).1
   have h₁ i (h:E₁ i): rM i=sX i:= congr_arg (fun j=> sumFee j bw) (ht i h).1
   have h₂ i (h:E₁ i): ϑ i=bX i:= congr_arg (fun j=> MergeProof.Menu.sing j bw) (ht i h).1
   have h₃ i (h:E₁ i): Ψ i=Ψ' i:= (ht i h).2
   have hU (i:V):0<bw i:= Real.rpow_pos_of_pos (zero_lt_one.trans_le (Peer.ge (H:=H))) _
   have hx i:0≤rM i:= MergeProof.Menu.timed _ hU; have hy i:0 ≤ sX i:= MergeProof.Menu.timed _ hU
   constructor
   · intro z; unfold showPT Fan.registryPt Fan.shiftedBranch
     apply Fan.cables χM f! J' p W' E₁ rM hx bc Qt ϑ oζ χX he sX bX h₁ h₂ _ _ (R0) v _ _ _ hy
     · intro i hh; simp only [Pi.smul_apply]; apply congr_arg (_ • ·); exact Fan.matchPX z χM f! Chi.canonical i.1 i.2 J' p W' E₁ hh bc h0 χX he H.κ D₀' Nh ℓ Φ Ψ Ψ' h₃ _ _ -- order. s argument should z
     all_goals
         intro i h; by_contra hh; apply h; unfold portfolio; simp_rw [Pi.smul_apply]; split
         next ht=> exact False.elim (hh ht.1)
         next=>rw [smul_zero]
   intro i; unfold modePt rootSection
   refine Fan.cables χM f! J' p W' E₁ rM hx bc Qt ϑ oζ χX he sX bX h₁ h₂ _ _ (R0) v (?_) ?_ ?_ hy 0 -- order conclude with Port.augment 0 rfl
   · intro j h; simp only [Pi.smul_apply]; apply congr_arg (_ • ·); exact (Fan.matchP B₀' χM f! Chi.canonical j.1 j.2 J' p W' E₁ h bc h0 χX he H.κ D₀' Nh ℓ Φ Ψ Ψ' h₃ ρ _ _).2 -- s order! maybe s argument before B.C
   all_goals
       intro i h; by_contra hh; apply h; unfold resMode; simp_rw [Pi.smul_apply]; split
       next ht=> exact False.elim (hh ht.1)
       next=>rw [smul_zero]
