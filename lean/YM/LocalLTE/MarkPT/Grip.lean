lemma tunes(hA:(F c0).Active)(hD:(δ').Active)(hV:(Qm).Active) {α ε d f a:ℝ} (h₀:(F c0).Radial wp a α 0 ν) (h₁:(δ').Radial wp 0 ε d ν) (h₂: (Qm).Radial wp 0 f 0 ν) :
    let B:= F c1; let Y:= ξ'; Fan.Tabs P Qt M' B Y ∧ B.Active ∧ Y.Active ∧ B.Radial wp a (α+f) 0 ν ∧ Y.Radial wp 0 (ε+f) d ν :=by -- notation parsing 
    intro B Y; let F0:= F c0; let Y0:= δ'; have hi: InInk P (F0) B (Qm):= ⟨rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl⟩
    have hz: InInk P Y0 Y (Qm):=⟨rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl⟩
    let X:= viewG M H q n r₀ A' l w Qt kp b i P -- order O.No include hw hx.
    have hΦ:Y.H= Y0.H + (1:ℂ) • (Qm).H:= by rw [one_smul]; change X (p0-c1)= X (p0-c0)+X (c0-c1); rw [map_sub,map_sub,map_sub]; abel
    have hΨ:B.H= F0.H+(-1:ℂ) • (Qm).H:= by rw [neg_one_smul]; change X c1=X c0+ - X (c0-c1); rw [map_sub]; abel
    refine ⟨⟨rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl,(map_sub X p0 c1).symm⟩,InInk.acts _ _ _ _ hi _ hΨ hA hV,InInk.acts _ _ _ _ hz _ hΦ hD hV,?_,?_⟩
    · simpa only [norm_neg, norm_one,one_mul] using InInk.pay _ _ _ _ hi _ hΨ hA hV h₀ h₂
    simpa only [norm_one,one_mul] using InInk.pay _ _ _ _ hz _ hΦ hD hV h₁ h₂
