lemma springB : EpochX N m n u S hm hv Qt T1 v Y ε' Kh ζ' Φ Ψ V₁:=by
    let X' :=B₀';
    have hb:= heightB N m n u S hm hv Qt T1 v Y e' ε' Kh ζ' Φ Ψ h hY hΨ hΦ
    have hh :=hY.showZ.error.pure; have hx:0 < v₀:= hY.showZ.error.factor; have hi:= hB0; have hU: (B).supportExponent+1 ≤ (R.expense D₀ D₁|>.earn) :=by
       rw [(show (B).supportExponent= _ from Rain.jersey (m:=m) (A:=A)|>.2.2.1)]; linarith only [(R.pledging.agenda D₀ D₁ (step_paid (c) m)|>.1)]
    refine ⟨hb,?_,fun z h'=> Fan.fabricP χM f! Chi.canonical J' p W' E₁ Φ Ψ bc cX ℓ h0 ε' rM B s0 Nh D₀' H.κ _ κ' H.paid.choose_spec ζ' (R0) Qt ϑ oζ v hb z h',fun t ht=> ?_ , rfl,rfl,fun u t ht=>?_,fun i=>?_⟩ -- order
    · have hx: Scene.Opens (R1) W' D' p Kh H.κ α Φ:= (S').leadIn ▸ hΦ
      have h':ZB=(fun i=> Fan.forecastPT χM f! Chi.canonical J' p W' E₁ Φ Ψ cX ℓ H.κ D₀' Nh i X'):= funext fun j=> Fan.votesP χM φ f! Chi.canonical J' p W' E₁ Φ Ψ cX ℓ D₀' Nh H.κ j (fun i hi=> hx.matchesAt i hi) hΨ.pressed
      unfold overZ Fan.shiftedBranch; rw [div_self (pow_ne_zero _ hi.1.ne'), one_smul]; exact congr_arg (fun i=> (QX i).H) h'.symm -- order
    · exact Fan.loaded χM f! Chi.canonical J' p W' E₁ Φ Ψ bc cX ℓ h0 rM s0 Nh D₀' H.κ κ' ζ' (R0) Qt ϑ oζ v t ht ρ
    · exact Fan.torn χM f! Chi.canonical J' p W' E₁ Φ Ψ bc cX ℓ h0 rM s0 Nh D₀' H.κ κ' ζ' (R0) Qt ϑ oζ v u t ht
    have hP:(R0).p=(B):=rfl
    obtain ⟨hA,hδ,hm'⟩:= Fan.givenTax χM f! Chi.canonical J' p W' E₁ Φ Ψ bc cX ℓ h0 ε' rM B s0 Nh D₀' H.κ _ κ' H.paid.choose_spec ζ' (R0) Qt ϑ oζ v rfl hB0 hb bw (fun i=> MergeProof.Menu.timed _ hh) hh (fun i=> MergeProof.Menu.paid _ hh) hP ((le_add_of_nonneg_right zero_le_one).trans hU) i hx -- order check
    refine ⟨hA,?_,hm',rfl,rfl,rfl,rfl⟩
    apply Coterie.hornB N m n u S hm hv Qt e' ε' α Kh ζ' A₁ V₁ h hc i hx0 (cι i s0) -- order η
    obtain ⟨hr,hx,-⟩:= Rain.jersey (m:=m) (A:=A)
    rw [hr,hx] at hδ; exact hδ
