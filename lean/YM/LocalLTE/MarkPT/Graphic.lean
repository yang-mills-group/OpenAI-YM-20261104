    shifted : ∀ (u:Zι) (t:ℝ), t∈ Weft.clip → (cι u t).H= (t^u.1.val/t^(κ'+ζ')) • (bι u).H
    price (i:Zι): (cι i s0).Active ∧ (cι i s0).Radial (fun _=>1) 0 (Y'^((((κ':ℝ)+ζ' - (i.1.val:ℝ) - (i.2.val:ℝ))/2)+(ε'+ε'))) 0 v₀ ∧ (Price.genre i < κ'→ (bι i).H=0) ∧ ( (cι i s0).marks=(Q#).plan.marks ∧ (cι i s0).entries=0 ∧ (cι i s0).rays=(Q#).plan.rays ∧ (cι i s0).support=(Q#).plan.support)
