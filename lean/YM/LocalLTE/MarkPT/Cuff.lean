lemma cutPalm (f: B₁ → ℝ → Pot G (A.B.a.S.side (m+1) n))(h:T0.Banner N m n u S hm Qt T1 A₁ f)(g: B₀→ℝ→ Pot G (A.B.a.S.side (m+1) n))(hy:g ∘ Sum.inl=f)(hp:Y.flowers N m n S hm Qt T1=T0): RouteQ.CanB N m n u S hm Qt T1 Y g A₁:=by
    subst T0 f
    refine ⟨fun i hi=> ?_,fun i hi=> ?_⟩
    · rcases i with i|i; exact h.turns i; simp [Port.star] at hi
    rcases i with i|i; exact h.wants i; simp [Port.star] at hi
