lemma coverP (ht: Petunia.Ages N m n u S hm Qt T1 T0 γ):∃ Φ:Port.liners (Wτ).plan d→ℝ→ Pot G (A.B.a.S.side (m+1) n), Banner N m n u S hm Qt T1 T0 A₁ Φ ∧ ∀ i, TurnMark (T0.menu i).M H.κ d J' (Φ i) (T0.board i):=by
    let F:= S'; let p:= q0
    have hx:= F.leadIn
    have hb : (R1).beta ∈ Icc (Y'/2) (2*Y')∧ (R1).p.threshold=Pressure.fiery G (xt m) (L m):= hx ▸ F.career.bandPass H W hm F.honor _ ρ M F.deed
    choose f h₁ h₂ h₃ using fun i=> h.visits _ (R1) hb.1 hb.2 d _ _ (ht.tunes.leads i) -- order
    exact ⟨f, ⟨h₁,h₃⟩,h₂⟩
