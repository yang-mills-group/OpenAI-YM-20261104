structure Audience (a0:ℝ)(V₁:ℝ) : Prop where -- use V₁ explicit cost in signature carefully!
     spend : (RouteQ.Loyal N m n u S hm hv Qt T1 v Y Kh ζ' Φ Ψ a0 (Coterie.tip (ρ:=ρ) (Wz:=Wz) m u ε' Kh ζ' V₁))
     secure : (G').Active
     actual: ∀ U:Config G (A.B.a.S.side m n), (G').density U= (Z').push (Pτ).beta T1.sure.density U
     tuning : ∀ U:Config G (A.B.a.S.side m n), (G').density U= (Z').push (Pτ).beta (Pτ).eval 1 • ((Career.shear Tτ Qt G').density U)
     sent: (G').Radial (fun _=>1) ((μ')*a0) (Y'^Λℓ * (Y'^aust)) E! v₀
     error: (A').Radial (fun _=>1) 0 (E!+ (gStep (Pτ).beta)^e') E! v₀
     notes : (L').Radial (fun _=>1) ((μ')*a0) (Y'^Λℓ *(Y'^aust+1)) 0 v₀
     sweep U : flags ((bι).threshold) U=∅ → let p:= (Z').push (Pτ).beta (Pτ).eval U; let w:= (Z').push (Pτ).beta T1.sure.density U; let g:= (G').extra U; let z:= (L').extra U;0 < p ∧ g.part Qt.quiet=0 ∧ p⁻¹ • w= Marker.Poly.pass g∧ Poly.price (fun _=> 1) (g-z) ≤ CB*( E!+εℓ)∧ Poly.price (fun _=>1) (p⁻¹ • w - Marker.Poly.pass z) ≤ Career.aerial CB (a0+2)*(E!+εℓ)
