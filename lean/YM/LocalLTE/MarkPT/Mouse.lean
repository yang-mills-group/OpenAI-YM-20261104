lemma starHit : RouteQ.Audience N m n u S hm hv Qt T1 v Y e' ε' Kh ζ' Φ Ψ a0 V₁:=by
   let p0:= RouteQ.tourA N m n u S hm hv Qt T1 v Y; let N':= (Q0); let T0:= G'; let T':= L'; let U:= v₀ -- `T'`?
   have hu:= artery N m n u S hm hv Qt T1 v Y e' ε' Kh ζ' Φ Ψ h hY hΨ hΦ hB0 -- order
   have ht : (G') = p0.sure:= hu.views -- notation mistake T0=G';
   have hp:= hY.showZ; have hP:= Y.forted N m n u S hm hv Qt T1 v hY
   have hv':= Display.brisk N m n u S hm hv Qt T1 a0 p0 hP hc ha -- order edit
   obtain ⟨hh,hκs,hZ,hδ,hP',hz0⟩:= Coterie.town N m n u S hm hv e' ε' α Kh ζ' A₁ V₁ h
   have hD := hu.leases.2; have hβ:= hu.error
   have hθ0:0 ≤ σ':= add_nonneg S.trades (by positivity); let V₀:=Y'^Λℓ; have h₀:0 ≤ V₀:= Real.rpow_nonneg (zero_le_one.trans hh) _
   let z₀:= E! + εℓ; let tℓ:= z' + dℓ
   have hζ:V₀ * tℓ ≤ z₀:=by unfold tℓ; rw [mul_add]; exact add_le_add hδ hP'
   have he' := Port.honours _ CB hc Y' σ' hθ0 hh hu.ready
   have Hδ:= Port.honours _ CB hc Y' σ' hθ0 hh hβ
   rw [mul_zero] at he' Hδ
   refine ⟨hu,ht.symm ▸ hv'.picture.boots,fun i=> ?_,fun i=>?_ ,ht.symm ▸ hv'.trueA,Port.budgetUp _ _ Hδ le_rfl hζ (mul_le_mul_of_nonneg_right hδ hβ.factor.le),?_,fun V h=>?_⟩
   · exact ht.symm ▸ (hv'.picture.trueE i).symm
   · change (G').density i= _ • (Career.shear _ _ (G')).density i; rw [ht]; exact hv'.normal i
   · refine Port.budgetUp _ _ he' le_rfl (mul_le_mul_of_nonneg_left (?_) h₀) le_rfl
     have hh:= add_le_add_right hZ (Y'^aust); linarith only [hh]
   obtain ⟨hN,hq,hΩ,hδ,hp⟩:= hv'.sweep V h
   have he:= hu.leases.1; have hx:Y'^aust≤1:= Real.rpow_le_one_of_one_le_of_nonpos hh (by norm_num [aust]); have hv:0≤ tℓ:= add_nonneg (Real.rpow_nonneg (zero_le_one.trans hh) _) hκs
   obtain ⟨hH,hU⟩:= Port.hymn G' L' A' bw V he hD hu.ready hβ hv hZ hu.split (a0+2) (by linarith only [hZ,hx]) (by linarith only [ha]) CB hc
   have hz₂:=Port.beaconY _ Y' σ' (CB:ℝ) CB hh hθ0 hc (by positivity) hH hζ
   have he₀:0≤ Career.aerial CB (a0+2):=by unfold Career.aerial; positivity
   have hz₃:=Port.beaconY _ Y' σ' _ CB hh hθ0 hc he₀ hU hζ
   refine ⟨hN,ht.symm ▸ hq,ht.symm ▸ hΩ,hz₂,?_⟩; rw [hΩ]; exact (show _ from ht ▸ hz₃) -- ht.symm? z3 terms have plan.
