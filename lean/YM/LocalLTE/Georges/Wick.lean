lemma tea : Season ((F.panelX H W k' tag).pours (F.tap H W k' tag k x)) (raiser (raiser B)) Vꞌ o κ₀ z₀ ((raiser (raiser (B))).supportExponent+1):=by
  obtain ⟨hr,hq,hE,hcost,hP⟩:= verge M V₀ TZ hκ (raiser (raiser B)) F.holds.base fU (d!).reg (tap').regular rfl (raindance M V₀ TZ (hC) hp) ho rfl
  refine ⟨hr,fun i hv=> ?_,hE,hcost,?_⟩ -- permits defeq?
  · have h' := hq i hv; exact ⟨h'.sym,h'.symtest,h'.meas,h'.meas_test,h'.reads,h'.reads_test,h'.permit⟩
  obtain ⟨b,hu,hv,hZ⟩:= hP
  have hi : ((raiser (raiser B)).supportExponent+1) ≤ (Z).earn:= by
    change (B).supportExponent+1+1+1 ≤ _; have he':= R.pledging.agenda _ _ (step_paid A.B.a m)|>.1; rw [Rain.jersey (A:=A) (m:=m)|>.2.2.1]; linarith
  change Ac.Hit (fun i=>(((d!).pours tap').forced i).support) (raiser (raiser B)).B b (Z).earn z₀ at hv
  refine ⟨b,hu, fun i=> ?_,hZ⟩; apply budget_mono (hv i)
  · intro i; split; exact mul_nonneg (hu _) (Real.exp_pos _).le; rfl
  intro i; split
  next h=> exact mul_le_mul_of_nonneg_left (Real.exp_monotone (mul_le_mul_of_nonneg_right hi (by positivity))) (hu _)
  rfl
