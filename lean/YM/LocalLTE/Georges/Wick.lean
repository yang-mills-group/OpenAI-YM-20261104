lemma touts (U:Config G (A₀))(r:ℝ)(hc:|r| *κ₀≤1) : (black (Y₁).activities (c₀ r)).gas B U=(black ((d!).pours tap') (Vꞌ r)).gas B U*Real.exp (∑' i,(tap').logarithm i U)*Real.exp (∑' i,(H₁).logarithm i U):=by
    have ht:= F.tea H W k' tag (k:=k) x M o ho hR TZ hp hκ
    have hf:= F.imagesP H W hm k' tag x hx hk hF M o ho hR TZ h₇ hp hκ
    have hu:= F.memories H W hm k' tag x hx hk hF
    let rx:= Passage.gathered (F:=Marlin.hak d!) (Mallow.hearth ht hu.1 r hc) U -- Care `.Passage` name occlusion
    have he: (black ((A').pours H₁) (m₀ r)).gas B U=(black ((d!).pours tap') (Vꞌ r)).gas B U*Real.exp (∑' i,(tap').logarithm i U):= rx.tsum_eq
    rw [← he]; exact final.slant hf (F.canopied H W hm k' tag x hx hk hF G') r hc U
