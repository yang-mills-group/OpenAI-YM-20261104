lemma imagesP : Season ((F.barn H W k' tag).pours (H₁)) (raiser B) (canvasZ H F W k' tag x M k) o κ₀ st ((raiser B).supportExponent+1):=by
    have ht:= h₇ (J) (I) (step_paid A.B.a m) _ (A.B.valid.pays m)
    have hf:= F.tea H W k' tag (k:=k) x M o ho hR TZ hp hκ -- order
    obtain ⟨h',hy,hκ'⟩:= F.memories H W hm k' tag x hx hk hF
    have hh: z₀ ≤ Real.exp (-(off').mark L u x₀):= mul_le_of_le_one_right (Real.exp_pos _).le (by linarith only [hp.gains])
    have hα:0 ≤ z₀:= by obtain ⟨-,_,i,hi,h⟩:= hf.burn; exact budget_nonneg (h.1 (0:Site A₀)) -- pattern h
    obtain ⟨η,hη⟩:= ht.1 z₀ _ hα hy hκ' hh; obtain ⟨he,hh,hp''⟩:= Mallow.harvest hf h' hη (Marlin.hak (d!))
    exact ⟨he,fun i ht=> let h':= hh i ht; ⟨h'.sym,h'.symtest,h'.meas,h'.meas_test,h'.reads,h'.reads_test,h'.permit⟩,hp''⟩
variable (G':G.Simple)(hX: Trail.Keeps H (F.hearth H x) tag p k')
include J' G'
lemma liftedA : Season (Y₁).activities (raiser B) (c₀) o κ₀ (straw u L G x₀) (raiser B).supportExponent:=by
    have hf:= F.canopied H W hm k' tag x hx hk hF G'
    have hz:= F.leafT H W hm k' tag x hx J' hk hF G'
    have hh:= F.imagesP H W hm k' tag x hx hk hF M o ho hR TZ h₇ hp hκ
    have ht : Time.Same (X.p.profile I) (B):= by rw [← params_eq A.B.valid]; exact ⟨rfl,rfl,rfl⟩
    obtain ⟨η,hη⟩:= h₇ (J) (I) (step_paid A.B.a m) x₀ (A.B.valid.pays m)|>.2 B rfl rfl ht _ (UVNext.CouplingReset.within_alpha («B»:=A.B) hm) _ hz.1 hz.2
    exact Mallow.final.slopes hh hf hη -- issue branch casts
lemma lowA : Season (Y₁).activities B (c₀) o κ₀ (straw u L G x₀) (A.B.a.budget m).supportExponent:=by
    have hT:= F.liftedA H W hm k' tag x hx J' hk hF M o ho hR TZ h₇ hp hκ G'
    refine ⟨hT.term,fun x hx=> let h':=hT.permit x hx; ⟨h'.sym,h'.symtest,h'.meas,h'.meas_test,h'.reads,h'.reads_test,h'.permit⟩,?_⟩
    obtain ⟨h₀,hv,i,he,h,hy⟩:=hT.burn; refine ⟨h₀,hv,i,he,fun a=>budget_mono (h a) (fun b=>?_) (fun b=>?_),hy⟩
    · split; exact mul_nonneg (he _) (Real.exp_pos _).le; rfl
    split; next h=> exact mul_le_mul_of_nonneg_left (Real.exp_monotone (mul_le_mul_of_nonneg_right (le_add_of_nonneg_right zero_le_one) (by positivity))) (he _)
    rfl
