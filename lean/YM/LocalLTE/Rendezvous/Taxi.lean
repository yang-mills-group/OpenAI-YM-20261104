    have hp := Career.majesty H F W hm k' tag x hx J' hk hF χM rM r Z hM hh hX φ E₁ wA (fun i=> MergeProof.Menu.timed _ hy) hτ hA' (fun i hi=> ?_) cX Qt W' r₁ hy (fun i=>(hs' i).2) (fun i=>(hs' i).1) (fun i=> MergeProof.Menu.paid _ hy) oζ hh' v G' -- order syntax. Need output Leafs.Mind.
