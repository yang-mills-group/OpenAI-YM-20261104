    obtain ⟨hQ,_,_,he,hg⟩:= Dilation.banner Xa b' T (Dilation.roomy _ _ _ _) hu (Extra.Histories.forcedPos ..|>.le) hW ht (show 0 < δ from Graces.glyphBound (A.B.a) m |>.1) hh.1 hL0 P -- parameter.Rcheck
    have hl: E₀= ∑ i:Bool,XPre.lit i • prose (XPre.readLeaf C i):=by rw [Fintype.sum_bool]; change _= (1:ℂ) • _+_; rw [one_smul]; rfl
    have hl': w'=∑ i:Bool,XPre.lit i • entry (XPre.readLeaf C i):=by rw [Fintype.sum_bool]; change _=(1:ℂ) • _+_; rw [one_smul]; rfl
    let Q₀:= U.output; let eQ:=(M0).forced
    have hZ(i:Bool):0≤ ‖(z)*XPre.lit i‖*load (XPre.readLeaf C i):= mul_nonneg (norm_nonneg _) ((Leaf.profit _).trans (U.inPort.p.loMass _ _ (Leaf.profit _)))
    let B₀ i j X:= z*XPre.lit i*( (U.door).hinge (XPre.readLeaf C i) j X:ℝ)
    have hZ:= supplyLine U.door (U.opensV G' hm h2) (budget_finite hZ le_rfl)
    have h : (M0).forced=fun i U=>∑' j:Bool,B₀ j i U:=by
       funext i V; rw [tsum_fintype,Fintype.sum_bool]; change (z)*((↑(U.door|>.hinge C.live i V):ℂ)+ Complex.I*(↑(U.door|>.hinge C.pale i V):ℂ))=(z)*1* ((U.door|>.hinge (C.live) i V:ℝ):ℂ)+(z)*Complex.I* ((U.door|>.hinge (C.pale) i V:ℝ):ℂ); -- likely rfl tactic
       ring
    apply Exists.intro _ (XPre.challenge C h' ht' hl hl' ?_ he); refine hg.trans ?_; rw [show b'.forced= _ from h];congr 1
    funext P0 V; rw [Finset.sum_apply]; simp_rw [Finset.sum_apply];
