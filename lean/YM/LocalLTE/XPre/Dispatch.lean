             have hg:River.bulk Y' Va=0:=by rw [show River.bulk Y' Va=_ from Turf.subsist U p hΘ Bf Va,hh,map_zero]; rfl
             have h:= congr_arg (Port.scaleQ (!b)) hg
             dsimp only [River.bulk] at h; cases b <;> simp [Port.scaleQ,Complex.mul_re,Complex.mul_im] at h <;> exact h
