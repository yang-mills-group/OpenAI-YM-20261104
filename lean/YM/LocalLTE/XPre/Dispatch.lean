      apply mul_le_mul_of_nonneg_left (le_add_of_nonneg_left hAu) zero_le_two
    let q:Bool⊕Bool→Lotus.Leaf E:= Sum.elim Ay An; let f:Bool⊕Bool→ℂ:= Sum.elim XPre.lit XPre.lit; let P:Bool⊕ Bool→Prop := fun i=> i.isLeft; let Ht:= 2*E0
    have hQ:= XPre.shards hLp hp hr' hE U.tunesCanvas (U.opensV G' hm h2) (show (∑ i:Bool, (‖XPre.lit i‖*load (Ay i)+ ‖XPre.lit i‖*load (An i)))≤ 2*(α'+E0) from (by rw [Finset.sum_add_distrib,hz,hv];rw [mul_add]))
    refine ⟨Bool⊕ Bool,inferInstance, q,f,muX,P,hQ,⟨fun i=> ?_,Summable.of_finite,?_⟩,?_⟩
    · unfold tollNon;split; rfl; exact mul_nonneg (norm_nonneg _) ((Leaf.profit _).trans (E.p.loMass _ _ (Leaf.profit _)))
    · rw [tsum_fintype,Fintype.sum_sum_type]; unfold tollNon; dsimp only [P,f,q]; simp only [Sum.isLeft_inl, Sum.isLeft_inr,↓reduceIte,Bool.false_eq_true,Finset.sum_const_zero,zero_add];exact hv.le
    intro i hi; rcases i with i|i; swap; · exact False.elim (Bool.noConfusion hi)
