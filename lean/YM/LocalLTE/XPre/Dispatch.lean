    let he: Turf.Holds U p Zf δg uG:= ⟨⟨Next.Foundations.regular_sub Bc.fits.smooth Bf.fits.smooth, Bc.fits.anchor, hUe.1,hUe.2⟩,hp₁⟩
    let Y':= applicant U p hΘ Bf; let N':= applicant U p hΘ he
    have hψ (i): River.bulk M i= River.bulk Y' i+River.bulk N' i:=by
       unfold M Y' N'; rw [Turf.subsist, Turf.subsist,Turf.subsist]; unfold δg; rw [map_sub,Pi.sub_apply]; abel
    let Ay:= XPre.readLeaf Y'; let An:= XPre.readLeaf N'
    have hE(b)(i): (A b).ingredient i=(Ay b).ingredient i+(An b).ingredient i:=by
        have hv:= congr_arg (Port.scaleQ (!b)) (hψ i)
        dsimp only [River.bulk] at hv
        cases b <;> simp [Port.scaleQ,Complex.mul_re,Complex.mul_im] at hv ⊢ <;> exact hv -- b type? Bool.
    let o (Zc:Cloud U.inPort):= ∑ i:Bool, ‖XPre.lit i‖*load (XPre.readLeaf Zc i)
    have hs(Zc: Cloud U.inPort): o Zc =2*load Zc.live:=by
       unfold o ;rw [Fintype.sum_bool]
       rw [show load (XPre.readLeaf Zc false)=load Zc.live from (show load Zc.pale=load Zc.live from (by unfold load;rw [Zc.turnout,Zc.rates])),show ‖XPre.lit true‖=1 from norm_one,show ‖XPre.lit false‖=1 from Complex.norm_I,one_mul,one_mul,two_mul];rfl
    have hz: ∑ i:Bool,‖XPre.lit i‖ * load (Ay i) = 2*(α'):= by change o Y'= _; rw [show _= _ from hs Y',show load Y'.live=α' from priceA U p hΘ Bf]
    have hv: ∑ i:Bool, ‖XPre.lit i‖ * load (An i) = 2* E0:= by change o N'= _; rw [show _= _ from hs N',show load N'.live=E0 from priceA U p hΘ he]
    have hAu:0≤ α':=mul_nonneg (Real.exp_nonneg _) ha.earn
    have hp (b): (A b).turn=(Ay b).turn:=by cases b <;> rfl
    have hr' b: (A b).turn=(An b).turn:=by cases b <;> rfl
    let uZ:=(((D.L J).val)* radiusB Y) -- Y mac.T
    by_cases hh:Φ=0
    ·
      have hS b Va : (A b).ingredient Va=(An b).ingredient Va:=by
