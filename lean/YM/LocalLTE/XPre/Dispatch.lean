       have he : prose M.live+Complex.I • prose M.pale= maskLinear U.inPort.p.threshold Zf φ:=by funext x; exact Turf.subsist U p hΘ Bc x
       have hf : entry M.live+ Complex.I • entry M.pale= 0:=by rw [show entry M.live=0 from rfl, show entry M.pale=0 from rfl]; simp
       rw [← he, ← hf]; exact hK -- rewriting 0 global issue!
    let δg:= φ-Φ; have hy : Reads (hol G) 0 Zf (0: Labels.Label G p) δg:=by
       have hr:= Next.Foundations.reads_sub ((Next.Foundations.reads_null_iff ..).2 (show _ from ⟨Bc.fits.unit_null,Bc.fits.proj⟩)) ((Next.Foundations.reads_null_iff ..).2 (show _ from ⟨Bf.fits.unit_null,Bf.fits.proj⟩)); rw [sub_zero] at hr;exact hr
