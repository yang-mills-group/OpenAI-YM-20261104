    have hz : Qz.turn=.logKey S:= rfl; have he : U.inPort.activities.reg S=reg 0 _ (Bf.fits.anchor):=Blush.latch _ _ _ _ hΘ
    have hp: Qz.crest=Zf:=by change (U.inPort.activities.reg S).support=Zf; rw [he]
    obtain ⟨he',g,hV,hζ,⟨c,hP,hg⟩,j,hj',Z0',hZ⟩:= ha.analytic hh
    have hb':= Port.framesV Bf.fits.smooth Bf.may i; have hk':=Port.framesV hV hζ i
    have hα: Qz.weight=α:=rfl
    have hJ : (b' i) =Port.scaleQ i ∘ g + Port.scaleQ i ∘ (presented (localSection G p) 0 U.inPort.p.threshold c):=by rw [hg]; funext U;exact map_add ..
    have hP0: Qz.ingredient=RG.masked U.inPort.p.threshold Qz.crest (b' i):=by
       rw [hp]; funext Uq; change Port.scaleQ i (RG.masked _ _ _ _)=_
       by_cases hv:Healthy U.inPort.p.threshold Zf Uq
       · rw [masked_eq _ _ _ _ hv, masked_eq _ _ _ _ hv];rfl
       rw [masked_ne _ _ _ _ hv,map_zero, masked_ne _ _ _ _ hv]
    change XPre.Lamp U.inPort p κz h Xw Qz (b' i)
