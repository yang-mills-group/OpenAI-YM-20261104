lemma ripe : GrowsP M H p ϑ L₁ U ((1+(hpv:ℕ))^(p.power*p.order)*(Tp:ℝ)) Vt ϑ:=by
    have hG:= genuine M H χ q n k r₀ A' rA p hB l₁ C₁ hl L₁ aA D' hH hD hA he hY hW hU hx0 hx1 ha
    obtain ⟨t,hP,h',hK⟩:= hG.lights; let X:Stars H M→Support c:= ϑ; let Z:ℝ := 1+(hpv:ℕ)
    have he:1≤ Z:=by unfold Z; exact le_add_of_nonneg_right (Nat.cast_nonneg _)
    let K:= Z^(p.power*p.order); have hk:1 ≤K:=one_le_pow₀ he
    refine ⟨fun i=> K*t i,fun i=>mul_nonneg (zero_le_one.trans hk) (hP i),fun i=>⟨CouplingShape.reg_extend (h' i|>.1) (Fan.prosper M H q n r₀ A' l₁ hl _),fun j hj=> ?_⟩,?_⟩
    · by_cases hv:η₀ i; swap; · exact VerifiedReset.sup_le ((h' _).2 _ ((show ϑ i=reachability i.1 from if_neg hv) ▸ hj)) (le_mul_of_one_le_left (hP i) hk)
      have he: j∈neighbors hpv (origin M H i):=(show ϑ i=neighbors hpv (origin M H i) from if_pos hv) ▸ hj
      exact Fan.spokeR p (b:=Z) (by exact add_le_add_right (Nat.cast_le.mpr ((neighbors_mem ..).1 he)) _) (h' i|>.2 (origin M H i) (Fan.pinned M H i))
    let W':=(1+(hpv:ℕ))^(p.power*p.order)*(Tp:ℝ)
    intro x; have ht':SumBudget _ W':= budget_scale (show 0 ≤ K from zero_le_one.trans hk) (hK x)
    convert! ht' using 1; ext i; split <;> ring
