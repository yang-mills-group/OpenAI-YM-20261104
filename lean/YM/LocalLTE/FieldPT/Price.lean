lemma authentic : (charged V0.activities V!).Valid B (W₁+ e#) s₁ ∧ (charged V0.activities (V0.activities.E-V!)).Valid B (u#+e#) s₁ ∧ |(θ#)^2* (V0.beta - (R'.beta+γ+Price.poloDelta ((π') p) r PT θ#))| ≤ u#+e# :=by
    let A':= F.proposals H W k' R'; let p':= B
    let V1τ t:= F.voicePT H W hm k' R' Φ r κz M H' t
    let B':= θ#; let f i:=F.dawnPT H W k' Φ i B'; let f0:=Career.goals H F W k' tag x
    have h r (hr:r≤ p):= F.industry H W hm k' R' Φ _ κz M H' hG D0 hp r hr
    have hg:=F.envelopes H W k' R' Φ hp x H'.entry H'.inlet; have h₁:=H'.pride; have h₂:=H'.receipt; rw [hg] at h₁ h₂; let Z:=F.index H W k' tag k x
    have he:20< (A.B.a.S.side m n).val:=by
         have hp:= Z0; have hx:= Trail.breadth H W (m:=m) (n:=n); unfold Trio.base Trio.tent at hx; omega
    have hv:= (F.bandPass H W hm k' R' r M H'|>.1); have ht:= D0.bear _ hv; have hQ i (hi:i≤ p):= Price.AtlasC.taken B _ (h i hi|>.1) hG H.paid.choose_spec D0.one ht r
    have hV(s:Signed)(b:Site (A₀)):Nonempty (V0.activities.Moves s b):= H'.actual.bundle.valid.labels.moves .. -- edit
    obtain ⟨hh,hI⟩:=Price.alphaProject ϑ B R₀ (M:=p) V0.activities (Price.silt (a₀).clip R₀ ϑ Z p (delta ((ϑ).read Z)) γ f0) f V1τ hG he (by rw [← H'.outlet]; rfl) h₂ h₁ (fun i hi j=> (h i hi|>.1.payment).choose_spec.2 j|>.2 _ ht) (fun i hi j=>hQ i hi|>.2 j) (fun i hi=> (hQ i hi).1.cheaper (h i hi|>.2.1)) (by rw [← H'.outlet]; rfl) hV D0.pos
    · have he:= D0.funds B (by rw [← PriceCompiler.params_eq A.B.valid]; exact ⟨rfl,rfl,rfl⟩) R'.beta hv
      refine ⟨{hh with boundE:= Time.E_rises hh.boundE (add_le_add le_rfl he)}, {hI with boundE:= Time.E_rises hI.boundE (add_le_add le_rfl he)},?_⟩
      let V:= PT; let t:= F.chipK H W k' R' p; let u:= Price.poloDelta ((π') p) r PT θ#
      have hk: |B'^2*(V θ#-u)|≤ B'^e:=h p le_rfl|>.2.2.2.2
      have hz:|B'^2*(V0.beta-(R'.beta+γ+t))| ≤ u#:=by rw [abs_mul,abs_of_nonneg (sq_nonneg _)]; exact (mul_le_of_le_one_left (abs_nonneg _) (pow_le_one₀ ht.1.le ht.2)).trans H'.drift
      rw [show (θ#)^2*((V0).beta- (R'.beta+γ+u))= B'^2*(V0.beta-(R'.beta+γ+t))+B'^2*(V θ#-u) from (by rw [show t=V θ# from F.kinU H W k' R' Φ hp p x H'.entry H'.inlet le_rfl]; unfold B'; ring)]; exact (abs_add_le ..).trans (add_le_add hz hk)
