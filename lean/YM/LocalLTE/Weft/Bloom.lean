lemma sipping (d:ℝ){Θ:ℝ}(h:Avis D C W Jp Ip j κ d x₀ Θ) (i:Stars) (hm:m<N) : YM.LocalLTE.Weft.Arp (2+(p'+3)) j Θ (fun s=> (Boulevard.stillA (M.reader W κ d s i)) ∘ Boulevard.actual) := by
    let V:= A.B.a.clock; let Z:= G; let postY:=X'.posts i; have hA:= postY.laws.data; have hu:= A.B.support
    have he : V.hatBeta (m+1)=betaF G x₀ (D.L Jp):= (Application.clock_next A.B.a m 0).trans (congr_arg (betaF G x₀) (PriceCompiler.block_eq A.B.valid m))
    obtain ⟨ha,hb⟩:= h
    have hB' : V.loopCap (m+1) ≤ ConnectedActivityE6.loopBill G (D.L Jp) x₀:= by
       refine (coverBill A.B.a (m+1)|>.2).trans_eq ?_; change 2*V.monitor (m+1)=2*Delay.fineMonitor G (D.L Jp) _; unfold Calendar.monitor Delay.fineMonitor; rw [he]; rfl
    have hB : V.loopCap m ≤ ConnectedActivityE6.loopBill G (D.L Jp) x₀:= (coverBill A.B.a m).2.trans (Pane.brace _ ha)
    have hj := V.adm (m+1); have he':= hA.funds; let α:= γ; let K:= (A.B.a.budget (m+1))
    have hi := params_eq A.B.valid (m+1); have hQ:= params_eq A.B.valid m
    have hβ:K.threshold=Pressure.fiery G x₀ L:=by rw [← he'.length_eq]; exact postY.laws.intake.received.temp
    have hx':|α| ≤ cloak D Jp := Boulevard.coupling A N m hm
    obtain ⟨p,hp,hM,hK⟩:= presents D A ht hm (Urns.scene (C:=C) (m:=m) (A:=A) W i) (M.tree i) (Urns.bought W i (M.tree i) postY) -- hc table?
    obtain ⟨hM',-⟩:= payouts (R:= T (P₀ i)) (Before.Service.is_extension (M.shares i) hp) hM hK
    refine hb _ _ _ (Pane.orchestra A N (scene (C:=C) (m:=m) (A:=A) W i)) (M.tree i) (M.notes i) K hj (he'.patch rfl rfl) A.B.valid.kernel (Urns.bought W i (M.tree i) postY) (congr_arg RG.Stage.clip hi) (congr_arg RG.Stage.clip hQ) ?_ ?_ α (M.station i) hx' (M.shares i) hM' β (?_) hβ
    · rw [← hi]; exact {(hu.cap N _ hm) with two:= budget_loosen (hu.cap N _ hm).two hB'}
    · rw [← hQ]; exact {(hu.cap N _ hm.le) with two:= budget_loosen (hu.cap N _ hm.le).two hB}
    unfold Avis.yieldU; rw [← he'.length_eq]; exact postY.laws.intake.window
open YM.LocalLTE Weft
lemma aroma (d:ℝ){Θ:ℝ}(h:Avis D C W Jp Ip (pie j + 1) κ d x₀ Θ) (hm:m<N) (i: Site (A.B.a.S.side m n)) : Weft.Scene (cane i) κ z (2+(p'+3)) (pie j+1) (fun u => Urns.penned W M d κ u j i) (trimSum Θ):=by
    let n':= pie j+1; let P:= (2+(p'+3)); let V' (s:Stars) (x:ℝ):= (Boulevard.stillA (M.reader W κ d x s)) ∘ Slide.shape (Trio.pad (P') s) i ∘ soloV
    have he(s:Stars):Arp P n' Θ (V' s):=by
       let Z:= LocalLTE.FrameBox.Hall.lumen (G:=G) (Trio.pad (P') s) i
       refine ((sipping W X' M ht d h s hm).twisted (show ‖Z‖≤1 from Hall.focus ..)).adjust (fun x hx=> funext fun y=>?_) -- edit
       exact congr_arg (Boulevard.stillA (M.reader W κ d x s)) (Hall.sweep (Trio.pad (P') s) i y)
    let U(x:ℝ):= (inkO W M d i (κ:=κ) x) ∘ soloV
    have hU: Arp P n' (trimSum Θ) U:=by
       have hx:= Arp.sumQ Finset.univ _ _ (fun s _=> (he s).scales (Slide.ray s)) |>.scales (-1:ℝ); rw [abs_neg,abs_one,one_mul] at hx; apply Arp.adjust hx; intro v hv; funext y; unfold U inkO LocalLTE.Patch.mural; simp only [Function.comp_apply,Pi.neg_apply, Finset.sum_apply,Pi.smul_apply]; change (-1:ℝ)*_=-_; rw [neg_one_mul]; rfl
    exact Weft.Scene.spinner n' _ _ _ hU le_rfl
