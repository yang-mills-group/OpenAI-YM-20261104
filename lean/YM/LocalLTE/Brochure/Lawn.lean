-- move h preserving sums.cast.Y.Budget weight. open Annual.Aides.
lemma crux (a:ℝ)(ha:∀ i, wμ*‖X'.units i‖ ≤ a): DawnT (H:=H) (Wz:=Wz) (P0:=P0) (μ:=μ) N m n Qt X' b t R' v' Y a :=by
