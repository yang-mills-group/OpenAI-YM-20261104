     let v'' (i:V):= neat bt μ; have hP : wgt A m μ 0=Γℓ:=by simp [wgt,countB]
     have ht': R' ≤ Wz.degree 0 j' i'+1:=by rw [S.signs.stalk.start]; exact hq _ _ (step_paid (A.B.a) m)
     have hv: ∀ i:V,v'' i*‖X'.units i‖≤a:=by intro i; simpa only [hP] using ha i
     have hp:= Sp.career.sugary H Sp.sign hS a S.trades Qt X' hc hh Y hx hv _ ht' hE
     obtain ⟨hB,hΦ,hz⟩:= hp.legal
     refine ⟨⟨?_,?_,?_⟩,?_⟩
     · rw [he,hP]; exact ⟨hB,hp.bulk,hΦ,hp.past,hz,hp.trace,hp.pilot⟩
     · rw [he]; exact hp.spirit
     · rw [he]; exact hp.energy
