lemma worthierC : GrowsP M H p ϑ L₁ U (Λ*(p3+Tp)+r⁻¹*Tp) (Vt-P!) ϑ:=by
    have hr:∀ i,0≤rA i:= fun i=> he i ▸ mul_nonneg (zero_le_one.trans (hA _)) (hY _)
    have hg':=Fan.genuineC M H χ q n k r₀ A' rA p hB l₁ C₁ hl L₁ aA D' hH hD hA he hY hW hU hx0 hx1 ha -- order edit
    let f:= Vt; let g:=P!; let X':=ϑ
    have hz(i: Stars H M): p.Regular (X' i) (f i-g i):=by
       apply CouplingShape.reg_sub (CouplingShape.reg_extend ((hg'.lights.choose_spec.2.1 i).1) (Fan.prosperC M H q n r₀ A' l₁ hl i)); unfold g Fan.predictedC; split; next h=> exact (Hτ i h.1).1
       next=> exact CouplingShape.reg_const _
    let A (i:Stars H M):= |Field.speedΛ H i.1.2| * canvasX M H i.1 i.2 f₀
    have hp0 (i):0 ≤ A i:= by apply mul_nonneg (abs_nonneg _); exact Finset.prod_nonneg fun _ _=>mul_nonneg (Team.profit _) (prod_nonneg fun i _=> hg _)
    let W(i:Stars H M):= wingBill C₁ i.1 M i.2; let W' i:= Fan.beryl M H f₀ L₁ i
    have hE i:0≤ W i:= fareV ..
    let pnT i:= Fan.Enter M H i; let L i:= if η₀ i ∧ pnT i then (A i+W i)*Λ else 0
    let H' (i:Stars H M):= wife C₁ i.1 M i.2 p.power; have hG i: 0 ≤ H' i:= mul_nonneg (pow_nonneg (by unfold March.shiftG; positivity) _) (fareV ..)
    let Y i:= if ¬η₀ i ∧ f i ≠ 0 then H' i else 0; have hX i:0 ≤ L i := by unfold L; split; exact mul_nonneg (add_nonneg (hp0 i) (hE i)) h'; rfl
    have hh i:0 ≤ Y i:=by unfold Y; split; exact hG i; rfl
    let K (i:Stars H M):= L i+Y i; let Z (i:Stars H M):= pearl i.1 M L₁ i.2; have he' i:0≤Z i:= pearlsNN M H L₁ hY i; have h₀ i:0 ≤ K i:=add_nonneg (hX _) (hh _)
    have hS (i) (v) : p.supBounds v (X' i) (0:Config G c→ℝ) (K i):= VerifiedReset.sup_le (CouplingShape.sup_const 0) ((abs_zero (α:=ℝ)).trans_le (h₀ i)) -- edit name
    refine ⟨K,h₀,fun i=> ⟨hz i,fun j hj=> ?_⟩,?_⟩
    · change p.supBounds j (X' i) (f i-g i) (K i); unfold g predictedC
      split
      next hi=>
         have hl:f i= _:=if_pos (show pnT i from hi.2); rw [hl]; exact VerifiedReset.sup_le (Hτ i hi.1|>.2 j hj) (le_trans (le_of_eq (show L i=(A i+W i)*Λ from if_pos hi).symm) (le_add_of_nonneg_right (hh i)))
      next hi=>
         rw [sub_zero]; by_cases hv:f i=0; · rw [hv]; exact hS i j
         have hp': Enter M H i:= by by_contra h; exact hv (if_neg h)
         have hr' : ¬fitsP M H q n r₀ A' i:=by intro h; exact hi ⟨h,hp'⟩
         unfold f exactE; rw [if_pos hp']; have ha: X' i= reachability i.1:=if_neg hr'
         change j∈ X' i at hj; rw [ha] at hj ⊢; exact VerifiedReset.sup_le (wing C₁ i.1 M i.2 hH p hU hx0 p.power le_rfl|>.2.2 _ hj) ((show Y i=H' i from if_pos ⟨hr',hv⟩).symm.le.trans (le_add_of_nonneg_left (hX i): Y i≤K i)) -- maybe rw K
    have h₁:= Fan.switchesC M H q n r₀ A' p hB (stageQ V E q) l₁ W' _ (fun i=> Fan.charmNN M H f₀ hg L₁ hY _) ha (fun i=> Fan.tiers M H q n r₀ A' f₀ hg L₁ hY i (ht i) hv)
    have h₂:= Fan.capQC M H χ q n k r₀ A' rA hr p hB l₁ C₁ D' hD hW hx1 ha
    rw [hB]; intro x;
    let pU i:= if x∈X' i then Z i*Y i*Real.exp (U*coverNumber (radiusB t) (X' i)) else 0
    let p₁ i:= if x∈ X' i then Z i*L i*Real.exp (U*coverNumber (radiusB t) (X' i)) else 0; have hr'' : 0≤ r⁻¹:= (inv_pos.mpr hR).le
    have h₃:SumBudget pU (r⁻¹*Tp):=by
       refine budget_mono (budget_scale hr'' (h₂ x)) (fun i=>by unfold pU; split; exact mul_nonneg (mul_nonneg (he' _) (hh _)) (Real.exp_nonneg _); exact le_rfl) ?_ ; intro i
       by_cases h:x∈X' i
       · by_cases hu: ¬η₀ i∧ f i≠0; swap; · rw [show pU i=0 from (by unfold pU Y; rw [if_pos h,if_neg hu,mul_zero,zero_mul])]; exact (budget_scale hr'' (h₂ x)).1 _
         let F₀:= wZ i
         have hp: Enter M H i:= by by_contra H'; exact hu.2 (if_neg H')
         obtain ⟨V,hU'⟩:=Function.ne_iff.mp hu.2; have hU':wingTerm (χ:=χ) i.1 M i.2 V≠0:=by
            unfold f exactE at hU'; rw [if_pos hp] at hU'; exact hU'
         have hx:= Fan.exhausted M H χ q n k r₀ A' rA C₁ D' hD hW p.power r hR.le aA L₁ hA he hY hm hL hT hΥ hc hcc hF i _ hp hU' hu.1 -- edit
         have he : Z i* H' i ≤ r⁻¹*F₀:= by rw [inv_mul_eq_div,le_div_iff₀ hR,mul_comm]; exact hx
         unfold pU; rw [if_pos h,if_pos (show x∈ϑ i from h),show Y i=_ from (show Y i= H' i from if_pos hu), ← mul_assoc]; exact mul_le_mul_of_nonneg_right he (Real.exp_nonneg _)
       rw [show pU i=0 from if_neg h]; exact (budget_scale hr'' (h₂ x)).1 i
    have h₄:SumBudget p₁ (Λ*(p3+Tp)):=by
       have hr:=budget_scale h' (budget_plus (h₁ x) (h₂ x)); refine budget_mono hr (fun i=>by unfold p₁; split; exact mul_nonneg (mul_nonneg (he' _) (hX _)) (Real.exp_nonneg _); exact le_rfl) (fun i=>?_)
       by_cases h:x∈X' i ∧ η₀ i ∧ Enter M H i; swap
       · have he0:p₁ i=0:= by
             unfold p₁ L; by_cases hr:x∈X' i; · rw [if_pos hr,if_neg (fun he=>h ⟨hr,he⟩),mul_zero,zero_mul]
             exact if_neg hr
         rw [he0]; exact hr.1 _
       let U' := Real.exp (U*coverNumber (radiusB t) (ϑ i)); let W0:=wZ i; have hv:1 ≤ ((Blaze.March.shiftG t)*(1+(coverNumber (radiusB t) (reachability i.1):ℝ))):= by unfold Blaze.March.shiftG; have ht : (0:ℝ) ≤ Pressure.radiusB t:= Nat.cast_nonneg _; nlinarith [show (0:ℝ)≤coverNumber (radiusB t) (reachability i.1) by positivity]
       have hy: Z i*W i≤ W0:= (mul_le_mul_of_nonneg_left (le_mul_of_one_le_left (hE i) (one_le_pow₀ hv)) (he' i)).trans (Fan.belayed M H χ q k _ C₁ D' hD hW p.power aA L₁ hA he hY i|>.1)
       dsimp only; rw [if_pos (show x∈ _ from h.1),if_pos h.2.1,if_pos (show x∈ϑ i from h.1)]; unfold p₁; rw [if_pos h.1,show L i=_ from if_pos h.2]; change Z i*((A i+W i)*Λ)*U' ≤ Λ*(A i * Z i* U'+ W0*U'); nlinarith only [mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hy (show 0≤U' from Real.exp_nonneg _)) h']
    convert (budget_plus h₄ h₃) using 1; ext i; unfold pU p₁; split; next hi=> unfold K Z X'; ring
    next=> ring
