lemma shimmer (V:Config G c)(i:ℕ): (a!|>.each i V)=Photo.Fleece K Qt k' i V:=by
    let g(x:Qt.Mode):= Poly.send x ((Photo.Fleece K Qt k' i V).part x); have hz(k:RZ): (a!).tagged i (C₁ k) V=g k.val:=by
       unfold Bands.tagged; obtain ⟨hh,hv⟩:= falls M H rA f' X'' Qt k' b' j P K k i; rw [hh,hv]
    have h'(x)(hx:x∉Set.range C₁): (a!).tagged i x V=0:=by
       unfold Bands.tagged opalescence; dsimp only; rw [blank _ _ hx]; exact Poly.send_zero _
    unfold Bands.each; rw [transferred_sum C₁ hz h']; let a:Qt.Mode:=Qt.quiet
    let z := Photo.Fleece K Qt k' i V; obtain ⟨b,h,-⟩:=hP.bought
    have he:z.part a=(↑(P.activities.K i V):ℂ):=by
       change (Switch.sound k' _).part Qt.quiet= _; rw [Switch.sunset _ (h i) _ _ hT]; rw [hP.term]
    have hb: g a + ∑' x:RZ,g x.val = z:=by
       have hp: (∑ x:RZ, g x.val)=∑ x∈Finset.univ.erase a,g x :=by
            refine Finset.sum_nbij' (fun x=>x.val) (fun x=> if h:x.val.Nonempty then (⟨x,h⟩ : libraries Qt) else ⟨Qt.fire j,Finset.singleton_nonempty _⟩) ?_ ?_ ?_ ?_ ?_ -- search
            · intro x _; exact mem_erase.mpr ⟨fun he=> x.property.ne_empty (congr_arg Subtype.val he),mem_univ _⟩
            · intro x _; exact mem_univ _
            · intro x _; rw [dif_pos x.property]
            · intro x hx; rw [dif_pos (show x.val.Nonempty from Finset.nonempty_iff_ne_empty.mpr (fun he=> (mem_erase.mp hx).1 (Subtype.ext he)))]
            · intro x _; rfl
       rw [tsum_fintype,hp, Finset.add_sum_erase (Finset.univ) _ (mem_univ a)]; exact Poly.studs _
    rw [← he]; exact hb
