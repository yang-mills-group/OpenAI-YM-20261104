lemma traveled (V:Config G c)(hp:Summable (fun i=>(a!).ray i V)):
       ((a!).extra V) = ∑' i,sound k' (cursors M H rA X'' f' i V):=by
    let G(i:Stars H M):= sound k' (cL f' i V); let F(y:Stars H M× Qt.Mode):= Poly.send y.2 ((G y.1).part y.2)
    have h'(i:IX): (a!).ray (C₀ i) V=F i.val :=by
        have hv:= Fan.chorusQ M H rA hr f' X'' Qt k' ht i.val.1 V i.val.2
        have hs:= Fan.shelf M H rA f' X'' Qt k' b' j P K i; unfold Overlay.Bands.ray; rw [hs.1,hs.2.1,hs.2.2,ht',hv]
    have hx (i)(hi:i∉ Set.range C₀) : (a!).ray i V=0:=by
        unfold Overlay.Bands.ray; have he:(a!).H i=0:=by dsimp only [opalescence]; exact blank _ _ hi
        rw [he]; by_cases hp:Healthy P.p.threshold ((a!).support i) V
        · rw [masked_eq _ _ _ _ hp]; exact Poly.send_zero _
        rw [masked_ne _ _ _ _ hp]; exact Poly.send_zero _
    have hU:cZ=0:= Finset.sum_eq_zero (fun i _ => Poly.send_zero _)
    let e:IX ↪ _ := ⟨Subtype.val,Subtype.val_injective⟩; have he (z) (hz:z∉Set.range e):F z=0:=by
        have h'':¬testsX M H X'' Qt b' z.1 z.2:=fun h=>hz ⟨⟨z,h⟩,rfl⟩
        have hf:ch z.1 z.2=0:= Classical.byContradiction fun h=> h'' (Fan.attends M H rA hr f' X'' Qt k' hT b' hv z.1 (hs z.1) z.2 h) -- order edit
        unfold F G; rw [← Fan.chorusQ M H rA hr f' X'' Qt k' ht,hf]; by_cases h : Healthy (Pressure.temp t) (X'' z.1) V; rw [masked_eq _ _ _ _ h]; exact Poly.send_zero _ ; rw [masked_ne _ _ _ _ h,Poly.send_zero]
    have hK:Summable (fun i:IX=>F i.val):= (transferred_summable (C₀) h' hx).1 hp
    unfold Overlay.Bands.extra; rw [hU,zero_add]; rw [transferred_sum C₀ h' hx, ← transferred_sum e (g:=fun i=>F i.val) (fun i=> rfl : ∀ i:IX, F (e i)= F i.val) he] -- syntax edit
    rw [((transferred_summable e (fun i=> (show F (e i)=F i.val from rfl)) he).2 hK).tsum_prod]; apply tsum_congr; intro i; unfold F; rw [tsum_fintype]; exact Poly.studs _
