lemma circS : ∃ f:ℕ×ℕ→ℝ,(∀ i j,0≤f (i,j) ∧ ∀ V, ‖(a!).entries i j V‖ ≤ f (i,j)) ∧ ∀ i:E,SumBudget (fun k=> if i∈ ((a!).marks k.1 k.2).val then Poly.toll w' ((a!).marks k.1 k.2)*P.p.mass (P.activities.forced k.1).support (f k) else 0) e :=by
    obtain ⟨b,h,H'⟩:= hP.bought
    let t(i:ℕ):= Photo.Fleece K Qt k' i; choose m h₁ h₂ h₃ using fun i=> (show Loci w' (t i) (b i) from Accent.crystal (h i) hw hX)
    -- only A. Need scope h? K weight certificate f entries maybe zeros outside barcode & origin, via Active hv.
    have hB(i) := Fan.fillet M Qt k' b' hv _ _ hP hm i
    have hz:= falls M H rA f' X'' Qt k' b' j P K
    let S' (i:ℕ):=(P.activities.forced i).support
    let f (i:ℕ×Qt.Mode):= if i.2.val.image b'⊆ S' i.1 then m i.1 i.2 else 0
    have hY(i):0≤ f i:= by unfold f; split; exact h₁ _ _; exact le_rfl
    let F (i:ℕ× libraries Qt):= f (i.1,i.2.val); let α':= (Function.Embedding.refl ℕ).prodMap (tapsC Qt)
    refine ⟨stuff α' F,fun i l=>?_,fun i=>?_⟩
    · by_cases hl:l∈Set.range (tapsC Qt)
      · obtain ⟨k,rfl⟩:=hl; rw [(hz k i).2, show stuff α' F (i,C₁ k)=F (i,k) from stuffed α' F (i,k)]
        refine ⟨hY _,fun V=>?_⟩; dsimp only [F]; unfold f; split; next hk=> exact h₂ i _ _
        next hk=>
            rw [show ((Photo.Fleece K Qt k' i) V).part k.val= 0 from (hB i).1.scope _ _ (fun h=>hk (fun _ hv=> by obtain ⟨x,hx,rfl⟩:=mem_image.mp hv; exact h hx)),norm_zero]
      have h' : (i,l) ∉ Set.range α':=by rintro ⟨⟨u,v⟩,hu⟩; exact hl ⟨v,congr_arg Prod.snd hu⟩
      rw [blank _ _ h']; refine ⟨le_rfl,fun V=>?_⟩; unfold opalescence; dsimp only; rw [blank _ _ hl,Pi.zero_apply,norm_zero]
    let V (p:ℕ×Qt.Mode):= if i∈p.2.val then Poly.toll w' p.2 * P.p.mass (S' p.1) (f p) else 0
    have hv(p):0≤ V p:=by unfold V; split; exact mul_nonneg (Poly.worth hw p.2|>.le) (mul_nonneg (Real.exp_nonneg _) (hY _)); rfl
    let XA(j:ℕ):= if b' i∈ S' j then b j * Real.exp (a₀* coverNumber P.p.B (S' j)) else 0
    have hk : SumBudget XA e:= H' (b' i)
    have hp(j): SumBudget (fun p:Qt.Mode=> V (j,p)) (XA j):=by
        refine budget_finite (fun i'=> hv (j,i')) ?_
        let d:= Real.exp (a₀*coverNumber N' (S' j))
        have hb: Real.exp (U *coverNumber N' (S' j)) ≤ d:= Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right hZ (by positivity))
        have hK(p:Qt.Mode):Poly.toll w' p * P.p.mass (S' j) (f (j,p)) ≤ (Poly.toll w' p*m j p) *d:=by
            have hl:f (j,p) ≤ m j p:=by unfold f; split; exact le_rfl; exact h₁ j p
            rw [mul_assoc, mul_comm (m j p) d]; exact mul_le_mul_of_nonneg_left (mul_le_mul hb hl (hY _) (Real.exp_nonneg _)) ((Poly.worth hw p).le)
        by_cases h': b' i ∈ S' j
        · refine (Finset.sum_le_sum (g:=fun p=> (r! p*m j p)*d) fun p _=> ?_).trans ?_
          · unfold V; split; exact hK p; exact mul_nonneg (mul_nonneg ((Poly.worth hw p).le) (h₁ j p)) (Real.exp_nonneg _)
          rw [← Finset.sum_mul]; exact (mul_le_mul_of_nonneg_right (h₃ j) (Real.exp_nonneg _)).trans_eq (show XA j=_ from if_pos h').symm
        unfold XA; rw [if_neg h', sum_eq_zero]; intro b hb; unfold V; split; swap; · rfl
        next hu=>rw [show f (j,b)=0 from if_neg (fun h=> h' (h (Finset.mem_image_of_mem _ hu)))]; unfold BudgetPoint.mass; rw [mul_zero,mul_zero]
    let z:ℕ×libraries Qt ↪ ℕ× Qt.Mode:= (Function.Embedding.refl ℕ).prodMap ⟨Subtype.val,Subtype.val_injective⟩; have hx:= budget_pull z z.injective (budget_loosen (Extra.Histories.budget_prod hp hk.2.1) hk.2.2)
    refine transfer_budget α' ?_ ?_ hx
    · rintro ⟨j,v⟩; rw [show (a!).marks (α' (j,v)).1 (α' (j,v)).2=v.val from hz v j |>.1,stuffed];rfl
    intro j hj; split;rw [blank _ _ hj]; unfold BudgetPoint.mass; rw [mul_zero,mul_zero];rfl
