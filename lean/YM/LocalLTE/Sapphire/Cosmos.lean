lemma superscrip : ∃ f:ℕ→ℝ,(∀ i,0≤f i∧∀ k∈ ((a!).rays i).val,P.p.supBounds ((a!).origins k) ((a!).support i) ((a!).H i) (f i))∧∀ i : E,SumBudget (fun j=> if i∈ ((a!).rays j).val then Poly.toll w' ((a!).rays j)*P.p.mass ((a!).support j) (f j) else 0) Λ:=by
    obtain ⟨b,hb,h,hZ⟩:= hp.lights; let y (i:IX):=i.val; let e:= C₀
    have ht:= shelf M H rA f' X'' Qt k' b' j P K
    let g0 (i:Stars H M×Qt.Mode):=‖(barry M H rA Qt k' i.1).part i.2‖*b i.1
    let g i:= g0 (y i); have hy (i:Stars H M×Qt.Mode):0≤g0 i:= mul_nonneg (norm_nonneg _) (hb _)
    refine ⟨stuff C₀ g,fun i=> ?_,fun k=>?_⟩
    · by_cases hz:i∈Set.range C₀
      · obtain ⟨i,rfl⟩:=hz; rw [stuffed,(ht i).1,(ht i).2.1,(ht i).2.2]
        refine ⟨hy _,fun k hk=> ?_⟩; exact Next.Foundations.bound_smul _ (Blush.pricingG (h i.val.1|>.1) (h i.val.1|>.2 ((a!).origins k) (i.property.2 (Finset.mem_image_of_mem _ hk))))
      rw [show (a!|>.H i)=(0: Config G c→ℂ) from (by unfold opalescence; dsimp only; exact blank _ _ hz), blank _ _ hz]; exact ⟨le_rfl,fun _ _=> no_cost ..⟩
    let Mℓ(XA:Support c) i:= if b' k∈ XA then Real.exp (α*coverNumber P.p.B XA)*i else 0
    let f (i:Stars H M×Qt.Mode):= Mℓ (X'' i.1) (Poly.toll w' i.2* g0 i); have hh (i):0≤ f i:=by unfold f Mℓ; split; exact mul_nonneg (Real.exp_nonneg _) (mul_nonneg (Poly.worth hw _|>.le) (hy i)); rfl
    let b0 i:= if b' k∈X'' i then (T₀ i*b i)* Real.exp (α* coverNumber P.p.B (X'' i)) else 0
    have hℓ: SumBudget b0 Λ:= hZ (b' k)
    have hu: SumBudget f Λ:=by
        have hh' i: SumBudget (fun j:Qt.Mode=> f (i,j)) (b0 i):=by
            refine budget_finite (fun j=> hh (i,j)) ?_; have hx:= Fan.bidsQ M H rA hr Qt k' w' hw hX i
            by_cases hp:b' k∈X'' i
            · simp only [f,Mℓ,b0,hp,↓reduceIte,g0]; rw [← mul_sum];
              let p:=barry M H rA Qt k' i; simp_rw [← mul_assoc]; rw [← sum_mul,mul_comm (Real.exp ..)]; exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hx (hb i)) (Real.exp_nonneg _)
            simp [f,Mℓ,b0,hp]
        exact budget_loosen (Extra.Histories.budget_prod hh' hℓ.2.1) hℓ.2.2
    let a:=a!
    let v (i:IX):= if k∈(i.val.2).val then Poly.toll w' i.val.2 * P.p.mass (X'' i.val.1) (g i) else 0
    have hr: SumBudget v Λ:=by
        refine budget_mono (budget_pull y (Subtype.val_injective) hu) (fun i=>?_ ) ?_
        · unfold v; split; exact mul_nonneg ((Poly.worth hw _).le) (mul_nonneg (Real.exp_nonneg _) (hy _)); rfl
        intro i; unfold v; split; swap; · exact hh _
        next hk=>
            unfold BudgetPoint.mass f y Mℓ; rw [if_pos (show b' k∈ X'' i.val.1 from i.property.2 (Finset.mem_image_of_mem _ hk)),mul_left_comm]
            exact mul_le_mul_of_nonneg_right (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right HB (by positivity))) (mul_nonneg ((Poly.worth hw _).le) (hy _))
    refine transfer_budget e ?_ ?_ hr
    · intro i; unfold e; rw [(ht i).2.1,(ht i).1,stuffed] --
    intro i hi; split; rw [blank _ _ hi]; unfold BudgetPoint.mass; rw [mul_zero,mul_zero]; rfl -- same
