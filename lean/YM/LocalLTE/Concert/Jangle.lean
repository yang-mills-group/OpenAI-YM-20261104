   change sound k' W=sound Zv K; rw [← he,sound,sound,mapScores_apply,mapScores_apply]; refine Finset.sum_congr rfl (fun r _=>?_)
   by_cases hv:∀ i∈ r,A' i
   · rw [Finset.prod_congr rfl (fun i hi=> hr' i (hv _ hi))]
   push Not at hv; obtain ⟨i,hi,hv⟩:=hv; have hp:jet W r=0:= Switch.jet_erase ((Fan.amends M H rA hr x Unit).works ()).choose_spec (fun t _ q=> Fan.staticA M H rA x i (fun ht=>hv (h i ht)) _ _) r hi; rw [hp, Complex.ofReal_zero,zero_smul,zero_smul]
