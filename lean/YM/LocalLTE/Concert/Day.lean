lemma cinematic (h0:flags ((Q').p).threshold U=∅) (hsP: Passage H k F W k' r b kB Ra μ ζ x hc L₀ X' FL d0 Z hk R₁ Q₁ v N' φ) : 
    0<V₁ U ∧ (qA).part L₀.quiet=0∧ (V₁ U)⁻¹ • Pτ U= Marker.Poly.pass qA ∧
     Poly.price W₂ (qA - vA) ≤ (kB:ℝ)*e' ∧ Poly.price W₂ ((V₁ U)⁻¹ • Pτ U- Marker.Poly.pass vA) ≤ Xf*e':=by
   have hE:=hsP.fires; let R:=Q'; let tM:=ms; let P0:=ps; let T0:=ps'
   obtain ⟨ht,h,hP,hL⟩:= hE.reach
   have hM:tM.Active:=ht; have hL:Fan.Tabs (Q') L₀ tM P0 T0:= hL --
   have hpB:=hsP.scales.1; have ht':=hsP.scales.2
   have he:(qA).part L₀.quiet=0:= Port.tones _ U hM ht'
   have hh: V₁ U=(Q').eval U:=by rw [hsP.tagOut]; exact (congr_fun hQ.actual.ident U).symm
   obtain ⟨hv,hy⟩:= YM.LocalLTE.Pass.stepClean tM U h0 hh (hsP.charges _).symm
   refine ⟨hv,he,hy,?_⟩; rw [hy]
   have hp₀:= hE.spent.2; have hδ:= hE.error
   rw [hkz] at hp₀ hδ
   have hw:1 ≤Y:=(H.vote.cash _ _ (step_paid (A.B.a) m)|>.2 _ (A.B.valid.pays m)).light.1
   have hx:0<ζ:=by have h:= (Z.bill _ _ (step_paid (A.B.a) m)).2.1; rw [hkz] at h; exact h
   let e₀:= Δ; have hcμ:0 ≤ hc:= (mul_nonneg (hp₀.pure v).le (norm_nonneg _)).trans (hp₀.localU v); have he0:0 ≤ e₀:= Real.rpow_nonneg (zero_le_one.trans hw) _; have he1: e₀ ≤ 1:= Real.rpow_le_one_of_one_le_of_nonpos hw (neg_nonpos.mpr hx.le)
   have hX0:Y^aust ≤ 1:= Real.rpow_le_one_of_one_le_of_nonpos hw (by norm_num [aust])
   have hs0:hc + (Y^aust + Δ) ≤ hc+2:= add_le_add (le_refl _) (by change Y^aust+e₀≤2; linarith only [he1,hX0]); have hs1:0 ≤ Xf:=by unfold aerial; positivity
   obtain ⟨htQ,hQ'⟩:= Port.hymn tM P0 T0 bw U hP h hp₀ hδ he0 he1 hL (hc+2) hs0 (by linarith only [hcμ]) kB hs
   have ht : Y^(-J₀) ≤ e':=by
       have hA:= (F.turns _ hQ.entry).2; rw [hQ.inlet] at hA; unfold RG.Shoot.band at hA; rw [beta_eq A.B.valid] at hA
       exact hζ _ _ (step_paid A.B.a m) _ (A.B.valid.pays m) R₁.beta hA.1 hA.2
   exact ⟨Port.beacon _ Y μ _ kB hw hμ hs (Nat.cast_nonneg _) htQ hV ht, Port.beacon _ Y μ _ kB hw hμ hs hs1 hQ' hV ht⟩
