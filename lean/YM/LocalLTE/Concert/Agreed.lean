lemma repr_inj : Injective (reporter M H X'' Qt b'):=by
   have ht:Injective (wingsZ M H):=by
       rintro ⟨v,u⟩ ⟨v',k⟩ h; obtain rfl: v=v':=congr_arg Sigma.fst h
       suffices hz:u=k by rw [hz]
       apply funext; intro i; exact Subtype.ext (congr_fun (eq_of_heq (Sigma.mk.inj h).2) i)
   exact fun _ _ h=> Subtype.ext (Prod.ext (ht (congr_arg Prod.fst h)) (congr_arg (fun p:σ₁ × Qt.Mode=>p.2) h))
