lemma rowHonor (i:Qt.Mode): Fan.chimes M H rA R₁ Qt k' ⟨z,D⟩ i=Fan.chimes M' H K' R₂ Qt Zv (⟨z,D'⟩) i ∧ X₁ (⟨z,D⟩)=Y₁ (⟨z,D'⟩):=by
    let F:=R₁; let K:=R₂; have he: fitsP M H q n r₀ A' iΩ:=hx; have hq: fitsP M' H q n r₀ A' jΩ:=choirT M H z D q n r₀ A' hx M' hm
    have hh: X₁ iΩ= Y₁ jΩ:=by unfold sitesP; rw [if_pos he,if_pos hq]
    have hz : F iΩ=K jΩ:=by
       have hT : Fan.Enter M H iΩ↔Fan.Enter M' H jΩ:=Iff.rfl; unfold F K Fan.predicted; by_cases hA: Fan.Enter M H iΩ; · rw [if_pos ⟨he,hA⟩,if_pos ⟨hq,hT.1 hA⟩]; exact Fan.aromaV M φ H χ z D q n r₀ A' hx M' φm hm hx' m a₁ _ hp
       rw [if_neg (fun h=>hA h.2),if_neg (fun h'=>hA (hT.2 h'.2))] -- edit structure use mem.H.
    refine ⟨?_,hh⟩; unfold chimes; rw [notesJ M H z D q n r₀ A' hx rA hr Qt k' M' hm K' Zv hζ hr', show R₁ (⟨z,D⟩)=R₂ (⟨z,D'⟩) from hz]
