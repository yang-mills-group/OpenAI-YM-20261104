lemma whereabouts (i:ℕ) (h: (Pℓ).H i ≠ 0) : ∃ x:Fan.Metering M H X₁ Qt b',∃ y:Fan.Metering M' H Y₁ Qt b',(eX x=i) ∧ reporter M H X₁ Qt b' x=reporter M' H Y₁ Qt b' y ∧
      (Pℓ).support i=(Pν).support (eY y)∧ (Pℓ).rays i=(Pν).rays (eY y)∧ (Pℓ).H i=(Pν).H (eY y):=by
    by_cases he:i∈ Set.range eX; swap; · exact (h (by unfold Fan.ghost Fan.opalescence; dsimp only; exact blank _ _ he)).elim
    obtain ⟨u,rfl⟩:=he; obtain ⟨z,hz⟩:=u; rcases z with ⟨⟨z,b⟩,k⟩
    let a:IQ:=⟨(⟨z,b⟩,k),hz⟩; obtain ⟨ht,h1,h2⟩:= Fan.shelf M H rA R₁ X₁ Qt k' b' v' C (fun _ _=>0) a
    have hs: (Pℓ).H (eX a) = Fan.chimes M H rA R₁ Qt k' a.val.1 a.val.2:= h2
    change (Pℓ).H (eX a) ≠0 at h; rw [hs] at h
    have hF: fitsP M H q n r₀ A' (⟨z,b⟩) :=by
       by_contra hh; have he:R₁ a.val.1=0:=if_neg (fun h=> hh h.1); apply h; unfold Fan.chimes; rw [he, show Complex.ofReal ∘ (0:Config G c→ℝ)=0 from funext fun _=> Complex.ofReal_zero,smul_zero]
    let W:=Fan.recloak M H z b q n r₀ A' hF M' hm
    obtain ⟨hA,hB⟩:= Fan.rowHonor M φ H χ z b q n r₀ A' hF rA hr l₁ Qt k' M' φm hm hx' K' Zv hζ hr' κ m a₁ hp k -- order check
    have hu:k.val.image b'⊆ Y₁ ⟨z,W⟩:= hz.2.trans hB.le
    let v:IΥ:=⟨(⟨z,W⟩,k),hz.1,hu⟩; obtain ⟨hx,hV,hK⟩:= Fan.shelf M' H K' R₂ Y₁ Qt Zv b' v' C (fun _ _=>0) v
    have ht:(Pℓ).support (eX a)=X₁ a.val.1:= ht; have hx': (Pν).support (eY v) = Y₁ v.val.1:= hx
    refine ⟨a,v,rfl,rfl,ht.trans (hB.trans hx'.symm),?_,?_⟩
    · exact (show (Pℓ).rays (eX a)=k from h1).trans (show (Pν).rays (eY v)=k from hV).symm
    exact hs.trans (hA.trans (show (Pν).H (eY v)=Fan.chimes M' H K' R₂ Qt Zv v.val.1 v.val.2 from hK).symm)
