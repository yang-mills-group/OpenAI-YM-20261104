def Infra {R:Rep G c}(Qt: Marker.Census E)(X Y: Overlay.Bands Qt R) (I J :Type) (e:I→ℕ)(d:J→ℕ)(F: I→σ₁ × Qt.Mode)(G':J→σ₁ × Qt.Mode): Prop:= X.origins=Y.origins ∧ X.units=Y.units∧∃ f:{i:ℕ//X.H i≠0}≃{i:ℕ//Y.H i≠0},∀ i, X.H i.val=Y.H (f i).val ∧ X.rays i.val=Y.rays (f i).val∧ X.support i.val=Y.support (f i).val ∧ ∃ x y,e x=i.val∧ d y=(f i).val∧ F x= G' y
