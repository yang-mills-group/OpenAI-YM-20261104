lemma illustrious (n':ℕ)(hv:D₁ ≤ n'+1)(s:ℕ)(ht:l₁*radiusB t ≤ s) : Shine Qt (augment (m0) U) n' s κ :=by
    constructor; intro i; let Aι:= m0; let F:= Aζ; let e:= offerC M H F Qt b'; let k:= fun (_:ℝ)(_:Finset ι)=> (0:Code G c)
    change Aι.H i≠0→ _; intro hi
    let V':=F₀ -- Aι notation capture?
    let Q':=Fan.opalescence M H rA (F₀) F Qt k' b' Vp P k
    by_cases h:i∈ Set.range e
    swap; · exact False.elim (hi (by unfold Aι ghost opalescence; dsimp only; exact blank _ _ h))
    obtain ⟨p,rfl⟩:= h; obtain ⟨hh,-,hy⟩:= shelf M H rA F₀ F Qt k' b' Vp P k p; let S:= (p.val.1); let P':= p.val.2
    have hb : Aι.H (e p)= chimes M H rA F₀ Qt k' S P':=hy
    let z:=Fan.origin M H S; let Qs:=X S
    let T:ℕ:= East.stagnate q Q.halo *radiusB t -- shadow!
    rw [hb] at hi; unfold chimes predicted at hi; split at hi; swap
    · apply False.elim; apply hi; rw [show Complex.ofReal ∘ (0:Config G c→ℝ)=(0:Config G c→ℂ) from funext (fun _=> Complex.ofReal_zero),smul_zero]
    next hhM=>
      let y:= barry M H rA Qt k' S; have hx:F S=neighbors Yρ z:=if_pos hhM.1
      have hy : (augment Aι U).support (e p)= neighbors Yρ z:= hh.trans hx
      rw [show (augment (m0) U).support (e p)= neighbors Yρ z from hy]
      refine ⟨z,(neighbors_mem ..).2 (by rw [separation_self]; omega), (fun i hi=>(neighbors_mem ..).2 (((neighbors_mem ..).1 hi).trans ht)), T,hl.le.trans ht,Qs,fun i=>?_⟩
      change ∃ S, Port.scaleQ i ∘ (Aι.H _)=_
      rw [hb]; unfold chimes predicted; rw [if_pos hhM]
      -- represent products. T year's hp.B output.D₁ to n+1
      let H₀:= lenses M φ H χ S.1 S.2 α₁ D₁ T Qs κ hp'
      let M' (k:Config G c→ℂ) := Port.scaleQ i ∘ k; have he : M' ((y.part P') • (Complex.ofReal ∘ H₀))= (Port.scaleQ i (y.part P')) • H₀:=by
         funext U; change Port.scaleQ i ((y.part P')*(↑(H₀ U):ℂ))= Port.scaleQ i (y.part P') * H₀ U; cases i <;> simp [Port.scaleQ, Complex.mul_re, Complex.mul_im]
      change ∃ P, M' ((y.part P') • (Complex.ofReal ∘ H₀))= _; rw [he]; exact Price.rp_raise Qs (Price.rp_scale Qs _ (show Price.Replicated Qs T κ D₁ H₀ from ⟨_,rfl⟩)) hv -- rep direction wrong
