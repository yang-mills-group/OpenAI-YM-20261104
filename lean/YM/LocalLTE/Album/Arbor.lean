lemma preserves_roots (o:Site (A₀))(i:ι)(h: o∈(M i).crest.image (A.B.a.clock.op m n).ratio.parent): Motion.Hush i o (fun i=> ((Y₁).activities.forced i).support) (c₀):=by
  have hr: Motion.Hush i o (fun i=> ((d!).kernel i).support) (Palette.shoot M (F.hearth H x) O rA (F.holds.base) fU):=by
    intro j t r ht; let U:= F.holds.base; by_cases hz:j∈Set.range (Refrain.visa (F.holds.base) (F.cords H x))
    · obtain ⟨w,rfl⟩:=hz; change o ∉ (Refrain.reserve _ (Refrain.badge (F.holds.base) (Refrain.visa (F.holds.base) (F.cords H x) w))).support at ht
      unfold Palette.shoot Palette.shootK; rw [stuffed,stuffed]; funext U; exact Palette.limbs M V₀ O rA U i o h w.val (fun h=> ht ((Refrain.admitted (F.holds.base) fU w).1.symm ▸ h)) t r
    unfold Palette.shoot Palette.shootK; rw [blank _ _ hz,blank _ _ hz]
  have he: Motion.Hush i o (fun i=> ((A').kernel i).support) (ivory H F W k' tag x M rA k):= Motion.quiet_fusion _ o hr (Marlin.hak (d!))
  exact Motion.quiet_fusion («d»:=Rack.widen A' H₁) («P»:=B) i o (Motion.quiet_up i o he) (Progress.DirectedRecipe.folio G _)
