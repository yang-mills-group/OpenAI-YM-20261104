lemma ports : Photo.Usable M (F.hearth H x) O (F.Voy H W k' tag k x) rA (coconut H F W k' tag x M rA k) ((R.expense J I).earn+w) (2*w₀) (straw u L G x₀) := by
  let X' := d!; let Y':=(V₀); let p' := Palette.lace M (V₀) rA n'; have hW(i):= Palette.fair M V₀ O rA hR i n'
  have he':Summable p':= (Palette.sizes M V₀ O rA hR hp TZ.balance).2
  have h₁ : Ac.Hit (fun i:Y'.fragrances=> Y'.bookFoot (.inr i)) ((Y₁).p.B) (fun i=> 2*p' i) es (2*w₀):=by
     intro i; have he:=budget_scale zero_le_two (Palette.lucent M V₀ O rA hR hp TZ.balance i); convert! he using 2; rename_i j; change (if i∈ Y'.bookFoot _ then 2*_ * Real.exp _ else 0) = _; split_ifs <;> ring_nf; rfl
  have hv:=F.shores H W hm k' tag x hx J' hk hF M rA TZ h₇ hp hR G'
  have hr : Motion.Pays ((Y₁).activities) (B) (c₀) sw (B).supportExponent:= by
     refine ⟨hv.term,fun t j ht=> let Uxx:=hv.licensed _ _ ht; ⟨Uxx.sym,Uxx.symtest,Uxx.meas,Uxx.meas_test,Uxx.reads,Uxx.reads_test,Uxx.permit⟩,?_⟩
     obtain ⟨Uxx,hT,h⟩:= hv.bought
     refine ⟨Uxx,hT,fun x=>budget_mono (h x) (fun i=> ?_) (fun i=> ?_)⟩ -- indentation
     · split; exact mul_nonneg ((hT _).rocket) (Real.exp_nonneg _); exact le_rfl
     split; next hi=> exact mul_le_mul_of_nonneg_left (Real.exp_monotone (mul_le_mul_of_nonneg_right (le_add_of_nonneg_right zero_le_one) (by positivity))) ((hT i).rocket)
     rfl
  refine ⟨hR,rfl,⟨_,fun i=>?_,he'.mul_left 2,h₁⟩,hr,preserves_roots H F W k' tag x M rA,fun U r j h=>?_⟩
  · have he:= Switch.constant (ι:=ι) (fun U=>Palette.song M V₀ O rA i U 0 ∅) (hW i|>.rocket) (fun U=> Switch.Paid.tasting (hW i) U 0 ⟨le_rfl,zero_le_one⟩ ∅);change Switch.Paid _ (2*p' i); rw [two_mul]; exact Switch.Paid.sub (hW i) he
  · let D':=Palette.color M V₀ O U (rp r j); let a':= overhead (prism (ships A.B N m n) x₀ O (R.shape.o J I).K U F.forest) (Q (F.holds.latch x)) (R.target J I).table
    let Dr:=black (Refrain.read (F.holds.base) fU O (d!|>.reg) (tap'|>.regular)) (V' r j); let R':=(Q (F.holds.latch x)); let Pr:=(Y₁)
    have hR': a'*Y'.homesteadMill D'*Dr.gas B U=(S).push R'.beta (Palette.buy M (rp r j) S) U:= Palette.chorus M V₀ O rA hR hp U F.forest TZ.balance _ _ _ (X'|>.reg) (tap'|>.regular) rfl j r h -- edit
    have hw : (black (Pr.activities) (c₀ r j)).gas B U= Dr.gas B U*Real.exp (∑' i,(tap').logarithm i U)*Real.exp (∑' i,(H₁).logarithm i U):= F.repaint H W hm k' tag x hx hk hF M rA TZ h₇ hp hR G' U j r h
    let p₀(y:ℝ)(q:Finset ι):=∑' i,Palette.song M V₀ O rA i U y q
    have hA : Real.exp (p₀ r j)=Y'.homesteadMill D':= (Palette.assembled M V₀ O rA hR hp U F.forest TZ.balance r h j).2.2
    have hs : Real.exp (p₀ 0 ∅)=Y'.homesteadPool O U:=by
      let s:=Palette.assembled M V₀ O rA hR hp U F.forest TZ.balance 0 (show (0:ℝ) ∈ Icc (0:ℝ) 1 from ⟨le_rfl,zero_le_one⟩) ∅ |>.2.2
      have he:Palette.ways rA 0 ∅=(fun _=>0):=by ext; simp [Palette.ways]
      rw [he] at s
      exact s.trans (congr_arg Y'.homesteadMill (Palette.muted M V₀ O U)) -- edit
    have hx' q r (hc:r∈Set.Icc (0:ℝ) 1):Summable (fun i=>Palette.song M V₀ O rA i U r q):= he'.of_norm_bounded fun i=> Switch.Paid.tasting (hW i) U _ hc _
    change Real.exp (Pr.exponent U)* _* (black _ _).gas (B) U=(S).push _ _ U
    have ht:= Career.closure H F W hm k' tag x hx J' hk hF G' hX TZ U
    rw [← hR',show (black _ _).gas _ _=_ from hw]
    have hh : Real.exp (∑' i,Photo.tones M Y' O rA i U r j)= Real.exp (p₀ r j)/Real.exp (p₀ 0 ∅):=by unfold Photo.tones; rw [Summable.tsum_sub (hx' _ _ h) (hx' _ _ ⟨le_rfl,zero_le_one⟩),Real.exp_sub]
    dsimp only at ht; change Real.exp _*Real.exp (∑' i, Photo.tones M Y' O rA i U r j)*_= _
    rw [hh]
    rw [← hs] at ht; rw [← hA]
