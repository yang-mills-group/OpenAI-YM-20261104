   (black ((F.Voy H W k' tag k x).activities) (c₀ r j)).gas B U=(black ((d!).pours tap') (V' r j)).gas B U*Real.exp (∑' i,(tap').logarithm i U)*Real.exp (∑' i,(H₁).logarithm i U):=by
     have he:=F.conserved H W hm k' tag x hx hk hF M rA TZ h₇ hp hR
     have hA:= F.kioskT H W k' tag x M rA TZ hp hR (k:=k)
     have hu:=F.memories H W hm k' tag x hx hk hF
     let rxx:= Passage.gathered (F:=Marlin.hak (d!)) (Merge.Motion.kitch hA hu.1 r hr j) U
     have hw: (black ((A').pours (H₁)) (m₀ r j)).gas B U=(black ((d!).pours tap') (V' r j)).gas B U*Real.exp (∑' i,(tap').logarithm i U):= rxx.tsum_eq
     rw [← hw]; exact (Merge.Motion.winter he (F.canopied H W hm k' tag x hx hk hF G') (Progress.DirectedRecipe.folio G _) r j hr U).tsum_eq
