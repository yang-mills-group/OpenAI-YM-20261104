   -- arguments referenced by proofs not outside.
   let E₁:= applicant U p hΘ hA; let E:= applicant U p hΘ hk; let E₂:= applicant U p hΘ hζ; have ht:= Holds.reduce U p Bc hk (he0 _ hv); let E₀:= applicant U p hΘ ht
   let P₁:= Turf.versionG U q (time a) (rank (a+1)) hP Yv p hΘ hA; let P₂:= Turf.whorlG U q (rank (a+1)) hP Yv p hΘ hζ
   obtain ⟨hf,hp⟩:= Turf.principalR U hm l q (rank a) (time a) (rank (a+1)) e hZ hm' hL hP Yv p G' h2 hΘ hA (Bv.fee _ hv.le) hF Zb hU hr hℓ hM hV hE hD hd -- order
   obtain ⟨hg,hG⟩:= Turf.principalWhorl U hm l q (rank (a+1)) hZ hL hP Yv p G' h2 hΘ hζ (Bv.grant _ hv) hF' hX hb Zb hU hr hℓ hM hV hE hD hd -- order .
   have hx:= U.ruled G' hm hU h2 hM hV hd hE hD hr hℓ hΘ Zf (e' (a+1)) (φ-B₂) ht.fits ht.may
   let cA:= U.inPort.p.mass Zf (Bv.price a); let cB:= U.inPort.p.mass Zf (Bv.incline a); let cb:= Doors.rate L*((U.inPort).p.mass Zf (e' (a+1)))
   have hi:=Turf.openWire U p hΘ Bc; have he i:River.bulk E i=River.bulk E₁ i+River.bulk E₂ i:=by unfold E E₁ E₂; rw [Turf.subsist,Turf.subsist,Turf.subsist,map_sub,Pi.sub_apply]; abel
   have hj:=Turf.together (d:=p) G' hm h2 U E E₁ E₂ rfl rfl l (U.openWire p hΘ hk) he P₁ P₂ hg hf
   let zA:= G!*(Yp^(-(1/16:ℝ))*cB); let zB:= Turf.wadSong (B).supportExponent Yp e l * cA; let tK:= ‖z‖*(zA+zA)+‖z‖*(zB+zB); let tz:= G!*cb+tK;
   have hς i:River.bulk (applicant U p hΘ Bc) i= River.bulk E i+River.bulk E₀ i:=by unfold E E₀; rw [Turf.subsist,Turf.subsist,Turf.subsist,map_sub,Pi.sub_apply]; abel
   have hK:= Turf.staysQ (d:=p) G' hm h2 U Hc E E₀ rfl rfl l hi hς (P₁+P₂) (show _ from hx) hj
   refine ⟨⟨tz,?_,hK⟩,fun i hi=>?_⟩
   · let u':= U.inPort.p.mass Zf (e' (a+1)); have hy:regularNet G (X.p.profile I) l p L e Y*cA= ‖z‖*(zB+zB):=by unfold regularNet zB; rw [Rain.jersey (A:=A) (m:=m)|>.2.2.1]; simp; ring
     rw [Rain.jersey (A:=A) (m:=m)|>.2.2.1]
     change dy * tz= debtR G (X.p.profile I) l p L * u'+ (dy * (regularNet G (X.p.profile I) l p L e Y)) * cA+ Legato.Spool.smallMeter (X.p.profile I) l p L G Y*cB
     unfold tz tK; rw [mul_assoc _ _ cA,hy,mul_add,mul_add]; unfold debtR zA cb; rw [Rain.jersey (A:=A) (m:=m)|>.2.2.1]; unfold Legato.Spool.smallMeter; simp; unfold u'; ring
   have he:P₁ i≠0 ∨ P₂ i≠0:=by contrapose! hi; change P₁ i + P₂ i=0; rw [hi.1,hi.2,zero_add]
   let K:=rank (a+1)+1
   have h(u: Config G (A.B.a.S.side m n)→ℂ)(hf:u≠0→ ∀ b:Bool,Replicated Yv (East.stagnate q (Z).halo*radiusB Y) κz (rank (a+1)+1) (Port.scaleQ b ∘u)) (b:Bool) : Replicated Yv (East.stagnate q (Z).halo*radiusB Y) κz K (Port.scaleQ b ∘u):=by
