       rw [h,show Port.scaleQ b∘ (0:Config G (A.B.a.S.side m n)→ℂ)=0 from funext (fun i=>map_zero _)]; exact rp_zero _
   have hj b:Port.scaleQ b ∘ ((P0 (a+1) hv) i)= Port.scaleQ b ∘ (P₁ i) + Port.scaleQ b ∘(P₂ i):=funext fun v=>map_add _ _ _
