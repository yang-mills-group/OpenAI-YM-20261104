lemma keeperRate : ∃ (T₁: Heading ((Labels.frames G).level 0))(YY:Set Wing), LocalLTE.Vinca.Key D₀ H N n m (hol G) e W₀ (ζ) (scaler (X.p.profile I) l L) (waybill A.B.a m) T₁ YY ∧ ∀ i,YY (.gasKey (cart Z i)):=by
    let P₀:= (Z); let P₁:= (Ut); have h1:0+3≤ I:=hd -- don't instance
    let V:Set Wing:=Set.univ; let Y₀:= (θ); have hB:Y₀=waybill A.B.a m:=by
         unfold Y₀ waybill; rw [params_eq A.B.valid]; have he:(Ωu).p=A.B.a.budget (m+1):= P.choice.represents N n (m+1) hm|>.vac; rw [he]
    obtain ⟨T₂,he⟩:= Cub.chordsP hm P₁.songs P₁.PStage P₁.wait (Graces.feet h1 P₁.clock) (U.samples N m n hm.le) P₁.r t₀ (U.baptism N m n hm) (U.charged N m n hm) hG P₁.tunes P₁.furthering P₁.corners P₁.shape P₁.clock P₁.stamp (aperture Ut N m n T 0 hd) (U.ore hm) l S₀ h1 V (fun i _=> trivial) -- V.prop
    refine ⟨T₂,V,?_,fun _=> trivial⟩; unfold Harmonics.lays Bandage.purser; rw [← hB,dif_pos h1]; exact he
