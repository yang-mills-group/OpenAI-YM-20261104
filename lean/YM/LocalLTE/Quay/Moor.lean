lemma epochB : let t0:= (scaler (X.p.profile I) l L)*t; (T0).Format 0 (hol G) Ω ∧ (T0).density 0 B0 Ω=(A.B.a.clock.op m n).push ((Ωu).beta) (R'.density 0 B0 Ωu) ∧ (T0).remBound 0 Ω (Real.sqrt (A.B.a.clock.forcedAllowance m)) t0 ∧ ((Labels.frames G).level 0).coeffSize ((Ip).x- ((Labels.frames G).level 0).e0) ≤ t0:=by
     intro t0
     obtain ⟨T₁,Φ,hp,hV⟩:= Harmonics.keeperRate U hm hd hG -- precision hX quantity
     have hz : SoundDoor (A.B.a.clock.op m n) (U.deed N n m hm):=by
          exact sound_duet H N n m (U.baptism ..) (U.charged ..) _ (A.B.a.clock.op m n) ((U.port N m n hm).opensV hG hm U.tag.r)
     apply LocalLTE.Concourse.acclaim B0 (hol G) W₀ Z R' Vx P.choice hm hf hP Φ e hz (Spool.scaler_pos ..) T₁ hp _ (glyphBound A.B.a (m+1)|>.2) hV -- order
     unfold waybill; apply mul_nonneg zero_le_two (mul_nonneg (Real.exp_pos _).le _); rw [params_eq A.B.valid]; exact zero_le_one.trans (Cub.title_one ..)
