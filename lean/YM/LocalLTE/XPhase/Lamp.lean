variable (Z' : Lotus.Leaf (Q (F.holds.latch x)))
omit [Fintype ι] in
lemma waltzT (i:ℕ) (Y:Config G (A.B.a.S.side m n)) : DifferentiableAt ℝ (fun t=> waxA H F W k' tag x Z' k t i Y) 0:=by
   let Z :Unit→ Lotus.Leaf (Q (F.holds.latch x)):=fun _=> Z'
   let t:Unit→ℝ:= fun _=>1
   have h : Grouped Z' t Z:=by constructor; exact fun _=> rfl; exact Summable.of_finite; intro j; simp [Z,t]
   let S:= F.tap H W k' tag k x; have hp: Joins Z' t (fun M θ=> waxA H F W k' tag x M k θ i Y) Z:= Joins.in_final B (F.barn H W k' tag) (F.tongue H W k' tag k x) (fun i uₓ=> (Joins.harvest B (d!) (Marlin.hak d!) S (fun i uₓ=> h.verses (F.hearth H x) Chi.canonical uₓ F.holds.base fU i) i uₓ)) i Y
   exact hp.atx _
lemma zero_state (t:ℝ)(i:ι): (V') t ∅=veranda (M i) V₀ O F.holds.base fU 0:=by unfold Palette.shoot Palette.shootK veranda; simp_rw [Palette.offWays,Palette.muted,color0]
lemma one_state (t:ℝ)(i:ι): (V') t {i}=veranda (M i) V₀ O F.holds.base fU (rA i*t):=by unfold Palette.shoot Palette.shootK veranda; simp_rw [Palette.active M]
