variable {v2 e2:ℝ}(ht: Motion.Pays ((F.Voy H W k' tag k x).activities) ((F.Voy H W k' tag k x).p) (coconut H F W k' tag x M rA k) v2 e2)
include ht
lemma candle (j:ℕ)(U:Config G (A₀))(i:ι): Switch.jet (fun t p=> lamp t p j U) {i}= rA i*(cannon|>.hinge (M i) j U):= by
     obtain ⟨b,hf,-⟩:= ht.bought; obtain ⟨q,hq⟩:= (hf j).works U
     let g t:= waxA H F W k' tag x (M i) k t j U; let f t:=g (rA i*t); refine hq.heading _ (f:=f) ?_ ?_ ?_
     · simpa  [f,g, stencilA,Function.comp_def] using! (waltzT H F W k' tag x (Z':=M i) (k:=k) j U).hasDerivAt.scomp_of_eq 0 ((hasDerivAt_id' (0:ℝ)).const_mul (rA i)) (show 0=rA i*0 from (mul_zero _).symm)
     · intro t; unfold f g;rw [mul_zero]; unfold coconut waxA final.frigid ivory canvasZ; simp_rw [zero_state H F x M rA _ i]
     intro t; unfold f g coconut waxA final.frigid ivory canvasZ; simp_rw [one_state H]
