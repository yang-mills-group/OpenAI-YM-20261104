   have hP:= AbsoluteSums.Product.everyone_ne X0 p.B ha (fun i _=> ⟨_, hc1 i (Fan.pinned M H i)⟩) hu
   exact hP.2.1.of_nonneg_of_le ha (fun i=> le_mul_of_one_le_right (ha _) (Real.one_le_exp (mul_nonneg h0 (by positivity))))
