lemma paintedText (U:Config G c) : HasSum (fun i=> messageH M H χ rA Qt k' α₀ U i) (∑ i, Photo.spine M H χ rA Qt k' i U) := by
   let f(i:Stars H M):= messageH M H χ rA Qt k' α₀ U i
   obtain ⟨v,hv,hZ⟩:= Fan.yields M H rA hr p hU α₀ (Vt) hP0 (fun i=>⟨_, Fan.pinned M H i⟩) h0
   have he(i:H.fragrances): HasSum (fun j:Captain.Oscars M i=> f ⟨i,j⟩) (Photo.headSheet M H χ rA Qt k' i U):=by
        let g (j:Oscars M i):= cursors M H rA (α₀) Vt ⟨i,j⟩ U
        refine Switch.soundSum k' g (a:=fun j=>v ⟨i,j⟩) (fun j=>?_) Summable.of_finite (fun s _ T=> ?_)
        · let a:= hZ ⟨i,j⟩; obtain ⟨g,hg,hF,hV⟩:=a; exact ⟨g,hg,hF,fun _=> hV U⟩
        rw [tsum_fintype]; exact (Fan.folk M H χ k rA p hU C₁ hA hx0 i U s T).symm
   let k:= fun i:H.fragrances=> H.bookFoot (.inr i); have hf:=Towed.repair (Photo.flag_E M H χ R' rA K Qt k' hp w' hw hX) hw U |>.2; have hh: HasSum (fun i=>Photo.spine M H χ rA Qt k' i U) (∑' i, Photo.headSheet M H χ rA Qt k' i U):= border k hf
   have ht:= Fan.sailH M H χ rA hr p hU Qt k' w' hw hX (α₀) h0 hP0 (fun i=> Finset.Subset.refl _); have h:Towed w' (α₀) _ p.B ex ζ:=ht
   have hk:= Towed.repair ht hw U|>.2; change Summable f at hk; rw [← tsum_fintype (L:=SummationFilter.unconditional _),hh.tsum_eq, ← show (∑' i, f i)=∑' i,Photo.headSheet M H χ rA Qt k' i U from hk.tsum_sigma.trans (tsum_congr fun i=>(he i).tsum_eq)]; exact hk.hasSum
