lemma yieldsText (i:Stars H M) : Accent.Burns b' (X0 i) (fun U=> messageH M H χ rA Qt k' X0 U i) p.threshold := by
    let x:= messageH M H χ rA Qt k' X0; let f(j: Qt.Mode):Config G c→ℂ := chimes M H rA Vt Qt k' i j
    have hx(U j): (x U i).part j = masked p.threshold (X0 i) (f j) U:= (hU.symm ▸ (Fan.chorusQ M H rA hr (Vt) X0 Qt k' ht i _ _)).symm -- Eq variant
    obtain ⟨b,hb,hF,hX⟩:= hV.lights; let IX:=(exactE M H χ)
    have hh (j): p.Regular (X0 i) (f j):= Next.Foundations.regular_smul _ (Blush.ornate (hF i).1)
    refine ⟨⟨fun V W hV h'=>?_,fun g U=> ?_,fun i'=> ?_, fun U j hj=>?_⟩,fun U h=>?_,fun U=>?_⟩
    · change x V i=x W i; ext i';rw [hx, hx]; have hy: Healthy p.threshold (X0 i) V ↔ Healthy p.threshold (X0 i) W:=by unfold Healthy; simp only [disjoint_iff_inter_eq_empty,h']; -- definitional? hV.
      by_cases hz:Healthy p.threshold (X0 i) V; rw [masked_eq _ _ _ _ hz,masked_eq _ _ _ _ (hy.1 hz),(hh i').sites V W hV];rw [masked_ne _ _ _ _ hz,masked_ne _ _ _ _ (mt hy.2 hz)]
    · change x _ i=x U i; ext j; rw [hx,hx]; have hT:Healthy p.threshold (X0 i) (gauge g U)↔Healthy p.threshold (X0 i) U:=by unfold Healthy;rw [gauge_flags]
      by_cases h:Healthy p.threshold (X0 i) U; rw [masked_eq _ _ _ _ (hT.2 h),masked_eq _ _ _ _ h,(hh j).symmetry g U]; rw [masked_ne _ _ _ _ (mt hT.1 h),masked_ne _ _ _ _ h]
    · change Measurable fun U=> (x U i).part i'; simp_rw [hx]; exact masked_measurable _ _ _ (hh _).borel
    · have he: builds M H X0 (Vt) i:=by
        intro h; have hv' : Enter M H i:= by by_contra hz; exact h (if_neg hz)
        exact ⟨hv', fun j hj=> Finset.Subset.trans (Fan.alongZ M H χ j i h hj) (hc1 i)⟩
      have hf:f j=0:= Classical.byContradiction (fun h=>hj ((Accent.room (X0 i) b' j).2 ((Fan.attends M H rA hr (Vt) X0 Qt k' hT b' hv i he j h).2)))
      change (x U i).part j=0;rw [hx,hf]; by_cases hz:Healthy p.threshold (X0 i) U; exact masked_eq _ _ _ _ hz; exact masked_ne _ _ _ _ hz
    · by_contra hz; apply h; ext j; rw [show ((messageH M H χ rA Qt k' X0 U i).part j)= _ from hx U j,masked_ne _ _ _ _ hz,Poly.part_nil]
    change (x U i).part Qt.quiet=0; let a:=b; have hv:= Fan.cents M H rA hr p hU Vt X0 X0 a hF (fun i=>⟨_, hc1 i (Fan.pinned M H i)⟩) i; exact (Switch.sunset _ hv k' U hT).trans (by rw [parkP,Complex.ofReal_zero])
