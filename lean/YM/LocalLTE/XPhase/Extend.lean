lemma budsP : (φ₀).Active ∧ (φ₀).Radial w' 0 ε' 0 g:=by
    subst p; let I:= Metering M H XA Qt b'; let Z:= offerC M H XA Qt b'; let b0:= opalescence M H rA f' XA Qt k' b' x A (fun _ _=>0)
    have hA:= shelf M H rA f' XA Qt k' b' x A (fun _ _=>0); let s:=(φ₀)
    have hv i (hx:i∉Set.range Z): (φ₀).rays i=Qt.fire x∧ (φ₀).support i={b' x} ∧ (φ₀).H i=0:= by
        unfold ghost opalescence; dsimp only; exact ⟨Function.extend_apply' _ _ _ hx,Function.extend_apply' _ _ _ hx,blank _ _ hx⟩
    refine ⟨⟨fun i=>?_,fun i j h=>?_,fun i=>?_,fun i j=> ?_,fun _ _ h=> (h rfl).elim,fun _ _ _ _ _ _=> rfl, fun _ _ _ h=> (h rfl).elim,fun _ _=> measurable_const,fun _ _ _ _=>rfl⟩,hw,fun i=> ?_,hg,Fan.superscrip M H rA hr f' XA Qt k' w' hw hX b' x A (fun _ _=>0) hP he,?_⟩
    · by_cases h:i∈ Set.range Z
      · obtain ⟨k,rfl⟩:=h; change (b0.rays _|>.val.Nonempty); rw [show b0.rays (Z k)=_ from hA k|>.2.1]; exact k.property.1
      rw [show s.rays i= Qt.fire x from hv i h|>.1]; exact singleton_nonempty _
    · by_cases ht:i∈ Set.range Z
      · obtain ⟨k,rfl⟩:= ht; rw [show s.rays (Z k)=_ from hA k|>.2.1] at h; rw [show s.support (Z k)=_ from hA k|>.1]; exact k.property.2 (Finset.mem_image_of_mem _ h)
      rw [show (φ₀).rays i=Qt.fire x from hv i ht|>.1] at h; obtain rfl : j=x:= mem_singleton.mp h; rw [(hv i ht).2.1]; exact mem_singleton_self _
    · by_cases hi:i∈ Set.range Z; swap; · rw [(hv _ hi).2.2]; exact unspent A.p _
      obtain ⟨j,rfl⟩:=hi; rw [show s.support _=_ from hA j|>.1,show s.H (Z j)= _ from hA j|>.2.2]; exact Next.Foundations.regular_smul _ (Blush.ornate (hP.lights.choose_spec.2.1 _ |>.1))
    · let z:= Fan.tapsC Qt; by_cases h:j∈ Set.range z
      · obtain ⟨t,rfl⟩:=h; rw [show (φ₀).marks i (z t)=t.val from (Fan.falls M H rA f' XA Qt k' b' x A (fun _ _=>0) t i).1]; exact t.property
      rw [show (φ₀).marks i j=Qt.fire x from (by unfold ghost opalescence; dsimp only; rw [Function.extend_apply' _ _ _ h])]; exact singleton_nonempty _
    · change w' i*‖(0:ℂ)‖≤0; rw [norm_zero,mul_zero]
    refine ⟨fun _=>0,fun _ _=> ⟨le_rfl,fun _=>?_⟩,fun i=>?_⟩
    · change ‖(0:ℂ)‖≤0; rw [norm_zero]
