lemma linked (hQx:GrowsP M H p (sitesP M H q n r₀ A' l₁) rA α ε' (exactE M H χ) (sitesP M H q n r₀ A' l₁)) (U:Config G c): (∑' i,(stashX M H q n r₀ A' rA l₁ (exactE M H χ) Qt k' b' A ZB x Kt).ray i U)= ∑ i,Accent.octave (progressE M H χ q n r₀ A' rA l₁ Qt k' i U):=by
    let f:= fA; let g:= Mob Qt A (f); let R0:= (YX); let Z:= XA
    obtain ⟨hb,hQ⟩:= Fan.budsP M H q n r₀ A' rA hr p l₁ (exactE M H χ) Qt k' w' hw hX b' A hp he hQx x zero_lt_one
    have hf : f.extra U= ∑' i, Switch.sound k' (cursors M H rA XA Vt i U):= Fan.traveled M H rA hr Vt Z Qt k' ht hT b' hv x A (fun _ _=>0) (fun i=> Fan.exactB M H χ q n r₀ A' l₁ hl _) (show A.p.threshold=Pressure.temp t from congr_arg BudgetPoint.threshold hp|>.trans hU) U ((Bands.bulkBound f hb hQ U).1) -- hp equality not threshold
    have ht := (Fan.bakery_out M H χ q n r₀ A' rA hr p hU l₁ hl Qt k' w' hw hX (p.exponent_pos.le.trans he) hQx).repair hw U|>.2
    have hh : f.extra U=∑ i,LX i U:=by
       have hx : HasSum (fun i=> LX i U) (f.extra U):=by rw [hf]; exact border Z ht
       rw [← tsum_fintype (L:=SummationFilter.unconditional _),hx.tsum_eq]
    have hu : (∑' i,R0.ray i U)=g.extra U:=by change (∑' i,g.ray i U)=_; unfold Bands.extra; rw [show g.units= 0 from rfl]; simp
    rw [show (∑' i,_)=_ from hu, show g.extra U=_ from XPhase.recollect Qt A f hb hQ rfl U,hh];ext i; rw [Poly.part_sum]; by_cases h:2 ≤ i.val.card; rw [Accent.crest _ _ h,Poly.part_sum]; exact Finset.sum_congr rfl fun j _=> (Accent.crest _ _ h).symm
    rw [Accent.starlet _ _ (Nat.lt_of_not_ge h),sum_eq_zero]; intro j _; exact Accent.starlet _ _ (Nat.lt_of_not_ge h)
