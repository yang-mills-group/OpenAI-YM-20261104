lemma textRise (U:Config G c)(i:Qt.Mode)(hi: 2 ≤ i.val.card): (∑ j,progressE M H χ q n r₀ A' rA l₁ Qt k' j U).part i = (∑ j,Photo.spine M H χ rA Qt k' j U).part i - (∑ j,cZ j U).part i:=by
   have hv := Fan.paintedText M H χ k rA hr p hU Qt k' w' hw hX h0 hP0 R' K hp' C₁ hA hx0 U; have ht := (Fan.bakery_out M H χ q n r₀ A' rA hr p hU l₁ hl Qt k' w' hw hX h0 hP).repair hw U|>.2
   have hQ := (Fan.transferredText M H χ q n r₀ A' rA hr p hB hU l₁ hl Qt k' w' hw hX h0 hP0 hP).repair hw U|>.2
   have hb: (∑ i, VZ i U)=∑' j, LX j U:=by rw [←tsum_fintype (L:=SummationFilter.unconditional _)]; exact (border _ ht).tsum_eq -- check defeq
   have hx : (∑ i, cZ i U)=∑' j, (fΔ) j U:=by rw [← tsum_fintype (L:=SummationFilter.unconditional _)]; exact (border _ hQ).tsum_eq
   rw [show (∑ j, _)= _ from hb, hx, ← hv.tsum_eq]; change (∑' j,LX j U).part i=(∑' j,L₀ j U).part i-(∑' j, (fΔ) j U).part i
   rw [Poly.share hQ];
   have ha: Summable (fun j=> L₀ j U - LX j U):= hv.summable.sub ht
   simp_rw [crest _ i hi]; rw [← Poly.share ha, Summable.tsum_sub hv.summable ht,Extra.Trajectories.part_sub]; abel
