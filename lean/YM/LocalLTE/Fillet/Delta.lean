lemma principalWhorl : Patched (B) 0 YL (φt-Ω) zα ∧∀ i, Ω i≠0 →(∀ b:Bool,Replicated Yv (East.stagnate q (Z).halo*radiusB Y) κz (h+1) (Port.scaleQ b ∘ (Ω i)))∧(YL) i= neighbors (l* Pressure.radiusB Y) 0:=by
    let Cx:=applicant U p hΘ Bf
    by_cases hz:0<α ∧ Φ≠0
    · unfold Turf.whorlG; simp_rw [if_pos hz]
      have hi:= Turf.openWire U p hΘ Bf
      have hp:Certified U h Cx.live (b' false):=Turf.apertureCap U h p hΘ Bf ha hx hz.2 false Complex.reCLM juror rfl
      have hQ: Certified U h Cx.pale (b' true):= Turf.apertureCap U h p hΘ Bf ha hx hz.2 true Complex.imCLM jurorI rfl
      obtain ⟨hf,hZ⟩:= Turf.cloister U hm l q h hZ hL hP Yv p Cx hi hX hb _ _ hp hQ
      exact ⟨(Eq.mp (congr_arg (fun w:ℝ=>Patched (B) 0 YL (φt-Blush.whorl G0 Cx _ _ κz q h Yv hP z) (‖z‖*(G!*(((Yp)^(-(1/16:ℝ)))*w)+G!*(((Yp)^(-(1/16:ℝ)))*w)))) (Turf.priceA U p hΘ Bf)) hf),fun i hi=> ⟨(hZ i).1,(hZ i).2 hi⟩⟩
    unfold Turf.whorlG; simp_rw [if_neg hz]; rw [sub_zero]; refine ⟨?_,fun i h=>(h rfl).elim⟩
    have hs:(U.inPort).p.supBounds 0 Zf Φ 0:=by
        by_cases hp:0<α; have ht : Φ=0:= not_not.mp (fun h=> hz ⟨hp,h⟩); rw [ht]; exact River.Canvas.value (Canvas.quiet (D:=localSection G p) (m:=h) (ℓ:=0) (k:=κz) le_rfl)
        exact bound_weaken Bf.may (not_lt.mp hp)
    let u₀:= applicant U p hΘ (show Turf.Holds U p Zf Φ 0 from ⟨Bf.fits,hs⟩)
    let t:= Blush.screen U.houseB u₀ (U.lamp u₀.live) (U.lamp u₀.pale) ((((D.L (A.B.a.clock.J (m+1))).val:ℂ)^p)) F0
    have hx:= U.ruled G' hm hU h2 hM hV hd hE hD hr hℓ hΘ Zf 0 Φ Bf.fits hs -- order
    have he:Planned.GuardedAtom.Deck t 0 (scope U.houseB u₀ 0) U.output δ 0 0:=by
       have he : Doors.rate L*(U.inPort.p.mass Zf 0)=0:=by simp [BudgetPoint.mass]
       exact (Eq.mp (congr_arg (fun b:ℝ=> Planned.GuardedAtom.Deck t 0 (scope U.houseB u₀ 0) U.output δ b b) he) hx) -- may rewrite LOTS zeros
    have hK := Turf.rework hm h2 U Cx u₀ rfl (fun i=> rfl) he -- order
    have hp := Turf.enlargementQ G' hm h2 U Cx l hK (Turf.openWire U p hΘ Bf); rw [mul_zero] at hp
    obtain ⟨g,hg,hGx⟩:= hp.permit
    have he':0 ≤ α':=mul_nonneg (Real.exp_nonneg _) ha.earn
    have hpq:0 ≤ ζ:=by
        let p':=(U.ranch.allocation); have hp:0≤ betaF G Y L:=zero_le_one.trans ((p').vote.cash _ _ (step_paid A.B.a m)|>.2 _ (A.B.valid.pays m)).light.1
        exact mul_nonneg (Real.exp_nonneg _) (mul_nonneg (Real.rpow_nonneg hp _) he')
    exact ⟨g,⟨hg.1,hg.2.1, hg.2.2.trans (mul_nonneg (norm_nonneg _) (add_nonneg hpq hpq))⟩,hGx⟩
