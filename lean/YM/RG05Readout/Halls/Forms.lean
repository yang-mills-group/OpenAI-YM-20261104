abbrev GapAll (p:ℕ)(n:Side){J:Type*}(F:J→Site n) := ∀ i j:J,i≠j→ p≤ separation (F i) (F j)

lemma stretches (h:Stock.Tabs f!)(he:n ≤ m)(a b:Site (C.side m p)) (hx : (Z! n).B^2+1+t≤ separation ((C.S.toDepth he p).parent a) ((C.S.toDepth he p).parent b)) : (Z! m).B^2+1+t ≤ separation a b:=by
   induction m,he using Nat.le_induction with
   | base => rw [Mine.equal_site .., Mine.equal_site ..] at hx; exact hx
   | succ m h' ih=>
       let u:= (K m p).ratio; let v:= (Πξ h' p)
       simp_rw [parent_nested v u _ (C.S.toDepth_odd h' p) (C.S.block_odd m)] at hx
       let x:=u.parent a; let z:=u.parent b
       have hp:= ih (u.parent a) (u.parent b) hx
       have ht:= Nat.mul_le_mul_left u.count.val hp; rw [← Next.Rank.Station.both] at ht
       have he:=(Nat.mul_le_mul_right ((Z! m).B^2) (show 2≤ u.count.val from le_trans (by decide : 2≤3) (C.S.block_large _))); have hS: (Z! (m+1)).B^2 ≤ u.count.val*(Z! m).B^2:= (h.grows _).trans he
       have ha:= midway u (C.S.block_odd m) a; have hb:= midway u (C.S.block_odd m) b
       have hL:= separation_triangle (u.embed x) a (u.embed z); have hq:= separation_triangle a b (u.embed z); rw [separation_comm (u.embed x) a] at hL
       rw [mul_add,mul_add,mul_one] at ht; unfold x z at *; have hz:t ≤ u.count.val*t:= Nat.le_mul_of_pos_left _ u.count.property; omega
omit [DecidableEq J] in
lemma gap_one {v:ℕ}{q:Side}(R:J→Site q)(hp:GapAll v q R)(hx:0 < v) : Occupancy R 1:=by
    intro i; apply Finset.card_le_one.mpr; intro j hj k hk; by_contra he; have h:= hx.trans_le (hp _ _ he); rw [(Finset.mem_filter.mp hj).2,(Finset.mem_filter.mp hk).2,separation_self] at h; exact (lt_irrefl _ h)
section
variable (o:J→Site (C.side b p))(W:J→Motion)
local notation "U!"=> ManyStem C o
local notation "Ω"=> Mine.tree o W
variable (S:Stock.Tabs C.path.levels)(H:GapAll ((C.path.levels.budget b).B^2+1+t) (C.side b p) o)
include S H
omit [DecidableEq J] [Fintype J] in
lemma grantG (hp:b ≤ i)(j k:ManyStem C o i)(hq: j.val.1≠k.val.1) : (Z! i).B^2+1+t ≤ separation j.val.2 k.val.2:= stretches S hp _ _ (by rw [j.property hp,k.property hp]; apply H _ _ hq)
lemma priceD (hp:b ≤ i) : Drake (Many.Lift (Stock.census J) ((Ω).labelY (i+1))) ((Z! i).B) (((K i p).ratio.parent) ∘ ((Ω).supportX (i+1))) :=by
    refine ⟨fun M _ j hj k hk he=> ?_⟩
    have hX:Lit (Stock.census J) ((Ω).labelY (i+1)) M.val:= (Finset.mem_filter.mp M.property).2
    have hk': j.val.1≠ k.val.1:= fun h=>he (hX.2 hj hk h)
    let a:=(Ω).narrows i hp; let b:= (a j).1; let c:=(a k).1; have hB : b.val.1 ≠ c.val.1:= fun h=> hk' (((Ω).loyal i hp j).trans (h.trans ((Ω).loyal i hp k).symm)); have he : (K i p|>.ratio).parent ∘ ((Ω).supportX (i+1))=(Ω).supportX i ∘ Prod.fst ∘ (Ω).narrows i hp:= parentExact (δ:=(Ω).motion ∘ (Ω).labelY i) ((Ω).future i hp)
    rw [congr_fun he j,congr_fun he k]; apply le_trans (b:= ((Z! i).B^2+1+t)) (by omega) (grantG o S H hp b c hB)
omit S
lemma shareO (hp:b ≤ i) : Occupancy ((Ω).supportX i) 1 := keep_occ o W hp (gap_one o H (by omega))
lemma shareB (hp:b ≤ i)(hv:Pin C b d) : Occupancy ((Ω).supportX (i+1)) (apron f! i)∧ Occupancy (((K i p).ratio.parent) ∘ ((Ω).supportX (i+1))) (apron f! i):= (Mine.pays o W hp (gap_one o H (by omega)) ((by decide : 1 ≤ 12).trans hv.lit.1)).symm
end
-- Reflection purchase ensures t added gap
section
variable (J:ℕ) (ht:J≤ b) (o:Site (C.side b p))
local notation "Z"=> Site (C.side J p)
local notation "T"=> hands C p J
-- base assignments in center camp all REAL phases. apply directly to marker accounting.
def housed (i:Site (C.side J p)):= affine (hands C p J i).fst ((C.S.toDepth ht p).embed i) o
local notation "L!"=> housed J ht o
-- allow chamber boundary later.Charge launch via explicit aperture.
lemma house_gap (s:ℕ) (hp: (Z! b).B^2+1+t+2*s ≤ (C.S.toDepth ht p).count.val)(hv:separation o 0 ≤ s) : GapAll ((Z! b).B^2+1+t) (C.side b p) (L!):=by
    intro i j h; let K':=(Πξ ht p); have hj:K'.count.val ≤ separation (K'.embed i) (K'.embed j):=(Nat.le_mul_of_pos_right _ (separation_pos i j h)).trans_eq (Next.Rank.Station.both ..).symm
    have he(k:Z): separation (L! k) (K'.embed k) ≤ s:= by simp only [housed,separation,affine, sub_zero] at *; unfold K'; rw [add_sub_cancel_right,pdist_invariant]; exact hv
    have ht':= he i; have ht'' := he j; rw [separation_comm _ (K'.embed i)] at ht'
    have hv:=separation_triangle (K'.embed i) (L! i) (K'.embed j); have hZ:=separation_triangle (L! i) (L! j) (K'.embed j); dsimp only [K'] at *; omega
-- purchase on schedule
noncomputable def bumper (s:ℕ):ℝ:= 40+ 4*s
lemma opened_lot (t:ℕ)(hp:Stock.Tabs.opens C.path.levels (bumper t) J b):
    (Z! b).B^2+1+t+2*((C.S.toDepth ht p).count.val /4) ≤ (C.S.toDepth ht p).count.val :=by
    let X:= (C.S.toDepth ht p).count.val; let B:=(Z! b).B^2; have hx : ((Z! b).B:ℝ)^2=(B:ℝ):=by unfold B; push_cast;rfl
    have hv : (B:ℝ) * (bumper t) ≤ X:=by
        rw [mul_comm,← hx]; apply hp.2.trans; rw [show (f!).S.a J= (S').a J from rfl,← (S').embeds_scale (C.S.toDepth ht p)]; have hy:=(S').a_pos b; exact le_of_eq (mul_div_cancel_left₀ _ hy.ne') -- arg
    have hy:1 ≤ (B:ℝ):=by unfold B; exact_mod_cast pow_pos ((f!|>.budget b).B_pos) _
    have hL: 2*(B+1+t) ≤ X:=by
       apply (Nat.cast_le (α := ℝ)).mp; push_cast; unfold bumper at hv; linarith only [hv,hy, mul_le_mul_of_nonneg_right hy (show 0 ≤ (t:ℝ) from by positivity)]
    unfold X B at hL; omega
end
