import YM.Juniper.Bright.Panorama
/-!
 # Strip all estimated label tails locally. Don't infer any bound on difference of mask partners.

 ~$Orbit identity ∀ fields$ before **separate** kinetic, not E/K Bond after mask.
 Here higher leaves generated by SeniorV. Need analogous masked-aware:
     budget on SPATIAL J on Scout.Repl. For mixed legacy use eventual-coverage input.
 No assumption of bounding BIG PERIOD SUM. 
 -/
set_option autoImplicit false
set_option quotPrecheck false
noncomputable section
namespace YM.Juniper.Bright
open ConnectedActivityE6 Blaze Silica March Captain PhysicalNext PhysicalNext.Repeat Height
open Filter Function Lattice RG Pressure Pressure.Stores Pressure.Tube Tree Wilson Finset MeasureTheory Matrix
open Push Push.AbsoluteSums Precision Exterior Shell Channel Next.Fluctuations SectorMeasure Oriented Work.E03
open Shoot SliceRows Control Pulse Mask Raw Matter Pond Gas Ursell Trees Reserves Greenbelt Deck Mint Shield Stained
open AnalyticBridge VerifiedReset Collection Quotes UVNext Next.Scheduling Extra.Iteration Animals Corona Match Song Meadow
open scoped Topology InnerProductSpace Matrix.Norms.Frobenius ContDiff BigOperators Classical
variable {G: Gauge} {c f L : Side} {P:Teller G}
      {W μ x C s t δ K u:ℝ} {χ:Chi}{Q: ConnectedActivityE6.Target G P} {o:Target.Order G W}
      {j n k m:ℕ} {S : StepData c f} {T:Tube G S} {R: Rep G f}
   {I:Cash W x μ L Q o C T R}{B:BudgetPoint}
section purse
variable {ι:Type}{w:ι→ℝ} {X:ι→RegularAddress c}
lemma pays_less {F:ι→ Config G c→ℝ} (hu:t ≤ δ)(h:Meadow.Budget B X (G:=G) F t): Meadow.Budget B X F δ:=by
    obtain ⟨p,hp,h⟩:=h; exact ⟨p,fun i=>budget_loosen (hp i) hu,h⟩
lemma earlier_none (p : ι→ Prop) [DecidablePred p] (h : Quotes.early B X w t) : Quotes.early B X (fun i=> if p i then 0 else w i) t:=by
   intro x; refine budget_mono (h x) (fun i=> ?_) (fun i=>?_)
   · by_cases he:p i
     · dsimp only; split_ifs <;> simp_all
     dsimp only; rw [if_neg he]; exact (h x).1 i
   have ht:= (h x).1 i; dsimp only at *; split_ifs at * <;> first| rfl| simp_all
lemma stamp0 {X:RegularAddress c}: B.Regular X.support (G:=G) (0:Config G c→ℝ) ∧ B.supBounds X.site X.support (0:Config G c→ℝ) 0:= ⟨CouplingShape.reg_const _, by simpa only [abs_zero] using! (CouplingShape.sup_const (G:=G) (p:=B) (X:=X.support) (o:=X.site) 0) ⟩
def arrest {ι:Type} (U: ι→ Config G c→ℝ) (Q: ι→ Prop) (i:ι): Config G c→ℝ:= if Q i then U i else 0
lemma camp (U: ι→ Config G c→ℝ) (Q: ι→ Prop) (h : Meadow.Budget B X U δ) : Meadow.Budget B X (arrest U Q) δ:= by
   obtain ⟨k,h,h'⟩:=h; refine ⟨fun i=> if ¬ Q i then 0 else k i, earlier_none (fun i=> ¬Q i) h,fun i=>?_⟩
   unfold arrest; dsimp only; split; next he=> exact h' i
   next he=> exact stamp0
lemma splits (U V K: ι→ Config G c→ℝ) (h: V=U+K)(hU:Meadow.Budget B X U u)(hK:Meadow.Budget B X K δ): Meadow.Budget B X V (u+δ):= by
   obtain ⟨b,hb,h'⟩:=hU; obtain ⟨a,ha,hK⟩:=hK
   refine ⟨b+a,fun i=>?_,fun i=>?_⟩
   · convert budget_plus (hb i) (ha i) using 1; ext j; dsimp only [Pi.add_apply]; split <;>ring
   rw [h,Pi.add_apply,Pi.add_apply]; let V:= (-1:ℝ) • K i; rw [show U i+K i=U i-V from by simp [V]]; have he:= CouplingShape.reg_scale (-1) (hK i).1
   have hh:= CouplingShape.sup_scale (-1) (hK i).2; rw [abs_neg,abs_one,one_mul] at hh; exact ⟨CouplingShape.reg_sub (h' i).1 he, CouplingShape.sup_sub (h' i).1 he (h' i).2 hh⟩
lemma thin (w:ι→ℝ)(H:SumBudget w t)(P:ℕ→ι→Prop)(h:∀ i,∀ᶠ n in atTop, ¬P n i) (he:0<δ):
    ∀ᶠ n in atTop, SumBudget (fun i=> if P n i then w i else 0) δ:= by
   let f n i:= if P n i then w i else 0; have hf n: SumBudget (f n) t:= budget_mono H (fun i=> by unfold f; split; exact H.1 i; rfl) (fun i=> by unfold f; split; rfl; exact H.1 i)
   have hx: Tendsto (fun n=>∑' i,f n i) atTop (𝓝 (∑' _i:ι,(0:ℝ))) := tendsto_tsum_of_dominated_convergence H.2.1 (fun i=> tendsto_const_nhds.congr' ((h i).mono fun k hk=> (if_neg hk).symm)) (Eventually.of_forall fun n i=> by rw [Real.norm_of_nonneg ((hf n).1 i)]; unfold f; split; rfl; exact H.1 i)
   rw [tsum_zero] at hx; filter_upwards [hx.eventually_le_const he] with n hn using ⟨(hf n).1,(hf n).2.1,hn⟩
lemma gone (U: ι→ Config G c→ℝ) (Q:ℕ→ι→Prop) (h : Meadow.Budget B X U t) (he:∀ i, U i ≠ 0 → ∀ᶠ n in atTop,¬Q n i)(hp:0<δ): ∀ᶠ n in atTop, Meadow.Budget B X (arrest U (Q n)) δ:= by
   obtain ⟨f,h,hF⟩:=h
   have hh i : ∀ᶠ n in atTop, ¬(Q n i ∧ U i≠0):= by
     by_cases hk:U i=0; · exact Eventually.of_forall (fun n h=>h.2 hk)
     exact (he i hk).mono fun n h=> by simp [h]
   filter_upwards [eventually_all.mpr (fun x:Site c=> thin _ (h x) (fun n i=> Q n i ∧ U i≠0) hh hp)] with n hn; refine ⟨fun i=> if Q n i ∧ U i≠0 then f i else 0,fun i=>?_,fun i=>?_⟩
   · convert hn i using 1; ext j; dsimp only; split_ifs <;> simp_all -- complex simplify
   dsimp only; unfold arrest; split_ifs with hr hv
   · exact hF _
   · rw [of_not_not (fun he=> hv ⟨hr,he⟩)]; exact stamp0
   · grind
   exact stamp0
end purse
end YM.Juniper.Bright
