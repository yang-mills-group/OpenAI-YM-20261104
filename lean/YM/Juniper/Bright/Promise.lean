lemma highEnough (n:ℕ) : 2*Trio.base V₀ (radiusB x) < (A.B.a.S.side m n).val := by
   let w:= V₀; let g:= A.delay.growth (J); have hp:1≤ radiusB x:= (B).B_pos
   have hz : 0< Trio.maxFixed w:= by unfold Trio.maxFixed Trio.base Trio.tent; omega
   have h:= step_paid A.B.a m; have hg:1≤ g:= (R.inn.terms.sizes _ _ h).2
   have hk:= A.B.valid.volume m n; let c:= 1+radiusB x+A.B.a.clock.coverSize (m+1)
   apply lt_of_lt_of_le _ hk; refine lt_of_le_of_lt (Trio.roof V₀ (radiusB x) hp) ?_
   change _< A.delay.shells J*c^g; exact lt_of_lt_of_le (Nat.mul_lt_mul_of_pos_left (lt_of_lt_of_le (b:=c) (by unfold c; omega) (le_self_pow₀ (by unfold c; omega) (by omega))) hz) (Nat.mul_le_mul_right _ (he.penned _ _ h))
