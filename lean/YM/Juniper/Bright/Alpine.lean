   obtain ⟨F⟩:= Tree.select (panel A m hp).ratio (panel A m hp).patch.odd_side; obtain ⟨he,_⟩:= roomy R hp hm S hV F; let v:= R.pledging; have hi:= step_paid A.B.a m; obtain ⟨hσ,hζ⟩:= (R.pledging.agenda _ _ hi)
   obtain ⟨-, -, h₀,hτ⟩:= Rain.jersey (A:=A) (m:=m); have hx: (raiser (B)).supportExponent+1≤ (k').earn:= by change (B).supportExponent+1+1 ≤_; rw [h₀]; linarith
   obtain ⟨f₁,he',hk⟩:= Refrain.chargesOut (raiser B) S (blank S) O hV rfl hx
   let zq:= betaF G x L; have hz':z=zq:= PriceCompiler.beta_eq A.B.valid m
   have hb: Next.Scheduling.inBand (betaF G x L) β:= by rw [← PriceCompiler.beta_eq A.B.valid]; exact trial_in h
   let u':= Time.forecastK A.B.a m R.scout β
   let w:= Trio.lossFee G L (k').wanting T D₁ x; let g:= Marlin.tithe (2*u₀) w B (coverTicket T)
   let p:= (R.scout J I).pair.strong (betaF G x L) β; have hP:u'=p:= by unfold u' forecastK; rw [hz']
   have hf:ζ≤ p/8:= by have he:= v.conducts.income.earns _ _ hi x (A.B.valid.pays m) _ hb; refine he.trans_eq ?_; ring -- let
   have he'K : 0≤ C₀:= by
     unfold Trio.heat; rw [← hτ, ← PriceCompiler.beta_eq A.B.valid]; have Hc:= turnFee_pos B; have HT:0 < (z):= zero_lt_one.trans (A.B.a.fits.delayed _); positivity
   have hJ: 0 ≤ w:= by unfold w Trio.lossFee; apply add_nonneg (add_nonneg he'K he'K); exact sum_nonneg fun i _=> mul_nonneg (abs_nonneg _) (mul_nonneg (Nat.cast_nonneg _) (add_nonneg he'K he'K))
   have hw: 0≤ g:= by unfold g Marlin.tithe; positivity
   have hΨ:g≤zq^(-(1/8):ℝ):= by unfold g Marlin.tithe; rw [h₀]; exact (terms R hK (m:=m) (hd ..)).2.2.2.2.1
   have hζ:= mirrorWarp R hp hm h V S hq hY hz hV hC n
   obtain ⟨η,hη⟩:= (R.inn.terms.allot _ _ hi x (A.B.valid.pays m)|>.2.2.1) β hb ζ g (budget_nonneg (hk 0)) hw hf hΨ
   obtain ⟨hy,hB,hY',hm',hh',_,hℒ'⟩:= Bright.climb (b:=(R.target J I).halo) (n:=H) (j:=radiusB x) (B).B_pos
   have hx : 4*(ℒ)+16 ≤ c.val:= by unfold miner; have hz:= (hℒ' c hC).1; omega
   change Ingredients _ _ _ _ u'; rw [hP]
   have h:Marlin.tithe (2*u₀) (breach ℒ (turnFee B*( z^(k').wanting+ z^ (-(7/16):ℝ))) (fun _=> C₀) (caves R m)) B (coverTicket T) ≤ g:= by
      unfold g w Trio.lossFee Trio.heat breach; rw [← PriceCompiler.beta_eq A.B.valid, ← hτ]
   refine Bright.funds u₀ hy hx rfl hY' hB hm' hh' le_rfl he ?_ hζ (fun i V' hi j=> (mainDoor R hm (sews R m i) (V.pages i) (V.sells i) n j).2 V' hi) ⟨_,he',hk⟩ hη ?_ h _
   · intro i j; exact CouplingShape.reg_extend ((mainDoor R hm (sews R m i) (V.pages i) (V.sells i) n j).1) (subset_univ _)
   intro x'; unfold coverTicket; apply Nat.cast_le.mpr; apply (Trio.scaleMeters T (radiusB x) (B).B_pos x' _ le_rfl).trans_eq; rw [two_mul]
