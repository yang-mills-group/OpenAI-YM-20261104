-- full setup packaged. α actual E/N exactly masked, TRUE Wilson-like kinetic estimate at panel, horizon all N,m.
lemma deployed : ∃ ᾰ: Chartlet M.X.shape M.A N m hp' σ, SeekR M.X.shape M.A N m hp' ᾰ ∧ ∀ᶠ n:ℕ in atTop, let θ:= M.A.B.a
      let x':= θ.budget m
      CloseG M.X hp' Z ᾰ n ∧
      ∀ F:Forest (panel M.A m hp').ratio, let β' := Bright.betaBorn _ _ Z ᾰ n; let H':= shelves (scaledP M.X hp' ᾰ) (M.A.B.kin.path N m) (M.A.B.a.budget m); let D':= Collection.branch (scaledP M.X hp' ᾰ) (M.A.B.kin.path N m) (M.A.B.a.params m).clip x' (score M.X hp' Z ᾰ n) (M.A.B.kin.alpha N m)
        (panel M.A m hp').push β ((hut N m hp' β).eval)=(Bright.delivery _ _ Z ᾰ n F).eval ∧ x'.threshold^2 * |β' -(β+M.A.B.kin.alpha N m)|≤ Time.forecastE M.A.B.a m ∧ Ingredients H' D' x' (fraction θ m) (quoteHard θ m M.X.book β) ∧ (Bright.delivery _ _ Z ᾰ n F).activities.Valid x' (fraction θ m) (quoteHard θ m M.X.book β) := by
   have hx: 100*(1+ (M.A.B.a.budget m).B) ≤ c.val:= (climb (b:=(Rain.lint M.X.target M.A m)) (n:=mast (M.A.B.a.clock.J (m+1))) (M.A.B.a.budget m).B_pos|>.2.2.2.2.2.2) c hc|>.2
   obtain ⟨ᾰ,hA⟩:= reception M.X hp' hm hβ hx
   refine ⟨ᾰ,hA,?_⟩; filter_upwards [ethos hm E hs hp' hβ Z hc ᾰ hA] with n hn -- order
   exact ⟨hn,fun F=>Bright.rebuilding M.X hp' hm Z ᾰ hn hG hβ F⟩
