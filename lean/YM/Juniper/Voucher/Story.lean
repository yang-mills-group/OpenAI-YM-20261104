lemma anchorage (hr: Q ≤ J) : Script P Y N m n hm r:= by
   have hxB:(↑(0:ℝ):ℂ)∈ Camp.Broad Y.A.B.a:=by simp only [Complex.ofReal_zero]; exact Metric.mem_ball_self (Camp.flat_pos _)
   obtain ⟨he,-,hg,hv,hF,hB,hH,hM⟩:= rotation P E Y h; have hR:= Cinch.pristine Ω hG hm S 0 hxB (n:=n); obtain ⟨hx,hk⟩:= (T).acts (Y.S.cart N n) (Y.S.token N n) Y.S.grove.coins hxB
   obtain ⟨Z⟩:= Bright.resident Ω hm (show β₁∈ Rain.lands Y.A m from hR.1)
   obtain ⟨V⟩:= gemsigned Ω hm Z
   constructor
   swap; · exact ⟨rfl, hR.2.2.symm, rfl⟩
   have hU : Reality B (m+1) n d X' β₁ := hx.alive (m+1) hm
   let f:=X'; let p:=Ψ; let b:=β₁; let L:= place B (m+1) n d; have hG':=(T).plates Y.S.grove.enabled Y.S.grove.climbed hx hxB hk (m+1) hm|>.1
   have hh:0 < rim:=by norm_num [rim]
   have hp' : ‖L f‖ < rim:= hG'.trans_lt (by norm_num [Camp.soft,rim])
   have hz: Native.trueE (0:Valve (m+1) n B d)=0:= -- because first coordinate of linear x
       congr_arg Prod.fst (congr_arg Subtype.val (map_zero L))
   have hh': ‖L p‖<rim:= Native.merge_grip d hp' (by rw [hz,norm_zero]; exact hh)
   let hy:= Native.accepts_budget d (x:=p) («β»:=b) hU.1 hh'
   have hl: 2*Bright.home Ω m< (c!).val:= Bright.highEnough Ω hg n
   refine ⟨Z,V,hU,hy,?_,Voucher.bought Ω Y.S.grove.pledge F! d hU (y:=p) hy hH hF hv hp hG Y.S.grove.enabled hr hR.2.1 hp' hh' ((T).rootc hx hxB hk _ hm) P V Z hg hM h.highest hl ?_ hB h.may_use⟩
   · rw [Native.total_diff,hz,sub_zero]; exact le_trans (le_max_left _ (‖Native.trueK f‖)) ((Native.total f).symm.trans_le hG')
   intro i U; change masked _ _ (0:Config G W→ℝ) U=0; simp [masked]
