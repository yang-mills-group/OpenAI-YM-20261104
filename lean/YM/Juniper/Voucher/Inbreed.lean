lemma bigger : figure R m ≤ home R m:=by
    let T₀:= R.target J i₀ ; let b:=T₀.halo; let x:=radiusB t₀; have hz:b ≤ H₀:= ((show b≤b+10 from by omega).trans (le_mul_of_one_le_left (Nat.zero_le _) (show 1 ≤20*(mast J+1)*(mast J+1) by nlinarith only [Nat.zero_le (mast J)])))
    change Trio.base b x ≤ Trio.base H₀ x
    unfold Trio.base Trio.tent Meadow.studio Meadow.roomSize Mint.width; have ht:= Nat.mul_le_mul_right x hz; omega
include hg hd H hx
lemma wind : Windy R m C (Need J i₀ t₀ D R.expense) (2*Bright.home R m) n:= by
  let x:= C; let k':= (X.p.profile i₀); let P':= Need J i₀ t₀ D R.expense; let ε':=coverTicket H₀; let p:= Marlin.tithe (2*Bright.home R m) (ν+P') (s) ε'
  have he:= step_paid B m; have hp:= A.B.valid.pays m; have hb: Next.Scheduling.inBand (betaF G t₀ Ω) C:=by rw [← PriceCompiler.beta_eq A.B.valid]; exact trial_in hx.1
  have ht' :=hg.veil _ _ he _ hp; have he': (s).supportExponent=(X.p.profile i₀).supportExponent:= (Rain.jersey (A:=A) (m:=m)).2.2.1
  have hh':p ≤ betaF G t₀ Ω ^(-(1/8):ℝ):= by unfold p Marlin.tithe; rw [he']; exact ht' (hd ..)|>.1
  have hY (b:ℕ):0 ≤ Trio.lossFee G Ω (R.expense J i₀).wanting b k' t₀:= by
    have ht:0 ≤ heat G Ω (R.expense J i₀).wanting b k' t₀:=by
      unfold Trio.heat; rw [← PriceCompiler.beta_eq A.B.valid]; have h:0≤ Height.away k':=by unfold Height.away Push.Local.turnCost; positivity
      have he:0 < Y:= zero_lt_one.trans (A.B.a.fits.delayed _); positivity
    unfold lossFee; exact add_nonneg (add_nonneg ht ht) (sum_nonneg fun i _=> mul_nonneg (abs_nonneg _) (mul_nonneg (Nat.cast_nonneg _) (add_nonneg ht ht)))
  have hr:0 ≤ ν+P':= add_nonneg (hY _) (add_nonneg (hY _) (hY _)); have hP: 0≤ p:= by unfold p Marlin.tithe; positivity
  have hX:= (standing R H d hx).invested
  have hL: 0≤ L:= budget_nonneg (hX.choose_spec.2 0)
  obtain ⟨η,hη⟩:= (R.inn.terms.allot _ _ he _ hp).2.2.1 _ hb _ p hL hP ((R.pledging.conducts.income.earns _ _ he _ hp _ hb).trans_eq (by ring)) hh'
  refine ⟨⟨η,ε',?_,fun i=>?_⟩,mul_le_mul_right (bigger R) _⟩
  · unfold forecastK; rw [PriceCompiler.beta_eq A.B.valid]; exact hη
  unfold ε' coverTicket; apply Nat.cast_le.mpr; exact (Trio.scaleMeters H₀ (radiusB t₀) (s).B_pos i _ le_rfl).trans_eq (by rw [two_mul])
