lemma ink : let R':=T₀
   ∃ d': Cham B m n, ∃ a: Valve m n B d', ∃ b: Valve m n B d',
   a.val = ψ ∧ (Tabernacle.floor s ψ).Valid s Y' W' ∧ R'= Dales.mount R N m n a.val (C+φ+Δ) (R'.v) ∧ R'.eval = D' ∧
   b.val = Ψ ∧ (Tabernacle.floor s Ψ).Valid s Υ W':= by
    have hh:=shown R T H d hx hy hr ht hκ|>.1; have hq:= persim R T H d hx hy v P f w hv ht hr hκ hM
    have hn:=Return.enough_room A.B m n; have hwidth:= hp_width R H.hm P₀; have hC:=A.B.support.cap N m H.hm.le
    have hp:= conviction R H d hx hy v P f w hv hG (p:=p); have hu : (s).threshold^2 * |a₀| ≤ δ:= by rw [hp.2.1]; exact delta_bound hG hq.projects
    let x' := Collection.fill φ₀ V (T').clip s ŷ φ (a₀)
    have ha := Cinch.fledged (X:=Collection.shelves φ₀ V s) M 0 (by
      obtain ⟨_,_,hp,_⟩:= Cinch.huts (α:=φ) hq hG hwidth.2 hC hwidth.1 hu
      exact hp : ((Collection.shelves φ₀ V s).pours x').EBound s Υ)
    rw [show Cinch.forecastW G c s 0=0 from (by simp [Cinch.forecastW,Cinch.Pylon.droop]),add_zero] at ha
    have hW:= Cinch.charges _ M 0 (hq.fittings hG hC hwidth.1 hn φ (a₀))
    have hk: ∀ (sOp:Signed) (vOp: Site c), ∃ q:Takes sOp vOp q' X₁,∃ w:Takes sOp vOp q' y₁,q.Joint w:= by
       intro a i; obtain ⟨M',K',hc⟩:= junction R T H d hx hy v P f w ht hr hκ hM a i; exact ⟨_,_,Cinch.moist_pair (Collection.shelves _ _ s) M (ĉ) 0 (Whirl.ember (R:=V) («c»:=(T').clip) hG hh hn φ Δ _ _ M') (Whirl.ember hG hq hn φ (a₀) _ _ K') (Whirl.moves _ _ _ _ _ _ M' K' hc)⟩
    intro R'; obtain ⟨T₁,⟨a,b,he,hg⟩,hv,hk⟩:= Cinch.sails q' hP.worn ha hW hk
    exact ⟨T₁,a,b,he,hv,(by rw [he]; rfl),hP.obeys.2.1,hg,hk⟩
