lemma scales (h₀:‖w! x‖<rim)(hz:‖w! y‖<rim): (s).threshold^2*|Δ-(a₀)| ≤ Λ+χ ∧ (Tabernacle.floor s (ψ-Ψ)).EBound s Δ₁ := by
    obtain ⟨hp,hξ⟩:=Voucher.wealth R T H d hx hy v P f w hv ht hPT hr hκ hθ hX hG h₀ hz
    have hxq:=Voucher.conviction R H d hx hy v P f w hv hG (p:=p); have he:= merchant hxq.2.2
    have hu:= hP.bend; let K':= delta ((φ₀).read Π); let a:= a₀; let b:= regularNeed G s (T').clip (T').width (T').paths 0
    have hh : (s).threshold^2*|Δ-(a₀)| ≤ Λ+χ:= by
       have hy : |Δ-a| ≤ |K'-a| + |K'-Δ|:= by rw [add_comm,abs_sub_comm K' Δ,show Δ-a=(Δ-K')+(K'-a) by ring]; exact abs_add_le ..
       linarith only [mul_le_mul_of_nonneg_left hy (sq_nonneg (s).threshold),hξ,hu]
    have hσ:0≤χ:= (mul_nonneg (sq_nonneg _) (abs_nonneg _)).trans hu
    refine ⟨hh,Time.E_rises (Cinch.strained (q') (A:=X₁) («B»:=y₁) (hP.currency ŷ (a₀) (Λ+χ) he.1 (Bright.pays_less (le_add_of_nonneg_right hσ) hp) hh).1) ?_⟩
    change b (Q+ e!+χ)+Ĉ ≤ _
    have hs:b (Q+e!+χ)=b (Q+χ)+b e!:= by unfold b; rw [Time.table G _ (show Time.Same T' s from ⟨rfl,rfl,rfl⟩),Time.table G _ (show Time.Same T' s from ⟨rfl,rfl,rfl⟩),Time.table G _ (show Time.Same T' s from ⟨rfl,rfl,rfl⟩)]; rw [abs_zero]; ring
    rw [hs]; linarith only [hP.time_paid, contractor R H hθ (norm_nonneg (w! x-w! y))]
