 obtain ⟨hβ0,hK,hK',hW,hZ,hΨ,hΨ',hu⟩:= mobilized F V hv ht β hβ
 have hc' (W:Positions (Uniform.Primary c' G)):= Rune.hibernate F V hv ht U A₁ v Vo s H1 T₁ D' hβ hm hS g0 h₀ i hd hw hp (Titanic.texture F V H h₁ h₂ H1 s O _ hp') hΓ hQ (Trio.taller (Town F V) z _) W
 have he: Leasing.scaleM (m:=m) V.pledge c' (Skull.orders r) 0 (rescue G L z V.pledge r)= Skull.vespers G L z V.pledge r:= by unfold Leasing.scaleM; rw [mul_zero,zero_add]
 obtain ⟨hT,hP⟩:= huddle F V hv ht; rw [he] at hP hT; let t:= (Pane.panel A m H).ratio.parent (O (Sonnet.root s)); let y:= Leasing.trove (c:=c) (C1:=c') Ξ; let t₁:= needP F V; let S0 : 3*Ω≤t₁:= by have hh:=Rune.deep F V; change _ ≤ (needP F V); omega
 let Bak:= Rotunda.bake (G:=G) (Leasing.trope (c:=c) (C1:=c') Ξ) y (Hoboken.wcap _ _ h₂); have hz:Leasing.trope (c:=c) (C1:=c') Ξ=t:=Titanic.porch H s O
 have hV : (A.B.a.budget m).Regular Finset.univ w':= by have hv:= CouplingShape.reg_extend ((aboard F V hv ht U β hβ v s (gist (A:=A) m H1 Vo)).z_m (ιWeight F V U δ)).genuine (subset_univ _); simpa only [neg_one_smul] using CouplingShape.reg_scale (-1) hv
 rw [← (show Leasing.trope (c:=c) (C1:=c') Ξ=x from hz), show (-(ιWeight F V U δ • forecastOf U v O s H β))= w' ∘ Bak from funext fun u=> congr_arg (fun i=>-(ιWeight F V U δ*i)) (poses_eq F V hv ht U v O s H hβ H1 h₁ h₂ hC u)]; rw [hP]; exact ⟨mul_nonneg (by unfold Rotunda.priceP; positivity) hT,Rotunda.reel (A.B.a.budget m) _ _ _ w' S0 hV,Rotunda.tickets (A.B.a.budget m) (Leasing.trope (c:=c) (C1:=c') Ξ) y _ w' (2*Ω+1) le_rfl (Rune.deep F V) hc (stip F V hv ht).2.2.2.2.2.1 hΨ' hV hT hc'⟩
