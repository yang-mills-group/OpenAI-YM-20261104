lemma trip (x:ι→ℝ)(hr:∀ i,1≤x i)(hx: Bench M (x*g) hPago) (hK:∀ i,Luggage.long M E' i→ Kt ≤ x i):
    Rooted (origins M I) (glass M (x*g) Chi.canonical) (Ym) qα (oh) ∧
     ∀ᶠ i in atTop, Rooted (origins M I) (treat (χ:=Chi.canonical) (ρ:=g) (Luggage.miss M I E' w Km i)) (Ym) qα (Zp*e+(Gorges.missΡ F P₀ U k m Z x₀)* (gStep R.beta)^(k+1)):=by
  obtain ⟨hV₀,hP',hT⟩:= sellers (A.B.a.budget m) (H:=I) (sector F P₀ U k m Z H) hx (Pane.ovation A N H hm F.pledging.conducts.full) hV hs rfl rfl hh -- H arg? named instead
  let w':= Kt; have hz:0<w':= pow_pos (lt_of_lt_of_le zero_lt_one (sector F P₀ U k m Z H).life) _
  let b:= gStep R.beta; have he:0<b:=(Fare.gS _ I.laws.intake.positive).1; have hp:0 ≤ b^(k+1):=pow_nonneg he.le _
  have ht:w'⁻¹ ≤ 2^(k+1)*b^(k+1):= Coin.power_absorb I.laws.intake.positive (show 1 ≤ betaF G x₀ L₀ from (by rw [← PriceCompiler.beta_eq A.B.valid m]; exact (A.B.a.fits.delayed _).le)) (show R.beta ≤ _ from (by rw [← PriceCompiler.beta_eq A.B.valid m]; exact hf.2)) _
  refine ⟨hV₀,?_⟩
  filter_upwards [Luggage.profits M g I Ym E' x Ω hV₀ hP' hT hr hK hz hΩ w (b^(k+1)) (pow_pos he _)] with i hi
  refine hi.larger ?_
  let z:= oh; have hy : 0 ≤ z:= hV₀.nonnegative
  have he:z/w' ≤ |z| *(2^(k+1)*b^(k+1)):= by rw [div_eq_mul_inv,abs_of_nonneg hy]; exact mul_le_mul_of_nonneg_left ht hy
  change Zp * e + z / w' + w'⁻¹ * z + _ ≤ _; rw [mul_comm w'⁻¹, ← div_eq_mul_inv]; unfold Gorges.missΡ Fiord.missCost; unfold b z at *; linarith only [he]

