lemma curve (x : Forest (IY).ratio)(h: Rooted (origins M I) (glass M g O) (Ym) qα (oh))(he : Gorges.Rye F P₀ U k m Z H M g I)(hI: SeekR F.shape A N m H I):
    Motion.Pays H₀ (Ym) (K₀) (Real.exp (-Kz)) qα ∧ ∀ V t,t∈ Set.Icc (0:ℝ) 1→ ∀ p:Finset ι,
    epochs F m H I x V*Real.exp (Heron.bouquet M g I (χ:=O) V t p)*(black H₀ ((K₀) t p)).gas (Ym) V=(IY).push R.beta (buy M (ways g t p) (IY)) V:=by -- fix
   constructor
   · have hh:= Story.forced M g I (selfA I) (Ym) γ (χ:=Chi.canonical) rfl he rfl
     obtain ⟨v,hv,hB⟩:=hh.bought; exact ⟨hh.term,hh.licensed,v,hv,fun i=> budget_loosen (hB i) (mul_le_of_le_one_right (Real.exp_nonneg _) (by linarith only [he.books]))⟩
   intro V
   let σ:=F.pledging.jewels _ _ (A.B.valid.pays m) _ (step_paid A.B.a m)
   obtain ⟨c',d,v,s,z,q,r,k',Y',l,t,⟨N',hT⟩,hN,h₁⟩:= σ.2 _ _ _ (Pane.orchestra A N H) I.laws.data.funds (Pane.ovation A N H hm F.pledging.conducts.full) R I
   exact Story.arcs M g I (Divides.selfA I) (Ym) γ rfl rfl he V x h ((Gorges.shelves F P₀ U k m Z H M g I hm he.pays).filtered) N' (A.B.support.cap _ _ hm.le) ((Rain.jersey (A:=A) (m:=m)).1.le) hI
